import std::types;
import std::sys;
namespace scaffold;

struct Scaffold {
    public static unsafe bool flag(i8* argument, i8* name) {
        return Files.same(argument, name);
    }

    public static unsafe i8* option(i32 from, i8* name) {
        i32 count = Process.argc();
        mut i32 prefix = 0;
        while (*(name + prefix) != 0) {
            prefix = prefix + 1;
        }
        for (mut i32 i = from; i < count; i = i + 1) {
            i8* argument = Process.argv(i) ?? "";
            if (Files.starts_with(argument, name) && *(argument + prefix) == 61) {
                return argument + prefix + 1;
            }
            if (Files.same(argument, name) && i + 1 < count) {
                return Process.argv(i + 1) ?? "";
            }
        }
        return (i8*)0;
    }

    public static unsafe bool has_flag(i32 from, i8* name) {
        i32 count = Process.argc();
        for (mut i32 i = from; i < count; i = i + 1) {
            if (Files.same(Process.argv(i) ?? "", name)) {
                return true;
            }
        }
        return false;
    }

    // Questions are asked only on a terminal and without --no-input; otherwise every answer has to be a flag.
    public static unsafe bool interactive() {
        return Files.is_tty() && !Scaffold.has_flag(2, "--no-input");
    }

    public static unsafe i8* positional(i32 from) {
        i32 count = Process.argc();
        for (mut i32 i = from; i < count; i = i + 1) {
            i8* argument = Process.argv(i) ?? "";
            if (*(argument + 0) != 45) {
                return argument;
            }
            if (Files.same(argument, "--target") || Files.same(argument, "--dir") || Files.same(argument, "--name")) {
                i = i + 1;
            }
        }
        return (i8*)0;
    }

    public static unsafe i32 usage() {
        Spectre.markupLine("[bold]djinn scaffold[/] - project snippets and diagnostics");
        printf("\n");
        printf("  djinnc new [name] [--target=web|windows|executable|library] [--dir <path>]\n");
        printf("  djinnc init [dir] [--target=...] [--name n] [--yes]   create djinn.proj (asks step by step)\n");
        printf("  djinnc doctor [dir] [--target=...]   check the setup and the project\n");
        return 2;
    }

    public static unsafe i32 run() {
        if (Process.argc() < 2) {
            return Scaffold.usage();
        }
        i8* command = Process.argv(1) ?? "";
        if (Files.same(command, "new")) {
            return NewCommand.run();
        }
        if (Files.same(command, "init")) {
            return InitCommand.run();
        }
        if (Files.same(command, "doctor")) {
            return DoctorCommand.run();
        }
        return Scaffold.usage();
    }
}
