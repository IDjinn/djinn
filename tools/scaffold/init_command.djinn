import std::types;
import std::sys;
namespace scaffold;

struct InitCommand {
    public static unsafe i32 run() {
        i8* directory = Scaffold.positional(2) ?? ".";
        i8* path = Files.join(directory, "djinn.proj");
        if (Files.exists(path)) {
            SpectreEmoji.printInfo("djinn.proj already exists, nothing to do");
            return 0;
        }
        Spectre.markupLine("[bold]djinnc init[/]");
        mut i8* name = Scaffold.option(2, "--name");
        if (name == (i8*)0 && !Scaffold.interactive()) {
            SpectreEmoji.printCross("--name and --target are required without a terminal");
            return 2;
        }
        if (name == (i8*)0) {
            i8* answer = i8[1024];
            Spectre.promptDefault("Project name", "PingPong", answer);
            name = answer;
        }
        if (*(name + 0) == 0) {
            SpectreEmoji.printCross("a project name is required");
            return 2;
        }
        i32 target = Targets.choose(Scaffold.option(2, "--target"), "What does it build?");
        if (target < 0) {
            return 2;
        }
        printf("\n");
        Spectre.markupLine("[bold]Summary[/]");
        printf("  project  %s\n  target   %s\n  file     %s\n\n", name, Targets.name(target), path);
        if (!Scaffold.has_flag(2, "--yes") && Scaffold.interactive() && !Spectre.confirm("Write it?")) {
            SpectreEmoji.printWarning("nothing written");
            return 1;
        }
        Targets.write_project(path, name, target);
        SpectreEmoji.printCheck("djinn.proj written");
        return 0;
    }
}
