import std::types;
import std::sys;
namespace scaffold;

struct NewCommand {
    public static unsafe i32 run() {
        i8* given = Scaffold.option(2, "--target");
        i8* directory = Scaffold.option(2, "--dir");
        mut i8* name = Scaffold.positional(2);
        i32 target = Targets.choose(given, "What kind of project?");
        if (target < 0) {
            return 2;
        }
        if (name == null) {
            i8* answer = i8[256];
            Spectre.promptInto("Project name", answer);
            if (answer[0] == 0) {
                SpectreEmoji.printCross("a project name is required");
                return 2;
            }
            name = answer;
        }
        i8* root = Files.join(directory ?? ".", name);
        if (Files.exists(Files.join(root, "djinn.proj"))) {
            SpectreEmoji.printCross("djinn.proj already exists there; use djinnc init, or pick another name");
            return 1;
        }
        Files.make_dir(root);
        i8* sources = Files.join(root, "src");
        Files.make_dir(sources);
        Targets.write_project(Files.join(root, "djinn.proj"), name, target);
        SpectreEmoji.printCheck("djinn.proj");
        mut i8* entry = "main.djinn";
        if (target == Targets.LIBRARY) {
            entry = "lib.djinn";
        }
        Files.emit(Files.join(sources, entry), Targets.main_source(target), name, false);
        SpectreEmoji.printCheck("src/main");
        if (target == Targets.WEB) {
            Files.emit(Files.join(root, "index.html"), Targets.index_html(), name, false);
            SpectreEmoji.printCheck("index.html");
        }
        Files.emit(Files.join(root, ".gitignore"), "build/\n", name, false);
        printf("\n");
        SpectreEmoji.printInfo("created the project; next:");
        printf("  cd %s\n  djinnc . -o build/%s", root, name);
        if (target == Targets.WEB) {
            printf(" --target web");
        }
        printf("\n");
        return 0;
    }
}
