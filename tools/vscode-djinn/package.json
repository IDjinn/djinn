{
  "name": "djinn-lang",
  "displayName": "Djinn Language",
  "description": "Language support for Djinn: diagnostics, navigation, completion, semantic highlighting and build tasks, backed by djinn-lsp and djinnc",
  "version": "0.2.0",
  "publisher": "djinn",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages", "Linters"],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:djinn",
    "workspaceContains:**/djinn.proj"
  ],
  "contributes": {
    "languages": [{
      "id": "djinn",
      "aliases": ["Djinn", "djinn"],
      "extensions": [".djinn"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "djinn",
      "scopeName": "source.djinn",
      "path": "./syntaxes/djinn.tmLanguage.json"
    }],
    "semanticTokenScopes": [{
      "language": "djinn",
      "scopes": {
        "macro": ["entity.name.function.macro.djinn"],
        "decorator": ["entity.name.function.attribute.djinn"],
        "enumMember": ["constant.other.enum.djinn"]
      }
    }],
    "configuration": {
      "title": "Djinn",
      "properties": {
        "djinn.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the djinn-lsp executable. Empty looks in the extension's bin folder, then in djinn-lsp/build of the workspace, then in PATH."
        },
        "djinn.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to djinnc (needs --check). Empty lets the server look next to itself and in the build folders of the workspace."
        },
        "djinn.runtimeDir": {
          "type": "string",
          "default": "",
          "description": "Directory with the Djinn runtime (the folder that contains core/). Empty searches upwards from the workspace."
        },
        "djinn.stdDir": {
          "type": "string",
          "default": "",
          "description": "Directory of the standard library. Empty uses ../std of the runtime directory."
        },
        "djinn.checkOnChange": {
          "type": "boolean",
          "default": true,
          "description": "Run the compiler check while typing. When off, it runs on open and on save."
        },
        "djinn.checkDebounceMs": {
          "type": "number",
          "default": 500,
          "description": "Milliseconds without typing before the compiler check runs."
        },
        "djinn.inlineDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Show the first error or warning message at the end of its line, next to the squiggle."
        },
        "djinn.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Traces the communication with the language server."
        }
      }
    },
    "commands": [
      { "command": "djinn.restartServer", "title": "Djinn: Restart Language Server" },
      { "command": "djinn.checkProject", "title": "Djinn: Check Project" },
      { "command": "djinn.build", "title": "Djinn: Build", "icon": "$(tools)" },
      { "command": "djinn.run", "title": "Djinn: Build and Run", "icon": "$(play)" },
      { "command": "djinn.showServerInfo", "title": "Djinn: Show Language Server Info" }
    ],
    "menus": {
      "editor/title/run": [
        { "command": "djinn.run", "when": "resourceLangId == djinn", "group": "navigation@1" }
      ],
      "commandPalette": [
        { "command": "djinn.build", "when": "editorLangId == djinn" },
        { "command": "djinn.run", "when": "editorLangId == djinn" }
      ]
    },
    "taskDefinitions": [{
      "type": "djinn",
      "required": ["command"],
      "properties": {
        "command": { "type": "string", "enum": ["build", "run", "check"], "description": "What to do with the project or file." },
        "target": { "type": "string", "description": "Project directory or .djinn file. Defaults to the active file's project." }
      }
    }],
    "problemMatchers": [{
      "name": "djinnc",
      "owner": "djinnc",
      "fileLocation": ["autoDetect", "${workspaceFolder}"],
      "pattern": {
        "regexp": "^(.+?):(\\d+):(\\d+): (error|warning)\\[(\\w+)\\]: (.*)$",
        "file": 1,
        "line": 2,
        "column": 3,
        "severity": 4,
        "code": 5,
        "message": 6
      }
    }]
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "scripts": {
    "package": "vsce package"
  }
}
