{
  "name": "djinn-lang",
  "displayName": "Djinn Language",
  "description": "Syntax highlighting for the Djinn programming language",
  "version": "0.1.0",
  "publisher": "djinn",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "djinn",
      "aliases": ["Djinn", "djinn"],
      "extensions": [".djinn"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "djinn",
      "scopeName": "source.djinn",
      "path": "./syntaxes/djinn.tmLanguage.json"
    }]
  }
}
