{
  "name": "djinn-lang",
  "displayName": "Djinn Language",
  "description": "Language support for Djinn: diagnostics, navigation, completion, semantic highlighting, build, debug and perf profiling with inline hints, backed by djinn-lsp and djinnc",
  "version": "0.4.1",
  "publisher": "djinn",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Debuggers",
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:djinn",
    "workspaceContains:**/djinn.proj"
  ],
  "contributes": {
    "languages": [
      {
        "id": "djinn",
        "aliases": [
          "Djinn",
          "djinn"
        ],
        "extensions": [
          ".djinn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "djinn",
        "scopeName": "source.djinn",
        "path": "./syntaxes/djinn.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "djinn",
        "scopes": {
          "macro": [
            "entity.name.function.macro.djinn"
          ],
          "decorator": [
            "entity.name.function.attribute.djinn"
          ],
          "enumMember": [
            "constant.other.enum.djinn"
          ]
        }
      }
    ],
    "configuration": {
      "title": "Djinn",
      "properties": {
        "djinn.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the djinn-lsp executable. Empty looks in the extension's bin folder, then in djinn-lsp/build of the workspace, then in PATH."
        },
        "djinn.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to djinnc (needs --check). Empty lets the server look next to itself and in the build folders of the workspace."
        },
        "djinn.runtimeDir": {
          "type": "string",
          "default": "",
          "description": "Directory with the Djinn runtime (the folder that contains core/). Empty searches upwards from the workspace."
        },
        "djinn.stdDir": {
          "type": "string",
          "default": "",
          "description": "Directory of the standard library. Empty uses ../std of the runtime directory."
        },
        "djinn.checkOnChange": {
          "type": "boolean",
          "default": true,
          "description": "Run the compiler check while typing. When off, it runs on open and on save."
        },
        "djinn.checkDebounceMs": {
          "type": "number",
          "default": 500,
          "description": "Milliseconds without typing before the compiler check runs."
        },
        "djinn.inlineDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Show the first error or warning message at the end of its line, next to the squiggle."
        },
        "djinn.runtimeLib": {
          "type": "string",
          "default": "",
          "description": "Path to djinn_runtime.lib (Windows) or libdjinn_runtime.a. Empty uses the bundled one, then build/runtime of a Djinn checkout."
        },
        "djinn.libDir": {
          "type": "string",
          "default": "",
          "description": "Directory that holds std.djlib for project builds. Empty uses the bundled one, then build/bootstrap/libs of a Djinn checkout; without one the standard library is compiled from source."
        },
        "djinn.llvmBinDir": {
          "type": "string",
          "default": "",
          "description": "LLVM bin directory (LLVM-C.dll, clang, lld-link). Empty uses the LLVM folder under Program Files when present."
        },
        "djinn.build.debugInfo": {
          "type": "boolean",
          "default": true,
          "description": "Pass -g to djinnc so debuggers and profilers can map code to source lines."
        },
        "djinn.build.optimization": {
          "type": "string",
          "enum": [
            "O0",
            "O1",
            "O2",
            "O3",
            "Os",
            "Oz"
          ],
          "default": "O2",
          "description": "Optimization level for Build and Build and Run."
        },
        "djinn.perf.distro": {
          "type": "string",
          "default": "",
          "description": "WSL distribution used for perf profiling on Windows. Empty uses the default distribution."
        },
        "djinn.perf.frequency": {
          "type": "number",
          "default": 499,
          "description": "Sampling frequency in Hz."
        },
        "djinn.perf.duration": {
          "type": "number",
          "default": 0,
          "description": "Seconds to record before stopping the program. 0 records until the program exits or you run Djinn: Stop profiling."
        },
        "djinn.perf.callGraph": {
          "type": "string",
          "enum": [
            "fp",
            "dwarf"
          ],
          "default": "fp",
          "description": "How perf unwinds stacks. fp follows frame pointers (fast, smaller files); dwarf is slower and often stops early in Djinn coroutine frames."
        },
        "djinn.debug.optimization": {
          "type": "string",
          "enum": [
            "O0",
            "O1",
            "O2"
          ],
          "default": "O0",
          "description": "Optimization level for Djinn: Debug builds. Higher levels make variables show as optimized away."
        },
        "djinn.perf.arguments": {
          "type": "string",
          "default": "",
          "description": "Command-line arguments for the profiled program."
        },
        "djinn.perf.hintThreshold": {
          "type": "number",
          "default": 0.5,
          "description": "Minimum percentage of samples for a line to show an inline hint."
        },
        "djinn.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication with the language server."
        },
        "djinn.perf.optimization": {
          "type": "string",
          "enum": [
            "O0",
            "O1",
            "O2",
            "O3",
            "Os",
            "Oz"
          ],
          "default": "O2",
          "description": "Optimization level the program is compiled with for Djinn: Profile with perf."
        },
        "djinn.perf.compiler": {
          "type": "string",
          "default": "",
          "description": "Path to a Linux djinnc used by perf profiling (the program is compiled and run on Linux, natively or in WSL). Empty uses the extension's bundled one, then djinnc/build/djinnc of a Djinn checkout."
        },
        "djinn.perf.runtimeLib": {
          "type": "string",
          "default": "",
          "description": "Path to a Linux libdjinn_runtime.a for perf profiling (tools/build_runtime.sh builds it). Empty uses the extension's bundled one, then build/runtime of a Djinn checkout."
        }
      }
    },
    "commands": [
      {
        "command": "djinn.restartServer",
        "title": "Djinn: Restart Language Server"
      },
      {
        "command": "djinn.checkProject",
        "title": "Djinn: Check Project"
      },
      {
        "command": "djinn.build",
        "title": "Djinn: Build",
        "icon": "$(tools)"
      },
      {
        "command": "djinn.run",
        "title": "Djinn: Build and Run",
        "icon": "$(play)"
      },
      {
        "command": "djinn.showServerInfo",
        "title": "Djinn: Show Language Server Info"
      },
      {
        "command": "djinn.debug",
        "title": "Djinn: Debug",
        "icon": "$(debug-alt)"
      },
      {
        "command": "djinn.perf.record",
        "title": "Djinn: Profile with perf (WSL)",
        "icon": "$(flame)"
      },
      {
        "command": "djinn.perf.recordMemory",
        "title": "Djinn: Profile memory allocations (WSL)",
        "icon": "$(database)"
      },
      {
        "command": "djinn.perf.stop",
        "title": "Djinn: Stop profiling",
        "icon": "$(debug-stop)"
      },
      {
        "command": "djinn.perf.import",
        "title": "Djinn: Import perf profile"
      },
      {
        "command": "djinn.perf.clear",
        "title": "Djinn: Clear profile",
        "icon": "$(clear-all)"
      },
      {
        "command": "djinn.perf.toggleHints",
        "title": "Djinn: Toggle profile hints",
        "icon": "$(eye)"
      },
      {
        "command": "djinn.perf.showAssembly",
        "title": "Djinn: Show assembly (profile)",
        "icon": "$(file-binary)"
      },
      {
        "command": "djinn.perf.projectOnly",
        "title": "Djinn: Hide non-project code in profile",
        "icon": "$(filter)"
      },
      {
        "command": "djinn.perf.projectOnly.off",
        "title": "Djinn: Show all code in profile",
        "icon": "$(filter-filled)"
      },
      {
        "command": "djinn.perf.recordPages",
        "title": "Djinn: Profile touched memory pages (WSL)",
        "icon": "$(pie-chart)"
      },
      {
        "command": "djinn.perf.memoryMetric",
        "title": "Djinn: Choose memory metric",
        "icon": "$(settings-gear)"
      },
      {
        "command": "djinn.perf.recordLevels",
        "title": "Djinn: Profile and compare optimization levels (WSL)",
        "icon": "$(git-compare)"
      },
      {
        "command": "djinn.perf.compare",
        "title": "Djinn: Compare saved profiles"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "djinn.profile",
          "name": "Djinn Profile"
        }
      ]
    },
    "debuggers": [
      {
        "type": "djinn",
        "label": "Djinn",
        "languages": [
          "djinn"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "target": {
                "type": "string",
                "description": "Project directory or .djinn file to build. Defaults to the active file's project. Variables such as ${workspaceFolder} are supported."
              },
              "program": {
                "type": "string",
                "description": "Executable to debug. Defaults to the build output."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "cwd": {
                "type": "string"
              },
              "build": {
                "type": "boolean",
                "default": true,
                "description": "Build with debug info before launching."
              },
              "stopAtEntry": {
                "type": "boolean",
                "default": false
              },
              "mode": {
                "type": "string",
                "enum": [
                  "debug",
                  "profile"
                ],
                "default": "debug",
                "description": "debug starts the native debugger. profile records the program with perf (see the profile property)."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment variables for the program (used when profiling)."
              },
              "profile": {
                "type": "object",
                "description": "Options for mode: profile. Each omitted value falls back to the djinn.perf.* settings.",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "cpu",
                      "allocations",
                      "pages"
                    ],
                    "default": "cpu",
                    "description": "cpu samples the CPU, allocations traces the Djinn allocator, pages samples first-touched memory."
                  },
                  "optimization": {
                    "type": "string",
                    "enum": [
                      "O0",
                      "O1",
                      "O2",
                      "O3",
                      "Os",
                      "Oz"
                    ],
                    "description": "Optimization level of the profiled build."
                  },
                  "levels": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "O0",
                        "O1",
                        "O2",
                        "O3",
                        "Os",
                        "Oz"
                      ]
                    },
                    "description": "Two or more levels: records each one and opens a comparison table."
                  },
                  "duration": {
                    "type": "number",
                    "description": "Seconds to record per run. 0 records until the program exits or you stop it."
                  },
                  "frequency": {
                    "type": "number",
                    "description": "CPU sampling frequency in Hz."
                  },
                  "callGraph": {
                    "type": "string",
                    "enum": [
                      "fp",
                      "dwarf"
                    ],
                    "description": "How perf unwinds stacks."
                  },
                  "metric": {
                    "type": "string",
                    "enum": [
                      "alloc",
                      "live",
                      "peak",
                      "count"
                    ],
                    "description": "Metric shown for kind allocations."
                  },
                  "runner": {
                    "type": "object",
                    "description": "Where perf runs.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "wsl",
                          "native"
                        ],
                        "description": "wsl (default on Windows) or native (default on Linux)."
                      },
                      "distro": {
                        "type": "string",
                        "description": "WSL distribution."
                      },
                      "user": {
                        "type": "string",
                        "description": "WSL user (perf usually needs root)."
                      },
                      "sudo": {
                        "type": "boolean",
                        "description": "Run the native runner through sudo."
                      },
                      "perf": {
                        "type": "string",
                        "description": "Path or name of the perf executable."
                      },
                      "workDir": {
                        "type": "string",
                        "description": "Directory where the profiled build is made (default $HOME/.djinn-perf)."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "djinn",
            "request": "launch",
            "name": "Djinn: Debug project",
            "args": []
          },
          {
            "type": "djinn",
            "request": "launch",
            "name": "Djinn: Profile CPU",
            "mode": "profile",
            "target": "${workspaceFolder}",
            "args": [],
            "profile": {
              "kind": "cpu",
              "optimization": "O2"
            }
          }
        ],
        "configurationSnippets": [
          {
            "label": "Djinn: Debug project",
            "body": {
              "type": "djinn",
              "request": "launch",
              "name": "Djinn: Debug project",
              "args": []
            }
          },
          {
            "label": "Djinn: Profile CPU",
            "body": {
              "type": "djinn",
              "request": "launch",
              "name": "Djinn: Profile CPU",
              "mode": "profile",
              "target": "^\"\\${workspaceFolder}\"",
              "args": [],
              "profile": {
                "kind": "cpu",
                "optimization": "O2",
                "duration": 0
              }
            }
          },
          {
            "label": "Djinn: Profile allocations",
            "body": {
              "type": "djinn",
              "request": "launch",
              "name": "Djinn: Profile allocations",
              "mode": "profile",
              "target": "^\"\\${workspaceFolder}\"",
              "args": [],
              "profile": {
                "kind": "allocations",
                "metric": "alloc"
              }
            }
          },
          {
            "label": "Djinn: Compare optimization levels",
            "body": {
              "type": "djinn",
              "request": "launch",
              "name": "Djinn: Compare O1 and O3",
              "mode": "profile",
              "target": "^\"\\${workspaceFolder}\"",
              "args": [],
              "profile": {
                "levels": [
                  "O1",
                  "O3"
                ],
                "duration": 0
              }
            }
          },
          {
            "label": "Djinn: Profile on a Linux host",
            "body": {
              "type": "djinn",
              "request": "launch",
              "name": "Djinn: Profile (native Linux)",
              "mode": "profile",
              "target": "^\"\\${workspaceFolder}\"",
              "profile": {
                "kind": "cpu",
                "runner": {
                  "type": "native",
                  "sudo": true
                }
              }
            }
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "djinn"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "djinn.perf.showAssembly",
          "when": "view == djinn.profile && viewItem == djinnFunction",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "djinn.perf.showAssembly",
          "when": "editorLangId == djinn",
          "group": "navigation@9"
        }
      ],
      "view/title": [
        {
          "command": "djinn.perf.projectOnly",
          "when": "view == djinn.profile && !djinn.profile.projectOnly",
          "group": "navigation@4"
        },
        {
          "command": "djinn.perf.projectOnly.off",
          "when": "view == djinn.profile && djinn.profile.projectOnly",
          "group": "navigation@4"
        },
        {
          "command": "djinn.perf.record",
          "when": "view == djinn.profile",
          "group": "navigation@0"
        },
        {
          "command": "djinn.perf.recordMemory",
          "when": "view == djinn.profile",
          "group": "navigation@0"
        },
        {
          "command": "djinn.perf.stop",
          "when": "view == djinn.profile",
          "group": "navigation@1"
        },
        {
          "command": "djinn.perf.toggleHints",
          "when": "view == djinn.profile",
          "group": "navigation@2"
        },
        {
          "command": "djinn.perf.clear",
          "when": "view == djinn.profile",
          "group": "navigation@3"
        },
        {
          "command": "djinn.perf.memoryMetric",
          "when": "view == djinn.profile && djinn.profile.allocations",
          "group": "navigation@5"
        },
        {
          "command": "djinn.perf.recordLevels",
          "when": "view == djinn.profile",
          "group": "navigation@6"
        }
      ],
      "editor/title/run": [
        {
          "command": "djinn.run",
          "when": "resourceLangId == djinn",
          "group": "navigation@1"
        },
        {
          "command": "djinn.debug",
          "when": "resourceLangId == djinn",
          "group": "navigation@2"
        },
        {
          "command": "djinn.perf.record",
          "when": "resourceLangId == djinn",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "djinn.build",
          "when": "editorLangId == djinn"
        },
        {
          "command": "djinn.run",
          "when": "editorLangId == djinn"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "djinn",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "build",
              "run",
              "check",
              "perf"
            ],
            "description": "What to do with the project or file."
          },
          "target": {
            "type": "string",
            "description": "Project directory or .djinn file. Defaults to the active file's project."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "djinnc",
        "owner": "djinnc",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (error|warning)\\[(\\w+)\\]: (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "scripts": {
    "package": "vsce package"
  }
}