{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Djinn",
  "scopeName": "source.djinn",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.djinn", "match": "//.*$" },
        { "name": "comment.block.djinn", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "attributes": {
      "name": "meta.attribute.djinn",
      "match": "(?<=^|[\\s;{}])(\\[)\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.definition.attribute.djinn" },
        "2": { "name": "entity.name.function.attribute.djinn" }
      }
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.djinn",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.interpolated.djinn",
          "begin": "\\$\"",
          "end": "\"",
          "patterns": [
            { "include": "#escapes" },
            {
              "name": "meta.interpolation.djinn",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.djinn" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.djinn" } },
              "patterns": [{ "include": "$self" }]
            }
          ]
        },
        {
          "name": "string.quoted.double.djinn",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.single.djinn",
          "match": "'(\\\\.|[^'\\\\])'"
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.djinn",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|.)"
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.djinn", "match": "\\b0[xX][0-9A-Fa-f_']+([iu](8|16|32|64|128)|u|l|ul)?\\b" },
        { "name": "constant.numeric.binary.djinn", "match": "\\b0[bB][01_']+([iu](8|16|32|64|128)|u|l|ul)?\\b" },
        { "name": "constant.numeric.float.djinn", "match": "\\b[0-9][0-9_']*\\.[0-9][0-9_']*([eE][+-]?[0-9]+)?(f32|f64|f)?\\b" },
        { "name": "constant.numeric.integer.djinn", "match": "\\b[0-9][0-9_']*([iu](8|16|32|64|128)|f32|f64|u|l|ul|f)?\\b" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(struct|union|enum|interface|impl|namespace)\\s+([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "storage.type.djinn" },
            "2": { "name": "entity.name.type.djinn" }
          }
        },
        {
          "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.control.import.djinn" },
            "2": { "name": "entity.name.namespace.djinn" }
          }
        },
        {
          "match": "\\b(operator)\\s*([^\\sA-Za-z0-9_(]+)",
          "captures": {
            "1": { "name": "keyword.other.operator.djinn" },
            "2": { "name": "entity.name.function.operator.djinn" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.djinn", "match": "\\b(if|else|for|while|do|switch|case|default|break|continue|return|yield|throw|try|in|is|where|require|ensure)\\b" },
        { "name": "keyword.control.async.djinn", "match": "\\b(async|await|spawn)\\b" },
        { "name": "keyword.other.throws.djinn", "match": "\\bthrows\\b" },
        { "name": "storage.modifier.djinn", "match": "\\b(public|private|static|extern|const|constexpr|consteval|mut|unsafe|macro)\\b" },
        { "name": "keyword.operator.new.djinn", "match": "\\bnew\\b" },
        { "name": "variable.language.this.djinn", "match": "\\bthis\\b" },
        { "name": "storage.type.auto.djinn", "match": "\\b(auto|void)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.djinn", "match": "\\b(i1|i8|i16|i32|i64|i128|u1|u8|u16|u32|u64|u128|f16|f32|f64|bool|size|size_long|str|string|ptr|arr|optional|result|task|object)\\b" },
        { "name": "entity.name.type.class.djinn", "match": "\\b[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\\b(?!\\s*\\()" },
        { "name": "entity.name.type.class.djinn", "match": "\\b[A-Z](?![A-Za-z0-9_])" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.djinn", "match": "\\b(true|false|null)\\b" },
        { "name": "constant.other.enum.djinn", "match": "\\b[A-Z][A-Z0-9_]+\\b" }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "entity.name.function.djinn", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*(<[^<>()]*>)?\\s*\\()" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.djinn", "match": "=>|->" },
        { "name": "keyword.operator.range.djinn", "match": "\\.\\.\\.|\\.\\.=|\\.\\." },
        { "name": "keyword.operator.null.djinn", "match": "\\?\\?=|\\?\\?|\\?\\.|!\\." },
        { "name": "keyword.operator.scope.djinn", "match": "::" },
        { "name": "keyword.operator.assignment.djinn", "match": "<<=|>>=|[+\\-*/%&|^]=|=(?!=)" },
        { "name": "keyword.operator.comparison.djinn", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.logical.djinn", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.arithmetic.djinn", "match": "\\+\\+|--|<<|>>|[+\\-*/%&|^~]" },
        { "name": "keyword.operator.ternary.djinn", "match": "\\?|:" }
      ]
    }
  }
}
