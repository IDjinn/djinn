<?xml version="1.0" encoding="utf-8"?>
<!-- Visual Studio debugger (cppvsdbg) visualizers for djinnc debug info. Loaded through "visualizerFile" by the Djinn launch provider. -->
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <!-- untyped `ptr`: an opaque handle, emitted by djinnc as struct handle { void* address } -->
  <Type Name="handle">
    <DisplayString Condition="address == 0">[handle NULL]</DisplayString>
    <DisplayString>[handle {(void*)address}]</DisplayString>
    <Expand>
      <Item Name="Address">address</Item>
    </Expand>
  </Type>

  <!-- arr&lt;T&gt;: data pointer plus length; shows the elements instead of the raw fields -->
  <Type Name="arr&lt;*&gt;">
    <DisplayString Condition="length == 0">[0] {{}}</DisplayString>
    <DisplayString>[{length}] {{ ...}}</DisplayString>
    <Expand>
      <Item Name="[length]">length</Item>
      <Item Name="[data]">(void*)data</Item>
      <ArrayItems>
        <Size>length</Size>
        <ValuePointer>data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>
</AutoVisualizer>
