import std::libc;
import testing;

struct Work {
    i64 rounds;
}

struct Spin {
    [Test]
    Work prepared() {
        Work work = { .rounds = 200000 };
        return work;
    }

    [Test]
    void ordinary() {
        Expect.equal(1, 1);
    }

    [Bench(2, 5)]
    void spin(Work work) {
        mut i64 total = 0;
        for (mut i64 i = 0; i < work.rounds; i = i + 1) {
            total = total + i % 7;
        }
        Expect.is_true(total > 0);
    }

    [Bench(1, 3)]
    void tiny() {
        Expect.equal(2, 2);
    }
}
