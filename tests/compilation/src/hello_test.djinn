import testing;
import djinnc::testing;

struct Hello {
    [Test]
    Compilation seven() {
        return Compilation.of("hello_seven", "i32 main() { return 7; }");
    }

    [Test]
    void has_no_diagnostics([From("seven")] Compilation compilation) {
        compilation.diagnostics(Expected.create());
    }

    [Test]
    void emits_the_constant([From("seven")] Compilation compilation) {
        compilation.ir(Expected.ir_contains("ret i32 7"));
    }

    [Test]
    void exits_with_seven([From("seven")] Compilation compilation) {
        compilation.runs(Expected.exit(7));
    }
}

struct Broken {
    [Test]
    Compilation broken() {
        return Compilation.of("broken_source", "i32 main() { return missing; }");
    }

    [Test]
    void reports_the_unknown_name([From("broken")] Compilation compilation) {
        compilation.diagnostics(Expected.error(3002));
    }
}
