import std::util;
import std::types;
namespace app;

i32 main() {
    Version older = { .major = 1, .minor = 2, .patch = 3 };
    Version newer = { .major = 1, .minor = 3, .patch = 0 };
    mut i32 total = 0;
    if (older < newer) { total = total + 1; }
    if (newer >= older) { total = total + 2; }
    if (older != newer) { total = total + 4; }
    return total;
}
