import std::io;
import std::types;
namespace app;

i32 main() {
    FILE* file = fopen("djinn_std_io.tmp", "wb");
    if (file == null) { return 1; }
    fputs("djinn", file);
    fclose(file);
    FILE* again = fopen("djinn_std_io.tmp", "rb");
    if (again == null) { return 2; }
    i32 first = getc(again);
    fclose(again);
    remove("djinn_std_io.tmp");
    return first;
}
