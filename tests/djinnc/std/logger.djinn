import std::logger;
import std::types;
namespace app;

i32 main() {
    Logger log = Logger("std");
    Logger same = Logger("std");
    Logger other = Logger("other");
    log.info("ready");
    if (log.log != same.log) {
        return 1;
    }
    if (log.log == other.log) {
        return 2;
    }
    return 0;
}
