import std::util;
import std::types;
namespace app;

bool valid(str text) {
    return switch Version.parse(text) { Value v -> true, Empty -> false };
}

Version version(str text) {
    return switch Version.parse(text) { Value v -> v, Empty -> Version.NONE };
}

i32 main() {
    str[] accepted = [
        "0.0.4", "1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-0.3.7", "1.0.0-x.7.z.92",
        "1.0.0-x-y-z.--", "1.0.0-alpha+001", "1.0.0+20130313144700",
        "1.0.0-beta+exp.sha.5114f85", "1.0.0+21AF26D3----117B344092BD"
    ];
    for (mut i32 i = 0; i < 10; i = i + 1) {
        if (!valid(accepted[i])) { return 1 + i; }
    }

    str[] rejected = [
        "", "1", "1.2", "01.2.3", "1.02.3", "1.2.03", "1.2.3-", "1.2.3-01",
        "1.2.3-a..b", "1.2.3+", "1.2.3-a+", "1.2.3 ", "v1.2.3", "1.2.3.4"
    ];
    for (mut i32 i = 0; i < 14; i = i + 1) {
        if (valid(rejected[i])) { return 20 + i; }
    }

    str[] ordered = [
        "1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-alpha.beta", "1.0.0-beta", "1.0.0-beta.2",
        "1.0.0-beta.11", "1.0.0-rc.1", "1.0.0", "2.0.0", "2.1.0", "2.1.1", "10.0.0"
    ];
    for (mut i32 i = 0; i + 1 < 12; i = i + 1) {
        Version low = version(ordered[i]);
        Version high = version(ordered[i + 1]);
        if (!(low < high) || !(high > low) || low == high || !(low != high)) { return 40 + i; }
    }

    if (!(version("1.0.0+first") == version("1.0.0+second"))) { return 60; }
    if (Version.identical(version("1.0.0+first"), version("1.0.0+second"))) { return 61; }
    if (!version("1.0.0-rc.1").is_prerelease() || version("1.0.0").is_prerelease()) { return 62; }
    Version parsed = version("3.4.5-beta.2+build.9");
    if (parsed.major != 3 || parsed.minor != 4 || parsed.patch != 5) { return 63; }
    return 0;
}
