import std::sys;
import std::types;
namespace app;

[TestPolicy(retry = 2, timeout = 60000)]
i32 flaky() {
    return 1;
}

i32 main() {
    MethodInfo* info = typeof(flaky);
    TestPolicy* policy = (TestPolicy*)info.attrs[0].payload;
    if (policy.retry != 2) {
        return 1;
    }
    if (policy.timeout != 60000) {
        return 2;
    }
    return 0;
}
