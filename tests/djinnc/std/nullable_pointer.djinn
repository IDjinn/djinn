import std::types;
namespace app;

struct Box {
    i32 value;
}

i32 read(Box*? box) {
    return switch box { Value found -> found.value, Empty -> 0 - 1 };
}

i32 main() {
    Box local = { .value = 7 };
    Box* safe = &local;
    mut Box*? maybe = null;
    i32 empty = read(maybe);
    maybe = safe;
    return read(maybe) + read(null) + read(safe) + empty;
}
