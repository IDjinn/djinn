import std::types;
namespace app;

optional<i32> find(i32 x) {
    if (x > 0) { return optional::Value(x); }
    return optional::Empty();
}

result<i32, i32> check(i32 x) {
    if (x > 0) { return result::Ok(x * 2); }
    return result::Error(9);
}

i32 main() {
    i32 some = switch find(4) { Value v -> v, Empty -> 100 };
    i32 none = switch find(-1) { Value v -> v, Empty -> 1 };
    i32 good = switch check(5) { Ok v -> v, Error e -> 1000 };
    i32 bad = switch check(-5) { Ok v -> v, Error e -> e };
    return some + none + good + bad;
}
