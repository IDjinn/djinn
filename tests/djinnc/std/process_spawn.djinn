import std::sys;
import std::types;
import std::libc;
namespace app;

i32 expect_success(void* child) {
    if (!Process.wait(child, 20000)) { return 10; }
    if (Process.exit_code(child) != 0) { return 11; }
    if (Process.stdout_length(child) == 0) { return 12; }
    return 0;
}

i32 expect_failure(void* child) {
    if (!Process.wait(child, 20000)) { return 20; }
    if (Process.exit_code(child) == 0) { return 21; }
    if (Process.stderr_length(child) == 0) { return 22; }
    return 0;
}

i32 main() {
    i32 first = switch Process.start("clang --version", "", 0) {
        Value child -> expect_success(child),
        Empty -> 30
    };
    if (first != 0) { return first; }
    i32 second = switch Process.start("clang --no-such-flag-xyz", "", 0) {
        Value child -> expect_failure(child),
        Empty -> 31
    };
    return second;
}
