import std::sys;
import std::types;
import std::libc;
namespace app;

i32 main() {
    if (Process.argc() < 1) { return 1; }
    i32 found = switch Process.env("PATH") { Value path -> (i32)strlen(path), Empty -> 0 };
    if (found == 0) { return 2; }
    i32 missing = switch Process.env("DJINN_NO_SUCH_VARIABLE") { Value path -> 1, Empty -> 0 };
    if (missing != 0) { return 3; }
    return 0;
}
