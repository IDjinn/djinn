namespace mathlib;

macro twice {
    (expression v) => { v + v }
}

unsafe static mut i32 calls = 0;

[Reflect]
struct Counter {
    mut i32 value;

    public void bump() {
        this.value = this.value + 1;
        calls = calls + 1;
    }

    public i32 get() {
        return this.value;
    }

    public i32 get(i32 extra) {
        return this.get() + extra;
    }
}

struct Box<T> {
    T item;

    public T take() {
        return this.item;
    }
}

constexpr i32 cube(i32 x) {
    return x * x * x;
}

public i32 square(i32 x) {
    // secret implementation detail
    return x * x;
}

public i32 total_calls() {
    return calls;
}
