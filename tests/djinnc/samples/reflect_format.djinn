struct Pair {
    i32 left;
    i32 right;
}

i32 total(...args) {
    mut i32 sum = 0;
    for (mut i32 i = 0; i < (i32)args.length; i = i + 1) {
        object item = args[i];
        if (item.type.kind == 2) {
            i8** text = (i8**)item.data;
            sum = sum + (i32)strlen(text[0]);
        }
    }
    return sum;
}

i32 main() {
    return total(Pair#fields, 5, Pair#interfaces);
}
