enum Tone {
    Low,
    Mid,
    High,
    Peak
}

i32 weight(Tone tone) {
    return switch tone {
        Low -> 1,
        Mid -> 2,
        _ -> 10
    };
}

i32 main() {
    Tone peak = Tone::Peak();
    i32 total = weight(Tone::Low()) + weight(Tone::Mid()) + weight(Tone::High()) + weight(peak);
    if (peak == Tone::Peak() && peak != Tone::Low()) {
        return total;
    }
    return 0;
}
