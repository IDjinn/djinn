attribute Tag(AttributeTarget.All);

[Reflect, Tag(7)]
struct Player {
    mut i32 hp;
    i32 maxHp;
    i8* name;

    [Tag(9)]
    public i32 heal(i32 amount) {
        return this.hp + amount;
    }
}

struct Plain {
    i32 value;
}

i32 main() {
    TypeInfoExt* info = (TypeInfoExt*)typeof(Player);
    FieldInfo* fields = info.fields;
    MethodInfo* methods = info.methods;
    AttributeInfo* tags = info.attrs;
    AttributeInfo* method_tags = methods[0].attrs;
    if (info.base.size != 16 || fields[1].offset != 4 || fields[2].name[0] != 110) {
        return 1;
    }
    if (tags[1].name[0] != 84 || tags[1].value[0] != 55 || method_tags[0].value[0] != 57) {
        return 2;
    }
    TypeInfo* plain = typeof(Plain);
    TypeInfo* number = typeof(i32);
    TypeInfo* unsigned = typeof(u8);
    if (plain.kind != 3 || number.kind != 0 || unsigned.kind != 4) {
        return 3;
    }
    return (i32)info.fieldCount * 10 + (i32)info.methodCount + (i32)fields[0].flags * 100;
}
