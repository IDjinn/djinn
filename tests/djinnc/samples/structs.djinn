struct Kind {
    const i32 SMALL = 3;
    const i32 LARGE = 40;
}

struct Counter {
    i32 total;
    i32 steps;

    public static Counter* create(i32 start) {
        Counter* counter = (Counter*)malloc(sizeof(Counter));
        counter.total = start;
        counter.steps = 0;
        return counter;
    }

    public void add(i32 amount) {
        this.total = this.total + amount;
        this.bump();
    }

    void bump() {
        this.steps = this.steps + 1;
    }

    public i32 summary() {
        return this.total + this.steps;
    }
}

struct Pair {
    Counter* left;
    Counter* right;
}

extern "C" {
    void* malloc(u64 size);
}

i32 main() {
    Pair* pair = (Pair*)malloc(sizeof(Pair));
    pair.left = Counter.create(Kind.SMALL);
    pair.right = Counter.create(Kind.LARGE);
    pair.left.add(2);
    pair.right.add(1);
    return pair.left.summary() + pair.right.summary();
}
