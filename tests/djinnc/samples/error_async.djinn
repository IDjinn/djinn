struct OddError {
    i32 value;

    OddError(i32 value) {
        this.value = value;
    }
}

async i32 half(i32 value) throws(OddError) {
    if (value % 2 != 0) {
        throw OddError(value);
    }
    return value / 2;
}

async i32 run() {
    i32 first = try await half(8) ?: -1;
    i32 second = try await half(7) ?: 20;
    return first + second;
}

i32 main() {
    i32 total = await run();
    return total;
}
