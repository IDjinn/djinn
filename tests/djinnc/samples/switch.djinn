i32 classify(i32 n) {
    switch (n) {
        case 1:
            return 10;
        case 2:
            return 20;
        default:
            return 5;
    }
    return 0;
}

i32 main() {
    mut i32 total = classify(1) + classify(2) + classify(9);
    for (mut i32 i = 0; i < 6; i = i + 1) {
        switch (i) {
            case 0:
                continue;
            case 3:
                break;
            default:
                total = total + 1;
        }
        total = total + 10;
    }
    return total;
}
