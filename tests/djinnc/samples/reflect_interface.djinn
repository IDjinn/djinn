interface Drawable {
    i32 sides;
    i32 area();
    i32 scale(i32 factor, i64 offset);
}

struct Square {
    i32 sides;
}

impl Drawable for Square {
    i32 area() {
        return this.sides * this.sides;
    }

    i32 scale(i32 factor, i64 offset) {
        return this.sides * factor + (i32)offset;
    }
}

[Reflect]
struct Marked : interface Drawable {
    i32 sides;

    i32 area() {
        return 1;
    }

    i32 scale(i32 factor, i64 offset) {
        return factor;
    }
}

i32 main() {
    TypeInfo* info = typeof(Drawable);
    TypeInfoExt* ext = Reflection.ext(info);
    TypeInfo* small = typeof(i32);
    if (ext == null || info.kind != 9 || ext.fieldCount != 1 || ext.methodCount != 2 || ext.fields[0].name[0] != 115) {
        return 1;
    }
    MethodInfo* scale = Reflection.method(ext, "scale");
    if (scale == null || scale.paramCount != 2 || scale.params[0].typeId != small.id || scale.params[1].name[0] != 111) {
        return 2;
    }
    TypeInfoExt* marked = Reflection.ext(typeof(Marked));
    if (!Reflection.implements(marked, "Drawable") || scale.funcPtr != null) {
        return 3;
    }
    return (i32)ext.methodCount * 10 + (i32)ext.fieldCount;
}
