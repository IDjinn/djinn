i128 to_signed(f64 value) {
    return (i128)value;
}

u128 to_unsigned(f32 value) {
    return (u128)value;
}

f64 from_signed(i128 value) {
    return (f64)value;
}

f32 from_unsigned(u128 value) {
    return (f32)value;
}

i32 main() {
    i128 big = (i128)1 << 100;
    if (to_signed(0.0 - 3.5) != 0 - 3) { return 1; }
    if (to_signed(1267650600228229401496703205376.0) != big) { return 2; }
    if (to_unsigned(16777216.0) != 16777216) { return 3; }
    if (from_signed(0 - big) != 0.0 - 1267650600228229401496703205376.0) { return 4; }
    if (from_signed(7) != 7.0) { return 5; }
    if (from_unsigned((u128)1 << 64) != 18446744073709551616.0) { return 6; }
    return 0;
}
