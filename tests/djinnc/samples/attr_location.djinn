attribute Location(AttributeTarget.Parameter) {
    i8* fileName;
    i32 line;
    i32 column;
}

attribute Marker(AttributeTarget.All);

i32 line_of([Location] Location site) {
    return site.line;
}

i32 pick([Marker] i32 value, [Location] Location site) {
    return value + site.line;
}

i32 main() {
    i32 here = line_of();
    if (unlikely(here == 0)) {
        trap();
    }
    assume(here > 0);
    return here + pick(1);
}
