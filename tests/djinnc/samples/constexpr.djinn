constexpr i32 BASE = 6 * 7;
constexpr i32 NEXT = BASE + 1;
constexpr bool FLAG = NEXT > 40;
constexpr i32 LATER = EARLIER + 1;
constexpr i32 EARLIER = 9;

constexpr i32 square(i32 n) {
    return n * n;
}

constexpr i32 factorial(i32 n) {
    mut i32 result = 1;
    for (mut i32 i = 2; i <= n; i = i + 1) {
        result = result * i;
    }
    return result;
}

constexpr i32 fib(i32 n) {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

consteval i32 cube(i32 n) {
    return n * n * n;
}

constexpr i64 shifted(i64 x) {
    return x << 40;
}

constexpr f64 half(f64 x) {
    return x / 2.0;
}

i32 runtime_square(i32 n) {
    return square(n);
}

i32 main() {
    constexpr i32 local = factorial(5);
    mut i32 total = 0;
    if constexpr FLAG {
        total = total + 1;
    } else {
        total = total + 100;
    }
    total = total + local + fib(10) + cube(3) + runtime_square(4) + LATER;
    constexpr i32 high = (i32)(shifted(1) >> 40);
    total = total + high + NEXT - BASE;
    f64 h = half(9.0);
    if (h > 4.0) {
        total = total + 1;
    }
    return total;
}
