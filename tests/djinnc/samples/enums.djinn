enum Color {
    Red(),
    Green(),
    Blue()
}

enum Level {
    Low = 10,
    Mid,
    High
}

i32 weight(Color c) {
    switch (c) {
        case Color::Red():
            return 1;
        case Color::Green():
            return 2;
        default:
            return 3;
    }
    return 0;
}

i32 main() {
    Color c = Color::Green();
    mut i32 total = weight(c) + weight(Color::Blue());
    if (c == Color::Green()) {
        total = total + 10;
    }
    if (c != Color::Red()) {
        total = total + 20;
    }
    Level l = Level::Mid();
    total = total + (i32)l;
    return total;
}
