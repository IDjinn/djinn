interface Sized {
    i32 size();
}

struct Box<T> {
    T value;
    i32 count;
}

impl Box<T> {
    T get() {
        return this.value;
    }

    void put(T item) {
        this.value = item;
        this.count = this.count + 1;
    }
}

impl Sized for Box<T> {
    i32 size() {
        return this.count;
    }
}

extern "C" {
    void* malloc(u64 size);
}

i32 main() {
    Box<i32>* numbers = (Box<i32>*)malloc(sizeof(Box<i32>));
    numbers.count = 0;
    numbers.put(30);
    numbers.put(12);
    Box<i64>* wide = (Box<i64>*)malloc(sizeof(Box<i64>));
    wide.count = 0;
    wide.put(100);
    return numbers.get() + numbers.size() + (i32)wide.get() + wide.size();
}
