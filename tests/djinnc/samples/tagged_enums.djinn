enum Message {
    Empty(),
    Number(i32),
    Pair(i32, i32)
}

enum Light {
    Red(),
    Green(),
    Blue()
}

i32 describe(Message m) {
    return switch m {
        Empty -> 1,
        Number n -> n,
        Pair a b -> a * b
    };
}

i32 rank(Light l) {
    return switch l {
        Red -> 1,
        Green -> 2,
        Blue -> 3
    };
}

i32 main() {
    Message a = Message::Empty();
    Message b = Message::Number(7);
    Message c = Message::Pair(3, 4);
    mut i32 total = describe(a) + describe(b) + describe(c);
    total = total + rank(Light::Blue()) + rank(Light::Red());
    return total;
}
