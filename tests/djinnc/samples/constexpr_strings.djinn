extern "C" { i32 printf(i8* format, ...); }
constexpr i8* GREETING = "hello, djinn";

constexpr i32 length(i8* text) {
    mut i32 n = 0;
    while (text[n] != 0) {
        n = n + 1;
    }
    return n;
}

constexpr i32 count_char(i8* text, i8 wanted) {
    mut i32 total = 0;
    mut i8* cursor = text;
    while (*cursor != 0) {
        if (*cursor == wanted) {
            total = total + 1;
        }
        cursor = cursor + 1;
    }
    return total;
}

constexpr i8* tail(i8* text, i32 skip) {
    return text + skip;
}

constexpr i32 LEN = length(GREETING);
constexpr i32 LS = count_char("a lazy llama", 108);

consteval i32 first_after(i8* text) { return text[7]; }

i32 main() {
    i8* rest = tail(GREETING, 7);
    printf("%s %d %d %d\n", rest, LEN, LS, first_after(GREETING));
    return LEN + LS;
}
