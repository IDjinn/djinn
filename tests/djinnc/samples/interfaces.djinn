interface Shape {
    i32 sides;
    i32 area();
}

interface Scalable {
    i32 scaled(i32 factor);
}

struct Square : interface Shape {
    i32 sides;
    i32 edge;

    i32 area() {
        return this.edge * this.edge;
    }
}

struct Rect {
    i32 sides;
    i32 w;
    i32 h;
}

impl Rect {
    i32 area() {
        return this.w * this.h;
    }
}

impl Shape for Rect {
}

impl Scalable for Rect {
    i32 scaled(i32 factor) {
        return this.area() * factor;
    }
}

extern "C" {
    void* malloc(u64 size);
}

i32 main() {
    Square* square = (Square*)malloc(sizeof(Square));
    square.sides = 4;
    square.edge = 3;
    Rect* rect = (Rect*)malloc(sizeof(Rect));
    rect.sides = 4;
    rect.w = 2;
    rect.h = 5;
    return square.area() + rect.area() + rect.scaled(2) + square.sides;
}
