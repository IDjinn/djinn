struct Data {
    i32 value;
}

i32 take(Data data) {
    return data.value;
}

i32 main() {
    Data first = { .value = 10 };
    Data mut second = first;
    mut i32 total = second.value;
    second = { .value = 20 };
    total = total + second.value;
    Data third = second;
    i32 copy = 5;
    i32 other = copy;
    return total + third.value + copy + other + take(third);
}
