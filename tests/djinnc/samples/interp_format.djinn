extern "C" {
    i32 printf(i8* format, ...);
}

i32 main() {
    i32 count = 42;
    i32 negative = -7;
    f64 ratio = 3.14159;
    str view = "abcdef";
    bool ready = true;

    string right = $"[{count:6}]";
    printf("%s\n", right.ptr());
    string left = $"[{count:-6}]";
    printf("%s\n", left.ptr());
    string zeros = $"[{count:06}] [{negative:06}]";
    printf("%s\n", zeros.ptr());
    string fixed = $"[{ratio:.2}] [{ratio:8.3}] [{ratio:-8.1}] [{ratio:08.2}]";
    printf("%s\n", fixed.ptr());
    string text = $"[{view:8}] [{view:-8}] [{view:.3}] [{view:6.2}]";
    printf("%s\n", text.ptr());
    string flags = $"[{ready:7}] [{count + 1:4}] [{count * 2:3}]";
    printf("%s\n", flags.ptr());
    string wide = $"[{count:1}] [{count:2}]";
    printf("%s\n", wide.ptr());

    mut i32 total = 0;
    for (auto i in 0..4) {
        total = total + i;
    }
    for (auto j in [1..3]) {
        total = total + j;
    }
    return total + (i32)right.length;
}
