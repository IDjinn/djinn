i32 check(i32 value) throws(bool) {
    if (value < 0) {
        throw true;
    }
    return value;
}

i32 main() {
    i32 first = switch check(4) {
        Result v -> v,
        bool e -> 100
    };
    i32 second = switch check(-1) {
        Result v -> v,
        bool e -> 3
    };
    return first + second;
}
