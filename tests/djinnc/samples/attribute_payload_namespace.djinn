namespace app;

attribute Limits(AttributeTarget.All) {
    i32 first;
    i32 second;
}

[Limits(second = 20, first = 3)]
i32 target() {
    return 1;
}

i32 main() {
    MethodInfo* info = typeof(target);
    Limits* limits = (Limits*)info.attrs[0].payload;
    return limits.first + limits.second;
}
