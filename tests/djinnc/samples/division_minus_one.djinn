i32 divide(i32 left, i32 right) {
    return left / right;
}

i32 main() {
    i64 wide = (0 - (i64)9223372036854775807) / 7;
    i32 minimum = 0 - 2147483647 - 1;
    i32 half = divide(minimum, 2);
    mut i32 value = 0 - 20;
    value /= 0 - 2;
    return divide(0 - 7, 0 - 1) + divide(half, half) + value - 8 + (i32)(wide / wide);
}
