attribute Only(AttributeTarget.All) {
    bool windows;
    bool linux;
    i32 pointer;
}

[Only(Platform.Windows, Platform.Linux, Runtime.PointerSize)]
i32 target() {
    return 1;
}

i32 main() {
    MethodInfo* info = typeof(target);
    Only* only = (Only*)info.attrs[0].payload;
    mut i32 result = 0;
    if (only.windows != only.linux) { result = 1; }
    return result + only.pointer * 10;
}
