enum Tone {
    A(),
    B(),
    C()
}

enum Shade {
    X(),
    Y()
}

struct Holder {
    Tone kind;
    u32 token;
}

i32 main() {
    Holder h = { .kind = Tone::C(), .token = 2 };
    Tone back = Tone::C();
    mut i32 total = 0;
    if (h.kind == back) { total = total + 1; }
    if (h.kind != Tone::A()) { total = total + 2; }
    if (h.kind == Tone::B()) { total = total + 100; }
    total = total + h.kind.getValue();
    Shade o = Shade::Y();
    total = total + o.getValue();
    return total;
}
