struct Pair {
    i32 a;
    i32 b;
}

usize measure(usize count) {
    return count * (usize)sizeof(Pair);
}

i32 main() {
    usize bytes = measure(3);
    isize delta = 0 - 5;
    usize tag = 7;
    isize back = 2;
    isize mixed = delta + (isize)bytes + (isize)tag + back;
    return (i32)mixed;
}
