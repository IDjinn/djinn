struct Point {
    i32 x;
    i32 y;

    Point(i32 x, i32 y) {
        this.x = x;
        this.y = y;
    }

    i32 scaled(i32 factor, i32 offset) {
        return this.x * factor + this.y + offset;
    }
}

struct Pair<K, V> {
    K first;
    V second;

    Pair(K first, V second) {
        this.first = first;
        this.second = second;
    }
}

i32 clamp(i32 value, i32 low, i32 high) {
    if (value < low) {
        return low;
    }
    if (value > high) {
        return high;
    }
    return value;
}

i32 main() {
    Point a = Point(y: 4, x: 3);
    Point* b = new Point(x: 1, y: 2);
    Pair<i32, i64> pair = Pair<i32, i64>(second: 5, first: 6);
    i32 low = clamp(50, high: 10, low: 0);
    return a.x * 10 + a.y + b.scaled(offset: 100, factor: 2) + pair.first + (i32)pair.second + low;
}
