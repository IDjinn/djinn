[Align(16)]
struct Vec4 {
    i32 x;
    i32 y;
}

struct Math {
    [ForceInline]
    [Hot]
    public static i32 add(i32 a, i32 b) {
        return a + b;
    }

    [NoInline, Cold]
    public static i32 rare() {
        return 5;
    }

    [Llvm("mustprogress")]
    public static i32 twice(i32 value) {
        return value * 2;
    }
}

[Deprecated(message = "use add")]
i32 old_add(i32 a, i32 b) {
    return a + b;
}

[NoRecurse]
i32 main() {
    Vec4 v = { .x = 1, .y = 2 };
    return Math.add(v.x, v.y) + Math.rare() + Math.twice(4) + old_add(1, 1);
}
