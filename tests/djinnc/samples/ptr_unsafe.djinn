unsafe i32 read_second(ptr<i32> values) {
    return values[1];
}

i32 main() {
    i32 first = 5;
    i32 second = 9;
    i32* typed = &first;
    ptr<i32> raw = (ptr<i32>)typed;
    unsafe {
        i32 loaded = *raw;
        if (loaded != 5) {
            return 1;
        }
        ptr<i8> bytes = (ptr<i8>)raw;
        ptr<i8> moved = bytes + 4;
        ptr<i32> back = (ptr<i32>)moved;
        i32* checked = (i32*)back;
        if (checked == null) {
            return 2;
        }
    }
    return second;
}
