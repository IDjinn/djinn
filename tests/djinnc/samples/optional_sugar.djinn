union optional<T> {
    Some(T),
    None()
}

struct Pair {
    i32 left;
    i32 right;
}

Pair*? find(Pair* pair, bool present) {
    if (present) {
        return optional<Pair*>::Some(pair);
    }
    return optional<Pair*>::None();
}

i32? half(i32 value) {
    if (value % 2 == 0) {
        return optional<i32>::Some(value / 2);
    }
    return optional<i32>::None();
}

i32 main() {
    mut Pair pair = { .left = 3, .right = 4 };
    Pair* address = &pair;
    i32 a = switch find(address, true) { Some p -> p.left, None -> 0 };
    i32 b = switch find(address, false) { Some p -> 1, None -> 10 };
    i32 c = switch half(8) { Some v -> v, None -> 0 };
    i32 d = switch half(7) { Some v -> v, None -> 20 };
    return a + b + c + d + (i32)sizeof(Pair*?);
}
