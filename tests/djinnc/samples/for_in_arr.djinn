struct Bag {
    i32[] items;
}

i32[] make() {
    return [4, 5, 6];
}

i32 sum_bag(Bag* bag) {
    mut i32 total = 0;
    for (i32 item in bag.items) {
        total = total + item;
    }
    return total;
}

i32 main() {
    i32[] numbers = [1, 2, 3, 4];
    mut i32 total = 0;
    for (i32 n in numbers) {
        total = total + n;
    }
    if (total != 10) { return 1; }

    mut i32 skipped = 0;
    for (auto n in numbers) {
        if (n == 2) { continue; }
        if (n == 4) { break; }
        skipped = skipped + n;
    }
    if (skipped != 4) { return 2; }

    mut i32 produced = 0;
    for (i32 n in make()) {
        produced = produced + n;
    }
    if (produced != 15) { return 3; }

    for (i32 n in [10, 20]) {
        produced = produced + n;
    }
    if (produced != 45) { return 4; }

    Bag bag = { .items = [7, 8] };
    if (sum_bag(&bag) != 15) { return 5; }

    mut i32 nested = 0;
    for (i32 a in numbers) {
        for (i32 b in 0..2) {
            nested = nested + a * b;
        }
    }
    if (nested != 10) { return 6; }

    i32[] names = [1, 2];
    for (i32 n in numbers) { }
    if (numbers.length != 4 || names.length != 2) { return 7; }
    return 0;
}
