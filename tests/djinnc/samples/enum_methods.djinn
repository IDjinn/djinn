enum Light {
    Red(),
    Green(),
    Blue()
}

union Message {
    Empty(),
    Number(i32),
    Pair(i32, i32)
}

interface Ranked {
    i32 rank();
}

interface Named {
    i32 id();
}

interface Sized {
    i32 size();
}

impl Ranked for Light {
    i32 rank() {
        return switch this {
            Red -> 1,
            Green -> 2,
            Blue -> 3
        };
    }
}

impl Message {
    i32 weight() {
        return switch this {
            Empty -> 1,
            Number n -> n,
            Pair a b -> a * b
        };
    }
}

struct Crate {
    i32 number;
    i32 volume;
}

impl Named, Sized for Crate {
    i32 id() {
        return this.number;
    }

    i32 size() {
        return this.volume;
    }
}

extern "C" {
    void* malloc(u64 size);
}

i32 main() {
    Light light = Light::Green();
    Message pair = Message::Pair(3, 4);
    Message number = Message::Number(7);
    Crate* crate = (Crate*)malloc(sizeof(Crate));
    crate.number = 5;
    crate.volume = 6;
    return light.rank() + pair.weight() + number.weight() + crate.id() + crate.size();
}
