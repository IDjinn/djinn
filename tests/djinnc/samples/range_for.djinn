i32 main() {
    mut i32 total = 0;
    for (i32 i in [1..10]) {
        total = total + i;
    }
    for (i32 j in [0..4)) {
        total = total + j;
    }
    for (i32 k in 0..3) {
        for (i32 m in 0..=2) {
            if (m == 1) {
                continue;
            }
            total = total + k * m;
        }
    }
    for (i32 n in 0..100) {
        if (n == 5) {
            break;
        }
        total = total + 1;
    }
    return total;
}
