async i32 twice(i32 value) {
    return value * 2;
}

async i32 chain(i32 value) {
    i32 first = await twice(value);
    i32 second = await twice(first);
    return first + second;
}

async void noop() {
    return;
}

i32 main() {
    await noop();
    i32 direct = await twice(5);
    i32 nested = await chain(3);
    return direct + nested;
}
