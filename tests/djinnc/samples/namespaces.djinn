namespace math {
    i32 twice(i32 value) {
        return value * 2;
    }

    struct Pair {
        i32 left;
        i32 right;
    }
}

namespace text {
    i32 twice(i32 value) {
        return value * 3;
    }

    struct Pair {
        i32 first;
        i32 second;
        i32 third;
    }
}

namespace math {
    i32 offset() {
        return twice(1) + 1;
    }
}

namespace outer {
    namespace inner {
        i32 deep() {
            return 7;
        }
    }

    i32 reach() {
        return inner::deep() + 1;
    }
}

i32 main() {
    i32 sizes = (i32)sizeof(math::Pair) + (i32)sizeof(text::Pair);
    return math::twice(4) + text::twice(2) + math::offset() + outer::reach() + sizes;
}
