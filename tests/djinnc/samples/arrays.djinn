i32 sum(i32[] values) {
    mut i32 total = 0;
    for (mut u32 i = 0; i < values.length; i = i + 1) {
        total = total + values[i];
    }
    return total;
}

i32 main() {
    i32[] numbers = [1, 2, 3, 4];
    numbers[0] = 10;
    str name = "djinn";
    i64[] wide = [5, 6];
    if (name.is_empty()) {
        return 1;
    }
    return sum(numbers) + (i32)name.length + (i32)wide[1] + (i32)numbers.length + sum([7, 8]);
}
