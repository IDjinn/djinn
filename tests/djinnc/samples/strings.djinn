extern "C" {
    i32 printf(i8* format, ...);
}

struct Point {
    i32 x;
    i32 y;
}

i32 main() {
    i32 count = 3;
    i64 big = 5000000000;
    u32 small = 7;
    f64 ratio = 2.5;
    bool ready = true;
    i8* name = "djinn";
    str view = "view";
    Point p = { .x = 1, .y = 2 };

    string greeting = $"hello {name}, count={count}";
    printf("%s\n", greeting.ptr());
    string numbers = $"big={big} small={small} ratio={ratio} ready={ready}";
    printf("%s\n", numbers.ptr());
    string math = $"sum={p.x + p.y} view={view} neg={count - 6}";
    printf("%s\n", math.ptr());
    string joined = greeting + "!" + numbers;
    printf("%s\n", joined.ptr());
    string literal = "plain";
    string nested = $"[{greeting}] {literal}";
    printf("%s\n", nested.ptr());
    string braces = $"{{{count}}} and }}";
    printf("%s\n", braces.ptr());
    string plain = "{count} stays text";
    printf("%s\n", plain.ptr());
    string empty = $"only text";
    printf("%s|%d\n", empty.ptr(), (i32)empty.length);
    return (i32)nested.length;
}
