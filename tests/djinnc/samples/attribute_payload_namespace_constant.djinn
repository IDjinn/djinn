namespace app;

struct Phase {
    const i32 IR = 1;
    const i32 JIT = 2;
}

attribute Stage(AttributeTarget.All) {
    i32 mask;
}

[Stage(Phase.IR | Phase.JIT)]
i32 target() {
    return 1;
}

i32 main() {
    MethodInfo* info = typeof(target);
    Stage* stage = (Stage*)info.attrs[0].payload;
    return stage.mask;
}
