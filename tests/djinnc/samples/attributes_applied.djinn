[Align(32)]
struct Block {
    i32 a;
    i32 b;
}

struct Device {
    [Volatile]
    i32 status;
    i32 plain;
}

[Volatile]
unsafe static mut i32 ticks = 0;

[NonNull]
i32* identity(i32* value) {
    return value;
}

[Align(64)]
i32 aligned_function() {
    return 3;
}

i32 poll(Device* device) {
    mut i32 seen = 0;
    for (mut i32 i = 0; i < 3; i++) {
        seen = seen + device.status;
    }
    return seen;
}

i32 main() {
    Block block = { .a = 1, .b = 2 };
    if (sizeof(Block) != 32) { return 1; }
    mut i32 number = 7;
    i32* same = identity(&number);
    if (*same != 7) { return 2; }
    Device device = { .status = 2, .plain = 0 };
    if (poll(&device) != 6) { return 3; }
    unsafe { ticks = 5; ticks++; }
    unsafe { if (ticks != 6) { return 4; } }
    return aligned_function() + block.a + block.b - 6;
}
