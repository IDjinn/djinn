constexpr u32 mask(u32 bits) {
    return (1 << bits) - 1;
}

constexpr i32 collatz(i32 n) {
    mut i32 steps = 0;
    mut i32 value = n;
    while (value != 1) {
        if (value % 2 == 0) {
            value = value / 2;
        } else {
            value = value * 3 + 1;
        }
        steps = steps + 1;
    }
    return steps;
}

constexpr i32 pick(i32 n) {
    switch (n) {
        case 1:
            return 10;
        case 2:
            return 20;
        default:
            return 5;
    }
    return 0;
}

constexpr u8 wrapped(i32 n) {
    return (u8)(n + 250);
}

constexpr i32 sum_to(i32 n) {
    mut i32 total = 0;
    for (mut i32 i = 1; i <= n; i = i + 1) {
        if (i == 5) {
            continue;
        }
        if (i > 8) {
            break;
        }
        total = total + i;
    }
    return total;
}

i32 main() {
    return collatz(27) + pick(2) + (i32)wrapped(10) + sum_to(10) + (i32)mask(4);
}
