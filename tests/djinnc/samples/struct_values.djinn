struct Point {
    i32 x;
    i32 y;

    i32 sum() {
        return this.x + this.y;
    }
}

struct Segment {
    Point from;
    Point to;
}

Point make(i32 a, i32 b) {
    return { .x = a, .y = b };
}

i32 total(Point p) {
    return p.x + p.y;
}

i32 main() {
    Point p = make(3, 4);
    mut Point q = p;
    q.x = 10;
    auto r = make(1, 2);
    Segment s = { .from = { .x = 1, .y = 1 }, .to = r };
    return p.x + q.x + total(r) + r.sum() + s.from.x + s.to.y;
}
