union Message {
    Empty(),
    Number(i32),
    Pair(i32, i32)
}

enum Light {
    Red(),
    Green()
}

i32 score(Message m) {
    mut i32 total = 0;
    if (m is Message::Empty) {
        total = total + 1;
    }
    if (m is Message::Number n) {
        total = total + n;
    }
    if (m is Message::Pair a b) {
        total = total + a * b;
    }
    return total;
}

i32 main() {
    Light light = Light::Green();
    mut i32 total = score(Message::Empty()) + score(Message::Number(7)) + score(Message::Pair(3, 4));
    if (light is Light::Green) {
        total = total + 100;
    }
    if (light is Light::Red) {
        total = total + 1000;
    }
    return total;
}
