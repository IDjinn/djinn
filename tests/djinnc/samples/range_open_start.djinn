i32 main() {
    mut i32 total = 0;
    for (auto i in (0..4]) {
        total = total + i;
    }
    for (i32 j in (0..4)) {
        total = total + j;
    }
    for (i32 k in (1)..3) {
        total = total + k;
    }
    i32 base = 1;
    for (i32 m in (base + 1..5)) {
        total = total + m;
    }
    return total;
}
