interface Hashable {
    u64 hash();
}

impl Hashable for u8, u16, i32 {
    u64 hash() {
        return (u64)this;
    }
}

u64 digest<K>(K key) where K : Hashable {
    return key.hash();
}

i32 main() {
    u8 a = 3;
    u16 b = 4;
    i32 c = 5;
    return (i32)(digest(a) + digest(b) + digest(c));
}
