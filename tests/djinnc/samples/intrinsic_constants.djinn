i32 main() {
    mut i32 platforms = 0;
    if (Platform.Windows) { platforms++; }
    if (Platform.Linux) { platforms++; }
    if (Platform.MacOs) { platforms++; }
    if (platforms > 1) { return 1; }

    mut i32 architectures = 0;
    if (Arch.X64) { architectures++; }
    if (Arch.X86) { architectures++; }
    if (Arch.Arm64) { architectures++; }
    if (architectures > 1) { return 2; }

    mut i32 builds = 0;
    if (Build.Debug) { builds++; }
    if (Build.Release) { builds++; }
    if (builds != 1) { return 3; }

    if (Arch.X64 && Runtime.PointerSize != 8) { return 4; }
    if (Runtime.PointerSize != 4 && Runtime.PointerSize != 8) { return 5; }
    return 0;
}
