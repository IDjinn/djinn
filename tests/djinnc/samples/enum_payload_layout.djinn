enum optional<T> {
    Some(T),
    None()
}

enum Shape {
    Circle(i64),
    Rect(i32, i64),
    Label(string),
    Nothing()
}

struct Point {
    i32 x;
    i64 y;
}

i32 area(Shape shape) {
    return switch shape {
        Circle r -> (i32)r,
        Rect w h -> w * (i32)h,
        Label text -> (i32)text.length,
        Nothing -> 0
    };
}

i32 main() {
    optional<string> greeting = optional<string>::Some("hello");
    i32 a = switch greeting { Some s -> (i32)s.length, None -> 0 };
    Point p = { .x = 3, .y = 4 };
    optional<Point> boxed = optional<Point>::Some(p);
    i32 b = switch boxed { Some q -> q.x + (i32)q.y, None -> 0 };
    i32 c = area(Shape::Rect(6, 7)) + area(Shape::Label("abc")) + area(Shape::Circle(2)) + area(Shape::Nothing());
    return a + b + c;
}
