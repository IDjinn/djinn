[Reflect]
enum Kind(i32 flag, i8* name, i32 width) {
    PROGRAM(0, "Program", 7),
    IMPORT(10, "Import", 6),
    WHILE(3, "While", 5)
}

enum Plain {
    A,
    B = 5,
    C
}

i32 main() {
    TypeInfo* info = typeof(Kind);
    EnumInfo* kinds = Reflection.enumeration(info);
    if (kinds == null || info.kind != 7 || !Reflection.reflected(info)) {
        return 1;
    }
    VariantInfo* imported = Reflection.variant(kinds, 10);
    if (imported == null || imported.name[0] != 73 || imported.payloadCount != 0) {
        return 2;
    }
    HeaderInfo* name = Reflection.header(kinds, "name");
    HeaderInfo* width = Reflection.header(kinds, "width");
    HeaderInfo* flag = Reflection.header(kinds, "flag");
    if (name == null || width == null || flag == null || Reflection.header(kinds, "missing") != null) {
        return 3;
    }
    i8* text = Reflection.header_text(name, 10);
    if (text[1] != 109 || Reflection.header_integer(width, 3) != 5 || Reflection.header_integer(flag, 3) != 3) {
        return 4;
    }
    VariantInfo* named = Reflection.variant_named(kinds, "WHILE");
    if (named == null || named.value != 3) {
        return 5;
    }
    TypeInfo* plain = typeof(Plain);
    if (plain.kind != 7 || Reflection.reflected(plain) || Reflection.enumeration(plain) != null) {
        return 6;
    }
    return (i32)kinds.variantCount * 10 + (i32)kinds.headerCount;
}
