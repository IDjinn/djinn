struct Account {
    i32 balance;
    i32 limit { get; set; }
    i32 doubled => balance * 2;
    i32 available {
        get => balance + limit;
    }
    i32 level {
        get { return balance / 10; }
        set { balance = value * 10; }
    }
}

struct Wrapper {
    Account account;
    Account inner => account;
}

i32 main() {
    Account account = { .balance = 50 };
    account.limit = 7;
    account.level = 8;
    account.level = account.level + 1;
    Wrapper wrapper = { .account = account };
    i32 first = account.doubled + account.available + account.limit;
    i32 second = wrapper.inner.balance;
    return first + second - 200;
}
