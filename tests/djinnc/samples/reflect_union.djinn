attribute Tag(AttributeTarget.All);

interface Named {
    i32 sides();
}

[Reflect, Tag(4)]
union Shape {
    Circle(i64),
    Rect(i32, i64),
    Nothing()
}

impl Named for Shape {
    [Tag(2)]
    i32 sides() {
        return switch this {
            Circle r -> 0,
            Rect w h -> 4,
            Nothing -> 0
        };
    }
}

i32 main() {
    TypeInfo* info = typeof(Shape);
    EnumInfo* shapes = Reflection.enumeration(info);
    TypeInfoExt* ext = Reflection.ext(info);
    if (shapes == null || ext == null || info.kind != 8) {
        return 1;
    }
    VariantInfo* rect = Reflection.variant_named(shapes, "Rect");
    if (rect == null || rect.value != 1 || rect.payloadCount != 2) {
        return 2;
    }
    TypeInfo* small = typeof(i32);
    TypeInfo* wide = typeof(i64);
    if (rect.payloadTypeIds[0] != small.id || rect.payloadTypeIds[1] != wide.id || rect.payloadOffsets[0] != 0 || rect.payloadOffsets[1] != 8) {
        return 3;
    }
    MethodInfo* sides = Reflection.method(ext, "Shape.sides");
    if (sides == null || sides.attrs[0].value[0] != 50 || ext.attrs[1].value[0] != 52) {
        return 4;
    }
    if (!Reflection.implements(ext, "Named") || Reflection.implements(ext, "Other")) {
        return 5;
    }
    return (i32)shapes.variantCount * 10 + (i32)ext.methodCount;
}
