extern i32 strlen(i8* text);

enum Kind(i32 flag, i8* name, i32 width) {
    PROGRAM(0, "Program", 7),
    IMPORT(10, "Import", 6),
    WHILE(3, "While", 5)
}

i32 weigh(Kind kind) {
    return kind.flag * 100 + kind.width;
}

i32 main() {
    Kind first = Kind::IMPORT;
    Kind second = Kind::WHILE;
    i32 total = weigh(first) + weigh(second) + strlen(Kind::PROGRAM.name) + strlen(second.name) + first.getValue();
    if (first == Kind::IMPORT && second != Kind::PROGRAM) {
        return total - 1333;
    }
    return 99;
}
