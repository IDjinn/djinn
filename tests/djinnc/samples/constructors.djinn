struct Point {
    i32 x;
    i32 y;

    Point(i32 x, i32 y) {
        this.x = x;
        this.y = y;
    }

    i32 sum() {
        return this.x + this.y;
    }
}

struct Counter {
    i32 count;

    Counter() {
        this.count = 5;
        this.bump();
    }

    void bump() {
        this.count = this.count + 1;
    }
}

struct Box<T> {
    T value;

    Box(T v) {
        this.value = v;
    }

    T get() {
        return this.value;
    }
}

struct Pair<K, V> {
    K first;
    V second;

    Pair(K a, V b) {
        this.first = a;
        this.second = b;
    }
}

i32 main() {
    Point p = Point(10, 20);
    Point* heap = new Point(1, 2);
    Counter c = Counter();
    Box<i32> box = Box<i32>(7);
    Box<i32>* shared = new Box<i32>(9);
    Pair<i32, i64> pair = Pair<i32, i64>(3, 4);
    return p.sum() + heap.sum() + c.count + box.get() + shared.get() + pair.first + (i32)pair.second;
}
