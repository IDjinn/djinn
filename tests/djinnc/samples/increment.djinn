struct Counter {
    i32 value;
}

constexpr i32 triangle(i32 limit) {
    mut i32 total = 0;
    for (mut i32 i = 0; i < limit; i++) {
        total = total + i;
    }
    return total;
}

i32 main() {
    mut i32 a = 5;
    i32 old = a++;
    i32 fresh = ++a;
    i32 down = a--;
    i32 under = --a;
    if (old != 5 || fresh != 7 || down != 7 || under != 5 || a != 5) { return 1; }

    mut Counter counter = { .value = 10 };
    counter.value++;
    ++counter.value;
    if (counter.value != 12) { return 2; }

    i32[] values = [1, 2, 3];
    mut i32 at = 0;
    values[at++] = 10;
    values[at++] = 20;
    if (at != 2 || values[0] != 10 || values[1] != 20 || values[2] != 3) { return 3; }

    mut f64 ratio = 1.5;
    ratio++;
    if (ratio != 2.5) { return 4; }

    mut u8 small = 255;
    small++;
    if (small != 0) { return 5; }

    mut i32 loops = 0;
    for (mut i32 i = 0; i < 4; i++) { loops++; }
    if (loops != 4) { return 6; }
    if (triangle(5) != 10) { return 7; }
    return 0;
}
