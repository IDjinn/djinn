interface Hashable {
    u64 hash();
}

impl Hashable for u64 {
    u64 hash() {
        return this * 31 + 7;
    }
}

impl Hashable for i32 {
    u64 hash() {
        return (u64)(u32)this + 1;
    }
}

impl bool {
    i32 weight() {
        if (this) {
            return 10;
        }
        return 1;
    }
}

u64 digest<K>(K key) where K : Hashable {
    return key.hash();
}

i32 main() {
    u64 big = 3;
    i32 small = 4;
    var a = big.hash();
    auto b = small.hash();
    bool ready = true;
    u64 c = digest(big) + digest(small);
    return (i32)(a + b + c) + ready.weight();
}
