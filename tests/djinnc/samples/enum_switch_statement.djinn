enum Tone {
    Low,
    Mid,
    High
}

i32 weigh(Tone tone) {
    mut i32 total = 0;
    switch (tone) {
        case Low:
            total = 1;
        case Tone::Mid:
            total = 20;
        default:
            total = 300;
    }
    return total;
}

i32 main() {
    Tone peak = Tone::High;
    return weigh(Tone::Low) + weigh(Tone::Mid) + weigh(peak) - 300;
}
