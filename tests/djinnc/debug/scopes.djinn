struct Node {
    i32 value;
    Node*? next;
}

i32 walk(Node* head) {
    mut i32 sum = 0;
    mut Node*? current = head;
    while (current != null) {
        i32 inner = current.value * 2;
        sum = sum + inner;
        current = current.next;
    }
    return sum;
}

i32 main() {
    Node last = { .value = 5, .next = null };
    Node first = { .value = 7, .next = &last };
    return walk(&first);
}
