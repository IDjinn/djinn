import testing;

struct Left {
    i32 value;
}

struct Right {
    i32 value;
}

struct Case {
    [Test]
    Left first(Right other) {
        Left value = { .value = other.value };
        return value;
    }

    [Test]
    Right second(Left other) {
        Right value = { .value = other.value };
        return value;
    }
}
