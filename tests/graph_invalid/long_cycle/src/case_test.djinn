import testing;

struct A {
    i32 value;
}

struct B {
    i32 value;
}

struct C {
    i32 value;
}

struct D {
    i32 value;
}

struct Case {
    [Test]
    D start() {
        D value = { .value = 1 };
        return value;
    }

    [Test]
    A a(D d, C c) {
        A value = { .value = d.value + c.value };
        return value;
    }

    [Test]
    B b(A a) {
        B value = { .value = a.value };
        return value;
    }

    [Test]
    C c(B b) {
        C value = { .value = b.value };
        return value;
    }
}
