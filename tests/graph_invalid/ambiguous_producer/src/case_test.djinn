import testing;

struct Session {
    i32 token;
}

struct Case {
    [Test]
    Session first() {
        Session value = { .token = 1 };
        return value;
    }

    [Test]
    Session second() {
        Session value = { .token = 2 };
        return value;
    }

    [Test]
    void needs(Session session) {
        Expect.equal(1, session.token);
    }
}
