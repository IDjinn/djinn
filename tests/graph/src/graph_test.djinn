struct Root {
    i64 id;
}

struct Left {
    i64 id;
}

struct Right {
    i64 id;
}

struct Diamond {
    [Test]
    unsafe Root root() {
        Gate.check("root");
        Root value = { .id = __djinn_now_us() };
        return value;
    }

    [Test]
    Left left(Root root) {
        Gate.check("left");
        Left value = { .id = root.id };
        return value;
    }

    [Test]
    Right right(Root root) {
        Gate.check("right");
        Right value = { .id = root.id };
        return value;
    }

    [Test]
    void join(Left left, Right right) {
        Gate.check("join");
        Expect.equal(left.id, right.id, "both branches must come from one run of root");
    }
}

struct Seed {
    i32 value;
}

struct Fan {
    [Test]
    Seed seed() {
        Seed value = { .value = 21 };
        return value;
    }

    [Test]
    void fan_0(Seed seed) {
        Gate.check("fan_0");
        Expect.equal(21, (i64)seed.value);
    }

    [Test]
    void fan_1(Seed seed) {
        Gate.check("fan_1");
        Expect.equal(21, (i64)seed.value);
    }

    [Test]
    void fan_2(Seed seed) {
        Gate.check("fan_2");
        Expect.equal(21, (i64)seed.value);
    }

    [Test]
    void fan_3(Seed seed) {
        Gate.check("fan_3");
        Expect.equal(21, (i64)seed.value);
    }

    [Test]
    void fan_4(Seed seed) {
        Gate.check("fan_4");
        Expect.equal(21, (i64)seed.value);
    }

    [Test]
    void fan_5(Seed seed) {
        Gate.check("fan_5");
        Expect.equal(21, (i64)seed.value);
    }

    [Test]
    void fan_6(Seed seed) {
        Gate.check("fan_6");
        Expect.equal(21, (i64)seed.value);
    }

    [Test]
    void fan_7(Seed seed) {
        Gate.check("fan_7");
        Expect.equal(21, (i64)seed.value);
    }

}

struct Token {
    i32 value;
}

struct Basket {
    i32 items;
}

struct Pair {
    i32 total;
}

struct Wide {
    [Test]
    Token token() {
        Token value = { .value = 5 };
        return value;
    }

    [Test]
    Token token_admin() {
        Token value = { .value = 9 };
        return value;
    }

    [Test]
    Basket basket() {
        Basket value = { .items = 3 };
        return value;
    }

    [Test]
    Pair combine([From("token_admin")] Token token, Basket basket) {
        Pair value = { .total = token.value * basket.items };
        return value;
    }

    [Test]
    void settle(Pair pair, [From("token")] Token token) {
        Expect.equal(27, (i64)pair.total);
        Expect.equal(5, (i64)token.value);
    }

    [Test]
    void alone() {
        Expect.equal(1, 1);
    }
}

