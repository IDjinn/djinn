import std::libc;
import testing;

extern "C" {
    i64 __djinn_now_us();
}

struct Gate {
    public static unsafe void check(ptr<i8> name) {
        ptr<i8> failing = Environment.variable("GRAPH_FAIL", "");
        ptr<i8> leaving = Environment.variable("GRAPH_EXIT", "");
        if (Text.same(leaving, name)) {
            exit(3);
        }
        if (Text.same(failing, name)) {
            Expect.fail(name);
        }
    }
}

