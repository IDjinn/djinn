struct Chain {
    [Test]
    unsafe Level00 step_00() {
        Gate.check("step_00");
        Level00 level = { .depth = 0, .id = __djinn_now_us() };
        return level;
    }

    [Test]
    Level01 step_01(Level00 previous) {
        Gate.check("step_01");
        Expect.equal(0, (i64)previous.depth, "depth");
        Level01 level = { .depth = previous.depth + 1, .id = previous.id };
        return level;
    }

    [Test]
    Level02 step_02(Level01 previous) {
