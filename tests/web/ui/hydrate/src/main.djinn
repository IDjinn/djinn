import ui;
import std::types;
import std::collections;

namespace webhydrate;

struct Task {
    i64 id;
    str title;
}

struct Counter {
    i32 start;

    public unsafe Node render() {
        signal<i32> count = state(this.start);
        return html!{
            <div class="counter">
                <output id="count">{count}</output> clicks
                <button id="inc" on_click={() => count.set(count.get() + 1)}>+</button>
                {if (count.get() % 2 == 0) { <small id="parity">even</small> } else { <b id="parity">odd</b> }}
            </div>
        };
    }
}

struct Echo {
    public unsafe Node render() {
        signal<str> name = state<str>("world");
        return html!{
            <section>
                <Field label="Name" value={name}/>
                <p id="echo">hello {name}!</p>
            </section>
        };
    }
}

[Server]
struct Report {
    str quarter;

    public unsafe Node render() {
        return html!{ <article id="report"><h2>Report {this.quarter}</h2></article> };
    }
}

[Application(render: hydrate)]
struct HydrateApp {
    public unsafe Node render() {
        Task* tasks = (Task*)__djinn_alloc_zeroed((size_long)(2 * sizeof(Task)));
        Task first = { .id = 1, .title = "adopt" };
        Task second = { .id = 2, .title = "listen" };
        *(tasks + (0)) = first;
        *(tasks + (1)) = second;
        slice<Task> list = { .data = tasks, .length = 2 };
        return html!{
            <main class="page stack">
                <h1>hydrate</h1>
                <Counter start={1}/>
                <ul id="tasks">{for (Task task in list) key(task.id) { <li>{task.title}</li> }}</ul>
                <Echo/>
                <Report quarter="Q4"/>
            </main>
        };
    }
}
