import ui;
import std::types;

namespace webislands;

[Client]
struct Like {
    i32 likes;

    public unsafe Node render() {
        signal<i32> count = state(this.likes);
        return html!{ <button id="like" on_click={() => count.set(count.get() + 1)}>{count} likes</button> };
    }
}

[Application(render: server)]
struct IslandsApp {
    public unsafe Node render() {
        return html!{
            <main class="page">
                <h1>server page</h1>
                <p id="static">rendered once</p>
                <Like likes={0}/>
            </main>
        };
    }
}
