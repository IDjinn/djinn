import ui;
import std::types;

namespace webclient;

struct Counter {
    i32 start;

    public unsafe Node render() {
        signal<i32> count = state(this.start);
        return html!{
            <div class="counter">
                <output id="count">{count}</output>
                <button id="inc" on_click={() => count.set(count.get() + 1)}>+</button>
                {if (count.get() % 2 == 0) { <small id="parity">even</small> } else { <b id="parity">odd</b> }}
            </div>
        };
    }
}

struct Echo {
    public unsafe Node render() {
        signal<str> name = state<str>("world");
        return html!{
            <section>
                <Field label="Name" value={name}/>
                <p id="echo">hello {name}</p>
            </section>
        };
    }
}

struct Pages {
    public unsafe Node render() {
        return html!{
            <nav>
                <button id="go" on_click={() => Router.navigate("/about")}>about</button>
                <span id="where">{Router.path()}</span>
            </nav>
        };
    }
}

[Application(render: client)]
struct ClientApp {
    public unsafe Node render() {
        str link = "javascript:alert(1)";
        return html!{
            <main class="page stack">
                <h1>web client</h1>
                <Counter start={1}/>
                <Echo/>
                <Pages/>
                <a id="bad" href={link}>x</a>
            </main>
        };
    }
}
