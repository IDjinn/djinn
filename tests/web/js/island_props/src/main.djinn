import ui;
import std::types;
import std::collections;

namespace islandprops;

// A [Client] island gets its props from the server: the native build writes them in data-props, and the web build
// builds each island with them (a value that is missing or of another type keeps the declaration's).
[Client]
struct Badge {
    str label;
    i32 count;
    u32 big;
    bool on;
    slice<str> tags;

    public unsafe Node render() {
        signal<i32> count = state(this.count);
        return html!{
            <section class="badge">
                <p class="label">{this.label}</p>
                <output class="count">{count}</output>
                <small class="big">{this.big}</small>
                <button class="inc" on_click={() => count.set(count.get() + 1)}>add</button>
                {if (this.on) { <em class="on">on</em> }}
                <ul>{for (str tag in this.tags) { <li>{tag}</li> }}</ul>
            </section>
        };
    }
}

struct Samples {
    public static slice<str> tags(str first, str second) {
        slice<str> list = [first, second];
        return list;
    }

    // quotes, a tag, an entity, a backslash, a line break and non-ASCII text
    public static str label() {
        return "say \"hi\" <b>&amp; 'it' é ✓ \\ \n end";
    }
}

[Application(render: server)]
struct PropsApp {
    public unsafe Node render() {
        return html!{
            <main class="page">
                <p id="static">rendered once</p>
                <Badge label={Samples.label()} count={5} big={4000000000} on={true} tags={Samples.tags("a<b", "&c\"")}/>
                <Badge label={"second"} count={7} big={0} on={false} tags={Samples.tags("x", "y")}/>
            </main>
        };
    }
}
