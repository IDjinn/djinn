import ui;
import std::types;

namespace islandload;

// Four islands, one for each way the page's JavaScript can take an island over (see [Client]).
[Client(load: load)]
struct Now {
    public unsafe Node render() {
        signal<i32> count = state(0);
        return html!{ <p class="now"><button on_click={() => count.set(count.get() + 1)}>now {count}</button></p> };
    }
}

[Client]
struct Seen {
    public unsafe Node render() {
        signal<i32> count = state(0);
        return html!{ <p class="seen"><button on_click={() => count.set(count.get() + 1)}>seen {count}</button></p> };
    }
}

[Client(load: idle)]
struct Later {
    public unsafe Node render() {
        signal<i32> count = state(0);
        return html!{ <p class="later"><button on_click={() => count.set(count.get() + 1)}>later {count}</button></p> };
    }
}

[Client(load: interaction)]
struct Touched {
    public unsafe Node render() {
        signal<i32> count = state(0);
        return html!{ <p class="touched"><button on_click={() => count.set(count.get() + 1)}>touched {count}</button></p> };
    }
}

[Application(render: server)]
struct Page {
    public unsafe Node render() {
        return html!{
            <main>
                <Now/>
                <Seen/>
                <Later/>
                <Touched/>
            </main>
        };
    }
}
