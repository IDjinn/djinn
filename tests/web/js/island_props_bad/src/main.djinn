import ui;
import std::types;

namespace bad;

[Client]
struct Gauge {
    i32 fine;
    f64 level;

    public unsafe Node render() {
        return html!{ <p>{this.fine}</p> };
    }
}

[Application(render: server)]
struct BadApp {
    public unsafe Node render() {
        return html!{ <Gauge fine={1} level={2.5}/> };
    }
}
