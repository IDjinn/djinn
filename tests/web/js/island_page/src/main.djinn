import ui;
import std::types;
import std::collections;

namespace islandpage;

// A page the server renders and a client island that is adopted: the web build keeps the server's HTML (it creates no
// element for it), wires the island's button, and never carries the code that only the server runs.
[Client]
struct Counter {
    i32 start;

    public unsafe Node render() {
        signal<i32> count = state(this.start);
        return html!{
            <div class="counter">
                <output class="value">{count}</output>
                <button class="inc" on_click={() => count.set(count.get() + 1)}>add one</button>
                {if (count.get() >= 7) { <small class="lot">that is a lot</small> }}
            </div>
        };
    }
}

// Rendered by the server only: this code, and what it calls, is not part of the web build.
[Server]
struct Clock {
    public unsafe Node render() {
        return html!{ <p id="clock">built by the server at <b>{Clock.stamp()}</b></p> };
    }

    public static str stamp() {
        return "12:00";
    }
}

struct Names {
    public static str who() {
        return "Ana";
    }

    public static i32 count() {
        return 3;
    }
}

[Application(render: server)]
struct Page {
    public unsafe Node render() {
        return html!{
            <main class="page">
                <h1>The page</h1>
                <p id="hello">Hello {Names.who()}, you have {Names.count()} items.</p>
                <Clock/>
                <Counter start={5}/>
                <ul>{for (i32 i in 1..4) { <li>step {i}</li> }}</ul>
            </main>
        };
    }
}
