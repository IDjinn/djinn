import std::sys;
import std::math;

namespace math_check;

unsafe i32 main() {
    i32 low = Math.min(3, 7);
    i32 high = Math.max(0, low - 5);
    i32 distance = Math.abs(low - 10);
    f64 root = Math.sqrt(16.0);
    Console.writeSync($"{low} {high} {distance} {root} {Math.floor(2.5)}\n");
    return 0;
}
