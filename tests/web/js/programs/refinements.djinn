import std::sys;

namespace refinements_check;

struct Positive : u32 where value > 0;
struct Ratio : f64 where value >= 0.0 && value <= 1.0;
struct Offset : i64 where value > -1000 && value < 1000;

struct Share {
    Positive parts;
    Ratio of;
}

T identity<T>(T value) => value;

Positive read(u32 raw) {
    return (Positive!)raw;
}

unsafe i32 main() {
    Positive one = 1;
    Positive five = read(5u);
    Share share = { .parts = five, .of = 0.25 };
    u32 sum = one + share.parts * 2u;
    Console.writeSync($"sum {sum} share {share.of} half {share.of * 0.5}\n");
    Offset near = (Offset!)(-7);
    Console.writeSync($"offset {near} {near - (i64)1}\n");
    mut Positive[3] items = [identity(five), 9, one];
    items[2] = read(sum);
    mut u32 total = 0u;
    for (mut i32 i = 0; i < 3; i = i + 1) {
        total = total + items[i];
    }
    Console.writeSync($"total {total}\n");
    return 0;
}
