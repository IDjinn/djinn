import std::sys;

namespace templates_check;

struct Buffer<T, N> {
    T[N] items;

    public static Buffer<T, N> filled(T value) {
        mut Buffer<T, N> made = {};
        for (mut i32 i = 0; i < N; i = i + 1) {
            made.items[i] = value;
        }
        return made;
    }

    public T sum() {
        mut T total = 0;
        for (mut i32 i = 0; i < N; i = i + 1) {
            total = total + this.items[i];
        }
        return total;
    }
}

struct Pair<i32 N> {
    Buffer<i32, N> left;
    i32[N] right;
}

unsafe i32 main() {
    Buffer<i32, 4> first = Buffer<i32, 4>.filled(3);
    mut Buffer<i32, 4> second = first;
    second.items[0] = 10;
    mut Pair<2> pair = {};
    pair.left.items[1] = 5;
    pair.right[0] = 7;
    Pair<2> copy = pair;
    pair.right[0] = 1;
    mut i32[3] local = [1, 2, 3];
    i32[3] kept = local;
    local[2] = 30;
    Console.writeSync($"{first.sum()} {second.sum()} {copy.left.sum()} {copy.right[0]} {kept[2]} {local[2]}\n");
    return 0;
}
