import std::sys;

namespace lang;

// Compiled natively and with --target web: both runs must print the same lines.
struct Point {
    i32 x;
    i32 y;

    public i32 sum() {
        return this.x + this.y;
    }

    public static Point origin() {
        Point zero = { .x = 0, .y = 0 };
        return zero;
    }
}

struct Counter {
    mut i32 value;

    public void bump(i32 by) {
        this.value = this.value + by;
    }
}

struct Limits {
    const i32 MAX = 7;
}

enum Color { Red, Green, Blue }

unsafe static mut i32 calls = 0;

unsafe i32 fib(i32 n) {
    calls = calls + 1;
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

i32 apply(fn(i32) -> i32 f, i32 x) {
    return f(x);
}

str name_of(Color color) {
    switch (color) {
        case Red:
            return "red";
        case Green:
            return "green";
        default:
            return "blue";
    }
}

unsafe i32 main() {
    Point p = { .x = 3, .y = 4 };
    Console.writeSync("point {0} {1} sum {2} origin {3}\n", p.x, p.y, p.sum(), Point.origin().sum());
    mut Counter a = { .value = 1 };
    Counter b = a;
    a.bump(5);
    Console.writeSync("copy a={0} b={1}\n", a.value, b.value);
    i32 base = 10;
    Console.writeSync("closure {0}\n", apply((i32 v) => v * base, 4));
    mut i32 total = 0;
    for (i32 i in 0..10) {
        total += i * i;
    }
    mut i32 down = 5;
    while (down > 0) {
        down = down - 1;
        if (down == 2) {
            continue;
        }
        total = total + 1;
    }
    Console.writeSync("loops {0}\n", total);
    i32 big = 2147483647;
    u32 top = 4294967295;
    u8 small = 250;
    Console.writeSync("wrap {0} {1} {2} saturate {3}\n", big + 1w, top + 2w, (u8)(small + 10w), big + 5s);
    Console.writeSync("div {0} {1} mod {2} shift {3} {4}\n", 7 / 2, -7 / 2, -7 % 3, 1 << 10, -16 >> 2);
    Console.writeSync("mul {0} {1}\n", 65537 * 65537w, 46340 * 46340);
    Console.writeSync("fib {0} calls {1} max {2}\n", fib(15), calls, Limits.MAX);
    Console.writeSync("enum {0} {1} {2}\n", name_of(Color::Red), name_of(Color::Green), name_of(Color::Blue));
    f64 half = 1.0 / 2.0;
    Console.writeSync("float {0} cast {1} {2}\n", half * 3.0, (i32)(half * 9.0), (f64)7 / 2.0);
    bool flag = p.x < p.y && !(p.x == 0);
    Console.writeSync("bool {0} {1}\n", flag, p.x > 100 || p.y > 100);
    Console.writeSync("{0}\n", $"text {p.x}+{p.y}={p.sum()} {flag}");
    mut i32 counted = 0;
    mut i32 i = 0;
    do {
        counted = counted + i;
        i++;
    } while (i < 4);
    Console.writeSync("do {0} {1}\n", counted, i);
    return 0;
}
