import std::types;
import std::sys;
import std::libc;
import std::math;
namespace app;

unsafe i32 main() {
    printf("%d %5d|%-5d|%05d %+d %x %X %#x %o %u\n", -42, 7, 7, 42, 3, 255, 255, 255, 8, (u32)4000000000);
    printf("%lld %llu %llx\n", (i64)-1234567890123, (u64)18446744073709551615, (u64)3735928559);
    printf("%s|%10s|%-10s|%.3s|%c\n", "text", "right", "left", "truncated", 65);
    printf("%f %.2f %.0f %.0f %.0f %10.3f|%-10.1f|\n", 3.14159265, 2.675, 0.5, 1.5, 2.5, -1.0005, 9.95);
    printf("%e %.3e %E %.0e\n", 123456.789, 0.000123456, 1e300, 5e-324);
    printf("%g %g %g %g %g %.3g %#g\n", 100000.0, 1000000.0, 0.0001, 0.00001, 123.456, 2.0 / 3.0, 1.0);
    printf("%f %e %g\n", 1e21, 1.7976931348623157e308, -0.0);
    i8* buffer = i8[64];
    i32 length = snprintf(buffer, 8, "%s-%d", "abcdef", 12345);
    printf("snprintf %d [%s]\n", length, buffer);
    f64 parsed = strtod("  -12.5e2xyz", (i8**)0);
    printf("strtod %f %lld %llu\n", parsed, strtoll("-77", (i8**)0, 10), strtoull("0xff", (i8**)0, 16));
    i128 big = (i128)9223372036854775807 * (i128)1000;
    i128 quotient = big / (i128)7;
    printf("i128 %lld %lld\n", (i64)(quotient % (i128)1000000007), (i64)(big >> 10));
    printf("floats %.17g %.17g %.17g %g\n", Math.sqrt(2.0), Math.sin(1.0), Math.pow(2.0, 0.5), Math.floor(-2.5));
    return 0;
}
