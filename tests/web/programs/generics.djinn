import std::types;
import std::sys;
import std::collections;
namespace app;

struct Box<T> {
    T value;

    public T get() {
        return this.value;
    }
}

interface Shape {
    f64 area();
}

struct Rect {
    f64 w;
    f64 h;
}

impl Shape for Rect {
    f64 area() {
        return this.w * this.h;
    }
}

T largest<T>(slice<T> items) where T : Comparable<T> {
    mut T best = items[0];
    for (mut u32 i = 1; i < items.length; i = i + 1) {
        if (items[i] > best) {
            best = items[i];
        }
    }
    return best;
}

i32 main() {
    Box<i64> boxed = { .value = 41 };
    Console.writeSync("{0}", $"box {boxed.get() + 1}\n");
    Rect r = { .w = 2.0, .h = 3.5 };
    Console.writeSync("{0}", $"area {r.area()}\n");
    mut array<i32> list = array<i32>();
    for (mut i32 i = 0; i < 1000; i = i + 1) {
        list.push((i * 7919) % 1009);
    }
    Console.writeSync("{0}", $"count {list.length} first {list.get(0)} last {list.get(999)}\n");
    mut string text = "";
    for (mut i32 i = 0; i < 5; i = i + 1) {
        text = text + $"{i},";
    }
    Console.writeSync("{0}", $"text {text}\n");
    return 0;
}
