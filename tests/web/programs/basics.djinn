import std::types;
import std::sys;
import std::collections;
namespace app;

struct Point {
    i32 x;
    i32 y;

    public i32 sum() {
        return this.x + this.y;
    }
}

union Shape { Circle(f64), Square(f64) }

f64 area(Shape shape) {
    return switch shape { Circle r -> 3.0 * r * r, Square s -> s * s };
}

i32 apply(fn(i32) -> i32 f, i32 x) {
    return f(x);
}

i32 main() {
    Console.writeSync("{0}", $"hello {"web"}\n");
    i32 base = 10;
    Console.writeSync("{0}", $"closure {apply((i32 v) => v + base, 5)}\n");
    Point p = { .x = 3, .y = 4 };
    Console.writeSync("{0}", $"point {p.x} sum {p.sum()}\n");
    Console.writeSync("{0}", $"float {1.5} {3.14159} {1.0 / 3.0} {1e21} {0.1 + 0.2}\n");
    Console.writeSync("{0}", $"i64 {(i64)-9007199254740993} u64 {(u64)18446744073709551615}\n");
    Console.writeSync("{0}", $"area {area(Shape::Square(2.5))} {area(Shape::Circle(1.0))}\n");
    map<str, i32> ages = map<str, i32>();
    ages.set("ana", 31);
    ages.set("bia", 27);
    Console.writeSync("{0}", $"bia {ages.get("bia")} count {ages.count}\n");
    string text = $"key_{123456789}";
    Console.writeSync("{0}", $"slice {text.slice(0, 5)} hash-equal {text.hash() == "key_123456789".hash()}\n");
    mut i64 wide = 1;
    for (mut i32 i = 0; i < 40; i = i + 1) {
        wide = wide * 3 % 1000000007;
    }
    Console.writeSync("{0}", $"pow {wide}\n");
    return 3;
}
