import std::types;
import std::sys;
import std::util;
namespace app;

unsafe void* field(void* value, i8* key) {
    return Json.get(value, key) ?? (void*)0;
}

unsafe void* item(void* value, i32 index) {
    return Json.at(value, index) ?? (void*)0;
}

unsafe i32 main() {
    i8* text = "{\"name\":\"djinn\",\"version\":3,\"ratio\":0.25,\"tags\":[\"fast\",\"web\"],\"ok\":true}";
    void* document = Json.parse(text, strlen(text)) ?? (void*)0;
    if (document == (void*)0) {
        return 1;
    }
    void* root = Json.root(document);
    void* tags = field(root, "tags");
    Console.writeSync("{0}", $"name {Json.as_text(field(root, "name"))} version {Json.as_int(field(root, "version"))}\n");
    Console.writeSync("{0}", $"ratio {Json.as_real(field(root, "ratio"))} tags {Json.length(tags)} second {Json.as_text(item(tags, 1))}\n");
    Console.writeSync("{0}", $"ok {Json.as_bool(field(root, "ok"))} kind {Json.kind(root)}\n");
    Json.release(document);
    return 0;
}
