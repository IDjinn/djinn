import std::types;
import std::sys;
namespace app;

async i32 slow_double(i32 value, i64 wait) {
    await Task.delay(wait);
    Console.writeSync("{0}", $"slept {wait} for {value}\n");
    return value * 2;
}

async i32 main() {
    Console.writeSync("{0}", "start\n");
    i32 first = await slow_double(10, 30);
    i32 second = await slow_double(20, 5);
    Console.writeSync("{0}", $"sum {first + second}\n");
    return first + second - 55;
}
