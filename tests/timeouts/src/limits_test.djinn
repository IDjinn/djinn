import std::libc;
import testing;

extern "C" {
    void __djinn_thread_sleep(i64 milliseconds);
}

struct Root {
    i32 value;
}

struct Slow {
    i32 value;
}

struct Limits {
    [Test]
    Root root() {
        Root value = { .value = 1 };
        return value;
    }

    [Test]
    [TestPolicy(0, 300)]
    unsafe Slow slow(Root root) {
        __djinn_thread_sleep(5000);
        Slow value = { .value = root.value };
        return value;
    }

    [Test]
    void after_slow(Slow slow) {
        Expect.equal(1, (i64)slow.value);
    }

    [Test]
    void fine(Root root) {
        Expect.equal(1, (i64)root.value);
    }
}
