import testing;

i32 main() {
    TestPlan* plan = TestPlan.discover();
    plan.workflow("user").step(typeof(Flow.login)).step(typeof(Flow.edit)).step(typeof(Flow.audit)).step(typeof(Flow.user_only));
    plan.workflow("admin").step(typeof(Flow.login_admin)).step(typeof(Flow.edit)).step(typeof(Flow.audit)).step(typeof(Flow.admin_only));
    plan.workflow("recheck").step(typeof(Flow.login)).step(typeof(Flow.edit)).step(typeof(Flow.compare));
    return plan.run();
}
