namespace djinnc;

extern "C" {
    ptr __djinn_process_start(ptr<i8> command, ptr<i8> input, i32 input_length);
    i32 __djinn_process_poll(ptr process);
    void __djinn_process_kill(ptr process);
    i32 __djinn_process_exit_code(ptr process);
    ptr<i8> __djinn_process_stdout_data(ptr process);
    i32 __djinn_process_stdout_length(ptr process);
    ptr<i8> __djinn_process_stderr_data(ptr process);
    i32 __djinn_process_stderr_length(ptr process);
    void __djinn_process_free(ptr process);
    void __djinn_thread_sleep(i64 milliseconds);
    void __djinn_call_method(ptr address, ptr target);
    ptr<i8> strstr(ptr<i8> haystack, ptr<i8> needle);
}

struct Kind {
    const i32 RUN = 0;
    const i32 ERROR = 2;
    const i32 CRASH = 3;
    const i32 SELFTEST = 4;
    const i32 DEBUG = 5;
    const i32 LIBRARY = 6;
    const i32 CLEAN = 7;
}

struct Config {
    ptr<i8> compiler;
    ptr<i8> runtime_dir;
    ptr<i8> runtime_lib;
    ptr<i8> std_dir;
    ptr<i8> out_dir;
    ptr<i8> work_dir;
    ptr<i8> filter;
    ptr<i8> report;
    i32 jobs;
    i64 timeout_us;
    i32 forced_paths;
    i32 skipped_links;
    bool link_debug;
    bool lld;
    bool crash;
    bool debug;
    bool library;
    bool ok;
}

struct TestCase {
    ptr<i8> name;
    ptr<i8> source;
    ptr<i8> binary;
    i32 kind;
    Expected* expected;
    ptr<i8> library;
    i32 state;
    i32 phase;
    bool passed;
    ptr process;
    i64 started_us;
    i64 elapsed_us;
    ptr<i8> reason;
    i32 retries;
    i32 max_retries;
    bool std;
    i64 timeout_us;
    i32 line;
    i32 requires;
    i32 path;
    i32 ran;
    bool skipped;
}

struct Runner {
    public static unsafe Config* parse_config() {
        Config* config = (Config*)Memory.zalloc(sizeof(Config));
        config.std_dir = "std";
        config.runtime_dir = "runtime";
        config.jobs = 8;
        config.timeout_us = 120000000;
        config.ok = true;
        mut i32 index = 1;
        while (index < Process.argc()) {
            ptr<i8> argument = Process.argv_or(index, "");
            ptr<i8> value = Process.argv_or(index + 1, "");
            if (Strings.same(argument, "--link-debug")) {
                config.link_debug = true;
                index = index + 1;
                continue;
            }
            if (Strings.same(argument, "--crash")) {
                config.crash = true;
                index = index + 1;
                continue;
            }
            if (Strings.same(argument, "--debug")) {
                config.debug = true;
                index = index + 1;
                continue;
            }
            if (Strings.same(argument, "--library")) {
                config.library = true;
                index = index + 1;
                continue;
            }
            if (Strings.same(argument, "--lld")) {
                config.lld = true;
                index = index + 1;
                continue;
            }
            if (Strings.same(argument, "--compiler")) {
                config.compiler = value;
            } else if (Strings.same(argument, "--runtime-dir")) {
                config.runtime_dir = value;
            } else if (Strings.same(argument, "--runtime-lib")) {
                config.runtime_lib = value;
            } else if (Strings.same(argument, "--std-dir")) {
                config.std_dir = value;
            } else if (Strings.same(argument, "--out")) {
                config.out_dir = value;
            } else if (Strings.same(argument, "--filter")) {
                config.filter = value;
            } else if (Strings.same(argument, "--report")) {
                config.report = value;
            } else if (Strings.same(argument, "--jobs")) {
                config.jobs = (i32)Strings.parse_integer(value, strlen(value));
            } else if (Strings.same(argument, "--require")) {
                i32 path = Runner.path_named(value);
                if (path == 0) {
                    config.ok = false;
                }
                config.forced_paths = config.forced_paths | path;
            } else {
                config.ok = false;
            }
            index = index + 2;
        }
        if (config.compiler == null || config.runtime_lib == null || config.jobs < 1) {
            config.ok = false;
        }
        if (((config.forced_paths & TestPath.LINK) != 0 || config.crash || config.debug || config.library) && config.out_dir == null) {
            config.ok = false;
        }
        config.work_dir = config.out_dir;
        if (config.work_dir == null) {
            config.work_dir = Process.env_or("TEMP", Process.env_or("TMPDIR", "/tmp"));
        }
        return config;
    }

    public static unsafe i32 path_named(ptr<i8> name) {
        if (Strings.same(name, "Check")) {
            return TestPath.CHECK;
        }
        if (Strings.same(name, "IR")) {
            return TestPath.IR;
        }
        if (Strings.same(name, "JIT")) {
            return TestPath.JIT;
        }
        if (Strings.same(name, "Link")) {
            return TestPath.LINK;
        }
        return 0;
    }

    public static unsafe i32 first_path(TestCase* test) {
        i32 paths = test.requires;
        if (test.kind == Kind.SELFTEST) {
            return 0;
        }
        if (test.kind == Kind.RUN) {
            if ((paths & TestPath.JIT) != 0) {
                return TestPath.JIT;
            }
            return paths & TestPath.LINK;
        }
        if (test.kind == Kind.ERROR) {
            if ((paths & TestPath.CODEGEN) != 0) {
                return TestPath.IR;
            }
            return paths & TestPath.CHECK;
        }
        if (test.kind == Kind.CLEAN) {
            if ((paths & TestPath.LINK) != 0) {
                return TestPath.LINK;
            }
            if ((paths & TestPath.CODEGEN) != 0) {
                return TestPath.IR;
            }
            return paths & TestPath.CHECK;
        }
        return paths & TestPath.LINK;
    }

    public static unsafe ptr<i8> base_name(ptr<i8> path) {
        i32 length = strlen(path);
        mut i32 start = 0;
        for (mut i32 i = 0; i < length; i = i + 1) {
            if (path[i] == 47 || path[i] == 92) {
                start = i + 1;
            }
        }
        mut i32 end = length;
        if (length - start > 6 && Strings.same(path + (length - 6), ".djinn")) {
            end = length - 6;
        }
        return Strings.duplicate(path + start, end - start);
    }

    public static unsafe ptr<i8> output_path(Config* config, ptr<i8> name, ptr<i8> extension) {
        ByteBuffer* path = ByteBuffer.create();
        path.append(config.work_dir);
        path.append("/");
        i32 length = strlen(name);
        for (mut i32 i = 0; i < length; i = i + 1) {
            if (name[i] == 47 || name[i] == 58) {
                path.append_char(95);
            } else {
                path.append_char(name[i]);
            }
        }
        path.append(extension);
        return path.cstr();
    }

    public static unsafe TestCase* new_case(Config* config, ptr<i8> name, ptr<i8> path, i32 kind) {
        TestCase* test = (TestCase*)Memory.zalloc(sizeof(TestCase));
        test.name = name;
        test.source = path;
        test.kind = kind;
        test.binary = Runner.output_path(config, name, ".exe");
        test.timeout_us = config.timeout_us;
        return test;
    }

    public static unsafe void quote(ByteBuffer* command, ptr<i8> text) {
        command.append(" \"");
        command.append(text);
        command.append("\"");
    }

    public static unsafe ptr<i8> debug_command(TestCase* test) {
        ByteBuffer* command = ByteBuffer.create();
        command.append("lldb -b -o \"breakpoint set -f ");
        command.append(Runner.base_name(test.source));
        command.append(".djinn -l ");
        command.append_int((i64)test.line);
        command.append("\" -o run -o \"frame variable\" -o bt -o quit");
        Runner.quote(command, test.binary);
        return command.cstr();
    }

    public static unsafe ptr<i8> library_command(TestCase* test, Config* config) {
        ByteBuffer* library = ByteBuffer.create();
        library.append(config.out_dir);
        library.append("/library_mathlib.djlib");
        ByteBuffer* command = ByteBuffer.create();
        command.append("\"");
        if (test.phase == 2) {
            command.append(test.binary);
            command.append("\"");
            return command.cstr();
        }
        command.append(config.compiler);
        command.append("\"");
        if (test.phase == 0) {
            Runner.quote(command, test.library);
            command.append(" --library -o");
            Runner.quote(command, library.cstr());
        } else {
            Runner.quote(command, test.source);
            command.append(" --lib");
            Runner.quote(command, library.cstr());
            command.append(" -o");
            Runner.quote(command, test.binary);
        }
        if (config.lld) {
            command.append(" --lld");
        }
        command.append(" --runtime-lib");
        Runner.quote(command, config.runtime_lib);
        command.append(" --runtime-dir");
        Runner.quote(command, config.runtime_dir);
        return command.cstr();
    }

    public static unsafe ptr<i8> build_command(TestCase* test, Config* config) {
        if (test.kind == Kind.LIBRARY) {
            return Runner.library_command(test, config);
        }
        ByteBuffer* command = ByteBuffer.create();
        command.append("\"");
        if (test.phase == 1 && test.kind == Kind.DEBUG) {
            return Runner.debug_command(test);
        }
        if (test.phase == 1) {
            command.append(test.binary);
            command.append("\"");
            return command.cstr();
        }
        command.append(config.compiler);
        command.append("\"");
        if (test.kind == Kind.SELFTEST) {
            command.append(" --selftest");
            return command.cstr();
        }
        Runner.quote(command, test.source);
        if (test.kind == Kind.ERROR || test.kind == Kind.CLEAN) {
            command.append(" --diagnostics-format=json");
        }
        if (test.path == TestPath.CHECK) {
            command.append(" --check --runtime-dir");
            Runner.quote(command, config.runtime_dir);
            Runner.append_std(command, test, config);
            return command.cstr();
        }
        if (test.path == TestPath.IR) {
            command.append(" --no-link -o");
            Runner.quote(command, test.binary);
        } else if (test.path == TestPath.LINK) {
            command.append(" -o");
            Runner.quote(command, test.binary);
            if (test.kind == Kind.CRASH || test.kind == Kind.DEBUG || config.link_debug) {
                command.append(" -g");
            }
            if (config.lld) {
                command.append(" --lld");
            }
        } else {
            command.append(" --run");
        }
        command.append(" --runtime-lib");
        Runner.quote(command, config.runtime_lib);
        command.append(" --runtime-dir");
        Runner.quote(command, config.runtime_dir);
        Runner.append_std(command, test, config);
        return command.cstr();
    }

    public static unsafe void append_std(ByteBuffer* command, TestCase* test, Config* config) {
        if (test.std) {
            command.append(" --std --std-dir");
            Runner.quote(command, config.std_dir);
        }
    }

    public static unsafe void start(TestCase* test, Config* config) {
        ptr<i8> command = Runner.build_command(test, config);
        if (test.started_us == 0) {
            test.started_us = __djinn_now_us();
        }
        test.ran = test.ran | test.path;
        test.process = __djinn_process_start(command, "", 0);
        if (test.process == null) {
            test.state = 2;
            test.reason = "could not start the process";
            return;
        }
        test.state = 1;
    }

    public static unsafe ptr<i8> output_text(ptr process) {
        ByteBuffer* text = ByteBuffer.create();
        ptr<i8> out = __djinn_process_stdout_data(process);
        i32 out_length = __djinn_process_stdout_length(process);
        for (mut i32 i = 0; i < out_length; i = i + 1) {
            if (out[i] != 13) {
                text.append_char(out[i]);
            }
        }
        ptr<i8> err = __djinn_process_stderr_data(process);
        i32 err_length = __djinn_process_stderr_length(process);
        for (mut i32 i = 0; i < err_length; i = i + 1) {
            if (err[i] != 13) {
                text.append_char(err[i]);
            }
        }
        return text.cstr();
    }

    public static unsafe ptr<i8> normalized(ptr<i8> data, i32 length) {
        ByteBuffer* text = ByteBuffer.create();
        for (mut i32 i = 0; i < length; i = i + 1) {
            if (data[i] != 13) {
                text.append_char(data[i]);
            }
        }
        return text.cstr();
    }

    public static unsafe ptr<i8> with_snippet(ptr<i8> prefix, ptr<i8> output) {
        ByteBuffer* reason = ByteBuffer.create();
        reason.append(prefix);
        i32 length = strlen(output);
        mut i32 limit = length;
        if (limit > 400) {
            limit = 400;
        }
        if (limit > 0) {
            reason.append(": ");
            reason.append_slice(output, limit);
        }
        return reason.cstr();
    }

    public static unsafe ptr<i8> exit_mismatch(i32 expected, i32 actual) {
        ByteBuffer* reason = ByteBuffer.create();
        reason.append("expected exit ");
        reason.append_int((i64)expected);
        reason.append(", got ");
        reason.append_int((i64)actual);
        return reason.cstr();
    }

    public static unsafe void check_diagnostics(TestCase* test, i32 exit_code) {
        Expected* expected = test.expected;
        ptr<i8> output = Runner.output_text(test.process);
        if (exit_code < 0) {
            test.reason = Runner.with_snippet("the compiler crashed", output);
            return;
        }
        test.reason = DiagnosticComparer.compare(expected, DiagnosticReader.read(output), test.source);
        if (test.reason == null && exit_code != 0 && !expected.wants_error()) {
            test.reason = Runner.with_snippet("expected no errors", output);
        }
    }

    public static unsafe void check_output(TestCase* test) {
        Expected* expected = test.expected;
        PointerList* patterns = expected.output;
        ptr<i8> output = Runner.output_text(test.process);
        for (mut i32 i = 0; i < patterns.length; i = i + 1) {
            ptr<i8> pattern = (ptr<i8>)patterns.get(i);
            if (strstr(output, pattern) == null) {
                ByteBuffer* reason = ByteBuffer.create();
                reason.append("missing in the output: ");
                reason.append(pattern);
                test.reason = reason.cstr();
                return;
            }
        }
    }

    public static unsafe void check_crash(TestCase* test, i32 exit_code) {
        if (exit_code == 0) {
            test.reason = "expected the program to crash";
            return;
        }
        Runner.check_output(test);
    }

    public static unsafe void check_run(TestCase* test, i32 exit_code) {
        Expected* expected = test.expected;
        if (expected.any_failure) {
            if (exit_code == 0) {
                test.reason = "expected a non-zero exit code";
            }
            return;
        }
        if (exit_code != expected.exit_code) {
            test.reason = Runner.exit_mismatch(expected.exit_code, exit_code);
            return;
        }
        if (expected.stdout_text == null) {
            return;
        }
        ptr<i8> actual = Runner.normalized(__djinn_process_stdout_data(test.process), __djinn_process_stdout_length(test.process));
        if (!Strings.same(actual, expected.stdout_text)) {
            test.reason = "stdout differs";
        }
    }

    public static unsafe void finish(TestCase* test, Config* config) {
        i32 exit_code = __djinn_process_exit_code(test.process);
        test.state = 2;
        if (test.kind == Kind.ERROR || test.kind == Kind.CLEAN) {
            Runner.check_diagnostics(test, exit_code);
            if (test.path == TestPath.IR) {
                Runner.remove_ir(test);
            }
        } else if (test.kind == Kind.SELFTEST) {
            if (exit_code != 0) {
                test.reason = Runner.with_snippet("selftest failed", Runner.output_text(test.process));
            }
        } else if (test.kind == Kind.LIBRARY) {
            if (test.phase < 2) {
                if (exit_code != 0) {
                    test.reason = Runner.with_snippet("compile failed", Runner.output_text(test.process));
                } else {
                    __djinn_process_free(test.process);
                    test.process = null;
                    test.phase = test.phase + 1;
                    Runner.start(test, config);
                    return;
                }
            } else {
                Runner.check_run(test, exit_code);
            }
        } else if (test.phase == 0 && test.path == TestPath.LINK) {
            if (exit_code != 0) {
                test.reason = Runner.with_snippet("compile failed", Runner.output_text(test.process));
            } else {
                __djinn_process_free(test.process);
                test.process = null;
                test.phase = 1;
                Runner.start(test, config);
                return;
            }
        } else if (test.kind == Kind.CRASH) {
            Runner.check_crash(test, exit_code);
        } else if (test.kind == Kind.DEBUG) {
            Runner.check_output(test);
        } else {
            Runner.check_run(test, exit_code);
            if (test.reason == null && test.path == TestPath.JIT && (test.requires & TestPath.LINK) != 0) {
                __djinn_process_free(test.process);
                test.process = null;
                test.path = TestPath.LINK;
                test.phase = 0;
                Runner.start(test, config);
                return;
            }
        }
        test.elapsed_us = __djinn_now_us() - test.started_us;
        test.passed = test.reason == null;
        __djinn_process_free(test.process);
        test.process = null;
        if (!test.passed && exit_code < 0 && test.kind != Kind.CRASH && test.retries < test.max_retries) {
            test.retries = test.retries + 1;
            test.reason = null;
            test.phase = 0;
            test.state = 0;
            test.started_us = 0;
            test.path = Runner.first_path(test);
        }
    }

    public static unsafe void remove_ir(TestCase* test) {
        ByteBuffer* path = ByteBuffer.create();
        path.append(test.binary);
        path.append(".ll");
        remove(path.cstr());
    }

    public static unsafe void add_orphans(Verify* verify, PointerList* cases, Config* config, ptr<i8> directory) {
        ptr<i8> listing = __djinn_list_files(directory, ".djinn");
        if (listing == null) {
            return;
        }
        i32 length = strlen(listing);
        mut i32 start = 0;
        for (mut i32 i = 0; i < length; i = i + 1) {
            if (listing[i] != 10) {
                continue;
            }
            ptr<i8> path = Strings.duplicate(listing + start, i - start);
            start = i + 1;
            if (verify.uses(path)) {
                continue;
            }
            ByteBuffer* name = ByteBuffer.create();
            name.append("orphans/");
            name.append(path);
            if (config.filter == null || strstr(name.cstr(), config.filter) != null) {
                TestCase* test = Runner.new_case(config, name.cstr(), path, Kind.CLEAN);
                test.state = 2;
                test.reason = "no test uses this source";
                cases.push((ptr)test);
            }
        }
    }

    public static unsafe ptr<i8> path_names(i32 paths) {
        ByteBuffer* names = ByteBuffer.create();
        if ((paths & TestPath.CHECK) != 0) {
            names.append("Check ");
        }
        if ((paths & TestPath.IR) != 0) {
            names.append("IR ");
        }
        if ((paths & TestPath.JIT) != 0) {
            names.append("JIT ");
        }
        if ((paths & TestPath.LINK) != 0) {
            names.append("Link ");
        }
        if (names.length > 0) {
            names.length = names.length - 1;
        }
        return names.cstr();
    }

    public static unsafe i32 count_path(PointerList* cases, i32 path) {
        mut i32 count = 0;
        for (mut i32 i = 0; i < cases.length; i = i + 1) {
            TestCase* test = (TestCase*)cases.get(i);
            if ((test.ran & path) != 0) {
                count = count + 1;
            }
        }
        return count;
    }

    public static unsafe void print_result(TestCase* test) {
        i32 millis = (i32)(test.elapsed_us / 1000);
        if (test.passed) {
            if (test.retries > 0) {
                printf("PASS %s (%d ms, after %d retries)\n", test.name, millis, test.retries);
            } else {
                printf("PASS %s (%d ms)\n", test.name, millis);
            }
        } else {
            printf("FAIL %s: %s\n", test.name, test.reason);
        }
    }

    public static unsafe void write_report(PointerList* cases, Config* config, i32 passed) {
        ByteBuffer* json = ByteBuffer.create();
        json.append("{\"total\":");
        json.append_int((i64)cases.length);
        json.append(",\"passed\":");
        json.append_int((i64)passed);
        json.append(",\"paths\":{\"check\":");
        json.append_int((i64)Runner.count_path(cases, TestPath.CHECK));
        json.append(",\"ir\":");
        json.append_int((i64)Runner.count_path(cases, TestPath.IR));
        json.append(",\"jit\":");
        json.append_int((i64)Runner.count_path(cases, TestPath.JIT));
        json.append(",\"link\":");
        json.append_int((i64)Runner.count_path(cases, TestPath.LINK));
        json.append("},\"cases\":[");
        for (mut i32 i = 0; i < cases.length; i = i + 1) {
            TestCase* test = (TestCase*)cases.get(i);
            if (i > 0) {
                json.append(",");
            }
            json.append("{\"name\":");
            json.append_json_string(test.name);
            json.append(",\"status\":");
            if (test.passed) {
                json.append("\"passed\"");
            } else {
                json.append("\"failed\"");
            }
            if (test.retries > 0) {
                json.append(",\"retries\":");
                json.append_int((i64)test.retries);
            }
            json.append(",\"paths\":");
            json.append_json_string(Runner.path_names(test.ran));
            json.append(",\"elapsed_ms\":");
            json.append_int(test.elapsed_us / 1000);
            if (test.reason != null) {
                json.append(",\"reason\":");
                json.append_json_string(test.reason);
            }
            json.append("}");
        }
        json.append("]}\n");
        Files.write_bytes(config.report, json.cstr(), json.length);
    }

    public static unsafe void time_out(TestCase* test) {
        __djinn_process_kill(test.process);
        __djinn_process_poll(test.process);
        test.elapsed_us = __djinn_now_us() - test.started_us;
        test.state = 2;
        test.reason = "timeout";
        __djinn_process_free(test.process);
        test.process = null;
    }

    public static unsafe i32 run(PointerList* cases, Config* config) {
        i32 total = cases.length;
        mut i32 next = 0;
        mut i32 running = 0;
        mut i32 finished = 0;
        mut i32 passed = 0;
        for (mut i32 i = 0; i < total; i = i + 1) {
            TestCase* test = (TestCase*)cases.get(i);
            if (test.state == 2) {
                Runner.print_result(test);
                finished = finished + 1;
            }
        }
        while (finished < total) {
            while (running < config.jobs && next < total) {
                TestCase* test = (TestCase*)cases.get(next);
                next = next + 1;
                if (test.state == 0) {
                    Runner.start(test, config);
                    if (test.state == 1) {
                        running = running + 1;
                    } else {
                        Runner.print_result(test);
                        finished = finished + 1;
                    }
                }
            }
            mut bool progressed = false;
            for (mut i32 i = 0; i < next; i = i + 1) {
                TestCase* test = (TestCase*)cases.get(i);
                if (test.state != 1) {
                    continue;
                }
                if (__djinn_process_poll(test.process) == 1) {
                    Runner.finish(test, config);
                    progressed = true;
                    if (test.state == 1) {
                        continue;
                    }
                    if (test.state == 0) {
                        printf("RETRY %s (the process crashed)\n", test.name);
                        Runner.start(test, config);
                        continue;
                    }
                    Runner.print_result(test);
                    running = running - 1;
                    finished = finished + 1;
                } else if (__djinn_now_us() - test.started_us > test.timeout_us) {
                    Runner.time_out(test);
                    Runner.print_result(test);
                    running = running - 1;
                    finished = finished + 1;
                    progressed = true;
                }
            }
            if (!progressed) {
                __djinn_thread_sleep(1);
            }
        }
        for (mut i32 i = 0; i < total; i = i + 1) {
            TestCase* test = (TestCase*)cases.get(i);
            if (test.passed) {
                passed = passed + 1;
            }
        }
        printf("%d passed, %d failed, %d total\n", passed, total - passed, total);
        printf("paths: Check %d, IR %d, JIT %d, Link %d\n", Runner.count_path(cases, TestPath.CHECK), Runner.count_path(cases, TestPath.IR), Runner.count_path(cases, TestPath.JIT), Runner.count_path(cases, TestPath.LINK));
        if (config.skipped_links > 0) {
            printf("%d link runs skipped: they need --out\n", config.skipped_links);
        }
        if (config.report != null) {
            Runner.write_report(cases, config, passed);
        }
        if (passed == total) {
            return 0;
        }
        return 1;
    }
}

i32 main() {
    Config* config = Runner.parse_config();
    if (!config.ok) {
        printf("usage: runner --compiler <djinnc> --runtime-lib <lib> [--runtime-dir <dir>] [--std-dir <dir>]\n");
        printf("              [--require Check|IR|JIT|Link] [--link-debug] [--crash] [--debug] [--library] [--out <absolute dir> [--lld]] [--filter <text>] [--jobs <n>] [--report <file>]\n");
        return 2;
    }
    PointerList* cases = PointerList.create();
    Verify* verify = Verify.create(cases, config);
    verify.test("selftest").selftest();
    Suites.register(verify);
    Runner.add_orphans(verify, cases, config, "tests/djinnc");
    Runner.add_orphans(verify, cases, config, "tests/conformance/cases");
    return Runner.run(cases, config);
}
