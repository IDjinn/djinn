interface IReadable {
    i32 read();
}

interface IWritable {
    void write(i32 val);
}

struct Store<T> where T : IReadable, IWritable {
    T backend;
}

struct ReadOnly : IReadable {
    i32 value;

    i32 read() {
        return this.value;
    }
}

i32 main() {
    ReadOnly r = { .value = 10 };
    Store<ReadOnly> s = { .backend = r };
    return 0;
}
