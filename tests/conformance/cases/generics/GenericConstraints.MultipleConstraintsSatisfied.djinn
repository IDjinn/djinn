interface IReadable {
    i32 read();
}

interface IWritable {
    void write(i32 val);
}

struct Store<T> where T : IReadable, IWritable {
    T backend;
}

struct MemBackend : IReadable, IWritable {
    i32 value;

    i32 read() {
        return this.value;
    }

    void write(i32 val) {
        this.value = val;
    }
}

i32 main() {
    MemBackend b = { .value = 99 };
    Store<MemBackend> s = { .backend = b };
    return 0;
}
