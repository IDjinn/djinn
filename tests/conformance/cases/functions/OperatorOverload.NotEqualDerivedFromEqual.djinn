struct Point {
    i32 x;
    i32 y;
}

impl Point {
    operator ==(Point left, Point right) -> bool {
        return left.x == right.x && left.y == right.y;
    }
}

i32 main() {
    Point a = { .x = 1, .y = 2 };
    Point b = { .x = 3, .y = 4 };
    if (a != b) {
        return 42;
    }
    return 0;
}
