i32 main() {
    i32 a = 12;
    i32 b = 10;

    i32 and_result = a & b;
    i32 or_result = a | b;
    i32 xor_result = a ^ b;
    i32 not_result = ~a;
    i32 shl_result = 1 << 3;
    i32 shr_result = 16 >> 2;

    // and: 1000 = 8, or: 1110 = 14, xor: 0110 = 6
    // not: depends on width, shl: 8, shr: 4
    // Return sum of and + or + xor + shl + shr = 8 + 14 + 6 + 8 + 4 = 40
    return and_result + or_result + xor_result + shl_result + shr_result;
}
