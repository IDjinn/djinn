struct Point {
    i32 x;
    i32 y;
}

impl Point {
    operator ==(Point left, Point right) -> bool {
        return left.x == right.x && left.y == right.y;
    }
}

i32 main() {
    Point a = { .x = 5, .y = 10 };
    Point b = { .x = 5, .y = 10 };
    if (a == b) {
        return 1;
    }
    return 0;
}
