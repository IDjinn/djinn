struct Container<T> {
    T value;
    i32 count;

    Container(T v) {
        this.value = v;
        this.count = 1;
        this.increment();
    }

    public void increment() {
        this.count = this.count + 1;
    }

    public i32 getCount() {
        return this.count;
    }
}

i32 main() {
    Container<i32> c = Container<i32>(10);
    return c.getCount();
}
