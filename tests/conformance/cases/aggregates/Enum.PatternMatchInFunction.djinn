union optional<T> {
    Empty(),
    Value(T)
}

i32 unwrap_or(optional<i32> opt, i32 default_val) {
    return switch opt {
        Value val -> val,
        Empty -> default_val
    };
}

i32 main() {
    auto a = optional<i32>::Value(50);
    auto b = optional<i32>::Empty();

    i32 x = unwrap_or(a, 0);
    i32 y = unwrap_or(b, 99);

    return x + y;
}
