struct Node {
    i32 value;
}

struct Sum {
    i32 total;

    void add(Node* node) {
        this.total = this.total + node.value;
    }
}

i32 main() {
    Node* n = malloc(sizeof(Node));
    n.value = 9;
    Sum* s = malloc(sizeof(Sum));
    s.total = 1;
    s.add(n);
    i32 result = s.total;
    free(n);
    free(s);
    return result;
}
