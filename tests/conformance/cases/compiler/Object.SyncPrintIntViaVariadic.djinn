struct Printer {
    public static i32 print_first_int(...args) {
        object first = args[0];
        u8 kind = first.type.kind;
        if (kind == (u8)0) {
            i32* ip = (i32*)first.data;
            printf("value=%d\n", *ip);
            return *ip;
        }
        return -1;
    }
}

i32 main() {
    return Printer.print_first_int(42);
}
