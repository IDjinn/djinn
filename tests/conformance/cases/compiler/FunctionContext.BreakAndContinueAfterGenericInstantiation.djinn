struct Box<T> {
    T value;

    public T get() {
        while (true) {
            break;
        }
        return this.value;
    }
}

i32 main() {
    mut i32 total = 0;
    for (mut i32 i = 0; i < 10; i = i + 1) {
        Box<i32> box = { .value = i };
        if (box.get() % 2 == 0) {
            continue;
        }
        if (i > 6) {
            break;
        }
        total = total + box.get();
    }
    return total;
}
