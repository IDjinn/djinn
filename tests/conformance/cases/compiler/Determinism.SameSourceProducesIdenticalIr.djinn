struct Alpha { i32 a; }
struct Beta { i32 b; }
struct Gamma { i32 c; }

struct Box<T> {
    T value;

    public T get() {
        return this.value;
    }
}

i32 zeta() { return 1; }
i32 alpha() { return 2; }
i32 middle() { return 3; }

i32 main() {
    Alpha x = { .a = zeta() };
    Beta y = { .b = alpha() };
    Gamma z = { .c = middle() };
    Box<i32> box = { .value = x.a + y.b + z.c };
    return box.get();
}
