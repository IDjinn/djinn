struct Item {
    i32 weight;
}

i32 main() {
    void** items = malloc(8 * 3);
    for (mut i32 i = 0; i < 3; i = i + 1) {
        Item* item = malloc(sizeof(Item));
        item.weight = i + 1;
        items[i] = item;
    }
    mut i32 total = 0;
    for (mut i32 i = 0; i < 3; i = i + 1) {
        Item* item = items[i];
        total = total + item.weight;
    }
    return total;
}
