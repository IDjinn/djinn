struct Node {
    i32 value;
}

void set_value(Node* node, i32 v) {
    node.value = v;
}

i32 get_value(Node* node) {
    return node.value;
}

i32 main() {
    Node* n = malloc(sizeof(Node));
    set_value(n, 41);
    n.value = n.value + 1;
    i32 result = get_value(n);
    free(n);
    return result;
}
