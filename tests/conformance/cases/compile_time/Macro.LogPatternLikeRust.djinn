macro log {
    (debug, expression msg) => { trace(msg) }
    (info, expression msg)  => { trace(msg) }
    (off, expression msg)   => void
}

unsafe static mut i32 call_count = 0;

void trace(i32 val) {
    call_count = call_count + val;
}

i32 main() {
    log(debug, 1);
    log(info, 2);
    log(off, 100);
    log(debug, 4);
    log(off, 200);
    log(info, 8);
    return call_count;
}
