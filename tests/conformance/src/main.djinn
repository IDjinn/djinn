namespace conformance;

import testing;
import djinnc::testing;

i32 main() {
    Config* config = Runner.parse_config();
    if (!config.ok) {
        Runner.print_usage();
        return 2;
    }
    Verify* verify = Verify.create(config);
    verify.test("selftest").selftest();
    Suites.register(verify);
    Runner.add_orphans(verify, "tests/djinnc");
    return Runner.run(verify);
}
