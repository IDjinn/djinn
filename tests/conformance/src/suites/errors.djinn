}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INTERFACE_NOT_IMPLEMENTED).at(5, 1));
    }

    [Test]
    void interface_wrong_signature() {
        str source = """
interface Shape {
    i32 area();
}

struct Blob {
    i32 x;
}

impl Shape for Blob {
    i64 area() {
        return 1;
    }
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INTERFACE_NOT_IMPLEMENTED).at(9, 6));
