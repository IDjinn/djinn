    ptr<i32> raw = (ptr<i32>)&value;
    ptr<i32> next = raw + 1;
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.UNSAFE_REQUIRED).at(4, 25));
    }

