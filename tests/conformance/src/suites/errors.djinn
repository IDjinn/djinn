    void ptr_deref_safe() {
        str source = """
i32 main() {
    i32 value = 7;
    ptr<i32> raw = (ptr<i32>)&value;
    return *raw;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.UNSAFE_REQUIRED).at(4, 12));
    }

    [Test]
    void extern_call_safe() {
        str source = """
extern "C" { i32 abs(i32 value); }

i32 main() {
    return abs(-3);
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.UNSAFE_REQUIRED).at(4, 15));
