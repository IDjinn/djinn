}

i32 main() {
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.IMPURE_OPERATION).at(5, 5));
    }

    [Test]
    void pure_function_calls_pure_extern() {
        str source = """
extern "C" {
    [Pure]
