    void string_literal_into_struct_pointer_variable() {
        str source = """
struct Box { i32 value; }
i32 main() {
    Box* box = "text";
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.IMPLICIT_CONVERSION).at(3, 16));
    }

    [Test]
    void string_literal_returned_as_struct_pointer() {
        str source = """
struct Box { i32 value; }
Box* make() {
    return "text";
}
i32 main() {
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.IMPLICIT_CONVERSION).at(3, 12));
    }

    [Test]
    void pointer_to_other_pointer_type_variable() {
        str source = """
struct Box { i32 value; }
struct Other { i32 value; }
i32 convert(Other* other) {
    Box* box = other;
    return box.value;
}
i32 main() {
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.IMPLICIT_CONVERSION).at(4, 16));
    }

    [Test]
    void pointer_to_other_pointer_type_argument() {
        str source = """
struct Box { i32 value; }
struct Other { i32 value; }
i32 read(Box* box) { return box.value; }
i32 convert(Other* other) {
    return read(other);
}
i32 main() {
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.IMPLICIT_CONVERSION).at(5, 17));
    }

    [Test]
    void string_literal_overload_prefers_str() {
        str source = """
struct Box { i32 value; }
i32 pick(Box* box) { return 1; }
i32 pick(str text) { return 2; }
i32 main() {
    return pick("text");
}
""";
        Verify.source(source).with_std().runs(Expected.exit(2));
    }

    [Test]
    void string_literal_overload_skips_other_pointer() {
        str source = """
i32 pick(str text) { return 2; }
i32 pick(i32* value) { return 1; }
i32 main() {
    return pick("text");
}
""";
        Verify.source(source).with_std().runs(Expected.exit(2));
    }

    [Test]
    void string_literal_into_overloaded_pointer_argument() {
        str source = """
struct Box { i32 value; }
i32 read(Box* box) { return box.value; }
i32 main() {
    return read("text");
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.NO_MATCHING_OVERLOAD).at(4, 17));
    }

    [Test]
    void missing_semicolon_is_reported_where_it_was_expected() {
        str source = """
i32 main() {
    i32 a = 1
    i32 b = 2;
    return a + b;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.UNEXPECTED_TOKEN).at(2, 14));
    }

    [Test]
    void extern_redeclaration_identical_is_a_warning() {
        str source = """
extern i32 abs(i32 value);
extern i32 abs(i32 value);

i32 main() {
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.warning(DiagnosticWarnings.EXTERN_REDECLARED).at(2, 8));
    }

    [Test]
    void extern_redeclaration_with_std_declaration_is_a_warning() {
        str source = """
extern i32 strlen(i8* s);

unsafe i32 main() {
    return strlen("abc");
}
""";
        Verify.source(source).with_std().diagnostics(Expected.warning(DiagnosticWarnings.EXTERN_REDECLARED));
    }

    [Test]
    void extern_redeclaration_nullable_pointer_matches_raw_pointer() {
        str source = """
extern i8*? lookup(i8* name);
extern ptr<i8> lookup(ptr<i8> name);

i32 main() {
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.warning(DiagnosticWarnings.EXTERN_REDECLARED).at(2, 8));
    }

    [Test]
    void extern_redeclaration_with_other_return_type_is_an_error() {
        str source = """
extern i32 abs(i32 value);
extern i64 abs(i32 value);

i32 main() {
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.DUPLICATE_DEFINITION).at(2, 8));
    }

    [Test]
    void extern_redeclaration_with_other_parameter_is_an_error() {
        str source = """
extern i32 abs(i32 value);
extern i32 abs(i64 value);

i32 main() {
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.DUPLICATE_DEFINITION).at(2, 8));
    }

    [Test]
    void extern_redeclaration_with_other_variadic_flag_is_an_error() {
        str source = """
extern i32 printf(i8* format, ...);
extern i32 printf(i8* format);

i32 main() {
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.DUPLICATE_DEFINITION).at(2, 8));
    }

    [Test]
    void member_list_is_not_a_text_argument() {
        str source = """
struct Box { i32 value; }

void show(str text) {
}

i32 main() {
    show(Box#fields);
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.ARGUMENT_TYPE_MISMATCH).at(7, 10));
    }

    [Test]
    void returning_a_void_call_is_an_error() {
        str source = """
void nothing() {
}

i32 main() {
    return nothing();
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.RETURN_MISMATCH).at(5, 19));
    }
}
