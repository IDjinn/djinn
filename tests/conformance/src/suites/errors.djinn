    [Test]
    void extern_call_in_unsafe_constructor() {
        str source = """
extern "C" { i32 abs(i32 value); }

struct Holder {
    i32 value;

    unsafe Holder() {
        this.value = abs(-5);
    }
}

i32 main() {
    Holder holder = Holder();
    return holder.value;
}
""";
        Verify.source(source).runs(Expected.exit(5));
    }

