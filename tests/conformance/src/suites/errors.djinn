namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct ErrorsTests {
    [Test]
    void attribute_payload_not_constant() {
        str source = """
attribute Stage(AttributeTarget.All) {
    i32 mask;
}

i32 runtime_value() {
    return 3;
}

[Stage(runtime_value())]
i32 main() {
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_ATTRIBUTE_ARGUMENT).at(9, 21));
    }

    [Test]
    void attribute_payload_too_many() {
        str source = """
attribute Stage(AttributeTarget.All) {
    i32 mask;
}

[Stage(1, 2)]
i32 main() {
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.UNKNOWN_FIELD).at(5, 11));
    }

    [Test]
    void attribute_payload_unknown_field() {
        str source = """
attribute Stage(AttributeTarget.All) {
    i32 mask;
}

[Stage(nope = 1)]
i32 main() {
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.UNKNOWN_FIELD).at(5, 8));
    }

    [Test]
    void borrow_assign_while_borrowed() {
        str source = """
i32 main() {
    mut i32 value = 1;
    i32* reference = &value;
    value = 2;
    return *reference;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.BORROW_CONFLICT).at(4, 5));
    }

    [Test]
    void borrow_exclusive_conflict() {
        str source = """
i32 main() {
    mut i32 value = 1;
    i32* first = &value;
    i32* second = &value;
    return *first + *second;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.BORROW_CONFLICT).at(4, 19));
    }

    [Test]
    void borrow_move_while_borrowed() {
        str source = """
struct Data : Disposable {
    i32 value;

    void disposable() {
    }
}

i32 main() {
    Data first = { .value = 1 };
    Data* reference = &first;
    Data second = first;
    return reference.value + second.value;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.BORROW_CONFLICT).at(11, 19));
    }

    [Test]
    void view_blocks_move_of_its_source() {
        str source = """
i32 main() {
    string text = "abc";
    str view = text;
    string other = text;
    return (i32)view.length;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.BORROW_CONFLICT).at(4, 20));
    }

    [Test]
    void view_from_method_blocks_move_of_its_source() {
        str source = """
i32 main() {
    string text = "abcdef";
    str part = text.slice(1, 2);
    string other = text;
    return (i32)part.length;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.BORROW_CONFLICT).at(4, 20));
    }

    [Test]
    void view_cannot_be_returned_from_its_local() {
        str source = """
str leak() {
    string text = "abc";
    return text;
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.BORROW_OUTLIVES_VALUE).at(3, 12));
    }

    [Test]
    void borrow_return_local() {
        str source = """
i32* leak() {
    i32 value = 1;
    return &value;
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.BORROW_OUTLIVES_VALUE).at(3, 12));
    }

    [Test]
    void break_outside_loop() {
        str source = """
i32 main() {
    break;
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_JUMP).at(2, 5));
    }

    [Test]
    void compile_time_if_runtime() {
        str source = """
i32 main() {
    mut i32 x = 1;
    if constexpr x > 0 {
        return 1;
    }
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(3, 18));
    }

    [Test]
    void consteval_runtime_argument() {
        str source = """
consteval i32 twice(i32 n) {
    return n * 2;
}

i32 main() {
    mut i32 x = 4;
    return twice(x);
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(7, 18));
    }

    [Test]
    void constexpr_not_constant() {
        str source = """
i32 runtime_value() {
    return 3;
}

constexpr i32 VALUE = runtime_value();

i32 main() {
    return VALUE;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(5, 36));
    }

    [Test]
    void constructor_arguments() {
        str source = """
struct Point {
    i32 x;
    i32 y;

    Point(i32 x, i32 y) {
        this.x = x;
        this.y = y;
    }
}

i32 main() {
    Point p = Point(1);
    return p.x;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTRUCTOR_CALL).at(12, 20));
    }

    [Test]
    void enum_cross_compare() {
        str source = """
enum Tone { A(), B() }
enum Shade { X(), Y() }
i32 main() {
    Tone k = Tone::A();
    Shade o = Shade::X();
    if (k == o) { return 1; }
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_OPERATOR_OPERAND).at(6, 11));
    }

    [Test]
    void enum_payload() {
        str source = """
enum Shape {
    Circle(i32),
    Square
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.ENUM_WITH_PAYLOAD).at(1, 1));
    }

    [Test]
    void error_missing_try() {
        str source = """
struct Failure;

i32 risky() throws(Failure) {
    throw Failure();
}

i32 main() {
    return risky();
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.MISSING_TRY).at(8, 17));
    }

    [Test]
    void error_switch_not_exhaustive() {
        str source = """
struct First;
struct Second;

i32 risky() throws(First, Second) {
    throw First();
}

i32 main() {
    return switch risky() {
        Result v -> v,
        First e -> 1
    };
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.SWITCH_NOT_EXHAUSTIVE).at(9, 12));
    }

    [Test]
    void error_throw_not_listed() {
        str source = """
struct Failure;
struct Other;

i32 risky() throws(Failure) {
    throw Other();
}

i32 main() {
    return try risky() ?: 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.THROWS_TYPE_MISMATCH).at(5, 5));
    }

    [Test]
    void error_try_non_throwing() {
        str source = """
i32 plain() {
    return 1;
}

i32 main() {
    return try plain() ?: 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.TRY_ON_NON_THROWING).at(6, 12));
    }

    [Test]
    void generic_constraint_violated() {
        str source = """
interface IValue {
    i32 getValue();
}

struct Container<T> where T : IValue {
    T item;
}

struct Plain {
    i32 x;
}

i32 main() {
    Plain p = { .x = 1 };
    Container<Plain> c = { .item = p };
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INTERFACE_NOT_IMPLEMENTED).at(15, 5));
    }

    [Test]
    void generic_function_constraint() {
        str source = """
interface Comparable<T> {
    i32 compare(T other);
}

struct Plain {
    i32 x;
}

T larger<T>(T a, T b) where T : Comparable<T> {
    return a;
}

i32 main() {
    Plain a = { .x = 1 };
    Plain b = { .x = 2 };
    Plain c = larger(a, b);
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INTERFACE_NOT_IMPLEMENTED).at(16, 21));
    }

    [Test]
    void generic_interface_mismatch() {
        str source = """
interface Comparable<T> {
    i32 compare(T other);
}

struct Point : Comparable<Point> {
    i32 x;

    i32 compare(i32 other) {
        return this.x - other;
    }
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INTERFACE_NOT_IMPLEMENTED).at(5, 1));
    }

    [Test]
    void generic_partial_constraint() {
        str source = """
interface IReadable {
    i32 read();
}

interface IWritable {
    void write(i32 value);
}

struct Store<T> where T : IReadable, IWritable {
    T backend;
}

struct ReadOnly : IReadable {
    i32 value;

    i32 read() {
        return this.value;
    }
}

i32 main() {
    Store<ReadOnly> s;
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INTERFACE_NOT_IMPLEMENTED).at(22, 5));
    }

    [Test]
    void immutable_assignment() {
        str source = """
