    [Test]
    void macro_ambiguous() {
        str source = """
macro pick {
    (expression a) => { a }
    (expression b) => { b }
}

i32 main() {
    return pick(1);
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.MACRO).at(1, 7));
    }

    [Test]
    void macro_no_match() {
        str source = """
macro pick {
    (add, expression a) => { a }
}

i32 main() {
    return pick(sub, 1);
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.MACRO).at(6, 12));
    }

    [Test]
    void overload_ambiguous() {
        str source = """
i32 pick(i32 a, i64 b) {
    return 1;
}

i32 pick(i64 a, i32 b) {
    return 2;
}

i32 main() {
    return pick(1, 2);
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.AMBIGUOUS_CALL).at(10, 16));
    }

    [Test]
    void overload_none() {
        str source = """
struct P {
    i32 x;
}

i32 take(i32 a) {
    return a;
}

i32 take(i32 a, i32 b) {
    return a;
}

i32 main() {
    P p = { .x = 1 };
    return take(p);
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.NO_MATCHING_OVERLOAD).at(15, 17));
    }

    [Test]
    void ptr_arithmetic_safe() {
        str source = """
