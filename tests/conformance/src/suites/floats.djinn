namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct FloatIeeeTests {
    [Test]
    void follows_ieee() {
        str source = """
f64 divide(f64 left, f64 right) {
    return left / right;
}

f64 rem(f64 left, f64 right) {
    return left % right;
}

f32 narrow(f64 value) {
    return (f32)value;
}

i32 main() {
    f64 infinity = divide(1.0, 0.0);
    f64 nan = divide(0.0, 0.0);
    if (infinity <= 1.0e300) { return 1; }
    if (divide(0.0 - 1.0, 0.0) >= 0.0 - 1.0e300) { return 2; }
    if (nan == nan) { return 3; }
    if (nan != nan) {
        if (nan < 1.0 || nan > 1.0) { return 4; }
    } else {
        return 5;
    }
    f64 from_zero = rem(1.0, 0.0);
    if (from_zero == from_zero) { return 6; }
    if (rem(7.5, 2.0) != 1.5) { return 7; }
    if ((f64)narrow(1.0e300) <= 1.0e300) { return 8; }
    return 0;
}
""";
        Verify.source(source).runs(Expected.exit(0));
    }

    [Test]
    void interpolation_prints_shortest_round_trip() {
        str source = """
extern "C" {
    i32 memcmp(void* left, void* right, u64 count);
}

f64 sum(f64 left, f64 right) { return left + right; }
f64 inverse(f64 value) { return 1.0 / value; }

i32 differs(string actual, i8* expected, u32 length) {
    if (actual.length != length) { return 1; }
    if (memcmp(actual.data, expected, (u64)length) != 0) { return 1; }
    return 0;
}

i32 main() {
    f64 zero = 0.0;
    f64 third = 0.1;
    f32 single = 0.1;
    f64 huge = 1.7976931348623157e308;
    f64 tiny = 5.0e-324;
    f32 single_pi = 3.14159;
    f64 pi = 3.14159;
    if (differs($"{sum(0.1, 0.2)}", "0.30000000000000004", 19) != 0) { return 1; }
    if (differs($"{1234567.0}", "1234567", 7) != 0) { return 2; }
    if (differs($"{1.0e16}", "1E+16", 5) != 0) { return 3; }
    if (differs($"{0.00001}", "1E-05", 5) != 0) { return 4; }
    if (differs($"{100.0}", "100", 3) != 0) { return 5; }
    if (differs($"{zero * (0.0 - 1.0)}", "-0", 2) != 0) { return 6; }
    if (differs($"{inverse(zero)}", "Infinity", 8) != 0) { return 7; }
    if (differs($"{0.0 - inverse(zero)}", "-Infinity", 9) != 0) { return 8; }
    if (differs($"{zero / zero}", "NaN", 3) != 0) { return 9; }
    if (differs($"{single}", "0.1", 3) != 0) { return 10; }
    if (differs($"{third}", "0.1", 3) != 0) { return 11; }
    if (differs($"{0.0001}", "0.0001", 6) != 0) { return 12; }
    if (differs($"{123456789012345.0}", "123456789012345", 15) != 0) { return 13; }
    if (differs($"{1.0e15}", "1E+15", 5) != 0) { return 14; }
    if (differs($"{1.5e-7}", "1.5E-07", 7) != 0) { return 15; }
    if (differs($"{0.0 - 2.5}", "-2.5", 4) != 0) { return 16; }
    if (differs($"{huge}", "1.7976931348623157E+308", 23) != 0) { return 17; }
    if (differs($"{tiny}", "5E-324", 6) != 0) { return 18; }
    if (differs($"{single_pi:.2}", "3.14", 4) != 0) { return 19; }
    if (differs($"{pi:10}", "   3.14159", 10) != 0) { return 20; }
    if (differs($"{single_pi:010}", "0003.14159", 10) != 0) { return 21; }
    if (differs($"{pi:-12.3}", "3.142       ", 12) != 0) { return 22; }
    return 0;
}
""";
        Verify.source(source).runs(Expected.exit(0));
    }

    [Test]
    void array_text_uses_the_same_format() {
        str source = """
extern "C" {
    i32 memcmp(void* left, void* right, u64 count);
}

i32 main() {
    f64[] values = [1.5, 2.25, 0.30000000000000004];
    string text = $"{values}";
    if (text.length != 34) { return 1; }
    if (memcmp(text.data, "[ 1.5, 2.25, 0.30000000000000004 ]", 34) != 0) { return 2; }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }
}
