namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct AsyncTests {
    [Test]
    void SimpleReturnValue() {
        str source = """
async i32 compute() {
    return 42;
}

i32 main() {
    i32 result = await compute();
    return result;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void WithParameter() {
        str source = """
async i32 double_val(i32 x) {
    return x * 2;
}

i32 main() {
    i32 result = await double_val(21);
    return result;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void MultipleParameters() {
        str source = """
async i32 add(i32 a, i32 b) {
    return a + b;
}

i32 main() {
    i32 result = await add(30, 12);
    return result;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void ExpressionComputation() {
        str source = """
async i32 compute(i32 x) {
    return x * 2 + 1;
}

i32 main() {
    i32 result = await compute(10);
    return result;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(21));
    }

    [Test]
    void AsyncMain() {
        str source = """
async i32 get_value() {
    return 99;
}

async i32 main() {
    i32 val = await get_value();
    return val;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(99));
    }

    [Test]
    void AsyncMainWithComputation() {
        str source = """
async i32 square(i32 x) {
    return x * x;
}

async i32 main() {
    i32 a = await square(3);
    i32 b = await square(4);
    return a + b;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(25));
    }

    [Test]
    void DiagnosticsForNonWaitableAsync() {
        str source = """
async i32 get_value() {
    return 99;
}

async i32 main() {
    i32 val = get_value();
    return val;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.VALUE_TYPE_MISMATCH));
    }

    [Test]
    void MultipleAwaitsSequential() {
        str source = """
async i32 get_a() {
    return 10;
}

async i32 get_b() {
    return 20;
}

i32 main() {
    i32 a = await get_a();
    i32 b = await get_b();
    return a + b;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(30));
    }

    [Test]
    void ThreeAwaitsAccumulate() {
        str source = """
async i32 val(i32 x) {
    return x;
}

i32 main() {
    i32 a = await val(10);
    i32 b = await val(20);
    i32 c = await val(30);
    return a + b + c;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(60));
    }

    [Test]
    void ChainedAwait() {
        str source = """
async i32 inner() {
    return 10;
}

async i32 outer() {
    i32 val = await inner();
    return val + 5;
}

i32 main() {
    i32 result = await outer();
    return result;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(15));
    }

    [Test]
    void DeepChaining() {
        str source = """
async i32 level3() {
    return 5;
}

async i32 level2() {
    i32 val = await level3();
    return val * 2;
}

async i32 level1() {
    i32 val = await level2();
    return val + 3;
}

i32 main() {
    i32 result = await level1();
    return result;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(13));
    }

    [Test]
    void ThousandLevelAwaitChain() {
        str source = """
async i64 depth(i32 n) {
    if (n == 0) {
        return 0;
    }
    i64 below = await depth(n - 1);
    return below + 1;
}

async i32 main() {
    i64 total = await depth(1000);
    if (total == 1000) {
        return 42;
    }
    return 1;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void ManyAwaitsReuseFrames() {
        str source = """
async i64 leaf(i64 x) {
    return x + 1;
}

async i64 node(i64 x) {
    i64 a = await leaf(x);
    i64 b = await leaf(a);
    return b;
}

async i32 main() {
    mut i64 sum = 0;
    for (mut i64 i = 0; i < 20000; i = i + 1) {
        sum = sum + await node(i);
    }
    if (sum == 200030000) {
        return 42;
    }
    return 1;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void ChainedAsyncMain() {
        str source = """
async i32 add(i32 a, i32 b) {
    return a + b;
}

async i32 compute() {
    i32 x = await add(10, 20);
    i32 y = await add(x, 5);
    return y;
}

async i32 main() {
    i32 result = await compute();
    return result;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(35));
    }

    [Test]
    void AwaitResultAsArgument() {
        str source = """
async i32 double_it(i32 x) {
    return x * 2;
}

i32 main() {
    i32 a = await double_it(5);
    i32 b = await double_it(a);
    return b;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(20));
    }

    [Test]
    void AwaitWithLocalComputation() {
        str source = """
async i32 fetch(i32 x) {
    return x + 1;
}

i32 main() {
    i32 val = await fetch(10);
    i32 local = val * 3;
    return local;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(33));
    }

    [Test]
    void NonAsyncMainStillWorks() {
        str source = """
async i32 compute() {
    return 77;
}

i32 main() {
    i32 result = await compute();
    return result;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(77));
    }
}

struct SpawnTests {
    [Test]
    void MultipleSpawnsParse() {
        str source = """
async i32 work(i32 x) {
    return x;
}

async i32 main() {
    spawn work(1);
    spawn work(2);
    spawn work(3);
    return 0;
}
""";
        Verify.source(source).with_std().compiles().runs(Expected.exit(0));
    }
}

struct AsyncElisionTests {
    [Test]
    void NeverSuspendingChainRuns() {
        str source = """
async i32 leaf(i32 x) {
    return x + 1;
}

async i32 middle(i32 x) {
    i32 value = await leaf(x);
    return value * 2;
}

i32 main() {
    i32 first = await middle(20);
    i32 second = await leaf(-43);
    return first + second;
}
""";
        Verify.source(source).runs(Expected.exit(0));
    }

    [Test]
    void NeverSuspendingFunctionHasNoCoroutine() {
        str source = """
async i32 leaf(i32 x) {
    return x + 1;
}

async i32 middle(i32 x) {
    i32 value = await leaf(x);
    return value * 2;
}

i32 main() {
    return await middle(20);
}
""";
        Verify.source(source).emits_ir(Expected.ir_contains("define i32 @leaf(").and_ir_contains("define i32 @middle(").and_ir_lacks("llvm.coro.id").and_ir_lacks("__djinn_event_loop_run"));
    }

    [Test]
    void NeverSuspendingFunctionWarns() {
        str source = """
async i32 leaf(i32 x) {
    return x + 1;
}

i32 main() {
    return await leaf(41);
}
""";
        Verify.source(source).diagnostics(Expected.warning(DiagnosticWarnings.ASYNC_NEVER_SUSPENDS).at(1, 7));
    }

    [Test]
    void SuspendingCallKeepsTheCallerAsync() {
        str source = """
import std::sys;

async i32 leaf(i32 x) {
    return x + 1;
}

async i32 waits(i32 x) {
    await Task.delay(1);
    i32 value = await leaf(x);
    return value;
}

i32 main() {
    return await waits(41);
}
""";
        Verify.source(source).with_std().diagnostics(Expected.warning(DiagnosticWarnings.ASYNC_NEVER_SUSPENDS).at(3, 7));
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("define ptr @waits(").and_ir_contains("define i32 @leaf("));
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void StaticMethodIsConvertedUnlessReflected() {
        str source = """
struct Calc {
    public static async i32 twice(i32 x) {
        return x * 2;
    }
}

[Reflect]
struct Shown {
    public static async i32 twice(i32 x) {
        return x * 2;
    }
}

i32 main() {
    i32 first = await Calc.twice(10);
    i32 second = await Shown.twice(11);
    return first + second;
}
""";
        Verify.source(source).diagnostics(Expected.warning(DiagnosticWarnings.ASYNC_NEVER_SUSPENDS).at(2, 25));
        Verify.source(source).emits_ir(Expected.ir_contains("define i32 @Calc.twice(").and_ir_contains("define ptr @Shown.twice("));
        Verify.source(source).runs(Expected.exit(42));
    }

    [Test]
    void NonTailRecursionStaysAsync() {
        str source = """
async i32 depth(i32 n) {
    if (n == 0) {
        return 0;
    }
    i32 below = await depth(n - 1);
    return below + 1;
}

i32 main() {
    return await depth(1000);
}
""";
        Verify.source(source).compiles();
        Verify.source(source).emits_ir(Expected.ir_contains("define ptr @depth("));
        Verify.source(source).runs(Expected.exit(1000));
    }

    [Test]
    void TailRecursiveCycleBecomesTailCalls() {
        str source = """
async bool is_even(i32 n) {
    if (n == 0) {
        return true;
    }
    return await is_odd(n - 1);
}

async bool is_odd(i32 n) {
    if (n == 0) {
        return false;
    }
    return await is_even(n - 1);
}

i32 main() {
    if (await is_even(3000000) && await is_odd(1000001)) {
        return 42;
    }
    return 1;
}
""";
        Verify.source(source).compiles();
        Verify.source(source).emits_ir(Expected.ir_contains("define i1 @is_even(").and_ir_contains("musttail call i1 @is_odd(").and_ir_contains("musttail call i1 @is_even(").and_ir_lacks("llvm.coro.id"));
        Verify.source(source).runs(Expected.exit(42));
        Verify.source(source).optimized(2).runs(Expected.exit(42));
    }

    [Test]
    void SelfTailRecursionRunsInConstantStack() {
        str source = """
async i64 sum_to(i64 n, i64 total) {
    if (n == 0) {
        return total;
    }
    return await sum_to(n - 1, total + n);
}

i32 main() {
    i64 sum = await sum_to(2000000, 0);
    if (sum == 2000001000000) {
        return 42;
    }
    return 1;
}
""";
        Verify.source(source).compiles();
        Verify.source(source).emits_ir(Expected.ir_contains("musttail call i64 @sum_to("));
        Verify.source(source).runs(Expected.exit(42));
    }

    [Test]
    void TailRecursionThrowsThroughTheRecord() {
        str source = """
struct Oops {
    i32 code;

    Oops(i32 code) {
        this.code = code;
    }
}

async i32 count_down(i32 n, i32 fail_at) throws(Oops) {
    if (n == fail_at) {
        throw Oops(n);
    }
    if (n == 0) {
        return 40;
    }
    return await count_down(n - 1, fail_at);
}

i32 main() {
    i32 finished = try await count_down(1000000, -1) ?: 0;
    i32 failed = try await count_down(1000000, 3) ?: 2;
    return finished + failed;
}
""";
        Verify.source(source).emits_ir(Expected.ir_contains("musttail call { i32, [1 x i64] } @count_down("));
        Verify.source(source).runs(Expected.exit(42));
    }

    [Test]
    void TailCycleThatSuspendsStaysAsync() {
        str source = """
import std::sys;

async bool is_even(i32 n) {
    if (n == 0) {
        await Task.pause();
        return true;
    }
    return await is_odd(n - 1);
}

async bool is_odd(i32 n) {
    if (n == 0) {
        return false;
    }
    return await is_even(n - 1);
}

i32 main() {
    if (await is_even(10)) {
        return 42;
    }
    return 1;
}
""";
        Verify.source(source).with_std().compiles();
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("define ptr @is_even(").and_ir_contains("define ptr @is_odd(").and_ir_lacks("musttail"));
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void TailCycleWithoutBaseCaseStaysAsync() {
        str source = """
async i32 spin(i32 n) {
    return await spin(n);
}

async i32 ping(i32 n) {
    return await pong(n - 1);
}

async i32 pong(i32 n) {
    return await ping(n + 1);
}

i32 main() {
    i32 limit = 0;
    if (limit > 0) {
        i32 value = await ping(limit);
        return await spin(value);
    }
    return 42;
}
""";
        Verify.source(source).compiles();
        Verify.source(source).emits_ir(Expected.ir_contains("define ptr @spin(").and_ir_contains("define ptr @ping(").and_ir_contains("define ptr @pong(").and_ir_lacks("musttail"));
        Verify.source(source).runs(Expected.exit(42));
    }

    [Test]
    void UnsafeTailCyclesStayAsync() {
        str source = """
struct Pair {
    i32 first;
    i32 second;
}

struct Data : Disposable {
    i32 value;

    void disposable() {
    }
}

async i32 walk(Pair pair, i32 n) {
    if (n == 0) {
        return pair.first;
    }
    return await walk(pair, n - 1);
}

async i32 narrow(i32 n) {
    if (n == 0) {
        return 1;
    }
    return await wide((i64)n - 1);
}

async i32 wide(i64 n) {
    if (n == 0) {
        return 2;
    }
    return await narrow((i32)n - 1);
}

async i32 owner(i32 n) {
    Data data = { .value = n };
    if (n == 0) {
        return data.value;
    }
    return await owner(n - 1);
}

i32 main() {
    Pair pair = { .first = 30, .second = 0 };
    i32 a = await walk(pair, 10);
    i32 b = await narrow(10);
    i32 c = await owner(10);
    return a + b + c + 10;
}
""";
        Verify.source(source).compiles();
        Verify.source(source).emits_ir(Expected.ir_contains("define ptr @walk(").and_ir_contains("define ptr @narrow(").and_ir_contains("define ptr @wide(").and_ir_contains("define ptr @owner(").and_ir_lacks("musttail"));
        Verify.source(source).runs(Expected.exit(41));
    }

    [Test]
    void TailCyclesReturningThroughMemoryStayAsync() {
        str source = """
struct Big {
    i64 a;
    i64 b;
    i64 c;
    i64 d;
}

struct Wide {
    i64 x;
    i64 y;
    i64 z;

    Wide(i64 x) {
        this.x = x;
        this.y = x;
        this.z = x;
    }
}

[Align(32)]
struct Aligned {
    i32 code;

    Aligned(i32 code) {
        this.code = code;
    }
}

async Big walk(i64 n) {
    if (n == 0) {
        Big big = { .a = 1, .b = 2, .c = 3, .d = 4 };
        return big;
    }
    return await walk(n - 1);
}

async i32 wide(i32 n) throws(Wide) {
    if (n < 0) {
        throw Wide(1);
    }
    if (n == 0) {
        return 10;
    }
    return await wide(n - 1);
}

async i32 aligned(i32 n) throws(Aligned) {
    if (n < 0) {
        throw Aligned(1);
    }
    if (n == 0) {
        return 20;
    }
    return await aligned(n - 1);
}

async i64 huge(i128 n) {
    if (n == 0) {
        return 2;
    }
    return await huge(n - 1);
}

i32 main() {
    Big big = await walk(100);
    i32 a = try await wide(100) ?: 0;
    i32 b = try await aligned(100) ?: 0;
    i64 c = await huge(100);
    return (i32)big.d + a + b + (i32)c + 6;
}
""";
        Verify.source(source).compiles();
        Verify.source(source).emits_ir(Expected.ir_contains("define ptr @walk(").and_ir_contains("define ptr @wide(").and_ir_contains("define ptr @aligned(").and_ir_contains("define ptr @huge(").and_ir_lacks("musttail"));
        Verify.source(source).runs(Expected.exit(42));
        Verify.source(source).optimized(2).runs(Expected.exit(42));
    }

    [Test]
    void SpawnedFunctionStaysAsync() {
        str source = """
async i32 work(i32 x) {
    return x;
}

async i32 main() {
    spawn work(1);
    i32 value = await work(41);
    return value + 1;
}
""";
        Verify.source(source).with_std().compiles();
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("define ptr @work("));
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void StoredTaskStaysAsync() {
        str source = """
async i32 work(i32 x) {
    return x * 2;
}

i32 main() {
    task<i32> pending = work(21);
    return await pending;
}
""";
        Verify.source(source).compiles();
        Verify.source(source).emits_ir(Expected.ir_contains("define ptr @work("));
        Verify.source(source).runs(Expected.exit(42));
    }

    [Test]
    void ThrowsPropagateThroughConvertedAwait() {
        str source = """
import std::sys;

struct Oops {
    i32 code;

    Oops(i32 code) {
        this.code = code;
    }
}

async i32 risky(i32 x) throws(Oops) {
    if (x > 5) {
        throw Oops(x);
    }
    return x;
}

async i32 wrapper(i32 x) throws(Oops) {
    i32 value = await risky(x);
    return value + 1;
}

async i32 suspending(i32 x) throws(Oops) {
    await Task.delay(1);
    i32 value = await wrapper(x);
    return value * 10;
}

i32 main() {
    i32 passed = try await wrapper(3) ?: 100;
    i32 failed = try await wrapper(9) ?: 30;
    i32 direct = try await risky(7) ?: 2;
    i32 resumed = try await suspending(1) ?: 500;
    i32 rethrown = try await suspending(8) ?: 600;
    return passed + failed + direct + resumed + rethrown;
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("define { i32, [1 x i64] } @wrapper(").and_ir_contains("define ptr @suspending("));
        Verify.source(source).with_std().runs(Expected.exit(656));
    }
}
