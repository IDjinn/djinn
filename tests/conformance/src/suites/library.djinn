namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct LibraryTests {
    [Test]
    void optimized_library_keeps_instances() {
        str library = """
namespace gx;

public T twice<T>(T value) {
    return value + value;
}

public i32 doubled(i32 value) {
    return twice<i32>(value);
}
""";
        str source = """
namespace app;
import gx;

i32 main() {
    return doubled(21);
}
""";
        Verify.source(source).optimized(2).links_library(library, Expected.exit(42));
    }

    [Test]
    void mathlib() {
        str library = """
namespace mathlib;

macro twice {
    (expression v) => { v + v }
}

unsafe static mut i32 calls = 0;

[Reflect]
struct Counter {
    mut i32 value;

    public void bump() {
        this.value = this.value + 1;
        calls = calls + 1;
    }

    public i32 get() {
        return this.value;
    }

    public i32 get(i32 extra) {
        return this.get() + extra;
    }
}

struct Box<T> {
    T item;

    public T take() {
        return this.item;
    }
}

constexpr i32 cube(i32 x) {
    return x * x * x;
}

public i32 square(i32 x) {
    // secret implementation detail
    return x * x;
}

public i32 total_calls() {
    return calls;
}
""";
        str source = """
namespace app;
import mathlib;

i32 main() {
    Counter c = { .value = 0 };
    c.bump();
    c.bump();
    Box<i32> b = { .item = 5 };
    i32 a = twice(square(3));
    return a + c.get(1) + b.take() + total_calls() + cube(2);
}
""";
        Verify.source(source).links_library(library, Expected.exit(36));
    }

    [Test]
    void optimized_library_inlines_small_functions() {
        str library = """
namespace fastlib;

unsafe static mut i32 hits = 0;

public i32 triple(i32 x) {
    return x * 3 + 1;
}

public i32 clamp_low(i32 x, i32 low) {
    if (x < low) {
        return low;
    }
    return x;
}

public i32 count() {
    hits = hits + 1;
    return hits;
}

public i32 total() {
    return hits;
}
""";
        str source = """
namespace app;
import fastlib;

i32 main() {
    count();
    count();
    return triple(clamp_low(4, 1)) + total();
}
""";
        Verify.source(source).optimized(2).links_library(library, Expected.exit(15));
    }

    [Test]
    void never_suspending_async_keeps_its_task_abi() {
        str library = """
namespace asynclib;

public async task<i32> plus_one(i32 x) {
    return x + 1;
}
""";
        str source = """
namespace app;
import asynclib;

async task<i32> twice_plus(i32 x) {
    i32 value = await plus_one(x);
    return value * 2;
}

task<i32> main() {
    i32 direct = await plus_one(20);
    i32 chained = await twice_plus(10);
    return direct + chained;
}
""";
        Verify.source(source).links_library(library, Expected.exit(43));
    }

    [Test]
    void task_signatures_cross_the_library() {
        str library = """
import std::sys;

namespace asynclib;

public task<i32> slow_plus_one(i32 x) {
    await Task.pause();
    return x + 1;
}

public task<i32> forward(i32 x) {
    return slow_plus_one(x);
}

public task<T> echo<T>(T value) {
    await Task.pause();
    return value;
}

public sync i32 blocking(i32 x) {
    return slow_plus_one(x).sync;
}
""";
        str source = """
namespace app;
import asynclib;

task<i32> main() {
    i32 a = await slow_plus_one(1);
    i32 b = await forward(a);
    i32 c = await echo(b);
    return c * 10 + blocking(b);
}
""";
        Verify.source(source).with_std().links_library(library, Expected.exit(34));
    }

    [Test]
    void operators_cross_the_library() {
        str library = """
namespace vectors;

struct Vec2 {
    i32 x;
    i32 y;
}

impl Vec2 {
    operator +(Vec2 left, Vec2 right) -> Vec2 {
        return { .x = left.x + right.x, .y = left.y + right.y };
    }

    operator ==(Vec2 left, Vec2 right) -> bool {
        return left.x == right.x && left.y == right.y;
    }
}

public Vec2 make(i32 x, i32 y) {
    Vec2 value = { .x = x, .y = y };
    return value;
}
""";
        str source = """
namespace app;
import vectors;

i32 main() {
    Vec2 sum = make(1, 2) + make(3, 4);
    if (sum == make(4, 6)) {
        return sum.x * 10 + sum.y;
    }
    return 1;
}
""";
        Verify.source(source).links_library(library, Expected.exit(46));
    }

    [Test]
    void static_strings_cross_the_library() {
        str library = """
namespace texts;

public string greeting() {
    return "hello";
}

public string built(i32 value) {
    return $"value {value}";
}
""";
        str source = """
namespace app;
import texts;

i32 main() {
    mut i32 total = 0;
    for (mut i32 i = 0; i < 1000; i = i + 1) {
        string fixed = greeting();
        string owned = built(i);
        if (fixed.is_static() && !owned.is_static()) {
            total = total + 1;
        }
    }
    string last = greeting() + "!";
    return total / 100 + (i32)last.length + 26;
}
""";
        Verify.source(source).links_library(library, Expected.exit(42));
    }

    [Test]
    void overflow_modes_cross_the_library() {
        str library = """
namespace modes;

public i32w wrap(i32w value) {
    return value + 1w;
}

public i32s clamp(i32s value) {
    return value + 1s;
}

public i32 add(i32 a, i32 b) throws(Overflow) {
    return a + b;
}

public T twice<T>(T value) {
    return value + value;
}
""";
        str source = """
namespace app;
import modes;

i32 main() {
    if (wrap(2147483647w) != 0 - 2147483647 - 1) { return 1; }
    if (clamp(2147483647s) != 2147483647s) { return 2; }
    i32 caught = try add(2147483647, 1) ?: 7;
    if (caught != 7) { return 3; }
    if (twice<i32>(21) != 42) { return 4; }
    return 42;
}
""";
        Verify.source(source).links_library(library, Expected.exit(42));
    }

    [Test]
    void interfaces_and_impls_cross_the_library() {
        str library = """
namespace shapes;

interface Ranked {
    i32 rank();
}

interface Sized {
    i32 size();
}

struct Crate {
    i32 number;
    i32 volume;
}

impl Ranked, Sized for Crate {
    i32 rank() {
        return this.number;
    }

    i32 size() {
        return this.volume;
    }
}

struct Holder<T> where T : Ranked {
    T item;

    public i32 best() {
        return this.item.rank();
    }
}

public Crate make(i32 number, i32 volume) {
    Crate crate = { .number = number, .volume = volume };
    return crate;
}
""";
        str source = """
namespace app;
import shapes;

struct Pallet {
    i32 level;
}

impl Ranked for Pallet {
    i32 rank() {
        return this.level;
    }
}

i32 main() {
    Crate crate = make(5, 6);
    Holder<Crate> holder = { .item = crate };
    Pallet pallet = { .level = 30 };
    Holder<Pallet> other = { .item = pallet };
    return holder.best() + crate.size() + other.best() + 1;
}
""";
        Verify.source(source).links_library(library, Expected.exit(42));
    }

    [Test]
    void enums_cross_the_library() {
        str library = """
namespace messages;

enum Light {
    Red(),
    Green(),
    Blue()
}

union Message {
    Empty(),
    Number(i32),
    Pair(i32, i32)
}

impl Message {
    i32 weight() {
        return switch this {
            Empty -> 1,
            Number n -> n,
            Pair a b -> a * b
        };
    }
}

public Message pair(i32 a, i32 b) {
    return Message::Pair(a, b);
}

public Light green() {
    return Light::Green();
}
""";
        str source = """
namespace app;
import messages;

i32 main() {
    Message number = Message::Number(30);
    Light light = green();
    i32 shade = switch light {
        Red -> 0,
        Green -> 2,
        Blue -> 3
    };
    return pair(2, 5).weight() + number.weight() + shade;
}
""";
        Verify.source(source).links_library(library, Expected.exit(42));
    }

    [Test]
    void namespaces_and_imports_cross_the_library() {
        str library = """
namespace outer::inner;

struct Point {
    i32 x;
    i32 y;
}

public Point origin(i32 x) {
    Point point = { .x = x, .y = 2 };
    return point;
}

public i32 sum(Point point) {
    return point.x + point.y;
}
""";
        str source = """
namespace app;
import outer::inner;

i32 main() {
    Point point = origin(40);
    return sum(point);
}
""";
        Verify.source(source).links_library(library, Expected.exit(42));
    }

    [Test]
    void attributes_and_reflection_cross_the_library() {
        str library = """
namespace tagged;

attribute Stage(AttributeTarget.All) {
    i32 mask;
    i8* label;
}

[Stage(mask = 3, label = "both")]
public i32 target() {
    return 1;
}

[Reflect]
struct Record {
    i32 id;
    mut i32 count;
}
""";
        str source = """
namespace app;
import tagged;

unsafe i32 main() {
    MethodInfo* info = typeof(target);
    Stage* stage = (Stage*)info.attrs[0].payload;
    if (stage.mask != 3 || stage.label[0] != 98) {
        return 1;
    }
    TypeInfoExt* record = (TypeInfoExt*)typeof(Record);
    if (record.fieldCount != 2) {
        return 2;
    }
    return 42;
}
""";
        Verify.source(source).links_library(library, Expected.exit(42));
    }

    [Test]
    void dispose_crosses_the_library() {
        str library = """
namespace resources;

interface Disposable {
    void disposable();
}

unsafe static mut i32 released = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        released = released * 4 + this.id;
    }
}

struct Guard<T> : Disposable {
    T item;

    public void disposable() {
        released = released * 4 + 2;
    }
}

public i32 released_total() {
    return released;
}
""";
        str source = """
namespace app;
import resources;

i32 main() {
    {
        Handle first = { .id = 1 };
        Guard<i32> second = { .item = 7 };
        Handle moved = first;
    }
    return released_total();
}
""";
        Verify.source(source).links_library(library, Expected.exit(6));
    }

    [Test]
    void char_crosses_the_library_boundary() {
        str library = """
namespace charlib;

public char next_letter(char value) {
    return (char)((i32)value + 1);
}

public bool is_smile(char value) {
    return value == '😀';
}
""";
        str source = """
namespace app;
import charlib;

i32 main() {
    char letter = next_letter('a');
    mut i32 score = 0;
    if (letter == 'b') { score = score + 1; }
    if (is_smile('😀')) { score = score + 2; }
    return score;
}
""";
        Verify.source(source).links_library(library, Expected.exit(3));
    }

    [Test]
    void atomic_intrinsics_cross_the_library() {
        str library = """
namespace counters;

struct Counter<T> {
    mut T value;

    public unsafe T bump(T delta) {
        return atomic_add(&this.value, delta);
    }

    public unsafe bool replace(T expected, T desired) {
        return atomic_cas(&this.value, expected, desired);
    }
}

public unsafe i32 drain(i32* value) {
    return atomic_swap(value, 0);
}
""";
        str source = """
namespace app;
import counters;

i32 main() {
    mut Counter<i64> wide = { .value = 40 };
    wide.bump(2);
    mut Counter<i32> narrow = { .value = 1 };
    if (!narrow.replace(1, 5)) { return 1; }
    mut i32 left = 3;
    if (drain(&left) != 3 || left != 0) { return 2; }
    return (i32)wide.value + narrow.value - 5;
}
""";
        Verify.source(source).links_library(library, Expected.exit(42));
    }

    [Test]
    void closures_cross_the_library() {
        str library = """
namespace fx;

public i32 call_with(fn(i32) -> i32 f, i32 v) {
    return f(v);
}

public T apply_twice<T>(fn(T) -> T f, T v) {
    fn(T) -> T again = (T x) => f(f(x));
    return again(v);
}

public i32 local_twice(i32 v) {
    return apply_twice<i32>((i32 x) => x + 2, v);
}

public fn(i32) -> i32 adder(i32 n) {
    return (i32 x) => x + n;
}
""";
        str source = """
namespace app;
import fx;

i32 main() {
    fn(i32) -> i32 add5 = adder(5);
    return call_with((x) => x * 2, 4) + apply_twice<i32>((i32 x) => x + 1, 1) + add5(1) + local_twice(0);
}
""";
        Verify.source(source).links_library(library, Expected.exit(21));
    }

    [Test]
    void struct_mut_and_enum_parse_value_cross_the_library() {
        str library = """
namespace shapes;

enum Color {
    Red = 1,
    Green = 2,
    Unknown = 0
}

struct mut Cursor {
    i32 row;
    i32 column;
}

public Color color_from_code(i64 code) {
    return Color::parseValue(code);
}

public i32 moved_column(i32 amount) {
    Cursor cursor = { .row = 1, .column = 2 };
    cursor.column = cursor.column + amount;
    return cursor.column;
}
""";
        str source = """
namespace app;
import shapes;

i32 main() {
    Color green = color_from_code(2);
    Color missing = color_from_code(9);
    if (green == Color::Green && missing == Color::Unknown) {
        return moved_column(5);
    }
    return 1;
}
""";
        Verify.source(source).links_library(library, Expected.exit(7));
    }

    [Test]
    void library_functions_own_their_value_parameters() {
        str library = """
namespace fx;

unsafe static mut i32 drops = 0;

struct Guard : Disposable {
    i32 v;

    public unsafe void disposable() {
        drops = drops + 1;
    }
}

public i32 take(Guard g) {
    return g.v;
}

public i32 keep(fn() -> i32 f) {
    return f();
}

public unsafe i32 dropped() {
    return drops;
}
""";
        str source = """
namespace app;
import fx;

i32 main() {
    Guard g = { .v = 5 };
    i32 got = take(g);
    Guard held = { .v = 7 };
    i32 seen = keep(() => held.v);
    return got + seen + dropped() * 10;
}
""";
        Verify.source(source).links_library(library, Expected.exit(32));
    }

    [Test]
    void union_payloads_cross_the_library() {
        str library = """
namespace boxes;
import std::types;

unsafe static mut i32 released = 0;

struct Guard : Disposable {
    i32 id;

    public unsafe void disposable() {
        released = released * 4 + this.id;
    }
}

public optional<Guard> boxed(i32 id) {
    Guard guard = { .id = id };
    return optional::Value(guard);
}

public i32 take(Guard guard) {
    return guard.id;
}

public unsafe i32 released_total() {
    return released;
}
""";
        str source = """
namespace app;
import boxes;
import std::types;

i32 main() {
    optional<Guard> held = boxed(2);
    if (released_total() != 0) { return 100; }
    mut i32 got = 0;
    if (held is Value guard) { got = take(guard); }
    return got * 10 + released_total();
}
""";
        Verify.source(source).with_std().links_library(library, Expected.exit(22));
    }
}
