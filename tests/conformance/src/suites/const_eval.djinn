    if (K996 != f_u64_54(id_u64(6148914691236517205), id_u64(0))) { return 997; }
    if (K997 != f_u64_54(id_u64(6148914691236517205), id_u64(6148914691236517205))) { return 998; }
    if (K998 != f_u64_54(id_u64(18446744073709551614), id_u64(0))) { return 999; }
    if (K999 != f_u64_54(id_u64(18446744073709551614), id_u64(6148914691236517205))) { return 1000; }
    if (K1000 != f_u64_55(id_u64(0), id_u64(0))) { return 1001; }
    if (K1001 != f_u64_55(id_u64(0), id_u64(6148914691236517205))) { return 1002; }
    if (K1002 != f_u64_55(id_u64(3), id_u64(0))) { return 1003; }
    if (K1003 != f_u64_55(id_u64(3), id_u64(6148914691236517205))) { return 1004; }
    if (K1004 != f_u64_55(id_u64(6148914691236517205), id_u64(0))) { return 1005; }
    if (K1005 != f_u64_55(id_u64(6148914691236517205), id_u64(6148914691236517205))) { return 1006; }
    if (K1006 != f_u64_55(id_u64(18446744073709551614), id_u64(0))) { return 1007; }
    if (K1007 != f_u64_55(id_u64(18446744073709551614), id_u64(6148914691236517205))) { return 1008; }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

    [Test]
    void WideIntegersAreNotEvaluated() {
        str source = """
constexpr i128 f(i128 x) { return x * x; }
constexpr i128 K = f(4611686018427387904);
i32 main() { return 0; }
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION));
    }

    [Test]
    void WideIntegerCallFallsBackToRuntime() {
        str source = """
constexpr i128 f(i128 x) { return x * x; }
i32 main() {
    i128 big = f(4611686018427387904);
    if (big > 9223372036854775807) { return 7; }
    return 1;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(7));
    }

    [Test]
    void ConstexprArrayGlobal() {
        str source = """
constexpr arr<u32> K = [1, 2, 0x428a2f98, 4 + 1];
constexpr arr<f64> F = [1.5, 2.5];

i32 sum() {
    mut i32 total = 0;
    unsafe {
        for (mut size i = 0u; i < K.length; i = i + 1u) {
            total = total + (i32)(*(K.data + (i)) & 0xff);
        }
    }
    return total;
}

i32 main() {
    unsafe {
        if (*(F.data + (1)) != 2.5) { return 1; }
    }
    if (sum() == 1 + 2 + 0x98 + 5) {
        return 7;
    }
    return 2;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(7));
    }

    [Test]
    void ConstexprArrayNeedsConstantElements() {
        str source = """
i32 value() { return 3; }
constexpr arr<i32> K = [1, value()];

i32 main() {
    return 0;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(2, 33));
    }
}
