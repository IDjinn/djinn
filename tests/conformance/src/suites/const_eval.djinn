    [Test]
    void NamedConstant() {
        str source = """
constexpr i32 SIZE = 1024;

i32 main() {
    if (SIZE == 1024) {
        return 1;
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(1));
    }

    [Test]
    void NamedConstantInExpression() {
        str source = """
constexpr i32 BASE = 100;
constexpr i32 X = BASE + 5;

i32 main() {
    if (X == 105) {
        return 1;
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(1));
    }

    [Test]
    void MultipleNamedConstants() {
        str source = """
constexpr i32 WIDTH = 80;
constexpr i32 HEIGHT = 24;
constexpr i32 X = WIDTH * HEIGHT;

i32 main() {
    if (X == 1920) {
        return 1;
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(1));
    }

    [Test]
    void MaxIterationsExceeded() {
        str source = """
constexpr i32 X = 1;

i32 main() {
    if (X == 1) {
        return 1;
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(1));
    }

    [Test]
    void StackOverflowProtection() {
        str source = """
constexpr i32 X = 42;

i32 main() {
    if (X == 42) {
        return 1;
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(1));
    }

    [Test]
    void DivisionByZero() {
        str source = """
constexpr i32 X = 10 / 0;

i32 main() {
    return X;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(1, 24).with_message("division by zero").and_error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(1, 22));
    }

    [Test]
    void ModuloByZero() {
        str source = """
constexpr i32 X = 10 % 0;

i32 main() {
    return X;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(1, 24).with_message("division by zero").and_error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(1, 22));
    }

    [Test]
    void UnknownIdentifierReturnsError() {
        str source = """
constexpr i32 X = UNKNOWN + 1;

i32 main() {
    return X;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.UNDEFINED_VARIABLE).at(1, 19).and_error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION).at(1, 19));
    }
}

struct ConstEvalTextTests {
    [Test]
    void ConcatenationIsFolded() {
        str source = """
constexpr str GREETING = "hello" + ", " + "djinn";

i32 main() {
    str text = GREETING;
    return (i32)text.length;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(12));
    }

    [Test]
    void InterpolationIsFolded() {
        str source = """
constexpr i32 WIDTH = 7;
constexpr str LABEL = $"w={WIDTH}, ok={true}";

i32 main() {
    str text = LABEL;
    return (i32)text.length;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(12));
    }

    [Test]
    void FunctionsTakeAndReturnStrings() {
        str source = """
constexpr str wrap(str inner) {
    return "[" + inner + "]";
}

constexpr str BOXED = wrap(wrap("x"));

i32 main() {
    str text = BOXED;
    return (i32)text.length;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(5));
    }

    [Test]
    void ComparisonAndLength() {
        str source = """
constexpr str LEFT = "ab" + "cd";
constexpr bool SAME = LEFT == "abcd";
constexpr bool DIFFERENT = LEFT != "abcd";
constexpr i32 SIZE = (i32)LEFT.length;

i32 main() {
    if (SAME && !DIFFERENT) {
        return SIZE;
    }
    return 99;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(4));
    }
}
