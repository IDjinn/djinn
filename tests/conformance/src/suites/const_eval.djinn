    void BinaryLiteral() {
        str source = """
constexpr i32 X = 0b1010;

i32 main() {
    if (X == 10) {
        return 1;
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(1));
    }

