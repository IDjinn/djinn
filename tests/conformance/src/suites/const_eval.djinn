namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct ConstEvalVMTests {
    [Test]
    void IntegerLiteral() {
        str source = """
constexpr i32 X = 42;

i32 main() {
    if (X == 42) {
        return 1;
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(1));
    }

    [Test]
    void FloatLiteral() {
        str source = """
constexpr f64 X = 3.14;

i32 main() {
    if ((i32)(X * 100.0) == 314) {
        return 1;
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(1));
    }

    [Test]
    void BooleanLiteral() {
        str source = """
constexpr bool X = true;

i32 main() {
    if (X) {
        return 1;
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(1));
    }

    [Test]
    void BooleanFalseLiteral() {
        str source = """
constexpr bool X = false;

i32 main() {
    if (!X) {
        return 1;
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(1));
    }

    [Test]
    void HexLiteral() {
        str source = """
constexpr i32 X = 0xFF;

i32 main() {
    if (X == 255) {
        return 1;
