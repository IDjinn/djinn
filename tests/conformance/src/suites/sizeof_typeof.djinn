namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct SizeofTypeofTests {
    [Test]
    void sizeof_primitives() {
        str source = """
i32 main() {
    if ((i32)sizeof(i8) != 1) { return 1; }
    if ((i32)sizeof(i32) != 4) { return 2; }
    if ((i32)sizeof(i64) != 8) { return 3; }
    if ((i32)sizeof(f32) != 4) { return 4; }
    if ((i32)sizeof(f64) != 8) { return 5; }
    return 42;
}
""";
        Verify.source(source).runs(Expected.exit(42));
    }

    [Test]
    void sizeof_struct() {
        str source = """
struct Pair {
    i32 a;
    i64 b;
}

i32 main() {
    return (i32)sizeof(Pair);
}
""";
        Verify.source(source).runs(Expected.exit(16));
    }

    [Test]
    void sizeof_generic_struct_instances() {
        str source = """
struct Box<T> {
    T value;
}

struct Point {
    i32 x;
    i32 y;
}

i32 main() {
    if ((i32)sizeof(Box<i32>) != 4) { return 1; }
    if ((i32)sizeof(Box<i64>) != 8) { return 2; }
    if ((i32)sizeof(Box<Point>) != 8) { return 3; }
    return 42;
}
""";
        Verify.source(source).runs(Expected.exit(42));
    }

    [Test]
    void sizeof_nint_is_pointer_sized() {
        str source = """
i32 main() {
    return (i32)sizeof(nint) - (i32)sizeof(ptr);
}
""";
        Verify.source(source).runs(Expected.exit(0));
    }

    [Test]
    void typeof_reports_the_kind_of_a_type() {
        str source = """
struct Player {
    i32 id;
}

i32 main() {
    if (typeof(i32).kind != 0) { return 1; }
    if (typeof(f64).kind != 1) { return 2; }
    if (typeof(Player).kind != 3) { return 3; }
    return 42;
}
""";
        Verify.source(source).runs(Expected.exit(42));
    }

    [Test]
    void sizeof_of_an_expression_is_rejected() {
        str source = """
i32 main() {
    i32 x = 5;
    return (i32)sizeof(x);
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.UNKNOWN_TYPE).at(3, 17));
    }

    [Test]
    void alignof_is_not_an_intrinsic() {
        str source = """
i32 main() {
    return (i32)alignof(i32);
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.UNDECLARED_FUNCTION).at(2, 17));
    }
}
