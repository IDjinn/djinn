    [Test]
    void json_parse() {
        str source = """
import std::util;
import std::types;
import std::libc;
namespace app;

i32 check_diagnostic(void* item) {
    void*? code = Json.get(item, "code");
    return switch code {
        Value c -> check_fields(item, c),
        Empty -> 20
    };
}

i32 check_fields(void* item, void* code) {
    if (Json.as_int(code) != 2001) { return 21; }
    void*? line = Json.get(item, "line");
    return switch line {
        Value l -> check_line(item, l),
        Empty -> 22
    };
}

i32 check_line(void* item, void* line) {
    if (Json.as_int(line) != 3) { return 23; }
    void*? args = Json.get(item, "args");
    return switch args {
        Value a -> check_args(a),
        Empty -> 24
    };
}

i32 check_args(void* args) {
    if (Json.kind(args) != Json.ARRAY) { return 25; }
    if (Json.length(args) != 2) { return 26; }
    void*? first = Json.at(args, 0);
    return switch first {
        Value f -> check_first(f),
        Empty -> 27
    };
}

unsafe i32 check_first(void* first) {
    if (Json.kind(first) != Json.STRING) { return 28; }
    if (Json.length(first) != 6) { return 29; }
    i8* text = Json.as_text(first);
    if (text[0] != 66) { return 32; }
    return 0;
}

i32 with_document(void* document) {
    void* root = Json.root(document);
    i32 result = check_diagnostic(root);
    Json.release(document);
    return result;
}

i32 main() {
    i8* text = "{\"severity\":\"error\",\"code\":2001,\"line\":3,\"column\":10,\"args\":[\"BadOne\",\"x\"]}";
    i32 parsed = switch Json.parse(text, (i32)strlen(text)) {
        Value document -> with_document(document),
        Empty -> 30
    };
    if (parsed != 0) { return parsed; }
    i8* broken = "{\"code\": ";
    i32 rejected = switch Json.parse(broken, (i32)strlen(broken)) {
        Value document -> 31,
        Empty -> 0
    };
    return rejected;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

