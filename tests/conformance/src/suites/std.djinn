    [Test]
    void version() {
        str source = """
import std::util;
import std::types;
namespace app;

i32 main() {
    Version older = { .major = 1, .minor = 2, .patch = 3 };
    Version newer = { .major = 1, .minor = 3, .patch = 0 };
    mut i32 total = 0;
    if (older < newer) { total = total + 1; }
    if (newer >= older) { total = total + 2; }
    if (older != newer) { total = total + 4; }
    return total;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(7));
    }

    [Test]
    void nullable_pointer() {
        str source = """
import std::types;
namespace app;

struct Box {
    i32 value;
}

i32 read(Box*? box) {
    return switch box { Value found -> found.value, Empty -> 0 - 1 };
}

i32 main() {
    Box local = { .value = 7 };
    Box* safe = &local;
    mut Box*? maybe = null;
    i32 empty = read(maybe);
    maybe = safe;
    return read(maybe) + read(null) + read(safe) + empty;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(12));
    }

    [Test]
    void text_to_c_string_appends_null_byte() {
        str source = """
import std::sys;
import std::types;
namespace app;

i32 main() {
    str text = "abc";
    unsafe {
        i8* copy = text.toCString();
        if (copy[0] != 97 || copy[2] != 99 || copy[3] != 0) { return 1; }
    }
    if (text != "abc") { return 2; }
    if (text == "abd") { return 3; }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

    [Test]
    void str_and_string_indexers_read_bytes() {
        str source = """
import std::types;
namespace app;

i32 main() {
    str text = "abc";
    string owned = "xyz";
    if (text[0] != 97 || text[2] != 99) { return 1; }
    if (owned[1] != 121) { return 2; }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }
}
