namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct StdSuite {
    public static unsafe void register(Verify* verify) {
        verify.test("std/async_delay").with_std().runs(Sources.file("tests/djinnc/std/async_delay.djinn"), Expected.exit(0));
        verify.test("std/collections").with_std().runs(Sources.file("tests/djinnc/std/collections.djinn"), Expected.exit(38));
        verify.test("std/console").with_std().runs(Sources.file("tests/djinnc/std/console.djinn"), Expected.exit(7).stdout("hello djinn view 7\n"));
        verify.test("std/hash_version").with_std().runs(Sources.file("tests/djinnc/std/hash_version.djinn"), Expected.exit(0));
        verify.test("std/hash_wide").with_std().runs(Sources.file("tests/djinnc/std/hash_wide.djinn"), Expected.exit(0));
        verify.test("std/io").with_std().runs(Sources.file("tests/djinnc/std/io.djinn"), Expected.exit(100));
        verify.test("std/json_parse").with_std().runs(Sources.file("tests/djinnc/std/json_parse.djinn"), Expected.exit(0));
        verify.test("std/logger").with_std().runs(Sources.file("tests/djinnc/std/logger.djinn"), Expected.exit(0));
        verify.test("std/math").with_std().runs(Sources.file("tests/djinnc/std/math.djinn"), Expected.exit(36));
        verify.test("std/optional_result").with_std().runs(Sources.file("tests/djinnc/std/optional_result.djinn"), Expected.exit(24));
        verify.test("std/process").with_std().runs(Sources.file("tests/djinnc/std/process.djinn"), Expected.exit(0));
        verify.test("std/process_spawn").with_std().runs(Sources.file("tests/djinnc/std/process_spawn.djinn"), Expected.exit(0));
        verify.test("std/semver").with_std().runs(Sources.file("tests/djinnc/std/semver.djinn"), Expected.exit(0));
        verify.test("std/spectre").with_std().runs(Sources.file("tests/djinnc/std/spectre.djinn"), Expected.exit(0).stdout("[1mbold[0m\n[31;1mwarn[0m\n"));
        verify.test("std/version").with_std().runs(Sources.file("tests/djinnc/std/version.djinn"), Expected.exit(7));
        verify.test("std/nullable_pointer").with_std().runs(Sources.file("tests/djinnc/std/nullable_pointer.djinn"), Expected.exit(12));
    }
}
