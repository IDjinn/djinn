    [Test]
    void atomic_types() {
        str source = """
import std::sys;
import std::types;
namespace app;

i32 main() {
    atomic<i32> n = atomic<i32>(5);
    if (n.fetchAdd(3) != 5) { return 1; }
    if (n.load() != 8) { return 2; }
    if (!n.compareExchange(8, 1)) { return 3; }
    if (n.compareExchange(8, 2)) { return 4; }
    atomic<i64> big = atomic<i64>(1);
    big.store(7);
    if (big.exchange(9) != 7) { return 5; }
    atomic_bool flag = atomic_bool(false);
    flag.store(true);
    if (!flag.load()) { return 6; }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

    [Test]
    void math() {
        str source = """
import std::math;
import std::types;
namespace app;

i32 main() {
    f64 root = sqrt(144.0);
    f64 power = pow(2.0, 10.0);
    return (i32)root + (i32)power - 1000;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(36));
    }

    [Test]
    void optional_result() {
        str source = """
import std::types;
namespace app;

optional<i32> find(i32 x) {
    if (x > 0) { return optional::Value(x); }
    return optional::Empty();
}

result<i32, i32> check(i32 x) {
    if (x > 0) { return result::Ok(x * 2); }
    return result::Error(9);
}

i32 main() {
    i32 some = switch find(4) { Value v -> v, Empty -> 100 };
    i32 none = switch find(-1) { Value v -> v, Empty -> 1 };
    i32 good = switch check(5) { Ok v -> v, Error e -> 1000 };
    i32 bad = switch check(-5) { Ok v -> v, Error e -> e };
    return some + none + good + bad;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(24));
    }

    [Test]
    void process() {
        str source = """
import std::sys;
import std::types;
import std::libc;
namespace app;

i32 main() {
    if (Process.argc() < 1) { return 1; }
    i32 found = switch Process.env("PATH") { Value path -> (i32)strlen(path), Empty -> 0 };
    if (found == 0) { return 2; }
    i32 missing = switch Process.env("DJINN_NO_SUCH_VARIABLE") { Value path -> 1, Empty -> 0 };
    if (missing != 0) { return 3; }
    return 0;
}
""";
        Verify.source(source).with_std().runs_linked(Expected.exit(0));
    }

    [Test]
    void process_spawn() {
        str source = """
import std::sys;
import std::types;
import std::libc;
namespace app;

i32 expect_success(void* child) {
    if (!Process.wait(child, 20000)) { return 10; }
    if (Process.exit_code(child) != 0) { return 11; }
    if (Process.stdout_length(child) == 0) { return 12; }
    return 0;
}

i32 expect_failure(void* child) {
    if (!Process.wait(child, 20000)) { return 20; }
    if (Process.exit_code(child) == 0) { return 21; }
    if (Process.stderr_length(child) == 0) { return 22; }
    return 0;
}

i32 main() {
    i32 first = switch Process.start("clang --version", "", 0) {
        Value child -> expect_success(child),
        Empty -> 30
    };
    if (first != 0) { return first; }
    i32 second = switch Process.start("clang --no-such-flag-xyz", "", 0) {
        Value child -> expect_failure(child),
        Empty -> 31
    };
    return second;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

    [Test]
    void semver() {
        str source = """
import std::util;
import std::types;
namespace app;

bool valid(str text) {
    return switch Version.parse(text) { Value v -> true, Empty -> false };
}

Version version(str text) {
    return switch Version.parse(text) { Value v -> v, Empty -> Version.NONE };
}

i32 main() {
    str[] accepted = [
        "0.0.4", "1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-0.3.7", "1.0.0-x.7.z.92",
        "1.0.0-x-y-z.--", "1.0.0-alpha+001", "1.0.0+20130313144700",
        "1.0.0-beta+exp.sha.5114f85", "1.0.0+21AF26D3----117B344092BD"
    ];
    for (mut i32 i = 0; i < 10; i = i + 1) {
        if (!valid(accepted[i])) { return 1 + i; }
    }

    str[] rejected = [
        "", "1", "1.2", "01.2.3", "1.02.3", "1.2.03", "1.2.3-", "1.2.3-01",
        "1.2.3-a..b", "1.2.3+", "1.2.3-a+", "1.2.3 ", "v1.2.3", "1.2.3.4"
    ];
    for (mut i32 i = 0; i < 14; i = i + 1) {
        if (valid(rejected[i])) { return 20 + i; }
    }

    str[] ordered = [
        "1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-alpha.beta", "1.0.0-beta", "1.0.0-beta.2",
        "1.0.0-beta.11", "1.0.0-rc.1", "1.0.0", "2.0.0", "2.1.0", "2.1.1", "10.0.0"
    ];
    for (mut i32 i = 0; i + 1 < 12; i = i + 1) {
        Version low = version(ordered[i]);
        Version high = version(ordered[i + 1]);
        if (!(low < high) || !(high > low) || low == high || !(low != high)) { return 40 + i; }
    }

    if (!(version("1.0.0+first") == version("1.0.0+second"))) { return 60; }
    if (Version.identical(version("1.0.0+first"), version("1.0.0+second"))) { return 61; }
    if (!version("1.0.0-rc.1").is_prerelease() || version("1.0.0").is_prerelease()) { return 62; }
    Version parsed = version("3.4.5-beta.2+build.9");
    if (parsed.major != 3 || parsed.minor != 4 || parsed.patch != 5) { return 63; }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

    [Test]
    void spectre() {
