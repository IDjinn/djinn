i32 main() {
    string_builder builder = string_builder();
    for (mut i32 i = 0; i < 2000; i = i + 1) { builder.append("abcdefghij"); }
    string big = builder.to_string();
    str formatted = Console.format("<{0}>{1}", big, 9);
    unsafe {
        if (formatted.length != 20003u || formatted.data[0] != 60 || formatted.data[20002] != 57) { return 1; }
        if (formatted.data[20003] != 0) { return 2; }
    }
    Console.writeSync("{0}\n", big);
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

    [Test]
    void text_hash_and_equality_are_plain_djinn() {
        str source = """
import std::types;
namespace app;

i32 main() {
    str empty = "";
    str view = "hello";
    str same = "hello";
    str near = "hellp";
    str prefix = "hell";
    if (empty.hash() == view.hash() || view.hash() != same.hash()) { return 1; }
    if (view.hash() == near.hash() || view.hash() == prefix.hash()) { return 2; }
    string owned = "hel" + "lo";
    if (!(view == "hello") || view == "help!" || view == "hell") { return 3; }
    if (!(owned == "hello")) { return 4; }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

