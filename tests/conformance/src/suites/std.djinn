namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct StdTests {
    [Test]
    void substring_copies_only_the_requested_range() {
        str source = """
import std::sys;
import std::types;
namespace app;

i32 main() {
    string text = "hello world";
    string part = text.substring(6, 5);
    string empty = text.substring(11, 0);
    string joined = part + "!";
    unsafe {
        printf("%s|%d|%s|%d|%s|%d\n", part.data, (i32)part.length, empty.data, (i32)empty.length, joined.data, (i32)joined.length);
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0).stdout("world|5||0|world!|6\n"));
    }

    [Test]
    void prefix_slices_sharing_a_pointer_are_different_keys() {
        str source = """
import std::collections;
import std::types;
namespace app;

i32 main() {
    string text = $"key_{123456789}";
    str short = text.slice(0, 1);
    str longer = text.slice(0, 3);
    if (short == longer) { return 1; }
    map<str, i32> table = map<str, i32>();
    for (mut u32 i = 0; i < 10; i = i + 1) {
        table.set(text.slice(0, i + 1), (i32)i);
    }
    mut i32 total = 0;
    for (mut u32 i = 0; i < 10; i = i + 1) {
        total = total + table.get(text.slice(0, i + 1));
    }
    return total - 3 + (i32)table.count;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(52));
    }

    [Test]
    void string_and_str_hash_the_same_text() {
        str source = """
import std::types;
namespace app;

i32 main() {
    string owned = $"hash {7}";
    string literal = "hash 7";
    str view = "hash 7";
    if (owned.hash() != view.hash() || literal.hash() != view.hash()) { return 1; }
    str other = "hash 8";
    if (other.hash() == view.hash()) { return 2; }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

    [Test]
    void long_text_hash_depends_on_every_byte_and_not_on_alignment() {
        str source = """
import std::types;
namespace app;

i32 main() {
    unsafe {
        i8* first = (i8*)malloc(4100);
        i8* second = (i8*)malloc(4100);
        for (mut i32 i = 0; i < 4100; i = i + 1) {
            first[i] = (i8)(32 + (i * 7) % 90);
        }
        for (mut i32 i = 0; i < 3000; i = i + 1) {
            second[i + 3] = first[i];
        }
        for (mut i32 length = 0; length <= 3000; length = length + 1) {
            str left = { .data = first, .length = (u32)length };
            str right = { .data = second + 3, .length = (u32)length };
            if (left.hash() != right.hash()) { return 1; }
        }
        for (mut i32 length = 65; length < 300; length = length + 1) {
            str base = { .data = first, .length = (u32)length };
            u64 expected = base.hash();
            for (mut i32 at = 0; at < length; at = at + 1) {
                i8 saved = first[at];
                first[at] = saved ^ 1;
                u64 changed = base.hash();
                first[at] = saved;
                if (changed == expected) { return 2; }
            }
        }
        for (mut i32 a = 0; a < 300; a = a + 1) {
            str prefix = { .data = first, .length = (u32)a };
            for (mut i32 b = a + 1; b < 300; b = b + 1) {
                str longer = { .data = first, .length = (u32)b };
                if (prefix.hash() == longer.hash()) { return 3; }
            }
        }
        free(first);
        free(second);
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

    [Test]
    void scoped_interner_interns_clears_and_disposes() {
        str source = """
import std::types;
import std::text;
namespace app;

i32 main() {
    interner pool = interner();
    symbol a = pool.intern("name");
    symbol b = pool.intern("na" + "me");
    symbol c = pool.intern("other");
    if (a != b || a.entry != b.entry) { return 1; }
    if (a == c) { return 2; }
    if (a.hash() != a.text().hash()) { return 3; }
    for (mut i32 i = 0; i < 5000; i = i + 1) {
        string key = $"key_{i % 1000}";
        pool.intern(key);
    }
    if (pool.length() != 1002u) { return 4; }
    if (!pool.contains("key_999") || pool.contains("key_1000")) { return 5; }
    pool.clear();
    if (pool.length() != 0u || pool.contains("name")) { return 6; }
    symbol fresh = pool.intern("name");
    return (i32)fresh.length() + 38;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void shared_interner_is_global_and_clearable() {
        str source = """
import std::types;
import std::text;
namespace app;

i32 main() {
    symbol first = interner.shared("global");
    symbol second = interner.shared("glo" + "bal");
    if (first.entry != second.entry) { return 1; }
    interner pool = interner();
    symbol local = pool.intern("global");
    if (local != first || local.entry == first.entry) { return 2; }
    interner.shared("another");
    if (interner.shared_length() != 2u) { return 3; }
    interner.clear_shared();
    if (interner.shared_length() != 0u) { return 4; }
    return 42;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void async_delay() {
        str source = """
import std::sys;
import std::types;
namespace app;

async i32 check_delay() {
    i64 start = __djinn_unix_timestamp_ms();
    await Task.delay(60);
    i64 elapsed = __djinn_unix_timestamp_ms() - start;
    if (elapsed < 55) { return 10; }
    return 0;
}

async i32 check_process() {
    void*? started = Process.start("clang --version", "", 0);
    return switch started {
        Value child -> await wait_child(child),
        Empty -> 20
    };
}

async i32 wait_child(void* child) {
    bool done = await Process.wait_async(child, 20000);
    if (!done) { return 21; }
    if (Process.exit_code(child) != 0) { return 22; }
    if (Process.stdout_length(child) == 0) { return 23; }
    return 0;
}

async i32 main() {
    i32 first = await check_delay();
    if (first != 0) { return first; }
    return await check_process();
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

    [Test]
