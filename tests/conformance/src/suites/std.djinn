import std::types;
namespace app;

i32 main() {
    str s = "  hello world  ";
    str t = s.trim();
    str up = "HeLLo";
    str blank = "   ";
    if (!t.startsWith("hello")) { return 1; }
    if (!t.endsWith("world")) { return 2; }
    if (!t.contains("lo wo")) { return 3; }
    if (t.contains("xyz")) { return 4; }
    if (t.indexOf("o") != 4) { return 5; }
    if (t.lastIndexOf("o") != 7) { return 6; }
    if (!up.equalsIgnoreCase("hello")) { return 7; }
    if (!blank.isBlank()) { return 8; }
    if (t.indexOf("zz") != -1) { return 9; }
    if (!t.containsChar(119)) { return 10; }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

