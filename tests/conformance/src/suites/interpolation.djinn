namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct StringInterpolationTests {
    [Test]
    void simple_identifier() {
        str source = """
import std::sys;
import std::types;
namespace app;

i32 main() {
    i32 name = 42;
    string line = $"hello {name}\n";
    Console.writeSync("{0}", line);
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0).stdout("hello 42\n"));
    }

    [Test]
    void folded_integer_extremes() {
        str source = """
import std::sys;
import std::types;
namespace app;

i32 main() {
    i64 low = 0x8000000000000000w;
    i64 high = 0x7FFFFFFFFFFFFFFF;
    string line = $"{low} {high}\n";
    Console.writeSync("{0}", line);
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0).stdout("-9223372036854775808 9223372036854775807\n"));
    }

    [Test]
    void runtime_integer_extremes() {
        str source = """
import std::sys;
import std::types;
namespace app;

string show(i64 low, u64 top, i64 zero, i32 small, u8 byte) {
    return $"{low} {top} {zero} {small} {byte} [{small:06}]\n";
}

i32 main() {
    i64 low = 0x8000000000000000w;
    i32 small = -42;
    Console.writeSync("{0}", show(low, 0xFFFFFFFFFFFFFFFF, 0, -7, 255));
    Console.writeSync("{0} {1}\n", low, small);
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0).stdout("-9223372036854775808 18446744073709551615 0 -7 255 [-00007]\n-9223372036854775808 -42\n"));
    }

    [Test]
    void whole_floats_print_as_integers() {
        str source = """
import std::sys;
import std::types;
namespace app;

string show(f64 whole, f64 negative, f64 widest, f64 scientific, f32 exact, f32 rounded, f64 fraction) {
    return $"{whole} {negative} {widest} {scientific} {exact} {rounded} {fraction}\n";
}

i32 main() {
    Console.writeSync("{0}", show(42.0, -1000.0, 999999999999999.0, 1e15, (f32)16777215.0, (f32)123456789.0, 2.5));
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0).stdout("42 -1000 999999999999999 1E+15 16777215 123456790 2.5\n"));
    }

    [Test]
    void multiple_arguments() {
        str source = """
import std::sys;
import std::types;
namespace app;

i32 main() {
    i32 a = 1;
    i32 b = 2;
    string line = $"a={a} b={b}\n";
    Console.writeSync("{0}", line);
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0).stdout("a=1 b=2\n"));
    }

    [Test]
    void field_access_inside_braces() {
        str source = """
import std::sys;
import std::types;
namespace app;

struct Point {
    i32 x;
    i32 y;
}

i32 main() {
    Point p = { 10, 20 };
    string line = $"p.x={p.x} p.y={p.y}\n";
    Console.writeSync("{0}", line);
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0).stdout("p.x=10 p.y=20\n"));
    }

    [Test]
    void arithmetic_expression_inside_braces() {
        str source = """
import std::sys;
import std::types;
namespace app;

i32 main() {
    i32 a = 3;
    i32 b = 4;
    string line = $"sum={a + b}\n";
    Console.writeSync("{0}", line);
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0).stdout("sum=7\n"));
    }

    [Test]
    void function_call_inside_braces() {
        str source = """
import std::sys;
import std::types;
namespace app;

i32 get_value() {
    return 42;
}

i32 main() {
    string line = $"value={get_value()}\n";
    Console.writeSync("{0}", line);
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0).stdout("value=42\n"));
    }

    [Test]
    void repeated_expression_is_evaluated_each_time() {
        str source = """
import std::sys;
import std::types;
namespace app;

unsafe static mut i32 calls = 0;

i32 next() {
    calls = calls + 1;
    return calls;
}

i32 main() {
    string line = $"{next()} and {next()}\n";
    Console.writeSync("{0}", line);
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0).stdout("1 and 2\n"));
    }
}
