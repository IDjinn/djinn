namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct StdLibraryTests {
    [Test]
    void array_slice_sorting_and_editing() {
        str source = """
import std::collections;

i32 main() {
    array<i32> a = array<i32>();
    for (mut i32 i = 0; i < 100; i = i + 1) { a.push((i * 37) % 101); }
    Sorting.sort(a.as_slice());
    for (mut i32 i = 1; i < 100; i = i + 1) { if (a[(size)i] < a[(size)(i - 1)]) { return 1; } }
    if (Sorting.binary_search(a.as_slice(), a[50u]) < 0) { return 2; }
    if (Sorting.binary_search(a.as_slice(), 1000) != -1) { return 3; }
    a.insert(0u, 5000);
    if (a[0u] != 5000 || a.length() != 101u) { return 4; }
    i32 removed = a.remove_at(0u);
    if (removed != 5000 || a.length() != 100u) { return 5; }
    i32 last = a.last();
    if (a.pop() != last || a.length() != 99u) { return 6; }
    a.reverse();
    if (a[0u] < a[1u]) { return 7; }
    slice<i32> v = a.as_slice().sub(10u, 5u);
    if (v.length() != 5u || v[0u] != a[10u]) { return 8; }
    if (!a.contains(a[3u]) || a.contains(-5)) { return 9; }
    return 42;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void set_stack_queue_priority_queue_and_map_views() {
        str source = """
import std::collections;

i32 main() {
    set<i32> s = set<i32>();
    for (mut i32 i = 0; i < 50; i = i + 1) { s.add(i % 10); }
    if (s.length() != 10u || !s.has(3) || s.has(11) || s.add(4) || !s.remove(4) || s.has(4)) { return 1; }
    array<i32> items = s.to_array();
    Sorting.sort(items.as_slice());
    if (items.length() != 9u || items[0u] != 0) { return 2; }

    map<i32, i32> m = map<i32, i32>();
    for (mut i32 i = 0; i < 20; i = i + 1) { m.set(i, i * i); }
    array<i32> ks = m.keys();
    array<i32> vs = m.values();
    Sorting.sort(ks.as_slice());
    Sorting.sort(vs.as_slice());
    if (ks.length() != 20u || ks[19u] != 19 || vs[19u] != 361) { return 3; }
    m.clear();
    if (m.length() != 0u || m.has(3)) { return 4; }
    m.set(3, 9);
    if (m.get(3) != 9) { return 5; }

    stack<i32> st = stack<i32>();
    st.push(1); st.push(2); st.push(3);
    if (st.peek() != 3 || st.pop() != 3 || st.pop() != 2 || st.length() != 1u) { return 6; }

    queue<i32> q = queue<i32>();
    for (mut i32 i = 0; i < 30; i = i + 1) { q.push_back(i); }
    for (mut i32 i = 0; i < 10; i = i + 1) { if (q.pop_front() != i) { return 7; } }
    q.push_front(-1);
    q.push_front(-2);
    if (q.front() != -2 || q.back() != 29 || q.get(1u) != -1 || q.length() != 22u) { return 8; }
    if (q.pop_back() != 29 || q.pop_front() != -2) { return 9; }

    priority_queue<i32> pq = priority_queue<i32>();
    for (mut i32 i = 0; i < 100; i = i + 1) { pq.push((i * 37) % 101); }
    mut i32 prev = -1;
    for (mut i32 i = 0; i < 100; i = i + 1) {
        i32 v = pq.pop();
        if (v < prev) { return 10; }
        prev = v;
    }
    if (!pq.is_empty()) { return 11; }
    map<i32,i32> h1 = map<i32,i32>();
    map<i32,i32> h2 = map<i32,i32>();
    for (mut i32 i = 0; i < 40; i = i + 1) { h1.set(i, i); }
    for (mut i32 i = 39; i >= 0; i = i - 1) { h2.set(i, i); }
    if (h1.hash() != h2.hash()) { return 12; }
    h2.set(5, 6);
    if (h1.hash() == h2.hash()) { return 13; }
    return 42;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void bag_ring_buffer_and_bitset() {
        str source = """
import std::collections;

i32 main() {
    bag<i32> b = bag<i32>();
    for (mut i32 i = 0; i < 10; i = i + 1) { b.add(i); }
    if (!b.remove(3) || b.remove(3) || b.length() != 9u || b.contains(3)) { return 1; }
    i32 t = b.take();
    if (t == 3 || b.length() != 8u) { return 2; }

    ring_buffer<i32> r = ring_buffer<i32>(4u);
    for (mut i32 i = 0; i < 6; i = i + 1) { r.push(i); }
    if (!r.is_full() || r.oldest() != 2 || r.newest() != 5 || r.get(1u) != 3) { return 3; }
    if (r.pop() != 2 || r.length() != 3u) { return 4; }
    if (r.push(10) || !r.push(11) || r.oldest() != 4) { return 5; }

    bitset s = bitset(130u);
    s.set(0u); s.set(64u); s.set(129u); s.flip(5u);
    if (!s.test(129u) || s.test(1u) || s.count() != 4u) { return 6; }
    s.clear(64u);
    if (s.test(64u) || s.count() != 3u) { return 7; }
    return 42;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void linked_list_operations() {
        str source = """
import std::collections;

i32 main() {
    linked_list<i32> l = linked_list<i32>();
    for (mut i32 i = 0; i < 5; i = i + 1) { l.push_back(i); }
    l.push_front(-1);
    if (l.length() != 6u || l.front() != -1 || l.back() != 4 || l.get(3u) != 2) { return 1; }
    if (!l.remove(2) || l.remove(2) || l.contains(2) || !l.contains(3)) { return 2; }
    if (l.pop_front() != -1 || l.pop_back() != 4 || l.length() != 3u) { return 3; }
    array<i32> a = l.to_array();
    if (a.length() != 3u || a.get(0u) != 0 || a.get(2u) != 3) { return 4; }
    l.clear();
    if (!l.is_empty()) { return 5; }
    return 42;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void arena_and_pool_allocators_back_array_and_map() {
        str source = """
import std::collections;
import std::memory;

i32 main() {
    arena region = arena(256u);
    unsafe {
        array<i32> a = array<i32>(allocator.from_arena(&region));
        for (mut i32 i = 0; i < 1000; i = i + 1) { a.push(i); }
        if (a.get(999u) != 999) { return 1; }
        map<i32, i32> m = map<i32, i32>(allocator.from_arena(&region));
        for (mut i32 i = 0; i < 500; i = i + 1) { m.set(i, i * 2); }
        for (mut i32 i = 0; i < 500; i = i + 1) { if (m.get(i) != i * 2) { return 2; } }
        if (region.allocated() == 0u) { return 3; }
    }
    pool nodes = pool(64u, 4u);
    unsafe {
        i8* x = nodes.acquire();
        i8* y = nodes.acquire();
        if (x == y || nodes.in_use() != 2u) { return 4; }
        nodes.release(x);
        i8* z = nodes.acquire();
        if (z != x || nodes.in_use() != 2u) { return 5; }
        for (mut i32 i = 0; i < 20; i = i + 1) { nodes.acquire(); }
        array<i32> small = array<i32>(allocator.from_pool(&nodes));
        small.push(7);
        if (small.get(0u) != 7) { return 6; }
    }
    array<i32> plain = array<i32>();
    plain.push(1);
    map<i32, i32> plain_map = map<i32, i32>();
    plain_map.set(1, 1);
    return 42;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void text_builder_split_replace_parse_and_utf8() {
        str source = """
import std::types;
import std::collections;
import std::text;

i32 main() {
    string_builder b = string_builder();
    b.append("id=");
    b.append_i64(-120);
    b.append_char('é');
    b.append_bool(true);
    string s = b.to_string();
    str expected = "id=-120étrue";
    if (s.length != expected.length) { return 1; }

    str csv = "a,b,,cd";
    array<str> parts = csv.split(",");
    if (parts.length() != 4u || parts[3u].length != 2u || parts[2u].length != 0u) { return 2; }
    string joined = Text.join(&parts, "-");
    str want = "a-b--cd";
    if (!(joined.length == want.length)) { return 3; }
    string swapped = csv.replace(",", "::");
    if (swapped.length != 10u) { return 4; }
    if (csv.count(",") != 3) { return 5; }

    str num = "-77";
    optional<i64> n = num.parseI64();
    i64 nv = switch n { Value x -> x, Empty -> 0 };
    if (nv != -77) { return 6; }
    str bad = "12x";
    optional<i64> bn = bad.parseI64();
    i32 isbad = switch bn { Value x -> 0, Empty -> 1 };
    if (isbad != 1) { return 7; }

    str word = "héllo";
    if (word.utf8Length() != 5u || !word.isValidUtf8()) { return 8; }
    if ((i32)word.utf8At(1u) != 233) { return 9; }

    str abc = "abc";
    string upper = abc.toUpper();
    if (upper[0u] != 65) { return 10; }
    string made = Text.from_hex(255u);
    if (made.length != 2u) { return 11; }
    str view = s.asStr();
    if (view.length != s.length) { return 12; }
    if (!Chars.is_alpha('z') || Chars.is_digit('x') || (i32)Chars.to_upper('q') != 81) { return 13; }
    return 42;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void number_formatting_and_parsing() {
        str source = """
import std::types;
import std::text;

i32 main() {
    str a = "-42";
    str b = "99999999999999999999";
    str c = "3.5";
    unsafe {
        i8* buf = __djinn_alloc(32u);
        size n = Numbers.format_i64(buf, -9223372036854775807 - 1);
        if (n != 20u) { return 1; }
        size m = Numbers.format_u64(buf, 1234500u);
        if (m != 7u || buf[0] != 49 || buf[6] != 48) { return 2; }
        size h = Numbers.format_radix(buf, 255u, 16u, false);
        if (h != 2u || buf[0] != 102) { return 3; }
        optional<i64> p = Numbers.parse_i64(a.data, a.length);
        i64 v = switch p { Value x -> x, Empty -> 0 };
        if (v != -42) { return 4; }
        optional<i64> bad = Numbers.parse_i64(b.data, b.length);
        i32 isbad = switch bad { Value x -> 0, Empty -> 1 };
        if (isbad != 1) { return 5; }
        optional<f64> f = Numbers.parse_f64(c.data, c.length);
        f64 fv = switch f { Value x -> x, Empty -> 0.0 };
        if (fv != 3.5) { return 6; }
    }
    return 42;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void byte_buffer_hex_and_base64() {
        str source = """
import std::types;
import std::text;
import std::encoding;

i32 main() {
    byte_buffer b = byte_buffer();
    unsafe {
        b.write_le(258u, 2u);
        b.write_be(258u, 2u);
        b.write_str("hi");
        if (b.length() != 6u || b.get(0u) != 2 || b.get(1u) != 1 || b.get(2u) != 1 || b.get(3u) != 2) { return 1; }
        if (b.read_le(2u) != 258u || b.read_be(2u) != 258u || b.remaining() != 2u) { return 2; }
    }
    str raw = "Many hands";
    string enc = Base64.encode(raw, false);
    str want = "TWFueSBoYW5kcw==";
    if (enc.length != want.length) { return 3; }
    for (mut size i = 0u; i < want.length; i = i + 1u) { unsafe { if (enc.data[i] != want.data[i]) { return 4; } } }
    byte_buffer back = byte_buffer();
    str encv = enc.asStr();
    if (!Base64.decode(encv, &back) || back.length() != raw.length) { return 5; }
    unsafe { if (back.get(0u) != 77 || back.get(9u) != 115) { return 6; } }
    string hex = Hex.encode(raw, false);
    str hv = hex.asStr();
    byte_buffer hb = byte_buffer();
    if (hex.length != 20u || !Hex.decode(hv, &hb) || hb.length() != 10u) { return 7; }
    return 42;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void fnv_xxhash_and_sha256_vectors() {
        str source = """
import std::types;
import std::text;
import std::encoding;
import std::hashing;

i32 main() {
    str a = "a";
    str abc = "abc";
    str empty = "";
    str longtext = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
    if (Hash.fnv1a_32(a) != 0xE40C292C) { return 1; }
    unsafe {
        if (Hash.fnv1a_64(a) != 0xAF63DC4C8601EC8C) { return 2; }
        if (Hash.xxh64(empty, 0) != 0xEF46DB3751D8E999) { return 3; }
        if (Hash.xxh64(abc, 0) != 0x44BC2CF5AD770999) { return 4; }
        string digest = Hash.sha256_hex(abc);
        str want = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
        if (digest.length != 64u) { return 5; }
        for (mut size i = 0u; i < 64u; i = i + 1u) { if (digest.data[i] != want.data[i]) { return 6; } }
        string long_digest = Hash.sha256_hex(longtext);
        str want2 = "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1";
        for (mut size i = 0u; i < 64u; i = i + 1u) { if (long_digest.data[i] != want2.data[i]) { return 7; } }
    }
    return 42;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void csv_and_toml_readers() {
        str source = """
import std::types;
import std::text;
import std::format;

i32 main() {
    str data = "name,quote\n\"a,b\",\"say \"\"hi\"\"\"\nx,y\n";
    csv_reader reader = csv_reader(data, 44);
    string_builder field = string_builder();
    mut i32 records = 0;
    mut i32 fields = 0;
    mut size total = 0u;
    while (reader.next_record()) {
        records = records + 1;
        while (reader.next_field(&field)) {
            fields = fields + 1;
            total = total + field.length();
        }
    }
    if (records != 3 || fields != 6) { return 1; }
    if (total != 22u) { return 2; }

    csv_writer writer = csv_writer(44);
    unsafe {
        writer.field("plain");
        writer.field("with,comma");
        writer.field("quo\"te");
        writer.end_record();
        string out = writer.to_string();
        str want = "plain,\"with,comma\",\"quo\"\"te\"\n";
        if (out.length != want.length) { return 3; }
    }

    str doc = "# config\ntitle = \"My App\"\n[server]\nport = 8080 # comment\nratio = 1.5\ndebug = true\n";
    toml_reader toml = toml_reader(doc);
    toml_entry entry = { .table = doc, .key = doc, .raw = doc, .kind = 0 };
    mut i32 seen = 0;
    mut i64 port = 0;
    while (toml.next(&entry)) {
        seen = seen + 1;
        if (entry.kind == 2) {
            optional<i64> parsed = Toml.integer(entry.raw);
            port = switch parsed { Value v -> v, Empty -> -1 };
        }
    }
    if (seen != 4 || port != 8080) { return 4; }
    return 42;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void chars_evaluate_at_compile_time() {
        str source = """
import std::text;

constexpr i32 UP = (i32)Chars.to_upper('q');
constexpr bool ALPHA = Chars.is_alpha('z');
constexpr i32 DIGIT = Chars.digit_value('f');

i32 main() {
    if (UP != 81 || !ALPHA || DIGIT != 15) { return 1; }
    return 42;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

}
