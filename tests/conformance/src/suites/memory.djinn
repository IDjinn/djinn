    [Test]
    void MoveOutOfFieldIsError() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }
}

struct Box {
    mut Handle h;
}

struct Holder : Disposable {
    mut Handle inner;

    Holder(i32 first) {
        this.inner = { .id = first };
        this.inner = { .id = first + 1 };
    }

    public void disposable() {
    }
}

i32 main() {
    Box b = { .h = { .id = 1 } };
    Handle x = b.h;
    return 0;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.MOVE_OUT_OF_PLACE));
    }

