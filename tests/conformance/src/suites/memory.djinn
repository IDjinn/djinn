namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct MutableTests {
    [Test]
    void BasicMutableVariables() {
        str source = """
namespace math {
    i32 add(i32 a, i32 b) {
        return a + b;
    }
}

import math;
namespace test;

i32 main() {
    auto mut result = 10;
    result = math::add(1, 1);
    return result;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(2));
    }

    [Test]
    void InvalidImmutableAssingment() {
        str source = """
namespace math {
    i32 add(i32 a, i32 b) {
        return a + b;
    }
}

import math;
namespace test;

i32 main() {
    auto result = 10;
    result = math::add(1, 1);
    return result;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.ASSIGN_TO_IMMUTABLE));
    }
}

struct OwnershipTests {
    [Test]
    void CopyTypesDoNotMove() {
        str source = """
i32 main() {
    i32 x = 42;
    i32 y = x;  // Copy, not move
    return x + y;  // Both can be used
}
""";
        Verify.source(source).with_std().runs(Expected.exit(84));
    }

    [Test]
    void FloatCopyTypes() {
        str source = """
i32 main() {
    f64 x = 3.14;
    f64 y = x;
    i32 res = 1;
    return res;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(1));
    }

    [Test]
    void PointerCopyTypes() {
        str source = """
i32 main() {
    i32 value = 10;
    i32* p1 = &value;
    i32* p2 = p1;  // Copy pointer, not move
    return *p1 + *p2;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(20));
    }

    [Test]
    void TrivialStructCopies() {
        str source = """
struct Data {
    i32 value;
}

i32 main() {
    Data d1 = { .value = 100 };
    Data d2 = d1;
    return d1.value + d2.value;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(200));
    }

    [Test]
    void StrCopies() {
        str source = """
i32 main() {
    str a = "abc";
    str b = a;
    return (i32)(a.length + b.length);
}
""";
        Verify.source(source).with_std().runs(Expected.exit(6));
    }

    [Test]
    void StructOfTrivialFieldsCopies() {
        str source = """
struct Inner {
    i32 value;
}

struct Outer {
    Inner inner;
    str name;
}

i32 main() {
    Outer o1 = { .inner = { .value = 4 }, .name = "ab" };
    Outer o2 = o1;
    return o1.inner.value + o2.inner.value + (i32)o1.name.length;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(10));
    }

    [Test]
    void DisposableStructMoves() {
        str source = """
import std::types::constraints;

struct Handle : Disposable {
    i32 value;

    public void disposable() {
    }
}

i32 main() {
    Handle h1 = { .value = 100 };
    Handle h2 = h1;
    return h2.value;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(100));
    }

    [Test]
    void UseAfterMove() {
        str source = """
import std::types::constraints;

struct Handle : Disposable {
    i32 value;

    public void disposable() {
    }
}

i32 main() {
    Handle h1 = { .value = 42 };
    Handle h2 = h1;
    return h1.value;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.USE_AFTER_MOVE));
    }

    [Test]
    void DoubleMoveError() {
        str source = """
import std::types::constraints;

struct Handle : Disposable {
    i32 value;

    public void disposable() {
    }
}

i32 main() {
    Handle h1 = { .value = 10 };
    Handle h2 = h1;
    Handle h3 = h1;
    return 0;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.USE_AFTER_MOVE));
    }

    [Test]
    void StructWithDisposableFieldMoves() {
        str source = """
import std::types::constraints;

struct Handle : Disposable {
    i32 value;

    public void disposable() {
    }
}

struct Holder {
    Handle handle;
}

i32 main() {
    Holder a = { .handle = { .value = 1 } };
    Holder b = a;
    return a.handle.value;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.USE_AFTER_MOVE));
    }

    [Test]
    void ReinitializeAfterMove() {
        str source = """
import std::types::constraints;

struct Handle : Disposable {
    i32 value;

    public void disposable() {
    }
}

i32 main() {
    Handle mut h1 = { .value = 10 };
    Handle h2 = h1;
    h1 = { .value = 20 };
    return h1.value + h2.value;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(30));
    }

    [Test]
    void ScopeOwnership() {
        str source = """
i32 main() {
    i32 mut res = 0;
    {
        i32 x = 10;
        res = x;
    }
    return res;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(10));
    }

    [Test]
    void NestedScopeOwnership() {
        str source = """
i32 main() {
    i32 mut res = 0;
    {
        i32 a = 1;
        {
            i32 b = 2;
            res = a + b;
        }
    }
    return res;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(3));
    }

    [Test]
    void FunctionParameterCopyType() {
        str source = """
i32 increment(i32 x) {
    return x + 1;
}

i32 main() {
    i32 val = 10;
    i32 res = increment(val);
    return val + res;  // val is still valid (copy type)
}
""";
        Verify.source(source).with_std().runs(Expected.exit(21));
    }

    [Test]
    void IfStatementOwnership() {
        str source = """
i32 main() {
    i32 x = 10;
    i32 mut res = 0;
    if (x > 5) {
        res = x;
    }
    return res;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(10));
    }

    [Test]
    void WhileLoopOwnership() {
        str source = """
i32 main() {
    i32 mut counter = 0;
    i32 mut sum = 0;
    while (counter < 5) {
        sum = sum + counter;
        counter = counter + 1;
    }
    return sum;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(10));
    }

    [Test]
    void ForLoopOwnership() {
        str source = """
i32 main() {
    i32 mut sum = 0;
    for (i32 mut i = 0; i < 5; i = i + 1) {
        sum = sum + i;
    }
    return sum;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(10));
    }
}

struct AllocationTests {
    [Test]
    void MixedObjectArrayFormatsEveryItem() {
        str source = """
struct Box { i32 value; }

i32 main() {
    Box item = { .value = 123 };
    auto items = [item, 69, "hello world"];
    string text = $"test = {items}";
    return (i32)text.length();
}
""";
        Verify.source(source).with_std().runs(Expected.exit(33));
    }

    [Test]
    void ConstantArrayInterpolationIsFolded() {
        str source = """
struct Box { i32 value; }

i32 main() {
    Box item = { .value = 123 };
    auto items = [item, 69, "hello world"];
    str text = $"test = {items}";
    if (text.length != 33) { return 1; }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

    [Test]
    void ConstexprFormatterIsFolded() {
        str source = """
struct Point : IFormatable<string> {
    i32 x;
    i32 y;

    constexpr string format() {
        return $"P({this.x}, {this.y})";
    }
}

i32 main() {
    Point p = { .x = 7, .y = 2 };
    auto items = [p, 3];
    str text = $"{items}";
    if (text.length != 16) { return 1; }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

    [Test]
    void RuntimeFormatterStillWorks() {
        str source = """
struct Point : IFormatable<string> {
    i32 x;

    string format() {
        return $"P({this.x})";
    }
}

i32 main() {
    mut i32 seed = 4;
    seed = seed + 3;
    Point p = { .x = seed };
    auto items = [p, 3];
    string text = $"{items}";
    return (i32)text.length();
}
""";
        Verify.source(source).with_std().runs(Expected.exit(13));
    }

    [Test]
    void RuntimeArrayInterpolationStillWorks() {
        str source = """
i32 main() {
    mut i32 seed = 5;
    seed = seed + 2;
    i32[] numbers = [1, seed, 3];
    string text = $"{numbers}";
    return (i32)text.length();
}
""";
        Verify.source(source).with_std().runs(Expected.exit(11));
    }

    [Test]
    void LocalArrayLiteralIsReadable() {
        str source = """
i32 main() {
    i32[] nums = [4, 5, 6];
    mut i32 total = 0;
    for (mut i32 i = 0; i < 3; i = i + 1) {
        i32[] inner = [i, i + 1];
        total = total + inner[1];
    }
    return (i32)nums.length + nums[1] + total;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(14));
    }

    [Test]
    void ReturnedArrayLiteralStaysValid() {
        str source = """
i32[] make() {
    i32[] nums = [7, 8, 9];
    return nums;
}

i32 clobber(i32 depth) {
    i32[] filler = [1, 1, 1, 1, 1, 1, 1, 1];
    if (depth == 0) { return filler[3]; }
    return clobber(depth - 1) + filler[2];
}

i32 main() {
    i32[] kept = make();
    i32 noise = clobber(8);
    return kept[0] + kept[2] + noise - 9;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(16));
    }

    [Test]
    void ArrayAssignedAwayStaysValid() {
        str source = """
struct Holder { i32[] items; }

Holder store() {
    i32[] nums = [3, 4];
    Holder holder = { .items = nums };
    return holder;
}

i32 clobber() {
    i32[] filler = [9, 9, 9, 9];
    return filler[0];
}

i32 main() {
    Holder held = store();
    i32 noise = clobber();
    return held.items[0] + held.items[1] + noise - 9;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(7));
    }
}

struct ViewTests {
    [Test]
    void ViewBorrowsWithoutMoving() {
        str source = """
i32 main() {
    string text = "hello";
    str view = text;
    str part = text.slice(1, 3);
    return (i32)(view.length + part.length) + (i32)text.length();
}
""";
        Verify.source(source).with_std().runs(Expected.exit(13));
    }

    [Test]
    void ViewEndsWithItsScope() {
        str source = """
i32 main() {
    string text = "hello";
    {
        str view = text;
    }
    string moved = text;
    return (i32)moved.length();
}
""";
        Verify.source(source).with_std().runs(Expected.exit(5));
    }
}

struct DisposeTests {
    [Test]
    void DisposeRunsAtScopeEnd() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }
}

i32 main() {
    {
        Handle h = { .id = 7 };
    }
    return log;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(7));
    }

    [Test]
    void DisposeRunsInReverseOrder() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }
}

i32 main() {
    {
        Handle a = { .id = 1 };
        Handle b = { .id = 2 };
        Handle c = { .id = 3 };
    }
    return log;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(57));
    }

    [Test]
    void MovedValueIsDisposedOnce() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }
}

i32 main() {
    {
        Handle a = { .id = 4 };
        Handle b = a;
    }
    return log;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(4));
    }

    [Test]
    void DisposeOnEarlyReturn() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }
}

i32 run(bool early) {
    Handle h = { .id = 5 };
    if (early) {
        return 1;
    }
    return 2;
}

i32 main() {
    run(true);
    run(false);
    return log;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(25));
    }

    [Test]
    void DisposeOnBreakAndContinue() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }
}

i32 main() {
    for (i32 mut i = 0; i < 4; i = i + 1) {
        Handle h = { .id = 1 };
        if (i == 1) {
            continue;
        }
        if (i == 2) {
            break;
        }
    }
    return log;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(21));
    }

    [Test]
    void DisposeFieldsOfContainingStruct() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }
}

struct Holder {
    Handle first;
    Handle second;
}

i32 main() {
    {
        Holder h = { .first = { .id = 1 }, .second = { .id = 2 } };
    }
    return log;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(9));
    }

    [Test]
    void ReturnedValueIsNotDisposedByCallee() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }
}

Handle make() {
    Handle h = { .id = 6 };
    return h;
}

i32 main() {
    {
        Handle h = make();
        log = log * 10;
    }
    return log;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(6));
    }

    [Test]
    void ReassignmentDisposesPreviousValue() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }
}

i32 main() {
    {
        Handle mut h = { .id = 1 };
        h = { .id = 2 };
    }
    return log;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(6));
    }

    [Test]
    void MovedIntoStructFieldIsDisposedOnce() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }
}

struct Holder {
    Handle inner;
}

i32 main() {
    {
        Handle a = { .id = 3 };
        Holder h = { .inner = a };
    }
    return log;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(3));
    }

    [Test]
    void CloneProducesAnIndependentValue() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable, Cloneable<Handle> {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }

    public Handle clone() {
        return { .id = this.id + 1 };
    }
}

i32 main() {
    {
        Handle original = { .id = 1 };
        Handle copy = original.clone();
        Handle moved = original;
    }
    return log;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(6));
    }

    [Test]
    void ArgumentIsMovedAndDisposedByCallee() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }
}

void consume(Handle h) {
}

i32 main() {
    {
        Handle a = { .id = 3 };
        consume(a);
    }
    return log;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(3));
    }

    [Test]
    void UseAfterPassingToFunction() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }
}

void consume(Handle h) {
}

i32 main() {
    Handle a = { .id = 3 };
    consume(a);
    return a.id;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.USE_AFTER_MOVE));
    }

    [Test]
    void TemporaryArgumentIsDisposedByCallee() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }
}

Handle make() {
    Handle h = { .id = 2 };
    return h;
}

void consume(Handle h) {
}

i32 main() {
    consume(make());
    return log;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(2));
    }

    [Test]
    void ParameterReturnedIsNotDisposed() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }
}

Handle pass(Handle h) {
    return h;
}

i32 main() {
    {
        Handle a = { .id = 2 };
        Handle b = pass(a);
    }
    return log;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(2));
    }

    [Test]
    void ParameterStoredInFieldDisposesThePreviousValue() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }
}

struct Slot {
    Handle inner;

    public void put(Handle h) {
        this.inner = h;
    }
}

i32 main() {
    {
        Slot s = { .inner = { .id = 1 } };
        Handle h = { .id = 2 };
        s.put(h);
    }
    return log;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(6));
    }

    [Test]
    void StringMoves() {
        str source = """
i32 main() {
    string a = "abc";
    string b = a;
    return (i32)b.length;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(3));
    }

    [Test]
    void UseAfterStringMove() {
        str source = """
i32 main() {
    string a = "abc";
    string b = a;
    return (i32)a.length;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.USE_AFTER_MOVE));
    }

    [Test]
    void StringParameterIsOwnedByCallee() {
        str source = """
