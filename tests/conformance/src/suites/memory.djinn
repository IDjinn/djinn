    [Test]
    void ConstructorReturningEarlyBeforeAssigningAFieldIsError() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }
}

struct Wrap : Disposable {
    Handle h;

    Wrap(i32 v, bool early) {
        if (early) {
            return;
        }
        this.h = { .id = v };
    }

    public void disposable() {
    }
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.FIELD_NOT_INITIALIZED));
    }

