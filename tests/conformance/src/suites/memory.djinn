    [Test]
    void ReadingAFieldOfAFieldedStructIsNotAMove() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }
}

struct Box {
    mut Handle h;
}

struct Holder : Disposable {
    mut Handle inner;

    Holder(i32 first) {
        this.inner = { .id = first };
        this.inner = { .id = first + 1 };
    }

    public void disposable() {
    }
}

i32 main() {
    mut i32 total = 0;
    {
        Box b = { .h = { .id = 3 } };
        total = b.h.id;
    }
    return total * 10 + log;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(33));
    }

