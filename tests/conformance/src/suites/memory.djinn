    [Test]
    void StringConcatenationKeepsOperands() {
        str source = """
i32 main() {
    string a = "ab";
    string b = "cd";
    string c = a + b;
    return (i32)c.length + (i32)a.length + (i32)b.length;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(8));
    }

    [Test]
    void StringReassignmentFreesPreviousBuffer() {
        str source = """
i32 main() {
    string mut s = "a";
    s = "bb";
    s = "ccc";
    return (i32)s.length;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(3));
    }

    [Test]
    void StringInterpolationIsOwned() {
        str source = """
i32 main() {
    i32 count = 12;
    string s = $"{count} items";
    return (i32)s.length;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(8));
    }

    [Test]
    void StringsInALoopAreFreed() {
        str source = """
i32 main() {
    i32 mut total = 0;
    for (i32 mut i = 0; i < 20000; i = i + 1) {
        string s = $"{i} loop";
        string t = s;
        total = total + (i32)t.length;
    }
    return total % 251;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(138));
    }

    [Test]
    void StringViewStaysStatic() {
        str source = """
i32 main() {
    str a = "view";
    str b = a;
    return (i32)(a.length + b.length);
}
""";
        Verify.source(source).with_std().runs(Expected.exit(8));
    }

    [Test]
    void ExplicitDisposeCallIsError() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }
}

i32 main() {
    Handle h = { .id = 1 };
    h.disposable();
    return 0;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.EXPLICIT_DISPOSE));
    }

    [Test]
    void ExplicitFieldDisposeInsideDisposeIsError() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }
}

struct Holder : Disposable {
    Handle inner;

    public void disposable() {
        this.inner.disposable();
    }
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.EXPLICIT_DISPOSE));
    }

    [Test]
    void FieldIsDisposedByGlueOnce() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }
}

struct Holder : Disposable {
    Handle inner;

    public void disposable() {
    }
}

i32 main() {
    {
        Holder h = { .inner = { .id = 3 } };
    }
    return log;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(3));
    }

    [Test]
    void EarlyReturnDisposesOnce() {
        str source = """
import std::types::constraints;

unsafe static mut i32 log = 0;

struct Handle : Disposable {
    i32 id;

    public void disposable() {
        log = log * 4 + this.id;
    }
}

i32 work(bool early) {
    Handle h = { .id = 2 };
    if (early) {
        return 1;
    }
    return 0;
}

i32 main() {
    work(true);
    return log;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(2));
    }

