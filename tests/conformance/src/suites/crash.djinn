namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct CrashTests {
    [Test]
    void null_read() {
        str source = """
struct Box {
    i32 value;
}

i32 read(Box*? box) {
    return box.value;
}

i32 outer(Box*? box) {
    return read(box);
}

i32 main() {
    Box*? none = null;
    return outer(none);
}
""";
        Verify.source(source).crashes(Expected.contains("native stack trace").and_contains("read").and_contains("outer").and_contains("null_read.djinn:6").and_contains("null_read.djinn:10"));
    }

    [Test]
    void DivisionByZeroReportShowsOperands() {
        str source = """
i32 main() {
    i32 d = 0;
    i32 x = 10 / d;
    return x;
}
""";
        Verify.source(source).crashes(Expected.contains("runtime error: panic").and_contains("division by zero").and_contains("--> ").and_contains("DivisionByZeroReportShowsOperands.djinn:3"));
    }

    [Test]
    void StackTraceShowsIntermediateFrames() {
        str source = """
i32 inner(i32 v) {
    i32 zero = 0;
    return v / zero;
}

i32 outer(i32 v) {
    return inner(v);
}

i32 main() {
    i32 x = 1000;
    return outer(x);
}
""";
        Verify.source(source).crashes(Expected.contains("division by zero").and_contains("at inner (").and_contains("at outer (").and_contains("at main ("));
    }

    [Test]
    void assert_non_null_of_null_panics() {
        str source = """
struct Node {
    i32 value;
}

i32 main() {
    Node*? p = null;
    return p!.value;
}
""";
        Verify.source(source).with_std().crashes(Expected.contains("R10009: null pointer dereference"));
    }

    [Test]
    void panic_hook_intercepts_panic() {
        str source = """
import std::system;
import std::libc;
import std::types;
namespace app;

void on_panic(i8* message, i8* file, u32 line) {
    printf("intercepted: %s at line %d
", message, line);
}

i32 main() {
    System.hook(HookKind.PANIC, &on_panic);
    i32 divisor = 0;
    return 10 / divisor;
}
""";
        Verify.source(source).with_std().crashes(Expected.contains("intercepted: R10001: division by zero at line 14"));
    }

    [Test]
    void panic_hook_can_print_default_report() {
        str source = """
import std::system;
import std::types;
namespace app;

void on_panic(i8* message, i8* file, u32 line) {
    System.print_default_panic_report(message, file, line);
}

i32 main() {
    System.hook(HookKind.PANIC, &on_panic);
    System.unhook(HookKind.PANIC);
    hook(panic, on_panic);
    i32 divisor = 0;
    return 10 / divisor;
}
""";
        Verify.source(source).with_std().crashes(Expected.contains("runtime error: panic").and_contains("division by zero"));
    }

    [Test]
    void str_indexer_is_bound_checked() {
        str source = """
import std::types;
namespace app;

i32 main() {
    str text = "abc";
    size position = 3;
    return (i32)text[position];
}
""";
        Verify.source(source).with_std().crashes(Expected.contains("R10010: index out of range"));
    }

    [Test]
    void string_indexer_is_bound_checked() {
        str source = """
import std::types;
namespace app;

i32 main() {
    string owned = "xyz";
    size position = 5;
    return (i32)owned[position];
}
""";
        Verify.source(source).with_std().crashes(Expected.contains("R10010: index out of range"));
    }
}
