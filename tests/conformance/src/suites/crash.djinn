namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct CrashTests {
    [Test]
    void null_read() {
        str source = """
struct Box {
    i32 value;
}

i32 read(Box*? box) {
    return box.value;
}

i32 outer(Box*? box) {
    return read(box);
}

i32 main() {
    Box*? none = null;
    return outer(none);
}
""";
        Verify.source(source).crashes(Expected.contains("native stack trace").and_contains("read").and_contains("outer").and_contains("null_read.djinn:6").and_contains("null_read.djinn:10"));
    }

    [Test]
    void DivisionByZeroReportShowsOperands() {
        str source = """
i32 main() {
    i32 d = 0;
    i32 x = 10 / d;
    return x;
}
""";
        Verify.source(source).crashes(Expected.contains("runtime error: panic").and_contains("division by zero").and_contains("--> ").and_contains("DivisionByZeroReportShowsOperands.djinn:3"));
    }

    [Test]
    void StackTraceShowsIntermediateFrames() {
        str source = """
i32 inner(i32 v) {
    i32 zero = 0;
    return v / zero;
}

i32 outer(i32 v) {
    return inner(v);
}

i32 main() {
    i32 x = 1000;
    return outer(x);
}
""";
        Verify.source(source).crashes(Expected.contains("division by zero").and_contains("at inner (").and_contains("at outer (").and_contains("at main ("));
    }
}
