namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct BootstrapSubsetFilesTests {
    [Test]
    void StructTypesVisibleAcrossFiles() {
        str shapes = """
namespace shapes;

struct Box {
    i32 volume;
}
""";
        str program = """
import shapes;

unsafe i32 main() {
    Box* box = malloc(sizeof(Box));
    box.volume = 5;
    i32 result = box.volume;
    free(box);
    return result;
}
""";
        Verify.source(program).and_file(shapes).with_std().runs(Expected.exit(5));
    }

    [Test]
    void SameNamespaceInTwoFilesIsShared() {
        str types = """
namespace shapes;

struct Box {
    i32 volume;
}
""";
        str functions = """
namespace shapes;

i32 twice(Box b) {
    return b.volume * 2;
}
""";
        str program = """
import shapes;

i32 main() {
    Box b = { .volume = 6 };
    return twice(b);
}
""";
        Verify.source(program).and_file(types).and_file(functions).with_std().runs(Expected.exit(12));
    }

    [Test]
    void QualifiedTypeInDeclaration() {
        str shapes = """
namespace shapes;

struct Box {
    i32 volume;
}
""";
        str program = """
i32 main() {
    shapes::Box b = { .volume = 6 };
    return b.volume;
}
""";
        Verify.source(program).and_file(shapes).with_std().runs(Expected.exit(6));
    }

    [Test]
    void QualifiedTypePointerInDeclaration() {
        str shapes = """
namespace shapes;

struct Box {
    i32 volume;
}
""";
        str program = """
i32 main() {
    shapes::Box b = { .volume = 7 };
    shapes::Box* pointer = &b;
    return pointer.volume;
}
""";
        Verify.source(program).and_file(shapes).with_std().runs(Expected.exit(7));
    }

    [Test]
    void QualifiedCallStillParsesAsExpression() {
        str math = """
namespace math;

i32 add(i32 a, i32 b) {
    return a + b;
}
""";
        str program = """
i32 main() {
    i32 total = math::add(2, 3);
    math::add(1, 1);
    return total;
}
""";
        Verify.source(program).and_file(math).with_std().runs(Expected.exit(5));
    }

    [Test]
    void ErrorInAnotherFileIsReported() {
        str shapes = """
i32 broken() {
    return "text";
}
""";
        str program = """
i32 main() {
    return 0;
}
""";
        Verify.source(program).and_file(shapes).with_std().diagnostics(Expected.error(DiagnosticErrors.VALUE_TYPE_MISMATCH));
    }
}
