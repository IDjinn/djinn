namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct BootstrapSubsetFilesTests {
    [Test]
    void StructTypesVisibleAcrossFiles() {
        str shapes = """
namespace shapes;

struct Box {
    i32 volume;
}
""";
        str program = """
import shapes;

i32 main() {
    Box* box = malloc(sizeof(Box));
    box.volume = 5;
    i32 result = box.volume;
    free(box);
    return result;
}
""";
        Verify.source(program).and_file(shapes).with_std().runs(Expected.exit(5));
    }

    [Test]
    void SameNamespaceInTwoFilesIsShared() {
        str types = """
namespace shapes;

struct Box {
    i32 volume;
}
""";
        str functions = """
namespace shapes;

i32 twice(Box b) {
    return b.volume * 2;
}
""";
        str program = """
import shapes;

i32 main() {
    Box b = { .volume = 6 };
    return twice(b);
}
""";
        Verify.source(program).and_file(types).and_file(functions).with_std().runs(Expected.exit(12));
    }

    [Test]
    void ErrorInAnotherFileIsReported() {
        str shapes = """
i32 broken() {
    return "text";
}
""";
        str program = """
i32 main() {
    return 0;
}
""";
        Verify.source(program).and_file(shapes).with_std().diagnostics(Expected.error(DiagnosticErrors.VALUE_TYPE_MISMATCH));
    }
}
