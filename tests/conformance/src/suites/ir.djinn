namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct OverflowIrTests {
    [Test]
    void WrappedIsPlainAdd() {
        str source = """
i32 work() {
    i32w a = 1000w;
    i32w b = 23w;
    i32w c = a + b;
    return c;
}

i32 main() {
    return work();
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("add i32").and_ir_lacks("with.overflow").in_function("work"));
    }
}

struct SpawnIrTests {
    [Test]
    void BasicSpawnParse() {
        str source = """
async i32 compute(i32 x) {
    return x * 2;
}

async i32 main() {
    spawn compute(10);
    return 0;
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("__djinn_spawn").and_ir_contains("__djinn_event_loop"));
    }
}

struct EventLoopIrTests {
    [Test]
    void AsyncMainGeneratesRuntimeCalls() {
        str source = """
async i32 get_value() {
    return 42;
}

async i32 main() {
    i32 val = await get_value();
    return val;
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("__djinn_runtime_init").and_ir_contains("__djinn_runtime_shutdown"));
    }

    [Test]
    void CoroWrappersGenerated() {
        str source = """
async i32 compute() {
    return 1;
}

async i32 main() {
    i32 r = await compute();
    return r;
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("__djinn_coro_resume").and_ir_contains("__djinn_coro_done").and_ir_contains("__djinn_coro_destroy").and_ir_contains("__djinn_coro_promise"));
    }
}

struct AsyncIrTests {
    [Test]
    void NonAsyncMainWithRuntime() {
        str source = """
import std::sys;

async i32 compute() {
    await Task.pause();
    return 1;
}

i32 main() {
    i32 result = await compute();
    return result;
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("__djinn_runtime_init").and_ir_contains("__djinn_event_loop_run").and_ir_contains("__djinn_sync_main"));
    }
}

struct AttributesIrTests {
    [Test]
    void ForceInlineGeneratesAlwaysInline() {
        str source = """
struct Math {
    [ForceInline]
    public static i32 add(i32 a, i32 b) {
        return a + b;
    }
}

i32 main() {
    return Math.add(1, 2);
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("alwaysinline"));
    }

    [Test]
    void NoInlineGeneratesNoInline() {
        str source = """
struct Math {
    [NoInline]
    public static i32 add(i32 a, i32 b) {
        return a + b;
    }
}

i32 main() {
    return Math.add(1, 2);
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("noinline"));
    }

    [Test]
    void NoReturnAttribute() {
        str source = """
struct Util {
    [NoReturn]
    public static void abort() {
        while (true) {}
    }
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("noreturn"));
    }

    [Test]
    void ColdAttribute() {
        str source = """
struct Util {
    [Cold]
    public static i32 rare_path() {
        return -1;
    }
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("cold"));
    }

    [Test]
    void MultipleAttributesOnMethod() {
        str source = """
struct Math {
    [ForceInline]
    [Hot]
    public static i32 add(i32 a, i32 b) {
        return a + b;
    }
}

i32 main() {
    return Math.add(1, 2);
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("alwaysinline").and_ir_contains("hot"));
    }

    [Test]
    void ImplicitNounwindOnAllFunctions() {
        str source = """
struct Math {
    public static i32 add(i32 a, i32 b) {
        return a + b;
    }
}

i32 main() {
    return Math.add(1, 2);
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("nounwind"));
    }

    [Test]
    void LlvmEscapeHatch() {
        str source = """
struct Util {
    [Llvm("mustprogress")]
    public static i32 compute(i32 x) {
        return x * 2;
    }
}

i32 main() {
    return Util.compute(21);
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("mustprogress"));
    }
}

struct ObjectIrTests {
    [Test]
    void BoxingIRContainsKind() {
        str source = """
struct Inspector {
    public static i32 check(...args) {
        object first = args[0];
        return (i32)first.type.kind;
    }
}

i32 main() {
    return Inspector.check(42);
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("__typeinfo_i32"));
    }
}

struct RuntimeErrorsIrTests {
    [Test]
    void ShadowStackCallsAppearInIr() {
        str source = """
i32 helper(i32t v) {
    return v;
}
i32 main() {
    return helper(1t);
}
""";
        Verify.source(source).with_std().with_debug_info().emits_ir(Expected.ir_contains("__djinn_frame_push").and_ir_contains("__djinn_frame_pop"));
    }

    [Test]
    void ReleaseModeOmitsShadowStackAndVarTracking() {
        str source = """
i32 helper(i32t v) {
    return v;
}
i32 main() {
    mut i32t x = 1t;
    x = 2t;
    return helper(x);
}
""";
        Verify.source(source).with_std().emits_ir(Expected.create().and_ir_lacks("__djinn_frame_push").and_ir_lacks("__djinn_frame_pop").and_ir_lacks("__djinn_frame_set_line").and_ir_lacks("__djinn_var_track"));
    }
}

struct ExternIrTests {
    [Test]
    void StdImportNoDuplicateExternSymbols() {
        str source = """
import std::types;
import std::sys;
import std::libc;
import std::collections;

namespace test_extern;

i32 main() {
    printf("hello %d\n", 42);
    return 0;
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("@printf").and_ir_contains("@malloc").and_ir_lacks("@printf.").and_ir_lacks("@malloc.").and_ir_lacks("@free.").and_ir_lacks("@strlen.").and_ir_lacks("@realloc."));
    }

    [Test]
    void ExternNotRemovedByOptimizer() {
        str source = """
extern i32 printf(i8* format, ...);

i32 main() {
    return 0;
}
""";
        Verify.source(source).optimized(3).emits_ir(Expected.ir_contains("declare").and_ir_contains("@printf").and_ir_contains("call"));
    }
}

struct StringInterpolationIrTests {
    [Test]
    void NoInterpolationLeavesStringUnchanged() {
        str source = """
extern i32 printf(i8* format, ...);

i32 main() {
    printf("plain string\n");
    return 0;
}
""";
        Verify.source(source).emits_ir(Expected.ir_contains("plain string"));
    }

    [Test]
    void BlockStringNoEscapes() {
        str source = "extern i32 printf(i8* format, ...);\n\ni32 main() {\n    printf(\"\"\"path: C:\\Users\\foo\"\"\");\n    return 0;\n}";
        Verify.source(source).emits_ir(Expected.ir_contains("C:\\\\Users\\\\foo"));
    }

    [Test]
    void EmptyBracesPreserved() {
        str source = """
extern i32 printf(i8* format, ...);

i32 main() {
    printf("nothing {} here\n");
    return 0;
}
""";
        Verify.source(source).emits_ir(Expected.ir_contains("nothing {} here"));
    }

    [Test]
    void NonCallStringLiteralNotInterpolated() {
        str source = """
i32 main() {
    i32 name = 7;
    str s = "hello {name}";
    return 0;
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("hello {name}"));
    }
}

struct IsExpressionIrTests {
    [Test]
    void IRContainsIsCheck() {
        str source = """
struct Inspector {
    public static i32 check(...args) {
        object first = args[0];
        if (first is i32) {
            return 1;
        }
        return 0;
    }
}

i32 main() {
    return Inspector.check(42);
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("is.match"));
    }
}

struct NativeTypesIrTests {
    [Test]
    void NfloatIsF32() {
        str source = """
i32 main() {
    nfloat a = 1.5;
    f32 b = a + 2.5;
    return 0;
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("float"));
    }

    [Test]
    void NdoubleIsF64() {
        str source = """
i32 main() {
    ndouble a = 1.5;
    f64 b = a + 2.5;
    return 0;
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("double"));
    }
}

struct NonZeroIrTests {
    [Test]
    void DivisionByConstantSkipsZeroCheck() {
        str source = """
i32 work(i32 a) {
    return a / 10;
}

i32 main() {
    return work(100);
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("sdiv").and_ir_lacks("div.zero").in_function("work"));
    }

    [Test]
    void DivisionByUnknownStillChecked() {
        str source = """
i32 work(i32 b) {
    return 100 / b;
}

i32 main() {
    return work(7);
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("div.zero").in_function("work"));
    }
}

struct AllocatorIrTests {
    [Test]
    void ArrayLiteralUsesTheZeroedAllocator() {
        str source = """
i32 main() {
    i32[] values = [1, 2, 3];
    return values[0] + values[2];
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("declare noalias ptr @__djinn_alloc_zeroed(i64)").and_ir_contains("allockind(\"alloc,zeroed\") allocsize(0) memory(inaccessiblemem: readwrite)"));
    }

    [Test]
    void ExternAllocatorsAreMarked() {
        str source = """
extern "C" {
    void* __djinn_alloc(u64 size);
}

i32 main() {
    unsafe {
        i8* memory = (i8*)__djinn_alloc(8);
        memory[0] = 7;
        return (i32)memory[0];
    }
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("declare noalias ptr @__djinn_alloc(i64)").and_ir_contains("allockind(\"alloc,uninitialized\")"));
    }

    [Test]
    void CoroutineFramesUseTheFramePool() {
        str source = """
async i32 compute() {
    return 42;
}

async i32 main() {
    return await compute();
}
""";
        Verify.source(source).with_std().emits_ir(Expected.ir_contains("call ptr @__djinn_coro_alloc(i64").and_ir_contains("call void @__djinn_coro_free(ptr"));
    }
}

struct ProgressIrTests {
    [Test]
    void LoopFreeCallChainMustProgress() {
        str source = """
i32 square(i32 x) {
    return x * x;
}

i32 hyp(i32 a, i32 b) {
    return square(a) + square(b);
}

async i32 never_suspends(i32 n) {
    return n + 1;
}

i32 main() {
    return hyp(3, 4) + await never_suspends(16);
}
""";
        Verify.source(source).emits_ir(Expected.ir_contains("mustprogress").in_function("square"));
        Verify.source(source).emits_ir(Expected.ir_contains("mustprogress").in_function("hyp"));
        Verify.source(source).emits_ir(Expected.ir_contains("mustprogress").in_function("never_suspends"));
        Verify.source(source).runs(Expected.exit(42));
        Verify.source(source).optimized(2).runs(Expected.exit(42));
    }

    [Test]
    void UnprovenFunctionsDoNotMustProgress() {
        str source = """
extern i32 abs(i32 value);

struct Data : Disposable {
    i32 value;

    void disposable() {
        while (this.value > 100) {
            this.value = this.value - 1;
        }
    }
}

i32 looping(i32 n) {
    mut i32 total = 0;
    for (mut i32 i = 0; i < n; i = i + 1) {
        total = total + i;
    }
    return total;
}

i32 spinning(i32 n) {
    mut i32 left = n;
    do {
        left = left - 1;
    } while (left > 0);
    return left;
}

i32 fact(i32 n) {
    if (n <= 1) {
        return 1;
    }
    return n * fact(n - 1);
}

async bool is_even(i32 n) {
    if (n == 0) {
        return true;
    }
    return await is_odd(n - 1);
}

async bool is_odd(i32 n) {
    if (n == 0) {
        return false;
    }
    return await is_even(n - 1);
}

i32 external(i32 n) {
    return abs(n);
}

i32 owner(i32 n) {
    Data data = { .value = n };
    return data.value;
}

i32 main() {
    mut i32 total = looping(4) + spinning(3) + fact(3) + external(-5) + owner(24);
    if (await is_even(10)) {
        total = total + 1;
    }
    return total;
}
""";
        Verify.source(source).emits_ir(Expected.ir_contains("nounwind").and_ir_lacks("mustprogress").in_function("Data.disposable"));
        Verify.source(source).emits_ir(Expected.ir_contains("nounwind").and_ir_lacks("mustprogress").in_function("looping"));
        Verify.source(source).emits_ir(Expected.ir_contains("nounwind").and_ir_lacks("mustprogress").in_function("spinning"));
        Verify.source(source).emits_ir(Expected.ir_contains("nounwind").and_ir_lacks("mustprogress").in_function("fact"));
        Verify.source(source).emits_ir(Expected.ir_contains("nounwind").and_ir_lacks("mustprogress").in_function("is_even"));
        Verify.source(source).emits_ir(Expected.ir_contains("nounwind").and_ir_lacks("mustprogress").in_function("is_odd"));
        Verify.source(source).emits_ir(Expected.ir_contains("nounwind").and_ir_lacks("mustprogress").in_function("external"));
        Verify.source(source).emits_ir(Expected.ir_contains("nounwind").and_ir_lacks("mustprogress").in_function("owner"));
        Verify.source(source).emits_ir(Expected.ir_contains("nounwind").and_ir_lacks("mustprogress").in_function("__djinn_sync_main"));
        Verify.source(source).runs(Expected.exit(42));
    }
}
