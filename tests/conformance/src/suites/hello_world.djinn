namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct HelloTests {
    [Test]
    void World() {
        str source = """
extern "C" {
    i32 printf(i8* format, ...);
}

void main() {
    printf("hello world!");
}
""";
        Verify.source(source).with_std().compiles().runs(Expected.exit(0).and_contains("hello world!"));
    }
}
