namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct NumericAuditTests {
    [Test]
    void nan_comparisons_follow_ieee() {
        str source = """
f64 make_nan(f64 zero) {
    return zero / zero;
}

i32 main() {
    f64 nan = make_nan(0.0);
    if (nan == nan) { return 1; }
    if (!(nan != nan)) { return 2; }
    if (nan < 1.0 || nan > 1.0 || nan <= 1.0 || nan >= 1.0) { return 3; }
    if (!(nan != 1.0)) { return 4; }
    return 42;
}
""";
        Verify.source(source).runs(Expected.exit(42));
    }

    [Test]
    void negative_zero_equals_zero_and_keeps_its_sign() {
        str source = """
f64 divide(f64 left, f64 right) {
    return left / right;
}

i32 main() {
    f64 zero = 0.0;
    f64 negative = 0.0 - zero * 1.0;
    f64 flipped = -zero;
    if (flipped != 0.0) { return 1; }
    if (divide(1.0, flipped) >= 0.0) { return 2; }
    if (divide(1.0, zero) <= 0.0) { return 3; }
    return 42;
}
""";
        Verify.source(source).runs(Expected.exit(42));
    }

    [Test]
    void subnormals_are_not_flushed_to_zero() {
        str source = """
f64 half(f64 value) {
    return value / 2.0;
}

f32 half_single(f32 value) {
    return value / 2.0;
}

i32 main() {
    mut f64 small = 1.0e-300;
    for (mut i32 i = 0; i < 20; i = i + 1) {
        small = half(small);
    }
    if (small <= 0.0) { return 1; }
    mut f32 tiny = 1.0e-38;
    for (mut i32 i = 0; i < 4; i = i + 1) {
        tiny = half_single(tiny);
    }
    if (tiny <= 0.0) { return 2; }
    return 42;
}
""";
        Verify.source(source).runs(Expected.exit(42));
    }

    [Test]
    void f32_is_promoted_to_f64_in_variadics() {
        str source = """
extern "C" {
    i32 printf(i8* format, ...);
}

i32 main() {
    f32 value = 1.5;
    printf("%.2f\n", value);
    return 0;
}
""";
        Verify.source(source).runs(Expected.exit(0).stdout("1.50\n"));
    }

    [Test]
    void f32_constants_round_at_every_step() {
        str source = """
constexpr f32 stepwise = 16777216.0 + 1.0 + 1.0;

f32 add(f32 left, f32 right) {
    return left + right;
}

i32 main() {
    f32 runtime = add(add(16777216.0, 1.0), 1.0);
    if (stepwise != 16777216.0) { return 1; }
    if (runtime != stepwise) { return 2; }
    return 42;
}
""";
        Verify.source(source).runs(Expected.exit(42));
    }

    [Test]
    void constants_and_run_time_agree_for_wrapping_arithmetic() {
        str source = """
i8w add8(i8w a, i8w b) { return a + b; }
i8w sub8(i8w a, i8w b) { return a - b; }
i8w mul8(i8w a, i8w b) { return a * b; }
u8w add_u8(u8w a, u8w b) { return a + b; }
u8w sub_u8(u8w a, u8w b) { return a - b; }
u8w mul_u8(u8w a, u8w b) { return a * b; }
i16w mul16(i16w a, i16w b) { return a * b; }
u16w sub_u16(u16w a, u16w b) { return a - b; }
i32w add32(i32w a, i32w b) { return a + b; }
i32w mul32(i32w a, i32w b) { return a * b; }
u32w sub_u32(u32w a, u32w b) { return a - b; }
u32w mul_u32(u32w a, u32w b) { return a * b; }
i64w add64(i64w a, i64w b) { return a + b; }
i64w mul64(i64w a, i64w b) { return a * b; }
u64w sub_u64(u64w a, u64w b) { return a - b; }
u64w mul_u64(u64w a, u64w b) { return a * b; }

constexpr i8 c_add8 = 127w + 1;
constexpr i8 c_sub8 = 0w - 127 - 2;
constexpr i8 c_mul8 = 100w * 3;
constexpr u8 c_add_u8 = 255w + 1;
constexpr u8 c_sub_u8 = 0w - 1;
constexpr u8 c_mul_u8 = 200w * 2;
constexpr i16 c_mul16 = 30000w * 3;
constexpr u16 c_sub_u16 = 0w - 1;
constexpr i32 c_add32 = 2147483647w + 1;
constexpr i32 c_mul32 = 65536w * 65536;
constexpr u32 c_sub_u32 = 0w - 1;
constexpr u32 c_mul_u32 = 65536w * 65536;
constexpr i64 c_add64 = 9223372036854775807w + 1;
constexpr i64 c_mul64 = 4294967296w * 4294967296;
constexpr u64 c_sub_u64 = 0w - 1;
constexpr u64 c_mul_u64 = 4294967296w * 4294967296;

i32 main() {
    if (c_add8 != add8(127, 1)) { return 1; }
    if (c_sub8 != sub8(0 - 127, 2)) { return 2; }
    if (c_mul8 != mul8(100, 3)) { return 3; }
    if (c_add_u8 != add_u8(255, 1)) { return 4; }
    if (c_sub_u8 != sub_u8(0, 1)) { return 5; }
    if (c_mul_u8 != mul_u8(200, 2)) { return 6; }
    if (c_mul16 != mul16(30000, 3)) { return 7; }
    if (c_sub_u16 != sub_u16(0, 1)) { return 8; }
    if (c_add32 != add32(2147483647, 1)) { return 9; }
    if (c_mul32 != mul32(65536, 65536)) { return 10; }
    if (c_sub_u32 != sub_u32(0, 1)) { return 11; }
    if (c_mul_u32 != mul_u32(65536, 65536)) { return 12; }
    if (c_add64 != add64(9223372036854775807, 1)) { return 13; }
    if (c_mul64 != mul64(4294967296, 4294967296)) { return 14; }
    if (c_sub_u64 != sub_u64(0, 1)) { return 15; }
    if (c_mul_u64 != mul_u64(4294967296, 4294967296)) { return 16; }
    return 42;
}
""";
        Verify.source(source).runs(Expected.exit(42));
    }

    [Test]
    void constants_and_run_time_agree_for_shifts_and_division() {
        str source = """
i32 shl32(i32 a, i32 b) { return a << b; }
i32 shr32(i32 a, i32 b) { return a >> b; }
u32 shr_u32(u32 a, u32 b) { return a >> b; }
i64 shl64(i64 a, i64 b) { return a << b; }
u64 shr_u64(u64 a, u64 b) { return a >> b; }
i32 div32(i32 a, i32 b) { return a / b; }
i32 rem32(i32 a, i32 b) { return a % b; }
u64 div_u64(u64 a, u64 b) { return a / b; }

constexpr i32 c_shl32 = 1 << 31;
constexpr i32 c_shr32 = (0 - 8) >> 1;
constexpr u32 c_shr_u32 = 2147483648 >> 31;
constexpr i64 c_shl64 = (i64)1 << 62;
constexpr u64 c_shr_u64 = 18446744073709551615 >> 60;
constexpr i32 c_div32 = (0 - 7) / 2;
constexpr i32 c_rem32 = (0 - 7) % 2;
constexpr u64 c_div_u64 = 18446744073709551615 / 3;

i32 main() {
    if (c_shl32 != shl32(1, 31)) { return 1; }
    if (c_shr32 != shr32(0 - 8, 1)) { return 2; }
    if (c_shr_u32 != shr_u32(2147483648, 31)) { return 3; }
    if (c_shl64 != shl64(1, 62)) { return 4; }
    if (c_shr_u64 != shr_u64(18446744073709551615, 60)) { return 5; }
    if (c_div32 != div32(0 - 7, 2)) { return 6; }
    if (c_rem32 != rem32(0 - 7, 2)) { return 7; }
    if (c_div_u64 != div_u64(18446744073709551615, 3)) { return 8; }
    return 42;
}
""";
        Verify.source(source).runs(Expected.exit(42));
    }

    [Test]
    void constants_and_run_time_agree_for_trapped_and_saturating() {
        str source = """
i32 sat_add(i32s a, i32s b) { return a + b; }
i32 sat_mul(i32s a, i32s b) { return a * b; }
u8 sat_sub(u8s a, u8s b) { return a - b; }

constexpr i32s c_add = 2147483647s + 100s;
constexpr i32s c_mul = 65536s * 65536s;
constexpr u8s c_sub = 3s - 10s;

i32 main() {
    if (c_add != sat_add(2147483647, 100)) { return 1; }
    if (c_mul != sat_mul(65536, 65536)) { return 2; }
    if (c_sub != sat_sub(3, 10)) { return 3; }
    return 42;
}
""";
        Verify.source(source).runs(Expected.exit(42));
    }

    [Test]
    void a_constant_expression_is_resolved_before_the_narrowing_check() {
        str source = """
i32 main() {
    u8 y = (u8)(200 + 100);
    return (i32)y;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION));
    }

    [Test]
    void a_constant_expression_that_fits_still_narrows() {
        str source = """
i32 main() {
    u8 y = (u8)(100 + 100);
    u64 all = (u64)(0w - 1);
    if (all != 18446744073709551615) { return 1; }
    return (i32)y;
}
""";
        Verify.source(source).runs(Expected.exit(200));
    }

    [Test]
    void bool_has_no_arithmetic() {
        str source = """
i32 main() {
    bool a = true;
    bool b = a + a;
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_OPERATOR_OPERAND));
    }

    [Test]
    void bool_ordering_is_disabled() {
        str source = """
i32 main() {
    bool a = false;
    bool b = true;
    if (a < b) { return 1; }
    return 0;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.OPERATOR_NOT_DEFINED).with_message("operator '<' is disabled for 'bool'"));
    }

    [Test]
    void bool_equality_still_works() {
        str source = """
i32 main() {
    bool a = false;
    bool b = true;
    if (a == b) { return 1; }
    if (a != b) { return 42; }
    return 2;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void bodiless_operator_disables_it_on_a_struct() {
        str source = """
struct Id {
    i32 value;
    operator ==(Id left, Id right) -> bool { return left.value == right.value; }
    operator <(Id left, Id right) -> bool;
}

i32 main() {
    Id a = { .value = 1 };
    Id b = { .value = 2 };
    if (a < b) { return 1; }
    return 0;
}
""";
        Verify.source(source).with_std().diagnostics(Expected.error(DiagnosticErrors.OPERATOR_NOT_DEFINED).with_message("operator '<' is disabled for 'Id'"));
    }

    [Test]
    void primitive_limit_constants() {
        str source = """
i32 main() {
    if (i8.MAX_VALUE != 127) { return 11; }
    if (i8.MIN_VALUE != -128) { return 12; }
    if (i32.MAX_VALUE != 2147483647) { return 2; }
    if (u8.MAX_VALUE != 255 || u32.MIN_VALUE != 0) { return 3; }
    if (i32.BITS != 32 || u64.BITS != 64 || f32.BITS != 32) { return 4; }
    if (f64.MANTISSA_DIGITS != 53) { return 5; }
    if (!(f64.INFINITY > f64.MAX_VALUE)) { return 6; }
    if (!(f64.NEG_INFINITY < f64.MIN_VALUE)) { return 7; }
    if (f64.NAN == f64.NAN) { return 8; }
    if (!(f32.INFINITY > f32.MAX_VALUE)) { return 9; }
    if (f32.NAN == f32.NAN) { return 10; }
    return 42;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(42));
    }

    [Test]
    void integer_literals_accept_hex_binary_and_separators() {
        str source = """
i32 main() {
    if (0xFF != 255 || 0XfF != 255 || 0xDEAD_BEEF != 3735928559) { return 1; }
    if (0b1010 != 10 || 0B11 != 3 || 0b1111_0000 != 240) { return 2; }
    if (1_000_000_000 != 1000000000 || 1'000 != 1000) { return 3; }
    u64 all = 0xFFFF_FFFF_FFFF_FFFF;
    if (all != 18446744073709551615) { return 4; }
    i64 mask = 0x7FFF_FFFF_FFFF_FFFF;
    if (mask != 9223372036854775807) { return 5; }
    u8 byte = 0b1111_1111;
    if (byte != 255) { return 6; }
    i32 billion = 1_000_000_000;
    if (billion + billion < 0) { return 7; }
    return 42;
}
""";
        Verify.source(source).runs(Expected.exit(42));
    }

    [Test]
    void hex_and_binary_literals_that_do_not_fit_are_errors() {
        str hex = """
i32 main() {
    u8 x = 0x100;
    return 0;
}
""";
        str binary = """
i32 main() {
    u8 x = 0b1_0000_0000;
    return 0;
}
""";
        Verify.source(hex).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION));
        Verify.source(binary).diagnostics(Expected.error(DiagnosticErrors.INVALID_CONSTANT_EXPRESSION));
    }

    [Test]
    void bool_keeps_bitwise_operators() {
        str source = """
i32 main() {
    bool a = true;
    bool b = false;
    if (!(a & !b)) { return 1; }
    if (!(a | b)) { return 2; }
    if (!(a ^ b)) { return 3; }
    return 42;
}
""";
        Verify.source(source).runs(Expected.exit(42));
    }
}
