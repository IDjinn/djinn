namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct CharTests {
    [Test]
    void char_literals_cover_ascii_escapes_and_unicode() {
        str source = """
i32 main() {
    char letter = 'a';
    char newline = '\n';
    char quote = '\'';
    char accent = 'é';
    char smile = '😀';
    char escaped = '\U0001F600';
    mut i32 score = 0;
    if ((i32)letter == 97) { score = score + 1; }
    if ((i32)newline == 10) { score = score + 2; }
    if ((i32)quote == 39) { score = score + 4; }
    if ((i32)accent == 233) { score = score + 8; }
    if ((i32)smile == 128512) { score = score + 16; }
    if (smile == escaped) { score = score + 32; }
    return score;
}
""";
        Verify.source(source).runs(Expected.exit(63));
    }

    [Test]
    void char_compares_and_converts_only_with_explicit_casts() {
        str source = """
i32 main() {
    char first = 'a';
    char next = (char)((i32)first + 1);
    mut i32 score = 0;
    if (first < next) { score = score + 1; }
    if (next != first) { score = score + 2; }
    if ((u8)first == 97) { score = score + 4; }
    return score;
}
""";
        Verify.source(source).runs(Expected.exit(7));
    }

    [Test]
    void integer_does_not_convert_to_char_implicitly() {
        str source = """
i32 main() {
    char letter = 97;
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.IMPLICIT_CONVERSION).at(2, 19));
    }

    [Test]
    void char_does_not_convert_to_integer_implicitly() {
        str source = """
i32 main() {
    i32 code = 'a';
    return code;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.IMPLICIT_CONVERSION).at(2, 16));
    }

    [Test]
    void char_and_integer_cannot_be_mixed_in_an_expression() {
        str source = """
i32 main() {
    char letter = 'a';
    if (letter == 97) { return 1; }
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.IMPLICIT_CONVERSION).at(3, 16));
    }

    [Test]
    void char_literal_holding_two_characters_is_error() {
        str source = """
i32 main() {
    char letter = 'ab';
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CHAR_LITERAL));
    }

    [Test]
    void interpolation_writes_the_char_as_utf8() {
        str source = """
i32 main() {
    char accent = 'é';
    char smile = '😀';
    string shown = $"a{accent}{smile}";
    return (i32)shown.length;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(7));
    }

    [Test]
    void str_methods_accept_a_char() {
        str source = """
import std::types;
namespace app;

i32 main() {
    str word = "café 😀!";
    mut i32 score = 0;
    if (word.contains('é')) { score = score + 1; }
    if (word.startsWith('c')) { score = score + 2; }
    if (word.endsWith('!')) { score = score + 4; }
    if (word.indexOf('😀') == 6) { score = score + 8; }
    if (word.lastIndexOf('c') == 0) { score = score + 16; }
    if (!word.contains('z')) { score = score + 32; }
    return score;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(63));
    }

    [Test]
    void char_equals_str_and_string() {
        str source = """
import std::types;
namespace app;

i32 main() {
    str ascii = "a";
    str accent = "é";
    string smile = "😀";
    str word = "ab";
    mut i32 score = 0;
    if ('a' == ascii) { score = score + 1; }
    if (accent == 'é') { score = score + 2; }
    if ('😀' == smile) { score = score + 4; }
    if (smile != 'a') { score = score + 8; }
    if ('a' != word) { score = score + 16; }
    if ('b' != ascii) { score = score + 32; }
    return score;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(63));
    }

    [Test]
    void unicode_escape_with_a_bad_digit_is_error() {
        str source = """
i32 main() {
    char letter = '\u12G4';
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CHAR_LITERAL));
    }

    [Test]
    void unicode_escape_outside_the_scalar_range_is_error() {
        str source = """
i32 main() {
    char letter = '\UFFFFFFFF';
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.INVALID_CHAR_LITERAL));
    }
}
