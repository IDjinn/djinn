namespace conformance;

import testing;
import djinnc::testing;
import djinnc;

struct PlatformAttributeTests {
    [Test]
    void declaration_for_another_platform_is_dropped() {
        str source = """
[Platform(windows)]
i32 os() {
    return 1;
}

[Platform(linux, macos)]
i32 os() {
    return 1;
}

[Platform(web)]
i32 os() {
    return 99;
}

i32 main() {
    return os();
}
""";
        Verify.source(source).runs(Expected.exit(1));
    }

    [Test]
    void groups_select_desktop_and_native() {
        str source = """
[Platform(desktop)]
i32 kind() {
    return 4;
}

[Platform(mobile, web)]
i32 kind() {
    return 8;
}

[Platform(native)]
i32 extra() {
    return 1;
}

i32 main() {
    return kind() + extra();
}
""";
        Verify.source(source).runs(Expected.exit(5));
    }

    [Test]
    void struct_member_for_another_platform_is_dropped() {
        str source = """
struct Window {
    i32 width;

    [Platform(web)]
    i64 canvas;

    [Platform(web)]
    i32 canvas_id() {
        return 7;
    }
}

i32 main() {
    return (i32)sizeof(Window);
}
""";
        Verify.source(source).runs(Expected.exit(4));
    }

    [Test]
    void platform_constants_for_new_targets() {
        str source = """
import std::sys;

i32 main() {
    if (Platform.Web || Platform.Android || Platform.Ios || Platform.Mobile) {
        return 1;
    }
    if (!Platform.Desktop) {
        return 2;
    }
    return 0;
}
""";
        Verify.source(source).with_std().runs(Expected.exit(0));
    }

    [Test]
    void unknown_platform_is_an_error() {
        str source = """
[Platform(amiga)]
i32 retro() {
    return 1;
}

i32 main() {
    return 0;
}
""";
        Verify.source(source).diagnostics(Expected.error(DiagnosticErrors.SEMANTIC).at(1, 2));
    }
}
