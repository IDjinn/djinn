namespace djinnc;

struct SourcePosition {
    i32 line;
    i32 column;
}

struct Source {
    ptr<i8> path;
    ptr<i8> text;

    public unsafe ptr<i8> contents() {
        if (this.text != null) {
            return this.text;
        }
        return Files.read_all(this.path);
    }

    public unsafe SourcePosition* find(ptr<i8> needle) {
        SourcePosition* position = (SourcePosition*)Memory.zalloc(sizeof(SourcePosition));
        position.line = -1;
        ptr<i8> contents = this.contents();
        ptr<i8> found = strstr(contents, needle);
        if (found == null) {
            return position;
        }
        position.line = 1;
        position.column = 1;
        for (mut ptr<i8> at = contents; at != found; at = at + 1) {
            position.column = position.column + 1;
            if (at[0] == 10) {
                position.line = position.line + 1;
                position.column = 1;
            }
        }
        return position;
    }
}

struct Sources {
    public static unsafe Source* file(ptr<i8> path) {
        Source* source = (Source*)Memory.zalloc(sizeof(Source));
        source.path = path;
        return source;
    }

    public static unsafe Source* text(ptr<i8> text) {
        Source* source = (Source*)Memory.zalloc(sizeof(Source));
        source.text = text;
        return source;
    }
}
