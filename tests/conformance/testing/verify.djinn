namespace djinnc;

unsafe static mut ptr current_verify = null;

struct Verify {
    PointerList* cases;
    PointerList* sources;
    Config* config;
    ptr<i8> name;
    bool std;
    i32 retry;
    i32 timeout;
    i32 required;
    i32 checks;
    Source* pending;

    public static unsafe Verify* create(PointerList* cases, Config* config) {
        Verify* verify = (Verify*)Memory.zalloc(sizeof(Verify));
        verify.cases = cases;
        verify.sources = PointerList.create();
        verify.config = config;
        return verify;
    }

    public unsafe Verify* test(ptr<i8> name) {
        this.name = name;
        this.std = false;
        this.retry = 0;
        this.timeout = 0;
        this.required = 0;
        this.checks = 0;
        return this;
    }

    public static unsafe Verify* with_source(Source* source) {
        Verify* verify = (Verify*)current_verify;
        verify.pending = source;
        return verify;
    }

    public static unsafe Verify* source(str text) {
        return Verify.with_source(Sources.text(Reflection.terminated_view(text)));
    }

    public static unsafe Verify* file(ptr<i8> path) {
        return Verify.with_source(Sources.file(path));
    }

    public unsafe void suite(TypeInfo* type) {
        current_verify = (ptr)this;
        TypeInfoExt* info = Reflection.ext(type);
        for (mut i32 i = 0; i < (i32)info.methodCount; i = i + 1) {
            MethodInfo* method = &info.methods[i];
            if (Verify.is_test(method)) {
                this.run_test(type, method);
            }
        }
    }

    static unsafe bool is_test(MethodInfo* method) {
        for (mut i32 i = 0; i < (i32)method.attrCount; i = i + 1) {
            if (Strings.same((ptr<i8>)method.attrs[i].name, "Test")) {
                return true;
            }
        }
        return false;
    }

    unsafe void run_test(TypeInfo* type, MethodInfo* method) {
        this.test((ptr<i8>)method.name);
        this.policy(method);
        if ((i32)method.paramCount != 0 || ((i32)method.flags & Reflection.METHOD_ASYNC) != 0) {
            this.fail_case("a [Test] takes no parameters and is not async yet");
            return;
        }
        if (((i32)method.flags & Reflection.METHOD_STATIC) != 0) {
            __djinn_call_entry((ptr)method.funcPtr);
        } else {
            __djinn_call_method((ptr)method.funcPtr, (ptr)Memory.zalloc((u64)type.size + 1));
        }
        if (this.checks == 0) {
            this.fail_case("this [Test] checks nothing");
        }
    }

    unsafe void fail_case(ptr<i8> reason) {
        Config* config = this.config;
        TestCase* test = Runner.new_case(config, this.name, "", Kind.SELFTEST);
        test.state = 2;
        test.reason = reason;
        this.select(test);
    }

    unsafe void select(TestCase* test) {
        Config* config = this.config;
        if (config.filter == null || strstr(test.name, config.filter) != null) {
            PointerList* cases = this.cases;
            cases.push((ptr)test);
        }
    }

    public unsafe Verify* with_std() {
        this.std = true;
        return this;
    }

    public unsafe Verify* policy(MethodInfo* method) {
        for (mut i32 i = 0; i < (i32)method.attrCount; i = i + 1) {
            if (Strings.same((ptr<i8>)method.attrs[i].name, "TestPolicy")) {
                TestPolicy* policy = (TestPolicy*)method.attrs[i].payload;
                this.retry = policy.retry;
                this.timeout = policy.timeout;
            } else if (Strings.same((ptr<i8>)method.attrs[i].name, "Requires")) {
                Requires* requires = (Requires*)method.attrs[i].payload;
                this.required = requires.paths;
            }
        }
        return this;
    }

    public unsafe bool uses(ptr<i8> path) {
        PointerList* sources = this.sources;
        for (mut i32 i = 0; i < sources.length; i = i + 1) {
            if (Strings.same((ptr<i8>)sources.get(i), path)) {
                return true;
            }
        }
        return false;
    }

    unsafe void remember(Source* source) {
        this.checks = this.checks + 1;
        if (source.path != null) {
            PointerList* sources = this.sources;
            sources.push((ptr)source.path);
        }
    }

    unsafe void resolve_paths(TestCase* test, i32 minimum) {
        Config* config = this.config;
        mut i32 paths = this.required;
        if (paths == 0) {
            paths = minimum & (0 - minimum);
        }
        if ((paths & minimum) == 0) {
            test.state = 2;
            test.reason = "[Requires] asks for less than this test needs";
            return;
        }
        if (test.kind == Kind.RUN) {
            paths = paths | config.forced_paths;
        }
        if (config.out_dir == null && (paths & TestPath.LINK) != 0) {
            config.skipped_links = config.skipped_links + 1;
            paths = paths - TestPath.LINK;
        }
        test.requires = paths;
        test.path = Runner.first_path(test);
        if (test.path == 0 && test.kind != Kind.SELFTEST) {
            test.skipped = true;
        }
    }

    unsafe ptr<i8> case_name() {
        if (this.checks < 2) {
            return this.name;
        }
        ByteBuffer* name = ByteBuffer.create();
        name.append(this.name);
        name.append("#");
        name.append_int((i64)this.checks);
        return name.cstr();
    }

    unsafe TestCase* add(Source* source, i32 kind, Expected* expected, i32 minimum) {
        Config* config = this.config;
        ptr<i8> name = this.case_name();
        if (source.path == null) {
            source.path = Runner.output_path(config, name, ".djinn");
        }
        TestCase* test = Runner.new_case(config, name, source.path, kind);
        test.std = this.std;
        test.expected = expected;
        test.max_retries = this.retry;
        if (this.timeout > 0) {
            test.timeout_us = (i64)this.timeout * 1000;
        }
        this.resolve_paths(test, minimum);
        if (!test.skipped) {
            if (source.text != null && (config.filter == null || strstr(test.name, config.filter) != null)) {
                Files.write_bytes(source.path, source.text, strlen(source.text));
            }
            this.select(test);
        }
        return test;
    }

    public unsafe void runs(Source* source, Expected* expected) {
        this.remember(source);
        this.add(source, Kind.RUN, expected, TestPath.JIT | TestPath.LINK);
    }

    public unsafe void runs(Expected* expected) {
        this.runs(this.pending, expected);
    }

    public unsafe void compiles() {
        this.compiles(this.pending);
    }

    public unsafe void diagnostics(Expected* expected) {
        this.diagnostics(this.pending, expected);
    }

    public unsafe void compiles(Source* source) {
        this.remember(source);
        this.add(source, Kind.CLEAN, Expected.create(), TestPath.ANY);
    }

    public unsafe void diagnostics(Source* source, Expected* expected) {
        this.remember(source);
        if (expected.reaches_codegen()) {
            this.add(source, Kind.ERROR, expected, TestPath.CODEGEN);
        } else {
            this.add(source, Kind.ERROR, expected, TestPath.ANY);
        }
    }

    public unsafe void crashes(Source* source, Expected* expected) {
        this.remember(source);
        Config* config = this.config;
        if (config.crash) {
            this.add(source, Kind.CRASH, expected, TestPath.LINK);
        }
    }

    public unsafe void stops_at(Source* source, i32 line, Expected* expected) {
        this.remember(source);
        Config* config = this.config;
        if (config.debug) {
            TestCase* test = this.add(source, Kind.DEBUG, expected, TestPath.LINK);
            test.line = line;
        }
    }

    public unsafe void links_library(Source* library, Source* application, Expected* expected) {
        this.remember(library);
        this.remember(application);
        Config* config = this.config;
        if (config.library) {
            TestCase* test = this.add(application, Kind.LIBRARY, expected, TestPath.LINK);
            test.library = library.path;
        }
    }

    public unsafe void selftest() {
        this.add(Sources.file(""), Kind.SELFTEST, Expected.create(), TestPath.ANY);
    }
}
