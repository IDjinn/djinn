namespace djinnc;

struct FunctionsSuite {
    public static unsafe void register(Verify* verify) {
        verify.test("functions/Constructor.StackBasicFieldAccess").with_std().runs(Sources.file("tests/conformance/cases/functions/Constructor.StackBasicFieldAccess.djinn"), Expected.exit(10));
        verify.test("functions/Constructor.StackSecondField").with_std().runs(Sources.file("tests/conformance/cases/functions/Constructor.StackSecondField.djinn"), Expected.exit(20));
        verify.test("functions/Constructor.StackFieldExpression").with_std().runs(Sources.file("tests/conformance/cases/functions/Constructor.StackFieldExpression.djinn"), Expected.exit(42));
        verify.test("functions/Constructor.StackThreeFields").with_std().runs(Sources.file("tests/conformance/cases/functions/Constructor.StackThreeFields.djinn"), Expected.exit(6));
        verify.test("functions/Constructor.StackPassedToFunction").with_std().runs(Sources.file("tests/conformance/cases/functions/Constructor.StackPassedToFunction.djinn"), Expected.exit(99));
        verify.test("functions/Constructor.HeapBasicFieldAccess").with_std().runs(Sources.file("tests/conformance/cases/functions/Constructor.HeapBasicFieldAccess.djinn"), Expected.exit(1));
        verify.test("functions/Constructor.HeapSecondField").with_std().runs(Sources.file("tests/conformance/cases/functions/Constructor.HeapSecondField.djinn"), Expected.exit(69));
        verify.test("functions/Constructor.HeapFieldExpression").with_std().runs(Sources.file("tests/conformance/cases/functions/Constructor.HeapFieldExpression.djinn"), Expected.exit(42));
        verify.test("functions/Constructor.HeapThreeFields").with_std().runs(Sources.file("tests/conformance/cases/functions/Constructor.HeapThreeFields.djinn"), Expected.exit(60));
        verify.test("functions/Constructor.HeapFieldAssignment").with_std().runs(Sources.file("tests/conformance/cases/functions/Constructor.HeapFieldAssignment.djinn"), Expected.exit(77));
        verify.test("functions/Constructor.StackAndHeapSameStruct").with_std().runs(Sources.file("tests/conformance/cases/functions/Constructor.StackAndHeapSameStruct.djinn"), Expected.exit(50));
        verify.test("functions/Constructor.GenericStackBasic").with_std().runs(Sources.file("tests/conformance/cases/functions/Constructor.GenericStackBasic.djinn"), Expected.exit(42));
        verify.test("functions/Constructor.GenericStackNoArgs").with_std().runs(Sources.file("tests/conformance/cases/functions/Constructor.GenericStackNoArgs.djinn"), Expected.exit(0));
        verify.test("functions/Constructor.GenericStackTwoFields").with_std().runs(Sources.file("tests/conformance/cases/functions/Constructor.GenericStackTwoFields.djinn"), Expected.exit(42));
        verify.test("functions/Constructor.GenericStackMethodCall").with_std().runs(Sources.file("tests/conformance/cases/functions/Constructor.GenericStackMethodCall.djinn"), Expected.exit(77));
        verify.test("functions/Constructor.GenericStackMethodForwardReference").with_std().runs(Sources.file("tests/conformance/cases/functions/Constructor.GenericStackMethodForwardReference.djinn"), Expected.exit(2));
        verify.test("functions/Constructor.GenericHeapBasic").with_std().runs(Sources.file("tests/conformance/cases/functions/Constructor.GenericHeapBasic.djinn"), Expected.exit(99));
        verify.test("functions/Constructor.GenericHeapMethodCall").with_std().runs(Sources.file("tests/conformance/cases/functions/Constructor.GenericHeapMethodCall.djinn"), Expected.exit(55));
        verify.test("functions/Method.BasicMethodWithBlock").with_std().compiles(Sources.file("tests/conformance/cases/functions/Method.BasicMethodWithBlock.djinn"));
        verify.test("functions/Method.ExpressionBodyArrow").with_std().compiles(Sources.file("tests/conformance/cases/functions/Method.ExpressionBodyArrow.djinn"));
        verify.test("functions/Method.MethodWithParameters").with_std().compiles(Sources.file("tests/conformance/cases/functions/Method.MethodWithParameters.djinn"));
        verify.test("functions/Method.PublicPrivateModifiers").with_std().compiles(Sources.file("tests/conformance/cases/functions/Method.PublicPrivateModifiers.djinn"));
        verify.test("functions/Method.StaticMethod").with_std().compiles(Sources.file("tests/conformance/cases/functions/Method.StaticMethod.djinn"));
        verify.test("functions/Method.VoidMethodWithBlock").with_std().compiles(Sources.file("tests/conformance/cases/functions/Method.VoidMethodWithBlock.djinn"));
        verify.test("functions/Method.MixedFieldsAndMethods").with_std().compiles(Sources.file("tests/conformance/cases/functions/Method.MixedFieldsAndMethods.djinn"));
        verify.test("functions/OperatorOverload.ParseOperatorInInterface").with_std().compiles(Sources.file("tests/conformance/cases/functions/OperatorOverload.ParseOperatorInInterface.djinn"));
        verify.test("functions/OperatorOverload.ParseOperatorInImpl").with_std().compiles(Sources.file("tests/conformance/cases/functions/OperatorOverload.ParseOperatorInImpl.djinn"));
        verify.test("functions/OperatorOverload.StructAddition").with_std().runs(Sources.file("tests/conformance/cases/functions/OperatorOverload.StructAddition.djinn"), Expected.exit(10));
        verify.test("functions/OperatorOverload.StructEquality").with_std().runs(Sources.file("tests/conformance/cases/functions/OperatorOverload.StructEquality.djinn"), Expected.exit(1));
        verify.test("functions/OperatorOverload.NotEqualDerivedFromEqual").with_std().runs(Sources.file("tests/conformance/cases/functions/OperatorOverload.NotEqualDerivedFromEqual.djinn"), Expected.exit(42));
