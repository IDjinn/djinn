namespace djinnc;

struct Suites {
    public static unsafe void register(Verify* verify) {
        AggregatesSuite.register(verify);
        ArithmeticSuite.register(verify);
        AsyncSuite.register(verify);
        CompileTimeSuite.register(verify);
        CompilerSuite.register(verify);
        ControlFlowSuite.register(verify);
        CrashSuite.register(verify);
        DebugSuite.register(verify);
        ErrorsSuite.register(verify);
        FunctionsSuite.register(verify);
        GenericsSuite.register(verify);
        HelloWorldSuite.register(verify);
        LibrarySuite.register(verify);
        MemorySuite.register(verify);
        ModulesSuite.register(verify);
        SamplesSuite.register(verify);
        StdSuite.register(verify);
        TypesSuite.register(verify);
    }
}
