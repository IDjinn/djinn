namespace djinnc;

struct CrashSuite {
    public static unsafe void register(Verify* verify) {
        verify.test("crash/null_read").crashes(Sources.file("tests/djinnc/crash/null_read.djinn"), Expected.contains("native stack trace").and_contains("read").and_contains("outer").and_contains("null_read.djinn:6").and_contains("null_read.djinn:10"));
        verify.test("crash/division_overflow").crashes(Sources.file("tests/djinnc/crash/division_overflow.djinn"), Expected.contains("integer overflow: the minimum value divided by -1").and_contains("division_overflow.djinn:2"));
    }
}
