namespace djinnc;

struct CrashSuite {
    public static unsafe void register(Verify* verify) {
        verify.test("crash/null_read").crashes(Sources.file("tests/djinnc/crash/null_read.djinn"), Expected.contains("native stack trace").and_contains("read").and_contains("outer").and_contains("null_read.djinn:6").and_contains("null_read.djinn:10"));
        verify.test("crash/division_overflow").crashes(Sources.file("tests/djinnc/crash/division_overflow.djinn"), Expected.contains("integer overflow: the minimum value divided by -1").and_contains("division_overflow.djinn:2"));
        verify.test("crash/division_by_zero").crashes(Sources.file("tests/djinnc/crash/division_by_zero.djinn"), Expected.contains("division by zero").and_contains("division_by_zero.djinn:2"));
        verify.test("crash/unsigned_division_by_zero").crashes(Sources.file("tests/djinnc/crash/unsigned_division_by_zero.djinn"), Expected.contains("division by zero").and_contains("unsigned_division_by_zero.djinn:2"));
        verify.test("crash/wide_division_by_zero").crashes(Sources.file("tests/djinnc/crash/wide_division_by_zero.djinn"), Expected.contains("division by zero").and_contains("wide_division_by_zero.djinn:2"));
        verify.test("crash/remainder_by_zero").crashes(Sources.file("tests/djinnc/crash/remainder_by_zero.djinn"), Expected.contains("division by zero").and_contains("remainder_by_zero.djinn:2"));
        verify.test("crash/compound_division_by_zero").crashes(Sources.file("tests/djinnc/crash/compound_division_by_zero.djinn"), Expected.contains("division by zero").and_contains("compound_division_by_zero.djinn:4"));
        verify.test("crash/shift_left_too_far").crashes(Sources.file("tests/djinnc/crash/shift_left_too_far.djinn"), Expected.contains("shift amount is out of range").and_contains("shift_left_too_far.djinn:2"));
        verify.test("crash/shift_right_too_far").crashes(Sources.file("tests/djinnc/crash/shift_right_too_far.djinn"), Expected.contains("shift amount is out of range").and_contains("shift_right_too_far.djinn:2"));
        verify.test("crash/shift_negative").crashes(Sources.file("tests/djinnc/crash/shift_negative.djinn"), Expected.contains("shift amount is out of range").and_contains("shift_negative.djinn:2"));
        verify.test("crash/nan_to_integer").crashes(Sources.file("tests/djinnc/crash/nan_to_integer.djinn"), Expected.contains("float value is out of range for the integer type").and_contains("nan_to_integer.djinn:2"));
        verify.test("crash/infinity_to_integer").crashes(Sources.file("tests/djinnc/crash/infinity_to_integer.djinn"), Expected.contains("float value is out of range for the integer type").and_contains("infinity_to_integer.djinn:2"));
        verify.test("crash/large_float_to_integer").crashes(Sources.file("tests/djinnc/crash/large_float_to_integer.djinn"), Expected.contains("float value is out of range for the integer type").and_contains("large_float_to_integer.djinn:2"));
        verify.test("crash/negative_float_to_unsigned").crashes(Sources.file("tests/djinnc/crash/negative_float_to_unsigned.djinn"), Expected.contains("float value is out of range for the integer type").and_contains("negative_float_to_unsigned.djinn:2"));
        verify.test("crash/large_float_to_wide").crashes(Sources.file("tests/djinnc/crash/large_float_to_wide.djinn"), Expected.contains("float value is out of range for the integer type").and_contains("large_float_to_wide.djinn:2"));
        verify.test("crash/wide_division_overflow").crashes(Sources.file("tests/djinnc/crash/wide_division_overflow.djinn"), Expected.contains("integer overflow: the minimum value divided by -1").and_contains("wide_division_overflow.djinn:2"));
    }
}
