namespace djinnc;

struct CompilerSuite {
    public static unsafe void register(Verify* verify) {
        verify.test("compiler/Binder.AllowsValidCode").with_std().runs(Sources.file("tests/conformance/cases/compiler/Binder.AllowsValidCode.djinn"), Expected.exit(30));
        verify.test("compiler/Binder.VariableDeclarationAndUsage").with_std().runs(Sources.file("tests/conformance/cases/compiler/Binder.VariableDeclarationAndUsage.djinn"), Expected.exit(42));
        verify.test("compiler/Binder.FunctionCallWithCorrectArgs").with_std().runs(Sources.file("tests/conformance/cases/compiler/Binder.FunctionCallWithCorrectArgs.djinn"), Expected.exit(6));
        verify.test("compiler/Binder.NamespaceQualifiedNames").with_std().compiles(Sources.file("tests/conformance/cases/compiler/Binder.NamespaceQualifiedNames.djinn"));
        verify.test("compiler/Binder.NestedNamespaceQualifiedNames").with_std().compiles(Sources.file("tests/conformance/cases/compiler/Binder.NestedNamespaceQualifiedNames.djinn"));
        verify.test("compiler/Binder.FileScopedNamespaceBinding").with_std().compiles(Sources.file("tests/conformance/cases/compiler/Binder.FileScopedNamespaceBinding.djinn"));
        verify.test("compiler/Binder.StructFieldAccess").with_std().runs(Sources.file("tests/conformance/cases/compiler/Binder.StructFieldAccess.djinn"), Expected.exit(15));
        verify.test("compiler/Binder.MultipleVariables").with_std().runs(Sources.file("tests/conformance/cases/compiler/Binder.MultipleVariables.djinn"), Expected.exit(6));
        verify.test("compiler/BootstrapSubset.PointerParameterFieldReadWrite").with_std().runs(Sources.file("tests/conformance/cases/compiler/BootstrapSubset.PointerParameterFieldReadWrite.djinn"), Expected.exit(42));
        verify.test("compiler/BootstrapSubset.PointerLocalMethodCall").with_std().runs(Sources.file("tests/conformance/cases/compiler/BootstrapSubset.PointerLocalMethodCall.djinn"), Expected.exit(2));
        verify.test("compiler/BootstrapSubset.PointerParameterInMethod").with_std().runs(Sources.file("tests/conformance/cases/compiler/BootstrapSubset.PointerParameterInMethod.djinn"), Expected.exit(10));
        verify.test("compiler/BootstrapSubset.PointerArrayOfStructPointers").with_std().runs(Sources.file("tests/conformance/cases/compiler/BootstrapSubset.PointerArrayOfStructPointers.djinn"), Expected.exit(6));
        verify.test("compiler/FunctionContext.BreakAndContinueAfterGenericInstantiation").runs(Sources.file("tests/conformance/cases/compiler/FunctionContext.BreakAndContinueAfterGenericInstantiation.djinn"), Expected.exit(9));
        verify.test("compiler/FunctionContext.MonomorphizedStructVisibleToLaterFunctions").runs(Sources.file("tests/conformance/cases/compiler/FunctionContext.MonomorphizedStructVisibleToLaterFunctions.djinn"), Expected.exit(7));
        verify.test("compiler/FunctionContext.PointerFieldMethodDispatchThroughAuto").runs(Sources.file("tests/conformance/cases/compiler/FunctionContext.PointerFieldMethodDispatchThroughAuto.djinn"), Expected.exit(9));
        verify.test("compiler/Determinism.SameSourceProducesIdenticalIr").compiles(Sources.file("tests/conformance/cases/compiler/Determinism.SameSourceProducesIdenticalIr.djinn"));
        verify.test("compiler/Object.TypeInfoStructDefinition").with_std().runs(Sources.file("tests/conformance/cases/compiler/Object.TypeInfoStructDefinition.djinn"), Expected.exit(1));
        verify.test("compiler/Object.ObjectStructDefinition").with_std().runs(Sources.file("tests/conformance/cases/compiler/Object.ObjectStructDefinition.djinn"), Expected.exit(0));
        verify.test("compiler/Object.TypeInfoKindInt").with_std().runs(Sources.file("tests/conformance/cases/compiler/Object.TypeInfoKindInt.djinn"), Expected.exit(0));
        verify.test("compiler/Object.TypeInfoKindFloat").with_std().runs(Sources.file("tests/conformance/cases/compiler/Object.TypeInfoKindFloat.djinn"), Expected.exit(1));
        verify.test("compiler/Object.VariadicMethodCompiles").with_std().runs(Sources.file("tests/conformance/cases/compiler/Object.VariadicMethodCompiles.djinn"), Expected.exit(0));
        verify.test("compiler/Object.VariadicEmptyArgs").with_std().runs(Sources.file("tests/conformance/cases/compiler/Object.VariadicEmptyArgs.djinn"), Expected.exit(0));
        verify.test("compiler/Object.VariadicArgsLength").with_std().runs(Sources.file("tests/conformance/cases/compiler/Object.VariadicArgsLength.djinn"), Expected.exit(3));
        verify.test("compiler/Object.VariadicWithNormalParams").with_std().runs(Sources.file("tests/conformance/cases/compiler/Object.VariadicWithNormalParams.djinn"), Expected.exit(2));
        verify.test("compiler/Object.VariadicAccessTypeInfo").with_std().runs(Sources.file("tests/conformance/cases/compiler/Object.VariadicAccessTypeInfo.djinn"), Expected.exit(4));
        verify.test("compiler/Object.SyncPrintIntViaVariadic").with_std().runs(Sources.file("tests/conformance/cases/compiler/Object.SyncPrintIntViaVariadic.djinn"), Expected.exit(42));
        verify.test("compiler/Object.AutoBoxPrimitiveToObject").with_std().runs(Sources.file("tests/conformance/cases/compiler/Object.AutoBoxPrimitiveToObject.djinn"), Expected.exit(0));
        verify.test("compiler/Object.AutoBoxStructToObject").with_std().runs(Sources.file("tests/conformance/cases/compiler/Object.AutoBoxStructToObject.djinn"), Expected.exit(8));
        verify.test("compiler/Object.AutoBoxStructToObjectKind").with_std().runs(Sources.file("tests/conformance/cases/compiler/Object.AutoBoxStructToObjectKind.djinn"), Expected.exit(3));
        verify.test("compiler/Object.AutoBoxFloatToObject").with_std().runs(Sources.file("tests/conformance/cases/compiler/Object.AutoBoxFloatToObject.djinn"), Expected.exit(1));
        verify.test("compiler/Object.IsExpressionWithAutoBoxedPrimitive").with_std().runs(Sources.file("tests/conformance/cases/compiler/Object.IsExpressionWithAutoBoxedPrimitive.djinn"), Expected.exit(1));
        verify.test("compiler/Object.IsExpressionBindingWithAutoBoxed").with_std().runs(Sources.file("tests/conformance/cases/compiler/Object.IsExpressionBindingWithAutoBoxed.djinn"), Expected.exit(99));
        verify.test("compiler/Object.NoWarningOnLiteralBoxing").with_std().compiles(Sources.file("tests/conformance/cases/compiler/Object.NoWarningOnLiteralBoxing.djinn"));
    }
}
