namespace djinnc;

struct GenericsSuite {
    public static unsafe void register(Verify* verify) {
        verify.test("generics/GenericConstraints.ParseWhereClauseSingleConstraint").compiles(Sources.file("tests/conformance/cases/generics/GenericConstraints.ParseWhereClauseSingleConstraint.djinn"));
        verify.test("generics/GenericConstraints.ParseWhereClauseMultipleConstraintsSameParam").compiles(Sources.file("tests/conformance/cases/generics/GenericConstraints.ParseWhereClauseMultipleConstraintsSameParam.djinn"));
        verify.test("generics/GenericConstraints.ParseWhereClauseMultipleParams").compiles(Sources.file("tests/conformance/cases/generics/GenericConstraints.ParseWhereClauseMultipleParams.djinn"));
        verify.test("generics/GenericConstraints.ParseWhereClauseOnInterface").compiles(Sources.file("tests/conformance/cases/generics/GenericConstraints.ParseWhereClauseOnInterface.djinn"));
        verify.test("generics/GenericConstraints.ConstraintSatisfied").runs(Sources.file("tests/conformance/cases/generics/GenericConstraints.ConstraintSatisfied.djinn"), Expected.exit(0));
        verify.test("generics/GenericConstraints.ConstraintViolated").diagnostics(Sources.file("tests/conformance/cases/generics/GenericConstraints.ConstraintViolated.djinn"), Expected.error(DiagnosticErrors.INTERFACE_NOT_IMPLEMENTED));
        verify.test("generics/GenericConstraints.NoConstraintNoValidation").runs(Sources.file("tests/conformance/cases/generics/GenericConstraints.NoConstraintNoValidation.djinn"), Expected.exit(0));
        verify.test("generics/GenericConstraints.MultipleConstraintsSatisfied").runs(Sources.file("tests/conformance/cases/generics/GenericConstraints.MultipleConstraintsSatisfied.djinn"), Expected.exit(0));
        verify.test("generics/GenericConstraints.MultipleConstraintsPartiallyViolated").diagnostics(Sources.file("tests/conformance/cases/generics/GenericConstraints.MultipleConstraintsPartiallyViolated.djinn"), Expected.error(DiagnosticErrors.INTERFACE_NOT_IMPLEMENTED));
        verify.test("generics/GenericConstraints.WhereClauseWithImplements").runs(Sources.file("tests/conformance/cases/generics/GenericConstraints.WhereClauseWithImplements.djinn"), Expected.exit(1));
        verify.test("generics/FullCompilation.StructGeneric").with_std().runs(Sources.file("tests/conformance/cases/generics/FullCompilation.StructGeneric.djinn"), Expected.exit(0));
        verify.test("generics/GenericStruct.TwoParameters").with_std().runs(Sources.file("tests/conformance/cases/generics/GenericStruct.TwoParameters.djinn"), Expected.exit(0));
        verify.test("generics/GenericStruct.ThreeParameters").with_std().runs(Sources.file("tests/conformance/cases/generics/GenericStruct.ThreeParameters.djinn"), Expected.exit(0));
        verify.test("generics/GenericStruct.FourParameters").with_std().runs(Sources.file("tests/conformance/cases/generics/GenericStruct.FourParameters.djinn"), Expected.exit(0));
        verify.test("generics/GenericStruct.MapEntry").with_std().runs(Sources.file("tests/conformance/cases/generics/GenericStruct.MapEntry.djinn"), Expected.exit(0));
        verify.test("generics/GenericStruct.TwoParametersWithInit").with_std().runs(Sources.file("tests/conformance/cases/generics/GenericStruct.TwoParametersWithInit.djinn"), Expected.exit(0));
        verify.test("generics/GenericStruct.TwoParametersFieldAccess").with_std().runs(Sources.file("tests/conformance/cases/generics/GenericStruct.TwoParametersFieldAccess.djinn"), Expected.exit(42));
        verify.test("generics/GenericStruct.TwoParametersSecondFieldAccess").with_std().runs(Sources.file("tests/conformance/cases/generics/GenericStruct.TwoParametersSecondFieldAccess.djinn"), Expected.exit(99));
        verify.test("generics/GenericStruct.MixedTypes").with_std().runs(Sources.file("tests/conformance/cases/generics/GenericStruct.MixedTypes.djinn"), Expected.exit(50));
        verify.test("generics/GenericStruct.PointerTypes").with_std().runs(Sources.file("tests/conformance/cases/generics/GenericStruct.PointerTypes.djinn"), Expected.exit(0));
        verify.test("generics/GenericStruct.MultipleInstantiations").with_std().runs(Sources.file("tests/conformance/cases/generics/GenericStruct.MultipleInstantiations.djinn"), Expected.exit(0));
        verify.test("generics/GenericStruct.NestedGenericStruct").with_std().runs(Sources.file("tests/conformance/cases/generics/GenericStruct.NestedGenericStruct.djinn"), Expected.exit(0));
        verify.test("generics/GenericStruct.FunctionReturningGenericStruct").with_std().runs(Sources.file("tests/conformance/cases/generics/GenericStruct.FunctionReturningGenericStruct.djinn"), Expected.exit(15));
        verify.test("generics/GenericStruct.GenericStructAsParameter").with_std().runs(Sources.file("tests/conformance/cases/generics/GenericStruct.GenericStructAsParameter.djinn"), Expected.exit(77));
        verify.test("generics/GenericStruct.ThreeParametersFieldSum").with_std().runs(Sources.file("tests/conformance/cases/generics/GenericStruct.ThreeParametersFieldSum.djinn"), Expected.exit(60));
        verify.test("generics/Interface.BasicDefinition").with_std().compiles(Sources.file("tests/conformance/cases/generics/Interface.BasicDefinition.djinn"));
        verify.test("generics/Interface.GenericInterface").with_std().compiles(Sources.file("tests/conformance/cases/generics/Interface.GenericInterface.djinn"));
        verify.test("generics/Interface.StructImplementsInterface").with_std().compiles(Sources.file("tests/conformance/cases/generics/Interface.StructImplementsInterface.djinn"));
        verify.test("generics/Interface.StructImplementsMultipleInterfaces").with_std().compiles(Sources.file("tests/conformance/cases/generics/Interface.StructImplementsMultipleInterfaces.djinn"));
    }
}
