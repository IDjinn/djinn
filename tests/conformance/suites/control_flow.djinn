namespace djinnc;

struct ControlFlowSuite {
    public static unsafe void register(Verify* verify) {
        verify.test("control_flow/ControlFlow.IfStatementTrueBranch").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.IfStatementTrueBranch.djinn"), Expected.exit(1));
        verify.test("control_flow/ControlFlow.IfStatementFalseBranch").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.IfStatementFalseBranch.djinn"), Expected.exit(0));
        verify.test("control_flow/ControlFlow.IfElseStatementTrueBranch").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.IfElseStatementTrueBranch.djinn"), Expected.exit(1));
        verify.test("control_flow/ControlFlow.IfElseStatementFalseBranch").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.IfElseStatementFalseBranch.djinn"), Expected.exit(2));
        verify.test("control_flow/ControlFlow.IfElseIfElseStatement").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.IfElseIfElseStatement.djinn"), Expected.exit(2));
        verify.test("control_flow/ControlFlow.NestedIfStatements").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.NestedIfStatements.djinn"), Expected.exit(1));
        verify.test("control_flow/ControlFlow.IfWithEquality").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.IfWithEquality.djinn"), Expected.exit(1));
        verify.test("control_flow/ControlFlow.IfWithNotEqual").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.IfWithNotEqual.djinn"), Expected.exit(1));
        verify.test("control_flow/ControlFlow.IfWithLogicalAnd").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.IfWithLogicalAnd.djinn"), Expected.exit(1));
        verify.test("control_flow/ControlFlow.IfWithLogicalOr").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.IfWithLogicalOr.djinn"), Expected.exit(1));
        verify.test("control_flow/ControlFlow.WhileLoopSimple").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.WhileLoopSimple.djinn"), Expected.exit(5));
        verify.test("control_flow/ControlFlow.WhileLoopSum").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.WhileLoopSum.djinn"), Expected.exit(15));
        verify.test("control_flow/ControlFlow.WhileLoopWithBreak").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.WhileLoopWithBreak.djinn"), Expected.exit(5));
        verify.test("control_flow/ControlFlow.WhileLoopWithContinue").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.WhileLoopWithContinue.djinn"), Expected.exit(9));
        verify.test("control_flow/ControlFlow.WhileLoopNeverExecutes").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.WhileLoopNeverExecutes.djinn"), Expected.exit(10));
        verify.test("control_flow/ControlFlow.DoWhileLoopSimple").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.DoWhileLoopSimple.djinn"), Expected.exit(5));
        verify.test("control_flow/ControlFlow.DoWhileExecutesAtLeastOnce").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.DoWhileExecutesAtLeastOnce.djinn"), Expected.exit(11));
        verify.test("control_flow/ControlFlow.DoWhileWithBreak").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.DoWhileWithBreak.djinn"), Expected.exit(3));
        verify.test("control_flow/ControlFlow.ForLoopSimple").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.ForLoopSimple.djinn"), Expected.exit(5));
        verify.test("control_flow/ControlFlow.ForLoopPostfix").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.ForLoopPostfix.djinn"), Expected.exit(5));
        verify.test("control_flow/ControlFlow.ForLoopSum").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.ForLoopSum.djinn"), Expected.exit(55));
        verify.test("control_flow/ControlFlow.ForLoopWithBreak").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.ForLoopWithBreak.djinn"), Expected.exit(5));
        verify.test("control_flow/ControlFlow.ForLoopWithContinue").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.ForLoopWithContinue.djinn"), Expected.exit(9));
        verify.test("control_flow/ControlFlow.ForLoopNested").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.ForLoopNested.djinn"), Expected.exit(9));
        verify.test("control_flow/ControlFlow.RangeForSimple").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.RangeForSimple.djinn"), Expected.exit(5));
        verify.test("control_flow/ControlFlow.RangeForSum").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.RangeForSum.djinn"), Expected.exit(55));
