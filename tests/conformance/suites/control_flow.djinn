        verify.test("control_flow/ControlFlow.RangeForWithContinue").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.RangeForWithContinue.djinn"), Expected.exit(9));
        verify.test("control_flow/ControlFlow.RangeForNested").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.RangeForNested.djinn"), Expected.exit(12));
        verify.test("control_flow/ControlFlow.RangeForVariableAccess").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.RangeForVariableAccess.djinn"), Expected.exit(6));
        verify.test("control_flow/ControlFlow.RangeForInclusiveEnd").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.RangeForInclusiveEnd.djinn"), Expected.exit(6));
        verify.test("control_flow/ControlFlow.RangeForInclusiveEndSum").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.RangeForInclusiveEndSum.djinn"), Expected.exit(55));
        verify.test("control_flow/ControlFlow.RangeForBracketClosed").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.RangeForBracketClosed.djinn"), Expected.exit(5));
        verify.test("control_flow/ControlFlow.RangeForBracketHalfOpen").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.RangeForBracketHalfOpen.djinn"), Expected.exit(4));
        verify.test("control_flow/ControlFlow.RangeForBracketClosedSum").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.RangeForBracketClosedSum.djinn"), Expected.exit(55));
        verify.test("control_flow/ControlFlow.SwitchStatementCase1").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.SwitchStatementCase1.djinn"), Expected.exit(10));
        verify.test("control_flow/ControlFlow.SwitchStatementCase2").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.SwitchStatementCase2.djinn"), Expected.exit(20));
        verify.test("control_flow/ControlFlow.SwitchStatementDefault").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.SwitchStatementDefault.djinn"), Expected.exit(0));
        verify.test("control_flow/ControlFlow.SwitchStatementWithBreak").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.SwitchStatementWithBreak.djinn"), Expected.exit(10));
        verify.test("control_flow/ControlFlow.SwitchStatementWithoutDefault").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.SwitchStatementWithoutDefault.djinn"), Expected.exit(10));
        verify.test("control_flow/ControlFlow.FibonacciIterative").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.FibonacciIterative.djinn"), Expected.exit(55));
        verify.test("control_flow/ControlFlow.FactorialIterative").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.FactorialIterative.djinn"), Expected.exit(120));
        verify.test("control_flow/ControlFlow.NestedLoopsWithBreak").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.NestedLoopsWithBreak.djinn"), Expected.exit(15));
        verify.test("control_flow/ControlFlow.WhileWithMultipleConditions").with_std().runs(Sources.file("tests/conformance/cases/control_flow/ControlFlow.WhileWithMultipleConditions.djinn"), Expected.exit(10));
        verify.test("control_flow/ErrorHandling.TryOnNonThrowingDiagnostic").with_std().diagnostics(Sources.file("tests/conformance/cases/control_flow/ErrorHandling.TryOnNonThrowingDiagnostic.djinn"), Expected.error(DiagnosticErrors.TRY_ON_NON_THROWING));
    }
