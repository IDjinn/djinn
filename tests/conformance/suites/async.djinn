namespace djinnc;

struct AsyncSuite {
    public static unsafe void register(Verify* verify) {
        verify.test("async/Async.SimpleReturnValue").with_std().runs(Sources.file("tests/conformance/cases/async/Async.SimpleReturnValue.djinn"), Expected.exit(42));
        verify.test("async/Async.WithParameter").with_std().runs(Sources.file("tests/conformance/cases/async/Async.WithParameter.djinn"), Expected.exit(42));
        verify.test("async/Async.MultipleParameters").with_std().runs(Sources.file("tests/conformance/cases/async/Async.MultipleParameters.djinn"), Expected.exit(42));
        verify.test("async/Async.ExpressionComputation").with_std().runs(Sources.file("tests/conformance/cases/async/Async.ExpressionComputation.djinn"), Expected.exit(21));
        verify.test("async/Async.AsyncMain").with_std().runs(Sources.file("tests/conformance/cases/async/Async.AsyncMain.djinn"), Expected.exit(99));
        verify.test("async/Async.AsyncMainWithComputation").with_std().runs(Sources.file("tests/conformance/cases/async/Async.AsyncMainWithComputation.djinn"), Expected.exit(25));
        verify.test("async/Async.MultipleAwaitsSequential").with_std().runs(Sources.file("tests/conformance/cases/async/Async.MultipleAwaitsSequential.djinn"), Expected.exit(30));
        verify.test("async/Async.ThreeAwaitsAccumulate").with_std().runs(Sources.file("tests/conformance/cases/async/Async.ThreeAwaitsAccumulate.djinn"), Expected.exit(60));
        verify.test("async/Async.ChainedAwait").with_std().runs(Sources.file("tests/conformance/cases/async/Async.ChainedAwait.djinn"), Expected.exit(15));
        verify.test("async/Async.DeepChaining").with_std().runs(Sources.file("tests/conformance/cases/async/Async.DeepChaining.djinn"), Expected.exit(13));
        verify.test("async/Async.ChainedAsyncMain").with_std().runs(Sources.file("tests/conformance/cases/async/Async.ChainedAsyncMain.djinn"), Expected.exit(35));
        verify.test("async/Async.AwaitResultAsArgument").with_std().runs(Sources.file("tests/conformance/cases/async/Async.AwaitResultAsArgument.djinn"), Expected.exit(20));
        verify.test("async/Async.AwaitWithLocalComputation").with_std().runs(Sources.file("tests/conformance/cases/async/Async.AwaitWithLocalComputation.djinn"), Expected.exit(33));
        verify.test("async/Async.NonAsyncMainStillWorks").with_std().runs(Sources.file("tests/conformance/cases/async/Async.NonAsyncMainStillWorks.djinn"), Expected.exit(77));
        verify.test("async/Spawn.MultipleSpawnsParse").with_std().compiles(Sources.file("tests/conformance/cases/async/Spawn.MultipleSpawnsParse.djinn"));
    }
}
