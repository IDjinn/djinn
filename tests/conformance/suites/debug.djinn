namespace djinnc;

struct DebugSuite {
    public static unsafe void register(Verify* verify) {
        verify.test("debug/enums:12").stops_at(Sources.file("tests/djinnc/debug/enums.djinn"), 12, Expected.contains("base = 11").and_contains("result = 33").and_contains("level = ").and_contains("weight"));
        verify.test("debug/locals:8").stops_at(Sources.file("tests/djinnc/debug/locals.djinn"), 8, Expected.contains("locals.djinn:8").and_contains("a = 3").and_contains("b = 4").and_contains("total = 7").and_contains("add(a=3, b=4)"));
        verify.test("debug/locals:14").stops_at(Sources.file("tests/djinnc/debug/locals.djinn"), 14, Expected.contains("r = 7").and_contains("x = 3").and_contains("y = 4").and_contains("main"));
        verify.test("debug/scopes:11").stops_at(Sources.file("tests/djinnc/debug/scopes.djinn"), 11, Expected.contains("inner = 14").and_contains("sum = 0").and_contains("current = 0x"));
        verify.test("debug/scopes:20").stops_at(Sources.file("tests/djinnc/debug/scopes.djinn"), 20, Expected.contains("value = 5").and_contains("value = 7").and_contains("next = NULL").and_contains("Node"));
        verify.test("debug/structs:8").stops_at(Sources.file("tests/djinnc/debug/structs.djinn"), 8, Expected.contains("x = 3").and_contains("y = 4").and_contains("result = 12").and_contains("Point"));
    }
}
