namespace djinnc;

struct MemorySuite {
    public static unsafe void register(Verify* verify) {
        verify.test("memory/Mutable.BasicMutableVariables").with_std().runs(Sources.file("tests/conformance/cases/memory/Mutable.BasicMutableVariables.djinn"), Expected.exit(2));
        verify.test("memory/Mutable.InvalidImmutableAssingment").with_std().diagnostics(Sources.file("tests/conformance/cases/memory/Mutable.InvalidImmutableAssingment.djinn"), Expected.error(DiagnosticErrors.ASSIGN_TO_IMMUTABLE));
        verify.test("memory/Ownership.CopyTypesDoNotMove").with_std().runs(Sources.file("tests/conformance/cases/memory/Ownership.CopyTypesDoNotMove.djinn"), Expected.exit(84));
        verify.test("memory/Ownership.FloatCopyTypes").with_std().runs(Sources.file("tests/conformance/cases/memory/Ownership.FloatCopyTypes.djinn"), Expected.exit(1));
        verify.test("memory/Ownership.PointerCopyTypes").with_std().runs(Sources.file("tests/conformance/cases/memory/Ownership.PointerCopyTypes.djinn"), Expected.exit(20));
        verify.test("memory/Ownership.StructMoveSemantics").with_std().runs(Sources.file("tests/conformance/cases/memory/Ownership.StructMoveSemantics.djinn"), Expected.exit(100));
        verify.test("memory/Ownership.UseAfterMove").with_std().diagnostics(Sources.file("tests/conformance/cases/memory/Ownership.UseAfterMove.djinn"), Expected.error(DiagnosticErrors.USE_AFTER_MOVE));
        verify.test("memory/Ownership.DoubleMoveError").with_std().diagnostics(Sources.file("tests/conformance/cases/memory/Ownership.DoubleMoveError.djinn"), Expected.error(DiagnosticErrors.USE_AFTER_MOVE));
        verify.test("memory/Ownership.ReinitializeAfterMove").with_std().runs(Sources.file("tests/conformance/cases/memory/Ownership.ReinitializeAfterMove.djinn"), Expected.exit(30));
        verify.test("memory/Ownership.ScopeOwnership").with_std().runs(Sources.file("tests/conformance/cases/memory/Ownership.ScopeOwnership.djinn"), Expected.exit(10));
        verify.test("memory/Ownership.NestedScopeOwnership").with_std().runs(Sources.file("tests/conformance/cases/memory/Ownership.NestedScopeOwnership.djinn"), Expected.exit(3));
        verify.test("memory/Ownership.FunctionParameterCopyType").with_std().runs(Sources.file("tests/conformance/cases/memory/Ownership.FunctionParameterCopyType.djinn"), Expected.exit(21));
        verify.test("memory/Ownership.IfStatementOwnership").with_std().runs(Sources.file("tests/conformance/cases/memory/Ownership.IfStatementOwnership.djinn"), Expected.exit(10));
        verify.test("memory/Ownership.WhileLoopOwnership").with_std().runs(Sources.file("tests/conformance/cases/memory/Ownership.WhileLoopOwnership.djinn"), Expected.exit(10));
        verify.test("memory/Ownership.ForLoopOwnership").with_std().runs(Sources.file("tests/conformance/cases/memory/Ownership.ForLoopOwnership.djinn"), Expected.exit(10));
    }
}
