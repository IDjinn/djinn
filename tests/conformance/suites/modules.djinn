namespace djinnc;

struct ModulesSuite {
    public static unsafe void register(Verify* verify) {
        verify.test("modules/Extern.PrintfHelloWorld").compiles(Sources.file("tests/conformance/cases/modules/Extern.PrintfHelloWorld.djinn"));
        verify.test("modules/Extern.BlockSyntax").compiles(Sources.file("tests/conformance/cases/modules/Extern.BlockSyntax.djinn"));
        verify.test("modules/Extern.MultipleExternBlocks").compiles(Sources.file("tests/conformance/cases/modules/Extern.MultipleExternBlocks.djinn"));
        verify.test("modules/Import.BasicImport").with_std().compiles(Sources.file("tests/conformance/cases/modules/Import.BasicImport.djinn"));
        verify.test("modules/Import.QualifiedImport").with_std().compiles(Sources.file("tests/conformance/cases/modules/Import.QualifiedImport.djinn"));
        verify.test("modules/Import.MultipleImports").with_std().compiles(Sources.file("tests/conformance/cases/modules/Import.MultipleImports.djinn"));
        verify.test("modules/Import.ImportParsesQualifiedName").with_std().compiles(Sources.file("tests/conformance/cases/modules/Import.ImportParsesQualifiedName.djinn"));
        verify.test("modules/Namespace.BasicDefinition").with_std().runs(Sources.file("tests/conformance/cases/modules/Namespace.BasicDefinition.djinn"), Expected.exit(0));
        verify.test("modules/Namespace.StructInNamespace").with_std().runs(Sources.file("tests/conformance/cases/modules/Namespace.StructInNamespace.djinn"), Expected.exit(0));
        verify.test("modules/Namespace.NestedNamespace").with_std().runs(Sources.file("tests/conformance/cases/modules/Namespace.NestedNamespace.djinn"), Expected.exit(0));
        verify.test("modules/Namespace.MultipleFunctionsInNamespace").with_std().runs(Sources.file("tests/conformance/cases/modules/Namespace.MultipleFunctionsInNamespace.djinn"), Expected.exit(0));
        verify.test("modules/Namespace.StructAndFunctionInNamespace").with_std().runs(Sources.file("tests/conformance/cases/modules/Namespace.StructAndFunctionInNamespace.djinn"), Expected.exit(0));
        verify.test("modules/Namespace.FileScopedNamespace").with_std().runs(Sources.file("tests/conformance/cases/modules/Namespace.FileScopedNamespace.djinn"), Expected.exit(0));
        verify.test("modules/Namespace.FileScopedQualifiedNamespace").with_std().runs(Sources.file("tests/conformance/cases/modules/Namespace.FileScopedQualifiedNamespace.djinn"), Expected.exit(0));
        verify.test("modules/Namespace.NoNamespaceIsGlobal").with_std().runs(Sources.file("tests/conformance/cases/modules/Namespace.NoNamespaceIsGlobal.djinn"), Expected.exit(0));
    }
}
