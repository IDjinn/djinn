namespace djinnc;

struct HelloTests {
    [Test]
    void World() {
        str source = """
extern "C" {
    i32 printf(i8* format, ...);
}

void main() {
    printf("hello world!");
}
""";
        Verify.source(source).with_std().compiles();
    }
}

struct HelloWorldSuite {
    public static unsafe void register(Verify* verify) {
        verify.suite(typeof(HelloTests));
    }
}
