namespace djinnc;

struct TypesSuite {
    public static unsafe void register(Verify* verify) {
        verify.test("types/AddressOf.StructLocalComparesWithItsPointer").runs(Sources.file("tests/conformance/cases/types/AddressOf.StructLocalComparesWithItsPointer.djinn"), Expected.exit(7));
        verify.test("types/AddressOf.IntegerLocalDereferencesToItsValue").runs(Sources.file("tests/conformance/cases/types/AddressOf.IntegerLocalDereferencesToItsValue.djinn"), Expected.exit(5));
        verify.test("types/Cast.IntTruncation").runs(Sources.file("tests/conformance/cases/types/Cast.IntTruncation.djinn"), Expected.exit(42));
        verify.test("types/Cast.IntWidening").runs(Sources.file("tests/conformance/cases/types/Cast.IntWidening.djinn"), Expected.exit(7));
        verify.test("types/Cast.FloatToInt").runs(Sources.file("tests/conformance/cases/types/Cast.FloatToInt.djinn"), Expected.exit(3));
        verify.test("types/Cast.IntToFloat").runs(Sources.file("tests/conformance/cases/types/Cast.IntToFloat.djinn"), Expected.exit(5));
        verify.test("types/Cast.ChainedCast").runs(Sources.file("tests/conformance/cases/types/Cast.ChainedCast.djinn"), Expected.exit(100));
        verify.test("types/Cast.SameTypeCastNoop").runs(Sources.file("tests/conformance/cases/types/Cast.SameTypeCastNoop.djinn"), Expected.exit(99));
        verify.test("types/Cast.CastInExpression").runs(Sources.file("tests/conformance/cases/types/Cast.CastInExpression.djinn"), Expected.exit(13));
        verify.test("types/Cast.FloatTruncation").runs(Sources.file("tests/conformance/cases/types/Cast.FloatTruncation.djinn"), Expected.exit(2));
        verify.test("types/Cast.PointerCast").runs(Sources.file("tests/conformance/cases/types/Cast.PointerCast.djinn"), Expected.exit(42));
        verify.test("types/Cast.CastLiteral").runs(Sources.file("tests/conformance/cases/types/Cast.CastLiteral.djinn"), Expected.exit(3));
        verify.test("types/Cast.NegativeFloatToInt").runs(Sources.file("tests/conformance/cases/types/Cast.NegativeFloatToInt.djinn"), Expected.exit(9));
        verify.test("types/ConstField.BasicConstFieldStaticAccess").with_std().runs(Sources.file("tests/conformance/cases/types/ConstField.BasicConstFieldStaticAccess.djinn"), Expected.exit(100));
        verify.test("types/ConstField.ConstFieldUsedInStaticMethod").with_std().runs(Sources.file("tests/conformance/cases/types/ConstField.ConstFieldUsedInStaticMethod.djinn"), Expected.exit(0));
        verify.test("types/ConstField.ConstFieldWithPublicModifier").with_std().runs(Sources.file("tests/conformance/cases/types/ConstField.ConstFieldWithPublicModifier.djinn"), Expected.exit(42));
        verify.test("types/ConstField.ConstFieldDoesNotAffectStructLayout").with_std().runs(Sources.file("tests/conformance/cases/types/ConstField.ConstFieldDoesNotAffectStructLayout.djinn"), Expected.exit(20));
        verify.test("types/ConstField.ConstFieldNegativeValue").with_std().runs(Sources.file("tests/conformance/cases/types/ConstField.ConstFieldNegativeValue.djinn"), Expected.exit(9));
        verify.test("types/ConstField.ConstFieldWithoutInitializerError").with_std().diagnostics(Sources.file("tests/conformance/cases/types/ConstField.ConstFieldWithoutInitializerError.djinn"), Expected.error(DiagnosticErrors.UNEXPECTED_TOKEN));
        verify.test("types/ConstField.MultipleConstFields").with_std().runs(Sources.file("tests/conformance/cases/types/ConstField.MultipleConstFields.djinn"), Expected.exit(3));
        verify.test("types/ConstField.ConstFieldWithMixedRegularFields").with_std().runs(Sources.file("tests/conformance/cases/types/ConstField.ConstFieldWithMixedRegularFields.djinn"), Expected.exit(100));
        verify.test("types/IsExpression.ObjectIsI32True").with_std().runs(Sources.file("tests/conformance/cases/types/IsExpression.ObjectIsI32True.djinn"), Expected.exit(1));
        verify.test("types/IsExpression.ObjectIsI32False").with_std().runs(Sources.file("tests/conformance/cases/types/IsExpression.ObjectIsI32False.djinn"), Expected.exit(0));
        verify.test("types/IsExpression.ObjectIsF64").with_std().runs(Sources.file("tests/conformance/cases/types/IsExpression.ObjectIsF64.djinn"), Expected.exit(1));
        verify.test("types/IsExpression.NegatedIsExpression").with_std().runs(Sources.file("tests/conformance/cases/types/IsExpression.NegatedIsExpression.djinn"), Expected.exit(1));
        verify.test("types/IsExpression.ErrorOnNonObjectOperand").with_std().diagnostics(Sources.file("tests/conformance/cases/types/IsExpression.ErrorOnNonObjectOperand.djinn"), Expected.error(DiagnosticErrors.INVALID_IS_OPERAND));
        verify.test("types/IsExpression.BindingExtractsI32Value").with_std().runs(Sources.file("tests/conformance/cases/types/IsExpression.BindingExtractsI32Value.djinn"), Expected.exit(42));
        verify.test("types/IsExpression.BindingNotUsedWhenTypeMismatch").with_std().runs(Sources.file("tests/conformance/cases/types/IsExpression.BindingNotUsedWhenTypeMismatch.djinn"), Expected.exit(-1));
        verify.test("types/IsExpression.BindingWithDifferentTypes").with_std().runs(Sources.file("tests/conformance/cases/types/IsExpression.BindingWithDifferentTypes.djinn"), Expected.exit(99));
        verify.test("types/NativeTypes.DeclarationsCompile").with_std().compiles(Sources.file("tests/conformance/cases/types/NativeTypes.DeclarationsCompile.djinn"));
        verify.test("types/NativeTypes.NintMixesWithI64").with_std().compiles(Sources.file("tests/conformance/cases/types/NativeTypes.NintMixesWithI64.djinn"));
        verify.test("types/NativeTypes.NintNegation").with_std().runs(Sources.file("tests/conformance/cases/types/NativeTypes.NintNegation.djinn"), Expected.exit(5));
        verify.test("types/NativeTypes.NintAsFunctionSignature").with_std().runs(Sources.file("tests/conformance/cases/types/NativeTypes.NintAsFunctionSignature.djinn"), Expected.exit(42));
        verify.test("types/NativeTypes.NfloatNdoubleArithmetic").with_std().compiles(Sources.file("tests/conformance/cases/types/NativeTypes.NfloatNdoubleArithmetic.djinn"));
        verify.test("types/NonZero.DeclarationsCompile").with_std().compiles(Sources.file("tests/conformance/cases/types/NonZero.DeclarationsCompile.djinn"));
        verify.test("types/NonZero.ExplicitCastIsTrusted").with_std().compiles(Sources.file("tests/conformance/cases/types/NonZero.ExplicitCastIsTrusted.djinn"));
        verify.test("types/NonZero.CombinesWithOverflowSuffix").with_std().compiles(Sources.file("tests/conformance/cases/types/NonZero.CombinesWithOverflowSuffix.djinn"));
        verify.test("types/NonZero.DivisionByNonZeroRuns").with_std().runs(Sources.file("tests/conformance/cases/types/NonZero.DivisionByNonZeroRuns.djinn"), Expected.exit(10));
        verify.test("types/NonZero.NonZeroParamCallWithNonZeroConstantCompiles").with_std().compiles(Sources.file("tests/conformance/cases/types/NonZero.NonZeroParamCallWithNonZeroConstantCompiles.djinn"));
        verify.test("types/NonZero.EntryCheckTrapsAtRuntime").with_std().runs(Sources.file("tests/conformance/cases/types/NonZero.EntryCheckTrapsAtRuntime.djinn"), Expected.failure());
        verify.test("types/Nullable.CastIntegerToPointerNoWarning").compiles(Sources.file("tests/conformance/cases/types/Nullable.CastIntegerToPointerNoWarning.djinn"));
        verify.test("types/PointerCompat.VoidToTyped").with_std().compiles(Sources.file("tests/conformance/cases/types/PointerCompat.VoidToTyped.djinn"));
        verify.test("types/PointerCompat.TypedToVoid").with_std().compiles(Sources.file("tests/conformance/cases/types/PointerCompat.TypedToVoid.djinn"));
        verify.test("types/PointerCompat.IncompatibleTypesHumanReadableMessage").with_std().compiles(Sources.file("tests/conformance/cases/types/PointerCompat.IncompatibleTypesHumanReadableMessage.djinn"));
        verify.test("types/PointerCompat.SameType").with_std().compiles(Sources.file("tests/conformance/cases/types/PointerCompat.SameType.djinn"));
        verify.test("types/PointerField.ComparesWithLocalInsideNamespace").runs(Sources.file("tests/conformance/cases/types/PointerField.ComparesWithLocalInsideNamespace.djinn"), Expected.exit(1));
        verify.test("types/UnsignedCompare.OrderingUsesUnsignedPredicates").runs(Sources.file("tests/conformance/cases/types/UnsignedCompare.OrderingUsesUnsignedPredicates.djinn"), Expected.exit(1));
        verify.test("types/UnsignedCompare.CastWidensWithZeroExtension").runs(Sources.file("tests/conformance/cases/types/UnsignedCompare.CastWidensWithZeroExtension.djinn"), Expected.exit(1));
        verify.test("types/UnsignedCompare.SignedStillOrdersNegatives").runs(Sources.file("tests/conformance/cases/types/UnsignedCompare.SignedStillOrdersNegatives.djinn"), Expected.exit(1));
    }
}
