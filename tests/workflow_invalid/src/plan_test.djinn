import testing;

struct Token {
    i32 value;
}

struct Broken {
    [Test]
    Token issue() {
        Token token = { .value = 1 };
        return token;
    }

    [Test]
    void use_token(Token token) {
        Expect.equal(1, (i64)token.value);
    }

    void helper() {
    }
}

i32 main() {
    TestPlan* plan = TestPlan.discover();
    plan.workflow("early").step(typeof(Broken.use_token)).step(typeof(Broken.issue));
    plan.workflow("helper").step(typeof(Broken.issue)).step(typeof(Broken.helper));
    return plan.run();
}
