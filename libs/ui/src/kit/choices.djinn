import std::types;

namespace ui;

// Helpers for a list of choices: an array (["One", "Two"], built once) or one string, "One|Two|Three".
struct Choices {
    public static u32 count(str[] choices) {
        return choices.length;
    }

    public static str nth(str[] choices, i32 index) {
        if (index < 0 || (u32)index >= choices.length) {
            return "";
        }
        return choices[(u32)index];
    }

    public static unsafe u32 count(str options) {
        if (options.length == 0) {
            return 0;
        }
        mut u32 total = 1;
        mut u32 i = 0;
        while (i < (u32)options.length) {
            if (*(options.data + i) == (i8)124) {
                total = total + 1;
            }
            i = i + 1;
        }
        return total;
    }

    // The choice at index (empty when out of range); it points into the options, nothing is copied.
    public static unsafe str nth(str options, i32 index) {
        mut u32 start = 0;
        mut i32 seen = 0;
        mut u32 i = 0;
        while (i <= (u32)options.length) {
            if (i == (u32)options.length || *(options.data + i) == (i8)124) {
                if (seen == index) {
                    str found = { .data = options.data + (size_long)start, .length = (size)(i - start) };
                    return found;
                }
                seen = seen + 1;
                start = i + 1;
            }
            i = i + 1;
        }
        str none = { .data = options.data, .length = 0 };
        return none;
    }

    // The part of "path=Label" before or after the equals sign.
    public static unsafe str side(str route, bool before) {
        mut u32 split = (u32)route.length;
        mut u32 i = 0;
        while (i < (u32)route.length) {
            if (*(route.data + i) == (i8)61) {
                split = i;
                i = (u32)route.length;
            } else {
                i = i + 1;
            }
        }
        if (before) {
            str head = { .data = route.data, .length = (size)split };
            return head;
        }
        mut u32 from = split + 1;
        if (from > (u32)route.length) {
            from = (u32)route.length;
        }
        str tail = { .data = route.data + (size_long)from, .length = (size)((u32)route.length - from) };
        return tail;
    }
}
