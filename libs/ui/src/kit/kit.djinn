import std::types;
import std::libc;

namespace ui;

// Small helpers for the kit components below.
struct Kit {
    // "true" / "false" for the aria and data attributes the theme styles.
    public static str flag(bool on) {
        if (on) {
            return "true";
        }
        return "false";
    }

    public static str mark(bool on) {
        if (on) {
            return "✓";
        }
        return "";
    }
}

// A button. 'variant' is "primary", "danger" or "" (the default look); the click runs 'on_click'.
struct Button {
    str label;
    str variant;
    fn() -> void on_click;

    public unsafe Node render() {
        return html!{ <button class={this.variant} on_click={() => this.on_click()}>{this.label}</button> };
    }
}

// An on / off switch bound to a signal. Space or Enter toggle it when focused.
struct Switch {
    str label;
    signal<bool> on;

    public unsafe Node render() {
        return html!{
            <button class="switch" role="switch" aria-checked={Kit.flag(this.on.get())}
                    on_click={() => this.on.set(!this.on.get())}>
                <span class="switch-track"><span class="switch-thumb"></span></span>
                {this.label}
            </button>
        };
    }
}

// A checkbox bound to a signal.
struct Checkbox {
    str label;
    signal<bool> checked;

    public unsafe Node render() {
        return html!{
            <button class="check" role="checkbox" aria-checked={Kit.flag(this.checked.get())}
                    on_click={() => this.checked.set(!this.checked.get())}>
                <span class="check-box">{Kit.mark(this.checked.get())}</span>
                {this.label}
            </button>
        };
    }
}

// One tab of a tab list; 'active' holds the index of the selected tab.
struct Tab {
    str label;
    i32 index;
    signal<i32> active;

    public unsafe Node render() {
        return html!{
            <button class="tab" role="tab" aria-selected={Kit.flag(this.active.get() == this.index)}
                    on_click={() => this.active.set(this.index)}>{this.label}</button>
        };
    }
}

// The content shown while its tab is the active one.
struct TabPanel {
    i32 index;
    signal<i32> active;
    Node children;

    public unsafe Node render() {
        return html!{
            <div class="tab-panel" role="tabpanel" data-active={Kit.flag(this.active.get() == this.index)}>
                {this.children}
            </div>
        };
    }
}
