import std::types;

namespace ui;

// Escape closes a popup; choosing or picking closes it too.
struct Popup {
    public static str caret() {
        return "▾";
    }

    public static unsafe void close_on_escape(signal<bool> open) {
        if (Input.key() == Key.ESCAPE) {
            open.set(false);
        }
    }

    public static unsafe void choose(signal<i32> index, signal<bool> open, i32 value) {
        index.set(value);
        open.set(false);
    }

    // The text of a menu button: the picked item, or the label when the menu keeps it (or nothing is picked yet).
    public static unsafe str caption(str label, str items, i32 chosen, bool keep_label) {
        if (!keep_label && chosen >= 0) {
            return Choices.nth(items, chosen);
        }
        return label;
    }
}
