import std::types;
import std::libc;

namespace ui;

// A growable list of u32 handles with manual storage, so it stays trivial and fits in the graph's flat arrays.
struct IdList {
    mut u32* data;
    mut u32 count;
    mut u32 capacity;

    public static unsafe IdList create() {
        IdList list = { .data = (u32*)0, .count = 0, .capacity = 0 };
        return list;
    }

    public unsafe void push(u32 id) {
        if (this.count == this.capacity) {
            mut u32 grown = this.capacity * 2;
            if (grown < 4) {
                grown = 4;
            }
            this.data = (u32*)__djinn_realloc((void*)this.data, (size_long)((u64)grown * 4));
            this.capacity = grown;
        }
        *(this.data + (this.count)) = id;
        this.count = this.count + 1;
    }

    public unsafe u32 get(u32 index) {
        return *(this.data + (index));
    }

    public unsafe bool contains(u32 id) {
        for (mut u32 i = 0; i < this.count; i = i + 1) {
            if (*(this.data + (i)) == id) {
                return true;
            }
        }
        return false;
    }

    public unsafe void remove(u32 id) {
        for (mut u32 i = 0; i < this.count; i = i + 1) {
            if (*(this.data + (i)) == id) {
                *(this.data + (i)) = *(this.data + (this.count - 1));
                this.count = this.count - 1;
                return;
            }
        }
    }

    public unsafe u32 pop() {
        this.count = this.count - 1;
        return *(this.data + (this.count));
    }

    public void clear() {
        this.count = 0;
    }

    public unsafe void release() {
        if (this.data != (u32*)0) {
            __djinn_free((void*)this.data);
        }
        this.data = (u32*)0;
        this.count = 0;
        this.capacity = 0;
    }
}
