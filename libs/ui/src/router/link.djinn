import std::types;

namespace ui;

// A link that navigates inside the app: Enter or a click on it goes to 'to' without leaving the page.
// 'prefetch' chooses when the page behind it is prepared (see Prefetch): "" or "hover" when the pointer arrives or
// the link gets focus, "eager" as soon as the link is shown, "off" never.
struct Link {
    str to;
    str label;
    str prefetch;

    public static unsafe void warm(str to, str mode) {
        if (mode == "off") {
            return;
        }
        Prefetch.request(to);
    }

    public unsafe Node render() {
        if (this.prefetch == "eager") {
            Prefetch.request(this.to);
        }
        return html!{
            <a href={this.to} on_click={() => Router.navigate(this.to)}
               on_pointerenter={() => Link.warm(this.to, this.prefetch)}
               on_focus={() => Link.warm(this.to, this.prefetch)}>{this.label}</a>
        };
    }
}
