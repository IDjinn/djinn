import std::types;
import std::libc;
import std::math;

namespace ui;

unsafe static mut bool display_squircle = false;

// One corner of a triangle: position in px, the atlas coordinate (0..1) it samples and its color (straight alpha,
// R in the lowest byte, which is what the GPU reads as R8G8B8A8). The final pixel is 'color * atlas(u, v)', so a
// plain shape samples the solid block of the atlas and a glyph its coverage.
struct mut Vertex {
    f32 x;
    f32 y;
    f32 u;
    f32 v;
    u32 color;
}

// What the painter produces and a renderer consumes: a flat list of triangles in paint order. The same list feeds
// the Vulkan renderer and the software rasterizer, so they draw the same frame.
struct mut DisplayList {
    Vertex* vertices;
    u32 count;
    u32 capacity;
    f32 clip_left;
    f32 clip_top;
    f32 clip_right;
    f32 clip_bottom;
    f32* scratch;
    f32* clip_stack;
    u32 clip_depth;
    f32 shift_x;
    f32 shift_y;
    Vertex* spare;
    u32 spare_capacity;

    public static unsafe DisplayList create() {
        DisplayList list = { .vertices = (Vertex*)0, .count = 0, .capacity = 0, .clip_left = (f32)-1000000.0, .clip_top = (f32)-1000000.0,
            .clip_right = (f32)1000000.0, .clip_bottom = (f32)1000000.0, .scratch = (f32*)0, .clip_stack = (f32*)0, .clip_depth = 0,
            .shift_x = (f32)0.0, .shift_y = (f32)0.0, .spare = (Vertex*)0, .spare_capacity = 0 };
        list.scratch = (f32*)__djinn_alloc_zeroed((size_long)(4096 * sizeof(f32)));
        list.clip_stack = (f32*)__djinn_alloc_zeroed((size_long)(4 * DisplayList.MAX_CLIPS * sizeof(f32)));
        return list;
    }

    public unsafe void release() {
        __djinn_free((void*)this.vertices);
        __djinn_free((void*)this.scratch);
        __djinn_free((void*)this.clip_stack);
        __djinn_free((void*)this.spare);
        this.spare = (Vertex*)0;
        this.spare_capacity = 0;
        this.clip_stack = (f32*)0;
        this.vertices = (Vertex*)0;
        this.scratch = (f32*)0;
        this.count = 0;
        this.capacity = 0;
    }

    public unsafe void clear() {
        this.count = 0;
        this.clip_left = (f32)-1000000.0;
        this.clip_top = (f32)-1000000.0;
        this.clip_right = (f32)1000000.0;
        this.clip_bottom = (f32)1000000.0;
        this.shift_x = (f32)0.0;
        this.shift_y = (f32)0.0;
    }

    // Everything drawn after this moves by (dx, dy): how a scroll container moves its content. Clips set before it
    // stay where they are; unshift undoes it.
    public unsafe void shift(f32 dx, f32 dy) {
        this.shift_x = this.shift_x + dx;
        this.shift_y = this.shift_y + dy;
    }

    unsafe void reserve(u32 extra) {
        u32 needed = this.count + extra;
        if (needed <= this.capacity) {
            return;
        }
        mut u32 grown = this.capacity * 2;
        if (grown < 1024) {
            grown = 1024;
        }
        if (grown < needed) {
            grown = needed;
        }
        this.vertices = (Vertex*)__djinn_realloc((void*)this.vertices, (size_long)(grown * sizeof(Vertex)));
        this.capacity = grown;
    }

    // Straight alpha in the byte order the GPU reads: 0xRRGGBBAA to A B G R from the top byte down, scaled by 'alpha'.
    public static u32 gpu_color(u32 rgba, f32 alpha) {
        u32 r = (rgba >> 24) & 255;
        u32 g = (rgba >> 16) & 255;
        u32 b = (rgba >> 8) & 255;
        mut f32 a = (f32)(rgba & 255) * alpha;
        if (a > (f32)255.0) {
            a = (f32)255.0;
        }
        if (a < (f32)0.0) {
            a = (f32)0.0;
        }
        return r | (g << 8) | (b << 16) | ((u32)(a + (f32)0.5) << 24);
    }

    // The color with its alpha multiplied by 'factor' (0..1), alpha being the top byte of a GPU color.
    public static u32 fade(u32 color, f32 factor) {
        mut f32 a = (f32)(color >> 24) * factor;
        if (a > (f32)255.0) {
            a = (f32)255.0;
        }
        return (color & 0x00FFFFFF) | ((u32)(a + (f32)0.5) << 24);
    }

    public unsafe void push(f32 x, f32 y, f32 u, f32 v, u32 color) {
        this.reserve(1);
        Vertex* vertex = &this.vertices[this.count];
        vertex.x = x;
        vertex.y = y;
        vertex.u = u;
        vertex.v = v;
        vertex.color = color;
        this.count = this.count + 1;
    }

    // Scales the vertices from 'first' on around (center_x, center_y) and then moves them by (dx, dy): what a CSS
    // transform does to the geometry an element (and its children) just drew.
    public unsafe void transform(u32 first, f32 center_x, f32 center_y, f32 scale, f32 dx, f32 dy) {
        this.transform_turned(first, center_x, center_y, scale, dx, dy, (f32)0.0);
    }

    // The same with a rotation of 'degrees' (clockwise, as in CSS) around the center.
    public unsafe void transform_turned(u32 first, f32 center_x, f32 center_y, f32 scale, f32 dx, f32 dy, f32 degrees) {
        mut f32 sine = (f32)0.0;
        mut f32 cosine = (f32)1.0;
        if (degrees != (f32)0.0) {
            f32 radians = degrees * (f32)0.017453292519943295;
            sine = Math.sin(radians);
            cosine = Math.cos(radians);
        }
        mut u32 i = first;
        while (i < this.count) {
            Vertex* vertex = &this.vertices[i];
            f32 ox = (vertex.x - center_x) * scale;
            f32 oy = (vertex.y - center_y) * scale;
            vertex.x = center_x + ox * cosine - oy * sine + dx;
            vertex.y = center_y + ox * sine + oy * cosine + dy;
            i = i + 1;
        }
    }

    // The solid block of the atlas: the center of its 2x2 pixels.
    public static f32 solid_u() {
        return (f32)1.0 / (f32)Fonts.ATLAS;
    }

    const u32 MAX_CLIPS = 64;

    // Narrows the clip rectangle to the given one (and the old clip); restore_clip undoes it after the subtree.
    public unsafe void clip_to(f32 x0, f32 y0, f32 x1, f32 y1) {
        if (this.clip_depth >= DisplayList.MAX_CLIPS) {
            return;
        }
        f32 left = x0 + this.shift_x;
        f32 top = y0 + this.shift_y;
        f32 right = x1 + this.shift_x;
        f32 bottom = y1 + this.shift_y;
        f32* saved = &this.clip_stack[this.clip_depth * 4];
        this.clip_depth = this.clip_depth + 1;
        saved[0] = this.clip_left;
        saved[1] = this.clip_top;
        saved[2] = this.clip_right;
        saved[3] = this.clip_bottom;
        if (left > this.clip_left) {
            this.clip_left = left;
        }
        if (top > this.clip_top) {
            this.clip_top = top;
        }
        if (right < this.clip_right) {
            this.clip_right = right;
        }
        if (bottom < this.clip_bottom) {
            this.clip_bottom = bottom;
        }
    }

    public unsafe void restore_clip() {
        if (this.clip_depth == 0) {
            return;
        }
        this.clip_depth = this.clip_depth - 1;
        f32* saved = &this.clip_stack[this.clip_depth * 4];
        this.clip_left = saved[0];
        this.clip_top = saved[1];
        this.clip_right = saved[2];
        this.clip_bottom = saved[3];
    }

    // Two triangles for the rectangle [x0,x1] x [y0,y1] sampling the atlas rectangle [u0,u1] x [v0,v1], cut to the
    // clip rectangle (the atlas coordinates are cut with it).
    public unsafe void quad(f32 x0, f32 y0, f32 x1, f32 y1, f32 u0, f32 v0, f32 u1, f32 v1, u32 color) {
        this.quad_at(x0 + this.shift_x, y0 + this.shift_y, x1 + this.shift_x, y1 + this.shift_y, u0, v0, u1, v1, color);
    }

    unsafe void quad_at(f32 x0, f32 y0, f32 x1, f32 y1, f32 u0, f32 v0, f32 u1, f32 v1, u32 color) {
        mut f32 left = x0;
        mut f32 top = y0;
        mut f32 right = x1;
        mut f32 bottom = y1;
        mut f32 ul = u0;
        mut f32 vt = v0;
        mut f32 ur = u1;
        mut f32 vb = v1;
        f32 width = x1 - x0;
        f32 height = y1 - y0;
        if (width <= (f32)0.0 || height <= (f32)0.0) {
            return;
        }
        if (left < this.clip_left) {
            ul = ul + (u1 - u0) * (this.clip_left - x0) / width;
            left = this.clip_left;
        }
        if (right > this.clip_right) {
            ur = ur - (u1 - u0) * (x1 - this.clip_right) / width;
            right = this.clip_right;
        }
        if (top < this.clip_top) {
            vt = vt + (v1 - v0) * (this.clip_top - y0) / height;
            top = this.clip_top;
        }
        if (bottom > this.clip_bottom) {
            vb = vb - (v1 - v0) * (y1 - this.clip_bottom) / height;
            bottom = this.clip_bottom;
        }
        if (left >= right || top >= bottom) {
            return;
        }
        this.reserve(6);
        this.push(left, top, ul, vt, color);
        this.push(right, top, ur, vt, color);
        this.push(left, bottom, ul, vb, color);
        this.push(right, top, ur, vt, color);
        this.push(right, bottom, ur, vb, color);
        this.push(left, bottom, ul, vb, color);
    }

    // A solid rectangle, edges snapped to whole pixels so neighbours meet without seams.
    public unsafe void fill(f32 x, f32 y, f32 width, f32 height, u32 color) {
        if ((color >> 24) == 0) {
            return;
        }
        f32 u = DisplayList.solid_u();
        f32 x0 = Math.round(x);
        f32 y0 = Math.round(y);
        f32 x1 = Math.round(x + width);
        f32 y1 = Math.round(y + height);
        this.quad_at(x0 + this.shift_x, y0 + this.shift_y, x1 + this.shift_x, y1 + this.shift_y, u, u, u, u, color);
    }

    // One point of a rounded rectangle outline moved 'grow' px outward, walking clockwise from the top-left corner;
    // 'index' counts 0 .. 4 * (SEGMENTS + 1) - 1. Writes x and y into out[0], out[1].
    // Corners drawn from here on are squircles (continuous corners, as Apple draws them) instead of circular arcs.
    public static unsafe void squircle(bool on) {
        display_squircle = on;
    }

    // The value of a point on a superellipse of exponent 5 (the curve Apple's continuous corners follow closely): the
    // cosine or sine of the angle, pushed out so the corner is fuller than a circle and joins the straight edge gently.
    static f32 fuller(f32 v) {
        mut f32 magnitude = v;
        if (magnitude < (f32)0.0) {
            magnitude = (f32)0.0 - magnitude;
        }
        f32 shaped = (f32)Math.pow((f64)magnitude, 0.4);
        if (v < (f32)0.0) {
            return (f32)0.0 - shaped;
        }
        return shaped;
    }

    static unsafe void outline_point(f32 x, f32 y, f32 width, f32 height, f32 radius, f32 grow, u32 index, f32* out) {
        u32 per_corner = DisplayList.SEGMENTS + 1;
        u32 corner = index / per_corner;
        u32 step = index % per_corner;
        mut f32 base = radius;
        if (display_squircle) {
            // a continuous corner spans a little more of each edge than a circular one of the same radius
            f32 reach = base * (f32)1.25;
            f32 half = Px.min(width, height) / (f32)2.0;
            if (reach > half) {
                base = half;
            } else {
                base = reach;
            }
        }
        mut f32 r = base + grow;
        if (r < (f32)0.0) {
            r = (f32)0.0;
        }
        f32 left = x - grow;
        f32 top = y - grow;
        f32 right = x + width + grow;
        f32 bottom = y + height + grow;
        mut f32 cx = left + r;
        mut f32 cy = top + r;
        mut f32 start = (f32)3.14159265;
        if (corner == 1) {
            cx = right - r;
            start = (f32)4.71238898;
        } else if (corner == 2) {
            cx = right - r;
            cy = bottom - r;
            start = (f32)0.0;
        } else if (corner == 3) {
            cy = bottom - r;
            start = (f32)1.57079633;
        }
        f32 angle = start + (f32)1.57079633 * (f32)step / (f32)DisplayList.SEGMENTS;
        mut f32 across = Math.cos(angle);
        mut f32 down = Math.sin(angle);
        if (display_squircle) {
            across = DisplayList.fuller(across);
            down = DisplayList.fuller(down);
        }
        out[0] = cx + r * across;
        out[1] = cy + r * down;
    }

    const u32 SEGMENTS = 8;

    // Cuts the triangles drawn since 'first' to the clip rectangle. A quad is cut as it is made; the rounded shapes and
    // rings are many triangles, and one that crosses the clip would otherwise be drawn whole (over the system bars of
    // a phone, where the page is moved inside them, or outside a scroll container).
    unsafe void clip_from(u32 first) {
        mut bool inside = true;
        for (mut u32 i = first; i < this.count && inside; i = i + 1) {
            Vertex* vertex = &this.vertices[i];
            if (vertex.x < this.clip_left || vertex.x > this.clip_right || vertex.y < this.clip_top || vertex.y > this.clip_bottom) {
                inside = false;
            }
        }
        if (inside) {
            return;
        }
        u32 total = this.count - first;
        u32 needed = total + 16;
        if (this.spare_capacity < needed) {
            this.spare = (Vertex*)__djinn_realloc((void*)this.spare, (size_long)(needed * sizeof(Vertex)));
            this.spare_capacity = needed;
        }
        Vertex* work = this.spare;
        Vertex* source = &this.spare[16];
        memcpy((void*)source, (void*)&this.vertices[first], (size_long)(total * sizeof(Vertex)));
        this.count = first;
        for (mut u32 t = 0; t + 2 < total; t = t + 3) {
            this.clip_triangle(&source[t], work);
        }
    }

    unsafe void clip_triangle(Vertex* triangle, Vertex* work) {
        Vertex* first = work;
        Vertex* second = &work[8];
        for (mut u32 k = 0; k < 3; k = k + 1) {
            DisplayList.copy_vertex(&first[k], &triangle[k]);
        }
        mut u32 count = DisplayList.clip_edge(first, 3, second, 0, this.clip_left, true);
        if (count > 0) {
            count = DisplayList.clip_edge(second, count, first, 0, this.clip_right, false);
        }
        if (count > 0) {
            count = DisplayList.clip_edge(first, count, second, 1, this.clip_top, true);
        }
        if (count > 0) {
            count = DisplayList.clip_edge(second, count, first, 1, this.clip_bottom, false);
        }
        for (mut u32 i = 1; i + 1 < count; i = i + 1) {
            this.push(first[0].x, first[0].y, first[0].u, first[0].v, first[0].color);
            this.push(first[i].x, first[i].y, first[i].u, first[i].v, first[i].color);
            this.push(first[i + 1].x, first[i + 1].y, first[i + 1].u, first[i + 1].v, first[i + 1].color);
        }
    }

    static unsafe void copy_vertex(Vertex* to, Vertex* from) {
        to.x = from.x;
        to.y = from.y;
        to.u = from.u;
        to.v = from.v;
        to.color = from.color;
    }

    // How far a vertex is inside the half plane x >= limit, y >= limit (keep_above) or x <= limit, y <= limit.
    static unsafe f32 inside_by(Vertex* vertex, u32 axis, f32 limit, bool keep_above) {
        mut f32 value = vertex.x;
        if (axis == 1) {
            value = vertex.y;
        }
        if (keep_above) {
            return value - limit;
        }
        return limit - value;
    }

    static unsafe u32 mix_color(u32 a, u32 b, f32 t) {
        mut u32 mixed = 0;
        for (mut u32 shift = 0; shift < 32; shift = shift + 8) {
            f32 from = (f32)((a >> shift) & 255);
            f32 to = (f32)((b >> shift) & 255);
            u32 channel = (u32)(from + (to - from) * t + (f32)0.5);
            mixed = mixed | (channel << shift);
        }
        return mixed;
    }

    // Sutherland-Hodgman against one side of the clip rectangle; returns the vertices written to 'output'.
    static unsafe u32 clip_edge(Vertex* input, u32 count, Vertex* output, u32 axis, f32 limit, bool keep_above) {
        mut u32 made = 0;
        for (mut u32 i = 0; i < count; i = i + 1) {
            Vertex* p = &input[i];
            Vertex* q = &input[(i + 1) % count];
            f32 dp = DisplayList.inside_by(p, axis, limit, keep_above);
            f32 dq = DisplayList.inside_by(q, axis, limit, keep_above);
            if (dp >= (f32)0.0) {
                DisplayList.copy_vertex(&output[made], p);
                made = made + 1;
            }
            if ((dp >= (f32)0.0) != (dq >= (f32)0.0)) {
                f32 t = dp / (dp - dq);
                Vertex* cut = &output[made];
                cut.x = p.x + (q.x - p.x) * t;
                cut.y = p.y + (q.y - p.y) * t;
                cut.u = p.u + (q.u - p.u) * t;
                cut.v = p.v + (q.v - p.v) * t;
                cut.color = DisplayList.mix_color(p.color, q.color, t);
                made = made + 1;
            }
        }
        return made;
    }

    // A rounded rectangle with a one pixel soft edge: the inside is opaque, the last half pixel on each side fades out.
    public unsafe void rounded(f32 px, f32 py, f32 width, f32 height, f32 radius, u32 color) {
        if ((color >> 24) == 0 || width <= (f32)0.0 || height <= (f32)0.0) {
            return;
        }
        mut f32 r = radius;
        f32 limit = Px.min(width, height) / (f32)2.0;
        if (r > limit) {
            r = limit;
        }
        if (r <= (f32)0.0) {
            this.fill(px, py, width, height, color);
            return;
        }
        f32 x = px + this.shift_x;
        f32 y = py + this.shift_y;
        if (x + width < this.clip_left || x > this.clip_right || y + height < this.clip_top || y > this.clip_bottom) {
            return;
        }
        u32 points = 4 * (DisplayList.SEGMENTS + 1);
        f32 u = DisplayList.solid_u();
        u32 clear = DisplayList.fade(color, (f32)0.0);
        f32* inner = this.scratch;
        f32* outer = &this.scratch[points * 2];
        f32 center_x = x + width / (f32)2.0;
        f32 center_y = y + height / (f32)2.0;
        u32 first = this.count;
        this.reserve(points * 9);
        for (mut u32 i = 0; i < points; i = i + 1) {
            DisplayList.outline_point(x, y, width, height, r, (f32)-0.5, i, &inner[i * 2]);
            DisplayList.outline_point(x, y, width, height, r, (f32)0.5, i, &outer[i * 2]);
        }
        for (mut u32 i = 0; i < points; i = i + 1) {
            u32 next = (i + 1) % points;
            this.push(center_x, center_y, u, u, color);
            this.push(inner[i * 2], inner[i * 2 + 1], u, u, color);
            this.push(inner[next * 2], inner[next * 2 + 1], u, u, color);
            this.push(inner[i * 2], inner[i * 2 + 1], u, u, color);
            this.push(outer[i * 2], outer[i * 2 + 1], u, u, clear);
            this.push(outer[next * 2], outer[next * 2 + 1], u, u, clear);
            this.push(inner[i * 2], inner[i * 2 + 1], u, u, color);
            this.push(outer[next * 2], outer[next * 2 + 1], u, u, clear);
            this.push(inner[next * 2], inner[next * 2 + 1], u, u, color);
        }
        this.clip_from(first);
    }

    // A border of 'thickness' px inside a rounded rectangle, soft on both edges.
    public unsafe void ring(f32 px, f32 py, f32 width, f32 height, f32 radius, f32 thickness, u32 color) {
        if ((color >> 24) == 0 || thickness <= (f32)0.0 || width <= (f32)0.0 || height <= (f32)0.0) {
            return;
        }
        mut f32 r = radius;
        f32 limit = Px.min(width, height) / (f32)2.0;
        if (r > limit) {
            r = limit;
        }
        f32 x = px + this.shift_x;
        f32 y = py + this.shift_y;
        mut f32 t = thickness;
        if (t > limit) {
            t = limit;
        }
        f32 u = DisplayList.solid_u();
        u32 clear = DisplayList.fade(color, (f32)0.0);
        u32 points = 4 * (DisplayList.SEGMENTS + 1);
        f32 hole_x = x + t;
        f32 hole_y = y + t;
        f32 hole_width = width - t * (f32)2.0;
        f32 hole_height = height - t * (f32)2.0;
        mut f32 hole_radius = r - t;
        if (hole_radius < (f32)0.0) {
            hole_radius = (f32)0.0;
        }
        f32* a = this.scratch;                         // outer edge, fading out
        f32* b = &this.scratch[points * 2];       // outer edge, opaque
        f32* c = &this.scratch[points * 4];       // hole edge, opaque
        f32* d = &this.scratch[points * 6];       // hole edge, fading out
        u32 first = this.count;
        this.reserve(points * 18);
        for (mut u32 i = 0; i < points; i = i + 1) {
            DisplayList.outline_point(x, y, width, height, r, (f32)0.5, i, &a[i * 2]);
            DisplayList.outline_point(x, y, width, height, r, (f32)-0.5, i, &b[i * 2]);
            DisplayList.outline_point(hole_x, hole_y, hole_width, hole_height, hole_radius, (f32)0.5, i, &c[i * 2]);
            DisplayList.outline_point(hole_x, hole_y, hole_width, hole_height, hole_radius, (f32)-0.5, i, &d[i * 2]);
        }
        for (mut u32 i = 0; i < points; i = i + 1) {
            u32 n = (i + 1) % points;
            this.strip(a, clear, b, color, i, n, u);
            this.strip(b, color, c, color, i, n, u);
            this.strip(c, color, d, clear, i, n, u);
        }
        this.clip_from(first);
    }

    unsafe void strip(f32* from, u32 from_color, f32* to, u32 to_color, u32 i, u32 n, f32 u) {
        this.push(from[i * 2], from[i * 2 + 1], u, u, from_color);
        this.push(to[i * 2], to[i * 2 + 1], u, u, to_color);
        this.push(from[n * 2], from[n * 2 + 1], u, u, from_color);
        this.push(to[i * 2], to[i * 2 + 1], u, u, to_color);
        this.push(to[n * 2], to[n * 2 + 1], u, u, to_color);
        this.push(from[n * 2], from[n * 2 + 1], u, u, from_color);
    }
}
