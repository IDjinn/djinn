import std::types;
import std::libc;

namespace ui;

unsafe static mut ptr painter_lines = null;
unsafe static mut u32 painter_line_capacity = 0;

// Turns the laid out tree into a display list: backgrounds, borders, text and outlines in tree order, with clipping
// for overflow. It reads the boxes from Layout and the computed styles from Styles, so the caller runs
// Layout.compute first (Painter.frame does).
unsafe static mut ptr raised_items = null;
unsafe static mut u32 raised_count = 0;
unsafe static mut u32 raised_capacity = 0;
unsafe static mut u32 raised_now = 0;

// A positioned element with a positive z-index waiting to be drawn above the normal flow.
struct Raised {
    mut u32 id;
    mut f32 dx;
    mut f32 dy;
    mut i32 z;
    mut bool done;
}

struct Painter {
    static unsafe bool is_raised(u32 id) {
        if (Dom.kind(id) != DomKind.ELEMENT || id == raised_now) {
            return false;
        }
        Style* style = Styles.of(id);
        return style.z_index > 0 && style.position != Keyword.STATIC
            && style.display != Display.NONE;
    }

    static unsafe void defer(DisplayList* list, u32 id) {
        if (raised_count == raised_capacity) {
            u32 grown = raised_capacity * 2 + 8;
            ptr items = (ptr)__djinn_alloc_zeroed((size_long)(grown * (u32)sizeof(Raised)));
            if (raised_count > 0) {
                memcpy((void*)items, (void*)raised_items, (size_long)(raised_count * (u32)sizeof(Raised)));
            }
            if (raised_items != null) {
                __djinn_free((void*)raised_items);
            }
            raised_items = items;
            raised_capacity = grown;
        }
        Raised* slot = &((Raised*)raised_items)[raised_count];
        slot.id = id;
        slot.dx = list.shift_x;
        slot.dy = list.shift_y;
        if (Styles.of(id).position == Keyword.FIXED) {
            // fixed boxes stay put in the window while the page scrolls
            slot.dx = list.shift_x + Scroll.page_left();
            slot.dy = list.shift_y + Scroll.page_top();
        }
        slot.z = Styles.of(id).z_index;
        slot.done = false;
        raised_count = raised_count + 1;
    }

    // Draws the deferred elements, lowest z-index first (document order among equals); drawing one may defer more.
    static unsafe void flush_raised(DisplayList* list) {
        mut bool more = true;
        while (more) {
            more = false;
            mut u32 pick = raised_count;
            mut u32 i = 0;
            while (i < raised_count) {
                Raised* slot = &((Raised*)raised_items)[i];
                if (!slot.done) {
                    if (pick == raised_count || slot.z < ((Raised*)raised_items)[pick].z) {
                        pick = i;
                    }
                }
                i = i + 1;
            }
            if (pick < raised_count) {
                more = true;
                ((Raised*)raised_items)[pick].done = true;
                Raised item = ((Raised*)raised_items)[pick];
                f32 keep_x = list.shift_x;
                f32 keep_y = list.shift_y;
                list.shift(item.dx - keep_x, item.dy - keep_y);
                raised_now = item.id;
                Painter.body(list, item.id, (f32)1.0);
                raised_now = 0;
                list.shift(keep_x - item.dx, keep_y - item.dy);
            }
        }
        raised_count = 0;
    }

    // One whole frame: layout for the viewport, then paint. Returns the document height (what a page scrolls).
    public static unsafe f32 frame(DisplayList* list, f32 width, f32 height) {
        u32 document = Dom.document();
        Layout.compute(document, width, height);
        list.clear();
        f32 total = Layout.box(document).height;
        Scroll.page_limit(total - height, height);
        Scroll.page_limit_x(Layout.box(document).content_width - width, width);
        Painter.paint(list, document, width, height);
        return total;
    }

    // Only what can reach the viewport is turned into triangles: a node whose box (plus the reach of its outline)
    // lies outside the current clip draws nothing, its children are still visited since they may overflow it.
    public static unsafe void paint(DisplayList* list, u32 root, f32 width, f32 height) {
        list.clip_to((f32)0.0, (f32)0.0, width, height);
        list.shift((f32)0.0 - Scroll.page_left(), (f32)0.0 - Scroll.page_top());
        raised_count = 0;
        Transitions.begin();
        Painter.node(list, root, (f32)1.0);
        Painter.flush_raised(list);
        list.shift(Scroll.page_left(), Scroll.page_top());
        list.restore_clip();
    }

    static unsafe bool outside(DisplayList* list, f32 left, f32 top, f32 width, f32 height, f32 reach) {
        f32 x = left + list.shift_x;
        f32 y = top + list.shift_y;
        return x - reach >= list.clip_right || x + width + reach <= list.clip_left
            || y - reach >= list.clip_bottom || y + height + reach <= list.clip_top;
    }

    static unsafe bool is_hidden_tag(str tag) {
        return Texts.same(tag, "head") || Texts.same(tag, "style") || Texts.same(tag, "script") || Texts.same(tag, "title")
            || Texts.same(tag, "meta") || Texts.same(tag, "link") || Texts.same(tag, "template");
    }

    static unsafe void children(DisplayList* list, u32 id, f32 opacity) {
        mut u32 child = Dom.first_child(id);
        while (child != 0) {
            Painter.node(list, child, opacity);
            child = Dom.next_sibling(child);
        }
    }

    static unsafe void node(DisplayList* list, u32 id, f32 opacity) {
        if (Painter.is_raised(id)) {
            Painter.defer(list, id);
            return;
        }
        if (Dom.kind(id) == DomKind.ELEMENT && Styles.of(id).position == Keyword.FIXED && Styles.of(id).display != Display.NONE) {
            // fixed boxes stay put in the window while the page scrolls
            f32 page = Scroll.page_top();
            f32 side = Scroll.page_left();
            list.shift(side, page);
            Painter.body(list, id, opacity);
            list.shift((f32)0.0 - side, (f32)0.0 - page);
            return;
        }
        Painter.body(list, id, opacity);
    }

    static unsafe void body(DisplayList* list, u32 id, f32 opacity) {
        u8 kind = Dom.kind(id);
        if (kind == DomKind.TEXT) {
            Painter.text(list, id, opacity);
            return;
        }
        if (kind != DomKind.ELEMENT) {
            Painter.children(list, id, opacity);
            return;
        }
        if (Painter.is_hidden_tag(Dom.tag(id))) {
            return;
        }
        mut Style* style = Styles.of(id);
        mut Style shown = Style();
        if (style.transition_ms > 0 || style.transform_ms > 0) {
            shown = *style;
            if (Transitions.apply(id, style, &shown)) {
                style = &shown;
            }
        }
        if (style.display == Display.NONE) {
            return;
        }
        if (style.display == Display.CONTENTS) {
            Painter.children(list, id, opacity * style.opacity);
            return;
        }
        LayoutBox* box = Layout.box(id);
        f32 faded = opacity * style.opacity * Animation.opacity(id);
        f32 reach = style.outline_offset + style.outline_width + (f32)2.0;
        bool visible = !Painter.outside(list, box.left, box.top, box.width, box.height, reach);
        u32 first_vertex = list.count;
        mut f32 scale = style.transform_scale;
        if (style.position != Keyword.FIXED) {
            scale = scale * Animation.pop_scale(id);
        }
        if (visible && style.visibility != Keyword.HIDDEN && faded > (f32)0.0) {
            Painter.background(list, box, style, faded);
            Painter.border(list, box, style, faded);
        }
        mut bool clipped = false;
        if (style.overflow == Keyword.HIDDEN || style.overflow == Keyword.SCROLL || style.overflow == Keyword.AUTO) {
            list.clip_to(box.left + box.border.left, box.top + box.border.top, box.left + box.width - box.border.right,
                box.top + box.height - box.border.bottom);
            clipped = true;
        }
        mut f32 moved_x = (f32)0.0;
        mut f32 moved_y = (f32)0.0;
        if (clipped && Scroll.container(id)) {
            moved_x = Scroll.left(id);
            moved_y = Scroll.top(id);
        }
        list.shift((f32)0.0 - moved_x, (f32)0.0 - moved_y);
        Painter.children(list, id, faded);
        if (visible && style.visibility != Keyword.HIDDEN && faded > (f32)0.0) {
            Painter.field(list, id, box, style, faded);
        }
        list.shift(moved_x, moved_y);
        if (clipped && visible && Scroll.container(id)) {
            Painter.scrollbars(list, id, box, style);
        }
        if (clipped) {
            list.restore_clip();
        }
        if (visible && style.visibility != Keyword.HIDDEN && faded > (f32)0.0) {
            Painter.outline(list, box, style, faded);
        }
        f32 slid = style.translate_x + Animation.slide_offset(id);
        if (scale != (f32)1.0 || slid != (f32)0.0 || style.translate_y != (f32)0.0) {
            list.transform(first_vertex, box.left + box.width / (f32)2.0 + list.shift_x,
                box.top + box.height / (f32)2.0 + list.shift_y, scale, slid, style.translate_y);
        }
    }

    // The overlay scroll thumbs of a container: a rounded bar on the right (and bottom) edge, only when there is
    // something to scroll.
    static unsafe void scrollbars(DisplayList* list, u32 id, LayoutBox* box, Style* style) {
        f32 thickness = (f32)6.0 * (f32)Styles.device_scale();
        mut f32 alpha = (f32)0.55;
        if (Bars.grabbed() == id) {
            alpha = (f32)0.85;
        }
        mut BarRect r = { .x = (f32)0.0, .y = (f32)0.0, .w = (f32)0.0, .h = (f32)0.0, .free = (f32)0.0 };
        if (Bars.rect(id, true, &r)) {
            list.rounded(r.x, r.y, r.w, r.h, thickness / (f32)2.0, DisplayList.gpu_color(0x7f7f7fff, alpha));
        }
        if (Bars.rect(id, false, &r)) {
            list.rounded(r.x, r.y, r.w, r.h, thickness / (f32)2.0, DisplayList.gpu_color(0x7f7f7fff, alpha));
        }
    }

    static unsafe void background(DisplayList* list, LayoutBox* box, Style* style, f32 opacity) {
        if ((style.background & 255) == 0) {
            return;
        }
        u32 color = DisplayList.gpu_color(style.background, opacity);
        list.rounded(box.left, box.top, box.width, box.height, style.border_radius, color);
    }

    static unsafe void border(DisplayList* list, LayoutBox* box, Style* style, f32 opacity) {
        if (style.border_style == Keyword.NONE || style.border_style == Keyword.HIDDEN || (style.border_color & 255) == 0) {
            return;
        }
        Edges edge = box.border;
        if (edge.top <= (f32)0.0 && edge.right <= (f32)0.0 && edge.bottom <= (f32)0.0 && edge.left <= (f32)0.0) {
            return;
        }
        u32 color = DisplayList.gpu_color(style.border_color, opacity);
        if (style.border_radius > (f32)0.0) {
            mut f32 widest = Px.max(Px.max(edge.top, edge.right), Px.max(edge.bottom, edge.left));
            list.ring(box.left, box.top, box.width, box.height, style.border_radius, widest, color);
            return;
        }
        list.fill(box.left, box.top, box.width, edge.top, color);
        list.fill(box.left, box.top + box.height - edge.bottom, box.width, edge.bottom, color);
        list.fill(box.left, box.top + edge.top, edge.left, box.height - edge.top - edge.bottom, color);
        list.fill(box.left + box.width - edge.right, box.top + edge.top, edge.right, box.height - edge.top - edge.bottom, color);
    }

    static unsafe void outline(DisplayList* list, LayoutBox* box, Style* style, f32 opacity) {
        if (style.outline_style == Keyword.NONE || style.outline_width <= (f32)0.0 || (style.outline_color & 255) == 0) {
            return;
        }
        f32 reach = style.outline_offset + style.outline_width;
        u32 color = DisplayList.gpu_color(style.outline_color, opacity);
        list.ring(box.left - reach, box.top - reach, box.width + reach * (f32)2.0, box.height + reach * (f32)2.0,
            style.border_radius + reach, style.outline_width, color);
    }

    static unsafe TextLine* lines_for(u32 id, f32 limit, u32* count) {
        if (painter_lines == null) {
            painter_line_capacity = 64;
            painter_lines = (ptr)__djinn_alloc_zeroed((size_long)(64 * sizeof(TextLine)));
        }
        mut u32 found = TextLines.split(id, limit, (TextLine*)painter_lines, painter_line_capacity);
        if (found > painter_line_capacity) {
            __djinn_free((void*)painter_lines);
            painter_line_capacity = found + 16;
            painter_lines = (ptr)__djinn_alloc_zeroed((size_long)(painter_line_capacity * sizeof(TextLine)));
            found = TextLines.split(id, limit, (TextLine*)painter_lines, painter_line_capacity);
        }
        *count = found;
        return (TextLine*)painter_lines;
    }

    // One glyph at a pen position: the whole pixels place the bitmap, the quarter pixels pick the sub-pixel variant.
    static unsafe void glyph(DisplayList* list, u32 code, f32 pen, f32 baseline, f32 size, bool bold, u32 color) {
        f32 atlas = (f32)Fonts.ATLAS;
        mut i32 quarters = 0;
        if (pen > (f32)0.0) {
            quarters = (i32)(pen * (f32)4.0 + (f32)0.5);
        }
        u32 phase = (u32)(quarters & 3);
        Glyph* found = Fonts.glyph(code, size, bold, phase);
        if (found != (Glyph*)0) {
            f32 x = (f32)(quarters >> 2) + (f32)found.bearing_x;
            f32 y = Math.round(baseline - (f32)found.bearing_y);
            list.quad(x, y, x + (f32)found.width, y + (f32)found.height, (f32)found.atlas_x / atlas,
                (f32)found.atlas_y / atlas, (f32)(found.atlas_x + found.width) / atlas,
                (f32)(found.atlas_y + found.height) / atlas, color);
        }
    }

    // What a text field shows: its value (bullets for a password), or the placeholder in a fainter color when it is
    // empty, kept inside the content box and scrolled so the end (where the caret is) stays visible.
    static unsafe void field(DisplayList* list, u32 id, LayoutBox* box, Style* style, f32 opacity) {
        if (!Fonts.active() || !Input.editable(id)) {
            return;
        }
        bool focused = (Dom.state(id) & NodeState.FOCUS) != 0;
        str value = Dom.attr(id, "value");
        mut str shown = value;
        mut bool placeholder = false;
        if (value.length == 0) {
            shown = Dom.attr(id, "placeholder");
            placeholder = true;
        }
        if (shown.length == 0 && !focused) {
            return;
        }
        bool secret = !placeholder && Texts.same(Dom.attr(id, "type"), "password");
        f32 left = box.left + box.border.left + box.padding.left;
        f32 right = box.left + box.width - box.border.right - box.padding.right;
        f32 inner_top = box.top + box.border.top;
        f32 inner_bottom = box.top + box.height - box.border.bottom;
        f32 size = style.font_size;
        bool bold = style.font_weight >= 600;
        mut f32 ascent = (f32)0.0;
        mut f32 descent = (f32)0.0;
        Fonts.line_metrics(size, bold, &ascent, &descent);
        f32 baseline = (inner_top + inner_bottom) / (f32)2.0 - (ascent + descent) / (f32)2.0 + ascent;
        u32 length = (u32)shown.length;
        mut f32 total = (f32)0.0;
        mut u32 i = 0;
        while (i < length) {
            mut u32 step = 1;
            mut u32 code = Codepoints.decode(shown.data, length, i, &step);
            i = i + step;
            if (secret) {
                code = 8226;
            }
            total = total + TextLines.advance(code, style, true, bold);
        }
        mut f32 shift = (f32)0.0;
        if (!placeholder && focused) {
            shift = Edit.shift(id);
        } else if (total > right - left - (f32)2.0 && !placeholder) {
            shift = total - (right - left - (f32)2.0);
        }
        mut f32 alpha = opacity;
        if (placeholder) {
            alpha = opacity * (f32)0.55;
        }
        u32 color = DisplayList.gpu_color(style.color, alpha);
        list.clip_to(left, inner_top, right, inner_bottom);
        if (focused && !placeholder && Edit.has_selection(id)) {
            f32 from = left - shift + Edit.width_to(id, Edit.low(id));
            f32 to = left - shift + Edit.width_to(id, Edit.high(id));
            list.fill(Math.round(from), baseline - ascent, Math.round(to) - Math.round(from), ascent + descent,
                DisplayList.gpu_color(0x4f8cffff, opacity * (f32)0.45));
        }
        mut f32 pen = Math.round(left - shift);
        i = 0;
        while (i < length) {
            mut u32 step = 1;
            mut u32 code = Codepoints.decode(shown.data, length, i, &step);
            i = i + step;
            if (secret) {
                code = 8226;
            }
            if (!TextLines.is_blank(code)) {
                Painter.glyph(list, code, pen, baseline, size, bold, color);
            }
            pen = pen + TextLines.advance(code, style, true, bold);
        }
        if (focused) {
            mut f32 caret = left - shift;
            if (!placeholder) {
                caret = left - shift + Edit.width_to(id, Edit.caret(id));
            }
            list.fill(Math.round(caret), baseline - ascent, (f32)1.0, ascent + descent, DisplayList.gpu_color(style.color, opacity));
        }
        list.restore_clip();
    }

    static unsafe void text(DisplayList* list, u32 id, f32 opacity) {
        if (!Fonts.active() || opacity <= (f32)0.0) {
            return;
        }
        Style* style = Styles.of(id);
        if (style.visibility == Keyword.HIDDEN || (style.color & 255) == 0) {
            return;
        }
        LayoutBox* box = Layout.box(id);
        if (box.width <= (f32)0.0 && box.height <= (f32)0.0) {
            return;
        }
        if (Painter.outside(list, box.left, box.top, box.width, box.height, (f32)2.0)) {
            return;
        }
        mut u32 count = 0;
        TextLine* lines = Painter.lines_for(id, box.width, &count);
        if (count == 0) {
            return;
        }
        str text = Dom.text_of(id);
        bool bold = style.font_weight >= 600;
        f32 size = style.font_size;
        mut u32 own_color = style.color;
        u32 owner = SelectorMatcher.parent_element(id);
        if (owner != 0 && style.transition_ms > 0) {
            own_color = Transitions.shown_color(owner, style.color);
        }
        u32 color = DisplayList.gpu_color(own_color, opacity);
        f32 line_height = style.line_px();
        mut f32 ascent = (f32)0.0;
        mut f32 descent = (f32)0.0;
        Fonts.line_metrics(size, bold, &ascent, &descent);
        f32 space = TextLines.advance(32, style, true, bold);
        f32 atlas = (f32)Fonts.ATLAS;
        for (mut u32 n = 0; n < count; n = n + 1) {
            TextLine line = lines[n];
            f32 top = box.top + (f32)n * line_height;
            f32 baseline = top + (line_height - (ascent + descent)) / (f32)2.0 + ascent;
            mut f32 pen = box.left;
            if (style.text_align == Keyword.CENTER) {
                pen = box.left + (box.width - line.width) / (f32)2.0;
            } else if (style.text_align == Keyword.END || style.text_align == Keyword.RIGHT) {
                pen = box.left + box.width - line.width;
            }
            // the line starts on a whole pixel, so moving or resizing the box never changes how its glyphs are
            // positioned relative to each other (no shimmer); only the advances inside the line are fractional
            pen = Math.round(pen);
            f32 line_left = pen;
            mut bool gap = false;
            mut u32 i = line.start;
            while (i < line.end) {
                mut u32 step = 1;
                u32 code = Codepoints.decode(text.data, (u32)text.length, i, &step);
                i = i + step;
                if (TextLines.is_blank(code)) {
                    gap = true;
                    continue;
                }
                if (gap) {
                    pen = pen + space;
                    gap = false;
                }
                Painter.glyph(list, code, pen, baseline, size, bold, color);
                pen = pen + TextLines.advance(code, style, true, bold);
            }
            f32 thickness = Px.max((f32)1.0, size / (f32)14.0);
            if (style.text_decoration == Keyword.UNDERLINE) {
                list.fill(line_left, baseline + Px.max((f32)1.0, size * (f32)0.1), pen - line_left, thickness, color);
            } else if (style.text_decoration == Keyword.LINE_THROUGH) {
                list.fill(line_left, baseline - size * (f32)0.3, pen - line_left, thickness, color);
            }
        }
    }
}
