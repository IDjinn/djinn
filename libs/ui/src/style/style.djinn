import std::types;
import std::libc;

namespace ui;

struct Display {
    const u8 NONE = 0;
    const u8 INLINE = 1;
    const u8 BLOCK = 2;
    const u8 INLINE_BLOCK = 3;
    const u8 FLEX = 4;
    const u8 INLINE_FLEX = 5;
    const u8 GRID = 6;
    const u8 CONTENTS = 7;
}

struct Keyword {
    const u8 NONE = 0;
    const u8 START = 1;
    const u8 END = 2;
    const u8 CENTER = 3;
    const u8 STRETCH = 4;
    const u8 BETWEEN = 5;
    const u8 AROUND = 6;
    const u8 EVENLY = 7;
    const u8 BASELINE = 8;
    const u8 ROW = 9;
    const u8 COLUMN = 10;
    const u8 ROW_REVERSE = 11;
    const u8 COLUMN_REVERSE = 12;
    const u8 WRAP = 13;
    const u8 NOWRAP = 14;
    const u8 LEFT = 15;
    const u8 RIGHT = 16;
    const u8 JUSTIFY = 17;
    const u8 VISIBLE = 18;
    const u8 HIDDEN = 19;
    const u8 SCROLL = 20;
    const u8 AUTO = 21;
    const u8 STATIC = 22;
    const u8 RELATIVE = 23;
    const u8 ABSOLUTE = 24;
    const u8 FIXED = 25;
    const u8 STICKY = 26;
    const u8 NORMAL = 27;
    const u8 ITALIC = 28;
    const u8 UNDERLINE = 29;
    const u8 LINE_THROUGH = 30;
    const u8 POINTER = 31;
    const u8 DEFAULT = 32;
    const u8 TEXT = 33;
    const u8 NOT_ALLOWED = 34;
    const u8 SOLID = 35;
    const u8 DASHED = 36;
    const u8 DOTTED = 37;
    const u8 BORDER_BOX = 38;
    const u8 CONTENT_BOX = 39;
    const u8 COLLAPSE = 40;
    const u8 UNKNOWN = 255;
}

// A custom property value ('--name: value'), chained to the ones inherited from the parent.
struct CssVar {
    mut str name;
    mut str value;
    mut CssVar* next;
}

// The computed style of one element: everything the layout, text and paint stages read.
struct Style {
    mut u8 display;
    mut u8 position;
    mut u8 visibility;
    mut u8 overflow;
    mut u8 box_sizing;
    mut i32 z_index;
    mut u32 color;
    mut u32 background;
    mut f32 opacity;
    mut u32 transition_ms;
    mut u32 transform_ms;
    mut f32 transform_scale;
    mut f32 translate_x;
    mut f32 translate_y;
    mut f32 transform_rotate;
    mut f32 origin_x;
    mut f32 origin_y;
    mut f32 origin_x_px;
    mut f32 origin_y_px;
    mut f32 font_size;
    mut u16 font_weight;
    mut u8 font_style;
    mut str font_family;
    mut f32 line_height;
    mut f32 line_factor;
    mut bool wrap_anywhere;
    mut f32 letter_spacing;
    mut u8 text_align;
    mut u8 text_decoration;
    mut u8 cursor;
    mut bool dark_scheme;
    mut Length padding_top;
    mut Length padding_right;
    mut Length padding_bottom;
    mut Length padding_left;
    mut Length margin_top;
    mut Length margin_right;
    mut Length margin_bottom;
    mut Length margin_left;
    mut f32 border_top;
    mut f32 border_right;
    mut f32 border_bottom;
    mut f32 border_left;
    mut u8 border_style;
    mut u32 border_color;
    mut f32 border_radius;
    mut Length width;
    mut Length height;
    mut Length min_width;
    mut Length min_height;
    mut Length max_width;
    mut Length max_height;
    mut u8 flex_direction;
    mut u8 flex_wrap;
    mut u8 justify_content;
    mut u8 align_items;
    mut u8 align_self;
    mut f32 flex_grow;
    mut f32 flex_shrink;
    mut Length flex_basis;
    mut Length row_gap;
    mut Length column_gap;
    mut u8 align_content;
    mut u8 justify_items;
    mut u8 justify_self;
    mut i32 order;
    mut Length inset_top;
    mut Length inset_right;
    mut Length inset_bottom;
    mut Length inset_left;
    mut f32 aspect_ratio;
    mut u32 grid_columns;
    mut u32 grid_rows;
    mut u32 grid_auto_columns;
    mut u32 grid_auto_rows;
    mut u8 grid_flow;
    mut bool grid_dense;
    mut GridLine grid_column;
    mut GridLine grid_row;
    mut f32 outline_width;
    mut u8 outline_style;
    mut u32 outline_color;
    mut f32 outline_offset;
    mut CssVar* vars;
    mut u32 own_vars;

    public static unsafe Style initial() {
        mut Style style = Style();
        str family = "sans-serif";
        style.display = Display.INLINE;
        style.position = Keyword.STATIC;
        style.visibility = Keyword.VISIBLE;
        style.overflow = Keyword.VISIBLE;
        style.box_sizing = Keyword.CONTENT_BOX;
        style.color = 255;
        style.background = 0;
        style.opacity = (f32)1.0;
        style.transform_scale = (f32)1.0;
        style.origin_x = (f32)0.5;
        style.origin_y = (f32)0.5;
        style.font_size = (f32)16.0;
        style.font_weight = 400;
        style.font_style = Keyword.NORMAL;
        style.font_family = family;
        style.line_height = (f32)0.0;
        style.text_align = Keyword.START;
        style.text_decoration = Keyword.NONE;
        style.cursor = Keyword.AUTO;
        style.padding_top = Length.px((f32)0.0);
        style.padding_right = Length.px((f32)0.0);
        style.padding_bottom = Length.px((f32)0.0);
        style.padding_left = Length.px((f32)0.0);
        style.margin_top = Length.px((f32)0.0);
        style.margin_right = Length.px((f32)0.0);
        style.margin_bottom = Length.px((f32)0.0);
        style.margin_left = Length.px((f32)0.0);
        style.border_style = Keyword.NONE;
        style.border_color = 255;
        style.width = Length.automatic();
        style.height = Length.automatic();
        style.min_width = Length.automatic();
        style.min_height = Length.automatic();
        style.max_width = Length.of(Unit.NONE, (f32)0.0);
        style.max_height = Length.of(Unit.NONE, (f32)0.0);
        style.flex_direction = Keyword.ROW;
        style.flex_wrap = Keyword.NOWRAP;
        style.justify_content = Keyword.START;
        style.align_items = Keyword.STRETCH;
        style.align_self = Keyword.AUTO;
        style.flex_shrink = (f32)1.0;
        style.flex_basis = Length.automatic();
        style.row_gap = Length.px((f32)0.0);
        style.column_gap = Length.px((f32)0.0);
        style.align_content = Keyword.NORMAL;
        style.justify_items = Keyword.NORMAL;
        style.justify_self = Keyword.AUTO;
        style.inset_top = Length.automatic();
        style.inset_right = Length.automatic();
        style.inset_bottom = Length.automatic();
        style.inset_left = Length.automatic();
        style.grid_flow = Keyword.ROW;
        style.grid_column = GridLine.automatic();
        style.grid_row = GridLine.automatic();
        style.vars = (CssVar*)0;
        return style;
    }

    // The inherited properties of 'parent' on top of the initial values.
    public static unsafe Style inheriting(Style* parent) {
        mut Style style = Style.initial();
        style.color = parent.color;
        style.visibility = parent.visibility;
        style.font_size = parent.font_size;
        style.font_weight = parent.font_weight;
        style.font_style = parent.font_style;
        style.font_family = parent.font_family;
        style.line_height = parent.line_height;
        style.line_factor = parent.line_factor;
        style.wrap_anywhere = parent.wrap_anywhere;
        style.letter_spacing = parent.letter_spacing;
        style.text_align = parent.text_align;
        style.cursor = parent.cursor;
        style.dark_scheme = parent.dark_scheme;
        style.vars = parent.vars;
        style.own_vars = 0;
        return style;
    }

    // The used line height in px ('normal' is 1.2 times the font size). A unitless line-height is inherited as the
    // number, so it follows the font size of each element.
    public f32 line_px() {
        if (this.line_factor > (f32)0.0) {
            return this.line_factor * this.font_size;
        }
        if (this.line_height > (f32)0.0) {
            return this.line_height;
        }
        return this.font_size * (f32)1.2;
    }

    public unsafe str custom(str name) {
        mut CssVar* item = this.vars;
        while (item != (CssVar*)0) {
            if (Texts.same(item.name, name)) {
                return item.value;
            }
            item = item.next;
        }
        str missing = { .data = (i8*)0, .length = 0 };
        return missing;
    }
}

struct Props {
    public static bool is_inherited(str name) {
        return CssNames.equal(name, "color") || CssNames.equal(name, "font-size") || CssNames.equal(name, "font-weight") || CssNames.equal(name, "font-style")
            || CssNames.equal(name, "font-family") || CssNames.equal(name, "line-height") || CssNames.equal(name, "letter-spacing")
            || CssNames.equal(name, "text-align") || CssNames.equal(name, "visibility") || CssNames.equal(name, "cursor") || CssNames.equal(name, "color-scheme")
            || CssNames.equal(name, "overflow-wrap") || CssNames.equal(name, "word-wrap");
    }

    static unsafe u8 keyword(str word) {
        if (CssNames.equal(word, "none")) { return Keyword.NONE; }
        if (CssNames.equal(word, "start") || CssNames.equal(word, "flex-start") || CssNames.equal(word, "self-start")) { return Keyword.START; }
        if (CssNames.equal(word, "end") || CssNames.equal(word, "flex-end") || CssNames.equal(word, "self-end")) { return Keyword.END; }
        if (CssNames.equal(word, "center")) { return Keyword.CENTER; }
        if (CssNames.equal(word, "stretch")) { return Keyword.STRETCH; }
        if (CssNames.equal(word, "space-between")) { return Keyword.BETWEEN; }
        if (CssNames.equal(word, "space-around")) { return Keyword.AROUND; }
        if (CssNames.equal(word, "space-evenly")) { return Keyword.EVENLY; }
        if (CssNames.equal(word, "baseline")) { return Keyword.BASELINE; }
        if (CssNames.equal(word, "row")) { return Keyword.ROW; }
        if (CssNames.equal(word, "column")) { return Keyword.COLUMN; }
        if (CssNames.equal(word, "row-reverse")) { return Keyword.ROW_REVERSE; }
        if (CssNames.equal(word, "column-reverse")) { return Keyword.COLUMN_REVERSE; }
        if (CssNames.equal(word, "wrap")) { return Keyword.WRAP; }
        if (CssNames.equal(word, "nowrap")) { return Keyword.NOWRAP; }
        if (CssNames.equal(word, "left")) { return Keyword.LEFT; }
        if (CssNames.equal(word, "right")) { return Keyword.RIGHT; }
        if (CssNames.equal(word, "justify")) { return Keyword.JUSTIFY; }
        if (CssNames.equal(word, "visible")) { return Keyword.VISIBLE; }
        if (CssNames.equal(word, "hidden")) { return Keyword.HIDDEN; }
        if (CssNames.equal(word, "collapse")) { return Keyword.COLLAPSE; }
        if (CssNames.equal(word, "scroll")) { return Keyword.SCROLL; }
        if (CssNames.equal(word, "auto")) { return Keyword.AUTO; }
        if (CssNames.equal(word, "static")) { return Keyword.STATIC; }
        if (CssNames.equal(word, "relative")) { return Keyword.RELATIVE; }
        if (CssNames.equal(word, "absolute")) { return Keyword.ABSOLUTE; }
        if (CssNames.equal(word, "fixed")) { return Keyword.FIXED; }
        if (CssNames.equal(word, "sticky")) { return Keyword.STICKY; }
        if (CssNames.equal(word, "normal")) { return Keyword.NORMAL; }
        if (CssNames.equal(word, "italic") || CssNames.equal(word, "oblique")) { return Keyword.ITALIC; }
        if (CssNames.equal(word, "underline")) { return Keyword.UNDERLINE; }
        if (CssNames.equal(word, "line-through")) { return Keyword.LINE_THROUGH; }
        if (CssNames.equal(word, "pointer")) { return Keyword.POINTER; }
        if (CssNames.equal(word, "default")) { return Keyword.DEFAULT; }
        if (CssNames.equal(word, "text")) { return Keyword.TEXT; }
        if (CssNames.equal(word, "not-allowed")) { return Keyword.NOT_ALLOWED; }
        if (CssNames.equal(word, "solid")) { return Keyword.SOLID; }
        if (CssNames.equal(word, "dashed")) { return Keyword.DASHED; }
        if (CssNames.equal(word, "dotted")) { return Keyword.DOTTED; }
        if (CssNames.equal(word, "border-box")) { return Keyword.BORDER_BOX; }
        if (CssNames.equal(word, "content-box")) { return Keyword.CONTENT_BOX; }
        return Keyword.UNKNOWN;
    }

    // An alignment value, skipping the 'safe' / 'unsafe' / 'legacy' modifiers.
    static unsafe u8 alignment(ValueReader* reader) {
        mut CssToken token = reader.next();
        while (token.kind == CssKind.IDENT && (CssNames.equal(token.text, "safe") || CssNames.equal(token.text, "unsafe") || CssNames.equal(token.text, "legacy"))) {
            token = reader.next();
        }
        if (token.kind != CssKind.IDENT) {
            return Keyword.UNKNOWN;
        }
        return Props.keyword(token.text);
    }

    static unsafe u8 display(str word) {
        if (CssNames.equal(word, "none")) { return Display.NONE; }
        if (CssNames.equal(word, "inline")) { return Display.INLINE; }
        if (CssNames.equal(word, "block") || CssNames.equal(word, "list-item") || CssNames.equal(word, "flow-root") || CssNames.equal(word, "table")) { return Display.BLOCK; }
        if (CssNames.equal(word, "inline-block")) { return Display.INLINE_BLOCK; }
        if (CssNames.equal(word, "flex")) { return Display.FLEX; }
        if (CssNames.equal(word, "inline-flex")) { return Display.INLINE_FLEX; }
        if (CssNames.equal(word, "grid") || CssNames.equal(word, "inline-grid")) { return Display.GRID; }
        if (CssNames.equal(word, "contents")) { return Display.CONTENTS; }
        return Keyword.UNKNOWN;
    }

    // The physical property a logical one maps to. Only horizontal, left-to-right writing is laid out for now, so
    // inline is the horizontal axis and block the vertical one, start is left / top.
    public static unsafe str physical(str name) {
        if (name.length < 9) {
            return name;
        }
        if (CssNames.equal(name, "inline-size")) { return "width"; }
        if (CssNames.equal(name, "block-size")) { return "height"; }
        if (CssNames.equal(name, "min-inline-size")) { return "min-width"; }
        if (CssNames.equal(name, "max-inline-size")) { return "max-width"; }
        if (CssNames.equal(name, "min-block-size")) { return "min-height"; }
        if (CssNames.equal(name, "max-block-size")) { return "max-height"; }
        if (CssNames.equal(name, "margin-inline-start")) { return "margin-left"; }
        if (CssNames.equal(name, "margin-inline-end")) { return "margin-right"; }
        if (CssNames.equal(name, "margin-block-start")) { return "margin-top"; }
        if (CssNames.equal(name, "margin-block-end")) { return "margin-bottom"; }
        if (CssNames.equal(name, "padding-inline-start")) { return "padding-left"; }
        if (CssNames.equal(name, "padding-inline-end")) { return "padding-right"; }
        if (CssNames.equal(name, "padding-block-start")) { return "padding-top"; }
        if (CssNames.equal(name, "padding-block-end")) { return "padding-bottom"; }
        if (CssNames.equal(name, "inset-inline-start")) { return "left"; }
        if (CssNames.equal(name, "inset-inline-end")) { return "right"; }
        if (CssNames.equal(name, "inset-block-start")) { return "top"; }
        if (CssNames.equal(name, "inset-block-end")) { return "bottom"; }
        if (CssNames.equal(name, "border-inline-start")) { return "border-left"; }
        if (CssNames.equal(name, "border-inline-end")) { return "border-right"; }
        if (CssNames.equal(name, "border-block-start")) { return "border-top"; }
        if (CssNames.equal(name, "border-block-end")) { return "border-bottom"; }
        return name;
    }

    // Copies one property (or the properties of a shorthand) from 'from': 'inherit', 'initial' and 'unset'.
    public static unsafe void copy(Style* style, str logical, Style* from) {
        str name = Props.physical(logical);
        if (CssNames.equal(name, "display")) { style.display = from.display; }
        else if (CssNames.equal(name, "position")) { style.position = from.position; }
        else if (CssNames.equal(name, "visibility")) { style.visibility = from.visibility; }
        else if (CssNames.equal(name, "color")) { style.color = from.color; }
        else if (CssNames.equal(name, "background-color") || CssNames.equal(name, "background")) { style.background = from.background; }
        else if (CssNames.equal(name, "opacity")) { style.opacity = from.opacity; }
        else if (CssNames.equal(name, "font-size")) { style.font_size = from.font_size; }
        else if (CssNames.equal(name, "font-weight")) { style.font_weight = from.font_weight; }
        else if (CssNames.equal(name, "font-style")) { style.font_style = from.font_style; }
        else if (CssNames.equal(name, "font-family")) { style.font_family = from.font_family; }
        else if (CssNames.equal(name, "line-height")) {
            style.line_height = from.line_height;
            style.line_factor = from.line_factor;
        } else if (CssNames.equal(name, "font")) {
            style.font_size = from.font_size;
            style.font_weight = from.font_weight;
            style.font_style = from.font_style;
            style.font_family = from.font_family;
            style.line_height = from.line_height;
            style.line_factor = from.line_factor;
        } else if (CssNames.equal(name, "outline")) {
            style.outline_width = from.outline_width;
            style.outline_style = from.outline_style;
            style.outline_color = from.outline_color;
        } else if (CssNames.equal(name, "outline-offset")) { style.outline_offset = from.outline_offset; }
        else if (CssNames.equal(name, "text-decoration")) { style.text_decoration = from.text_decoration; }
        else if (CssNames.equal(name, "overflow-wrap") || CssNames.equal(name, "word-wrap")) { style.wrap_anywhere = from.wrap_anywhere; }
        else if (CssNames.equal(name, "border")) {
            style.border_top = from.border_top;
            style.border_right = from.border_right;
            style.border_bottom = from.border_bottom;
            style.border_left = from.border_left;
            style.border_style = from.border_style;
            style.border_color = from.border_color;
        }
        else if (CssNames.equal(name, "letter-spacing")) { style.letter_spacing = from.letter_spacing; }
        else if (CssNames.equal(name, "text-align")) { style.text_align = from.text_align; }
        else if (CssNames.equal(name, "cursor")) { style.cursor = from.cursor; }
        else if (CssNames.equal(name, "color-scheme")) { style.dark_scheme = from.dark_scheme; }
        else if (CssNames.equal(name, "padding")) {
            style.padding_top = from.padding_top;
            style.padding_right = from.padding_right;
            style.padding_bottom = from.padding_bottom;
            style.padding_left = from.padding_left;
        } else if (CssNames.equal(name, "margin")) {
            style.margin_top = from.margin_top;
            style.margin_right = from.margin_right;
            style.margin_bottom = from.margin_bottom;
            style.margin_left = from.margin_left;
        } else if (CssNames.equal(name, "border-color")) { style.border_color = from.border_color; }
        else if (CssNames.equal(name, "border-radius")) { style.border_radius = from.border_radius; }
        else if (CssNames.equal(name, "width")) { style.width = from.width; }
        else if (CssNames.equal(name, "height")) { style.height = from.height; }
        else if (CssNames.equal(name, "min-width")) { style.min_width = from.min_width; }
        else if (CssNames.equal(name, "min-height")) { style.min_height = from.min_height; }
        else if (CssNames.equal(name, "max-width")) { style.max_width = from.max_width; }
        else if (CssNames.equal(name, "max-height")) { style.max_height = from.max_height; }
        else if (CssNames.equal(name, "overflow")) { style.overflow = from.overflow; }
        else if (CssNames.equal(name, "box-sizing")) { style.box_sizing = from.box_sizing; }
        else if (CssNames.equal(name, "flex")) {
            style.flex_grow = from.flex_grow;
            style.flex_shrink = from.flex_shrink;
            style.flex_basis = from.flex_basis;
        } else if (CssNames.equal(name, "flex-direction")) { style.flex_direction = from.flex_direction; }
        else if (CssNames.equal(name, "flex-wrap")) { style.flex_wrap = from.flex_wrap; }
        else if (CssNames.equal(name, "flex-grow")) { style.flex_grow = from.flex_grow; }
        else if (CssNames.equal(name, "flex-shrink")) { style.flex_shrink = from.flex_shrink; }
        else if (CssNames.equal(name, "flex-basis")) { style.flex_basis = from.flex_basis; }
        else if (CssNames.equal(name, "justify-content")) { style.justify_content = from.justify_content; }
        else if (CssNames.equal(name, "align-items")) { style.align_items = from.align_items; }
        else if (CssNames.equal(name, "align-self")) { style.align_self = from.align_self; }
        else if (CssNames.equal(name, "align-content")) { style.align_content = from.align_content; }
        else if (CssNames.equal(name, "justify-items")) { style.justify_items = from.justify_items; }
        else if (CssNames.equal(name, "justify-self")) { style.justify_self = from.justify_self; }
        else if (CssNames.equal(name, "gap")) {
            style.row_gap = from.row_gap;
            style.column_gap = from.column_gap;
        } else if (CssNames.equal(name, "order")) { style.order = from.order; }
        else if (CssNames.equal(name, "inset")) {
            style.inset_top = from.inset_top;
            style.inset_right = from.inset_right;
            style.inset_bottom = from.inset_bottom;
            style.inset_left = from.inset_left;
        } else if (CssNames.equal(name, "top")) { style.inset_top = from.inset_top; }
        else if (CssNames.equal(name, "right")) { style.inset_right = from.inset_right; }
        else if (CssNames.equal(name, "bottom")) { style.inset_bottom = from.inset_bottom; }
        else if (CssNames.equal(name, "left")) { style.inset_left = from.inset_left; }
        else if (CssNames.equal(name, "aspect-ratio")) { style.aspect_ratio = from.aspect_ratio; }
        else if (CssNames.equal(name, "grid-template-columns")) { style.grid_columns = from.grid_columns; }
        else if (CssNames.equal(name, "grid-template-rows")) { style.grid_rows = from.grid_rows; }
        else if (CssNames.equal(name, "grid-auto-columns")) { style.grid_auto_columns = from.grid_auto_columns; }
        else if (CssNames.equal(name, "grid-auto-rows")) { style.grid_auto_rows = from.grid_auto_rows; }
        else if (CssNames.equal(name, "grid-auto-flow")) {
            style.grid_flow = from.grid_flow;
            style.grid_dense = from.grid_dense;
        } else if (CssNames.equal(name, "grid-column")) { style.grid_column = from.grid_column; }
        else if (CssNames.equal(name, "grid-row")) { style.grid_row = from.grid_row; }
    }

    static unsafe bool color(ValueReader* reader, ValueContext* context, Style* style, u32* out) {
        return Colors.read(reader, context, style.color, out);
    }

    // 1 to 4 lengths in CSS side order (top, right, bottom, left), written to 'out'.
    static unsafe bool sides(ValueReader* reader, ValueContext* context, Length* out) {
        mut u32 count = 0;
        while (!reader.done() && count < 4) {
            Length value = CssNumbers.length(reader, context);
            if (value.unit == Unit.INVALID) {
                return false;
            }
            out[count] = value;
            count = count + 1;
        }
        if (count == 0 || !reader.done()) {
            return false;
        }
        if (count == 1) {
            out[1] = out[0];
            out[2] = out[0];
            out[3] = out[0];
        } else if (count == 2) {
            out[2] = out[0];
            out[3] = out[1];
        } else if (count == 3) {
            out[3] = out[1];
        }
        return true;
    }

    static unsafe f32 width_of(Length value) {
        if (value.unit == Unit.PX) {
            return value.value;
        }
        return (f32)0.0;
    }

    // 'border: 1px solid red' (any order); 'side' is 0 for all sides, 1..4 for top, right, bottom, left.
    static unsafe bool border(ValueReader* reader, ValueContext* context, Style* style, u32 side) {
        mut f32 width = (f32)3.0;
        mut u8 line = Keyword.NONE;
        mut u32 color = style.color;
        while (!reader.done()) {
            CssToken token = reader.peek();
            if (token.kind == CssKind.IDENT) {
                u8 word = Props.keyword(token.text);
                if (word == Keyword.SOLID || word == Keyword.DASHED || word == Keyword.DOTTED || word == Keyword.NONE || word == Keyword.HIDDEN) {
                    line = word;
                    reader.next();
                    continue;
                }
                if (CssNames.equal(token.text, "thin")) { width = (f32)1.0; reader.next(); continue; }
                if (CssNames.equal(token.text, "medium")) { width = (f32)3.0; reader.next(); continue; }
                if (CssNames.equal(token.text, "thick")) { width = (f32)5.0; reader.next(); continue; }
            }
            if (token.kind == CssKind.DIMENSION || token.kind == CssKind.NUMBER || (token.kind == CssKind.FUNCTION && CssNames.equal(token.text, "calc"))) {
                width = Props.width_of(CssNumbers.length(reader, context));
                continue;
            }
            if (!Props.color(reader, context, style, &color)) {
                return false;
            }
        }
        if (line == Keyword.NONE || line == Keyword.HIDDEN) {
            width = (f32)0.0;
        }
        if (side == 0 || side == 1) { style.border_top = width; }
        if (side == 0 || side == 2) { style.border_right = width; }
        if (side == 0 || side == 3) { style.border_bottom = width; }
        if (side == 0 || side == 4) { style.border_left = width; }
        if (line != Keyword.NONE || side == 0) {
            style.border_style = line;
        }
        style.border_color = color;
        return true;
    }

    // Whether '@supports (name: value)' holds here: the property is one the engine applies and the value reads.
    public static unsafe bool supports(str name, str value) {
        if (name.length > 2 && name.data[0] == 45 && name.data[1] == 45) {
            return true;
        }
        mut Style scratch = Style.initial();
        mut Style parent = Style.initial();
        mut CssTokens tokens = CssLexer.tokenize(value);
        mut ValueReader reader = ValueReader.over(&tokens, 0, tokens.count);
        reader.text = value.data;
        mut ValueContext context = { .font_size = 16.0, .root_font_size = 16.0, .viewport_width = 1280.0, .viewport_height = 800.0, .dark = false };
        mut bool known = true;
        bool valid = Props.apply_named(&scratch, Props.physical(name), &reader, &context, &parent, &known);
        if (tokens.data != (CssToken*)0) {
            __djinn_free((void*)tokens.data);
        }
        return known && valid;
    }

    // 'outline: 2px solid color' in any order.
    static unsafe bool outline(ValueReader* reader, ValueContext* context, Style* style) {
        mut f32 width = (f32)3.0;
        mut u8 line = Keyword.NONE;
        mut u32 color = style.color;
        while (!reader.done()) {
            CssToken token = reader.peek();
            if (token.kind == CssKind.IDENT) {
                u8 word = Props.keyword(token.text);
                if (word == Keyword.SOLID || word == Keyword.DASHED || word == Keyword.DOTTED || word == Keyword.NONE || word == Keyword.AUTO) {
                    line = word;
                    reader.next();
                    continue;
                }
                if (CssNames.equal(token.text, "thin")) { width = (f32)1.0; reader.next(); continue; }
                if (CssNames.equal(token.text, "medium")) { width = (f32)3.0; reader.next(); continue; }
                if (CssNames.equal(token.text, "thick")) { width = (f32)5.0; reader.next(); continue; }
            }
            if (token.kind == CssKind.DIMENSION || token.kind == CssKind.NUMBER || (token.kind == CssKind.FUNCTION && CssNames.equal(token.text, "calc"))) {
                width = Props.width_of(CssNumbers.length(reader, context));
                continue;
            }
            if (!Props.color(reader, context, style, &color)) {
                return false;
            }
        }
        if (line == Keyword.NONE) {
            width = (f32)0.0;
        }
        style.outline_width = width;
        style.outline_style = line;
        style.outline_color = color;
        return true;
    }

    // Applies one declaration with its value already free of var(); returns false when the value is invalid.
    public static unsafe bool apply(Style* style, str name, ValueReader* reader, ValueContext* context, Style* parent) {
        mut bool known = true;
        if (CssNames.equal(name, "border-inline") || CssNames.equal(name, "border-block")) {
            u32 start = reader.pos;
            mut str first_side = "border-left";
            mut str second_side = "border-right";
            if (CssNames.equal(name, "border-block")) {
                first_side = "border-top";
                second_side = "border-bottom";
            }
            if (!Props.apply_named(style, first_side, reader, context, parent, &known)) {
                return false;
            }
            reader.pos = start;
            return Props.apply_named(style, second_side, reader, context, parent, &known);
        }
        return Props.apply_named(style, Props.physical(name), reader, context, parent, &known);
    }

    // 'known' is set to false when the property is not one the engine applies (the declaration is then ignored).
    static unsafe bool apply_named(Style* style, str name, ValueReader* reader, ValueContext* context, Style* parent, bool* known) {
        CssToken first = reader.peek();
        if (CssNames.equal(name, "color-scheme")) {
            // 'light dark' follows the system; a single scheme forces it ('only' and 'normal' need nothing else).
            mut bool light = false;
            mut bool dark = false;
            while (!reader.done()) {
                CssToken word = reader.next();
                if (CssNames.equal(word.text, "light")) { light = true; }
                else if (CssNames.equal(word.text, "dark")) { dark = true; }
                else if (word.kind != CssKind.IDENT) { return false; }
            }
            if (light && dark) {
                style.dark_scheme = Styles.environment().prefers_dark;
            } else {
                style.dark_scheme = dark;
            }
            return true;
        }
        if (CssNames.equal(name, "overflow-wrap") || CssNames.equal(name, "word-wrap")) {
            if (CssNames.equal(first.text, "normal")) { style.wrap_anywhere = false; return true; }
            if (CssNames.equal(first.text, "break-word") || CssNames.equal(first.text, "anywhere")) { style.wrap_anywhere = true; return true; }
            return false;
        }
        if (CssNames.equal(name, "outline")) { return Props.outline(reader, context, style); }
        if (CssNames.equal(name, "outline-width")) { style.outline_width = Props.width_of(CssNumbers.length(reader, context)); return true; }
        if (CssNames.equal(name, "outline-style")) {
            style.outline_style = Props.keyword(first.text);
            return style.outline_style != Keyword.UNKNOWN;
        }
        if (CssNames.equal(name, "outline-color")) { return Props.color(reader, context, style, &style.outline_color); }
        if (CssNames.equal(name, "outline-offset")) {
            Length offset = CssNumbers.length(reader, context);
            if (offset.unit != Unit.PX) { return false; }
            style.outline_offset = offset.value;
            return true;
        }
        if (CssNames.equal(name, "display")) {
            u8 value = Props.display(first.text);
            if (value == Keyword.UNKNOWN) { return false; }
            style.display = value;
            return true;
        }
        if (CssNames.equal(name, "color")) {
            return Colors.read(reader, context, parent.color, &style.color);
        }
        if (CssNames.equal(name, "background-color")) {
            return Props.color(reader, context, style, &style.background);
        }
        if (CssNames.equal(name, "background")) {
            while (!reader.done()) {
                u32 before = reader.pos;
                mut u32 color = 0;
                if (Props.color(reader, context, style, &color)) {
                    style.background = color;
                    return true;
                }
                if (reader.pos == before) {
                    reader.next();
                }
            }
            return true;
        }
        if (CssNames.equal(name, "transition") || CssNames.equal(name, "transition-duration")) {
            // The first duration of each comma separated item goes to the property it names: 'transform' has its own
            // time (it moves with a spring), everything else (colors, opacity, all) shares the other one.
            mut u32 colors = 0;
            mut u32 moves = 0;
            mut bool for_colors = true;
            mut bool for_moves = true;
            while (!reader.done()) {
                u32 before = reader.pos;
                CssToken word = reader.peek();
                if (word.kind == CssKind.COMMA) {
                    reader.next();
                    for_colors = true;
                    for_moves = true;
                    continue;
                }
                if (word.kind == CssKind.IDENT) {
                    reader.next();
                    if (CssNames.equal(word.text, "transform")) {
                        for_colors = false;
                        for_moves = true;
                    } else if (CssNames.equal(word.text, "all")) {
                        for_colors = true;
                        for_moves = true;
                    } else if (!(CssNames.equal(word.text, "ease") || CssNames.equal(word.text, "ease-in")
                        || CssNames.equal(word.text, "ease-out") || CssNames.equal(word.text, "ease-in-out")
                        || CssNames.equal(word.text, "linear") || CssNames.equal(word.text, "spring")
                        || CssNames.equal(word.text, "none"))) {
                        for_colors = true;
                        for_moves = false;
                    }
                    continue;
                }
                Numeric amount = CssNumbers.read(reader, context);
                if (amount.unit == Unit.NUMBER && amount.value > 0.0) {
                    if (for_colors && colors == 0) {
                        colors = (u32)amount.value;
                    }
                    if (for_moves && moves == 0) {
                        moves = (u32)amount.value;
                    }
                }
                if (reader.pos == before) {
                    reader.next();
                }
            }
            style.transition_ms = colors;
            style.transform_ms = moves;
            return true;
        }
        if (CssNames.equal(name, "transform")) {
            // scale(n), scale(x, y) (the larger counts), translate(x, y), translateX(x), translateY(y); 'none' resets
            mut f32 scale = (f32)1.0;
            mut f32 across = (f32)0.0;
            mut f32 down = (f32)0.0;
            mut f32 turn = (f32)0.0;
            while (!reader.done()) {
                CssToken word = reader.next();
                if (word.kind != CssKind.FUNCTION) {
                    continue;
                }
                u32 close = reader.closing();
                mut ValueReader inner = ValueReader.over(reader.tokens, reader.pos, close);
                reader.pos = close + 1;
                if (CssNames.equal(word.text, "scale")) {
                    Numeric amount = CssNumbers.read(&inner, context);
                    if (amount.unit == Unit.NUMBER) {
                        scale = (f32)amount.value;
                    } else if (amount.unit == Unit.PERCENT) {
                        scale = (f32)(amount.value / 100.0);
                    }
                } else if (CssNames.equal(word.text, "translate") || CssNames.equal(word.text, "translatex")) {
                    Length x = CssNumbers.length(&inner, context);
                    if (x.unit == Unit.PX) {
                        across = x.value;
                    }
                    if (inner.peek().kind == CssKind.COMMA) {
                        inner.next();
                    }
                    if (!inner.done()) {
                        Length y = CssNumbers.length(&inner, context);
                        if (y.unit == Unit.PX) {
                            down = y.value;
                        }
                    }
                } else if (CssNames.equal(word.text, "rotate")) {
                    Numeric angle = CssNumbers.read(&inner, context);
                    if (angle.unit == Unit.DEGREES) {
                        turn = (f32)angle.value;
                    }
                } else if (CssNames.equal(word.text, "translatey")) {
                    Length y = CssNumbers.length(&inner, context);
                    if (y.unit == Unit.PX) {
                        down = y.value;
                    }
                }
            }
            style.transform_scale = scale;
            style.translate_x = across;
            style.translate_y = down;
            style.transform_rotate = turn;
            return true;
        }
        if (CssNames.equal(name, "transform-origin")) {
            // one or two of: left | center | right | top | bottom | <percentage> | <length>
            mut f32 first_pct = (f32)0.5;
            mut f32 first_px = (f32)0.0;
            mut f32 second_pct = (f32)0.5;
            mut f32 second_px = (f32)0.0;
            mut bool first_vertical = false;
            mut u32 count = 0;
            while (!reader.done() && count < 2) {
                CssToken word = reader.peek();
                mut f32 pct = (f32)0.5;
                mut f32 px = (f32)0.0;
                mut bool vertical = false;
                if (word.kind == CssKind.IDENT) {
                    reader.next();
                    if (CssNames.equal(word.text, "left")) { pct = (f32)0.0; }
                    else if (CssNames.equal(word.text, "right")) { pct = (f32)1.0; }
                    else if (CssNames.equal(word.text, "top")) { pct = (f32)0.0; vertical = true; }
                    else if (CssNames.equal(word.text, "bottom")) { pct = (f32)1.0; vertical = true; }
                    else if (!CssNames.equal(word.text, "center")) { return false; }
                } else {
                    Length part = CssNumbers.length(reader, context);
                    if (part.unit == Unit.PERCENT) {
                        pct = part.value / (f32)100.0;
                    } else if (part.unit == Unit.PX) {
                        pct = (f32)0.0;
                        px = part.value;
                    } else {
                        return false;
                    }
                }
                if (count == 0) {
                    first_pct = pct;
                    first_px = px;
                    first_vertical = vertical;
                } else {
                    second_pct = pct;
                    second_px = px;
                }
                count = count + 1;
            }
            if (count == 0) {
                return false;
            }
            if (first_vertical && count == 2) {
                style.origin_x = second_pct;
                style.origin_x_px = second_px;
                style.origin_y = first_pct;
                style.origin_y_px = first_px;
            } else if (first_vertical) {
                style.origin_x = (f32)0.5;
                style.origin_x_px = (f32)0.0;
                style.origin_y = first_pct;
                style.origin_y_px = first_px;
            } else {
                style.origin_x = first_pct;
                style.origin_x_px = first_px;
                style.origin_y = second_pct;
                style.origin_y_px = second_px;
            }
            return true;
        }
        if (CssNames.equal(name, "opacity")) {
            Numeric value = CssNumbers.read(reader, context);
            if (value.unit == Unit.NUMBER) { style.opacity = (f32)value.value; return true; }
            if (value.unit == Unit.PERCENT) { style.opacity = (f32)(value.value / 100.0); return true; }
            return false;
        }
        if (CssNames.equal(name, "font-size")) {
            if (first.kind == CssKind.IDENT) {
                f64 base = (f64)parent.font_size;
                mut f64 size = 0.0;
                if (CssNames.equal(first.text, "smaller")) { size = base / 1.2; }
                else if (CssNames.equal(first.text, "larger")) { size = base * 1.2; }
                else if (CssNames.equal(first.text, "small")) { size = 13.0; }
                else if (CssNames.equal(first.text, "medium")) { size = 16.0; }
                else if (CssNames.equal(first.text, "large")) { size = 18.0; }
                else { return false; }
                style.font_size = (f32)size;
                return true;
            }
            Length value = CssNumbers.length(reader, context);
            if (value.unit == Unit.PX) { style.font_size = value.value; return true; }
            if (value.unit == Unit.PERCENT) { style.font_size = parent.font_size * value.value / (f32)100.0; return true; }
            return false;
        }
        if (CssNames.equal(name, "font-weight")) {
            if (first.kind == CssKind.NUMBER) { style.font_weight = (u16)first.number; return true; }
            if (CssNames.equal(first.text, "normal")) { style.font_weight = 400; return true; }
            if (CssNames.equal(first.text, "bold")) { style.font_weight = 700; return true; }
            if (CssNames.equal(first.text, "bolder")) { style.font_weight = 700; return true; }
            if (CssNames.equal(first.text, "lighter")) { style.font_weight = 300; return true; }
            return false;
        }
        if (CssNames.equal(name, "font-style")) {
            style.font_style = Props.keyword(first.text);
            return style.font_style != Keyword.UNKNOWN;
        }
        if (CssNames.equal(name, "font-family")) {
            CssToken last = reader.tokens.get(reader.end - 1);
            str all = { .data = CssDeclarations.source_of(reader, first), .length = (size)(last.end - first.start) };
            style.font_family = all;
            return true;
        }
        if (CssNames.equal(name, "line-height")) {
            style.line_factor = (f32)0.0;
            if (first.kind == CssKind.IDENT && CssNames.equal(first.text, "normal")) { style.line_height = (f32)0.0; return true; }
            Numeric value = CssNumbers.read(reader, context);
            if (value.unit == Unit.NUMBER) { style.line_height = (f32)0.0; style.line_factor = (f32)value.value; return true; }
            if (value.unit == Unit.PX) { style.line_height = (f32)value.value; return true; }
            if (value.unit == Unit.PERCENT) { style.line_height = (f32)(value.value / 100.0 * (f64)style.font_size); return true; }
            return false;
        }
        if (CssNames.equal(name, "letter-spacing")) {
            if (CssNames.equal(first.text, "normal")) { style.letter_spacing = (f32)0.0; return true; }
            style.letter_spacing = Props.width_of(CssNumbers.length(reader, context));
            return true;
        }

        if (CssNames.equal(name, "text-align")) { style.text_align = Props.keyword(first.text); return style.text_align != Keyword.UNKNOWN; }
        if (CssNames.equal(name, "text-decoration") || CssNames.equal(name, "text-decoration-line")) { style.text_decoration = Props.keyword(first.text); return true; }
        if (CssNames.equal(name, "cursor")) { style.cursor = Props.keyword(first.text); return true; }
        if (CssNames.equal(name, "position")) { style.position = Props.keyword(first.text); return style.position != Keyword.UNKNOWN; }
        if (CssNames.equal(name, "visibility")) { style.visibility = Props.keyword(first.text); return style.visibility != Keyword.UNKNOWN; }
        if (CssNames.equal(name, "overflow")) { style.overflow = Props.keyword(first.text); return style.overflow != Keyword.UNKNOWN; }
        if (CssNames.equal(name, "box-sizing")) { style.box_sizing = Props.keyword(first.text); return style.box_sizing != Keyword.UNKNOWN; }
        if (CssNames.equal(name, "z-index")) {
            if (first.kind == CssKind.NUMBER) { style.z_index = (i32)first.number; }
            return true;
        }
        if (CssNames.equal(name, "flex-direction")) { style.flex_direction = Props.keyword(first.text); return true; }
        if (CssNames.equal(name, "flex-wrap")) { style.flex_wrap = Props.keyword(first.text); return true; }
        if (CssNames.equal(name, "justify-content")) { style.justify_content = Props.keyword(first.text); return true; }
        if (CssNames.equal(name, "align-items")) { style.align_items = Props.keyword(first.text); return true; }
        if (CssNames.equal(name, "align-self")) { style.align_self = Props.keyword(first.text); return true; }
        if (CssNames.equal(name, "align-content")) { style.align_content = Props.keyword(first.text); return style.align_content != Keyword.UNKNOWN; }
        if (CssNames.equal(name, "justify-items")) { style.justify_items = Props.alignment(reader); return style.justify_items != Keyword.UNKNOWN; }
        if (CssNames.equal(name, "justify-self")) { style.justify_self = Props.alignment(reader); return style.justify_self != Keyword.UNKNOWN; }
        if (CssNames.equal(name, "place-items") || CssNames.equal(name, "place-content") || CssNames.equal(name, "place-self")) {
            u8 align = Props.alignment(reader);
            mut u8 justify = align;
            if (!reader.done()) {
                justify = Props.alignment(reader);
            }
            if (align == Keyword.UNKNOWN || justify == Keyword.UNKNOWN) {
                return false;
            }
            if (CssNames.equal(name, "place-items")) { style.align_items = align; style.justify_items = justify; }
            else if (CssNames.equal(name, "place-content")) { style.align_content = align; style.justify_content = justify; }
            else { style.align_self = align; style.justify_self = justify; }
            return true;
        }
        if (CssNames.equal(name, "order")) {
            if (first.kind != CssKind.NUMBER || first.number > 1000000.0 || first.number < -1000000.0) { return false; }
            style.order = (i32)first.number;
            return true;
        }
        if (CssNames.equal(name, "top")) { style.inset_top = CssNumbers.length(reader, context); return style.inset_top.unit != Unit.INVALID; }
        if (CssNames.equal(name, "right")) { style.inset_right = CssNumbers.length(reader, context); return style.inset_right.unit != Unit.INVALID; }
        if (CssNames.equal(name, "bottom")) { style.inset_bottom = CssNumbers.length(reader, context); return style.inset_bottom.unit != Unit.INVALID; }
        if (CssNames.equal(name, "left")) { style.inset_left = CssNumbers.length(reader, context); return style.inset_left.unit != Unit.INVALID; }
        if (CssNames.equal(name, "inset")) {
            Length* values = (Length*)__djinn_alloc_zeroed((size_long)(4 * sizeof(Length)));
            bool ok = Props.sides(reader, context, values);
            if (ok) {
                style.inset_top = values[0];
                style.inset_right = values[1];
                style.inset_bottom = values[2];
                style.inset_left = values[3];
            }
            __djinn_free((void*)values);
            return ok;
        }
        if (CssNames.equal(name, "inset-inline") || CssNames.equal(name, "inset-block")) {
            Length start = CssNumbers.length(reader, context);
            mut Length end = start;
            if (!reader.done()) { end = CssNumbers.length(reader, context); }
            if (start.unit == Unit.INVALID || end.unit == Unit.INVALID) { return false; }
            if (CssNames.equal(name, "inset-inline")) { style.inset_left = start; style.inset_right = end; }
            else { style.inset_top = start; style.inset_bottom = end; }
            return true;
        }
        if (CssNames.equal(name, "aspect-ratio")) {
            if (first.kind == CssKind.IDENT && CssNames.equal(first.text, "auto")) { style.aspect_ratio = (f32)0.0; return true; }
            Numeric width = CssNumbers.read(reader, context);
            if (width.unit != Unit.NUMBER || width.value <= 0.0) { return false; }
            mut f64 height = 1.0;
            if (reader.is_delim("/")) {
                reader.next();
                Numeric below = CssNumbers.read(reader, context);
                if (below.unit != Unit.NUMBER || below.value <= 0.0) { return false; }
                height = below.value;
            }
            style.aspect_ratio = (f32)(width.value / height);
            return true;
        }
        if (CssNames.equal(name, "grid-template-columns")) { return GridTemplates.read(reader, context, &style.grid_columns); }
        if (CssNames.equal(name, "grid-template-rows")) { return GridTemplates.read(reader, context, &style.grid_rows); }
        if (CssNames.equal(name, "grid-auto-columns")) { return GridTemplates.read(reader, context, &style.grid_auto_columns); }
        if (CssNames.equal(name, "grid-auto-rows")) { return GridTemplates.read(reader, context, &style.grid_auto_rows); }
        if (CssNames.equal(name, "grid-auto-flow")) {
            mut u8 flow = Keyword.ROW;
            mut bool dense = false;
            while (!reader.done()) {
                CssToken word = reader.next();
                if (CssNames.equal(word.text, "row")) { flow = Keyword.ROW; }
                else if (CssNames.equal(word.text, "column")) { flow = Keyword.COLUMN; }
                else if (CssNames.equal(word.text, "dense")) { dense = true; }
                else { return false; }
            }
            style.grid_flow = flow;
            style.grid_dense = dense;
            return true;
        }
        if (CssNames.equal(name, "grid-column")) { return GridTemplates.placement(reader, &style.grid_column); }
        if (CssNames.equal(name, "grid-row")) { return GridTemplates.placement(reader, &style.grid_row); }
        if (CssNames.equal(name, "grid-column-start")) { return GridTemplates.side(reader, &style.grid_column.start, &style.grid_column.start_span); }
        if (CssNames.equal(name, "grid-column-end")) { return GridTemplates.side(reader, &style.grid_column.end, &style.grid_column.end_span); }
        if (CssNames.equal(name, "grid-row-start")) { return GridTemplates.side(reader, &style.grid_row.start, &style.grid_row.start_span); }
        if (CssNames.equal(name, "grid-row-end")) { return GridTemplates.side(reader, &style.grid_row.end, &style.grid_row.end_span); }
        if (CssNames.equal(name, "grid-area")) {
            if (!GridTemplates.side(reader, &style.grid_row.start, &style.grid_row.start_span)) { return false; }
            if (reader.is_delim("/")) {
                reader.next();
                if (!GridTemplates.side(reader, &style.grid_column.start, &style.grid_column.start_span)) { return false; }
            }
            if (reader.is_delim("/")) {
                reader.next();
                if (!GridTemplates.side(reader, &style.grid_row.end, &style.grid_row.end_span)) { return false; }
            }
            if (reader.is_delim("/")) {
                reader.next();
                if (!GridTemplates.side(reader, &style.grid_column.end, &style.grid_column.end_span)) { return false; }
            }
            return true;
        }
        if (CssNames.equal(name, "flex-grow")) { style.flex_grow = (f32)CssNumbers.read(reader, context).value; return true; }
        if (CssNames.equal(name, "flex-shrink")) { style.flex_shrink = (f32)CssNumbers.read(reader, context).value; return true; }
        if (CssNames.equal(name, "flex-basis")) { style.flex_basis = CssNumbers.length(reader, context); return style.flex_basis.unit != Unit.INVALID; }
        if (CssNames.equal(name, "flex")) {
            if (first.kind == CssKind.IDENT && CssNames.equal(first.text, "none")) {
                style.flex_grow = (f32)0.0;
                style.flex_shrink = (f32)0.0;
                style.flex_basis = Length.automatic();
                return true;
            }
            if (first.kind == CssKind.IDENT && CssNames.equal(first.text, "auto")) {
                style.flex_grow = (f32)1.0;
                style.flex_shrink = (f32)1.0;
                style.flex_basis = Length.automatic();
                return true;
            }
            style.flex_grow = (f32)CssNumbers.read(reader, context).value;
            style.flex_shrink = (f32)1.0;
            style.flex_basis = Length.of(Unit.PERCENT, (f32)0.0);
            if (!reader.done() && reader.peek().kind == CssKind.NUMBER) {
                style.flex_shrink = (f32)CssNumbers.read(reader, context).value;
            }
            if (!reader.done()) {
                style.flex_basis = CssNumbers.length(reader, context);
            }
            return true;
        }
        if (CssNames.equal(name, "gap")) {
            Length row = CssNumbers.length(reader, context);
            if (row.unit == Unit.INVALID) { return false; }
            mut Length column = row;
            if (!reader.done()) {
                column = CssNumbers.length(reader, context);
            }
            style.row_gap = row;
            style.column_gap = column;
            return true;
        }
        if (CssNames.equal(name, "row-gap")) { style.row_gap = CssNumbers.length(reader, context); return true; }
        if (CssNames.equal(name, "column-gap")) { style.column_gap = CssNumbers.length(reader, context); return true; }
        if (CssNames.equal(name, "padding") || CssNames.equal(name, "margin")) {
            Length* values = (Length*)__djinn_alloc_zeroed((size_long)(4 * sizeof(Length)));
            bool ok = Props.sides(reader, context, values);
            if (ok && CssNames.equal(name, "padding")) {
                style.padding_top = values[0];
                style.padding_right = values[1];
                style.padding_bottom = values[2];
                style.padding_left = values[3];
            } else if (ok) {
                style.margin_top = values[0];
                style.margin_right = values[1];
                style.margin_bottom = values[2];
                style.margin_left = values[3];
            }
            __djinn_free((void*)values);
            return ok;
        }
        if (CssNames.equal(name, "padding-top")) { style.padding_top = CssNumbers.length(reader, context); return true; }
        if (CssNames.equal(name, "padding-right")) { style.padding_right = CssNumbers.length(reader, context); return true; }
        if (CssNames.equal(name, "padding-bottom")) { style.padding_bottom = CssNumbers.length(reader, context); return true; }
        if (CssNames.equal(name, "padding-left")) { style.padding_left = CssNumbers.length(reader, context); return true; }
        if (CssNames.equal(name, "padding-inline") || CssNames.equal(name, "padding-block")) {
            Length start = CssNumbers.length(reader, context);
            mut Length end = start;
            if (!reader.done()) { end = CssNumbers.length(reader, context); }
            if (CssNames.equal(name, "padding-inline")) { style.padding_left = start; style.padding_right = end; }
            else { style.padding_top = start; style.padding_bottom = end; }
            return true;
        }
        if (CssNames.equal(name, "margin-top")) { style.margin_top = CssNumbers.length(reader, context); return true; }
        if (CssNames.equal(name, "margin-right")) { style.margin_right = CssNumbers.length(reader, context); return true; }
        if (CssNames.equal(name, "margin-bottom")) { style.margin_bottom = CssNumbers.length(reader, context); return true; }
        if (CssNames.equal(name, "margin-left")) { style.margin_left = CssNumbers.length(reader, context); return true; }
        if (CssNames.equal(name, "margin-inline") || CssNames.equal(name, "margin-block")) {
            Length start = CssNumbers.length(reader, context);
            mut Length end = start;
            if (!reader.done()) { end = CssNumbers.length(reader, context); }
            if (CssNames.equal(name, "margin-inline")) { style.margin_left = start; style.margin_right = end; }
            else { style.margin_top = start; style.margin_bottom = end; }
            return true;
        }
        if (CssNames.equal(name, "border")) { return Props.border(reader, context, style, 0); }
        if (CssNames.equal(name, "border-top")) { return Props.border(reader, context, style, 1); }
        if (CssNames.equal(name, "border-right")) { return Props.border(reader, context, style, 2); }
        if (CssNames.equal(name, "border-bottom")) { return Props.border(reader, context, style, 3); }
        if (CssNames.equal(name, "border-left")) { return Props.border(reader, context, style, 4); }
        if (CssNames.equal(name, "border-width")) {
            Length* values = (Length*)__djinn_alloc_zeroed((size_long)(4 * sizeof(Length)));
            bool ok = Props.sides(reader, context, values);
            if (ok) {
                style.border_top = Props.width_of(values[0]);
                style.border_right = Props.width_of(values[1]);
                style.border_bottom = Props.width_of(values[2]);
                style.border_left = Props.width_of(values[3]);
            }
            __djinn_free((void*)values);
            return ok;
        }
        if (CssNames.equal(name, "border-style")) { style.border_style = Props.keyword(first.text); return true; }
        if (CssNames.equal(name, "border-color")) { return Props.color(reader, context, style, &style.border_color); }
        if (CssNames.equal(name, "border-radius")) {
            Length value = CssNumbers.length(reader, context);
            if (value.unit != Unit.PX) { return false; }
            style.border_radius = value.value;
            return true;
        }
        if (CssNames.equal(name, "width")) { style.width = CssNumbers.length(reader, context); return style.width.unit != Unit.INVALID; }
        if (CssNames.equal(name, "height")) { style.height = CssNumbers.length(reader, context); return style.height.unit != Unit.INVALID; }
        if (CssNames.equal(name, "min-width")) { style.min_width = CssNumbers.length(reader, context); return true; }
        if (CssNames.equal(name, "min-height")) { style.min_height = CssNumbers.length(reader, context); return true; }
        if (CssNames.equal(name, "max-width")) { style.max_width = CssNumbers.length(reader, context); return true; }
        if (CssNames.equal(name, "max-height")) { style.max_height = CssNumbers.length(reader, context); return true; }
        known[0] = false;
        return true;
    }
}

struct CssDeclarations {
    public static unsafe i8* source_of(ValueReader* reader, CssToken first) {
        return CssDeclarations.base(reader) + first.start;
    }

    // The text the reader's tokens were made from (stored by Styles before applying a declaration).
    public static unsafe i8* base(ValueReader* reader) {
        return (i8*)reader.text;
    }
}
