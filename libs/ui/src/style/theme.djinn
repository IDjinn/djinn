import std::types;
import std::libc;

namespace ui;

// What every element starts from, as a browser's own stylesheet: which elements are blocks, headings, emphasis.
struct BrowserStyles {
    public static str css() {
        return """
html, body, div, section, article, main, header, footer, nav, aside, ul, ol, li, p, h1, h2, h3, h4, h5, h6,
form, fieldset, blockquote, figure, figcaption, hr, pre, table, dl, dt, dd, details, summary, dialog, address, menu, legend {
    display: block;
}
head, script, style, template, title, meta, link, [hidden] { display: none; }
b, strong { font-weight: 700; }
i, em, cite { font-style: italic; }
h1 { font-size: 2em; font-weight: 700; margin: 0.67em 0; }
h2 { font-size: 1.5em; font-weight: 700; margin: 0.83em 0; }
h3 { font-size: 1.17em; font-weight: 700; margin: 1em 0; }
h4, h5, h6 { font-weight: 700; margin: 1.33em 0; }
p, blockquote, figure, dl { margin: 1em 0; }
ul, ol { margin: 1em 0; padding-left: 40px; }
body { margin: 8px; }
small { font-size: 0.83em; }
code, kbd, samp, pre { font-family: monospace; }
button, input, select, textarea, img, output { display: inline-block; }
a { color: #0000ee; text-decoration: underline; cursor: pointer; }
hr { border-top: 1px solid gray; margin: 0.5em 0; }
""";
    }
}

struct ThemeMode {
    const u8 SYSTEM = 0;
    const u8 LIGHT = 1;
    const u8 DARK = 2;
}

// The built-in look: the same on every platform, light and dark. Colors, radii and fonts are custom properties on
// ':root' ('--ui-*'), so an app restyles it by overriding them; 'data-theme' on the document picks the mode, and
// without it the system preference decides (prefers-color-scheme).
struct Theme {
    public static str css() {
        return """
:root {
    --ui-font: "Segoe UI Variable", "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
    --ui-mono: "Cascadia Code", "SF Mono", Consolas, "Liberation Mono", monospace;
    --ui-radius: 8px;
    --ui-radius-small: 6px;
    --ui-bg: #ffffff;
    --ui-surface: #f6f7f9;
    --ui-surface-2: #eceef2;
    --ui-fg: #1b1f24;
    --ui-muted: #5b6470;
    --ui-border: #d8dde3;
    --ui-accent: #2563eb;
    --ui-accent-hover: #1d4ed8;
    --ui-accent-fg: #ffffff;
    --ui-danger: #dc2626;
    --ui-success: #16a34a;
    --ui-focus: rgb(37 99 235 / 0.45);
    color-scheme: light;
    background-color: var(--ui-bg);
    color: var(--ui-fg);
    font-family: var(--ui-font);
    font-size: 16px;
}
:root > *, body { font-size: 14px; line-height: 1.5; }
:root[data-theme="dark"] {
    --ui-bg: #0f1115;
    --ui-surface: #171a21;
    --ui-surface-2: #1f232c;
    --ui-fg: #e6e9ee;
    --ui-muted: #9aa3ae;
    --ui-border: #2a2f39;
    --ui-accent: #4f8cff;
    --ui-accent-hover: #6ea0ff;
    --ui-accent-fg: #0b1020;
    --ui-danger: #f87171;
    --ui-success: #4ade80;
    --ui-focus: rgb(79 140 255 / 0.5);
    color-scheme: dark;
}
@media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
        --ui-bg: #0f1115;
        --ui-surface: #171a21;
        --ui-surface-2: #1f232c;
        --ui-fg: #e6e9ee;
        --ui-muted: #9aa3ae;
        --ui-border: #2a2f39;
        --ui-accent: #4f8cff;
        --ui-accent-hover: #6ea0ff;
        --ui-accent-fg: #0b1020;
        --ui-danger: #f87171;
        --ui-success: #4ade80;
        --ui-focus: rgb(79 140 255 / 0.5);
        color-scheme: dark;
    }
}
body { margin: 0; }
h1 { font-size: 28px; font-weight: 650; margin: 0 0 12px; line-height: 1.25; }
h2 { font-size: 20px; font-weight: 600; margin: 0 0 8px; line-height: 1.3; }
h3 { font-size: 16px; font-weight: 600; margin: 0 0 6px; }
p { margin: 0 0 8px; }
ul, ol { margin: 0 0 8px; padding-left: 20px; }
a { color: var(--ui-accent); text-decoration: none; }
a:hover { text-decoration: underline; }
small { color: var(--ui-muted); font-size: 12px; }
code, kbd, pre {
    font-family: var(--ui-mono);
    font-size: 13px;
    background-color: var(--ui-surface-2);
    border-radius: var(--ui-radius-small);
    padding: 1px 5px;
}
hr { border-top: 1px solid var(--ui-border); margin: 12px 0; }
button {
    font-family: inherit;
    font-size: inherit;
    font-weight: 500;
    line-height: 20px;
    padding: 6px 14px;
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius);
    background-color: var(--ui-surface);
    color: var(--ui-fg);
    cursor: pointer;
}
button:hover { background-color: var(--ui-surface-2); }
button:active { background-color: var(--ui-border); }
button:focus-visible { border-color: var(--ui-accent); }
button:disabled { opacity: 0.5; cursor: not-allowed; }
button.primary, button[data-variant="primary"] {
    background-color: var(--ui-accent);
    border-color: var(--ui-accent);
    color: var(--ui-accent-fg);
}
button.primary:hover, button[data-variant="primary"]:hover {
    background-color: var(--ui-accent-hover);
    border-color: var(--ui-accent-hover);
}
button.danger, button[data-variant="danger"] {
    background-color: var(--ui-danger);
    border-color: var(--ui-danger);
    color: #ffffff;
}
input, textarea, select {
    font-family: inherit;
    font-size: inherit;
    line-height: 20px;
    padding: 6px 10px;
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius);
    background-color: var(--ui-bg);
    color: var(--ui-fg);
}
input:focus, textarea:focus, select:focus { border-color: var(--ui-accent); }
input:disabled, textarea:disabled, select:disabled { opacity: 0.5; cursor: not-allowed; }
output { font-variant-numeric: tabular-nums; font-weight: 600; }
.card {
    background-color: var(--ui-surface);
    border: 1px solid var(--ui-border);
    border-radius: calc(var(--ui-radius) + 4px);
    padding: 16px;
}
.badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    background-color: var(--ui-surface-2);
    color: var(--ui-muted);
    font-size: 12px;
    font-weight: 600;
}
.muted { color: var(--ui-muted); }
""";
    }

    // LIGHT and DARK force the mode; SYSTEM follows the OS (the host reports it with Styles.set_prefers_dark).
    public static unsafe void set(u8 mode) {
        u32 root = Dom.document();
        if (mode == ThemeMode.LIGHT) {
            str light = "light";
            Dom.set_attr(root, "data-theme", light.data, (u32)light.length);
        } else if (mode == ThemeMode.DARK) {
            str dark = "dark";
            Dom.set_attr(root, "data-theme", dark.data, (u32)dark.length);
        } else {
            Dom.remove_attr(root, "data-theme");
        }
    }

    public static unsafe u8 mode() {
        u32 root = Dom.document();
        if (!Dom.has_attr(root, "data-theme")) {
            return ThemeMode.SYSTEM;
        }
        if (Texts.same(Dom.attr(root, "data-theme"), "dark")) {
            return ThemeMode.DARK;
        }
        return ThemeMode.LIGHT;
    }

    // Whether the document currently renders dark (forced, or by system preference).
    public static unsafe bool is_dark() {
        return Styles.of(Dom.document()).dark_scheme;
    }
}
