import std::types;
import std::libc;

namespace ui;

// What every element starts from, as a browser's own stylesheet: which elements are blocks, headings, emphasis.
struct BrowserStyles {
    public static str css() {
        return """
html, body, div, section, article, main, header, footer, nav, aside, ul, ol, li, p, h1, h2, h3, h4, h5, h6,
form, fieldset, blockquote, figure, figcaption, hr, pre, table, dl, dt, dd, details, summary, dialog, address, menu, legend {
    display: block;
}
head, script, style, template, title, meta, link, [hidden] { display: none; }
b, strong { font-weight: 700; }
i, em, cite { font-style: italic; }
h1 { font-size: 2em; font-weight: 700; margin: 0.67em 0; }
h2 { font-size: 1.5em; font-weight: 700; margin: 0.83em 0; }
h3 { font-size: 1.17em; font-weight: 700; margin: 1em 0; }
h4, h5, h6 { font-weight: 700; margin: 1.33em 0; }
p, blockquote, figure, dl { margin: 1em 0; }
ul, ol { margin: 1em 0; padding-left: 40px; }
body { margin: 8px; }
small { font-size: 0.83em; }
code, kbd, samp, pre { font-family: monospace; }
button, input, select, textarea, img, output { display: inline-block; }
a { color: #0000ee; text-decoration: underline; cursor: pointer; }
hr { border-top: 1px solid gray; margin: 0.5em 0; }
""";
    }
}

struct ThemeMode {
    const u8 SYSTEM = 0;
    const u8 LIGHT = 1;
    const u8 DARK = 2;
}

// The built-in look: the same on every platform, light and dark, and responsive without the app asking for it.
//
// - Tokens are custom properties on ':root' ('--ui-*'), so an app restyles the theme by overriding them. Each color
//   is written once per scheme ('--ui-bg-light', '--ui-bg-dark') and joined with light-dark(), which follows
//   'color-scheme': the system preference by default, 'data-theme' on the document or on any subtree to force one.
// - Everything is in the cascade layers 'ui-base', 'ui-components' and 'ui-layout' with ':where()' selectors, so
//   any rule of the app wins without a specificity fight.
// - Sizes are rem and em and the root font size is left alone, so the OS and browser text size settings scale the
//   whole interface. Headings and gutters are fluid (clamp() of a rem and a viewport part); controls have a minimum
//   size that grows on touch screens; nothing has a fixed height.
// - The layout classes ('.page', '.stack', '.cluster', '.tiles', '.split') reflow by the space they are given
//   (wrapping flex lines, auto-fit grid columns), not by viewport breakpoints.
// - 'prefers-contrast: more' strengthens borders and muted text; with forced colors the tokens become system colors.
struct Theme {
    public static str css() {
        return """
@layer ui-base, ui-components, ui-layout;

@layer ui-base {
    :root {
        --ui-bg-light: #ffffff;
        --ui-bg-dark: #0f1115;
        --ui-surface-light: #f6f7f9;
        --ui-surface-dark: #171a21;
        --ui-surface-2-light: #eceef2;
        --ui-surface-2-dark: #1f232c;
        --ui-fg-light: #1b1f24;
        --ui-fg-dark: #e6e9ee;
        --ui-muted-light: #5b6470;
        --ui-muted-dark: #9aa3ae;
        --ui-border-light: #d8dde3;
        --ui-border-dark: #2a2f39;
        --ui-control-border-light: #8a94a1;
        --ui-control-border-dark: #6b7480;
        --ui-accent-light: #2563eb;
        --ui-accent-dark: #4f8cff;
        --ui-accent-hover-light: #1d4ed8;
        --ui-accent-hover-dark: #6ea0ff;
        --ui-accent-fg-light: #ffffff;
        --ui-accent-fg-dark: #0b1020;
        --ui-danger-light: #dc2626;
        --ui-danger-dark: #f87171;
        --ui-danger-fg-light: #ffffff;
        --ui-danger-fg-dark: #2a0a0a;
        --ui-success-light: #15803d;
        --ui-success-dark: #4ade80;
        --ui-focus-light: #1d4ed8;
        --ui-focus-dark: #9ec1ff;

        --ui-bg: var(--ui-bg-light);
        --ui-surface: var(--ui-surface-light);
        --ui-surface-2: var(--ui-surface-2-light);
        --ui-fg: var(--ui-fg-light);
        --ui-muted: var(--ui-muted-light);
        --ui-border: var(--ui-border-light);
        --ui-control-border: var(--ui-control-border-light);
        --ui-accent: var(--ui-accent-light);
        --ui-accent-hover: var(--ui-accent-hover-light);
        --ui-accent-fg: var(--ui-accent-fg-light);
        --ui-danger: var(--ui-danger-light);
        --ui-danger-fg: var(--ui-danger-fg-light);
        --ui-success: var(--ui-success-light);
        --ui-focus: var(--ui-focus-light);

        @supports (color: light-dark(white, black)) {
            --ui-bg: light-dark(var(--ui-bg-light), var(--ui-bg-dark));
            --ui-surface: light-dark(var(--ui-surface-light), var(--ui-surface-dark));
            --ui-surface-2: light-dark(var(--ui-surface-2-light), var(--ui-surface-2-dark));
            --ui-fg: light-dark(var(--ui-fg-light), var(--ui-fg-dark));
            --ui-muted: light-dark(var(--ui-muted-light), var(--ui-muted-dark));
            --ui-border: light-dark(var(--ui-border-light), var(--ui-border-dark));
            --ui-control-border: light-dark(var(--ui-control-border-light), var(--ui-control-border-dark));
            --ui-accent: light-dark(var(--ui-accent-light), var(--ui-accent-dark));
            --ui-accent-hover: light-dark(var(--ui-accent-hover-light), var(--ui-accent-hover-dark));
            --ui-accent-fg: light-dark(var(--ui-accent-fg-light), var(--ui-accent-fg-dark));
            --ui-danger: light-dark(var(--ui-danger-light), var(--ui-danger-dark));
            --ui-danger-fg: light-dark(var(--ui-danger-fg-light), var(--ui-danger-fg-dark));
            --ui-success: light-dark(var(--ui-success-light), var(--ui-success-dark));
            --ui-focus: light-dark(var(--ui-focus-light), var(--ui-focus-dark));
        }

        --ui-font: system-ui, "Segoe UI Variable", "Segoe UI", -apple-system, "Helvetica Neue", Arial, sans-serif;
        --ui-mono: ui-monospace, "Cascadia Code", "SF Mono", Consolas, "Liberation Mono", monospace;
        --ui-radius: 0.5rem;
        --ui-radius-small: 0.375rem;
        --ui-space-1: 0.25rem;
        --ui-space-2: 0.5rem;
        --ui-space-3: 0.75rem;
        --ui-space-4: 1rem;
        --ui-space-6: 1.5rem;
        --ui-gap: var(--ui-space-4);
        --ui-gutter: clamp(1rem, 0.5rem + 2.5vi, 2rem);
        --ui-text-small: 0.875rem;
        --ui-text-h1: clamp(1.75rem, 1.4rem + 1.75vi, 2.5rem);
        --ui-text-h2: clamp(1.375rem, 1.2rem + 0.9vi, 1.75rem);
        --ui-text-h3: 1.125rem;
        --ui-measure: 70ch;
        --ui-control-size: 2.5rem;
        --ui-page: 72rem;
        --ui-tile: 16rem;

        color-scheme: light dark;
        accent-color: var(--ui-accent);
        background-color: var(--ui-bg);
        color: var(--ui-fg);
        font-family: var(--ui-font);
        line-height: 1.5;
        overflow-wrap: break-word;
    }

    /* A scheme can be forced on the document or on any subtree; light-dark() follows it. */
    [data-theme="light"] { color-scheme: light; }
    [data-theme="dark"] { color-scheme: dark; }
    :where([data-theme]:not(:root)) {
        background-color: var(--ui-bg);
        color: var(--ui-fg);
        accent-color: var(--ui-accent);
    }

    /* Browsers without light-dark(): the same tokens, switched by the system preference or by data-theme. */
    @supports not (color: light-dark(white, black)) {
        @media (prefers-color-scheme: dark) {
            :root:not([data-theme="light"]) {
                --ui-bg: var(--ui-bg-dark);
                --ui-surface: var(--ui-surface-dark);
                --ui-surface-2: var(--ui-surface-2-dark);
                --ui-fg: var(--ui-fg-dark);
                --ui-muted: var(--ui-muted-dark);
                --ui-border: var(--ui-border-dark);
                --ui-control-border: var(--ui-control-border-dark);
                --ui-accent: var(--ui-accent-dark);
                --ui-accent-hover: var(--ui-accent-hover-dark);
                --ui-accent-fg: var(--ui-accent-fg-dark);
                --ui-danger: var(--ui-danger-dark);
                --ui-danger-fg: var(--ui-danger-fg-dark);
                --ui-success: var(--ui-success-dark);
                --ui-focus: var(--ui-focus-dark);
            }
        }
        :root[data-theme="dark"] {
            --ui-bg: var(--ui-bg-dark);
            --ui-surface: var(--ui-surface-dark);
            --ui-surface-2: var(--ui-surface-2-dark);
            --ui-fg: var(--ui-fg-dark);
            --ui-muted: var(--ui-muted-dark);
            --ui-border: var(--ui-border-dark);
            --ui-control-border: var(--ui-control-border-dark);
            --ui-accent: var(--ui-accent-dark);
            --ui-accent-hover: var(--ui-accent-hover-dark);
            --ui-accent-fg: var(--ui-accent-fg-dark);
            --ui-danger: var(--ui-danger-dark);
            --ui-danger-fg: var(--ui-danger-fg-dark);
            --ui-success: var(--ui-success-dark);
            --ui-focus: var(--ui-focus-dark);
        }
    }

    /* Touch screens get larger targets. */
    @media (pointer: coarse) {
        :root { --ui-control-size: 2.75rem; }
    }

    @media (prefers-contrast: more) {
        :root {
            --ui-border: var(--ui-fg);
            --ui-control-border: var(--ui-fg);
            --ui-muted: var(--ui-fg);
        }
    }

    /* Forced colors (Windows High Contrast): the tokens become the system palette. */
    @media (forced-colors: active) {
        :root {
            --ui-bg: Canvas;
            --ui-surface: Canvas;
            --ui-surface-2: Canvas;
            --ui-fg: CanvasText;
            --ui-muted: CanvasText;
            --ui-border: CanvasText;
            --ui-control-border: ButtonBorder;
            --ui-accent: Highlight;
            --ui-accent-hover: Highlight;
            --ui-accent-fg: HighlightText;
            --ui-danger: CanvasText;
            --ui-danger-fg: Canvas;
            --ui-success: CanvasText;
            --ui-focus: Highlight;
        }
    }

    :where(html, body, main, header, footer, nav, aside, section, article, div, p, ul, ol, li, form, fieldset, label,
        button, input, textarea, select, table, figure, dialog, details, summary, pre, blockquote, hr, img, video, canvas) {
        box-sizing: border-box;
    }
    :where(body) { margin: 0; }
    :where(body, :root > *) { min-block-size: 100dvb; }

    :where(h1, h2, h3, h4, h5, h6) {
        margin-block: 0 var(--ui-space-2);
        font-weight: 650;
        line-height: 1.2;
        text-wrap: balance;
    }
    :where(h1) { font-size: var(--ui-text-h1); }
    :where(h2) { font-size: var(--ui-text-h2); }
    :where(h3) { font-size: var(--ui-text-h3); }
    :where(h4, h5, h6) { font-size: 1rem; }
    :where(p) {
        margin-block: 0 var(--ui-space-3);
        max-inline-size: var(--ui-measure);
        text-wrap: pretty;
    }
    :where(ul, ol) {
        margin-block: 0 var(--ui-space-3);
        padding-inline-start: 1.5rem;
    }
    :where(a:any-link) {
        color: var(--ui-accent);
        text-decoration: underline;
        text-underline-offset: 0.15em;
    }
    :where(small) {
        color: var(--ui-muted);
        font-size: var(--ui-text-small);
    }
    :where(code, kbd, samp, pre) {
        font-family: var(--ui-mono);
        font-size: 0.875em;
    }
    :where(code, kbd) {
        background-color: var(--ui-surface-2);
        border-radius: var(--ui-radius-small);
        padding: 0.1em 0.35em;
    }
    :where(pre) {
        background-color: var(--ui-surface-2);
        border-radius: var(--ui-radius);
        padding: var(--ui-space-3);
        overflow: auto;
    }
    :where(hr) {
        border: 0;
        border-block-start: 1px solid var(--ui-border);
        margin-block: var(--ui-space-4);
    }
    :where(img, video, canvas) {
        display: block;
        max-inline-size: 100%;
        block-size: auto;
    }

    /* The focus ring is an outline, so it survives forced colors and never moves the layout. */
    :where(a:any-link, button, input, textarea, select, summary, [tabindex]):focus-visible {
        outline: 2px solid var(--ui-focus);
        outline-offset: 2px;
    }
    ::selection {
        background-color: var(--ui-accent);
        color: var(--ui-accent-fg);
    }
}

@layer ui-components {
    :where(button, input, textarea, select) {
        font: inherit;
        color: inherit;
        max-inline-size: 100%;
        border: 1px solid var(--ui-control-border);
        border-radius: var(--ui-radius);
        line-height: 1.25;
    }
    :where(button) {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--ui-space-2);
        min-block-size: var(--ui-control-size);
        min-inline-size: var(--ui-control-size);
        padding: var(--ui-space-2) var(--ui-space-4);
        background-color: var(--ui-surface);
        font-weight: 500;
        cursor: pointer;
        touch-action: manipulation;
        transition: background-color 120ms, border-color 120ms, color 120ms;
    }
    :where(button:hover:not(:disabled)) { background-color: var(--ui-surface-2); }
    :where(button:active:not(:disabled)) { background-color: var(--ui-border); }
    :where(button.primary, button[data-variant="primary"]) {
        background-color: var(--ui-accent);
        border-color: var(--ui-accent);
        color: var(--ui-accent-fg);
    }
    :where(button.primary, button[data-variant="primary"]):where(:hover:not(:disabled)) {
        background-color: var(--ui-accent-hover);
        border-color: var(--ui-accent-hover);
    }
    :where(button.danger, button[data-variant="danger"]) {
        background-color: var(--ui-danger);
        border-color: var(--ui-danger);
        color: var(--ui-danger-fg);
    }
    :where(input, textarea, select) {
        min-block-size: var(--ui-control-size);
        padding: var(--ui-space-2) var(--ui-space-3);
        background-color: var(--ui-bg);
    }
    :where(textarea) {
        min-block-size: 5rem;
        resize: vertical;
        field-sizing: content;
    }
    :where(input[type="checkbox"], input[type="radio"]) {
        min-block-size: 0;
        inline-size: 1.25rem;
        block-size: 1.25rem;
        padding: 0;
    }
    :where(input, textarea, select):user-invalid { border-color: var(--ui-danger); }
    :where(button, input, textarea, select):disabled {
        opacity: 0.55;
        cursor: not-allowed;
    }
    ::placeholder {
        color: var(--ui-muted);
        opacity: 1;
    }
    :where(output) {
        font-variant-numeric: tabular-nums;
        font-weight: 600;
    }
    :where(.card) {
        background-color: var(--ui-surface);
        border: 1px solid var(--ui-border);
        border-radius: calc(var(--ui-radius) + 0.25rem);
        padding: clamp(1rem, 0.75rem + 1vi, 1.5rem);
    }
    :where(.badge) {
        display: inline-block;
        padding: 0.125rem 0.5rem;
        border-radius: 999px;
        background-color: var(--ui-surface-2);
        color: var(--ui-muted);
        font-size: 0.75rem;
        font-weight: 600;
    }
    :where(.muted) { color: var(--ui-muted); }
}

@layer ui-layout {
    /* A centered column no wider than --ui-page, with fluid gutters. */
    :where(.page) {
        inline-size: 100%;
        max-inline-size: var(--ui-page);
        margin-inline: auto;
        padding: var(--ui-gutter);
    }
    /* Children one under the other, evenly spaced. */
    :where(.stack) {
        display: flex;
        flex-direction: column;
        gap: var(--ui-gap);
    }
    :where(.stack > *) { margin-block: 0; }
    /* Children side by side, wrapping to new lines when they run out of room. */
    :where(.cluster) {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--ui-gap);
    }
    /* As many equal columns as fit, each at least --ui-tile wide; one column on a narrow screen. */
    :where(.tiles) {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--ui-tile)), 1fr));
        gap: var(--ui-gap);
    }
    /* A sidebar (first child) beside the main content (last child); they stack when the content gets too narrow. */
    :where(.split) {
        display: flex;
        flex-wrap: wrap;
        gap: var(--ui-gap);
    }
    :where(.split > :first-child) { flex: 1 1 var(--ui-tile); }
    :where(.split > :last-child) {
        flex: 999 1 0;
        min-inline-size: 55%;
    }
}
""";
    }

    // LIGHT and DARK force the mode; SYSTEM follows the OS (the host reports it with Styles.set_prefers_dark).
    public static unsafe void set(u8 mode) {
        u32 root = Dom.document();
        if (mode == ThemeMode.LIGHT) {
            str light = "light";
            Dom.set_attr(root, "data-theme", light.data, (u32)light.length);
        } else if (mode == ThemeMode.DARK) {
            str dark = "dark";
            Dom.set_attr(root, "data-theme", dark.data, (u32)dark.length);
        } else {
            Dom.remove_attr(root, "data-theme");
        }
    }

    public static unsafe u8 mode() {
        u32 root = Dom.document();
        if (!Dom.has_attr(root, "data-theme")) {
            return ThemeMode.SYSTEM;
        }
        if (Texts.same(Dom.attr(root, "data-theme"), "dark")) {
            return ThemeMode.DARK;
        }
        return ThemeMode.LIGHT;
    }

    // Whether the document currently renders dark (forced, or by system preference).
    public static unsafe bool is_dark() {
        return Styles.of(Dom.document()).dark_scheme;
    }
}
