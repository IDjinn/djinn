import std::types;
import std::libc;

namespace ui;

struct CssKind {
    const u8 EOF = 0;
    const u8 IDENT = 1;
    const u8 FUNCTION = 2;
    const u8 AT = 3;
    const u8 HASH = 4;
    const u8 STRING = 5;
    const u8 NUMBER = 6;
    const u8 PERCENT = 7;
    const u8 DIMENSION = 8;
    const u8 SPACE = 9;
    const u8 COLON = 10;
    const u8 SEMICOLON = 11;
    const u8 COMMA = 12;
    const u8 OPEN_SQUARE = 13;
    const u8 CLOSE_SQUARE = 14;
    const u8 OPEN_PAREN = 15;
    const u8 CLOSE_PAREN = 16;
    const u8 OPEN_CURLY = 17;
    const u8 CLOSE_CURLY = 18;
    const u8 DELIM = 19;
}

// One token of CSS Syntax Level 3. 'text' is the unescaped name (ident, function without '(', at-keyword without
// '@', hash without '#', string without quotes, the unit of a dimension); 'start'/'end' locate it in the source.
struct CssToken {
    mut u8 kind;
    mut str text;
    mut f64 number;
    mut u32 start;
    mut u32 end;
}

struct CssTokens {
    mut CssToken* data;
    mut u32 count;
    mut u32 capacity;

    public static unsafe CssTokens create() {
        CssTokens tokens = { .data = (CssToken*)0, .count = 0, .capacity = 0 };
        return tokens;
    }

    public unsafe void push(CssToken token) {
        if (this.count == this.capacity) {
            mut u32 grown = this.capacity * 2;
            if (grown < 64) {
                grown = 64;
            }
            this.data = (CssToken*)__djinn_realloc((void*)this.data, (size_long)((u64)grown * sizeof(CssToken)));
            this.capacity = grown;
        }
        this.data[this.count] = token;
        this.count = this.count + 1;
    }

    public unsafe CssToken get(u32 index) {
        if (index >= this.count) {
            CssToken end = { .kind = CssKind.EOF, .text = "", .number = 0.0, .start = 0, .end = 0 };
            return end;
        }
        return this.data[index];
    }
}

struct CssLexer {
    public static bool is_name_start(i8 c) {
        return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 || (u8)c >= 128;
    }

    public static bool is_name(i8 c) {
        return CssLexer.is_name_start(c) || (c >= 48 && c <= 57) || c == 45;
    }

    public static bool is_digit(i8 c) {
        return c >= 48 && c <= 57;
    }

    static bool is_space(i8 c) {
        return c == 32 || c == 9 || c == 10 || c == 13 || c == 12;
    }

    static bool is_hex(i8 c) {
        return CssLexer.is_digit(c) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70);
    }

    static unsafe bool starts_name(i8* data, u32 length, u32 i) {
        if (i >= length) {
            return false;
        }
        i8 c = data[i];
        if (CssLexer.is_name_start(c)) {
            return true;
        }
        if (c == 92) {
            return i + 1 < length && data[i + 1] != 10;
        }
        if (c == 45) {
            if (i + 1 >= length) {
                return false;
            }
            i8 next = data[i + 1];
            return CssLexer.is_name_start(next) || next == 45 || (next == 92 && i + 2 < length);
        }
        return false;
    }

    static unsafe bool starts_number(i8* data, u32 length, u32 i) {
        if (i >= length) {
            return false;
        }
        i8 c = data[i];
        if (CssLexer.is_digit(c)) {
            return true;
        }
        if (c == 46) {
            return i + 1 < length && CssLexer.is_digit(data[i + 1]);
        }
        if (c == 43 || c == 45) {
            if (i + 1 < length && CssLexer.is_digit(data[i + 1])) {
                return true;
            }
            return i + 2 < length && data[i + 1] == 46 && CssLexer.is_digit(data[i + 2]);
        }
        return false;
    }

    // Reads a name with escapes ('\:' or '\31 ' as in '.md\:flex', '.\31 0'); 'cursor' is left after it.
    static unsafe str name(i8* data, u32 length, u32* cursor) {
        mut TextBuffer out = TextBuffer.create();
        mut u32 i = cursor[0];
        while (i < length) {
            i8 c = data[i];
            if (CssLexer.is_name(c)) {
                out.append_byte(c);
                i = i + 1;
            } else if (c == 92 && i + 1 < length && data[i + 1] != 10) {
                i = i + 1;
                if (CssLexer.is_hex(data[i])) {
                    mut u32 code = 0;
                    mut u32 digits = 0;
                    while (i < length && digits < 6 && CssLexer.is_hex(data[i])) {
                        i8 h = data[i];
                        mut u32 value = 0;
                        if (CssLexer.is_digit(h)) {
                            value = (u32)(h - 48);
                        } else if (h >= 97) {
                            value = (u32)(h - 87);
                        } else {
                            value = (u32)(h - 55);
                        }
                        code = code * 16 + value;
                        digits = digits + 1;
                        i = i + 1;
                    }
                    if (i < length && CssLexer.is_space(data[i])) {
                        i = i + 1;
                    }
                    CssLexer.append_code_point(&out, code);
                } else {
                    out.append_byte(data[i]);
                    i = i + 1;
                }
            } else {
                break;
            }
        }
        cursor[0] = i;
        return out.view();
    }

    static unsafe void append_code_point(TextBuffer* out, u32 code) {
        if (code == 0 || code > 1114111 || (code >= 55296 && code <= 57343)) {
            out.append_replacement();
        } else if (code < 128) {
            out.append_byte((i8)code);
        } else if (code < 2048) {
            out.append_byte(CssLexer.byte(192 | (code >> 6)));
            out.append_byte(CssLexer.byte(128 | (code & 63)));
        } else if (code < 65536) {
            out.append_byte(CssLexer.byte(224 | (code >> 12)));
            out.append_byte(CssLexer.byte(128 | ((code >> 6) & 63)));
            out.append_byte(CssLexer.byte(128 | (code & 63)));
        } else {
            out.append_byte(CssLexer.byte(240 | (code >> 18)));
            out.append_byte(CssLexer.byte(128 | ((code >> 12) & 63)));
            out.append_byte(CssLexer.byte(128 | ((code >> 6) & 63)));
            out.append_byte(CssLexer.byte(128 | (code & 63)));
        }
    }

    public static i8 byte(u32 value) {
        if (value > 127) {
            return (i8)((i32)value - 256);
        }
        return (i8)value;
    }

    static unsafe f64 number(i8* data, u32 length, u32* cursor) {
        mut u32 i = cursor[0];
        mut f64 sign = 1.0;
        if (data[i] == 43) {
            i = i + 1;
        } else if (data[i] == 45) {
            sign = 0.0 - 1.0;
            i = i + 1;
        }
        mut f64 value = 0.0;
        while (i < length && CssLexer.is_digit(data[i])) {
            value = value * 10.0 + (f64)(data[i] - 48);
            i = i + 1;
        }
        if (i + 1 < length && data[i] == 46 && CssLexer.is_digit(data[i + 1])) {
            i = i + 1;
            mut f64 scale = 0.1;
            while (i < length && CssLexer.is_digit(data[i])) {
                value = value + scale * (f64)(data[i] - 48);
                scale = scale / 10.0;
                i = i + 1;
            }
        }
        if (i + 1 < length && (data[i] == 101 || data[i] == 69)) {
            mut u32 j = i + 1;
            mut f64 exponent_sign = 1.0;
            if (j < length && (data[j] == 43 || data[j] == 45)) {
                if (data[j] == 45) {
                    exponent_sign = 0.0 - 1.0;
                }
                j = j + 1;
            }
            if (j < length && CssLexer.is_digit(data[j])) {
                mut f64 exponent = 0.0;
                while (j < length && CssLexer.is_digit(data[j])) {
                    exponent = exponent * 10.0 + (f64)(data[j] - 48);
                    j = j + 1;
                }
                mut f64 factor = 1.0;
                for (mut i32 k = 0; k < (i32)exponent && k < 308; k = k + 1) {
                    factor = factor * 10.0;
                }
                if (exponent_sign > 0.0) {
                    value = value * factor;
                } else {
                    value = value / factor;
                }
                i = j;
            }
        }
        cursor[0] = i;
        return sign * value;
    }

    static unsafe CssToken make(u8 kind, str text, f64 number, u32 start, u32 end) {
        CssToken token = { .kind = kind, .text = text, .number = number, .start = start, .end = end };
        return token;
    }

    public static unsafe CssTokens tokenize(str source) {
        mut CssTokens tokens = CssTokens.create();
        i8* data = source.data;
        u32 length = (u32)source.length;
        str empty = "";
        mut u32 i = 0;
        while (i < length) {
            u32 start = i;
            i8 c = data[i];
            if (c == 47 && i + 1 < length && data[i + 1] == 42) {
                i = i + 2;
                while (i + 1 < length && !(data[i] == 42 && data[i + 1] == 47)) {
                    i = i + 1;
                }
                i = i + 2;
                if (i > length) {
                    i = length;
                }
                continue;
            }
            if (CssLexer.is_space(c)) {
                while (i < length && CssLexer.is_space(data[i])) {
                    i = i + 1;
                }
                tokens.push(CssLexer.make(CssKind.SPACE, empty, 0.0, start, i));
                continue;
            }
            if (c == 34 || c == 39) {
                i = i + 1;
                mut TextBuffer text = TextBuffer.create();
                while (i < length && data[i] != c && data[i] != 10) {
                    if (data[i] == 92 && i + 1 < length) {
                        i = i + 1;
                        if (data[i] != 10) {
                            text.append_byte(data[i]);
                        }
                        i = i + 1;
                        continue;
                    }
                    text.append_byte(data[i]);
                    i = i + 1;
                }
                if (i < length && data[i] == c) {
                    i = i + 1;
                }
                tokens.push(CssLexer.make(CssKind.STRING, text.view(), 0.0, start, i));
                continue;
            }
            if (CssLexer.starts_number(data, length, i)) {
                f64 value = CssLexer.number(data, length, &i);
                if (i < length && data[i] == 37) {
                    i = i + 1;
                    tokens.push(CssLexer.make(CssKind.PERCENT, empty, value, start, i));
                } else if (CssLexer.starts_name(data, length, i)) {
                    str unit = CssLexer.name(data, length, &i);
                    tokens.push(CssLexer.make(CssKind.DIMENSION, unit, value, start, i));
                } else {
                    tokens.push(CssLexer.make(CssKind.NUMBER, empty, value, start, i));
                }
                continue;
            }
            if (CssLexer.starts_name(data, length, i)) {
                str word = CssLexer.name(data, length, &i);
                if (i < length && data[i] == 40) {
                    i = i + 1;
                    tokens.push(CssLexer.make(CssKind.FUNCTION, word, 0.0, start, i));
                } else {
                    tokens.push(CssLexer.make(CssKind.IDENT, word, 0.0, start, i));
                }
                continue;
            }
            if (c == 64 && CssLexer.starts_name(data, length, i + 1)) {
                i = i + 1;
                str word = CssLexer.name(data, length, &i);
                tokens.push(CssLexer.make(CssKind.AT, word, 0.0, start, i));
                continue;
            }
            if (c == 35 && i + 1 < length && (CssLexer.is_name(data[i + 1]) || data[i + 1] == 92)) {
                i = i + 1;
                str word = CssLexer.name(data, length, &i);
                tokens.push(CssLexer.make(CssKind.HASH, word, 0.0, start, i));
                continue;
            }
            mut u8 kind = CssKind.DELIM;
            if (c == 58) {
                kind = CssKind.COLON;
            } else if (c == 59) {
                kind = CssKind.SEMICOLON;
            } else if (c == 44) {
                kind = CssKind.COMMA;
            } else if (c == 91) {
                kind = CssKind.OPEN_SQUARE;
            } else if (c == 93) {
                kind = CssKind.CLOSE_SQUARE;
            } else if (c == 40) {
                kind = CssKind.OPEN_PAREN;
            } else if (c == 41) {
                kind = CssKind.CLOSE_PAREN;
            } else if (c == 123) {
                kind = CssKind.OPEN_CURLY;
            } else if (c == 125) {
                kind = CssKind.CLOSE_CURLY;
            }
            i = i + 1;
            str delim = { .data = data + start, .length = 1 };
            tokens.push(CssLexer.make(kind, delim, 0.0, start, i));
        }
        return tokens;
    }
}
