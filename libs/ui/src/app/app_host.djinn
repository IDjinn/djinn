import std::types;
import std::libc;

namespace ui;

// Where App.run takes an application. Natively it renders the page once and prints it (a server or a static build
// sends it on); the web version (app_host.web.djinn) mounts it in the browser.
struct AppHost {
    public static unsafe i32 run<T>(T app, u8 mode) {
        mut TextBuffer html = App.render_document<T>(app, mode);
        printf("%s\n", html.data);
        html.release();
        return 0;
    }
}
