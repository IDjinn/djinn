import std::types;
import std::libc;
import std::sys;
import std::filesystem;
import std::net;

namespace ui;

// Where App.run takes an application natively, the server side of a web app. With no arguments it renders the page
// once and prints it. The program's own arguments choose otherwise:
//   --out <dir>       a static site: every page reachable through links from "/" (and Router.declare) is written to
//                     <dir>/<path>/index.html, rendered in the app's mode (hydrate pages are still hydrated)
//   --serve <port>    a small HTTP server (Serve): pages are rendered per request, files come from --public
//   --public <dir>    where djinn.js, the .wasm module and other files are served from (default: the current dir)
// The web version (app_host.web.djinn) mounts the app in the browser instead.
struct AppHost {
    public static unsafe sync i32 run<T>(T app, u8 mode) {
        mut i8* out = (i8*)0;
        mut i32 port = 0;
        mut i8* public_dir = (i8*)".";
        i32 count = Process.argc();
        for (mut i32 i = 1; i + 1 < count; i = i + 1) {
            i8* name = Process.argv(i) ?? (i8*)"";
            i8* value = Process.argv(i + 1) ?? (i8*)"";
            if (strcmp_text(name, "--out")) {
                out = value;
                i = i + 1;
            } else if (strcmp_text(name, "--serve")) {
                port = atoi(value);
                i = i + 1;
            } else if (strcmp_text(name, "--public")) {
                public_dir = value;
                i = i + 1;
            }
        }
        if (out != (i8*)0) {
            return StaticSite.write<T>(app, mode, out);
        }
        if (port > 0) {
            return Serve.listen<T>(app, mode, port, public_dir).sync;
        }
        mut TextBuffer html = App.render_document<T>(app, mode);
        printf("%s\n", html.data);
        html.release();
        return 0;
    }
}

unsafe bool strcmp_text(i8* left, i8* right) {
    mut i32 i = 0;
    while (left[i] != 0 && left[i] == right[i]) {
        i = i + 1;
    }
    return left[i] == right[i];
}

// One page rendered for a path, and the internal links it holds (to find the rest of a static site).
struct RenderedPage {
    mut TextBuffer html;
    mut Paths links;
}

struct Pages {
    // A path a static site can have a file for: starts with '/', no '//' (another host), no ':' or '*' (patterns),
    // no '..'; the query and the fragment are dropped.
    public static unsafe str page_path(str href) {
        str empty = "";
        if (href.length == 0 || href.data[0] != (i8)47 || (href.length > 1 && href.data[1] == (i8)47)) {
            return empty;
        }
        mut u32 end = 0;
        while (end < (u32)href.length && href.data[end] != (i8)63 && href.data[end] != (i8)35) {
            i8 c = href.data[end];
            if (c == (i8)58 || c == (i8)42 || c == (i8)92 || (c == (i8)46 && end + 1 < (u32)href.length && href.data[end + 1] == (i8)46)) {
                return empty;
            }
            end = end + 1;
        }
        str path = { .data = href.data, .length = (size)end };
        return path;
    }

    static unsafe void collect(u32 id, Paths* links) {
        if (Dom.kind(id) == DomKind.ELEMENT && Texts.same(Dom.tag(id), "a") && Dom.has_attr(id, "href")) {
            str path = Pages.page_path(Dom.attr(id, "href"));
            if (path.length > 0) {
                links.add(path);
            }
        }
        mut u32 child = Dom.first_child(id);
        while (child != 0) {
            Pages.collect(child, links);
            child = Dom.next_sibling(child);
        }
    }

    // The page at 'path' as a server sends it: rendered without keeping a reactive graph, with the hydration markers
    // when the app hydrates, and everything released afterwards.
    public static unsafe RenderedPage render<T>(T app, u8 mode, str path) {
        Router.start(path);
        Reactive.set_static(true);
        Dom.set_static(true);
        Mounted mounted = App.mount<T>(app);
        mut Paths links = Paths.create();
        Pages.collect(mounted.node.id, &links);
        TextBuffer html = Html.document(mounted.node, mode == RenderMode.HYDRATE);
        mounted.unmount();
        Reactive.set_static(false);
        Dom.set_static(false);
        RenderedPage page = { .html = html, .links = links };
        return page;
    }
}

// A static site: "/", every page linked from it, every page linked from those, and so on (Router.declare adds pages
// no link reaches).
struct StaticSite {
    public static unsafe i32 write<T>(T app, u8 mode, i8* out) {
        str out_text = { .data = out, .length = (size)strlen(out) };
        result<Path, FsError> parsed = Path.parse(out_text);
        Path out_path = switch parsed { Ok v -> v, Error e -> Path.unchecked(".", false) };
        bool valid = switch parsed { Ok v -> true, Error e -> false };
        if (!valid) {
            printf("ui: '%s' is not a valid directory for --out\n", out);
            return 2;
        }
        result<Directory, FsError> here = Directory.open_root_sync(Path.unchecked(".", false));
        return switch here {
            Ok root -> StaticSite.write_into<T>(app, mode, &root, out_path, out),
            Error e -> 1
        };
    }

    static unsafe i32 write_into<T>(T app, u8 mode, Directory* root, Path out, i8* out_text) {
        result<bool, FsError> made = root.create_dir_all_sync(out);
        if (switch made { Ok v -> false, Error e -> true }) {
            printf("ui: cannot create '%s'\n", out_text);
            return 1;
        }
        mut Paths pending = Paths.create();
        pending.add("/");
        Paths* declared = Router.declared();
        for (mut u32 d = 0; d < declared.count; d = d + 1) {
            pending.add(declared.at(d));
        }
        mut u32 written = 0;
        for (mut u32 i = 0; i < pending.count; i = i + 1) {
            str path = pending.at(i);
            mut RenderedPage page = Pages.render<T>(app, mode, path);
            for (mut u32 k = 0; k < page.links.count; k = k + 1) {
                pending.add(page.links.at(k));
            }
            mut TextBuffer file = TextBuffer.create();
            file.append_bytes(out_text, (u32)strlen(out_text));
            file.append("/");
            if (path.length > 1) {
                file.append_bytes(path.data + 1, (u32)path.length - 1);
                if (path.data[path.length - 1] != (i8)47) {
                    file.append("/");
                }
            }
            str directory = file.view();
            Path directory_path = Path.unchecked(directory, false);
            result<bool, FsError> folder = root.create_dir_all_sync(directory_path);
            file.append("index.html");
            str target = file.view();
            result<bool, FsError> saved = root.write_atomic_sync(Path.unchecked(target, false), page.html.view());
            bool ok = switch saved { Ok v -> true, Error e -> false };
            if (!ok) {
                printf("ui: cannot write '%s'\n", target.data);
                return 1;
            }
            printf("ui: wrote %s\n", target.data);
            written = written + 1;
            file.release();
            page.html.release();
            page.links.release();
        }
        pending.release();
        printf("ui: %u page(s)\n", written);
        return 0;
    }
}

// A small HTTP/1.0 server for an application: GET of a page renders it (Pages.render) and GET of a file (a last
// segment with a '.', such as /djinn.js or /app.wasm) is read from the public directory. One request at a time; a
// development server, not a production one.
struct Serve {
    public static unsafe async i32 listen<T>(T app, u8 mode, i32 port, i8* public_dir) {
        mut Socket server = Socket();
        if (server.bind((i8*)"127.0.0.1", port) < 0 || server.listen(16) < 0) {
            printf("ui: cannot listen on port %d\n", port);
            return 1;
        }
        printf("ui: serving on http://127.0.0.1:%d/ (files from %s)\n", port, public_dir);
        fflush((FILE*)0);
        i8* buffer = (i8*)__djinn_alloc((size_long)65536);
        while (true) {
            mut Socket client = await server.accept();
            i64 received = await client.recv((void*)buffer, 65535);
            if (received > 0) {
                buffer[received] = 0;
                str request = { .data = buffer, .length = (size)received };
                await Serve.answer<T>(app, mode, &client, request, public_dir);
            }
            client.close();
        }
        return 0;
    }

    // The path of "GET <path> HTTP/1.1", or "" for anything else.
    public static unsafe str request_path(str request) {
        str empty = "";
        if (request.length < 5 || request.data[0] != (i8)71 || request.data[1] != (i8)69 || request.data[2] != (i8)84 || request.data[3] != (i8)32) {
            return empty;
        }
        mut u32 end = 4;
        while (end < (u32)request.length && request.data[end] != (i8)32 && request.data[end] != (i8)13 && request.data[end] != (i8)10) {
            end = end + 1;
        }
        str path = { .data = request.data + 4, .length = (size)(end - 4) };
        return path;
    }

    public static unsafe str content_type(str path) {
        if (Serve.ends_with(path, ".wasm")) { return "application/wasm"; }
        if (Serve.ends_with(path, ".js") || Serve.ends_with(path, ".mjs")) { return "text/javascript; charset=utf-8"; }
        if (Serve.ends_with(path, ".css")) { return "text/css; charset=utf-8"; }
        if (Serve.ends_with(path, ".html")) { return "text/html; charset=utf-8"; }
        if (Serve.ends_with(path, ".json")) { return "application/json"; }
        if (Serve.ends_with(path, ".svg")) { return "image/svg+xml"; }
        if (Serve.ends_with(path, ".png")) { return "image/png"; }
        if (Serve.ends_with(path, ".ico")) { return "image/x-icon"; }
        return "application/octet-stream";
    }

    static unsafe bool ends_with(str text, str suffix) {
        if (text.length < suffix.length) {
            return false;
        }
        str tail = { .data = text.data + (text.length - suffix.length), .length = suffix.length };
        return Texts.same(tail, suffix);
    }

    // A file request: the last segment of the path has a dot.
    static unsafe bool is_file(str path) {
        mut bool dot = false;
        for (mut u32 i = 0; i < (u32)path.length; i = i + 1) {
            if (path.data[i] == (i8)47) {
                dot = false;
            } else if (path.data[i] == (i8)46) {
                dot = true;
            }
        }
        return dot;
    }

    static unsafe void header(TextBuffer* head, str line) {
        head.append(line);
        head.append_byte((i8)13);
        head.append_byte((i8)10);
    }

    static unsafe async void send(Socket* client, i32 status, str reason, str type, i8* body, u32 length) {
        mut TextBuffer head = TextBuffer.create();
        head.append("HTTP/1.0 ");
        head.append_number((i64)status);
        head.append(" ");
        Serve.header(&head, reason);
        head.append("Content-Type: ");
        Serve.header(&head, type);
        head.append("Content-Length: ");
        head.append_number((i64)length);
        Serve.header(&head, "");
        Serve.header(&head, "Cache-Control: no-store");
        Serve.header(&head, "X-Content-Type-Options: nosniff");
        Serve.header(&head, "Connection: close");
        Serve.header(&head, "");
        await client.send((void*)head.data, (i64)head.length);
        if (length > 0) {
            await client.send((void*)body, (i64)length);
        }
        head.release();
    }

    static unsafe async void answer<T>(T app, u8 mode, Socket* client, str request, i8* public_dir) {
        str target = Serve.request_path(request);
        str path = Pages.page_path(target);
        if (path.length == 0) {
            await Serve.send(client, 400, "Bad Request", "text/plain", (i8*)"bad request", 11);
            return;
        }
        if (Serve.is_file(path)) {
            await Serve.file(client, path, public_dir);
            return;
        }
        mut RenderedPage page = Pages.render<T>(app, mode, path);
        await Serve.send(client, 200, "OK", "text/html; charset=utf-8", page.html.data, page.html.length);
        page.html.release();
        page.links.release();
    }

    static unsafe bool read_file(Directory* root, str path, string* body) {
        str relative = { .data = path.data + 1, .length = path.length - 1 };
        result<Path, FsError> parsed = Path.parse(relative);
        if (switch parsed { Ok v -> false, Error e -> true }) {
            return false;
        }
        Path inside = switch parsed { Ok v -> v, Error e -> Path.unchecked("x", false) };
        result<string, FsError> read = root.read_to_string_sync(inside, 268435456);
        if (switch read { Ok s -> false, Error e -> true }) {
            return false;
        }
        *body = switch read { Ok s -> s, Error e -> "" };
        return true;
    }

    static unsafe async void file(Socket* client, str path, i8* public_dir) {
        str root_text = { .data = public_dir, .length = (size)strlen(public_dir) };
        result<Directory, FsError> opened = Directory.open_root_sync(Path.unchecked(root_text, true));
        mut string body = "";
        bool found = switch opened { Ok root -> Serve.read_file(&root, path, &body), Error e -> false };
        if (!found) {
            await Serve.send(client, 404, "Not Found", "text/plain", (i8*)"not found", 9);
            return;
        }
        await Serve.send(client, 200, "OK", Serve.content_type(path), body.ptr(), (u32)body.length);
    }
}
