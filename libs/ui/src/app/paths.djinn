import std::types;
import std::libc;

namespace ui;

// A growable list of owned paths.
struct mut Paths {
    i8** items;
    u32* lengths;
    u32 count;
    u32 capacity;

    public static unsafe Paths create() {
        Paths made = { .items = (i8**)0, .lengths = (u32*)0, .count = 0, .capacity = 0 };
        return made;
    }

    public unsafe bool contains(str path) {
        for (mut u32 i = 0; i < this.count; i = i + 1) {
            str item = { .data = this.items[i], .length = (size)this.lengths[i] };
            if (item == path) {
                return true;
            }
        }
        return false;
    }

    public unsafe void add(str path) {
        if (this.contains(path)) {
            return;
        }
        if (this.count == this.capacity) {
            u32 grown = this.capacity * 2 + 8;
            this.items = (i8**)__djinn_realloc((void*)this.items, (size_long)(grown * (u32)sizeof(i8*)));
            this.lengths = (u32*)__djinn_realloc((void*)this.lengths, (size_long)(grown * 4));
            this.capacity = grown;
        }
        this.items[this.count] = Texts.copy(path.data, (u32)path.length);
        this.lengths[this.count] = (u32)path.length;
        this.count = this.count + 1;
    }

    public unsafe str at(u32 index) {
        str item = { .data = this.items[index], .length = (size)this.lengths[index] };
        return item;
    }

    public unsafe void release() {
        for (mut u32 i = 0; i < this.count; i = i + 1) {
            __djinn_free((void*)this.items[i]);
        }
        __djinn_free((void*)this.items);
        __djinn_free((void*)this.lengths);
        this.count = 0;
        this.capacity = 0;
    }
}
