import std::types;

namespace ui;

// The application in the browser. CLIENT builds the page from nothing; HYDRATE, SERVER and STATIC adopt the HTML the
// server sent: the tree is built without touching the page and then matched with it node by node (in SERVER and
// STATIC mode only the [Client] islands are), so nothing is created twice and the listeners attach to what is there.
struct AppHost {
    public static unsafe i32 run<T>(T app, u8 mode) {
        DomHost.start();
        if (mode == RenderMode.CLIENT) {
            App.mount<T>(app);
            DomHost.styles();
            return 0;
        }
        DomHost.mute();
        Mounted mounted = App.mount<T>(app);
        DomHost.unmute();
        DomHost.adopt(mounted.node.id, mode != RenderMode.HYDRATE);
        return 0;
    }
}
