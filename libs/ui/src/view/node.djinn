import std::types;
import std::libc;

namespace ui;

// A handle to a node of the retained tree. html! builds the UI with these calls: static parts are created once,
// and each dynamic part ('{expr}', 'class={expr}') becomes one effect bound to exactly the node it changes.
struct Node {
    u32 id;

    public static Node of(u32 id) {
        Node node = { .id = id };
        return node;
    }

    public static unsafe Node element(str tag) {
        Node node = { .id = Dom.element(tag) };
        return node;
    }

    public static unsafe Node text(str value) {
        Node node = { .id = Dom.text(value) };
        return node;
    }

    public static unsafe Node fragment() {
        Node node = { .id = Dom.fragment() };
        return node;
    }

    public static Node none() {
        return Node.fragment();
    }

    public unsafe Node child(Node node) {
        Dom.append(this.id, node.id);
        return Node.of(this.id);
    }

    public unsafe Node add(str value) {
        Dom.append(this.id, Dom.text(value));
        return Node.of(this.id);
    }

    public unsafe Node attr(str name, str value) {
        Dom.set_attr(this.id, name, value.data, (u32)value.length);
        return Node.of(this.id);
    }

    public unsafe Node on(str event, fn() -> void handler) {
        Dom.listen(this.id, event, handler);
        return Node.of(this.id);
    }

    unsafe u32 text_slot() {
        u32 slot = Dom.text("");
        Dom.append(this.id, slot);
        return slot;
    }

    public unsafe Node insert(fn() -> Node render) {
        u32 region = Dom.fragment();
        Dom.append(this.id, region);
        effect(() => {
            Dom.clear_children(region);
            Node inner = render();
            Dom.append(region, inner.id);
        });
        return Node.of(this.id);
    }

    public unsafe Node insert(fn() -> str value) {
        u32 slot = this.text_slot();
        effect(() => {
            str text = value();
            Dom.set_text(slot, text.data, (u32)text.length);
        });
        return Node.of(this.id);
    }

    public unsafe Node insert(fn() -> string value) {
        u32 slot = this.text_slot();
        effect(() => {
            string text = value();
            Dom.set_text(slot, text.data, text.length);
        });
        return Node.of(this.id);
    }

    public unsafe Node insert(fn() -> i32 value) {
        u32 slot = this.text_slot();
        effect(() => Dom.set_number(slot, (i64)value()));
        return Node.of(this.id);
    }

    public unsafe Node insert(fn() -> i64 value) {
        u32 slot = this.text_slot();
        effect(() => Dom.set_number(slot, value()));
        return Node.of(this.id);
    }

    public unsafe Node insert(fn() -> u32 value) {
        u32 slot = this.text_slot();
        effect(() => Dom.set_number(slot, (i64)value()));
        return Node.of(this.id);
    }

    public unsafe Node insert(fn() -> bool value) {
        u32 slot = this.text_slot();
        effect(() => Bind.flag(slot, value()));
        return Node.of(this.id);
    }

    public unsafe Node insert(fn() -> f64 value) {
        u32 slot = this.text_slot();
        effect(() => Bind.real(slot, value()));
        return Node.of(this.id);
    }

    public unsafe Node insert(fn() -> signal<i32> value) {
        u32 slot = this.text_slot();
        effect(() => Dom.set_number(slot, (i64)value().get()));
        return Node.of(this.id);
    }

    public unsafe Node insert(fn() -> signal<i64> value) {
        u32 slot = this.text_slot();
        effect(() => Dom.set_number(slot, value().get()));
        return Node.of(this.id);
    }

    public unsafe Node insert(fn() -> signal<bool> value) {
        u32 slot = this.text_slot();
        effect(() => Bind.flag(slot, value().get()));
        return Node.of(this.id);
    }

    public unsafe Node insert(fn() -> signal<f64> value) {
        u32 slot = this.text_slot();
        effect(() => Bind.real(slot, value().get()));
        return Node.of(this.id);
    }

    public unsafe Node insert(fn() -> signal<str> value) {
        u32 slot = this.text_slot();
        effect(() => Bind.words(slot, value().get()));
        return Node.of(this.id);
    }

    public unsafe Node insert(fn() -> memo<i32> value) {
        u32 slot = this.text_slot();
        effect(() => Dom.set_number(slot, (i64)value().get()));
        return Node.of(this.id);
    }

    public unsafe Node insert(fn() -> memo<i64> value) {
        u32 slot = this.text_slot();
        effect(() => Dom.set_number(slot, value().get()));
        return Node.of(this.id);
    }

    public unsafe Node insert(fn() -> memo<bool> value) {
        u32 slot = this.text_slot();
        effect(() => Bind.flag(slot, value().get()));
        return Node.of(this.id);
    }

    public unsafe Node insert(fn() -> memo<str> value) {
        u32 slot = this.text_slot();
        effect(() => Bind.words(slot, value().get()));
        return Node.of(this.id);
    }

    public unsafe Node attr(str name, fn() -> str value) {
        u32 id = this.id;
        effect(() => {
            str text = value();
            Dom.set_attr(id, name, text.data, (u32)text.length);
        });
        return Node.of(this.id);
    }

    public unsafe Node attr(str name, fn() -> string value) {
        u32 id = this.id;
        effect(() => {
            string text = value();
            Dom.set_attr(id, name, text.data, text.length);
        });
        return Node.of(this.id);
    }

    public unsafe Node attr(str name, fn() -> i32 value) {
        u32 id = this.id;
        effect(() => Bind.number_attr(id, name, (i64)value()));
        return Node.of(this.id);
    }

    public unsafe Node attr(str name, fn() -> signal<i32> value) {
        u32 id = this.id;
        effect(() => Bind.number_attr(id, name, (i64)value().get()));
        return Node.of(this.id);
    }

    public unsafe Node attr(str name, fn() -> signal<str> value) {
        u32 id = this.id;
        effect(() => {
            str text = value().get();
            Dom.set_attr(id, name, text.data, (u32)text.length);
        });
        return Node.of(this.id);
    }

    // A boolean attribute ('disabled={busy}'): present with an empty value when true, removed when false.
    public unsafe Node attr(str name, fn() -> bool value) {
        u32 id = this.id;
        effect(() => Bind.flag_attr(id, name, value()));
        return Node.of(this.id);
    }
}

struct Bind {
    public static unsafe void flag(u32 slot, bool value) {
        if (value) {
            str text = "true";
            Dom.set_text(slot, text.data, 4);
        } else {
            str text = "false";
            Dom.set_text(slot, text.data, 5);
        }
    }

    public static unsafe void real(u32 slot, f64 value) {
        string text = $"{value}";
        Dom.set_text(slot, text.data, text.length);
    }

    public static unsafe void words(u32 slot, str value) {
        Dom.set_text(slot, value.data, (u32)value.length);
    }

    public static unsafe void number_attr(u32 id, str name, i64 value) {
        mut TextBuffer digits = TextBuffer.create();
        digits.append_number(value);
        Dom.set_attr(id, name, digits.data, digits.length);
        digits.release();
    }

    public static unsafe void flag_attr(u32 id, str name, bool value) {
        if (value) {
            str empty = "";
            Dom.set_attr(id, name, empty.data, 0);
        } else {
            Dom.remove_attr(id, name);
        }
    }
}
