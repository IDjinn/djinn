import std::types;
import std::libc;
import std::collections;

namespace ui;

// The props of a [Client] island: the values the server renders it with, sent in data-props as a JSON object so the
// client builds the island from them instead of from its declaration. The macro of [Client] writes them field by
// field (add_*, native) and reads them back (open, then get_*, on the web). A prop is a bool, an i32, a u32, a str or
// a slice of those; any other type is a compile error in the macro.
//
// Natively (and in the WebAssembly add-on, which builds the island from its declaration) get_* return the value they
// are given; the JavaScript target replaces this struct with the one in libs/ui/js/ui.djinn that reads the page.
struct IslandProps {
    public static unsafe TextBuffer begin() {
        TextBuffer out = TextBuffer.create();
        out.append_byte(123);
        return out;
    }

    public static unsafe str finish(TextBuffer* out) {
        out.append_byte(125);
        return out.view();
    }

    static unsafe void key(TextBuffer* out, str name) {
        if (out.length > 1) {
            out.append_byte(44);
        }
        IslandProps.text(out, name);
        out.append_byte(58);
    }

    // A JSON string: quotes, backslashes and control characters are escaped; everything else is written as it is
    // (the HTML writer then escapes it again for the attribute, and replaces malformed UTF-8).
    static unsafe void text(TextBuffer* out, str value) {
        out.append_byte(34);
        for (mut u32 i = 0; i < (u32)value.length; i = i + 1) {
            i8 c = *(value.data + (i));
            if (c == 34) {
                out.append("\\\"");
            } else if (c == 92) {
                out.append("\\\\");
            } else if (c == 10) {
                out.append("\\n");
            } else if (c == 13) {
                out.append("\\r");
            } else if (c == 9) {
                out.append("\\t");
            } else if (c >= 0 && c < 32) {
                out.append("\\u00");
                out.append_byte(IslandProps.hex((u32)c / 16));
                out.append_byte(IslandProps.hex((u32)c % 16));
            } else {
                out.append_byte(c);
            }
        }
        out.append_byte(34);
    }

    static i8 hex(u32 digit) {
        if (digit < 10) {
            return (i8)(48 + digit);
        }
        return (i8)(87 + digit);
    }

    public static unsafe void add_bool(TextBuffer* out, str name, bool value) {
        IslandProps.key(out, name);
        IslandProps.flag(out, value);
    }

    static unsafe void flag(TextBuffer* out, bool value) {
        if (value) {
            out.append("true");
        } else {
            out.append("false");
        }
    }

    public static unsafe void add_i32(TextBuffer* out, str name, i32 value) {
        IslandProps.key(out, name);
        out.append_number((i64)value);
    }

    public static unsafe void add_u32(TextBuffer* out, str name, u32 value) {
        IslandProps.key(out, name);
        out.append_number((i64)value);
    }

    public static unsafe void add_str(TextBuffer* out, str name, str value) {
        IslandProps.key(out, name);
        IslandProps.text(out, value);
    }

    public static unsafe void add_slice_bool(TextBuffer* out, str name, slice<bool> value) {
        IslandProps.key(out, name);
        out.append_byte(91);
        for (mut u32 i = 0; i < (u32)value.length; i = i + 1) {
            if (i > 0) {
                out.append_byte(44);
            }
            IslandProps.flag(out, *(value.data + (i)));
        }
        out.append_byte(93);
    }

    public static unsafe void add_slice_i32(TextBuffer* out, str name, slice<i32> value) {
        IslandProps.key(out, name);
        out.append_byte(91);
        for (mut u32 i = 0; i < (u32)value.length; i = i + 1) {
            if (i > 0) {
                out.append_byte(44);
            }
            out.append_number((i64)*(value.data + (i)));
        }
        out.append_byte(93);
    }

    public static unsafe void add_slice_u32(TextBuffer* out, str name, slice<u32> value) {
        IslandProps.key(out, name);
        out.append_byte(91);
        for (mut u32 i = 0; i < (u32)value.length; i = i + 1) {
            if (i > 0) {
                out.append_byte(44);
            }
            out.append_number((i64)*(value.data + (i)));
        }
        out.append_byte(93);
    }

    public static unsafe void add_slice_str(TextBuffer* out, str name, slice<str> value) {
        IslandProps.key(out, name);
        out.append_byte(91);
        for (mut u32 i = 0; i < (u32)value.length; i = i + 1) {
            if (i > 0) {
                out.append_byte(44);
            }
            IslandProps.text(out, *(value.data + (i)));
        }
        out.append_byte(93);
    }

    public static void open(str island) {
    }

    public static bool get_bool(str name, bool fallback) {
        return fallback;
    }

    public static i32 get_i32(str name, i32 fallback) {
        return fallback;
    }

    public static u32 get_u32(str name, u32 fallback) {
        return fallback;
    }

    public static str get_str(str name, str fallback) {
        return fallback;
    }

    public static slice<bool> get_slice_bool(str name, slice<bool> fallback) {
        return fallback;
    }

    public static slice<i32> get_slice_i32(str name, slice<i32> fallback) {
        return fallback;
    }

    public static slice<u32> get_slice_u32(str name, slice<u32> fallback) {
        return fallback;
    }

    public static slice<str> get_slice_str(str name, slice<str> fallback) {
        return fallback;
    }
}
