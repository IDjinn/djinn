import std::types;

namespace ui;

// What a host that mirrors the tree elsewhere hears about each change of Dom. The native hosts read the tree itself,
// so here every hook is empty (and inlined away); the web host (dom_host.web.djinn) turns them into DOM operations.
struct DomHost {
    [ForceInline] public static void created(u32 id) {}
    [ForceInline] public static void text_changed(u32 id) {}
    [ForceInline] public static void attr_set(u32 id, str name, i8* data, u32 length) {}
    [ForceInline] public static void attr_removed(u32 id, str name) {}
    [ForceInline] public static void inserted(u32 parent, u32 child, u32 before) {}
    [ForceInline] public static void removed(u32 id) {}
    [ForceInline] public static void listened(u32 id, str event) {}
    [ForceInline] public static void focused(u32 id) {}
}
