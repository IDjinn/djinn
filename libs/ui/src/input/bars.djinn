import std::types;

namespace ui;

unsafe static mut u32 bar_id = 0;
unsafe static mut bool bar_vertical = true;
unsafe static mut f32 bar_start = (f32)0.0;
unsafe static mut f32 bar_origin = (f32)0.0;
unsafe static mut f32 bar_free = (f32)0.0;
unsafe static mut f32 bar_limit = (f32)0.0;
unsafe static mut f32 bar_page_width = (f32)0.0;
unsafe static mut f32 bar_page_gutter = (f32)0.0;

struct BarRect {
    mut f32 x;
    mut f32 y;
    mut f32 w;
    mut f32 h;
    mut f32 free;
}

// The scroll thumbs of the scroll containers and of the page: where they sit and dragging them. A container that
// keeps room for its bar (Layout.reserve, the box's gutter) has its thumb in that strip, as in a browser; with
// 'scrollbar-width: none' it still scrolls but shows no bar. The page bar sits in the strip the painter keeps at the
// right of the window (Bars.set_page). The painter draws what 'rect' describes; the host grabs a thumb with 'begin'
// when the pointer goes down on one (Hit.bar says which, the document for the page), moves it with 'drag' and lets
// go with 'end'.
struct Bars {
    // Set by the painter each frame: the window width and the strip of the page bar (0 when the page fits).
    public static unsafe void set_page(f32 width, f32 gutter) {
        bar_page_width = width;
        bar_page_gutter = gutter;
    }

    public static unsafe f32 page_gutter() {
        return bar_page_gutter;
    }

    static unsafe bool is_page(u32 id) {
        return id == Dom.document();
    }

    static unsafe f32 offset(u32 id, bool vertical) {
        if (Bars.is_page(id)) {
            return Scroll.page_top();
        }
        if (vertical) {
            return Scroll.top(id);
        }
        return Scroll.left(id);
    }

    static unsafe f32 limit(u32 id, bool vertical) {
        if (Bars.is_page(id)) {
            return Scroll.page_max_y();
        }
        if (vertical) {
            return Scroll.max_y(id);
        }
        return Scroll.max_x(id);
    }

    // The thumb of the page bar, in window pixels.
    static unsafe bool page_rect(bool vertical, BarRect* r) {
        if (!vertical || bar_page_gutter <= (f32)0.0) {
            return false;
        }
        f32 pixel = (f32)Styles.device_scale();
        f32 inset = (f32)2.0 * pixel;
        f32 view = Scroll.page_size();
        f32 limit = Scroll.page_max_y();
        if (limit <= (f32)0.0 || view <= (f32)16.0 * pixel) {
            return false;
        }
        f32 track = view - inset * (f32)2.0;
        f32 length = Px.clamp(track * view / (view + limit), (f32)24.0 * pixel, track);
        f32 free = track - length;
        r.free = free;
        r.x = bar_page_width - bar_page_gutter + inset;
        r.y = inset + Px.clamp(free * Scroll.page_top() / limit, (f32)0.0, free);
        r.w = Px.max(bar_page_gutter - inset * (f32)2.0, pixel);
        r.h = length;
        return true;
    }

    // The rect of a container's thumb in the space of its box (the page's in window pixels): left, top, width,
    // height, free = how far the thumb can travel along its track. False when there is nothing to scroll on that
    // axis or no bar is shown.
    public static unsafe bool rect(u32 id, bool vertical, BarRect* r) {
        if (Bars.is_page(id)) {
            return Bars.page_rect(vertical, r);
        }
        LayoutBox* box = Layout.box(id);
        f32 pixel = (f32)Styles.device_scale();
        f32 inset = (f32)2.0 * pixel;
        f32 bar = Layout.bar_width(Styles.of(id));
        if (bar <= (f32)0.0) {
            return false;
        }
        f32 thickness = Px.max(bar - inset * (f32)2.0, pixel);
        mut f32 view = box.width - box.border.horizontal();
        mut f32 limit = Scroll.max_x(id);
        mut f32 at = Scroll.left(id);
        if (vertical) {
            view = box.height - box.border.vertical();
            limit = Scroll.max_y(id);
            at = Scroll.top(id);
        }
        if (limit <= (f32)0.0 || view <= (f32)16.0 * pixel) {
            return false;
        }
        f32 track = view - inset * (f32)2.0;
        mut f32 length = track * view / (view + limit);
        if (length < (f32)24.0 * pixel) {
            length = (f32)24.0 * pixel;
        }
        if (length > track) {
            length = track;
        }
        f32 free = track - length;
        mut f32 offset = free * at / limit;
        if (offset < (f32)0.0) {
            offset = (f32)0.0;
        }
        if (offset > free) {
            offset = free;
        }
        r.free = free;
        if (vertical) {
            r.x = box.left + box.width - box.border.right - thickness - inset;
            r.y = box.top + box.border.top + inset + offset;
            r.w = thickness;
            r.h = length;
        } else {
            r.x = box.left + box.border.left + inset + offset;
            r.y = box.top + box.height - box.border.bottom - thickness - inset;
            r.w = length;
            r.h = thickness;
        }
        return true;
    }

    // True when (x, y), in the space of the container's box, is on its thumb (a little margin makes it easier to hit).
    public static unsafe bool over(u32 id, bool vertical, f32 x, f32 y) {
        mut BarRect r = { .x = (f32)0.0, .y = (f32)0.0, .w = (f32)0.0, .h = (f32)0.0, .free = (f32)0.0 };
        if (!Bars.rect(id, vertical, &r)) {
            return false;
        }
        f32 slop = (f32)4.0 * (f32)Styles.device_scale();
        return x >= r.x - slop && x < r.x + r.w + slop && y >= r.y - slop && y < r.y + r.h + slop;
    }

    // True when (x, y), in the space of the container's box, is on the track of its scroll bar (the strip the thumb
    // slides in) but not on the thumb.
    public static unsafe bool on_track(u32 id, bool vertical, f32 x, f32 y) {
        mut BarRect r = { .x = (f32)0.0, .y = (f32)0.0, .w = (f32)0.0, .h = (f32)0.0, .free = (f32)0.0 };
        if (!Bars.rect(id, vertical, &r) || Bars.over(id, vertical, x, y)) {
            return false;
        }
        if (Bars.is_page(id)) {
            return vertical && x >= bar_page_width - bar_page_gutter && x < bar_page_width && y >= (f32)0.0 && y < Scroll.page_size();
        }
        LayoutBox* box = Layout.box(id);
        if (vertical) {
            return x >= r.x && x < r.x + r.w && y >= box.top && y < box.top + box.height;
        }
        return y >= r.y && y < r.y + r.h && x >= box.left && x < box.left + box.width;
    }

    // Whether a point on the track is before (above or left of) the thumb.
    public static unsafe bool before(u32 id, bool vertical, f32 x, f32 y) {
        mut BarRect r = { .x = (f32)0.0, .y = (f32)0.0, .w = (f32)0.0, .h = (f32)0.0, .free = (f32)0.0 };
        Bars.rect(id, vertical, &r);
        if (vertical) {
            return y < r.y;
        }
        return x < r.x;
    }

    // A click on the track scrolls a page towards it, as the system does ('before': the click is above or left of
    // the thumb).
    public static unsafe void page(u32 id, bool vertical, bool before) {
        if (Bars.is_page(id)) {
            mut f32 step = Scroll.page_size() * (f32)0.9;
            if (before) {
                step = (f32)0.0 - step;
            }
            Scroll.page_by(step);
            return;
        }
        LayoutBox* box = Layout.box(id);
        mut f32 amount = (box.width - box.border.horizontal()) * (f32)0.9;
        if (vertical) {
            amount = (box.height - box.border.vertical()) * (f32)0.9;
        }
        if (before) {
            amount = (f32)0.0 - amount;
        }
        if (vertical) {
            Scroll.glide_by(id, (f32)0.0, amount);
        } else {
            Scroll.glide_by(id, amount, (f32)0.0);
        }
    }

    // Starts dragging the thumb of 'id' with the pointer at (x, y) in window pixels.
    public static unsafe void begin(u32 id, bool vertical, f32 x, f32 y) {
        mut BarRect r = { .x = (f32)0.0, .y = (f32)0.0, .w = (f32)0.0, .h = (f32)0.0, .free = (f32)0.0 };
        if (!Bars.rect(id, vertical, &r)) {
            return;
        }
        bar_id = id;
        bar_vertical = vertical;
        bar_free = r.free;
        bar_start = x;
        if (vertical) {
            bar_start = y;
        }
        bar_origin = Bars.offset(id, vertical);
        bar_limit = Bars.limit(id, vertical);
        Scroll.touch();
    }

    public static unsafe bool dragging() {
        return bar_id != 0;
    }

    public static unsafe u32 grabbed() {
        return bar_id;
    }

    // The pointer moved to (x, y): the container scrolls by the same share of its length as the thumb travelled.
    public static unsafe void drag(f32 x, f32 y) {
        if (bar_id == 0 || bar_free <= (f32)0.0) {
            return;
        }
        mut f32 moved = x - bar_start;
        if (bar_vertical) {
            moved = y - bar_start;
        }
        f32 goal = bar_origin + moved * bar_limit / bar_free;
        if (Bars.is_page(bar_id)) {
            Scroll.page_to(goal);
            return;
        }
        if (bar_vertical) {
            Scroll.set(bar_id, Scroll.left(bar_id), goal);
        } else {
            Scroll.set(bar_id, goal, Scroll.top(bar_id));
        }
    }

    public static unsafe void end() {
        if (bar_id != 0) {
            bar_id = 0;
            Scroll.touch();
        }
    }
}
