import std::types;
import std::libc;

namespace ui;

unsafe static mut ptr clipboard_system = null;

// The contract of a platform clipboard, the same on every platform: win32 implements it with CF_UNICODETEXT, a web
// host would with navigator.clipboard, and so on. 'write' replaces the text, 'read' returns the current text (UTF-8)
// and its length, or null when there is none; the pointer belongs to the backend and stays valid until its next call.
interface ClipboardBackend {
    void write(i8* data, u32 length);
    i8* read(u32* length);
}

// What a platform provides for the system clipboard: 'write' replaces its text, 'read' returns the current text (UTF-8)
// and its length; the pointer belongs to the host and stays valid until its next call.
struct ClipboardProvider {
    fn(i8*, u32) -> void write;
    fn(u32*) -> i8* read;
}

struct mut ClipboardSystem {
    bool active;
    ClipboardProvider provider;
    i8* data;
    u32 length;
}

// Cut, copy and paste in text fields. Without a provider the text lives in the process only, so copy and paste still
// work between fields; a host installs a provider to share it with other programs.
struct Clipboard {
    static unsafe ClipboardSystem* system() {
        if (clipboard_system == null) {
            clipboard_system = (ptr)__djinn_alloc_zeroed((size_long)sizeof(ClipboardSystem));
        }
        return (ClipboardSystem*)clipboard_system;
    }

    public static unsafe void install(ClipboardProvider provider) {
        ClipboardSystem* system = Clipboard.system();
        system.provider = provider;
        system.active = true;
    }

    // Installs a platform backend; every platform goes through the same ClipboardBackend interface.
    public static unsafe void use<T>(T backend) where T : ClipboardBackend {
        ClipboardProvider provider = {
            .write = (i8* data, u32 length) => backend.write(data, length),
            .read = (u32* length) => backend.read(length)
        };
        Clipboard.install(provider);
    }

    public static unsafe void write(i8* data, u32 length) {
        ClipboardSystem* system = Clipboard.system();
        if (system.data != (i8*)0) {
            __djinn_free((void*)system.data);
        }
        system.data = (i8*)__djinn_alloc_zeroed((size_long)(length + 1));
        if (length > 0) {
            memcpy((void*)system.data, (void*)data, (size_long)length);
        }
        system.length = length;
        if (system.active) {
            system.provider.write(data, length);
        }
    }

    // The clipboard text; 'length' receives its size. Never null.
    public static unsafe i8* read(u32* length) {
        ClipboardSystem* system = Clipboard.system();
        if (system.active) {
            i8* text = system.provider.read(length);
            if (text != (i8*)0) {
                return text;
            }
        }
        if (system.data == (i8*)0) {
            *length = 0;
            return (i8*)"";
        }
        *length = system.length;
        return system.data;
    }
}
