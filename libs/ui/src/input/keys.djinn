namespace ui;

// Key codes are the Windows virtual-key values; the other hosts translate their own codes to these.
struct Key {
    const i32 BACKSPACE = 8;
    const i32 TAB = 9;
    const i32 ENTER = 13;
    const i32 ESCAPE = 27;
    const i32 SPACE = 32;
    const i32 END = 35;
    const i32 HOME = 36;
    const i32 LEFT = 37;
    const i32 UP = 38;
    const i32 RIGHT = 39;
    const i32 DOWN = 40;
    const i32 DELETE = 46;
}

struct Mod {
    const u32 SHIFT = 1;
    const u32 CTRL = 2;
    const u32 ALT = 4;
    const u32 META = 8;
}
