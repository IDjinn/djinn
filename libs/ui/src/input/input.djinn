import std::types;
import std::libc;

namespace ui;

unsafe static mut i32 input_key = 0;
unsafe static mut u32 input_mods = 0;
unsafe static mut bool input_prevented = false;

// Key codes are the Windows virtual-key values; the other hosts translate their own codes to these.
struct Key {
    const i32 BACKSPACE = 8;
    const i32 TAB = 9;
    const i32 ENTER = 13;
    const i32 ESCAPE = 27;
    const i32 SPACE = 32;
    const i32 END = 35;
    const i32 HOME = 36;
    const i32 LEFT = 37;
    const i32 UP = 38;
    const i32 RIGHT = 39;
    const i32 DOWN = 40;
    const i32 DELETE = 46;
}

struct Mod {
    const u32 SHIFT = 1;
    const u32 CTRL = 2;
    const u32 ALT = 4;
}

// Keyboard input. A host calls Input.press for each key; the "keydown" event goes to the focused element (or the
// document), bubbles, and a listener reads what was pressed with Input.key() / Input.shift() / ...
// Calling Input.prevent() in a listener cancels the default action:
//   Tab / Shift+Tab   move focus to the next / previous element
//   Enter, Space      click the focused button or link (Space only on a button, Enter also on a link)
//   Escape            blur the focused element
struct Input {
    public static unsafe i32 key() {
        return input_key;
    }

    public static unsafe bool shift() {
        return (input_mods & Mod.SHIFT) != 0;
    }

    public static unsafe bool ctrl() {
        return (input_mods & Mod.CTRL) != 0;
    }

    public static unsafe bool alt() {
        return (input_mods & Mod.ALT) != 0;
    }

    // Cancels the default action of the key being delivered.
    public static unsafe void prevent() {
        input_prevented = true;
    }

    // A text field: a textarea or an input of a type that takes text, not disabled and not readonly.
    public static unsafe bool editable(u32 id) {
        if (id == 0 || Dom.kind(id) != DomKind.ELEMENT) {
            return false;
        }
        str tag = Dom.tag(id);
        mut bool field = Texts.same(tag, "textarea");
        if (Texts.same(tag, "input")) {
            str kind = Dom.attr(id, "type");
            field = !(Texts.same(kind, "checkbox") || Texts.same(kind, "radio") || Texts.same(kind, "hidden")
                || Texts.same(kind, "button") || Texts.same(kind, "submit") || Texts.same(kind, "reset")
                || Texts.same(kind, "range") || Texts.same(kind, "color") || Texts.same(kind, "file")
                || Texts.same(kind, "image"));
        }
        return field && !Dom.has_attr(id, "disabled") && !Dom.has_attr(id, "readonly");
    }

    // Appends a code point to the value of the focused text field and fires "input". The caret is always at the end.
    // A host calls this for every character the keyboard produces (not for control keys). Returns true when it typed.
    public static unsafe bool typed(u32 code) {
        u32 target = Focus.current();
        if (code < 32 || code == 127 || !Input.editable(target)) {
            return false;
        }
        str value = Dom.attr(target, "value");
        u32 length = (u32)value.length;
        if (length > 4000) {
            return false;
        }
        u8* grown = (u8*)__djinn_alloc_zeroed((size_long)(length + 5));
        if (length > 0) {
            memcpy((void*)grown, (void*)value.data, (size_long)length);
        }
        mut u32 added = 0;
        if (code < 128) {
            grown[length] = (u8)code;
            added = 1;
        } else if (code < 2048) {
            grown[length] = (u8)(192 | (code >> 6));
            grown[length + 1] = (u8)(128 | (code & 63));
            added = 2;
        } else if (code < 65536) {
            grown[length] = (u8)(224 | (code >> 12));
            grown[length + 1] = (u8)(128 | ((code >> 6) & 63));
            grown[length + 2] = (u8)(128 | (code & 63));
            added = 3;
        } else {
            grown[length] = (u8)(240 | (code >> 18));
            grown[length + 1] = (u8)(128 | ((code >> 12) & 63));
            grown[length + 2] = (u8)(128 | ((code >> 6) & 63));
            grown[length + 3] = (u8)(128 | (code & 63));
            added = 4;
        }
        Dom.set_attr(target, "value", (i8*)grown, length + added);
        __djinn_free((void*)grown);
        Dom.dispatch(target, "input");
        return true;
    }

    // Removes the last character of the focused text field (Backspace) and fires "input".
    static unsafe bool erase(u32 target) {
        str value = Dom.attr(target, "value");
        u32 length = (u32)value.length;
        if (length == 0) {
            return false;
        }
        mut u32 keep = length - 1;
        while (keep > 0 && (((i32)value.data[keep]) & 192) == 128) {
            keep = keep - 1;
        }
        i8* head = (i8*)__djinn_alloc_zeroed((size_long)(keep + 1));
        if (keep > 0) {
            memcpy((void*)head, (void*)value.data, (size_long)keep);
        }
        Dom.set_attr(target, "value", head, keep);
        __djinn_free((void*)head);
        Dom.dispatch(target, "input");
        return true;
    }

    static unsafe bool button_like(u32 id) {
        return Texts.same(Dom.tag(id), "button") || Texts.same(Dom.attr(id, "role"), "button");
    }

    // Delivers a key press. Returns true when the press was handled (a listener ran or a default action happened).
    public static unsafe bool press(i32 key, u32 mods) {
        input_key = key;
        input_mods = mods;
        input_prevented = false;
        mut u32 target = Focus.current();
        if (target == 0) {
            target = Dom.document();
        }
        mut bool handled = Dom.dispatch(target, "keydown") > 0;
        if (input_prevented) {
            input_key = 0;
            input_mods = 0;
            return true;
        }
        if (key == Key.TAB && (mods & Mod.CTRL) == 0 && (mods & Mod.ALT) == 0) {
            if (Focus.move((mods & Mod.SHIFT) != 0)) {
                handled = true;
            }
        } else if (key == Key.BACKSPACE) {
            u32 field = Focus.current();
            if (Input.editable(field) && Input.erase(field)) {
                handled = true;
            }
        } else if (key == Key.ESCAPE) {
            if (Focus.current() != 0) {
                Focus.clear();
                handled = true;
            }
        } else if (key == Key.ENTER || key == Key.SPACE) {
            u32 focused = Focus.current();
            if (focused != 0) {
                bool button = Input.button_like(focused);
                bool link = Texts.same(Dom.tag(focused), "a") && Dom.has_attr(focused, "href");
                if ((button && !Dom.has_attr(focused, "disabled")) || (link && key == Key.ENTER)) {
                    Dom.dispatch(focused, "click");
                    handled = true;
                }
            }
        }
        input_key = 0;
        input_mods = 0;
        return handled;
    }
}
