import std::types;

namespace ui;

// What the shared navigation kit asks of the machine it runs on. The web target has its own (libs/ui/js/kit.djinn).
struct Device {
    // The keyboard's main modifier is Command (macOS and iOS), not Control.
    public static bool apple() {
        return Platform.MacOs || Platform.Ios;
    }

    // The screen is wide enough for the desktop layout (a menu column instead of a menu button): 56.25rem.
    public static unsafe bool wide() {
        return Styles.wide_screen(56.25);
    }

    // Tab / Shift+Tab: the next or previous control in reading order takes focus.
    public static unsafe void step_focus(bool backward) {
        if (Focus.move(backward)) {
            Scroll.into_view(Focus.current());
        }
    }

    // No pointer: a remote control or buttons drive the interface.
    public static unsafe bool remote() {
        return Styles.no_pointer();
    }
}

// The first character of a label (a whole UTF-8 sequence), for the compact form of a menu entry. The web target has
// its own (libs/ui/js/kit.djinn).
struct Initial {
    public static unsafe str of(str label) {
        mut u32 bytes = 0;
        if (label.length > 0) {
            u8 lead = (u8)label.data[0];
            bytes = 1;
            if (lead >= 240) {
                bytes = 4;
            } else if (lead >= 224) {
                bytes = 3;
            } else if (lead >= 192) {
                bytes = 2;
            }
            if (bytes > (u32)label.length) {
                bytes = (u32)label.length;
            }
        }
        str first = { .data = label.data, .length = (size)bytes };
        return first;
    }
}
