import std::types;
import std::libc;

namespace ui;

unsafe static mut ptr animation_system = null;

struct Tween {
    mut u32 id;
    mut f32 from;
    mut f32 to;
    mut u32 start;
    mut u32 duration;
    mut bool started;
    mut bool hide;
    mut bool pop;
    mut f32 slide;
}

struct AnimationSystem {
    mut Tween* items;
    mut u32 count;
    mut u32 capacity;
    mut u32 now;
    mut u32 version;
}

// Time-driven animations on top of the retained tree. For now the animated property is the opacity of an element
// (multiplied into whatever the style says): enough for page and dialog transitions, drawn without a relayout.
// The host calls Animation.advance(milliseconds) once per loop iteration and keeps drawing while it returns true.
// Animations are skipped (the end value applies at once) when the user asked for reduced motion.
struct Animation {
    // The default durations (milliseconds): things appear a little slower than they leave.
    const u32 ENTER = 320;
    const u32 EXIT = 220;
    // A page entering after a navigation.
    const u32 PAGE = 440;

    static unsafe AnimationSystem* system() {
        if (animation_system == null) {
            animation_system = (ptr)__djinn_alloc_zeroed((size_long)sizeof(AnimationSystem));
        }
        return (AnimationSystem*)animation_system;
    }

    // Fades an element in from transparent over 'duration' milliseconds.
    public static unsafe void fade_in(u32 id, u32 duration) {
        Animation.fade(id, (f32)0.0, (f32)1.0, duration);
    }

    // A page entering: it fades in while sliding 'from' pixels (CSS pixels, either side) to its place with a spring.
    public static unsafe void enter(u32 id, u32 duration, f32 from) {
        Animation.fade_with(id, (f32)0.0, (f32)1.0, duration, false, false);
        AnimationSystem* system = Animation.system();
        mut u32 i = 0;
        while (i < system.count) {
            if (system.items[i].id == id) {
                system.items[i].slide = from;
            }
            i = i + 1;
        }
    }

    // Shows or hides an element the way the system does: it fades in, or fades out and is then hidden (data-gone,
    // see fade_out). The first call only sets the starting state.
    public static unsafe void present(u32 id, bool on) {
        if (!Dom.has_attr(id, "data-gone")) {
            if (on) {
                Dom.set_attr(id, "data-gone", "false", 5);
            } else {
                Dom.set_attr(id, "data-gone", "true", 4);
            }
            return;
        }
        if (on) {
            Animation.fade_with(id, (f32)0.0, (f32)1.0, Animation.ENTER, false, true);
        } else {
            Animation.fade_with(id, (f32)1.0, (f32)0.0, Animation.EXIT, true, true);
        }
    }

    // The attributes that move an element: data-open (dialogs, popups) presents or dismisses it, and a panel that
    // becomes data-active fades in. Called by the tree when an attribute is set.
    static unsafe void attribute(u32 id, str name, u32 length, bool existed) {
        if (name == "data-open") {
            Animation.present(id, length == 4);
        } else if (existed && length == 4 && name == "data-active") {
            if (Dom.has_attr(id, "data-slide")) {
                // A step of a wizard: it also slides in from the side the wizard moved.
                Animation.enter(id, Animation.ENTER, (f32)(24 * Router.direction()));
            } else {
                Animation.fade_in(id, Animation.ENTER);
            }
        }
    }

    // Fades an element out over 'duration' milliseconds and then hides it (data-gone="true", which the theme turns
    // into display: none); fade_in shows it again. With reduced motion it is hidden at once.
    public static unsafe void fade_out(u32 id, u32 duration) {
        Animation.fade_with(id, (f32)1.0, (f32)0.0, duration, true, false);
    }

    public static unsafe void fade(u32 id, f32 from, f32 to, u32 duration) {
        Animation.fade_with(id, from, to, duration, false, false);
    }

    static unsafe void fade_with(u32 id, f32 from, f32 to, u32 duration, bool hide, bool pop) {
        Animation.cancel(id);
        if (!hide && Dom.has_attr(id, "data-gone")) {
            Dom.set_attr(id, "data-gone", "false", 5);
        }
        if (Styles.prefers_reduced_motion() || duration == 0) {
            if (hide) {
                Dom.set_attr(id, "data-gone", "true", 4);
            }
            return;
        }
        AnimationSystem* system = Animation.system();
        if (system.count == system.capacity) {
            u32 grown = system.capacity * 2 + 8;
            Tween* items = (Tween*)__djinn_alloc_zeroed((size_long)(grown * (u32)sizeof(Tween)));
            if (system.count > 0) {
                memcpy((void*)items, (void*)system.items, (size_long)(system.count * (u32)sizeof(Tween)));
            }
            if (system.items != (Tween*)0) {
                __djinn_free((void*)system.items);
            }
            system.items = items;
            system.capacity = grown;
        }
        Tween* tween = &system.items[system.count];
        tween.id = id;
        tween.from = from;
        tween.to = to;
        tween.duration = duration;
        tween.start = 0;
        tween.started = false;
        tween.hide = hide;
        tween.pop = pop;
        tween.slide = (f32)0.0;
        system.count = system.count + 1;
        system.version = system.version + 1;
    }

    public static unsafe void cancel(u32 id) {
        AnimationSystem* system = Animation.system();
        mut u32 i = 0;
        while (i < system.count) {
            if (system.items[i].id == id) {
                system.items[i] = system.items[system.count - 1];
                system.count = system.count - 1;
                system.version = system.version + 1;
            } else {
                i = i + 1;
            }
        }
    }

    static f32 ease(f32 t) {
        f32 left = (f32)1.0 - t;
        return (f32)1.0 - left * left * left;
    }

    // A damped spring from 0 to 1 over t in 0..1: it leaves quickly, overshoots by about five percent and settles.
    static f32 spring(f32 t) {
        if (t >= (f32)1.0) {
            return (f32)1.0;
        }
        return (f32)1.0 - Math.exp((f32)-5.5 * t) * Math.cos((f32)7.0 * t);
    }

    // The opacity factor an animation gives an element right now (1 when it has none).
    public static unsafe f32 opacity(u32 id) {
        AnimationSystem* system = Animation.system();
        mut u32 i = 0;
        while (i < system.count) {
            Tween* tween = &system.items[i];
            if (tween.id == id) {
                if (!tween.started) {
                    return tween.from;
                }
                u32 elapsed = system.now - tween.start;
                if (elapsed >= tween.duration) {
                    return tween.to;
                }
                f32 t = Animation.ease((f32)elapsed / (f32)tween.duration);
                return tween.from + (tween.to - tween.from) * t;
            }
            i = i + 1;
        }
        return (f32)1.0;
    }

    // The scale an entrance or exit gives an element that was shown or hidden with 'present': it grows from 96% with a
    // spring when it appears and shrinks back to 96% when it leaves (1 when it has none).
    public static unsafe f32 pop_scale(u32 id) {
        AnimationSystem* system = Animation.system();
        mut u32 i = 0;
        while (i < system.count) {
            Tween* tween = &system.items[i];
            if (tween.id == id && tween.pop) {
                bool entering = tween.to > tween.from;
                if (!tween.started) {
                    if (entering) {
                        return (f32)0.96;
                    }
                    return (f32)1.0;
                }
                u32 elapsed = system.now - tween.start;
                if (elapsed >= tween.duration) {
                    return (f32)1.0;
                }
                f32 t = (f32)elapsed / (f32)tween.duration;
                if (entering) {
                    return (f32)0.96 + (f32)0.04 * Animation.spring(t);
                }
                return (f32)1.0 - (f32)0.04 * Animation.ease(t);
            }
            i = i + 1;
        }
        return (f32)1.0;
    }

    // How far an entering page still has to slide (device pixels; 0 when it has none).
    public static unsafe f32 slide_offset(u32 id) {
        AnimationSystem* system = Animation.system();
        mut u32 i = 0;
        while (i < system.count) {
            Tween* tween = &system.items[i];
            if (tween.id == id && tween.slide != (f32)0.0) {
                f32 scale = (f32)Styles.device_scale();
                if (!tween.started) {
                    return tween.slide * scale;
                }
                u32 elapsed = system.now - tween.start;
                if (elapsed >= tween.duration) {
                    return (f32)0.0;
                }
                f32 t = (f32)elapsed / (f32)tween.duration;
                return tween.slide * scale * ((f32)1.0 - Animation.spring(t));
            }
            i = i + 1;
        }
        return (f32)0.0;
    }

    // The clock the host last set with advance (milliseconds).
    public static unsafe u32 clock() {
        return Animation.system().now;
    }

    public static unsafe bool active() {
        return Animation.system().count > 0;
    }

    // Changes whenever an animation moves, so a host knows to draw again.
    public static unsafe u32 version() {
        return Animation.system().version;
    }

    // Moves the clock to 'now' (milliseconds, any origin) and retires finished animations. True while any is running.
    public static unsafe bool advance(u32 now) {
        AnimationSystem* system = Animation.system();
        system.now = now;
        Timers.advance(now);
        mut bool moving = Transitions.active();
        if (Scroll.advance(now)) {
            moving = true;
        }
        if (system.count == 0) {
            if (moving) {
                system.version = system.version + 1;
            }
            return moving;
        }
        mut u32 i = 0;
        while (i < system.count) {
            Tween* tween = &system.items[i];
            if (!tween.started) {
                tween.started = true;
                tween.start = now;
            }
            if (now - tween.start >= tween.duration) {
                if (tween.hide) {
                    Dom.set_attr(tween.id, "data-gone", "true", 4);
                }
                system.items[i] = system.items[system.count - 1];
                system.count = system.count - 1;
            } else {
                i = i + 1;
            }
        }
        system.version = system.version + 1;
        return system.count > 0 || moving;
    }
}
