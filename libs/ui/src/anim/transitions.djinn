import std::types;
import std::libc;

namespace ui;

unsafe static mut ptr transit_items = null;
unsafe static mut u32 transit_capacity = 0;
unsafe static mut u32 transit_active = 0;

// What one element shows while its colors and opacity move to a new style value.
struct Transit {
    mut bool seen;
    mut bool running;
    mut u32 start;
    mut u32 duration;
    mut u32 bg_from;
    mut u32 bg_to;
    mut u32 border_from;
    mut u32 border_to;
    mut u32 color_from;
    mut u32 color_to;
    mut f32 opacity_from;
    mut f32 opacity_to;
    mut u32 color_now;
}

// CSS 'transition' for the properties that never change the layout: background-color, border-color, color and
// opacity. An element whose style says 'transition: ... <time>' no longer jumps to the new value when :hover,
// :active, :focus, an attribute or a class changes it; it moves there over that time (cubic ease-out) and, when the
// target changes again midway, starts from wherever it is, so it is always interruptible. The painter asks for the
// values to draw, so the layout never reruns. Skipped under prefers-reduced-motion.
struct Transitions {
    static unsafe Transit* entry(u32 id) {
        if (id >= transit_capacity) {
            u32 wanted = id + 64;
            transit_items = (ptr)Dom.resize((void*)transit_items, transit_capacity, wanted, (u64)sizeof(Transit));
            transit_capacity = wanted;
        }
        return &((Transit*)transit_items)[id];
    }

    // Whether any element was still moving in the last frame: the host keeps drawing while it is.
    public static unsafe bool active() {
        return transit_active > 0;
    }

    // Called at the start of every frame.
    static unsafe void begin() {
        transit_active = 0;
    }

    static f32 mix(f32 from, f32 to, f32 t) {
        return from + (to - from) * t;
    }

    static u32 channel(u32 from, u32 to, u32 shift, f32 t) {
        f32 a = (f32)((from >> shift) & 255);
        f32 b = (f32)((to >> shift) & 255);
        return (u32)(a + (b - a) * t + (f32)0.5) & 255;
    }

    // Colors are 0xRRGGBBAA. A fully transparent end takes the other end's hue, so a fade to or from 'transparent'
    // does not pass through black.
    static u32 blend(u32 from, u32 to, f32 t) {
        if (from == to) {
            return to;
        }
        mut u32 start = from;
        mut u32 end = to;
        if ((from & 255) == 0) {
            start = to & 0xFFFFFF00;
        }
        if ((to & 255) == 0) {
            end = from & 0xFFFFFF00;
        }
        u32 red = Transitions.channel(start, end, 24, t);
        u32 green = Transitions.channel(start, end, 16, t);
        u32 blue = Transitions.channel(start, end, 8, t);
        u32 alpha = Transitions.channel(from, to, 0, t);
        return (red << 24) | (green << 16) | (blue << 8) | alpha;
    }

    static unsafe f32 progress(Transit* t, u32 now) {
        if (!t.running) {
            return (f32)1.0;
        }
        u32 elapsed = now - t.start;
        if (elapsed >= t.duration) {
            return (f32)1.0;
        }
        return Animation.ease((f32)elapsed / (f32)t.duration);
    }

    // Writes into 'out' (a copy of 'style') the values to draw right now for element 'id'; false when the style
    // is shown as it is.
    static unsafe bool apply(u32 id, Style* style, Style* out) {
        Transit* t = Transitions.entry(id);
        if (Styles.prefers_reduced_motion() || style.transition_ms == 0) {
            t.seen = false;
            t.running = false;
            t.color_now = style.color;
            return false;
        }
        u32 now = Animation.clock();
        if (!t.seen) {
            t.seen = true;
            t.running = false;
            t.bg_to = style.background;
            t.border_to = style.border_color;
            t.color_to = style.color;
            t.opacity_to = style.opacity;
            t.color_now = style.color;
            return false;
        }
        if (t.bg_to != style.background || t.border_to != style.border_color || t.color_to != style.color
            || t.opacity_to != style.opacity) {
            f32 before = Transitions.progress(t, now);
            t.bg_from = Transitions.blend(t.bg_from, t.bg_to, before);
            t.border_from = Transitions.blend(t.border_from, t.border_to, before);
            t.color_from = Transitions.blend(t.color_from, t.color_to, before);
            t.opacity_from = Transitions.mix(t.opacity_from, t.opacity_to, before);
            if (!t.running) {
                t.bg_from = t.bg_to;
                t.border_from = t.border_to;
                t.color_from = t.color_to;
                t.opacity_from = t.opacity_to;
            }
            t.bg_to = style.background;
            t.border_to = style.border_color;
            t.color_to = style.color;
            t.opacity_to = style.opacity;
            t.start = now;
            t.duration = style.transition_ms;
            t.running = true;
        }
        if (!t.running || now - t.start >= t.duration) {
            t.running = false;
            t.color_now = style.color;
            return false;
        }
        f32 p = Transitions.progress(t, now);
        transit_active = transit_active + 1;
        out.background = Transitions.blend(t.bg_from, t.bg_to, p);
        out.border_color = Transitions.blend(t.border_from, t.border_to, p);
        out.color = Transitions.blend(t.color_from, t.color_to, p);
        out.opacity = Transitions.mix(t.opacity_from, t.opacity_to, p);
        t.color_now = out.color;
        return true;
    }

    // The color text inside 'owner' is drawn with this frame.
    static unsafe u32 shown_color(u32 owner, u32 target) {
        if (owner >= transit_capacity) {
            return target;
        }
        Transit* t = &((Transit*)transit_items)[owner];
        if (!t.seen) {
            return target;
        }
        return t.color_now;
    }
}
