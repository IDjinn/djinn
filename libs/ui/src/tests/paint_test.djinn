namespace ui;

import testing;
import std::types;
import std::collections;

// A font for the tests: every glyph advances 0.6 em, is a solid box of 0.5 em x 0.7 em that rises 0.7 em above the
// baseline, and a line has an ascent of 0.8 em and a descent of 0.2 em. Deterministic, so pixels can be asserted.
struct TestFont {
    static unsafe void fill(f32 size, GlyphBitmap* out) {
        i32 width = (i32)(size * (f32)0.5);
        i32 height = (i32)(size * (f32)0.7);
        out.width = width;
        out.height = height;
        out.bearing_x = 0;
        out.bearing_y = height;
        u8* pixels = (u8*)__djinn_alloc((size_long)(width * height));
        memset((void*)pixels, 255, (size_long)(width * height));
        out.pixels = pixels;
    }

    public static unsafe void install() {
        FontProvider provider = {
            .advance = (u32 code, f32 size, u32 weight) => size * (f32)0.6,
            .rasterize = (u32 code, f32 size, u32 weight, u32 phase, GlyphBitmap* out) => {
                TestFont.fill(size, out);
                return true;
            },
            .metrics = (f32 size, u32 weight, f32* ascent, f32* descent) => {
                *ascent = size * (f32)0.8;
                *descent = size * (f32)0.2;
            }
        };
        Fonts.set_provider(provider);
        Dom.touch();
    }

    public static unsafe void remove() {
        Fonts.clear_provider();
        Dom.touch();
    }
}

// A frame of a detached tree on a white canvas.
struct Shot {
    public static unsafe Canvas take(Node root, u32 width, u32 height) {
        Layout.compute(root.id, (f32)width, (f32)height);
        mut DisplayList list = DisplayList.create();
        Painter.paint(&list, root.id, (f32)width, (f32)height);
        mut Canvas canvas = Canvas.create(width, height);
        canvas.clear(0xFFFFFFFF);
        SoftRaster.draw(&canvas, &list);
        list.release();
        return canvas;
    }

    public static unsafe u32 vertices(Node root, u32 width, u32 height) {
        Layout.compute(root.id, (f32)width, (f32)height);
        mut DisplayList list = DisplayList.create();
        Painter.paint(&list, root.id, (f32)width, (f32)height);
        u32 count = list.count;
        list.release();
        return count;
    }
}

struct TextTests {
    [Test]
    unsafe void a_provider_replaces_the_placeholder_metrics() {
        Styles.add(".t1 { font-size: 10px; line-height: 20px; width: 200px; }");
        Node text = Node.element("div").attr("class", "t1").add("ab cd");
        Layout.compute(text.id, (f32)800.0, (f32)600.0);
        Expect.equal(25, Lay.px(Layout.rect(Dom.first_child(text.id)).width), "5 placeholder characters at 5px, a space included");
        TestFont.install();
        Layout.compute(text.id, (f32)800.0, (f32)600.0);
        Expect.equal(30, Lay.px(Layout.rect(Dom.first_child(text.id)).width), "two words of 12px and a 6px space");
        TestFont.remove();
    }

    [Test]
    unsafe void lines_break_where_the_measure_says() {
        Styles.add(".t2 { font-size: 10px; line-height: 20px; width: 20px; }");
        TestFont.install();
        Node text = Node.element("div").attr("class", "t2").add("ab cd ef");
        Layout.compute(text.id, (f32)800.0, (f32)600.0);
        u32 child = Dom.first_child(text.id);
        mut TextLine* lines = (TextLine*)__djinn_alloc((size_long)(8 * sizeof(TextLine)));
        u32 count = TextLines.split(child, Layout.rect(child).width, lines, 8);
        Expect.equal(3, (i64)count, "one word per line in 20px");
        Expect.equal(60, Lay.px(Layout.rect(text.id).height), "three 20px lines");
        Expect.equal(12, Lay.px((*(lines + 1)).width));
        Expect.equal(3, (i64)(*(lines + 1)).start, "the second line starts at 'cd'");
        __djinn_free((void*)lines);
        TestFont.remove();
    }

    [Test]
    unsafe void a_glyph_is_rasterized_into_the_atlas_once() {
        TestFont.install();
        Glyph* first = Fonts.glyph(65, (f32)10.0, 400, 0);
        Expect.is_true(first != (Glyph*)0, "the glyph exists");
        u32 version = Fonts.atlas().version;
        Glyph* again = Fonts.glyph(65, (f32)10.0, 400, 0);
        Expect.is_true(first == again, "the same slot");
        Expect.equal((i64)version, (i64)Fonts.atlas().version, "nothing was uploaded again");
        Glyph* other = Fonts.glyph(66, (f32)10.0, 400, 0);
        Expect.is_true(other.atlas_x != first.atlas_x || other.atlas_y != first.atlas_y, "another place in the atlas");
        Expect.is_true(Fonts.glyph(32, (f32)10.0, 400, 0) != (Glyph*)0, "the test font draws a box even for a blank");
        TestFont.remove();
    }

    [Test]
    unsafe void text_paints_one_quad_per_glyph() {
        Styles.add(".t4 { font-size: 20px; line-height: 20px; color: #112233; width: 100px; }");
        TestFont.install();
        Node text = Node.element("div").attr("class", "t4").add("ab");
        u32 count = Shot.vertices(text, 100, 40);
        Expect.equal(12, (i64)count, "2 glyphs, 6 vertices each");
        mut Canvas canvas = Shot.take(text, 100, 40);
        // the first glyph is 10 x 14 px, its top 14 px above the baseline at 16
        Expect.equal(0x112233FF, (i64)canvas.at(5, 10), "inside the first glyph");
        Expect.equal(0xFFFFFFFF, (i64)canvas.at(11, 10), "between the glyphs");
        canvas.release();
        TestFont.remove();
    }
}

struct ClipTests {
    [Test]
    unsafe void a_rounded_box_that_crosses_the_clip_is_cut_at_it() {
        mut DisplayList list = DisplayList.create();
        list.clip_to((f32)0.0, (f32)40.0, (f32)200.0, (f32)200.0);
        list.rounded((f32)10.0, (f32)-60.0, (f32)100.0, (f32)120.0, (f32)12.0, 0xFF3366FF);
        Expect.is_true(list.count > 0, "the part inside is drawn");
        mut f32 top = (f32)1000.0;
        for (mut u32 i = 0; i < list.count; i = i + 1) {
            if ((*(list.vertices + i)).y < top) {
                top = (*(list.vertices + i)).y;
            }
        }
        Expect.is_true(top >= (f32)40.0, "nothing above the clip");
        list.restore_clip();
        list.release();
    }

    [Test]
    unsafe void a_ring_that_crosses_the_clip_is_cut_at_it() {
        mut DisplayList list = DisplayList.create();
        list.clip_to((f32)0.0, (f32)0.0, (f32)200.0, (f32)50.0);
        list.ring((f32)10.0, (f32)10.0, (f32)100.0, (f32)120.0, (f32)12.0, (f32)2.0, 0xFF3366FF);
        mut f32 bottom = (f32)-1000.0;
        for (mut u32 i = 0; i < list.count; i = i + 1) {
            if ((*(list.vertices + i)).y > bottom) {
                bottom = (*(list.vertices + i)).y;
            }
        }
        Expect.is_true(list.count > 0, "the part inside is drawn");
        Expect.is_true(bottom <= (f32)50.0, "nothing below the clip");
        list.restore_clip();
        list.release();
    }

    [Test]
    unsafe void a_box_inside_the_clip_is_left_alone() {
        mut DisplayList list = DisplayList.create();
        list.clip_to((f32)0.0, (f32)0.0, (f32)200.0, (f32)200.0);
        list.rounded((f32)10.0, (f32)10.0, (f32)50.0, (f32)50.0, (f32)8.0, 0xFF3366FF);
        Expect.equal(4 * 9 * 9, (i64)list.count, "every triangle of the shape is kept");
        list.restore_clip();
        list.release();
    }
}

struct PaintTests {
    [Test]
    unsafe void a_background_fills_its_box() {
        Styles.add(".p1 { width: 20px; height: 10px; background: #ff0000; }");
        Node box = Node.element("div").attr("class", "p1");
        Expect.equal(6, (i64)Shot.vertices(box, 40, 40), "one quad");
        mut Canvas canvas = Shot.take(box, 40, 40);
        Expect.equal(0xFF0000FF, (i64)canvas.at(5, 5));
        Expect.equal(0xFF0000FF, (i64)canvas.at(0, 0), "the corner pixel belongs to the box");
        Expect.equal(0xFF0000FF, (i64)canvas.at(19, 9), "so does the last one");
        Expect.equal(0xFFFFFFFF, (i64)canvas.at(20, 5), "the pixel after it does not");
        Expect.equal(0xFFFFFFFF, (i64)canvas.at(5, 10));
        canvas.release();
    }

    [Test]
    unsafe void opacity_blends_with_what_is_behind() {
        Styles.add(".p2 { width: 10px; height: 10px; background: #000000; opacity: 0.5; }");
        Node box = Node.element("div").attr("class", "p2");
        mut Canvas canvas = Shot.take(box, 20, 20);
        u32 pixel = canvas.at(5, 5);
        u32 red = pixel >> 24;
        Expect.is_true(red >= 126 && red <= 129, "half way between black and white");
        canvas.release();
    }

    [Test]
    unsafe void a_border_is_drawn_around_the_box() {
        Styles.add(".p3 { width: 20px; height: 20px; box-sizing: border-box; border: 2px solid #0000ff; }");
        Node box = Node.element("div").attr("class", "p3");
        mut Canvas canvas = Shot.take(box, 30, 30);
        Expect.equal(0x0000FFFF, (i64)canvas.at(0, 10), "the left edge");
        Expect.equal(0x0000FFFF, (i64)canvas.at(10, 1), "the top edge");
        Expect.equal(0xFFFFFFFF, (i64)canvas.at(10, 10), "the inside is not painted");
        canvas.release();
    }

    [Test]
    unsafe void rounded_corners_leave_the_corner_empty() {
        Styles.add(".p4 { width: 40px; height: 40px; background: #00aa00; border-radius: 12px; }");
        Node box = Node.element("div").attr("class", "p4");
        mut Canvas canvas = Shot.take(box, 50, 50);
        Expect.equal(0xFFFFFFFF, (i64)canvas.at(0, 0), "the corner is cut away");
        Expect.equal(0x00AA00FF, (i64)canvas.at(20, 20), "the middle is solid");
        Expect.equal(0x00AA00FF, (i64)canvas.at(20, 1), "so is the straight edge");
        canvas.release();
    }

    [Test]
    unsafe void overflow_hidden_clips_the_children() {
        Styles.add(".p5 { width: 20px; height: 20px; overflow: hidden; } .p5a { width: 60px; height: 60px; background: #ff00ff; }");
        Node inner = Node.element("div").attr("class", "p5a");
        Node box = Node.element("div").attr("class", "p5").child(inner);
        mut Canvas canvas = Shot.take(box, 80, 80);
        Expect.equal(0xFF00FFFF, (i64)canvas.at(10, 10), "inside the clip");
        Expect.equal(0xFFFFFFFF, (i64)canvas.at(30, 10), "outside it");
        Expect.equal(0xFFFFFFFF, (i64)canvas.at(10, 30));
        canvas.release();
    }

    [Test]
    unsafe void hidden_and_display_none_paint_nothing() {
        Styles.add(".p6 { width: 10px; height: 10px; background: #000; } .p6h { visibility: hidden; } .p6n { display: none; }");
        Node hidden = Node.element("div").attr("class", "p6 p6h");
        Node gone = Node.element("div").attr("class", "p6 p6n");
        Expect.equal(0, (i64)Shot.vertices(hidden, 20, 20));
        Expect.equal(0, (i64)Shot.vertices(gone, 20, 20));
    }

    [Test]
    unsafe void list_items_get_a_marker_outside_their_box() {
        Styles.add(".p7 { margin: 0; padding-left: 40px; font-size: 10px; line-height: 20px; width: 100px; } .p7 li { color: #000; }");
        TestFont.install();
        Node first = Node.element("li").add("a");
        Node second = Node.element("li").add("b");
        Node list = Node.element("ol").attr("class", "p7").attr("start", "3").child(first).child(second);
        mut Canvas canvas = Shot.take(list, 120, 60);
        Expect.is_true(Styles.of(first.id).list_item, "li is a list item");
        Expect.equal((i64)ListMarker.DECIMAL, (i64)Styles.of(first.id).list_marker, "ol numbers its items");
        Expect.equal(3, Painter.ordinal(first.id), "counting from 'start'");
        Expect.equal(4, Painter.ordinal(second.id));
        // "3. " is three 6px advances ending at the item's left edge (40px): the '3' box covers x 22..27, y 6..13
        Expect.is_true(canvas.at(24, 10) != 0xFFFFFFFF, "the number is drawn left of the item");
        Expect.equal(0xFFFFFFFF, (i64)canvas.at(24, 2), "above the glyph");
        canvas.release();
        TestFont.remove();
    }

    [Test]
    unsafe void marker_text_is_built_like_the_browser() {
        Expect.equal(5, (i64)Painter.marker_length(ListMarker.DECIMAL, -12), "-12. ");
        Expect.equal(45, (i64)Painter.marker_code(ListMarker.DECIMAL, -12, 0));
        Expect.equal(49, (i64)Painter.marker_code(ListMarker.DECIMAL, -12, 1));
        Expect.equal(50, (i64)Painter.marker_code(ListMarker.DECIMAL, -12, 2));
        Expect.equal(46, (i64)Painter.marker_code(ListMarker.DECIMAL, -12, 3));
        Expect.equal(32, (i64)Painter.marker_code(ListMarker.DECIMAL, -12, 4));
        Expect.equal(8226, (i64)Painter.marker_code(ListMarker.DISC, 0, 0), "a disc is the bullet character");
        Node item = Node.element("li").add("x");
        Node list = Node.element("ul").child(item);
        Layout.compute(list.id, (f32)200.0, (f32)100.0);
        Expect.equal((i64)ListMarker.DISC, (i64)Styles.of(item.id).list_marker, "ul items get a disc");
    }
}

struct FontUnitTests {
    [Test]
    unsafe void a_blank_before_a_run_is_drawn_as_a_space() {
        Styles.add(".f1 { font-size: 10px; line-height: 20px; width: 200px; }");
        TestFont.install();
        Node text = Node.element("div").attr("class", "f1").add("ab").add(" cd ");
        Layout.compute(text.id, (f32)800.0, (f32)600.0);
        u32 second = Dom.next_sibling(Dom.first_child(text.id));
        mut TextLine* lines = (TextLine*)__djinn_alloc((size_long)(8 * sizeof(TextLine)));
        u32 count = TextLines.split(second, (f32)-1.0, lines, 8);
        Expect.equal(1, (i64)count);
        Expect.equal(0, (i64)(*(lines + 0)).start, "the line starts at the blank, so the painter moves over it");
        Expect.equal(18, Lay.px((*(lines + 0)).width), "a 6px space and two 6px letters");
        Expect.equal(12, Lay.px(Layout.rect(Dom.first_child(text.id)).width), "the first run");
        Expect.equal(24, Lay.px(Layout.rect(second).width), "the measure counts both blanks");
        __djinn_free((void*)lines);
        TestFont.remove();
    }

    [Test]
    unsafe void ch_is_the_advance_of_zero() {
        Styles.add(".f2 { font-size: 10px; width: 10ch; }");
        TestFont.install();
        Node box = Node.element("div").attr("class", "f2");
        Layout.compute(box.id, (f32)800.0, (f32)600.0);
        Expect.equal(60, Lay.px(Layout.rect(box.id).width), "ten zeros of 6px");
        TestFont.remove();
    }

    [Test]
    unsafe void weights_are_kept_apart() {
        Expect.equal(500, (i64)Fonts.weight_of(500));
        Expect.equal(700, (i64)Fonts.weight_of(650));
        Expect.equal(900, (i64)Fonts.weight_of(1000));
        Expect.equal(100, (i64)Fonts.weight_of(0));
        TestFont.install();
        Glyph* regular = Fonts.glyph(65, (f32)10.0, 400, 0);
        Glyph* medium = Fonts.glyph(65, (f32)10.0, 500, 0);
        Expect.is_true(regular != medium, "500 is a glyph of its own, not the regular one");
        TestFont.remove();
    }

    [Test]
    unsafe void a_scroll_container_keeps_room_for_its_bar() {
        Styles.add(".s1 { width: 100px; height: 50px; overflow: auto; scrollbar-width: thin; } .s1 > div { height: 200px; } .s1n { scrollbar-width: none; } .s1s { overflow: scroll; } .s1s > div { height: 10px; }");
        Node tall = Node.element("div");
        Node box = Node.element("div").attr("class", "s1").child(tall);
        Layout.compute(box.id, (f32)800.0, (f32)600.0);
        Expect.equal(10, Lay.px(Layout.box(box.id).gutter), "thin bars take 10px, as in the browser");
        Expect.equal(90, Lay.px(Layout.rect(tall.id).width), "the content gets the rest");
        mut BarRect r = { .x = (f32)0.0, .y = (f32)0.0, .w = (f32)0.0, .h = (f32)0.0, .free = (f32)0.0 };
        Expect.is_true(Bars.rect(box.id, true, &r), "there is a thumb");
        Expect.equal(92, Lay.px(r.x), "inside the strip, 2px from its edges");
        Expect.equal(6, Lay.px(r.w));
        Node hidden = Node.element("div");
        Node bare = Node.element("div").attr("class", "s1 s1n").child(hidden);
        Layout.compute(bare.id, (f32)800.0, (f32)600.0);
        Expect.equal(100, Lay.px(Layout.rect(hidden.id).width), "scrollbar-width: none keeps no room");
        Expect.is_true(!Bars.rect(bare.id, true, &r), "and shows no thumb");
        Node low = Node.element("div");
        Node always = Node.element("div").attr("class", "s1 s1s").child(low);
        Layout.compute(always.id, (f32)800.0, (f32)600.0);
        Expect.equal(90, Lay.px(Layout.rect(low.id).width), "overflow: scroll keeps it even when the content fits");
        Node short = Node.element("p").add("x");
        Node fits = Node.element("div").attr("class", "s1").child(short);
        Layout.compute(fits.id, (f32)800.0, (f32)600.0);
        Expect.equal(0, Lay.px(Layout.box(fits.id).gutter), "auto keeps none when nothing overflows");
    }

    [Test]
    unsafe void the_page_bar_sits_in_its_strip() {
        Scroll.page_limit((f32)500.0, (f32)500.0);
        Bars.set_page((f32)800.0, (f32)10.0);
        mut BarRect r = { .x = (f32)0.0, .y = (f32)0.0, .w = (f32)0.0, .h = (f32)0.0, .free = (f32)0.0 };
        Expect.is_true(Bars.rect(Dom.document(), true, &r), "a taller document has a page thumb");
        Expect.equal(792, Lay.px(r.x));
        Expect.equal(6, Lay.px(r.w));
        Expect.equal(248, Lay.px(r.h), "half the track: the window shows half the document");
        Expect.is_true(Bars.on_track(Dom.document(), true, (f32)795.0, (f32)400.0), "below the thumb is track");
        Bars.set_page((f32)0.0, (f32)0.0);
        Scroll.page_limit((f32)0.0, (f32)500.0);
    }
}
