namespace ui;

import testing;
import std::types;

unsafe static mut u32 fake_writes = 0;

// A backend written against the interface only: what any platform has to provide.
struct FakeClipboard : ClipboardBackend {
    i32 unused;

    public unsafe void write(i8* data, u32 length) {
        fake_writes = fake_writes + length;
    }

    public unsafe i8* read(u32* length) {
        *length = 3;
        return (i8*)"abc";
    }
}

struct ClipboardTests {
    [Test]
    unsafe void a_backend_installed_through_the_interface_serves_reads_and_writes() {
        FakeClipboard backend = { .unused = 0 };
        Clipboard.use<FakeClipboard>(backend);
        fake_writes = 0;
        Clipboard.write((i8*)"hello", 5);
        Expect.equal(5, (i64)fake_writes);
        mut u32 length = 0;
        i8* text = Clipboard.read(&length);
        Expect.equal(3, (i64)length);
        Expect.equal(97, (i64)*(text + 0));
    }
}
