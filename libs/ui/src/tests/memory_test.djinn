namespace ui;

import testing;
import std::types;
import std::libc;

extern "C" {
    void* GetCurrentProcess();
    i32 K32GetProcessMemoryInfo(void* process, void* counters, u32 size);
}

unsafe static mut u32 memory_signal = 0;

struct MemoryPage {
    i32 unused;

    static str cls(i32 phase) {
        if (phase % 2 == 0) {
            return "ma";
        }
        return "ma mb";
    }

    public unsafe Node render() {
        signal<i32> phase = state(0);
        memory_signal = phase.id;
        return html!{
            <section class="card stack">
                <div class={MemoryPage.cls(phase.get())}></div>
                <p>Phase {phase}</p>
            </section>
        };
    }
}

// Styling and drawing again and again must not grow the process: a restyle once leaked the token array of every
// declaration it applied (about 90 KB per frame of an animated page).
struct MemoryTests {
    static unsafe u64 working_set() {
        u64* info = (u64*)__djinn_alloc_zeroed((size_long)72);
        info[0] = 72;
        K32GetProcessMemoryInfo(GetCurrentProcess(), (void*)info, 72);
        u64 bytes = info[2];
        __djinn_free((void*)info);
        return bytes;
    }

    [Test]
    unsafe void restyling_and_painting_do_not_leak() {
        Styles.set_reduced_motion(true);
        Styles.add(".ma { width: 20px; height: 20px; background-color: color-mix(in oklab, #3b82f6 50%, white); } .mb { background-color: #ec4899; }");
        Mounted app = App.mount<MemoryPage>(MemoryPage { .unused = 0 });
        DisplayList list = DisplayList.create();
        Painter.frame(&list, (f32)400.0, (f32)300.0);
        u64 before = MemoryTests.working_set();
        signal<i32> phase = { .id = memory_signal };
        mut u32 i = 0;
        while (i < 1500) {
            phase.set(phase.peek() + 1);
            Painter.frame(&list, (f32)400.0, (f32)300.0);
            i = i + 1;
        }
        u64 grown = MemoryTests.working_set() - before;
        Expect.is_true(grown < (u64)(16 * 1024 * 1024), "1500 restyled frames grew the process by less than 16 MB");
        app.unmount();
        Styles.set_reduced_motion(false);
    }
}
