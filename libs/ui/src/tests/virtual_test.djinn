namespace ui;

import testing;
import std::types;

struct VirtualTests {
    static unsafe Node cell(i32 index) {
        return Node.element("b").add("row");
    }

    // The rows mounted in the space of the list (the second child of the box is the space; the first is none).
    static unsafe u32 mounted(Node box) {
        u32 space = Dom.first_child(box.id);
        mut u32 count = 0;
        mut u32 row = Dom.first_child(space);
        while (row != 0) {
            count = count + 1;
            row = Dom.next_sibling(row);
        }
        return count;
    }

    [Test]
    unsafe void only_the_rows_in_view_are_mounted() {
        Scroll.reset();
        u32 root = Reactive.root(() => {
            Node page = html!{ <VirtualList count={10000} item_height={20} height={100} row={(i32 i) => VirtualTests.cell(i)}/> };
            Layout.compute(page.id, (f32)300.0, (f32)300.0);
            Expect.equal(9, (i64)VirtualTests.mounted(page), "5 in view, 1 more and 3 of overscan");
            Expect.is_true(Scroll.container(page.id));
            Expect.is_true(Scroll.max_y(page.id) > (f32)199000.0, "the whole list is scrollable");
            Scroll.set(page.id, (f32)0.0, (f32)4000.0);
            Expect.equal(200, (i64)(Scroll.top(page.id) / (f32)20.0), "scrolled to row 200");
            Expect.equal(12, (i64)VirtualTests.mounted(page), "the window moved to rows 197..208");
            Scroll.reset();
        });
        Reactive.dispose(root);
    }
}
