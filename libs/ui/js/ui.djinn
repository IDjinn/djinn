}

// Control flow and composition for html!.
struct View {
    [Js("document.createDocumentFragment()")]
    public static Node fragment() {
        return Opaque.value<Node>();
    }

    [Js("$show($0, $1, $2)")]
    public static Node show(fn() -> bool when, fn() -> Node yes, fn() -> Node no) {
        return Opaque.value<Node>();
    }

    [Js("$show($0, $1, null)")]
    public static Node show(fn() -> bool when, fn() -> Node yes) {
        return Opaque.value<Node>();
    }

    [Js("$each($0, $1, $2)")]
    public static Node each<T>(fn() -> slice<T> items, fn(T) -> i64 key, fn(T) -> Node render) {
        return Opaque.value<Node>();
    }

    [Js("$eachValue($0, $1)")]
    public static Node each_value<T>(fn() -> slice<T> items, fn(T) -> Node render) {
        return Opaque.value<Node>();
    }

    [Js("$range($0, $1, $2)")]
    public static Node range(fn() -> i32 start, fn() -> i32 end, fn(i32) -> Node render) {
        return Opaque.value<Node>();
    }

    // A component renders once, untracked: only the computations it creates react.
    public static Node mount<T>(T props) {
        u32 observer = Reactive.pause();
        Node node = props.render();
        Reactive.resume(observer);
        return node;
    }

    [Js("$island($0, () => $1)")]
    public static Node island(str name, Node content) {
        return content;
    }

    [Js("$raw($0)")]
    public static Node prerendered(str html) {
        return Opaque.value<Node>();
    }

    [Js("$serverIsland($0)")]
    public static Node server_island(str name) {
        return Opaque.value<Node>();
    }

    [Js("$1")]
    public static Node server_part(str name, Node content) {
        return content;
    }

    // The route the page shows: 'view' renders it, again on every navigation.
    [Js("$outlet($0)")]
    public static Node route(fn(str) -> Node view) {
        return Opaque.value<Node>();
    }
}

// The props of a [Client] island, as the server wrote them in data-props: 'open' finds the island's element, then
// each get_* reads one field and gives back the declaration's value when it is missing or of another type.
struct IslandProps {
    [Js("$propsOpen($0)")]
    public static void open(str island) {
    }

    [Js("$propRead($0, $1, $isBool)")]
    public static bool get_bool(str name, bool fallback) {
        return fallback;
    }

    [Js("$propRead($0, $1, $isI32)")]
    public static i32 get_i32(str name, i32 fallback) {
        return fallback;
    }

    [Js("$propRead($0, $1, $isU32)")]
    public static u32 get_u32(str name, u32 fallback) {
        return fallback;
    }

    [Js("$propRead($0, $1, $isStr)")]
    public static str get_str(str name, str fallback) {
        return fallback;
    }

    [Js("$propList($0, $1, $isBool)")]
    public static slice<bool> get_slice_bool(str name, slice<bool> fallback) {
        return fallback;
    }

    [Js("$propList($0, $1, $isI32)")]
    public static slice<i32> get_slice_i32(str name, slice<i32> fallback) {
        return fallback;
    }

    [Js("$propList($0, $1, $isU32)")]
    public static slice<u32> get_slice_u32(str name, slice<u32> fallback) {
        return fallback;
    }

    [Js("$propList($0, $1, $isStr)")]
    public static slice<str> get_slice_str(str name, slice<str> fallback) {
        return fallback;
    }
}

struct RenderMode {
    const u8 CLIENT = 0;
    const u8 HYDRATE = 1;
    const u8 SERVER = 2;
    const u8 STATIC = 3;
}

struct App {
    // The entry point [Application] generates.
    public static i32 run<T>(T app, u8 mode) {
        App.attach(() => View.mount<T>(app), mode, ThemeSheet.css());
        return 0;
    }

    [Js("$mountApp($0, $1, $2)")]
    static void attach(fn() -> Node render, u8 mode, str theme) {
    }

    // The entry point of a page only the server renders ([Application(render: server | static)]): the program is the
    // [Client] islands it holds, each mounted on the <dj-island> of its name. The page itself is not part of it.
    [Js("($mountIslands($islands), 0)")]
    public static i32 islands<T>(T app, u8 mode) {
        return 0;
    }
}

struct Theme {
    [Js("$theme.set($0)")]
    public static void set(u8 mode) {
    }

    [Js("$theme.toggle()")]
    public static void toggle() {
    }

    [Js("$theme.isDark()")]
    public static bool is_dark() {
        return false;
    }
}

// The router: the path is a signal (an effect that reads Router.path() runs again after each navigation), the address
// bar follows with pushState and the back button works. matches/param follow the native rules (':name' segments,
// a trailing '*').
struct Router {
    [Js("$matches($0, $1)")]
    public static bool matches(str pattern, str path) {
        return false;
    }

    [Js("$param($0, $1, $2)")]
    public static str param(str pattern, str path, str name) {
        return "";
    }

    [Js("$navigate($0)")]
    public static void navigate(str path) {
    }

    [Js("$navigate($0, true)")]
    public static void start(str path) {
    }

    [Js("history.back()")]
    public static void back() {
    }

    [Js("history.forward()")]
    public static void forward() {
    }

    [Js("$read($path)")]
    public static str path() {
        return "";
    }

    [Js("$direction")]
    public static i32 direction() {
        return 1;
    }
}

// The page for the current path, inside the same <div class="outlet"><div class="route"> as natively.
struct Outlet {
    fn(str) -> Node view;

    [Js("$outlet($this.view)")]
    public Node render() {
        return Opaque.value<Node>();
    }
}
