import std::collections;

namespace ui;

// libs/ui for the web target. The same API as the native library (html!, signals, components, render modes), but
// every function is a [Js] template: djinnc inlines it at the call, so a program talks to ui.js (and through it to
// the DOM) with no Djinn layer in between. A binding has no body (abstract, or a struct of the extern "JS" block at
// the end): there is nothing to run, only the template.

// A reactive value; on the web a $Signal object.
struct signal<T> {
    [Js("$signal($0)")]
    signal(T initial) {
    }

    [Js("$read($this)")]
    public abstract T get();

    [Js("$peek($this)")]
    public abstract T peek();

    [Js("$set($this, $0)")]
    public void set(T value) {
    }

    [Js("$set($this, $0($peek($this)))")]
    public void update(fn(T) -> T change) {
    }

    [Js("$notify($this)")]
    public void notify() {
    }
}

// A derived value, recomputed only when what it read changed.
struct memo<T> {
    [Js("$memo($0)")]
    memo(fn() -> T compute) {
    }

    [Js("$memoRead($this)")]
    public abstract T get();

    [Js("$memoPeek($this)")]
    public abstract T peek();
}

[Js("$signal($0)")]
abstract signal<T> state<T>(T initial);

[Js("$memo($0)")]
abstract memo<T> derived<T>(fn() -> T compute);

[Js("$effect($0)")]
abstract u32 effect(fn() -> void body);

[Js("$untrack($0)")]
abstract T untracked<T>(fn() -> T body);



// Control flow and composition for html!.
struct View {
    [Js("document.createDocumentFragment()")]
    public static abstract Node fragment();

    [Js("$show($0, $1, $2)")]
    public static abstract Node show(fn() -> bool when, fn() -> Node yes, fn() -> Node no);

    [Js("$show($0, $1, null)")]
    public static abstract Node show(fn() -> bool when, fn() -> Node yes);

    [Js("$each($0, $1, $2)")]
    public static abstract Node each<T>(fn() -> slice<T> items, fn(T) -> i64 key, fn(T) -> Node render);

    [Js("$eachValue($0, $1)")]
    public static abstract Node each_value<T>(fn() -> slice<T> items, fn(T) -> Node render);

    [Js("$range($0, $1, $2)")]
    public static abstract Node range(fn() -> i32 start, fn() -> i32 end, fn(i32) -> Node render);

    // A component renders once, untracked: only the computations it creates react.
    public static Node mount<T>(T props) {
        u32 observer = Reactive.pause();
        Node node = props.render();
        Reactive.resume(observer);
        return node;
    }

    [Js("$island($0, () => $1)")]
    public static abstract Node island(str name, Node content);

    [Js("$raw($0)")]
    public static abstract Node prerendered(str html);

    [Js("$serverIsland($0)")]
    public static abstract Node server_island(str name);

    [Js("$1")]
    public static abstract Node server_part(str name, Node content);

    // The route the page shows: 'view' renders it, again on every navigation.
    [Js("$outlet($0)")]
    public static abstract Node route(fn(str) -> Node view);
}


struct RenderMode {
    const u8 CLIENT = 0;
    const u8 HYDRATE = 1;
    const u8 SERVER = 2;
    const u8 STATIC = 3;
}

struct App {
    // The entry point [Application] generates.
    public static i32 run<T>(T app, u8 mode) {
        App.attach(() => View.mount<T>(app), mode, ThemeSheet.css());
        return 0;
    }

    [Js("$mountApp($0, $1, $2)")]
    static void attach(fn() -> Node render, u8 mode, str theme) {
    }

    // The entry point of a page only the server renders ([Application(render: server | static)]): the program is the
    // [Client] islands it holds, each mounted on the <dj-island> of its name. The page itself is not part of it.
    [Js("($mountIslands($islands), 0)")]
    public static i32 islands<T>(T app, u8 mode) {
        return 0;
    }
}



// The page for the current path, inside the same <div class="outlet"><div class="route"> as natively.
struct Outlet {
    fn(str) -> Node view;
    str groups;

    [Js("$outlet($this.view, $this.groups)")]
    public abstract Node render();
}


extern "JS" {
    // A DOM node.
    struct Node {
        [Js("$el($0)")]
        public static Node element(str tag);

        [Js("$txt($0)")]
        public static Node text(str value);

        [Js("document.createDocumentFragment()")]
        public static Node fragment();

        [Js("document.createDocumentFragment()")]
        public static Node none();

        [Js("$child($this, $0)")]
        public Node child(Node node);

        [Js("$text($this, $0)")]
        public Node add(str value);

        [Js("$attr($this, $0, $1)")]
        public Node attr(str name, str value);

        [Js("$on($this, $0, $1)")]
        public Node on(str event, fn() -> void handler);

        // The value of an <input> or <textarea> as it is typed.
        [Js("$onValue($this, $0)")]
        public Node on_value(fn(str) -> void handler);

        // Two-way binding of an input's value / a checkbox's state to a signal.
        [Js("$bindValue($this, $0)")]
        public Node bind_value(signal<str> value);

        [Js("$bindChecked($this, $0)")]
        public Node bind_checked(signal<bool> checked);

        [Js("$insertNode($this, $0)")]
        public Node insert(fn() -> Node render);

        [Js("$insertText($this, $0)")]
        public Node insert(fn() -> str value);

        [Js("$insertText($this, $0)")]
        public Node insert(fn() -> string value);

        [Js("$insertText($this, $0)")]
        public Node insert(fn() -> i32 value);

        [Js("$insertText($this, $0)")]
        public Node insert(fn() -> i64 value);

        [Js("$insertText($this, $0)")]
        public Node insert(fn() -> u32 value);

        [Js("$insertText($this, $0)")]
        public Node insert(fn() -> bool value);

        [Js("$insertText($this, $0)")]
        public Node insert(fn() -> f64 value);

        [Js("$insertSignal($this, $0)")]
        public Node insert(fn() -> signal<i32> value);

        [Js("$insertSignal($this, $0)")]
        public Node insert(fn() -> signal<i64> value);

        [Js("$insertSignal($this, $0)")]
        public Node insert(fn() -> signal<bool> value);

        [Js("$insertSignal($this, $0)")]
        public Node insert(fn() -> signal<f64> value);

        [Js("$insertSignal($this, $0)")]
        public Node insert(fn() -> signal<str> value);

        [Js("$insertMemo($this, $0)")]
        public Node insert(fn() -> memo<i32> value);

        [Js("$insertMemo($this, $0)")]
        public Node insert(fn() -> memo<i64> value);

        [Js("$insertMemo($this, $0)")]
        public Node insert(fn() -> memo<bool> value);

        [Js("$insertMemo($this, $0)")]
        public Node insert(fn() -> memo<str> value);

        [Js("$attrFn($this, $0, $1)")]
        public Node attr(str name, fn() -> str value);

        [Js("$attrFn($this, $0, $1)")]
        public Node attr(str name, fn() -> string value);

        [Js("$attrFn($this, $0, $1)")]
        public Node attr(str name, fn() -> i32 value);

        [Js("$attrFn($this, $0, $1)")]
        public Node attr(str name, fn() -> bool value);

        [Js("$attrSignal($this, $0, $1)")]
        public Node attr(str name, fn() -> signal<i32> value);

        [Js("$attrSignal($this, $0, $1)")]
        public Node attr(str name, fn() -> signal<str> value);

        [Js("$attrSignal($this, $0, $1)")]
        public Node attr(str name, fn() -> signal<bool> value);

        [Js("$attrMemo($this, $0, $1)")]
        public Node attr(str name, fn() -> memo<str> value);
    }

    // The props of a [Client] island, as the server wrote them in data-props: 'open' finds the island's element, then
    // each get_* reads one field and gives back the declaration's value when it is missing or of another type.
    struct IslandProps {
        [Js("$propsOpen($0)")]
        public static void open(str island);

        [Js("$propRead($0, $1, $isBool)")]
        public static bool get_bool(str name, bool fallback);

        [Js("$propRead($0, $1, $isI32)")]
        public static i32 get_i32(str name, i32 fallback);

        [Js("$propRead($0, $1, $isU32)")]
        public static u32 get_u32(str name, u32 fallback);

        [Js("$propRead($0, $1, $isStr)")]
        public static str get_str(str name, str fallback);

        [Js("$propList($0, $1, $isBool)")]
        public static slice<bool> get_slice_bool(str name, slice<bool> fallback);

        [Js("$propList($0, $1, $isI32)")]
        public static slice<i32> get_slice_i32(str name, slice<i32> fallback);

        [Js("$propList($0, $1, $isU32)")]
        public static slice<u32> get_slice_u32(str name, slice<u32> fallback);

        [Js("$propList($0, $1, $isStr)")]
        public static slice<str> get_slice_str(str name, slice<str> fallback);
    }

    struct Theme {
        [Js("$theme.set($0)")]
        public static void set(u8 mode);

        [Js("$theme.toggle()")]
        public static void toggle();

        [Js("$theme.isDark()")]
        public static bool is_dark();
    }

    // The router: the path is a signal (an effect that reads Router.path() runs again after each navigation), the address
    // bar follows with pushState and the back button works. matches/param follow the native rules (':name' segments,
    // a trailing '*').
    struct Router {
        [Js("$matches($0, $1)")]
        public static bool matches(str pattern, str path);

        [Js("$param($0, $1, $2)")]
        public static str param(str pattern, str path, str name);

        [Js("$navigate($0)")]
        public static void navigate(str path);

        [Js("$navigate($0, true)")]
        public static void start(str path);

        [Js("history.back()")]
        public static void back();

        [Js("history.forward()")]
        public static void forward();

        [Js("$read($path)")]
        public static str path();

        [Js("$getDirection()")]
        public static i32 direction();

        [Js("$path.value")]
        public static str peek();

        [Js("$canBack()")]
        public static bool can_go_back();

        [Js("$canForward()")]
        public static bool can_go_forward();

        [Js("$setDirection($0)")]
        public static void set_direction(i32 direction);
    }

    // Prefetch and prerender, as natively: a link that is hovered, focused or eager asks for its page, the Outlet's view
    // builds it off screen and the Outlet shows the finished page when the user gets there.
    struct Prefetch {
        [Js("$prefetchEnable($0)")]
        public static void enable(bool on);

        [Js("!$pf.off")]
        public static bool enabled();

        [Js("$pf.skip.push($0)")]
        public static void skip(str pattern);

        [Js("($pf.hook = $0)")]
        public static void on_request(fn(str) -> void hook);

        [Js("$prefetch($0)")]
        public static void request(str path);

        [Js("$prefetchClear()")]
        public static void clear();

        [Js("$pf.cache.has($0)")]
        public static bool has(str path);
    }

    struct Reactive {
        [Js("$batch($0)")]
        public static void batch(fn() -> void body);

        [Js("$untrack($0)")]
        public static void untrack(fn() -> void body);

        [Js("$onCleanup($0)")]
        public static void on_cleanup(fn() -> void cleanup);

        // Stops tracking until resume (what mounting a component does around its render).
        [Js("$pause()")]
        public static u32 pause();

        [Js("$resume($0)")]
        public static void resume(u32 observer);
    }
}
