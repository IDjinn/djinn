import std::collections;

namespace ui;

// libs/ui for the web target. The same API as the native library (html!, signals, components, render modes), but
// every function is a [Js] template: djinnc inlines it at the call, so a program talks to ui.js (and through it to
// the DOM) with no Djinn layer in between. The bodies only exist for the type checker and never run.
struct Opaque {
    [Js("undefined")]
    public static unsafe T value<T>() {
        return *(T*)(void*)0;
    }
}

// A reactive value; on the web a $Signal object.
struct signal<T> {
    [Js("$signal($0)")]
    signal(T initial) {
    }

    [Js("$read($this)")]
    public T get() {
        return Opaque.value<T>();
    }

    [Js("$peek($this)")]
    public T peek() {
        return Opaque.value<T>();
    }

    [Js("$set($this, $0)")]
    public void set(T value) {
    }

    [Js("$set($this, $0($peek($this)))")]
    public void update(fn(T) -> T change) {
    }

    [Js("$notify($this)")]
    public void notify() {
    }
}

// A derived value, recomputed only when what it read changed.
struct memo<T> {
    [Js("$memo($0)")]
    memo(fn() -> T compute) {
    }

    [Js("$memoRead($this)")]
    public T get() {
        return Opaque.value<T>();
    }

    [Js("$memoPeek($this)")]
    public T peek() {
        return Opaque.value<T>();
    }
}

[Js("$signal($0)")]
signal<T> state<T>(T initial) {
    return Opaque.value<signal<T>>();
}

[Js("$memo($0)")]
memo<T> derived<T>(fn() -> T compute) {
    return Opaque.value<memo<T>>();
}

[Js("$effect($0)")]
u32 effect(fn() -> void body) {
    return 0;
}

[Js("$untrack($0)")]
T untracked<T>(fn() -> T body) {
    return Opaque.value<T>();
}

struct Reactive {
    [Js("$batch($0)")]
    public static void batch(fn() -> void body) {
    }

    [Js("$untrack($0)")]
    public static void untrack(fn() -> void body) {
    }

    [Js("$onCleanup($0)")]
    public static void on_cleanup(fn() -> void cleanup) {
    }

    // Stops tracking until resume (what mounting a component does around its render).
    [Js("$pause()")]
    public static u32 pause() {
        return 0;
    }

    [Js("$resume($0)")]
    public static void resume(u32 observer) {
    }
}

// A DOM node.
struct Node {
    [Js("$el($0)")]
    public static Node element(str tag) {
        return Opaque.value<Node>();
    }

    [Js("$txt($0)")]
    public static Node text(str value) {
        return Opaque.value<Node>();
    }

    [Js("document.createDocumentFragment()")]
    public static Node fragment() {
        return Opaque.value<Node>();
    }

    [Js("document.createDocumentFragment()")]
    public static Node none() {
        return Opaque.value<Node>();
    }

    [Js("$child($this, $0)")]
    public Node child(Node node) {
        return Opaque.value<Node>();
    }

    [Js("$text($this, $0)")]
    public Node add(str value) {
        return Opaque.value<Node>();
    }

    [Js("$attr($this, $0, $1)")]
    public Node attr(str name, str value) {
        return Opaque.value<Node>();
    }

    [Js("$on($this, $0, $1)")]
    public Node on(str event, fn() -> void handler) {
        return Opaque.value<Node>();
    }

    // The value of an <input> or <textarea> as it is typed.
    [Js("$onValue($this, $0)")]
    public Node on_value(fn(str) -> void handler) {
        return Opaque.value<Node>();
    }

    // Two-way binding of an input's value / a checkbox's state to a signal.
    [Js("$bindValue($this, $0)")]
    public Node bind_value(signal<str> value) {
        return Opaque.value<Node>();
    }

    [Js("$bindChecked($this, $0)")]
    public Node bind_checked(signal<bool> checked) {
        return Opaque.value<Node>();
    }

    [Js("$insertNode($this, $0)")]
    public Node insert(fn() -> Node render) {
        return Opaque.value<Node>();
    }

    [Js("$insertText($this, $0)")]
    public Node insert(fn() -> str value) {
        return Opaque.value<Node>();
    }

    [Js("$insertText($this, $0)")]
    public Node insert(fn() -> string value) {
        return Opaque.value<Node>();
    }

    [Js("$insertText($this, $0)")]
    public Node insert(fn() -> i32 value) {
        return Opaque.value<Node>();
    }

    [Js("$insertText($this, $0)")]
    public Node insert(fn() -> i64 value) {
        return Opaque.value<Node>();
    }

    [Js("$insertText($this, $0)")]
    public Node insert(fn() -> u32 value) {
        return Opaque.value<Node>();
    }

    [Js("$insertText($this, $0)")]
    public Node insert(fn() -> bool value) {
        return Opaque.value<Node>();
    }

    [Js("$insertText($this, $0)")]
    public Node insert(fn() -> f64 value) {
        return Opaque.value<Node>();
    }

    [Js("$insertSignal($this, $0)")]
    public Node insert(fn() -> signal<i32> value) {
        return Opaque.value<Node>();
    }

    [Js("$insertSignal($this, $0)")]
    public Node insert(fn() -> signal<i64> value) {
        return Opaque.value<Node>();
    }

    [Js("$insertSignal($this, $0)")]
    public Node insert(fn() -> signal<bool> value) {
        return Opaque.value<Node>();
    }

    [Js("$insertSignal($this, $0)")]
    public Node insert(fn() -> signal<f64> value) {
        return Opaque.value<Node>();
    }

    [Js("$insertSignal($this, $0)")]
    public Node insert(fn() -> signal<str> value) {
        return Opaque.value<Node>();
    }

    [Js("$insertMemo($this, $0)")]
    public Node insert(fn() -> memo<i32> value) {
        return Opaque.value<Node>();
    }

    [Js("$insertMemo($this, $0)")]
    public Node insert(fn() -> memo<i64> value) {
        return Opaque.value<Node>();
    }

    [Js("$insertMemo($this, $0)")]
    public Node insert(fn() -> memo<bool> value) {
        return Opaque.value<Node>();
    }

    [Js("$insertMemo($this, $0)")]
    public Node insert(fn() -> memo<str> value) {
        return Opaque.value<Node>();
    }

    [Js("$attrFn($this, $0, $1)")]
    public Node attr(str name, fn() -> str value) {
        return Opaque.value<Node>();
    }

    [Js("$attrFn($this, $0, $1)")]
    public Node attr(str name, fn() -> string value) {
        return Opaque.value<Node>();
    }

    [Js("$attrFn($this, $0, $1)")]
    public Node attr(str name, fn() -> i32 value) {
        return Opaque.value<Node>();
    }

    [Js("$attrFn($this, $0, $1)")]
    public Node attr(str name, fn() -> bool value) {
