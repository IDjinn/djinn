import std::types;

namespace ui;

// The platform services the shared kit (libs/ui/src/kit, listed in shared.txt) needs, and the kit components that
// talk to the DOM natively, written for the browser with the same markup.
extern "JS" {
    struct Choices {
        [Js("($0.length === 0 ? 0 : $0.split(\"|\").length)")]
        public static u32 count(str options);

        [Js("($0.split(\"|\")[$1] ?? \"\")")]
        public static str nth(str options, i32 index);

        [Js("$side($0, $1)")]
        public static str side(str route, bool before);
    }

    // The key being delivered to a "keydown" listener (Windows virtual-key values, which are the browser's keyCode).
    struct Input {
        [Js("$key.code")]
        public static i32 key();

        [Js("$key.shift")]
        public static bool shift();

        [Js("$key.ctrl")]
        public static bool ctrl();

        [Js("$key.alt")]
        public static bool alt();

        [Js("$key.prevent()")]
        public static void prevent();
    }

    struct Initial {
        [Js("(Array.from($0)[0] ?? \"\")")]
        public static str of(str label);
    }

    // The machine the page runs on, for the keyboard and layout choices of the navigation kit (native: input/device.djinn).
    struct Device {
        [Js("$apple")]
        public static bool apple();

        [Js("$media(\"(min-width: 56.25rem)\")")]
        public static bool wide();

        [Js("$media(\"(pointer: none)\")")]
        public static bool remote();

        [Js("$focusStep($0)")]
        public static void step_focus(bool backward);
    }

    // Keyboard shortcuts (native: input/hotkeys.djinn). A combo is one step such as "Mod+B" or "Alt+Left"; "Mod" is Command
    // on Apple systems and Control elsewhere.
    struct Hotkeys {
        [Js("($hk.mac = $0)")]
        public static void use_command(bool on);

        [Js("$hotkeyOn($0, $1, $2)")]
        public static u32 on(str combo, str scope, fn() -> void handler);

        [Js("$hotkeyOff($0)")]
        public static void off(u32 id);
    }

    struct Styles {
        // Adds a stylesheet to the page (once per text).
        [Js("$addStyles($0)")]
        public static void add(str css);
    }

    struct Document {
        [Js("$onDocument($0, $1)")]
        public static void listen(str event, fn() -> void handler);
    }
}

// A modal dialog over the page, shown while 'open' is true; the close button and Escape clear it.
struct Dialog {
    str title;
    signal<bool> open;
    Node children;

    static void on_key(signal<bool> open) {
        if (open.get() && Input.key() == Key.ESCAPE) {
            open.set(false);
            Input.prevent();
        }
    }

    public Node render() {
        signal<bool> open = this.open;
        Document.listen("keydown", () => Dialog.on_key(open));
        return html!{
            <div class="dialog-backdrop" data-open={Kit.flag(this.open.get())}>
                <section class="card stack dialog" role="dialog" aria-modal="true" data-open={Kit.flag(this.open.get())}>
                    <h2>{this.title}</h2>
                    {this.children}
                    <div class="cluster">
                        <button class="primary" on_click={() => this.open.set(false)}>Close</button>
                    </div>
                </section>
            </div>
        };
    }
}

// Shows its content while 'show' is true, fading in and out (the content keeps its state while hidden).
struct Transition {
    signal<bool> show;
    Node children;

    [Js("$transition($this.show, $this.children)")]
    public Node render() {
        return Opaque.value<Node>();
    }
}

// A scrolling list of 'count' rows 'item_height' px tall in a box 'height' px tall that keeps only the rows in view in the
// page (the same component as the native one); 'row' builds the row of an index.
struct VirtualList {
    i32 count;
    i32 item_height;
    i32 height;
    fn(i32) -> Node row;

    [Js("$virtual($this.count, $this.item_height, $this.height, $this.row)")]
    public Node render() {
        return Opaque.value<Node>();
    }
}

// A labelled text field with an optional hint; a signal<str> as 'value' binds it both ways.
struct Field {
    str label;
    str hint;
    str placeholder;
    str kind;
    signal<str> value;

    [Js("$bindField($0, $1)")]
    static Node bind(Node root, signal<str> value) {
        return root;
    }

    public Node render() {
        Node root = html!{
            <label class="field stack">
                <span class="field-label">{this.label}</span>
                <input type={this.kind} placeholder={this.placeholder}/>
                <small class="muted">{this.hint}</small>
            </label>
        };
        return Field.bind(root, this.value);
    }
}

// A labelled text area; a signal<str> as 'value' binds it both ways.
struct Textarea {
    str label;
    str hint;
    str placeholder;
    signal<str> value;

    public Node render() {
        Node root = html!{
            <label class="field stack">
                <span class="field-label">{this.label}</span>
                <textarea placeholder={this.placeholder}></textarea>
                <small class="muted">{this.hint}</small>
            </label>
        };
        return Field.bind(root, this.value);
    }
}
