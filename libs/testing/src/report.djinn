namespace testing;

import std::sys;
import std::types;
import std::libc;
import std::io;

struct TagCount {
    ptr<i8> name;
    i32 count;
}

struct TestReport {
    public static unsafe void print_node(TestNode* node) {
        i32 millis = (i32)(node.elapsed_us / 1000);
        if (node.hidden) {
            return;
        }
        if (node.skipped) {
            printf("SKIP %s: %s\n", node.name, node.reason);
        } else if (node.blocked) {
            printf("BLOCKED %s: %s\n", node.name, node.reason);
        } else if (node.reason != null) {
            printf("FAIL %s: %s\n", node.name, node.reason);
        } else if (node.retries > 0) {
            printf("PASS %s (%d ms, after %d retries)\n", node.name, millis, node.retries);
        } else {
            printf("PASS %s (%d ms)\n", node.name, millis);
        }
    }

    static unsafe void count_tag(ItemList* counts, ptr<i8> name) {
        for (mut i32 i = 0; i < counts.length; i = i + 1) {
            TagCount* tag = (TagCount*)counts.get(i);
            if (Text.same(tag.name, name)) {
                tag.count = tag.count + 1;
                return;
            }
        }
        TagCount* tag = (TagCount*)Allocator.zeroed(sizeof(TagCount));
        tag.name = name;
        tag.count = 1;
        counts.push((ptr)tag);
    }

    static unsafe ItemList* tag_counts(ItemList* nodes) {
        ItemList* counts = ItemList.create();
        for (mut i32 i = 0; i < nodes.length; i = i + 1) {
            TestNode* node = (TestNode*)nodes.get(i);
            ptr<i8> tags = node.tags;
            i32 length = (i32)strlen(tags);
            mut i32 start = 0;
            for (mut i32 at = 0; at <= length; at = at + 1) {
                if (at == length || tags[at] == 32) {
                    if (at > start) {
                        TestReport.count_tag(counts, Text.duplicate(tags + start, at - start));
                    }
                    start = at + 1;
                }
            }
        }
        return counts;
    }

    public static unsafe i32 passed(ItemList* nodes) {
        mut i32 count = 0;
        for (mut i32 i = 0; i < nodes.length; i = i + 1) {
            TestNode* node = (TestNode*)nodes.get(i);
            if (node.passed && !node.hidden) {
                count = count + 1;
            }
        }
        return count;
    }

    public static unsafe i32 blocked(ItemList* nodes) {
        mut i32 count = 0;
        for (mut i32 i = 0; i < nodes.length; i = i + 1) {
            TestNode* node = (TestNode*)nodes.get(i);
            if (node.blocked && !node.hidden) {
                count = count + 1;
            }
        }
        return count;
    }

    public static unsafe i32 skipped(ItemList* nodes) {
        mut i32 count = 0;
        for (mut i32 i = 0; i < nodes.length; i = i + 1) {
            TestNode* node = (TestNode*)nodes.get(i);
            if (node.skipped && !node.hidden) {
                count = count + 1;
            }
        }
        return count;
    }

    public static unsafe bool succeeded(ItemList* nodes) {
        return TestReport.passed(nodes) + TestReport.skipped(nodes) == TestReport.total(nodes);
    }

    public static unsafe i32 total(ItemList* nodes) {
        mut i32 count = 0;
        for (mut i32 i = 0; i < nodes.length; i = i + 1) {
            TestNode* node = (TestNode*)nodes.get(i);
            if (!node.hidden) {
                count = count + 1;
            }
        }
        return count;
    }

    public static unsafe void print_summary(Scheduler* scheduler) {
        ItemList* nodes = scheduler.nodes;
        i32 passed = TestReport.passed(nodes);
        i32 blocked = TestReport.blocked(nodes);
        i32 total = TestReport.total(nodes);
        i32 skipped = TestReport.skipped(nodes);
        i32 failed = total - passed - blocked - skipped;
        if (blocked > 0 && skipped > 0) {
            printf("%d passed, %d failed, %d blocked, %d skipped, %d total\n", passed, failed, blocked, skipped, total);
        } else if (blocked > 0) {
            printf("%d passed, %d failed, %d blocked, %d total\n", passed, failed, blocked, total);
        } else if (skipped > 0) {
            printf("%d passed, %d failed, %d skipped, %d total\n", passed, failed, skipped, total);
        } else {
            printf("%d passed, %d failed, %d total\n", passed, failed, total);
        }
        ItemList* counts = TestReport.tag_counts(nodes);
        for (mut i32 i = 0; i < counts.length; i = i + 1) {
            TagCount* tag = (TagCount*)counts.get(i);
            if (i > 0) {
                printf(", ");
            }
            printf("%s %d", tag.name, tag.count);
        }
        if (counts.length > 0) {
            printf("\n");
        }
    }

    static unsafe void append_xml(TextBuffer* out, ptr<i8> text) {
        i32 length = (i32)strlen(text);
        for (mut i32 i = 0; i < length; i = i + 1) {
            i32 c = (i32)text[i];
            if (c == 38) {
                out.append("&amp;");
            } else if (c == 60) {
                out.append("&lt;");
            } else if (c == 62) {
                out.append("&gt;");
            } else if (c == 34) {
                out.append("&quot;");
            } else if (c == 10 || c == 9 || c >= 32) {
                out.append_slice(text + i, 1);
            }
        }
    }

    public static unsafe void write_junit(Scheduler* scheduler, ptr<i8> path) {
        ItemList* nodes = scheduler.nodes;
        i32 total = TestReport.total(nodes);
        i32 skipped = TestReport.skipped(nodes);
        i32 failures = total - TestReport.passed(nodes) - skipped;
        TextBuffer* xml = TextBuffer.create();
        xml.append("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<testsuite name=\"tests\" tests=\"");
        xml.append_int((i64)total);
        xml.append("\" failures=\"");
        xml.append_int((i64)failures);
        xml.append("\" skipped=\"");
        xml.append_int((i64)skipped);
        xml.append("\">\n");
        for (mut i32 i = 0; i < nodes.length; i = i + 1) {
            TestNode* node = (TestNode*)nodes.get(i);
            if (node.hidden) {
                continue;
            }
            xml.append("  <testcase name=\"");
            TestReport.append_xml(xml, node.name);
            xml.append("\" time=\"");
            xml.append_int(node.elapsed_us / 1000000);
            xml.append(".");
            i64 millis = (node.elapsed_us / 1000) % 1000;
            if (millis < 100) {
                xml.append("0");
            }
            if (millis < 10) {
                xml.append("0");
            }
            xml.append_int(millis);
            xml.append("\"");
            if (node.skipped) {
                xml.append("><skipped message=\"");
                TestReport.append_xml(xml, node.reason);
                xml.append("\"/></testcase>\n");
            } else if (node.reason != null) {
                xml.append("><failure message=\"");
                TestReport.append_xml(xml, node.reason);
                if (node.blocked) {
                    xml.append("\" type=\"blocked");
                }
                xml.append("\"/></testcase>\n");
            } else {
                xml.append("/>\n");
            }
        }
        xml.append("</testsuite>\n");
        TextFiles.write(path, xml.cstr(), xml.length);
    }

    public static unsafe void write_json(Scheduler* scheduler, ptr<i8> path) {
        ItemList* nodes = scheduler.nodes;
        TextBuffer* json = TextBuffer.create();
        json.append("{\"total\":");
        json.append_int((i64)TestReport.total(nodes));
        json.append(",\"passed\":");
        json.append_int((i64)TestReport.passed(nodes));
        json.append(",\"tags\":{");
        ItemList* counts = TestReport.tag_counts(nodes);
        for (mut i32 i = 0; i < counts.length; i = i + 1) {
            TagCount* tag = (TagCount*)counts.get(i);
            if (i > 0) {
                json.append(",");
            }
            json.append_json_string(tag.name);
            json.append(":");
            json.append_int((i64)tag.count);
        }
        json.append("},\"cases\":[");
        mut bool first_case = true;
        for (mut i32 i = 0; i < nodes.length; i = i + 1) {
            TestNode* node = (TestNode*)nodes.get(i);
            if (node.hidden) {
                continue;
            }
            if (!first_case) {
                json.append(",");
            }
            first_case = false;
            json.append("{\"name\":");
            json.append_json_string(node.name);
            json.append(",\"status\":");
            if (node.passed) {
                json.append("\"passed\"");
            } else if (node.skipped) {
                json.append("\"skipped\"");
            } else if (node.blocked) {
                json.append("\"blocked\"");
            } else {
                json.append("\"failed\"");
            }
            if (node.retries > 0) {
                json.append(",\"retries\":");
                json.append_int((i64)node.retries);
            }
            json.append(",\"tags\":");
            json.append_json_string(node.tags);
            json.append(",\"elapsed_ms\":");
            json.append_int(node.elapsed_us / 1000);
            if (node.reason != null) {
                json.append(",\"reason\":");
                json.append_json_string(node.reason);
            }
            json.append("}");
        }
        json.append("]}\n");
        TextFiles.write(path, json.cstr(), json.length);
    }
}
