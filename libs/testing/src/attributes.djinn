namespace testing;

import std::sys;
import std::types;
import std::libc;
import std::io;

attribute Test(AttributeTarget.Method);

attribute Tag(AttributeTarget.Method) {
    i8* name;
}

attribute From(AttributeTarget.Parameter) {
    i8* name;
}

attribute Mutates(AttributeTarget.Parameter);

attribute Teardown(AttributeTarget.Method);

attribute Bench(AttributeTarget.Method) {
    i32 warmup;
    i32 iterations;
}

attribute Case(AttributeTarget.Method) {
    i64 first;
    i64 second;
    i64 third;
    i64 fourth;
}

attribute Skip(AttributeTarget.Method) {
    i8* reason;
}

attribute Resource(AttributeTarget.Method) {
    i8* name;
}

attribute TestPolicy(AttributeTarget.Function | AttributeTarget.Method) {
    i32 retry;
    i32 timeout;
}
