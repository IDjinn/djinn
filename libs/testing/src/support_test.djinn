namespace testing;

import std::sys;
import std::types;
import std::libc;
import std::io;

struct TextTests {
    [Test]
    [Tag("text")]
    void same_compares_content() {
        Expect.is_true(Text.same("djinn", "djinn"));
        Expect.is_false(Text.same("djinn", "djinx"));
        Expect.is_false(Text.same("djinn", "djin"));
    }

    [Test]
    [Tag("text")]
    void contains_finds_parts() {
        Expect.is_true(Text.contains("hello djinn", "djinn"));
        Expect.is_false(Text.contains("hello djinn", "world"));
    }

    [Test]
    void parses_integers() {
        Expect.equal(1234, Text.parse_integer("1234", 4));
        Expect.equal(12, Text.parse_integer("1234", 2));
        Expect.is_true(Text.is_digit(55));
        Expect.is_false(Text.is_digit(97));
    }

    [Test]
    void removes_carriage_returns() {
        TextBuffer* raw = TextBuffer.create();
        raw.append_char(97);
        raw.append_char(13);
        raw.append_char(10);
        raw.append_char(98);
        Expect.equal(4, raw.length);
        Expect.equal_text("a\nb", Text.without_carriage_returns(raw.cstr(), raw.length));
    }

    [Test]
    void duplicates_a_slice() {
        Expect.equal_text("djin", Text.duplicate("djinn", 4));
    }
}

struct BufferTests {
    [Test]
    void grows_past_its_first_capacity() {
        TextBuffer* buffer = TextBuffer.create();
        for (mut i32 i = 0; i < 500; i = i + 1) {
            buffer.append_char(97);
        }
        Expect.equal(500, buffer.length);
        Expect.equal((i64)strlen(buffer.cstr()), 500);
    }

    [Test]
    void formats_integers() {
        TextBuffer* buffer = TextBuffer.create();
        buffer.append_int(-42);
        buffer.append(" ");
        buffer.append_int(0);
        buffer.append(" ");
        buffer.append_int(1234567);
        Expect.equal_text("-42 0 1234567", buffer.cstr());
    }

    [Test]
    void escapes_json_strings() {
        TextBuffer* buffer = TextBuffer.create();
        buffer.append_json_string("say \"hi\"\n");
        Expect.equal_text("\"say \\\"hi\\\"\\n\"", buffer.cstr());
    }
}

struct ListTests {
    [Test]
    void keeps_items_in_order_after_growing() {
        ItemList* list = ItemList.create();
        for (mut i32 i = 0; i < 100; i = i + 1) {
            list.push((ptr)Text.duplicate("x", 1));
        }
        Expect.equal(100, list.length);
        Expect.equal_text("x", (ptr<i8>)list.get(99));
    }
}

struct TestFailure {
    i32 code;

    TestFailure(i32 code) {
        this.code = code;
    }
}

struct ThrowingTests {
    [Test]
    void passes_when_nothing_is_thrown() throws(TestFailure) {
        Expect.equal(4, 2 + 2);
    }
}

struct AsyncTests {
    [Test]
    async void runs_on_the_event_loop() {
        Expect.equal(4, 2 + 2);
    }
}

struct ExpectMessageTests {
    [Test]
    void accepts_a_message_when_the_check_holds() {
        Expect.is_true(1 < 2, "one is below two");
        Expect.is_false(2 < 1, "two is not below one");
        Expect.equal(4, 2 + 2, "sum");
        Expect.equal_text("a", "a", "text");
        Expect.contains("djinn", "inn", "part");
    }
}
