namespace testing;

import std::sys;
import std::types;
import std::libc;
import std::io;

extern "C" {
    void __djinn_panic(ptr<i8> message, ptr<i8> file, u32 line);
}

struct Expect {
    static unsafe void fail_with(ptr<i8> message, Location site) {
        __djinn_panic(message, (ptr<i8>)site.fileName, (u32)site.line);
    }

    public static unsafe void fail(ptr<i8> message, [Location] Location site) {
        Expect.fail_with(message, site);
    }

    public static unsafe void that(bool condition, ptr<i8> message, [Location] Location site) {
        if (!condition) {
            Expect.fail_with(message, site);
        }
    }

    public static unsafe void is_true(bool condition, [Location] Location site) {
        if (!condition) {
            Expect.fail_with("expected true", site);
        }
    }

    public static unsafe void is_false(bool condition, [Location] Location site) {
        if (condition) {
            Expect.fail_with("expected false", site);
        }
    }

    public static unsafe void equal(i64 expected, i64 actual, [Location] Location site) {
        if (expected != actual) {
            TextBuffer* message = TextBuffer.create();
            message.append("expected ");
            message.append_int(expected);
            message.append(", got ");
            message.append_int(actual);
            Expect.fail_with(message.cstr(), site);
        }
    }

    public static unsafe void equal_text(ptr<i8> expected, ptr<i8> actual, [Location] Location site) {
        if (!Text.same(expected, actual)) {
            TextBuffer* message = TextBuffer.create();
            message.append("expected \"");
            message.append(expected);
            message.append("\", got \"");
            message.append(actual);
            message.append("\"");
            Expect.fail_with(message.cstr(), site);
        }
    }

    public static unsafe void contains(ptr<i8> text, ptr<i8> part, [Location] Location site) {
        if (!Text.contains(text, part)) {
            TextBuffer* message = TextBuffer.create();
            message.append("\"");
            message.append(text);
            message.append("\" does not contain \"");
            message.append(part);
            message.append("\"");
            Expect.fail_with(message.cstr(), site);
        }
    }
}
