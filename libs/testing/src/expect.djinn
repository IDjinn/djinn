namespace testing;

import std::sys;
import std::types;
import std::libc;
import std::io;

extern "C" {
    void __djinn_panic(ptr<i8> message, ptr<i8> file, u32 line);
}

struct Expect {
    static unsafe void fail_with(ptr<i8> message, Location site) {
        __djinn_panic(message, (ptr<i8>)site.fileName, (u32)site.line);
    }

    static unsafe void fail_detailed(ptr<i8> note, ptr<i8> detail, Location site) {
        if (note == null || Text.same(note, "")) {
            Expect.fail_with(detail, site);
            return;
        }
        TextBuffer* message = TextBuffer.create();
        message.append(note);
        message.append(": ");
        message.append(detail);
        Expect.fail_with(message.cstr(), site);
    }

    public static unsafe void fail(ptr<i8> message, [Location] Location site) {
        Expect.fail_with(message, site);
    }

    public static unsafe void that(bool condition, ptr<i8> message, [Location] Location site) {
        if (!condition) {
            Expect.fail_with(message, site);
        }
    }

    public static unsafe void is_true(bool condition, [Location] Location site) {
        if (!condition) {
            Expect.fail_with("expected true", site);
        }
    }

    public static unsafe void is_true(bool condition, ptr<i8> message, [Location] Location site) {
        if (!condition) {
            Expect.fail_detailed(message, "expected true", site);
        }
    }

    public static unsafe void is_false(bool condition, [Location] Location site) {
        if (condition) {
            Expect.fail_with("expected false", site);
        }
    }

    public static unsafe void is_false(bool condition, ptr<i8> message, [Location] Location site) {
        if (condition) {
            Expect.fail_detailed(message, "expected false", site);
        }
    }

    static unsafe ptr<i8> describe_numbers(i64 expected, i64 actual) {
        TextBuffer* message = TextBuffer.create();
        message.append("expected ");
        message.append_int(expected);
        message.append(", got ");
        message.append_int(actual);
        return message.cstr();
    }

    public static unsafe void equal(i64 expected, i64 actual, [Location] Location site) {
        if (expected != actual) {
            Expect.fail_with(Expect.describe_numbers(expected, actual), site);
        }
    }

    public static unsafe void equal(i64 expected, i64 actual, ptr<i8> message, [Location] Location site) {
        if (expected != actual) {
            Expect.fail_detailed(message, Expect.describe_numbers(expected, actual), site);
        }
    }

    static unsafe ptr<i8> describe_texts(ptr<i8> expected, ptr<i8> actual) {
        TextBuffer* message = TextBuffer.create();
        message.append("expected \"");
        message.append(expected);
        message.append("\", got \"");
        message.append(actual);
        message.append("\"");
        return message.cstr();
    }

    public static unsafe void equal_text(ptr<i8> expected, ptr<i8> actual, [Location] Location site) {
        if (!Text.same(expected, actual)) {
            Expect.fail_with(Expect.describe_texts(expected, actual), site);
        }
    }

    public static unsafe void equal_text(ptr<i8> expected, ptr<i8> actual, ptr<i8> message, [Location] Location site) {
        if (!Text.same(expected, actual)) {
            Expect.fail_detailed(message, Expect.describe_texts(expected, actual), site);
        }
    }

    static unsafe ptr<i8> describe_missing(ptr<i8> text, ptr<i8> part) {
        TextBuffer* message = TextBuffer.create();
        message.append("\"");
        message.append(text);
        message.append("\" does not contain \"");
        message.append(part);
        message.append("\"");
        return message.cstr();
    }

    public static unsafe void contains(ptr<i8> text, ptr<i8> part, [Location] Location site) {
        if (!Text.contains(text, part)) {
            Expect.fail_with(Expect.describe_missing(text, part), site);
        }
    }

    public static unsafe void contains(ptr<i8> text, ptr<i8> part, ptr<i8> message, [Location] Location site) {
        if (!Text.contains(text, part)) {
            Expect.fail_detailed(message, Expect.describe_missing(text, part), site);
        }
    }
}
