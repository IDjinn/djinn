namespace testing;

import std::sys;
import std::types;
import std::libc;

struct Artifact {
    ptr<i8> path;

    public static unsafe Artifact at(ptr<i8> path) {
        Artifact artifact = { .path = path };
        return artifact;
    }

    public unsafe bool exists() {
        FILE* file = fopen((i8*)this.path, "rb");
        if (file == null) {
            return false;
        }
        fclose(file);
        return true;
    }

    public unsafe ptr<i8> read_text() {
        return TextFiles.read(this.path);
    }

    public unsafe void must_exist() {
        Expect.is_true(this.exists(), "the artifact file was not produced");
    }
}
