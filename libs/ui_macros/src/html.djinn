import std::meta;
import ui::markup;
import ui::css;

namespace ui;

TokenStream expand_html(TokenStream input) {
    unsafe {
        return HtmlMacro.expand(input);
    }
}

proc macro html => expand_html;

TokenStream expand_css(TokenStream input) {
    unsafe {
        return CssMacro.expand(input);
    }
}

proc macro css => expand_css;

TokenStream expand_application(TokenStream args, TokenStream item) {
    unsafe {
        return Attributes.application(args, item);
    }
}

TokenStream expand_server(TokenStream args, TokenStream item) {
    unsafe {
        return Attributes.server(args, item);
    }
}

TokenStream expand_client(TokenStream args, TokenStream item) {
    unsafe {
        return Attributes.client(args, item);
    }
}

TokenStream expand_static(TokenStream args, TokenStream item) {
    unsafe {
        return Attributes.prerendered(args, item);
    }
}

proc attribute Application => expand_application;
proc attribute Server => expand_server;
proc attribute Client => expand_client;
proc attribute Static => expand_static;
