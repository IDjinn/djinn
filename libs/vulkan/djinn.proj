project: "vulkan"
version: "0.1.0"

compiler:
  library-mode: true

  output:
    file: "vulkan.djlib"
    directory: "build/libs"

  libs: [
    'std',
    'spirv',
    'ui_macros',
    'ui'
  ]

  # the Vulkan loader's import library (shipped in native/ next to the lib folder), delay-loaded so a program still
  # starts without the loader and falls back to the software rasterizer
  '-lvulkan-1'
  '-Wl,/delayload:vulkan-1.dll'
  '-ldelayimp'
  '-lkernel32'
