import std::types;
import std::libc;

namespace vulkan;

extern "C" {
    i32 vkCreateAndroidSurfaceKHR(u64 instance, void* info, void* allocator, u64* surface);
}

// What differs between platforms (see platform.windows.djinn). Android: the Vulkan loader (libvulkan.so, API 24 and later)
// is linked directly, and the surface comes from the ANativeWindow.
struct VkPlatform {
    public static unsafe bool load() {
        return true;
    }

    public static unsafe i8* surface_extension() {
        return "VK_KHR_android_surface";
    }

    // 'module' is unused; 'window' is the ANativeWindow*.
    public static unsafe i32 create_surface(u64 instance, void* module, void* window, u64* surface) {
        void* info = VkBuf.info(32, 1000008000);
        VkBuf.ptr_at(info, 24, window);
        i32 made = vkCreateAndroidSurfaceKHR(instance, info, (void*)0, surface);
        __djinn_free(info);
        return made;
    }
}
