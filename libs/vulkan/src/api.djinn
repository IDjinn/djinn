import std::types;
import std::libc;

namespace vulkan;

// The slice of Vulkan 1.0 the UI renderer uses, bound straight to vulkan-1.dll (link with libs/vulkan/native/vulkan-1.lib).
// Every handle is a u64 (dispatchable ones are pointers, 8 bytes on x64 as well) and every structure is filled through
// a byte buffer at its documented x64 offsets (see VkBuf), so no layout has to be mirrored here.
extern "C" {
    i32 vkCreateInstance(void* info, void* allocator, u64* instance);
    void vkDestroyInstance(u64 instance, void* allocator);
    i32 vkEnumeratePhysicalDevices(u64 instance, u32* count, u64* devices);
    void vkGetPhysicalDeviceQueueFamilyProperties(u64 device, u32* count, void* properties);
    i32 vkGetPhysicalDeviceSurfaceSupportKHR(u64 device, u32 family, u64 surface, u32* supported);
    void vkGetPhysicalDeviceMemoryProperties(u64 device, void* properties);
    i32 vkCreateDevice(u64 physical, void* info, void* allocator, u64* device);
    void vkDestroyDevice(u64 device, void* allocator);
    void vkGetDeviceQueue(u64 device, u32 family, u32 index, u64* queue);
    i32 vkGetPhysicalDeviceSurfaceFormatsKHR(u64 device, u64 surface, u32* count, void* formats);
    void vkDestroySurfaceKHR(u64 instance, u64 surface, void* allocator);
    i32 vkGetPhysicalDeviceSurfaceCapabilitiesKHR(u64 device, u64 surface, void* capabilities);
    i32 vkCreateSwapchainKHR(u64 device, void* info, void* allocator, u64* swapchain);
    void vkDestroySwapchainKHR(u64 device, u64 swapchain, void* allocator);
    i32 vkGetSwapchainImagesKHR(u64 device, u64 swapchain, u32* count, u64* images);
    i32 vkAcquireNextImageKHR(u64 device, u64 swapchain, u64 timeout, u64 semaphore, u64 fence, u32* index);
    i32 vkQueuePresentKHR(u64 queue, void* info);
    i32 vkCreateImageView(u64 device, void* info, void* allocator, u64* view);
    void vkDestroyImageView(u64 device, u64 view, void* allocator);
    i32 vkCreateRenderPass(u64 device, void* info, void* allocator, u64* pass);
    void vkDestroyRenderPass(u64 device, u64 pass, void* allocator);
    i32 vkCreateFramebuffer(u64 device, void* info, void* allocator, u64* framebuffer);
    void vkDestroyFramebuffer(u64 device, u64 framebuffer, void* allocator);
    i32 vkCreateShaderModule(u64 device, void* info, void* allocator, u64* module);
    void vkDestroyShaderModule(u64 device, u64 module, void* allocator);
    i32 vkCreateDescriptorSetLayout(u64 device, void* info, void* allocator, u64* layout);
    i32 vkCreatePipelineLayout(u64 device, void* info, void* allocator, u64* layout);
    i32 vkCreateGraphicsPipelines(u64 device, u64 cache, u32 count, void* infos, void* allocator, u64* pipelines);
    i32 vkCreateDescriptorPool(u64 device, void* info, void* allocator, u64* pool);
    i32 vkAllocateDescriptorSets(u64 device, void* info, u64* sets);
    void vkUpdateDescriptorSets(u64 device, u32 write_count, void* writes, u32 copy_count, void* copies);
    i32 vkCreateSampler(u64 device, void* info, void* allocator, u64* sampler);
    i32 vkCreateImage(u64 device, void* info, void* allocator, u64* image);
    void vkGetImageMemoryRequirements(u64 device, u64 image, void* requirements);
    i32 vkAllocateMemory(u64 device, void* info, void* allocator, u64* memory);
    i32 vkBindImageMemory(u64 device, u64 image, u64 memory, u64 offset);
    i32 vkCreateBuffer(u64 device, void* info, void* allocator, u64* buffer);
    void vkGetBufferMemoryRequirements(u64 device, u64 buffer, void* requirements);
    i32 vkBindBufferMemory(u64 device, u64 buffer, u64 memory, u64 offset);
    i32 vkMapMemory(u64 device, u64 memory, u64 offset, u64 size, u32 flags, void** data);
    void vkUnmapMemory(u64 device, u64 memory);
    i32 vkCreateCommandPool(u64 device, void* info, void* allocator, u64* pool);
    i32 vkAllocateCommandBuffers(u64 device, void* info, u64* buffers);
    i32 vkBeginCommandBuffer(u64 command_buffer, void* info);
    i32 vkEndCommandBuffer(u64 command_buffer);
    void vkCmdBeginRenderPass(u64 command_buffer, void* info, u32 contents);
    void vkCmdEndRenderPass(u64 command_buffer);
    void vkCmdBindPipeline(u64 command_buffer, u32 bind_point, u64 pipeline);
    void vkCmdBindVertexBuffers(u64 command_buffer, u32 first, u32 count, u64* buffers, u64* offsets);
    void vkCmdBindDescriptorSets(u64 command_buffer, u32 bind_point, u64 layout, u32 first, u32 count, u64* sets, u32 dynamic_count, u32* dynamic);
    void vkCmdPushConstants(u64 command_buffer, u64 layout, u32 stages, u32 offset, u32 size, void* values);
    void vkCmdDraw(u64 command_buffer, u32 vertex_count, u32 instance_count, u32 first_vertex, u32 first_instance);
    void vkCmdPipelineBarrier(u64 command_buffer, u32 source_stage, u32 destination_stage, u32 dependencies, u32 memory_count,
        void* memory, u32 buffer_count, void* buffers, u32 image_count, void* images);
    void vkCmdCopyBufferToImage(u64 command_buffer, u64 buffer, u64 image, u32 layout, u32 count, void* regions);
    void vkCmdSetViewport(u64 command_buffer, u32 first, u32 count, void* viewports);
    void vkCmdSetScissor(u64 command_buffer, u32 first, u32 count, void* scissors);
    i32 vkQueueSubmit(u64 queue, u32 count, void* submits, u64 fence);
    i32 vkQueueWaitIdle(u64 queue);
    i32 vkDeviceWaitIdle(u64 device);
    i32 vkCreateSemaphore(u64 device, void* info, void* allocator, u64* semaphore);
    void vkDestroySemaphore(u64 device, u64 semaphore, void* allocator);
    i32 vkCreateFence(u64 device, void* info, void* allocator, u64* fence);
    i32 vkWaitForFences(u64 device, u32 count, u64* fences, u32 wait_all, u64 timeout);
    i32 vkResetFences(u64 device, u32 count, u64* fences);
    i32 vkResetCommandBuffer(u64 command_buffer, u32 flags);
    void vkFreeMemory(u64 device, u64 memory, void* allocator);
    void vkDestroyBuffer(u64 device, u64 buffer, void* allocator);
    void vkDestroyImage(u64 device, u64 image, void* allocator);
    void vkDestroyPipeline(u64 device, u64 pipeline, void* allocator);
    void vkDestroyPipelineLayout(u64 device, u64 layout, void* allocator);
    void vkDestroyDescriptorSetLayout(u64 device, u64 layout, void* allocator);
    void vkDestroyDescriptorPool(u64 device, u64 pool, void* allocator);
    void vkDestroySampler(u64 device, u64 sampler, void* allocator);
    void vkDestroyCommandPool(u64 device, u64 pool, void* allocator);
    void vkDestroyFence(u64 device, u64 fence, void* allocator);
}

// Byte buffers read and written as the C structures Vulkan wants.
struct VkBuf {
    public static unsafe void* make(u32 bytes) {
        // from the block pool: a frame asks for the same few small buffers every time, so they are reused
        void* buffer = Blocks.take((u64)bytes);
        memset(buffer, 0, (size_long)bytes);
        return buffer;
    }

    // Gives back a buffer made with 'bytes' (a pool block, so it can also just be freed).
    public static unsafe void drop(void* buffer, u32 bytes) {
        Blocks.give(buffer, (u64)bytes);
    }

    public static unsafe void u32_at(void* buffer, u32 offset, u32 value) {
        u8* at = (u8*)buffer;
        *((u32*)&*(at + (offset))) = value;
    }

    public static unsafe void u64_at(void* buffer, u32 offset, u64 value) {
        u8* at = (u8*)buffer;
        *((u64*)&*(at + (offset))) = value;
    }

    public static unsafe void f32_at(void* buffer, u32 offset, f32 value) {
        u8* at = (u8*)buffer;
        *((f32*)&*(at + (offset))) = value;
    }

    public static unsafe void ptr_at(void* buffer, u32 offset, void* value) {
        u8* at = (u8*)buffer;
        *((u64*)&*(at + (offset))) = (u64)value;
    }

    public static unsafe u32 get_u32(void* buffer, u32 offset) {
        u8* at = (u8*)buffer;
        return *((u32*)&*(at + (offset)));
    }

    public static unsafe u64 get_u64(void* buffer, u32 offset) {
        u8* at = (u8*)buffer;
        return *((u64*)&*(at + (offset)));
    }

    // The structure type every Vulkan info structure starts with, then pNext = null.
    public static unsafe void* info(u32 bytes, u32 type) {
        void* buffer = VkBuf.make(bytes);
        VkBuf.u32_at(buffer, 0, type);
        return buffer;
    }
}
