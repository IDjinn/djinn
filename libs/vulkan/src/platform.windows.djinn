import std::types;
import std::libc;

namespace vulkan;

extern "C" {
    i32 vkCreateWin32SurfaceKHR(u64 instance, void* info, void* allocator, u64* surface);
    void* LoadLibraryExA(i8* name, void* file, u32 flags);
}

// What differs between platforms: how the Vulkan loader is found, the name of the surface extension and how a surface is
// made from the native window. Windows: vulkan-1.dll is delay-loaded (see djinn.proj), so a machine without the Vulkan
// loader still starts: the renderer checks for the DLL first and the host falls back to the software rasterizer.
struct VkPlatform {
    public static unsafe bool load() {
        if (LoadLibraryExA("vulkan-1.dll", (void*)0, 0) == (void*)0) {
            printf("vulkan: vulkan-1.dll not found\n");
            return false;
        }
        return true;
    }

    public static unsafe i8* surface_extension() {
        return "VK_KHR_win32_surface";
    }

    // 'module' is the HINSTANCE and 'window' the HWND.
    public static unsafe i32 create_surface(u64 instance, void* module, void* window, u64* surface) {
        void* info = VkBuf.info(40, 1000009000);
        VkBuf.ptr_at(info, 24, module);
        VkBuf.ptr_at(info, 32, window);
        i32 made = vkCreateWin32SurfaceKHR(instance, info, (void*)0, surface);
        __djinn_free(info);
        return made;
    }
}
