project: "win32"
version: "0.1.0"

compiler:
  library-mode: true

  output:
    file: "win32.djlib"
    directory: "build/libs"

  libs: [
    'std',
    'ui_macros',
    'ui',
    'spirv',
    'vulkan'
  ]

  # system libraries the host calls; programs that import win32 link them automatically
  '-luser32'
  '-lgdi32'
  '-lkernel32'
