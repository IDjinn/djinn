import std::types;
import std::libc;
import ui;

namespace win32;

unsafe static mut ptr gdi_dc = null;
unsafe static mut ptr gdi_matrix = null;
unsafe static mut ptr gdi_metrics = null;
unsafe static mut ptr gdi_fonts = null;
unsafe static mut ptr gdi_bitmap = null;
unsafe static mut u32 gdi_bitmap_capacity = 0;
unsafe static mut ptr gdi_last = null;

// The FontProvider of the Windows host: GDI draws and measures the glyphs of the system font. Every glyph is drawn
// SCALE (8) times larger and averaged down to the pixel grid, which gives smooth, unhinted edges and advances that are not
// rounded to whole pixels (GDI's own hinted bitmaps are crisp but jagged and unevenly spaced at small sizes).
// Fonts are created once per size and weight.
struct GdiFonts {
    const i32 SCALE = 8;
    const u32 SLOTS = 32;
    const u32 CHARSET = 1;
    const u32 TT_PRECISION = 4;
    const u32 ANTIALIASED = 4;

    static unsafe void* dc() {
        if (gdi_dc == null) {
            gdi_dc = (ptr)CreateCompatibleDC((void*)0);
            gdi_matrix = (ptr)Raw.make(16);
            // the identity transform: 1.0 in a 16.16 fixed number is 0x00010000
            Raw.put_u32((void*)gdi_matrix, 0, 65536);
            Raw.put_u32((void*)gdi_matrix, 12, 65536);
            gdi_metrics = (ptr)Raw.make(64);
            gdi_fonts = (ptr)Raw.make(GdiFonts.SLOTS * 16);
        }
        return (void*)gdi_dc;
    }

    // Selects the font for a size and weight into the device context, creating it the first time.
    static unsafe void select(f32 size, u32 weight) {
        void* dc = GdiFonts.dc();
        mut u32 key = (u32)(size * (f32)16.0 + (f32)0.5) | (weight << 20);
        u64* table = (u64*)gdi_fonts;
        mut u32 free_slot = GdiFonts.SLOTS;
        for (mut u32 i = 0; i < GdiFonts.SLOTS; i = i + 1) {
            if (*(table + (i * 2 + 1)) != 0 && (u32)*(table + (i * 2)) == key) {
                SelectObject(dc, (void*)*(table + (i * 2 + 1)));
                return;
            }
            if (*(table + (i * 2 + 1)) == 0 && free_slot == GdiFonts.SLOTS) {
                free_slot = i;
            }
        }
        i32 pixels = (i32)(size * (f32)8.0 + (f32)0.5);
        void* font = CreateFontA(-pixels, 0, 0, 0, GdiFonts.face_weight(weight), 0, 0, 0, GdiFonts.CHARSET, GdiFonts.TT_PRECISION, 0,
            GdiFonts.ANTIALIASED, 0, GdiFonts.face(weight));
        if (free_slot < GdiFonts.SLOTS) {
            *(table + (free_slot * 2)) = (u64)key;
            *(table + (free_slot * 2 + 1)) = (u64)font;
        }
        SelectObject(dc, font);
    }

    // The Segoe UI face a CSS weight gets, the way the browser picks it on Windows: 500 and 600 are Semibold, 800 and
    // 900 Black. GDI keeps the light, semibold and black faces as families of their own.
    static i8* face(u32 weight) {
        if (weight <= 300) {
            return "Segoe UI Light";
        }
        if (weight == 500 || weight == 600) {
            return "Segoe UI Semibold";
        }
        if (weight >= 800) {
            return "Segoe UI Black";
        }
        return "Segoe UI";
    }

    static i32 face_weight(u32 weight) {
        if (weight <= 300) {
            return 300;
        }
        if (weight == 500 || weight == 600) {
            return 600;
        }
        if (weight >= 800) {
            return 900;
        }
        if (weight >= 700) {
            return 700;
        }
        return 400;
    }

    // Division by SCALE (8) rounding toward negative infinity.
    static i32 floor_div(i32 value) {
        if (value >= 0) {
            return value / 8;
        }
        return 0 - ((0 - value + 7) / 8);
    }

    static unsafe f32 advance(u32 code, f32 size, u32 weight) {
        GdiFonts.select(size, weight);
        if (GetGlyphOutlineW(GdiFonts.dc(), code, 2, (void*)gdi_metrics, 0, (void*)0, (void*)gdi_matrix) == 4294967295) {
            return size * (f32)0.5;
        }
        return (f32)Raw.get_i16((void*)gdi_metrics, 16) / (f32)8.0;
    }

    static unsafe bool rasterize(u32 code, f32 size, u32 weight, u32 phase, GlyphBitmap* out) {
        GdiFonts.select(size, weight);
        void* dc = GdiFonts.dc();
        u32 bytes = GetGlyphOutlineW(dc, code, 6, (void*)gdi_metrics, 0, (void*)0, (void*)gdi_matrix);
        if (bytes == 4294967295 || bytes == 0) {
            return false;
        }
        if (bytes > gdi_bitmap_capacity) {
            if (gdi_bitmap != null) {
                __djinn_free((void*)gdi_bitmap);
            }
            gdi_bitmap_capacity = bytes + 1024;
            gdi_bitmap = (ptr)__djinn_alloc((size_long)gdi_bitmap_capacity);
        }
        if (GetGlyphOutlineW(dc, code, 6, (void*)gdi_metrics, bytes, (void*)gdi_bitmap, (void*)gdi_matrix) == 4294967295) {
            return false;
        }
        u32 width = Raw.get_u32((void*)gdi_metrics, 0);
        u32 height = Raw.get_u32((void*)gdi_metrics, 4);
        if (width == 0 || height == 0) {
            return false;
        }
        // GDI rows are padded to 4 bytes and hold 0..64 at SCALE times the size; average SCALE x SCALE samples per pixel
        u32 pitch = (width + 3) & 0xFFFFFFFC;
        u8* source = (u8*)gdi_bitmap;
        i32 origin_x = Raw.get_i32((void*)gdi_metrics, 8);
        i32 origin_y = Raw.get_i32((void*)gdi_metrics, 12);
        // the sub-pixel phase moves the glyph right by phase/4 of a pixel: 2 samples per quarter at 8 samples a pixel
        i32 shift = (i32)phase * 2;
        i32 left = GdiFonts.floor_div(origin_x + shift);
        i32 right = GdiFonts.floor_div(origin_x + shift + (i32)width + 7);
        i32 top = GdiFonts.floor_div(origin_y + 7);
        i32 bottom = GdiFonts.floor_div(origin_y - (i32)height);
        u32 out_width = (u32)(right - left);
        u32 out_height = (u32)(top - bottom);
        if (out_width == 0 || out_height == 0) {
            return false;
        }
        u8* pixels = (u8*)__djinn_alloc_zeroed((size_long)(out_width * out_height));
        for (mut u32 py = 0; py < out_height; py = py + 1) {
            for (mut u32 px = 0; px < out_width; px = px + 1) {
                mut u32 sum = 0;
                for (mut i32 dy = 0; dy < 8; dy = dy + 1) {
                    i32 row = origin_y - ((top - (i32)py) * 8 - dy);
                    if (row < 0 || row >= (i32)height) {
                        continue;
                    }
                    for (mut i32 dx = 0; dx < 8; dx = dx + 1) {
                        i32 column = (left + (i32)px) * 8 + dx - origin_x - shift;
                        if (column >= 0 && column < (i32)width) {
                            sum = sum + (u32)*(source + ((u32)row * pitch + (u32)column));
                        }
                    }
                }
                // 64 samples of at most 64: 4096 is full coverage; a little contrast keeps dark text from looking thin
                mut u32 level = sum * 255 / 4096;
                if (level > 255) {
                    level = 255;
                }
                level = level + 35 * level * (255 - level) / 25500;
                if (level > 255) {
                    level = 255;
                }
                *(pixels + (py * out_width + px)) = (u8)level;
            }
        }
        out.width = (i32)out_width;
        out.height = (i32)out_height;
        out.bearing_x = left;
        out.bearing_y = top;
        // the provider hands the pixels over until its next call: keep this buffer for the next glyph to free
        if (gdi_last != null) {
            __djinn_free((void*)gdi_last);
        }
        gdi_last = (ptr)pixels;
        out.pixels = pixels;
        return true;
    }

    static unsafe void metrics(f32 size, u32 weight, f32* ascent, f32* descent) {
        GdiFonts.select(size, weight);
        GetTextMetricsW(GdiFonts.dc(), (void*)gdi_metrics);
        *ascent = (f32)Raw.get_i32((void*)gdi_metrics, 4) / (f32)8.0;
        *descent = (f32)Raw.get_i32((void*)gdi_metrics, 8) / (f32)8.0;
    }

    public static unsafe void install() {
        FontProvider provider = {
            .advance = (u32 code, f32 size, u32 weight) => GdiFonts.advance(code, size, weight),
            .rasterize = (u32 code, f32 size, u32 weight, u32 phase, GlyphBitmap* out) => GdiFonts.rasterize(code, size, weight, phase, out),
            .metrics = (f32 size, u32 weight, f32* ascent, f32* descent) => GdiFonts.metrics(size, weight, ascent, descent)
        };
        Fonts.set_provider(provider);
        Dom.touch();
    }
}
