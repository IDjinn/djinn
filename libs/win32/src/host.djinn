import std::types;
import std::libc;
import std::math;
import ui;
import vulkan;

namespace win32;

// Everything a frame needs, shared by the message loop and the window procedure: while the user drags a window edge
// Windows runs its own loop and only calls the window procedure, so the frame has to be drawn from there too.
struct HostState {
    void* window;
    void* rect;
    mut VulkanRenderer* gpu;
    mut DisplayList list;
    mut Canvas canvas;
    mut u32 stamp;
    mut u32 epoch;
    mut u32 gpu_width;
    mut u32 gpu_height;
    mut bool dirty;
    mut u32 hover;
    mut DevTools* tools;
}

unsafe static mut u64 host_state_address = 0;

// What the system calls for every message of the window: 2 is WM_DESTROY, 5 is WM_SIZE, 15 is WM_PAINT and 20 is
// WM_ERASEBKGND. A size or paint message draws the frame right away, so a resize follows the mouse instead of
// stretching the old frame until the drag ends.
[Abi(C)]
unsafe i64 djinn_window_proc(void* window, u32 message, u64 param, i64 extra) {
    if ((message == 5 || message == 15) && host_state_address != 0) {
        HostState* current = (HostState*)host_state_address;
        // a software frame must be repainted when the window is exposed; a GPU frame stays on screen by itself, so a
        // paint message only draws if something changed (drawing it twice per size step doubled the resize cost)
        if (message == 5 || current.gpu == (VulkanRenderer*)0) {
            current.dirty = true;
        }
        WinHost.render(current);
    }
    if (message == 2) {
        PostQuitMessage(0);
        return 0;
    }
    if (message == 20) {
        return 1;
    }
    // 131 is WM_NCCALCSIZE: the client area is the whole window, the frame is drawn by the host (see chrome)
    if (message == 131) {
        if (param != 0 && IsZoomed(window) != 0) {
            // a maximized window overhangs the screen by its frame: keep the content on the screen
            void* area = (void*)extra;
            i32 around = GetSystemMetrics(92);
            i32 across = GetSystemMetrics(32) + around;
            i32 down = GetSystemMetrics(33) + around;
            Raw.put_i32(area, 0, Raw.get_i32(area, 0) + across);
            Raw.put_i32(area, 4, Raw.get_i32(area, 4) + down);
            Raw.put_i32(area, 8, Raw.get_i32(area, 8) - across);
            Raw.put_i32(area, 12, Raw.get_i32(area, 12) - down);
        }
        return 0;
    }
    // 132 is WM_NCHITTEST: edges resize, the strip on top drags and its three buttons are the system ones
    if (message == 132) {
        return WinHost.hit_test(window, extra);
    }
    // 160 is WM_NCMOUSEMOVE, 674 is WM_NCMOUSELEAVE: which caption button is under the pointer
    if (message == 160 && host_state_address != 0) {
        HostState* current = (HostState*)host_state_address;
        mut u32 over = 0;
        if (param == 8 || param == 9 || param == 20) {
            over = (u32)param;
        }
        if (over != current.hover) {
            current.hover = over;
            current.dirty = true;
        }
        void* track = Raw.make(24);
        Raw.put_u32(track, 0, 24);
        Raw.put_u32(track, 4, 18);
        Raw.put_ptr(track, 8, window);
        TrackMouseEvent(track);
        __djinn_free(track);
    }
    if (message == 674 && host_state_address != 0) {
        HostState* current = (HostState*)host_state_address;
        current.hover = 0;
        current.dirty = true;
    }
    // 161 / 162 are WM_NCLBUTTONDOWN / UP: the buttons act on release, with no system tracking loop
    if ((message == 161 || message == 162) && (param == 8 || param == 9 || param == 20)) {
        if (message == 162) {
            if (param == 8) {
                ShowWindow(window, 6);
            } else if (param == 9) {
                if (IsZoomed(window) != 0) {
                    ShowWindow(window, 9);
                } else {
                    ShowWindow(window, 3);
                }
            } else {
                PostMessageA(window, 16, 0, 0);
            }
        }
        return 0;
    }
    return DefWindowProcA(window, message, param, extra);
}

// The native Windows host: a window, the message pump, the GDI fonts and a software present of the frame. Mouse
// and key messages become DOM events (click, mousedown, mouseup, mousemove, keydown), found by hit-testing the
// layout boxes, so the same handlers run here as in any other host.
//
// The window class has a window procedure of its own, a [Abi(C)] function the system calls: it ends the message loop
// when the window is destroyed and keeps the system from erasing the background (the frame covers the whole client
// area). Everything else goes to DefWindowProc. Input is still read from the queue (PeekMessage) in the loop below.
struct WinHost {
    const u32 WM_QUIT = 18;
    const u32 WM_PAINT = 15;
    const u32 WM_KEYDOWN = 256;
    const u32 WM_CHAR = 258;
    const u32 WM_MOUSEMOVE = 512;
    const u32 WM_MOUSEWHEEL = 522;
    const u32 WM_MOUSEHWHEEL = 526;
    const u32 WM_XBUTTONUP = 524;
    const u32 WM_LBUTTONDOWN = 513;
    const u32 WM_LBUTTONUP = 514;
    const u32 WS_OVERLAPPEDWINDOW = 13565952;
    const u32 WS_VISIBLE = 268435456;

    // The screen scale (1.5 at 150%): the system DPI over 96, or DJINN_UI_SCALE in percent (to test a scale).
    public static unsafe f64 scale() {
        i8* forced = getenv("DJINN_UI_SCALE");
        if (forced != (i8*)0) {
            mut i32 percent = 0;
            mut u32 at = 0;
            while (forced[at] >= (i8)48 && forced[at] <= (i8)57) {
                percent = percent * 10 + ((i32)forced[at] - 48);
                at = at + 1;
            }
            if (percent >= 50 && percent <= 400) {
                return (f64)percent / 100.0;
            }
        }
        u32 dpi = GetDpiForSystem();
        if (dpi < 96) {
            return 1.0;
        }
        return (f64)dpi / 96.0;
    }

    static unsafe void* open(str title, u32 width, u32 height) {
        void* module = GetModuleHandleA((i8*)0);
        void* class_info = Raw.make(80);
        Raw.put_u32(class_info, 0, 80);
        Raw.put_u32(class_info, 4, 3);
        Raw.put_ptr(class_info, 8, (void*)&djinn_window_proc);
        Raw.put_ptr(class_info, 24, module);
        Raw.put_ptr(class_info, 40, LoadCursorA((void*)0, (void*)32512));
        Raw.put_ptr(class_info, 64, (void*)"DjinnUiWindow");
        RegisterClassExA(class_info);
        __djinn_free(class_info);
        void* window = CreateWindowExA(0, "DjinnUiWindow", title.data, WinHost.WS_OVERLAPPEDWINDOW | WinHost.WS_VISIBLE,
            100, 100, (i32)width, (i32)height, (void*)0, (void*)0, module, (void*)0);
        return window;
    }

    // Copies an RGBA canvas to the window as BGRA.
    static unsafe void present(void* window, Canvas* canvas) {
        void* dc = GetDC(window);
        u32 count = canvas.width * canvas.height;
        u8* bgra = (u8*)__djinn_alloc((size_long)(count * 4));
        u32* source = (u32*)canvas.pixels;
        u32* target = (u32*)bgra;
        for (mut u32 i = 0; i < count; i = i + 1) {
            u32 p = source[i];
            target[i] = 0xFF000000 | ((p & 0xFF) << 16) | (p & 0xFF00) | ((p >> 16) & 0xFF);
        }
        void* info = Raw.make(44);
        Raw.put_u32(info, 0, 40);
        Raw.put_i32(info, 4, (i32)canvas.width);
        Raw.put_i32(info, 8, -(i32)canvas.height);
        Raw.put_u16(info, 12, 1);
        Raw.put_u16(info, 14, 32);
        StretchDIBits(dc, 0, 0, (i32)canvas.width, (i32)canvas.height, 0, 0, (i32)canvas.width, (i32)canvas.height,
            (void*)bgra, info, 0, 13369376);
        __djinn_free(info);
        __djinn_free((void*)bgra);
        ReleaseDC(window, dc);
    }

    // The lowest 16 bits of a message parameter as a signed coordinate (a cast to i16 would trap on 32768 and up).
    static f32 low_word(u64 value) {
        mut i32 word = (i32)(value & 0xFFFF);
        if (word >= 32768) {
            word = word - 65536;
        }
        return (f32)word;
    }

    // Shift, Control and Alt as the input layer's modifier bits (the high bit of GetKeyState is "down").
    static unsafe u32 modifiers() {
        mut u32 mods = 0;
        if (GetKeyState(16) < 0) {
            mods = mods | Mod.SHIFT;
        }
        if (GetKeyState(17) < 0) {
            mods = mods | Mod.CTRL;
        }
        if (GetKeyState(18) < 0) {
            mods = mods | Mod.ALT;
        }
        return mods;
    }

    // Runs every animation to its end (headless shots).
    static unsafe void settle() {
        u32 start = Animation.clock() + 1;
        Animation.advance(start);
        Animation.advance(start + 1000000);
    }

    static unsafe void announce(u32 id, str event) {
        if (id != 0) {
            Dom.dispatch(id, event);
        }
    }

    // How far a wheel movement scrolls, following the system settings: the lines per notch the user chose in the mouse
    // settings (3 by default; "one screen at a time" scrolls a page), 16 pixels a line, scaled by the display. 'raw' is
    // the signed wheel delta (120 per notch, less on precision wheels and touchpads).
    static unsafe f32 wheel_amount(i32 raw, bool sideways) {
        mut u32 action = 104;
        mut u32 fallback = 3;
        if (sideways) {
            action = 108;
        }
        u32* setting = (u32*)__djinn_alloc_zeroed((size_long)8);
        setting[0] = fallback;
        SystemParametersInfoA(action, 0, (void*)setting, 0);
        u32 lines = setting[0];
        __djinn_free((void*)setting);
        f32 notches = (f32)raw / (f32)120.0;
        if (lines == 4294967295) {
            mut f32 page = Scroll.page_size() * (f32)0.9;
            if (page < (f32)100.0) {
                page = (f32)100.0;
            }
            return notches * page;
        }
        return notches * (f32)lines * (f32)16.0 * (f32)Styles.device_scale();
    }

    // Microseconds from the performance counter (it ticks at 10 MHz on current Windows).
    static unsafe u64 ticks(HostState* s) {
        QueryPerformanceCounter((void*)((u8*)s.rect + 16));
        return Raw.get_u64(s.rect, 16) / 10;
    }

    // The height of the strip drawn on top of the page: the title bar, in physical pixels.
    public static unsafe f32 caption() {
        return (f32)(u32)(36.0 * Styles.device_scale());
    }

    // What WM_NCHITTEST answers: HTCLIENT (1), HTCAPTION (2), HTMINBUTTON (8), HTMAXBUTTON (9), HTCLOSE (20) or one
    // of the edges and corners (10 .. 17) that resize.
    static unsafe i64 hit_test(void* window, i64 extra) {
        void* rect = Raw.make(16);
        GetWindowRect(window, rect);
        f32 left = (f32)Raw.get_i32(rect, 0);
        f32 top = (f32)Raw.get_i32(rect, 4);
        f32 width = (f32)Raw.get_i32(rect, 8) - left;
        f32 height = (f32)Raw.get_i32(rect, 12) - top;
        __djinn_free(rect);
        f32 x = WinHost.low_word((u64)extra) - left;
        f32 y = WinHost.low_word(((u64)extra) >> 16) - top;
        f32 scale = (f32)Styles.device_scale();
        f32 cap = WinHost.caption();
        f32 button = (f32)46.0 * scale;
        if (y >= (f32)0.0 && y < cap && x >= width - button * (f32)3.0 && x < width) {
            if (x >= width - button) {
                return 20;
            }
            if (x >= width - button * (f32)2.0) {
                return 9;
            }
            return 8;
        }
        if (IsZoomed(window) == 0) {
            f32 edge = (f32)6.0 * scale;
            bool at_left = x < edge;
            bool at_right = x >= width - edge;
            bool at_top = y < edge;
            bool at_bottom = y >= height - edge;
            if (at_top && at_left) {
                return 13;
            }
            if (at_top && at_right) {
                return 14;
            }
            if (at_bottom && at_left) {
                return 16;
            }
            if (at_bottom && at_right) {
                return 17;
            }
            if (at_left) {
                return 10;
            }
            if (at_right) {
                return 11;
            }
            if (at_top) {
                return 12;
            }
            if (at_bottom) {
                return 15;
            }
        }
        if (y < cap) {
            return 2;
        }
        return 1;
    }

    // Rounded corners and no accent-colored border: the system frame is gone (WM_NCCALCSIZE), the window only keeps
    // its shadow and, on Windows 11, the rounding of its corners (DWMWA_WINDOW_CORNER_PREFERENCE 33 = round, and
    // DWMWA_BORDER_COLOR 34 = none).
    static unsafe void shape(void* window) {
        void* value = Raw.make(4);
        Raw.put_u32(value, 0, 2);
        DwmSetWindowAttribute(window, 33, value, 4);
        Raw.put_u32(value, 0, 0xFFFFFFFE);
        DwmSetWindowAttribute(window, 34, value, 4);
        __djinn_free(value);
    }

    // A straight line of 'thick' px as two triangles.
    static unsafe void segment(DisplayList* list, f32 x0, f32 y0, f32 x1, f32 y1, f32 thick, u32 color) {
        f32 dx = x1 - x0;
        f32 dy = y1 - y0;
        f32 length = Math.sqrt(dx * dx + dy * dy);
        if (length <= (f32)0.0) {
            return;
        }
        f32 nx = (f32)0.0 - dy / length * thick / (f32)2.0;
        f32 ny = dx / length * thick / (f32)2.0;
        f32 u = DisplayList.solid_u();
        list.push(x0 + nx, y0 + ny, u, u, color);
        list.push(x1 + nx, y1 + ny, u, u, color);
        list.push(x0 - nx, y0 - ny, u, u, color);
        list.push(x1 + nx, y1 + ny, u, u, color);
        list.push(x1 - nx, y1 - ny, u, u, color);
        list.push(x0 - nx, y0 - ny, u, u, color);
    }

    // The title bar and the window outline, drawn by the host over the page: the page's own background, the three
    // caption buttons (minimize, maximize or restore, close; the close one turns red under the pointer) and a one
    // pixel border that follows the rounded corners.
    static unsafe void chrome(HostState* s, f32 width, f32 height) {
        DisplayList* list = &s.list;
        f32 scale = (f32)Styles.device_scale();
        f32 cap = WinHost.caption();
        u32 page = Painter.canvas_color(Dom.document());
        mut u32 background = 0x101114FF;
        if ((page & 255) != 0) {
            background = page;
        }
        u32 red = (background >> 24) & 255;
        u32 green = (background >> 16) & 255;
        u32 blue = (background >> 8) & 255;
        bool dark = (red * 299 + green * 587 + blue * 114) / 1000 < 128;
        mut u32 ink = 0x202020FF;
        if (dark) {
            ink = 0xF2F2F2FF;
        }
        bool zoomed = IsZoomed(s.window) != 0;
        list.fill((f32)0.0, (f32)0.0, width, cap, DisplayList.gpu_color(background, (f32)1.0));
        f32 button = (f32)46.0 * scale;
        f32 half = (f32)5.0 * scale;
        mut f32 thick = (f32)(u32)scale;
        if (thick < (f32)1.0) {
            thick = (f32)1.0;
        }
        for (mut u32 i = 0; i < 3; i = i + 1) {
            mut u32 code = 8;
            if (i == 1) {
                code = 9;
            } else if (i == 2) {
                code = 20;
            }
            f32 left = width - button * (f32)(3 - i);
            bool over = s.hover == code;
            mut u32 glyph = DisplayList.gpu_color(ink, (f32)1.0);
            if (over && code == 20) {
                list.fill(left, (f32)0.0, button, cap, DisplayList.gpu_color(0xC42B1CFF, (f32)1.0));
                glyph = DisplayList.gpu_color(0xFFFFFFFF, (f32)1.0);
            } else if (over) {
                list.fill(left, (f32)0.0, button, cap, DisplayList.gpu_color(ink, (f32)0.1));
            }
            f32 cx = left + button / (f32)2.0;
            f32 cy = cap / (f32)2.0;
            if (code == 8) {
                list.fill(cx - half, cy, half * (f32)2.0, thick, glyph);
            } else if (code == 9 && !zoomed) {
                list.ring(cx - half, cy - half, half * (f32)2.0, half * (f32)2.0, scale, thick, glyph);
            } else if (code == 9) {
                f32 q = half * (f32)1.6;
                f32 o = (f32)2.0 * scale;
                f32 a = cx - half;
                f32 b = cy - half + o * (f32)1.5;
                list.ring(a, b, q, q, scale, thick, glyph);
                list.fill(a + o, b - o, q, thick, glyph);
                list.fill(a + o + q - thick, b - o, thick, q, glyph);
            } else {
                WinHost.segment(list, cx - half, cy - half, cx + half, cy + half, thick, glyph);
                WinHost.segment(list, cx + half, cy - half, cx - half, cy + half, thick, glyph);
            }
        }
        if (!zoomed) {
            list.ring((f32)0.0, (f32)0.0, width, height, (f32)8.0 * scale, thick, DisplayList.gpu_color(ink, (f32)0.16));
        }
    }

    // Draws a frame when something changed: the size, the DOM or an explicit request (dirty).
    static unsafe void render(HostState* s) {
        GetClientRect(s.window, s.rect);
        u32 w = (u32)Raw.get_i32(s.rect, 8);
        u32 h = (u32)Raw.get_i32(s.rect, 12);
        if (w == 0 || h == 0) {
            return;
        }
        if (s.gpu == (VulkanRenderer*)0 && (w != s.canvas.width || h != s.canvas.height)) {
            s.canvas.release();
            s.canvas = Canvas.create(w, h);
            s.dirty = true;
        }
        if (s.gpu != (VulkanRenderer*)0 && (w != s.gpu_width || h != s.gpu_height)) {
            s.gpu_width = w;
            s.gpu_height = h;
            s.dirty = true;
        }
        if (s.dirty || Dom.stamp() + Animation.version() + Scroll.version() != s.stamp || Dom.epoch() != s.epoch) {
            mut u64 t0 = WinHost.ticks(s);
            // the page is laid out below the title bar: its triangles move down by the bar's height
            f32 cap = WinHost.caption();
            Painter.frame(&s.list, (f32)w, (f32)h - cap);
            for (mut u32 i = 0; i < s.list.count; i = i + 1) {
                Vertex* vertex = &s.list.vertices[i];
                vertex.y = vertex.y + cap;
            }
            WinHost.chrome(s, (f32)w, (f32)h);
            u64 t1 = WinHost.ticks(s);
            mut u64 draw_us = 0;
            mut u64 present_us = 0;
            if (s.gpu != (VulkanRenderer*)0) {
                // a size change makes the first attempt rebuild the swapchain; drawing again at once keeps the window
                // from showing a stale or stretched frame while the edge is dragged
                s.dirty = !VulkanRenderer.draw(s.gpu, &s.list, w, h);
                mut u32 attempts = 1;
                if (s.dirty) {
                    s.dirty = !VulkanRenderer.draw(s.gpu, &s.list, w, h);
                    attempts = 2;
                }
                draw_us = WinHost.ticks(s) - t1;
                if (getenv("DJINN_UI_TRACE") != (i8*)0) {
                    printf("gpu client %ux%u swapchain %ux%u attempts %u shown %d vertices %u
", w, h, s.gpu.width, s.gpu.height, attempts, (i32)(!s.dirty), s.list.count);
                }
            } else {
                s.canvas.clear(0xFFFFFFFF);
                SoftRaster.draw(&s.canvas, &s.list);
                u64 t2 = WinHost.ticks(s);
                WinHost.present(s.window, &s.canvas);
                u64 t3 = WinHost.ticks(s);
                draw_us = t2 - t1;
                present_us = t3 - t2;
                if (getenv("DJINN_UI_TRACE") != (i8*)0) {
                    printf("frame %ux%u layout+paint %llu raster %llu present %llu (us)
", w, h, t1 - t0, t2 - t1, t3 - t2);
                }
                s.dirty = false;
            }
            DevTools.frame(s.tools, t1 - t0, draw_us, present_us, s.list.count, w, h);
            s.stamp = Dom.stamp() + Animation.version() + Scroll.version();
            s.epoch = Dom.epoch();
        }
    }

    // Runs one app in a window until it is closed. Returns the exit code.
    public static unsafe i32 run<T>(T app, str title, u32 width, u32 height) {
        // DJINN_UI_DEVTOOLS shows the metrics screen (see devtools.djinn) in the console of the process
        mut DevTools* tools = (DevTools*)0;
        if (getenv("DJINN_UI_DEVTOOLS") != (i8*)0) {
            tools = DevTools.create();
        }
        SetProcessDPIAware();
        GdiFonts.install();
        WinClipboard.install();
        Scroll.set_smooth(true);
        mut u64 stage_start = DevTools.now();
        Mounted mounted = App.mount<T>(app);
        DevTools.stage(tools, "mount", stage_start);
        // the window size is given in CSS pixels
        f64 device = WinHost.scale();
        Styles.set_device_scale(device);
        u32 scaled_width = (u32)((f64)width * device);
        u32 scaled_height = (u32)((f64)height * device);
        stage_start = DevTools.now();
        void* window = WinHost.open(title, scaled_width, scaled_height);
        if (window == (void*)0) {
            return 1;
        }
        DevTools.stage(tools, "window", stage_start);
        WinHost.shape(window);
        f32 cap = WinHost.caption();
        HostState* state = (HostState*)__djinn_alloc_zeroed((size_long)sizeof(HostState));
        state.window = window;
        state.rect = Raw.make(32);
        state.list = DisplayList.create();
        state.canvas = Canvas.create(1, 1);
        state.dirty = true;
        state.tools = tools;
        stage_start = DevTools.now();
        // Vulkan is the default; the software rasterizer is used only when no Vulkan device is available (or when
        // DJINN_UI_CPU is set, to compare or debug).
        if (getenv("DJINN_UI_CPU") == (i8*)0) {
            state.gpu = VulkanRenderer.create(GetModuleHandleA((i8*)0), window, scaled_width, scaled_height);
            if (state.gpu == (VulkanRenderer*)0) {
                printf("win32: Vulkan is not available, drawing with the software rasterizer
");
            } else {
                printf("win32: drawing with Vulkan
");
            }
        }
        DevTools.stage(tools, "gpu", stage_start);
        host_state_address = (u64)state;
        void* message = Raw.make(64);
        mut u32 pressed = 0;
        mut u32 editing = 0;
        mut u32 high = 0;
        mut f32 pointer_x = (f32)0.0;
        mut f32 pointer_y = (f32)0.0;
        mut bool running = true;
        while (running) {
            mut bool busy = false;
            while (PeekMessageA(message, (void*)0, 0, 0, 1) != 0) {
                busy = true;
                u32 kind = Raw.get_u32(message, 8);
                u64 param = Raw.get_u64(message, 24);
                u64 key = Raw.get_u64(message, 16);
                f32 x = WinHost.low_word(param);
                f32 y = WinHost.low_word(param >> 16) - cap;
                if (kind == WinHost.WM_QUIT) {
                    running = false;
                } else if (kind == WinHost.WM_LBUTTONDOWN) {
                    pressed = Hit.at(x, y);
                    if (Hit.bar() != 0) {
                        Bars.begin(Hit.bar(), Hit.bar_vertical(), x, y);
                        pressed = 0;
                    } else if (Hit.track() != 0) {
                        Bars.page(Hit.track(), Hit.bar_vertical(), Hit.track_before());
                        pressed = 0;
                    }
                    u32 control = Focus.owner(pressed);
                    editing = 0;
                    if (control != 0) {
                        Focus.set(control, false);
                        if (Input.editable(control)) {
                            editing = control;
                            Edit.click(control, x, (WinHost.modifiers() & Mod.SHIFT) != 0);
                        }
                    } else {
                        Focus.clear();
                    }
                    Pointer.press(pressed);
                    WinHost.announce(pressed, "mousedown");
                } else if (kind == WinHost.WM_LBUTTONUP) {
                    Bars.end();
                    u32 target = Hit.at(x, y);
                    Pointer.release();
                    WinHost.announce(target, "mouseup");
                    if (target != 0 && target == pressed) {
                        WinHost.announce(target, "click");
                    }
                    pressed = 0;
                    editing = 0;
                } else if (kind == WinHost.WM_MOUSEMOVE) {
                    pointer_x = x;
                    pointer_y = y;
                    if (state.hover != 0) {
                        state.hover = 0;
                        state.dirty = true;
                    }
                    if (editing != 0) {
                        Edit.drag(editing, x);
                    }
                    if (Bars.dragging() && (key & 1) == 0) {
                        Bars.end();
                    }
                    if (Bars.dragging()) {
                        Bars.drag(x, y);
                    }
                    u32 over = Hit.at(x, y);
                    Pointer.move(over);
                    WinHost.announce(over, "mousemove");
                } else if (kind == WinHost.WM_MOUSEWHEEL) {
                    // the wheel delta is the signed high word of wParam (120 per notch); the position is on screen
                    mut i32 notches = (i32)((key >> 16) & 0xFFFF);
                    if (notches >= 32768) {
                        notches = notches - 65536;
                    }
                    if ((WinHost.modifiers() & Mod.SHIFT) != 0) {
                        Scroll.wheel_x(pointer_x, pointer_y, (f32)0.0 - WinHost.wheel_amount(notches, true));
                    } else {
                        Scroll.wheel(pointer_x, pointer_y, (f32)0.0 - WinHost.wheel_amount(notches, false));
                    }
                } else if (kind == WinHost.WM_MOUSEHWHEEL) {
                    mut i32 side = (i32)((key >> 16) & 0xFFFF);
                    if (side >= 32768) {
                        side = side - 65536;
                    }
                    Scroll.wheel_x(pointer_x, pointer_y, WinHost.wheel_amount(side, true));
                } else if (kind == WinHost.WM_XBUTTONUP) {
                    // the extra mouse buttons go back (1) and forward (2) through the pages, like a browser
                    u32 button = (u32)((key >> 16) & 0xFFFF);
                    if (button == 1) {
                        Router.back();
                    } else if (button == 2) {
                        Router.forward();
                    }
                } else if (kind == WinHost.WM_KEYDOWN) {
                    Input.press((i32)(key & 0xFFFF), WinHost.modifiers());
                } else if (kind == WinHost.WM_CHAR) {
                    // UTF-16 units: a high surrogate waits for its low half
                    u32 unit = (u32)(key & 0xFFFF);
                    if (unit >= 55296 && unit < 56320) {
                        high = unit;
                    } else if (unit >= 56320 && unit < 57344) {
                        if (high != 0) {
                            Input.typed(65536 + ((high - 55296) << 10) + (unit - 56320));
                        }
                        high = 0;
                    } else {
                        high = 0;
                        Input.typed(unit);
                    }
                } else if (kind == WinHost.WM_PAINT) {
                    state.dirty = true;
                }
                TranslateMessage(message);
                DispatchMessageA(message);
            }
            if (IsWindow(window) == 0) {
                running = false;
            }
            if (Animation.advance((u32)(WinHost.ticks(state) / 1000))) {
                busy = true;
            }
            if (running) {
                u32 before = state.stamp + state.epoch + Animation.version() + Scroll.version();
                bool was_dirty = state.dirty;
                WinHost.render(state);
                if (was_dirty || before != state.stamp + state.epoch + Animation.version() + Scroll.version()) {
                    busy = true;
                }
            }
            DevTools.tick(tools);
            if (!busy) {
                Sleep(8);
            }
        }
        host_state_address = 0;
        DevTools.close(tools);
        if (state.gpu != (VulkanRenderer*)0) {
            VulkanRenderer.release(state.gpu);
        }
        state.list.release();
        state.canvas.release();
        mounted.unmount();
        return 0;
    }

    // One frame to a PPM file, no window: what a test or a screenshot of the showcase uses.
    public static unsafe i32 shot<T>(T app, u32 width, u32 height, i8* path, f32 click_x, f32 click_y) {
        GdiFonts.install();
        WinClipboard.install();
        f64 device = WinHost.scale();
        Styles.set_device_scale(device);
        // the image is in physical pixels: the size given is in CSS pixels
        u32 pixel_width = (u32)((f64)width * device);
        u32 pixel_height = (u32)((f64)height * device);
        Mounted mounted = App.mount<T>(app);
        mut DisplayList list = DisplayList.create();
        Painter.frame(&list, (f32)pixel_width, (f32)pixel_height);
        // a still image shows every animation finished: the first advance starts them, the second ends them
        WinHost.settle();
        Painter.frame(&list, (f32)pixel_width, (f32)pixel_height);
        if (click_x >= (f32)0.0) {
            u32 target = Hit.at(click_x, click_y);
            WinHost.announce(target, "click");
            Painter.frame(&list, (f32)pixel_width, (f32)pixel_height);
            WinHost.settle();
            Painter.frame(&list, (f32)pixel_width, (f32)pixel_height);
        }
        mut Canvas canvas = Canvas.create(pixel_width, pixel_height);
        canvas.clear(0xFFFFFFFF);
        SoftRaster.draw(&canvas, &list);
        bool saved = canvas.save_ppm(path);
        list.release();
        canvas.release();
        mounted.unmount();
        if (saved) {
            return 0;
        }
        return 1;
    }
}
