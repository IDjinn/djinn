import std::types;
import std::libc;

namespace win32;

// The slice of the Win32 API the host uses. Structures are filled through byte buffers at their documented x64
// offsets (see Raw), so no layout has to be mirrored here. Link with user32.lib, gdi32.lib and kernel32.lib.
extern "C" {
    void* GetModuleHandleA(i8* name);
    void* GetProcAddress(void* module, i8* name);
    void Sleep(u32 milliseconds);

    u16 RegisterClassExA(void* class_info);
    void* CreateWindowExA(u32 ex_style, i8* class_name, i8* title, u32 style, i32 x, i32 y, i32 width, i32 height,
        void* parent, void* menu, void* instance, void* param);
    i32 ShowWindow(void* window, i32 command);
    i32 PeekMessageA(void* message, void* window, u32 min, u32 max, u32 remove);
    i32 TranslateMessage(void* message);
    i64 DispatchMessageA(void* message);
    i32 IsWindow(void* window);
    i32 DestroyWindow(void* window);
    i32 GetClientRect(void* window, void* rect);
    void* LoadCursorA(void* instance, void* name);
    i32 SetWindowTextA(void* window, i8* text);
    i32 SetProcessDPIAware();
    u32 GetDpiForWindow(void* window);
    void* GetDC(void* window);
    i32 ReleaseDC(void* window, void* dc);
    i32 GetSystemMetrics(i32 index);

    void* CreateCompatibleDC(void* dc);
    void* CreateFontA(i32 height, i32 width, i32 escapement, i32 orientation, i32 weight, u32 italic, u32 underline,
        u32 strike, u32 charset, u32 out_precision, u32 clip_precision, u32 quality, u32 pitch, i8* face);
    void* SelectObject(void* dc, void* object);
    i32 DeleteObject(void* object);
    u32 GetGlyphOutlineW(void* dc, u32 code, u32 format, void* metrics, u32 size, void* buffer, void* matrix);
    i32 GetTextMetricsW(void* dc, void* metrics);
    i32 StretchDIBits(void* dc, i32 dest_x, i32 dest_y, i32 dest_width, i32 dest_height, i32 src_x, i32 src_y,
        i32 src_width, i32 src_height, void* bits, void* info, u32 usage, u32 operation);
}

// Byte buffers read and written as the C structures the API wants.
struct Raw {
    public static unsafe void* make(u32 bytes) {
        return __djinn_alloc_zeroed((size_long)bytes);
    }

    public static unsafe void put_u32(void* buffer, u32 offset, u32 value) {
        u8* at = (u8*)buffer;
        *((u32*)&at[offset]) = value;
    }

    public static unsafe void put_i32(void* buffer, u32 offset, i32 value) {
        u8* at = (u8*)buffer;
        *((i32*)&at[offset]) = value;
    }

    public static unsafe void put_u16(void* buffer, u32 offset, u16 value) {
        u8* at = (u8*)buffer;
        *((u16*)&at[offset]) = value;
    }

    public static unsafe void put_ptr(void* buffer, u32 offset, void* value) {
        u8* at = (u8*)buffer;
        *((u64*)&at[offset]) = (u64)value;
    }

    public static unsafe u32 get_u32(void* buffer, u32 offset) {
        u8* at = (u8*)buffer;
        return *((u32*)&at[offset]);
    }

    public static unsafe i32 get_i32(void* buffer, u32 offset) {
        u8* at = (u8*)buffer;
        return *((i32*)&at[offset]);
    }

    public static unsafe i32 get_i16(void* buffer, u32 offset) {
        u8* at = (u8*)buffer;
        return (i32)(*((i16*)&at[offset]));
    }

    public static unsafe u64 get_u64(void* buffer, u32 offset) {
        u8* at = (u8*)buffer;
        return *((u64*)&at[offset]);
    }
}
