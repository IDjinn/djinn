import std::types;
import std::libc;

namespace android;

// The functions of runtime/android/android_host.c: the looper, the window, touch input, the software present and the
// system fonts. Programs for an Android target get that file through the runtime library (tools/build_runtime.sh --android).
extern "C" {
    i64 __djinn_now_us();
    void djinn_android_log(i8* text);
    void djinn_android_ready();
    i32 djinn_android_pump(i32 timeout_ms);
    i32 djinn_android_take_dirty();
    i32 djinn_android_width();
    void* djinn_android_window();
    i32 djinn_android_height();
    i32 djinn_android_density();
    i32 djinn_android_night();
    i32 djinn_android_present(u32* pixels, i32 width, i32 height);
    i32 djinn_android_next_touch(f32* x, f32* y, i32* action);
    i32 djinn_android_next_key(i32* code, i32* meta, i32* action, i32* unicode);
    void djinn_android_keyboard(i32 show);
    void djinn_android_insets(i32* out);
    void djinn_android_clipboard_set(i8* text, i32 length);
    i8* djinn_android_clipboard_get(i32* length);

    f32 djinn_font_advance(u32 code, f32 size, u32 weight);
    i32 djinn_font_rasterize(u32 code, f32 size, u32 weight, u32 phase, i32* width, i32* height, i32* bearing_x, i32* bearing_y, u8** pixels);
    void djinn_font_metrics(f32 size, u32 weight, f32* ascent, f32* descent);
}
