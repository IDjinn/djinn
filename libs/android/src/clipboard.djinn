import std::types;
import std::libc;
import ui;

namespace android;

// The system clipboard for the text fields of the ui library: Android's ClipboardManager through the runtime shim (JNI).
struct AndroidClipboard : ClipboardBackend {
    i32 unused;

    public unsafe void write(i8* data, u32 length) {
        djinn_android_clipboard_set(data, (i32)length);
    }

    // The clipboard text as UTF-8, or null when it holds no text. The buffer lives until the next read.
    public unsafe i8* read(u32* length) {
        mut i32 size = 0;
        i8* text = djinn_android_clipboard_get(&size);
        if (text == (i8*)0) {
            return (i8*)0;
        }
        *length = (u32)size;
        return text;
    }
}
