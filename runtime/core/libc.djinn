extern "C" {
    [AllocFn("djinn")] void* __djinn_alloc([AllocSize] u64 size);
    [AllocFn("djinn"), AllocZeroed] void* __djinn_alloc_zeroed([AllocSize] u64 size);
    i32 __djinn_reflected_count();
    void* __djinn_reflected_type(i32 index);
    [AllocFn("djinn_aligned"), AllocZeroed] void* __djinn_malloc_aligned([AllocSize] u64 size, [AllocAlign] u64 alignment);
    [FreeFn("djinn_aligned")] void __djinn_free_aligned([AllocPtr] void* pointer);
    [FreeFn("djinn")] void __djinn_free([AllocPtr] void* pointer);
    [ReallocFn("djinn")] void* __djinn_realloc([AllocPtr] void* pointer, [AllocSize] u64 new_size);
    void* memcpy(void* destination, void* source, u64 count);
    void* memmove(void* destination, void* source, u64 count);
    i32 snprintf(i8* buffer, u64 size, i8* format, ...);
    i32 strlen(i8* text);
    f64 strtod(i8* text, void* end);
    f32 strtof(i8* text, void* end);
    i64 write(i32 descriptor, void* data, u64 count);
    void abort();
    i32 __djinn_errno();
    void __djinn_errno_clear();
    i32 __djinn_last_error();
}
