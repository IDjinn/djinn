extern "C" {
    void* __djinn_alloc(u64 size);
    void* __djinn_alloc_zeroed(u64 size);
    i32 __djinn_reflected_count();
    void* __djinn_reflected_type(i32 index);
    void* __djinn_malloc_aligned(u64 size, u64 alignment);
    void __djinn_free_aligned(void* pointer);
    void __djinn_free(void* pointer);
    void* __djinn_realloc(void* pointer, u64 new_size);
    void* memcpy(void* destination, void* source, u64 count);
    void* memmove(void* destination, void* source, u64 count);
    i32 snprintf(i8* buffer, u64 size, i8* format, ...);
    i32 strlen(i8* text);
    f64 strtod(i8* text, void* end);
    f32 strtof(i8* text, void* end);
    i64 write(i32 descriptor, void* data, u64 count);
    void abort();
}
