struct Error {
    i8* name;
    i8* message;
    i32 code;
    i8* stackTrace;

    // 'Error("something went wrong")': a plain error carrying only a message.
    public Error() {
        this.name = "Error";
        this.message = "";
        this.code = 0;
        unsafe { this.stackTrace = (i8*)0; }
    }

    // A literal or constexpr message arrives as a STATIC string: its bytes are in the binary and end in NUL, so the
    // pointer is kept as it is. Any other text is copied.
    public Error(string message) {
        this.name = "Error";
        this.message = Reflection.terminated(message);
        this.code = 0;
        unsafe { this.stackTrace = (i8*)0; }
    }

    public Error(string message, i32 code) {
        this.name = "Error";
        this.message = Reflection.terminated(message);
        this.code = code;
        unsafe { this.stackTrace = (i8*)0; }
    }

    public Error(str message) {
        this.name = "Error";
        this.message = Reflection.terminated_view(message);
        this.code = 0;
        unsafe { this.stackTrace = (i8*)0; }
    }

    public Error(str message, i32 code) {
        this.name = "Error";
        this.message = Reflection.terminated_view(message);
        this.code = code;
        unsafe { this.stackTrace = (i8*)0; }
    }
}

struct Overflow {
    i8* message;

    public Overflow() {
        this.message = "integer overflow";
    }

    public Overflow(string message) {
        this.message = Reflection.terminated(message);
    }

    public Overflow(str message) {
        this.message = Reflection.terminated_view(message);
    }
}

struct DivisionByZero {
    i8* message;

    public DivisionByZero() {
        this.message = "division by zero";
    }

    public DivisionByZero(string message) {
        this.message = Reflection.terminated(message);
    }

    public DivisionByZero(str message) {
        this.message = Reflection.terminated_view(message);
    }
}
