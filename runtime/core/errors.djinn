struct Error {
    i8* name;
    i8* message;
    i32 code;
    i8* stackTrace;

    // 'Error("something went wrong")': a plain error carrying only a message.
    public Error() {
        this.name = "Error";
        this.message = "";
        this.code = 0;
        unsafe { this.stackTrace = (i8*)0; }
    }

    // A literal or constexpr message is static data: the pointer is kept as it is, nothing is allocated.
    public Error(i8* message) {
        this.name = "Error";
        this.message = message;
        this.code = 0;
        unsafe { this.stackTrace = (i8*)0; }
    }

    public Error(i8* message, i32 code) {
        this.name = "Error";
        this.message = message;
        this.code = code;
        unsafe { this.stackTrace = (i8*)0; }
    }

    public Error(str message) {
        this.name = "Error";
        this.message = Reflection.terminated_view(message);
        this.code = 0;
        unsafe { this.stackTrace = (i8*)0; }
    }

    public Error(str message, i32 code) {
        this.name = "Error";
        this.message = Reflection.terminated_view(message);
        this.code = code;
        unsafe { this.stackTrace = (i8*)0; }
    }
}

struct Overflow {
    i8* message;

    public Overflow() {
        this.message = "integer overflow";
    }

    public Overflow(i8* message) {
        this.message = message;
    }

    public Overflow(str message) {
        this.message = Reflection.terminated_view(message);
    }
}

struct DivisionByZero {
    i8* message;

    public DivisionByZero() {
        this.message = "division by zero";
    }

    public DivisionByZero(i8* message) {
        this.message = message;
    }

    public DivisionByZero(str message) {
        this.message = Reflection.terminated_view(message);
    }
}
