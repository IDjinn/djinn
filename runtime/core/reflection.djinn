struct Reflection {
    public static unsafe i8* terminated(string text) {
        i8* copy = (i8*)__djinn_malloc((u64)text.length + 1);
        memcpy(copy, text.data, (u64)text.length);
        copy[text.length] = 0;
        return copy;
    }

    public static unsafe i8* terminated_view(str text) {
        i8* copy = (i8*)__djinn_malloc((u64)text.length + 1);
        memcpy(copy, text.data, (u64)text.length);
        copy[text.length] = 0;
        return copy;
    }

    public static ValueKind kind_of(TypeInfo* info) {
        i32 kind = (i32)info.kind;
        if (kind == 0) { return ValueKind::Signed(); }
        if (kind == 1) { return ValueKind::Floating(); }
        if (kind == 2) { return ValueKind::Pointer(); }
        if (kind == 4) { return ValueKind::Unsigned(); }
        if (kind == 5) { return ValueKind::View(); }
        if (kind == 6) { return ValueKind::Owned(); }
        return ValueKind::Composite();
    }

    public static unsafe string number_text(i8* buffer, i32 count) {
        string number = { .data = buffer, .length = (u32)count, .capacity = 64 };
        return number;
    }

    public static unsafe string signed_text(TypeInfo* info, void* element) {
        mut i64 value = 0;
        if (info.size == 1) { value = (i64)*(i8*)element; }
        else if (info.size == 2) { value = (i64)*(i16*)element; }
        else if (info.size == 4) { value = (i64)*(i32*)element; }
        else { value = *(i64*)element; }
        i8* buffer = (i8*)__djinn_malloc(64);
        return Reflection.number_text(buffer, snprintf(buffer, 64, "%lld", value));
    }

    public static unsafe string unsigned_text(TypeInfo* info, void* element) {
        mut u64 value = 0;
        if (info.size == 1) { value = (u64)*(u8*)element; }
        else if (info.size == 2) { value = (u64)*(u16*)element; }
        else if (info.size == 4) { value = (u64)*(u32*)element; }
        else { value = *(u64*)element; }
        i8* buffer = (i8*)__djinn_malloc(64);
        return Reflection.number_text(buffer, snprintf(buffer, 64, "%llu", value));
    }

    public static unsafe string floating_text(TypeInfo* info, void* element) {
        mut f64 value = 0.0;
        if (info.size == 4) { value = (f64)*(f32*)element; }
        else { value = *(f64*)element; }
        i8* buffer = (i8*)__djinn_malloc(64);
        return Reflection.number_text(buffer, snprintf(buffer, 64, "%g", value));
    }

    public static unsafe string quoted_text(i8* data, u32 length) {
        i8* quoted = (i8*)__djinn_malloc((u64)length + 3);
        quoted[0] = 34;
        memcpy(quoted + 1, data, (u64)length);
        quoted[length + 1] = 34;
        string text = { .data = quoted, .length = length + 2, .capacity = length + 3 };
        return text;
    }

    public static unsafe string element_text(TypeInfo* info, void* element) {
        switch (Reflection.kind_of(info)) {
            case Signed:
                return Reflection.signed_text(info, element);
            case Unsigned:
                return Reflection.unsigned_text(info, element);
            case Floating:
                return Reflection.floating_text(info, element);
            case View:
                return Reflection.quoted_text(*(i8**)element, *(u32*)((i8*)element + 8));
            case Owned:
                return Reflection.quoted_text(*(i8**)element, *(u32*)((i8*)element + 8));
            case Pointer:
                return Reflection.quoted_text(*(i8**)element, (u32)strlen(*(i8**)element));
            default:
                return reflection_text(info.name);
        }
    }

    public static unsafe string object_text(object item) {
        return Reflection.element_text(item.type, item.data);
    }

    public static unsafe string array_start() {
        return reflection_text("[");
    }

    public static unsafe string array_join(string joined, string item, u32 index) {
        if (index == 0) {
            return joined + reflection_text(" ") + item;
        }
        return joined + reflection_text(", ") + item;
    }

    public static unsafe string array_end(string joined) {
        return joined + reflection_text(" ]");
    }

    const i32 KIND_ENUM = 7;
    const i32 KIND_UNION = 8;
    const i32 KIND_INTERFACE = 9;
    const i32 FLAG_REFLECTED = 1;
    const i32 METHOD_STATIC = 2;
    const i32 METHOD_ASYNC = 4;

    public static unsafe bool same(i8* left, i8* right) {
        mut i32 i = 0;
        while (left[i] != 0 && left[i] == right[i]) {
            i = i + 1;
        }
        return left[i] == right[i];
    }
    public static unsafe i32 type_count() {
        return __djinn_reflected_count();
    }
    public static unsafe TypeInfo* type_at(i32 index) {
        return (TypeInfo*)__djinn_reflected_type(index);
    }
    public static bool reflected(TypeInfo* info) {
        return (info.flags & 1) != 0;
    }
    public static unsafe TypeInfoExt* ext(TypeInfo* info) {
        if ((info.flags & 1) == 0) {
            return (TypeInfoExt*)0;
        }
        return (TypeInfoExt*)info;
    }
    public static unsafe EnumInfo* enumeration(TypeInfo* info) {
        if ((info.flags & 1) == 0 || (info.kind != 7 && info.kind != 8)) {
            return (EnumInfo*)0;
        }
        TypeInfoExt* extended = (TypeInfoExt*)info;
        return (EnumInfo*)extended.detail;
    }
    public static unsafe FieldInfo* field(TypeInfoExt* info, i8* name) {
        for (mut i32 i = 0; i < (i32)info.fieldCount; i = i + 1) {
            if (Reflection.same(info.fields[i].name, name)) {
                return &info.fields[i];
            }
        }
        return (FieldInfo*)0;
    }
    public static unsafe MethodInfo* method(TypeInfoExt* info, i8* name) {
        for (mut i32 i = 0; i < (i32)info.methodCount; i = i + 1) {
            if (Reflection.same(info.methods[i].name, name)) {
                return &info.methods[i];
            }
        }
        return (MethodInfo*)0;
    }
    public static unsafe bool implements(TypeInfoExt* info, i8* name) {
        for (mut i32 i = 0; i < (i32)info.interfaceCount; i = i + 1) {
            if (Reflection.same(info.interfaces[i], name)) {
                return true;
            }
        }
        return false;
    }
    public static unsafe i32 variant_index(EnumInfo* info, i64 value) {
        for (mut i32 i = 0; i < (i32)info.variantCount; i = i + 1) {
            if (info.variants[i].value == value) {
                return i;
            }
        }
        return 0 - 1;
    }
    public static unsafe VariantInfo* variant(EnumInfo* info, i64 value) {
        i32 index = Reflection.variant_index(info, value);
        if (index < 0 || index >= (i32)info.variantCount) {
            return (VariantInfo*)0;
        }
        return &info.variants[index];
    }
    public static unsafe VariantInfo* variant_named(EnumInfo* info, i8* name) {
        for (mut i32 i = 0; i < (i32)info.variantCount; i = i + 1) {
            if (Reflection.same(info.variants[i].name, name)) {
                return &info.variants[i];
            }
        }
        return (VariantInfo*)0;
    }
    public static unsafe HeaderInfo* header(EnumInfo* info, i8* name) {
        for (mut i32 i = 0; i < (i32)info.headerCount; i = i + 1) {
            if (Reflection.same(info.headers[i].name, name)) {
                return &info.headers[i];
            }
        }
        return (HeaderInfo*)0;
    }
    public static unsafe i64 header_integer(HeaderInfo* header, i64 value) {
        if (header.table == null) {
            return value;
        }
        if (value < 0 || value >= (i64)header.rowCount) {
            return 0;
        }
        if (header.size == 1) {
            i8* narrow = (i8*)header.table;
            return (i64)narrow[value];
        }
        if (header.size == 2) {
            i16* small = (i16*)header.table;
            return (i64)small[value];
        }
        if (header.size == 4) {
            i32* medium = (i32*)header.table;
            return (i64)medium[value];
        }
        i64* wide = (i64*)header.table;
        return wide[value];
    }
    public static unsafe i8* header_text(HeaderInfo* header, i64 value) {
        if (header.table == null || value < 0 || value >= (i64)header.rowCount) {
            return (i8*)0;
        }
        i8** rows = (i8**)header.table;
        return rows[value];
    }
}
