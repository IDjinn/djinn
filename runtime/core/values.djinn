struct str {
    i8* data;
    u32 length;
    public bool is_empty() { return this.length == 0; }
    public i8* ptr() { return this.data; }
}
struct task<T> {
    void* handle;
}
struct object {
    TypeInfo* type;
    void* data;
}
struct arr<T> {
    T* data;
    u32 length;
    public bool is_empty() { return this.length == 0; }
    public T* ptr() { return this.data; }
}
