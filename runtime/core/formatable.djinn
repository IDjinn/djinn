interface IFormatable<T> {
    T format();
}
unsafe string reflection_text(i8* text) {
    u32 size = (u32)strlen(text);
    string copy = { .data = __djinn_text_duplicate(text, size), .length = size, .meta = 0 };
    return copy;
}
unsafe string reflection_separator(i32 index) {
    if (index == 0) {
        return reflection_text("");
    }
    return reflection_text(", ");
}
impl IFormatable<string> for FieldList {
    unsafe string format() {
        mut string joined = reflection_text("");
        for (mut i32 i = 0; i < this.length; i = i + 1) {
            joined = joined + reflection_separator(i) + reflection_text(this.items[i].name);
        }
        return joined;
    }
}
