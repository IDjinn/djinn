struct FieldList {
    FieldInfo* items;
    i32 length;
}
struct MethodList {
    MethodInfo* items;
    i32 length;
}
struct PropertyInfo {
    i8* name;
    i32 typeId;
    MethodInfo* getter;
    MethodInfo* setter;
}
struct PropertyList {
    PropertyInfo* items;
    i32 length;
}
struct AttributeList {
    AttributeInfo* items;
    i32 length;
}
struct NameList {
    i8** items;
    i32 length;
}
