namespace std::types;

// Text helpers on the web target, where str and string are JS strings.
struct Texts {
    [Js("String($0)")]
    public static str of_int(i64 value) {
        return "";
    }

    [Js("$0.trim()")]
    public static str trim(str text) {
        return text;
    }

    [Js("$0.toUpperCase()")]
    public static str upper(str text) {
        return text;
    }

    [Js("$0.toLowerCase()")]
    public static str lower(str text) {
        return text;
    }

    [Js("$0.includes($1)")]
    public static bool contains(str text, str part) {
        return false;
    }

    [Js("$0.startsWith($1)")]
    public static bool starts_with(str text, str prefix) {
        return false;
    }

    [Js("$0.slice($1, $2)")]
    public static str slice(str text, i32 start, i32 end) {
        return text;
    }

    [Js("($0 + $1)")]
    public static str concat(str left, str right) {
        return left;
    }

    [Js("(parseInt($0, 10) | 0)")]
    public static i32 parse_i32(str text) {
        return 0;
    }
}
