namespace std::math;

// Math on the web target, in the namespace the native std declares it in.
struct Math {
    [Js("Math.sqrt($0)")]
    public static f64 sqrt(f64 value) {
        return value;
    }

    [Js("Math.floor($0)")]
    public static f64 floor(f64 value) {
        return value;
    }

    [Js("Math.round($0)")]
    public static f64 round(f64 value) {
        return value;
    }

    [Js("Math.abs($0)")]
    public static T abs<T>(T value) {
        return value;
    }

    [Js("Math.min($0, $1)")]
    public static T min<T>(T a, T b) {
        return a;
    }

    [Js("Math.max($0, $1)")]
    public static T max<T>(T a, T b) {
        return a;
    }

    [Js("Math.random()")]
    public static f64 random() {
        return 0.0;
    }
}
