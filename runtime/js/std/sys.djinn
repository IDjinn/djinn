namespace std::sys;

// The std on the web target: each function is a [Js] template the compiler inlines at the call.
struct Console {
    [Js("$write($format($*))")]
    public static void writeSync(str format, ...args) {
    }

    [Js("$write($format($*))")]
    public static void write(str format, ...args) {
    }

    [Js("$write($0 + \"\n\")")]
    public static void print_line(str text) {
    }
}

struct Clock {
    [Js("performance.now()")]
    public static f64 now_ms() {
        return 0.0;
    }
}
