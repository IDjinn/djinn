namespace std::sys;

// The std on the web target: each function is a [Js] template the compiler inlines at the call.
struct Console {
    [Js("$write($format($*))")]
    public static void writeSync(str format, ...args) {
    }

    [Js("$write($format($*))")]
    public static void write(str format, ...args) {
    }

    [Js("$write($0 + \"\n\")")]
    public static void print_line(str text) {
    }
}

struct Math {
    [Js("Math.sqrt($0)")]
    public static f64 sqrt(f64 value) {
        return value;
    }

    [Js("Math.abs($0)")]
    public static f64 abs(f64 value) {
        return value;
    }

    [Js("Math.floor($0)")]
    public static f64 floor(f64 value) {
        return value;
    }

    [Js("Math.round($0)")]
    public static f64 round(f64 value) {
        return value;
    }

    [Js("Math.min($0, $1)")]
    public static f64 min(f64 a, f64 b) {
        return a;
    }

    [Js("Math.max($0, $1)")]
    public static f64 max(f64 a, f64 b) {
        return a;
    }

    [Js("Math.random()")]
    public static f64 random() {
        return 0.0;
    }
}

struct Clock {
    [Js("performance.now()")]
    public static f64 now_ms() {
        return 0.0;
    }
}
