namespace std::collections;

// A view of items: a JS array on the web target ('data' does not exist there).
struct slice<T> {
    T* data;
    u32 length;

    [Js("$this[$0]")]
    operator get[](slice<T> view, u32 index) -> T {
        unsafe {
            return view.data[index];
        }
    }

    public bool is_empty() {
        return this.length == 0;
    }
}

// Arrays on the web target are JS arrays: these build new ones, so a signal holding one sees a new value.
struct Arrays {
    [Js("[...$0, $1]")]
    public static slice<T> append<T>(slice<T> items, T item) {
        return items;
    }

    [Js("$0.filter((_, at) => at !== $1)")]
    public static slice<T> remove_at<T>(slice<T> items, i32 index) {
        return items;
    }

    [Js("$0.map((item, at) => at === $1 ? $2 : item)")]
    public static slice<T> replace_at<T>(slice<T> items, i32 index, T item) {
        return items;
    }

    [Js("[]")]
    public static slice<T> empty<T>() {
        mut slice<T> none = Arrays.empty<T>();
        return none;
    }
}
