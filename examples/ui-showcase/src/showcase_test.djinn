import ui;
import testing;
import std::types;
import std::collections;

namespace showcase;

struct ShowcaseTests {
    [Test]
    unsafe void counter_clicks_touch_only_what_changed() {
        Counter counter = { .start = 1 };
        Mounted app = App.mount<Counter>(counter);
        Dom.record();
        Dom.dispatch(Dom.find(app.node.id, "inc"), "click");
        Expect.equal(4, (i64)Dom.operation_count(), "the number, then the even/odd branch: build the new one, remove the old, insert the new");
        Dom.record();
        Dom.dispatch(Dom.find(app.node.id, "reset"), "click");
        Dom.dispatch(Dom.find(app.node.id, "inc"), "click");
        mut ui::TextBuffer html = Html.render(app.node, false);
        Expect.contains(html.data, "<output id=\"count\">1</output>");
        Expect.contains(html.data, "<small>odd</small>");
        app.unmount();
    }

    [Test]
    unsafe void hydration_markers_only_in_hydrate_mode() {
        Counter counter = { .start = 0 };
        mut ui::TextBuffer server = App.render_to_string<Counter>(counter, RenderMode.SERVER);
        mut ui::TextBuffer hydrate = App.render_to_string<Counter>(counter, RenderMode.HYDRATE);
        Expect.is_false(Text.contains(server.data, "data-dj"));
        Expect.contains(hydrate.data, "data-dj=");
        Expect.contains(hydrate.data, "<!--[-->");
    }

    [Test]
    unsafe void server_render_leaves_nothing_behind() {
        u32 nodes = Reactive.live();
        u32 elements = Dom.live();
        Showcase page = Showcase();
        mut ui::TextBuffer first = App.render_to_string<Showcase>(page, RenderMode.SERVER);
        mut ui::TextBuffer second = App.render_to_string<Showcase>(page, RenderMode.SERVER);
        Expect.equal_text(first.data, second.data);
        Expect.equal((i64)nodes, (i64)Reactive.live());
        Expect.equal((i64)elements, (i64)Dom.live());
        Expect.equal(1, (i64)StaticPages.renders(), "the [Static] footer rendered once for both requests");
    }
}

struct ThemeShowcaseTests {
    [Test]
    unsafe void the_default_theme_styles_the_page_in_both_modes() {
        Counter counter = { .start = 0 };
        Mounted app = App.mount<Counter>(counter);
        u32 increment = Dom.find(app.node.id, "inc");
        Expect.equal_text("#f6f7f9", Colors.format(Styles.of(increment).background).data);
        Theme.set(ThemeMode.DARK);
        Expect.equal_text("#171a21", Colors.format(Styles.of(increment).background).data);
        Expect.equal_text("#e6e9ee", Colors.format(Styles.of(increment).color).data);
        Dom.set_state(increment, ui::NodeState.HOVER, true);
        Expect.equal_text("#1f232c", Colors.format(Styles.of(increment).background).data);
        app.unmount();
    }
}

// The page lays out for a phone and for a desktop from the same markup: the theme's classes reflow by the space
// they get.
struct LayoutShowcaseTests {
    // The 'nth' element under 'root' whose class attribute is exactly 'name' (0 when there is none).
    static unsafe u32 with_class(u32 root, str name, u32* nth) {
        if (Dom.kind(root) == DomKind.ELEMENT && Texts.same(Dom.attr(root, "class"), name)) {
            if (nth[0] == 0) {
                return root;
            }
            nth[0] = nth[0] - 1;
        }
        mut u32 child = Dom.first_child(root);
        while (child != 0) {
            u32 found = LayoutShowcaseTests.with_class(child, name, nth);
            if (found != 0) {
                return found;
            }
            child = Dom.next_sibling(child);
        }
        return 0;
    }

    static unsafe u32 card(u32 index) {
        mut u32 nth = index;
        return LayoutShowcaseTests.with_class(Dom.document(), "card stack", &nth);
    }

    // The right edge of the widest box under 'root'.
    static unsafe f32 reach(u32 root) {
        mut f32 widest = (f32)0.0;
        LayoutBox* box = Layout.box(root);
        if (box.visible) {
            widest = box.left + box.width;
        }
        mut u32 child = Dom.first_child(root);
        while (child != 0) {
            f32 inner = LayoutShowcaseTests.reach(child);
            if (inner > widest) {
                widest = inner;
            }
            child = Dom.next_sibling(child);
        }
        return widest;
    }

    [Test]
    unsafe void the_page_reflows_from_desktop_to_phone() {
        Showcase page = Showcase();
        Mounted app = App.mount<Showcase>(page);
        Layout.compute(Dom.document(), (f32)1280.0, (f32)800.0);
        mut Rect first = Layout.rect(LayoutShowcaseTests.card(0));
        mut Rect second = Layout.rect(LayoutShowcaseTests.card(1));
        Expect.is_true(second.x > first.x + first.width - (f32)1.0, "on a desktop the cards are side by side");
        Expect.is_true(second.y == first.y);
        Expect.is_true(first.height == second.height, "and as tall as each other");
        Expect.is_true(Layout.rect(app.node.id).x > (f32)60.0, "the page is centered with room around it");

        Layout.compute(Dom.document(), (f32)360.0, (f32)640.0);
        first = Layout.rect(LayoutShowcaseTests.card(0));
        second = Layout.rect(LayoutShowcaseTests.card(1));
        Expect.is_true(second.x == first.x, "on a phone they stack");
        Expect.is_true(second.y > first.y + first.height);
        Expect.equal(326, (i64)first.width, "the full width, less the fluid gutter (17px at this size) on each side");
        Expect.is_true(LayoutShowcaseTests.reach(Dom.document()) <= (f32)360.5, "and nothing overflows the screen");

        Styles.set_text_scale(2.0);
        Layout.compute(Dom.document(), (f32)360.0, (f32)640.0);
        Expect.is_true(LayoutShowcaseTests.reach(Dom.document()) <= (f32)360.5, "even with the text twice as large");
        app.unmount();
    }
}
