import ui;
import std::types;
import std::collections;
import std::libc;

namespace showcase;

[Application(render: server)]
struct Showcase {
    public unsafe Node render() {
        Task* tasks = (Task*)__djinn_alloc_zeroed((size_long)(3 * sizeof(Task)));
        Task write = { .id = 1, .title = "write the core", .done = true };
        Task test = { .id = 2, .title = "test every host", .done = false };
        Task ship = { .id = 3, .title = "ship the kit", .done = false };
        tasks[0] = write;
        tasks[1] = test;
        tasks[2] = ship;
        slice<Task> list = { .data = tasks, .length = 3 };
        return html!{
            <main class="p-4 flex flex-col gap-2">
                <h1>Djinn UI showcase</h1>
                <p>Running on {Greeting.platform()}.</p>
                <Card title="Components">
                    <Badge label="open" count={2}/>
                    <Counter start={4}/>
                </Card>
                <Card title="Lists">
                    <TaskList tasks={list}/>
                    <ol>{for (i32 i in 1..4) { <li>step {i}</li> }}</ol>
                </Card>
                <Report quarter="Q3"/>
                <Untrusted comment="<script>alert('x')</script> & more" link="javascript:alert(1)"/>
                <Footer/>
            </main>
        };
    }
}
