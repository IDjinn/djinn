import ui;
import std::types;
import std::collections;

namespace showcase;

struct Task {
    i64 id;
    str title;
    bool done;

    public str css() {
        if (this.done) {
            return "task done";
        }
        return "task";
    }
}

// A component: props are fields, render() runs once, '{expr}' parts update on their own.
struct Badge {
    str label;
    i32 count;

    public unsafe Node render() {
        return html!{ <span class="badge">{this.label}: {this.count}</span> };
    }
}

// Children are passed as a Node field named 'children'.
struct Card {
    str title;
    Node children;

    public unsafe Node render() {
        return html!{
            <section class="card">
                <h2>{this.title}</h2>
                {this.children}
            </section>
        };
    }
}

// State lives in locals of render(): a signal is a u32 handle captured by the closures.
struct Counter {
    i32 start;

    public unsafe Node render() {
        signal<i32> count = state(this.start);
        memo<bool> even = derived<bool>(() => count.get() % 2 == 0);
        return html!{
            <div class="counter">
                <output id="count">{count}</output>
                <button id="inc" on_click={() => count.set(count.get() + 1)}>+</button>
                <button id="reset" onClick={() => count.set(0)}>reset</button>
                {if (even.get()) { <small>even</small> } else { <small>odd</small> }}
            </div>
        };
    }
}

struct TaskList {
    slice<Task> tasks;

    public unsafe Node render() {
        slice<Task> all = this.tasks;
        return html!{
            <ul class="tasks">
                {for (Task task in all) key(task.id) {
                    <li class={task.css()}>{task.title}</li>
                }}
            </ul>
        };
    }
}

// Rendered with the page; on the web build it is a placeholder for the server's HTML.
[Server]
struct Report {
    str quarter;

    public unsafe Node render() {
        return html!{ <article><h2>Report {this.quarter}</h2><LikeButton likes={3}/></article> };
    }
}

// An island: inside a server-rendered page, the only part the client hydrates.
[Client]
struct LikeButton {
    i32 likes;

    public unsafe Node render() {
        signal<i32> count = state(this.likes);
        return html!{ <button on_click={() => count.set(count.get() + 1)}>{count} likes</button> };
    }
}

// Rendered once, the same HTML shared by every request that shows it.
[Static]
struct Footer {
    public unsafe Node render() {
        return html!{ <footer>Made with Djinn UI</footer> };
    }
}

// Hostile text is escaped and dangerous URLs are replaced; listeners are never written as attributes.
struct Untrusted {
    str comment;
    str link;

    public unsafe Node render() {
        return html!{ <blockquote><p>{this.comment}</p><a href={this.link}>link</a></blockquote> };
    }
}
