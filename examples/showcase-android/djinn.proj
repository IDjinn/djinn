project: "showcase-android"
version: "0.1.0"

compiler:
  library-mode: false
  targets: [android]

  output:
    file: "libshowcase-android.so"
    directory: "build"

  # the pages are the ones of examples/showcase, written once; only the host entry point lives here
  sources: [
    '../showcase/src/app.djinn',
    '../showcase/src/virtual.djinn',
    '../showcase/src/motion.djinn'
  ]

  libs: [
    'std',
    'ui_macros',
    'ui',
    'spirv',
    'vulkan',
    'android'
  ]

# Android app metadata (read by the VS Code extension and tools/android_build.sh callers)
android:
  package: "dev.djinn.showcase"
  label: "Djinn Showcase"
  min-api: 26
