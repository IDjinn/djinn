project: "android-hello"
version: "0.1.0"

compiler:
  library-mode: false
  targets: [android]

  output:
    file: "libandroid-hello.so"
    directory: "build"

  libs: [
    'std',
    'ui_macros',
    'ui',
    'spirv',
    'vulkan',
    'android'
  ]

# Android app metadata (read by the VS Code extension and tools/android_build.sh callers)
android:
  package: "dev.djinn.hello"
  label: "Djinn Hello"
  min-api: 26
