import ui;
import android;
import std::types;
import std::libc;

namespace hello;

struct Counter {
    i32 start;

    public unsafe Node render() {
        signal<i32> count = state(this.start);
        return html!{
            <div class="counter cluster">
                <output id="count">{count}</output>
                <button id="inc" on_click={() => count.set(count.get() + 1)}>+</button>
                <button id="reset" on_click={() => count.set(0)}>reset</button>
            </div>
        };
    }
}

// The same html! source every host draws, here on Android: the activity loads this library, the runtime shim calls
// main on the app thread and the host runs the frame loop until the activity is destroyed.
struct Hello {
    i32 unused;

    public unsafe Node render() {
        // a field bound to a signal both ways, echoed below it: typing must keep the caret and lose no character
        signal<str> name = state<str>("");
        return html!{
            <main class="page stack">
                <h1>Djinn on Android</h1>
                <p>One html! and css! source, drawn by the framework.</p>
                <section class="card stack">
                    <h2>Counter</h2>
                    <Counter start={0}/>
                </section>
                <input id="field" placeholder="Type here"/>
                <Field label="Bound" kind="text" placeholder="bound to a signal" value={name}/>
                <output id="echo">{name}</output>
                <ol>{for (i32 i in 1..41) { <li>row {i}</li> }}</ol>
            </main>
        };
    }
}

unsafe i32 main() {
    Hello app = { .unused = 0 };
    return AndroidHost.run<Hello>(app);
}
