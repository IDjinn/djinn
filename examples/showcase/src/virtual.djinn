import ui;
import std::types;

namespace showcase;

// A hundred thousand rows with only the ones in view mounted: native hosts (Windows, Android).
struct VirtualPage {
    i32 unused;

    static unsafe Node line(i32 index) {
        return html!{ <span>Virtual row number {index}</span> };
    }

    public unsafe Node render() {
        return html!{
            <section class="card stack">
                <h2>Virtual list</h2>
                <p>Rows are built when they scroll into view and dropped when they leave, so the list costs the same at any length.</p>
                <VirtualList count={100000} item_height={40} height={360} row={(i32 i) => VirtualPage.line(i)}/>
            </section>
        };
    }
}
