import ui;
import std::types;
import std::libc;

namespace showcase;

// Other platforms (no native host yet): print the page.
unsafe i32 main() {
    Showcase app = { .unused = 0 };
    TextBuffer html = App.render_to_string<Showcase>(app, RenderMode.CLIENT);
    printf("%.*s\n", (i32)html.length, html.data);
    return 0;
}
