import ui;
import std::types;

namespace showcase;

unsafe static mut bool motion_styled = false;

// CSS animations and transitions, the same sheet natively and in the browser: keyframes on opacity and transform,
// a transition on colors, and the skeleton pulse of the kit.
struct MotionLook {
    static str css() {
        return css!{
            @keyframes showcase-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
            @keyframes showcase-slide { from { transform: translateX(0px); } to { transform: translateX(160px); } }
            @keyframes showcase-pop { 0% { transform: scale(0.4); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
            @keyframes showcase-breathe { from { opacity: 1; } to { opacity: 0.25; } }
            .motion-stage { display: flex; align-items: center; gap: 24px; min-height: 64px; }
            .spinner { width: 40px; height: 40px; border-radius: 8px; background-color: #3b82f6; animation: showcase-spin 1200ms linear infinite; }
            .slider { width: 32px; height: 32px; border-radius: 16px; background-color: #ec4899; animation: showcase-slide 900ms infinite alternate; }
            .popper, .popper.again { width: 48px; height: 48px; border-radius: 12px; background-color: #10b981; animation: showcase-pop 1500ms forwards; }
            .breather { width: 48px; height: 24px; border-radius: 12px; background-color: #f59e0b; animation: showcase-breathe 1000ms infinite alternate; }
            .fader { width: 96px; height: 40px; border-radius: 8px; background-color: #10b981; transition: background-color 400ms; }
            .fader[data-on="true"] { background-color: #f59e0b; }
        };
    }

    public static unsafe void install() {
        if (!motion_styled) {
            Styles.add(MotionLook.css());
            motion_styled = true;
        }
    }
}

struct MotionPage {
    i32 unused;

    public unsafe Node render() {
        MotionLook.install();
        signal<bool> on = state(false);
        signal<bool> running = state(true);
        signal<bool> flip = state(false);
        return html!{
            <div class="stack">
                <section class="card stack">
                    <h2>Keyframes</h2>
                    <p>Rotate, translate, scale and opacity run from @keyframes without laying the page out again.</p>
                    <div class="cluster"><Button label="Start / stop the loops" variant="" on_click={() => running.set(!running.get())}/></div>
                    {if (running.get()) {
                        <div class="motion-stage" id="loops">
                            <div class="spinner"></div>
                            <div class="slider"></div>
                            <div class="breather"></div>
                        </div>
                    } else {
                        <div class="motion-stage" id="loops"><small class="muted">stopped: a hidden animation costs nothing</small></div>
                    }}
                </section>
                <section class="card stack">
                    <h2>Once, forwards</h2>
                    <p>The box pops in when it is created and stays at the end of the animation. Replay builds a new one.</p>
                    <div class="cluster"><Button label="Replay" variant="" on_click={() => flip.set(!flip.get())}/></div>
                    <div class="motion-stage" id="pop">
                        {if (flip.get()) {
                            <div class="popper again"></div>
                        } else {
                            <div class="popper"></div>
                        }}
                    </div>
                </section>
                <section class="card stack">
                    <h2>Transition</h2>
                    <div class="cluster">
                        <div class="fader" id="fader" data-on={Kit.flag(on.get())}></div>
                        <Button label="Change color" variant="" on_click={() => on.set(!on.get())}/>
                    </div>
                    <h2>Skeleton</h2>
                    <Skeleton wide={true} pulse={true}/>
                </section>
            </div>
        };
    }
}
