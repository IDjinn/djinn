import ui;
import win32;
import std::types;
import std::libc;
import std::sys;

namespace showcase;

// Windows: a native window drawn by the framework. For checks without a window:
//   --html [route]          prints the tree the app built, as HTML (what tests/web/js/showcase.mjs compares)
//   DJINN_UI_SHOT=file.ppm  renders one frame of DJINN_UI_ROUTE (default "/") at 900 x DJINN_UI_H (default 900)
unsafe i32 main() {
    Showcase app = { .unused = 0 };
    Arguments arguments = Process.arguments().arguments;
    if (arguments.get(0) is Value flag && flag == "--html") {
        if (arguments.get(1) is Value route) {
            Router.start(route);
        }
        TextBuffer html = App.render_to_string<Showcase>(app, RenderMode.CLIENT);
        printf("%.*s\n", (i32)html.length, html.data);
        return 0;
    }
    i8* shot = getenv("DJINN_UI_SHOT");
    if (shot != (i8*)0) {
        i8* route = getenv("DJINN_UI_ROUTE");
        if (route != (i8*)0) {
            str path = { .data = route, .length = (size)strlen(route) };
            Router.start(path);
        }
        mut u32 tall = 900;
        i8* height = getenv("DJINN_UI_H");
        if (height != (i8*)0) {
            tall = (u32)atoi(height);
        }
        return WinHost.shot<Showcase>(app, 900, tall, shot, (f32)-1.0, (f32)-1.0);
    }
    // DJINN_UI_ROUTE also picks the page the window opens on
    i8* start = getenv("DJINN_UI_ROUTE");
    if (start != (i8*)0) {
        str first = { .data = start, .length = (size)strlen(start) };
        Router.start(first);
    }
    return WinHost.run<Showcase>(app, "Djinn UI showcase", 900, 720);
}
