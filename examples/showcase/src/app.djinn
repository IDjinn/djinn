import ui;
import std::types;

namespace showcase;

// The front end, written once. main.windows.djinn opens it in a native window (Vulkan, or the software rasterizer)
// and main.web.djinn runs it in the browser as JavaScript; both build the same tree from this file.

unsafe static mut bool showcase_styled = false;

struct Look {
    static str css() {
        return css!{
            .swatches { display: flex; gap: 8px; }
            .swatch { width: 48px; height: 32px; border-radius: 8px; }
            .swatch.a { background-color: #3b82f6; }
            .swatch.b { background-color: #ec4899; }
            .swatch.c { background-color: #10b981; }
            .swatch.d { background-color: #f59e0b; }
        };
    }

    public static unsafe void install() {
        if (!showcase_styled) {
            Styles.add(Look.css());
            showcase_styled = true;
        }
    }
}

struct Counter {
    i32 start;

    public unsafe Node render() {
        signal<i32> count = state(this.start);
        memo<bool> even = derived<bool>(() => count.get() % 2 == 0);
        return html!{
            <div class="counter cluster">
                <output id="count">{count}</output>
                <button id="inc" on_click={() => count.set(count.get() + 1)}>+</button>
                <button id="reset" on_click={() => count.set(0)}>reset</button>
                {if (even.get()) { <small id="parity">even</small> } else { <small id="parity">odd</small> }}
            </div>
        };
    }
}

struct Overview {
    i32 unused;

    public unsafe Node render() {
        signal<i32> rows = state(3);
        return html!{
            <div class="stack">
                <section class="card stack">
                    <h2>Counter</h2>
                    <p>A signal, a memo and an if: only the text that changed is touched.</p>
                    <Counter start={4}/>
                </section>
                <section class="card stack">
                    <h2>Loops</h2>
                    <div class="cluster">
                        <button id="more" on_click={() => rows.set(rows.get() + 1)}>more</button>
                        <button id="less" on_click={() => rows.set(rows.get() - 1)}>less</button>
                    </div>
                    <ol id="squares">{for (i32 i in 0..rows.get()) { <li>{i} squared is {i * i}</li> }}</ol>
                </section>
                <section class="card stack">
                    <h2>Own styles</h2>
                    <p>A stylesheet added by the app, applied by the native engine and by the browser.</p>
                    <div class="swatches">
                        <div class="swatch a"></div>
                        <div class="swatch b"></div>
                        <div class="swatch c"></div>
                        <div class="swatch d"></div>
                    </div>
                </section>
            </div>
        };
    }
}

struct Components {
    i32 unused;

    public unsafe Node render() {
        signal<bool> wifi = state(true);
        signal<bool> news = state(false);
        signal<i32> tab = state(0);
        signal<bool> open = state(false);
        signal<i32> size = state(1);
        signal<i32> last = state(-1);
        signal<bool> bold = state(false);
        signal<i32> radio = state(1);
        signal<bool> confirm = state(false);
        signal<bool> sheet = state(false);
        signal<i32> page = state(0);
        signal<i32> volume = state(40);
        signal<str> bio = state("");
        signal<i32> deleted = state(0);
        return html!{
            <div class="stack">
                <section class="card stack">
                    <h2>Kit</h2>
                    <div class="cluster">
                        <Button label="Primary" variant="primary" on_click={() => open.set(true)}/>
                        <Button label="Danger" variant="danger" on_click={() => news.set(false)}/>
                        <Switch label="Wi-Fi" on={wifi}/>
                        <Checkbox label="Newsletter" checked={news}/>
                    </div>
                    <div class="cluster" role="tablist">
                        <Tab label="Account" index={0} active={tab}/>
                        <Tab label="Security" index={1} active={tab}/>
                    </div>
                    <TabPanel index={0} active={tab}><Field label="Name" hint="As on your card" placeholder="Ada Lovelace" kind="text"/></TabPanel>
                    <TabPanel index={1} active={tab}><Field label="Password" hint="At least 12 characters" placeholder="secret" kind="password"/></TabPanel>
                    <Dialog title="Are you sure?" open={open}><p>This is a modal dialog.</p></Dialog>
                </section>
                <section class="card stack">
                    <h2>Select, menu and tooltip</h2>
                    <div class="cluster">
                        <Select label="Size" options="Small|Medium|Large|Extra large" index={size}/>
                        <Menu label="File" items="Open|Save|Save as|Quit" on_pick={(i32 i) => last.set(i)}/>
                        <Tooltip text="Opens the command menu"><button>Hover me</button></Tooltip>
                    </div>
                    <p>Size: {Choices.nth("Small|Medium|Large|Extra large", size.get())}. Last command: {last}.</p>
                </section>
                <section class="card stack">
                    <h2>More components</h2>
                    <Card>
                        <CardHeader><CardTitle>Project</CardTitle><CardDescription>Everything in one place.</CardDescription></CardHeader>
                        <CardContent>
                            <div class="cluster"><Avatar initials="AL"/><Badge label="New" variant=""/><Badge label="Beta" variant="outline"/><Kbd keys="Ctrl K"/></div>
                            <Progress value={65}/>
                        </CardContent>
                        <CardFooter><Toggle label="Bold" variant="outline" pressed={bold}/></CardFooter>
                    </Card>
                    <Alert title="Heads up" description="You can restyle all of this with tokens." variant=""/>
                    <Alert title="Error" description="Something went wrong." variant="destructive"/>
                    <Separator vertical={false}/>
                    <RadioGroup label="Plan" options="Free|Pro|Team" index={radio}/>
                    <AccordionItem title="Is it accessible?" open={true}><p>Yes, it follows the WAI-ARIA patterns.</p></AccordionItem>
                    <Breadcrumb items="Home|Components|Showcase"/>
                    <Skeleton wide={true} pulse={false}/>
                    <Collapsible title="Can I collapse this?" open={false}><p>Yes, it opens and closes on its button.</p></Collapsible>
                    <div class="cluster">
                        <Popover label="Open popover"><p>Any content can go here.</p></Popover>
                        <button on_click={() => confirm.set(true)}>Delete account</button>
                        <button on_click={() => sheet.set(true)}>Open sheet</button>
                        <small class="muted">Deleted {deleted} times</small>
                    </div>
                    <AlertDialog title="Are you absolutely sure?" description="This action cannot be undone." confirm="Delete"
                                 open={confirm} on_confirm={() => deleted.set(deleted.get() + 1)}/>
                    <Sheet title="Edit profile" side="right" open={sheet}>
                        <Textarea label="Bio" hint="A few words" placeholder="Tell us about you" value={bio}/>
                    </Sheet>
                    <Label text="Volume"/>
                    <Slider label="Volume" value={volume}/>
                    <small class="muted">Volume {volume}</small>
                    <Textarea label="Notes" hint="Multi-line on the web, one line natively for now" placeholder="Write here" value={bio}/>
                    <Pagination pages={5} page={page}/>
                </section>
            </div>
        };
    }
}

struct Data {
    i32 unused;

    public unsafe Node render() {
        return html!{
            <section class="card stack">
                <h2>List</h2>
                <List>
                    {for (i32 n in 0..12) { <Item>Row number {n}</Item> }}
                </List>
                <h2>Table</h2>
                <Table>
                    <Row header={true}><span>Name</span><span>Kind</span><span>Size</span></Row>
                    {for (i32 n in 0..8) { <Row header={false}><span>file{n}.djinn</span><span>source</span><span>{n}KB</span></Row> }}
                </Table>
            </section>
        };
    }
}

struct Routing {
    i32 unused;

    static unsafe Node page(str path) {
        if (Router.matches("/routing/settings", path)) {
            return html!{ <p id="sub">Settings page.</p> };
        }
        if (Router.matches("/routing/users/:id", path)) {
            return html!{ <p id="sub">User {Router.param("/routing/users/:id", path, "id")}</p> };
        }
        return html!{ <p id="sub">Routing home.</p> };
    }

    public unsafe Node render() {
        return html!{
            <section class="card stack">
                <h2>Router</h2>
                <nav class="cluster">
                    <Link to="/routing" label="Home"/>
                    <Link to="/routing/settings" label="Settings"/>
                    <Link to="/routing/users/42" label="User 42"/>
                    <Button label="Back" variant="" on_click={() => Router.back()}/>
                </nav>
                <Outlet view={(str path) => Routing.page(path)}/>
            </section>
        };
    }
}

struct Showcase {
    i32 unused;

    static unsafe Node page(str path) {
        if (Router.matches("/components", path)) {
            return html!{ <Components unused={0}/> };
        }
        if (Router.matches("/data", path)) {
            return html!{ <Data unused={0}/> };
        }
        if (Router.matches("/virtual", path)) {
            return html!{ <VirtualPage unused={0}/> };
        }
        if (Router.matches("/motion", path)) {
            return html!{ <MotionPage unused={0}/> };
        }
        if (Router.matches("/navigation/*", path) || Router.matches("/navigation", path)) {
            return html!{ <NavigationPage unused={0}/> };
        }
        if (Router.matches("/routing/*", path)) {
            return html!{ <Routing unused={0}/> };
        }
        return html!{ <Overview unused={0}/> };
    }

    public unsafe Node render() {
        Look.install();
        return html!{
            <main class="page stack">
                <h1>Djinn UI</h1>
                <p>One source: a native window and a web page.</p>
                <div class="cluster"><Button label="Light / dark" variant="" on_click={() => Theme.toggle()}/></div>
                <Navigator routes="/=Overview|/components=Components|/data=List and table|/virtual=Virtual list|/motion=Motion|/routing=Routing|/navigation=Navigation"/>
                <Outlet groups="/navigation/*|/routing/*" view={(str path) => Showcase.page(path)}/>
            </main>
        };
    }
}
