import ui;
import std::types;

namespace showcase;

// The navigation kit: a menu (Drawer), a stack of screens with a Back button (Stack), tabs (TabBar) and a wizard
// (Stepper). The look is the same natively and on the web; only the arrangement follows the width of the window.
// Hover or focus a link and its page is prepared ahead of time (Prefetch); Prefetch.enable(false) turns that off.
struct NavigationPage {
    i32 unused;

    static unsafe Node screen(str path) {
        if (Router.matches("/navigation/inbox", path)) {
            return html!{ <p id="screen">Inbox: three new messages.</p> };
        }
        if (Router.matches("/navigation/settings", path)) {
            return html!{ <p id="screen">Settings: nothing to change yet.</p> };
        }
        return html!{ <p id="screen">Home: pick a place in the menu or in the tabs.</p> };
    }

    public unsafe Node render() {
        signal<bool> open = state(false);
        signal<bool> collapsed = state(false);
        signal<i32> step = state(0);
        signal<bool> can_next = state(false);
        signal<str> name = state("");
        signal<bool> finished = state(false);
        effect(() => can_next.set(step.get() > 0 || name.get().length > 0));
        return html!{
            <div class="stack">
                <section class="card stack">
                    <h2>Menu, stack and tabs</h2>
                    <p>Alt+Left goes back (Command and the left bracket on a Mac), Ctrl+B or Command+B toggles the menu, the arrows walk the tabs.</p>
                    <Drawer title="Demo" routes="/navigation=Home|/navigation/inbox=Inbox|/navigation/settings=Settings"
                            open={open} collapsed={collapsed}>
                        <Stack titles="/navigation=Home|/navigation/inbox=Inbox|/navigation/settings=Settings">
                            <Outlet view={(str path) => NavigationPage.screen(path)}/>
                        </Stack>
                        <TabBar routes="/navigation=Home|/navigation/inbox=Inbox|/navigation/settings=Settings"/>
                    </Drawer>
                </section>
                <section class="card stack">
                    <h2>Wizard</h2>
                    <Stepper steps="Account|Details|Review" finish="Create" step={step} can_next={can_next}
                             on_finish={() => finished.set(true)}>
                        <Step index={0} step={step}>
                            <Field label="Name" hint="Needed to go on" placeholder="Ada Lovelace" kind="text" value={name}/>
                        </Step>
                        <Step index={1} step={step}><p>Anything else the account needs.</p></Step>
                        <Step index={2} step={step}><p>Check everything and create it.</p></Step>
                    </Stepper>
                    <small id="created" class="muted">{if (finished.get()) { <span>Created.</span> } else { <span>Not created yet.</span> }}</small>
                </section>
            </div>
        };
    }
}
