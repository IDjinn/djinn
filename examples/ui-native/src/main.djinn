import ui;
import win32;
import std::types;
import std::libc;

namespace native;

// A native window in client mode: the page is built here, in the process, and a click runs the same handlers a
// browser would. Set DJINN_UI_SHOT to a file name to render one frame to a PPM image instead of opening a window.
struct Counter {
    i32 start;

    public unsafe Node render() {
        signal<i32> count = state(this.start);
        memo<bool> even = derived<bool>(() => count.get() % 2 == 0);
        return html!{
            <div class="counter cluster">
                <output id="count">{count}</output>
                <button id="inc" on_click={() => count.set(count.get() + 1)}>+</button>
                <button id="reset" onClick={() => count.set(0)}>reset</button>
                {if (even.get()) { <small>even</small> } else { <small>odd</small> }}
            </div>
        };
    }
}

// Keyboard and focus: Tab and Shift+Tab walk these controls (the disabled button and the tabindex=-1 box are skipped),
// Enter or Space press the focused button, Enter follows a link, Escape blurs. The page listens for keydown on the way
// up and shows the last key code (Windows virtual-key values).
struct Keyboard {
    i32 unused;

    public unsafe Node render() {
        signal<i32> last = state(0);
        signal<i32> presses = state(0);
        return html!{
            <section class="card stack" on_keydown={() => last.set(Input.key())}>
                <h2>Focus and keyboard</h2>
                <p>Tab and Shift+Tab move focus, Enter or Space press a button, Escape blurs.</p>
                <div class="cluster">
                    <button id="first" on_click={() => presses.set(presses.get() + 1)}>Press me</button>
                    <button id="off" disabled="">Disabled</button>
                    <a id="docs" href="/docs">A link</a>
                    <div id="box" tabindex="0">Focusable box</div>
                    <div id="skip" tabindex="-1">Skipped by Tab</div>
                    <input id="field" placeholder="Type here"/>
                </div>
                <p>Presses: {presses}. Last key code: {last}.</p>
            </section>
        };
    }
}

// The kit: button, switch, checkbox, tabs, dialog and a labelled field.
struct Kit {
    i32 unused;

    public unsafe Node render() {
        signal<bool> wifi = state(true);
        signal<bool> news = state(false);
        signal<i32> tab = state(0);
        signal<bool> open = state(false);
        return html!{
            <section class="card stack">
                <h2>Kit</h2>
                <div class="cluster">
                    <Button label="Primary" variant="primary" on_click={() => open.set(true)}/>
                    <Button label="Danger" variant="danger" on_click={() => news.set(false)}/>
                    <Switch label="Wi-Fi" on={wifi}/>
                    <Checkbox label="Newsletter" checked={news}/>
                </div>
                <div class="cluster" role="tablist">
                    <Tab label="Account" index={0} active={tab}/>
                    <Tab label="Security" index={1} active={tab}/>
                </div>
                <TabPanel index={0} active={tab}><Field label="Name" hint="As on your card" placeholder="Ada Lovelace" kind="text"/></TabPanel>
                <TabPanel index={1} active={tab}><Field label="Password" hint="At least 12 characters" placeholder="secret" kind="password"/></TabPanel>
                <Dialog title="Are you sure?" open={open}><p>This is a modal dialog.</p></Dialog>
            </section>
        };
    }
}

// Routing: the links navigate inside the app and each new page fades in.
struct Pages {
    i32 unused;

    static unsafe Node page(str path) {
        if (Router.matches("/settings", path)) {
            return html!{ <p>Settings page. Navigation keeps one window and fades the page in.</p> };
        }
        if (Router.matches("/users/:id", path)) {
            return html!{ <p>User {Router.param("/users/:id", path, "id")}</p> };
        }
        return html!{ <p>Home page.</p> };
    }

    public unsafe Node render() {
        return html!{
            <section class="card stack">
                <h2>Router</h2>
                <nav class="cluster">
                    <Link to="/" label="Home"/>
                    <Link to="/settings" label="Settings"/>
                    <Link to="/users/42" label="User 42"/>
                    <Button label="Back" variant="" on_click={() => Router.back()}/>
                </nav>
                <Outlet view={(str path) => Pages.page(path)}/>
            </section>
        };
    }
}

// Selection and menus: a drop-down, a command menu and a tooltip.
struct Choose {
    i32 unused;

    public unsafe Node render() {
        signal<i32> size = state(1);
        signal<i32> last = state(-1);
        signal<bool> note = state(true);
        return html!{
            <section class="card stack">
                <h2>Select, menu and tooltip</h2>
                <div class="cluster">
                    <Select label="Size" options="Small|Medium|Large|Extra large" index={size}/>
                    <Menu label="File" items="Open|Save|Save as|Quit" on_pick={(i32 i) => last.set(i)}/>
                    <Tooltip text="Opens the command menu"><button>Hover me</button></Tooltip>
                </div>
                <p>Size: {Choices.nth("Small|Medium|Large|Extra large", size.get())}. Last command: {last}.</p>
                <div class="cluster">
                    <button on_click={() => note.set(!note.get())}>Toggle note</button>
                    <Transition show={note}><small>Fades in and out.</small></Transition>
                </div>
            </section>
        };
    }
}

// Scrolling: a list and a table taller than their boxes (wheel, Page Up / Down, Home / End).
struct Data {
    i32 unused;

    static unsafe Node line(i32 index) {
        return html!{ <span>Virtual row number {index}</span> };
    }

    public unsafe Node render() {
        return html!{
            <section class="card stack">
                <h2>List</h2>
                <List>
                    {for (i32 n in 0..30) { <Item>Row number {n}</Item> }}
                </List>
                <h2>A hundred thousand rows</h2>
                <VirtualList count={100000} item_height={32} height={192} row={(i32 i) => Data.line(i)}/>
                <h2>Table</h2>
                <Table>
                    <Row header={true}><span>Name</span><span>Kind</span><span>Size</span></Row>
                    {for (i32 n in 0..24) { <Row header={false}><span>file{n}.djinn</span><span>source</span><span>{n}KB</span></Row> }}
                </Table>
            </section>
        };
    }
}

unsafe static mut bool motion_styled = false;

// Motion: looping transitions driven by a timer. Each tick flips a phase and the styles below animate towards it.
struct Motion {
    i32 unused;

    static str css() {
        return ".orb { width: 36px; height: 36px; border-radius: 18px; background-color: #3b82f6; transform: translateX(0px) scale(1); transition: transform 500ms, background-color 600ms; } .orb.b { background-color: #ec4899; transform: translateX(240px) scale(1.4); } .bar { width: 16px; height: 48px; border-radius: 8px; background-color: #f59e0b; opacity: 0.3; transform: scale(1); transition: transform 400ms, opacity 400ms; } .bar.on { opacity: 1; transform: scale(1.3); } .tint { width: 120px; height: 36px; border-radius: 10px; background-color: #10b981; opacity: 1; transition: background-color 800ms, opacity 800ms; } .tint.b { background-color: #8b5cf6; opacity: 0.6; } .tint.c { background-color: #ef4444; opacity: 0.9; } .track { width: 300px; }";
    }

    static str orb(i32 phase) {
        if (phase % 2 == 0) {
            return "orb";
        }
        return "orb b";
    }

    static str bar(i32 phase, i32 index) {
        if (phase % 5 == index) {
            return "bar on";
        }
        return "bar";
    }

    static str tint(i32 phase) {
        if (phase % 3 == 0) {
            return "tint";
        }
        if (phase % 3 == 1) {
            return "tint b";
        }
        return "tint c";
    }

    public unsafe Node render() {
        if (!motion_styled) {
            Styles.add(Motion.css());
            motion_styled = true;
        }
        signal<i32> phase = state(0);
        signal<bool> running = state(true);
        Timers.every_mounted(700, () => Motion.tick(phase, running));
        return html!{
            <section class="card stack">
                <h2>Motion</h2>
                <div class="cluster">
                    <Switch label="Running" on={running}/>
                    <button on_click={() => phase.set(phase.get() + 1)}>Step</button>
                </div>
                <div class="track"><div class={Motion.orb(phase.get())}></div></div>
                <div class="cluster">
                    {for (i32 i in 0..5) { <div class={Motion.bar(phase.get(), i)}></div> }}
                </div>
                <div class={Motion.tint(phase.get())}></div>
            </section>
        };
    }

    static unsafe void tick(signal<i32> phase, signal<bool> running) {
        if (running.get()) {
            phase.set(phase.get() + 1);
        }
    }
}

struct Home {
    i32 unused;

    public unsafe Node render() {
        return html!{
            <div class="stack">
                <section class="card stack">
                    <h2>Counter</h2>
                    <Counter start={4}/>
                </section>
                <Keyboard unused={0}/>
            </div>
        };
    }
}

struct Showcase {
    static unsafe Node page(str path) {
        if (Router.matches("/components", path)) {
            return html!{ <div class="stack"><Kit unused={0}/><Choose unused={0}/></div> };
        }
        if (Router.matches("/data", path)) {
            return html!{ <Data unused={0}/> };
        }
        if (Router.matches("/motion", path)) {
            return html!{ <Motion unused={0}/> };
        }
        if (Router.matches("/routing", path)) {
            return html!{ <Pages unused={0}/> };
        }
        return html!{ <Home unused={0}/> };
    }

    public unsafe Node render() {
        return html!{
            <main class="page stack">
                <h1>Djinn UI</h1>
                <p>A native window, drawn by the framework.</p>
                <Navigator routes="/=Overview|/components=Components|/data=List and table|/routing=Routing|/motion=Motion"/>
                <Outlet view={(str path) => Showcase.page(path)}/>
            </main>
        };
    }
}

unsafe i32 main() {
    Showcase app = { };
    i8* shot = getenv("DJINN_UI_SHOT");
    if (shot != (i8*)0) {
        i8* route = getenv("DJINN_UI_ROUTE");
        if (route != (i8*)0) {
            str path = { .data = route, .length = (size)strlen(route) };
            Router.start(path);
        }
        mut f32 click_x = (f32)-1.0;
        mut f32 click_y = (f32)-1.0;
        i8* at_x = getenv("DJINN_UI_CLICK_X");
        i8* at_y = getenv("DJINN_UI_CLICK_Y");
        if (at_x != (i8*)0 && at_y != (i8*)0) {
            click_x = digits(at_x);
            click_y = digits(at_y);
        }
        mut u32 tall = 600;
        i8* height = getenv("DJINN_UI_H");
        if (height != (i8*)0) {
            tall = (u32)digits(height);
        }
        return WinHost.shot<Showcase>(app, 900, tall, shot, click_x, click_y);
    }
    return WinHost.run<Showcase>(app, "Djinn UI", 900, 640);
}

unsafe f32 digits(i8* text) {
    mut i32 value = 0;
    mut u32 i = 0;
    while (text[i] >= 48 && text[i] <= 57) {
        value = value * 10 + ((i32)text[i] - 48);
        i = i + 1;
    }
    return (f32)value;
}
