import ui;
import win32;
import std::types;
import std::libc;

namespace native;

// A native window in client mode: the page is built here, in the process, and a click runs the same handlers a
// browser would. Set DJINN_UI_SHOT to a file name to render one frame to a PPM image instead of opening a window.
struct Counter {
    i32 start;

    public unsafe Node render() {
        signal<i32> count = state(this.start);
        memo<bool> even = derived<bool>(() => count.get() % 2 == 0);
        return html!{
            <div class="counter cluster">
                <output id="count">{count}</output>
                <button id="inc" on_click={() => count.set(count.get() + 1)}>+</button>
                <button id="reset" onClick={() => count.set(0)}>reset</button>
                {if (even.get()) { <small>even</small> } else { <small>odd</small> }}
            </div>
        };
    }
}

// Keyboard and focus: Tab and Shift+Tab walk these controls (the disabled button and the tabindex=-1 box are skipped),
// Enter or Space press the focused button, Enter follows a link, Escape blurs. The page listens for keydown on the way
// up and shows the last key code (Windows virtual-key values).
struct Keyboard {
    i32 unused;

    public unsafe Node render() {
        signal<i32> last = state(0);
        signal<i32> presses = state(0);
        return html!{
            <section class="card stack" on_keydown={() => last.set(Input.key())}>
                <h2>Focus and keyboard</h2>
                <p>Tab and Shift+Tab move focus, Enter or Space press a button, Escape blurs.</p>
                <div class="cluster">
                    <button id="first" on_click={() => presses.set(presses.get() + 1)}>Press me</button>
                    <button id="off" disabled="">Disabled</button>
                    <a id="docs" href="/docs">A link</a>
                    <div id="box" tabindex="0">Focusable box</div>
                    <div id="skip" tabindex="-1">Skipped by Tab</div>
                    <input id="field" placeholder="Type here"/>
                </div>
                <p>Presses: {presses}. Last key code: {last}.</p>
            </section>
        };
    }
}

// The kit: button, switch, checkbox, tabs, dialog and a labelled field.
struct Kit {
    i32 unused;

    public unsafe Node render() {
        signal<bool> wifi = state(true);
        signal<bool> news = state(false);
        signal<i32> tab = state(0);
        signal<bool> open = state(false);
        return html!{
            <section class="card stack">
                <h2>Kit</h2>
                <div class="cluster">
                    <Button label="Primary" variant="primary" on_click={() => open.set(true)}/>
                    <Button label="Danger" variant="danger" on_click={() => news.set(false)}/>
                    <Switch label="Wi-Fi" on={wifi}/>
                    <Checkbox label="Newsletter" checked={news}/>
                </div>
                <div class="cluster" role="tablist">
                    <Tab label="Account" index={0} active={tab}/>
                    <Tab label="Security" index={1} active={tab}/>
                </div>
                <TabPanel index={0} active={tab}><Field label="Name" hint="As on your card" placeholder="Ada Lovelace" kind="text"/></TabPanel>
                <TabPanel index={1} active={tab}><Field label="Password" hint="At least 12 characters" placeholder="secret" kind="password"/></TabPanel>
                <Dialog title="Are you sure?" open={open}><p>This is a modal dialog.</p></Dialog>
            </section>
        };
    }
}

// Routing: the links navigate inside the app and each new page fades in.
struct Pages {
    i32 unused;

    static unsafe Node page(str path) {
        if (Router.matches("/settings", path)) {
            return html!{ <p>Settings page. Navigation keeps one window and fades the page in.</p> };
        }
        if (Router.matches("/users/:id", path)) {
            return html!{ <p>User {Router.param("/users/:id", path, "id")}</p> };
        }
        return html!{ <p>Home page.</p> };
    }

    public unsafe Node render() {
        return html!{
            <section class="card stack">
                <h2>Router</h2>
                <nav class="cluster">
                    <Link to="/" label="Home"/>
                    <Link to="/settings" label="Settings"/>
                    <Link to="/users/42" label="User 42"/>
                    <Button label="Back" variant="" on_click={() => Router.back()}/>
                </nav>
                <Outlet view={(str path) => Pages.page(path)}/>
            </section>
        };
    }
}

struct Showcase {
    public unsafe Node render() {
        return html!{
            <main class="page stack">
                <h1>Djinn UI</h1>
                <p>A native window, drawn by the framework.</p>
                <section class="card stack">
                    <h2>Counter</h2>
                    <Counter start={4}/>
                </section>
                <Keyboard unused={0}/>
                <Kit unused={0}/>
                <Pages unused={0}/>
            </main>
        };
    }
}

unsafe i32 main() {
    Showcase app = { };
    i8* shot = getenv("DJINN_UI_SHOT");
    if (shot != (i8*)0) {
        mut f32 click_x = (f32)-1.0;
        mut f32 click_y = (f32)-1.0;
        i8* at_x = getenv("DJINN_UI_CLICK_X");
        i8* at_y = getenv("DJINN_UI_CLICK_Y");
        if (at_x != (i8*)0 && at_y != (i8*)0) {
            click_x = digits(at_x);
            click_y = digits(at_y);
        }
        return WinHost.shot<Showcase>(app, 900, 600, shot, click_x, click_y);
    }
    return WinHost.run<Showcase>(app, "Djinn UI", 900, 640);
}

unsafe f32 digits(i8* text) {
    mut i32 value = 0;
    mut u32 i = 0;
    while (text[i] >= 48 && text[i] <= 57) {
        value = value * 10 + ((i32)text[i] - 48);
        i = i + 1;
    }
    return (f32)value;
}
