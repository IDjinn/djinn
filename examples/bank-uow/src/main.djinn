unsafe i32 run_transfer(Account* a, Account* b, Ledger* ledger, i64 amount) {
    return switch transfer(a, b, ledger, amount) {
        Result v -> 0,
        InsufficientFunds e -> 1
    };
}

unsafe i32 run_settle(Account* a, Account* b, i64 amount) {
    return switch settle(a, b, amount) {
        Result v -> 0,
        InsufficientFunds e -> 1,
        AuditUnavailable e -> 2
    };
}

unsafe i32 main() {
    Account alice = Account { .id = 1, .balance = 100, .frozen = false };
    Account bob = Account { .id = 2, .balance = 50, .frozen = false };
    Ledger ledger = Ledger();

    i32 first = run_transfer(&alice, &bob, &ledger, 500);
    printf("transfer 500: %d alice=%lld bob=%lld entries=%lld\n", first, alice.balance, bob.balance, ledger.entries);
    i32 second = run_transfer(&alice, &bob, &ledger, 30);
    printf("transfer 30:  %d alice=%lld bob=%lld entries=%lld\n", second, alice.balance, bob.balance, ledger.entries);

    i32 charged = switch charge(&bob, &ledger, 5) {
        Result v -> 0,
        InsufficientFunds e -> 1
    };
    printf("charge 5:     %d bob=%lld entries=%lld volume=%lld\n", charged, bob.balance, ledger.entries, ledger.volume);

    i32 audited = run_settle(&alice, &bob, 13);
    printf("settle 13:    %d alice=%lld bob=%lld\n", audited, alice.balance, bob.balance);
    i32 settled = run_settle(&alice, &bob, 20);
    printf("settle 20:    %d alice=%lld bob=%lld\n", settled, alice.balance, bob.balance);

    printf("statement:    alice=%lld\n", statement(&alice));

    if (first != 1 || second != 0 || charged != 0 || audited != 2 || settled != 0) {
        return 1;
    }
    return 0;
}
