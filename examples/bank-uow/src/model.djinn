extern "C" {
    i32 printf(i8* format, ...);
}

struct InsufficientFunds;
struct AuditUnavailable;

struct Account {
    i64 id;
    mut i64 balance;
    mut bool frozen;
}

// Only the methods of Ledger can write its fields, and the invariant is checked every time one of them returns.
struct Ledger {
    mut i64 entries;
    mut i64 volume;
    invariant(this.entries >= 0 && this.volume >= 0);

    Ledger() {
        this.entries = 0;
        this.volume = 0;
    }

    public void record(i64 amount) require(amount > 0) ensure(this.entries == old(this.entries) + 1) {
        this.entries = this.entries + 1;
        this.volume = this.volume + amount;
    }
}
