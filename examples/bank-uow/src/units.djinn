// A uow declares the participants, the rules and the memory a method may touch; the method keeps the code.
uow Transfer {
    Account* from;
    Account* to;
    Ledger* ledger;
    i64 amount;

    require(amount > 0)
    require(from.id != to.id)
    require(!from.frozen && !to.frozen)
    ensure(from.balance + to.balance == old(from.balance) + old(to.balance))
    writes(*from, *to, *ledger)
    access(exclusive from, exclusive to, exclusive ledger)
    ordering(Account.id ascending)
    isolation(serializable)
}

uow Charge {
    Account* from;
    Ledger* ledger;
    i64 fee;

    require(fee > 0)
    writes(*from, *ledger)
    access(exclusive from, exclusive ledger)
    ordering(Account.id ascending)
    isolation(serializable)
}

uow Statement {
    Account* from;

    access(shared from)
    ordering(Account.id ascending)
    isolation(serializable)
}
