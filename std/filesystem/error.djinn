import std::types;

namespace std::filesystem;

enum FsError {
    NotFound,
    AlreadyExists,
    PermissionDenied,
    NotADirectory,
    IsADirectory,
    NotEmpty,
    InvalidArgument,
    NameTooLong,
    SymlinkRefused,
    NoSpace,
    ReadOnly,
    TooManyOpenFiles,
    Busy,
    IoError,
    CrossDevice,
    Unsupported,
    QuotaExceeded,
    TooManyLinks,
    BadHandle,
    FileTooLarge,
    WouldBlock,
    OutOfMemory,
    BrokenPipe,
    NotRegularFile,
    InvalidPath,
    PathEscapes,
    AbsolutePath,
    Closed,
    Unknown
}

FsError fs_error_from_code(i64 code) {
    switch (code) {
        case 1:
            return FsError::NotFound;
        case 2:
            return FsError::AlreadyExists;
        case 3:
            return FsError::PermissionDenied;
        case 4:
            return FsError::NotADirectory;
        case 5:
            return FsError::IsADirectory;
        case 6:
            return FsError::NotEmpty;
        case 7:
            return FsError::InvalidArgument;
        case 8:
            return FsError::NameTooLong;
        case 9:
            return FsError::SymlinkRefused;
        case 10:
            return FsError::NoSpace;
        case 11:
            return FsError::ReadOnly;
        case 12:
            return FsError::TooManyOpenFiles;
        case 13:
            return FsError::Busy;
        case 15:
            return FsError::IoError;
        case 16:
            return FsError::CrossDevice;
        case 17:
            return FsError::Unsupported;
        case 18:
            return FsError::QuotaExceeded;
        case 19:
            return FsError::TooManyLinks;
        case 20:
            return FsError::BadHandle;
        case 21:
            return FsError::FileTooLarge;
        case 22:
            return FsError::WouldBlock;
        case 23:
            return FsError::OutOfMemory;
        case 24:
            return FsError::BrokenPipe;
        case 25:
            return FsError::NotRegularFile;
        case 26:
            return FsError::InvalidPath;
        case 27:
            return FsError::PathEscapes;
        case 28:
            return FsError::AbsolutePath;
        default:
            return FsError::Unknown;
    }
}

str fs_error_message(FsError error) {
    return switch error {
        NotFound -> "not found",
        AlreadyExists -> "already exists",
        PermissionDenied -> "permission denied",
        NotADirectory -> "not a directory",
        IsADirectory -> "is a directory",
        NotEmpty -> "directory not empty",
        InvalidArgument -> "invalid argument",
        NameTooLong -> "name too long",
        SymlinkRefused -> "symbolic link refused",
        NoSpace -> "no space left on device",
        ReadOnly -> "read-only file system",
        TooManyOpenFiles -> "too many open files",
        Busy -> "resource busy",
        IoError -> "i/o error",
        CrossDevice -> "cross-device operation",
        Unsupported -> "unsupported operation",
        QuotaExceeded -> "quota exceeded",
        TooManyLinks -> "too many levels of links",
        BadHandle -> "bad handle",
        FileTooLarge -> "file too large",
        WouldBlock -> "operation would block",
        OutOfMemory -> "out of memory",
        BrokenPipe -> "broken pipe",
        NotRegularFile -> "not a regular file",
        InvalidPath -> "invalid path",
        PathEscapes -> "path escapes the directory",
        AbsolutePath -> "absolute path not allowed",
        Closed -> "handle already closed",
        Unknown -> "unknown error"
    };
}
