import std::types;

namespace std::filesystem;

enum FsError {
    NotFound(),
    AlreadyExists(),
    PermissionDenied(),
    NotADirectory(),
    IsADirectory(),
    NotEmpty(),
    InvalidArgument(),
    NameTooLong(),
    SymlinkRefused(),
    NoSpace(),
    ReadOnly(),
    TooManyOpenFiles(),
    Busy(),
    IoError(),
    CrossDevice(),
    Unsupported(),
    QuotaExceeded(),
    TooManyLinks(),
    BadHandle(),
    FileTooLarge(),
    WouldBlock(),
    OutOfMemory(),
    BrokenPipe(),
    NotRegularFile(),
    InvalidPath(),
    PathEscapes(),
    AbsolutePath(),
    Closed(),
    Unknown()
}

FsError fs_error_from_code(i64 code) {
    if (code == 1) { return FsError::NotFound(); }
    if (code == 2) { return FsError::AlreadyExists(); }
    if (code == 3) { return FsError::PermissionDenied(); }
    if (code == 4) { return FsError::NotADirectory(); }
    if (code == 5) { return FsError::IsADirectory(); }
    if (code == 6) { return FsError::NotEmpty(); }
    if (code == 7) { return FsError::InvalidArgument(); }
    if (code == 8) { return FsError::NameTooLong(); }
    if (code == 9) { return FsError::SymlinkRefused(); }
    if (code == 10) { return FsError::NoSpace(); }
    if (code == 11) { return FsError::ReadOnly(); }
    if (code == 12) { return FsError::TooManyOpenFiles(); }
    if (code == 13) { return FsError::Busy(); }
    if (code == 15) { return FsError::IoError(); }
    if (code == 16) { return FsError::CrossDevice(); }
    if (code == 17) { return FsError::Unsupported(); }
    if (code == 18) { return FsError::QuotaExceeded(); }
    if (code == 19) { return FsError::TooManyLinks(); }
    if (code == 20) { return FsError::BadHandle(); }
    if (code == 21) { return FsError::FileTooLarge(); }
    if (code == 22) { return FsError::WouldBlock(); }
    if (code == 23) { return FsError::OutOfMemory(); }
    if (code == 24) { return FsError::BrokenPipe(); }
    if (code == 25) { return FsError::NotRegularFile(); }
    if (code == 26) { return FsError::InvalidPath(); }
    if (code == 27) { return FsError::PathEscapes(); }
    if (code == 28) { return FsError::AbsolutePath(); }
    return FsError::Unknown();
}

str fs_error_message(FsError error) {
    return switch error {
        NotFound -> "not found",
        AlreadyExists -> "already exists",
        PermissionDenied -> "permission denied",
        NotADirectory -> "not a directory",
        IsADirectory -> "is a directory",
        NotEmpty -> "directory not empty",
        InvalidArgument -> "invalid argument",
        NameTooLong -> "name too long",
        SymlinkRefused -> "symbolic link refused",
        NoSpace -> "no space left on device",
        ReadOnly -> "read-only file system",
        TooManyOpenFiles -> "too many open files",
        Busy -> "resource busy",
        IoError -> "i/o error",
        CrossDevice -> "cross-device operation",
        Unsupported -> "unsupported operation",
        QuotaExceeded -> "quota exceeded",
        TooManyLinks -> "too many levels of links",
        BadHandle -> "bad handle",
        FileTooLarge -> "file too large",
        WouldBlock -> "operation would block",
        OutOfMemory -> "out of memory",
        BrokenPipe -> "broken pipe",
        NotRegularFile -> "not a regular file",
        InvalidPath -> "invalid path",
        PathEscapes -> "path escapes the directory",
        AbsolutePath -> "absolute path not allowed",
        Closed -> "handle already closed",
        Unknown -> "unknown error"
    };
}
