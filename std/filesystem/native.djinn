import std::types;

namespace std::filesystem::native;

extern "C" {
    i64 __djinn_fs_open_root(i8* path, i64 length, i32 flags);
    i64 __djinn_fs_open_dir(i64 dir, i8* path, i64 length, i32 flags);
    i64 __djinn_fs_open_file(i64 dir, i8* path, i64 length, i32 flags, i32 mode);
    i64 __djinn_fs_close(i64 handle);
    i64 __djinn_fs_read(i64 handle, void* buffer, i64 count);
    i64 __djinn_fs_write(i64 handle, void* buffer, i64 count);
    i64 __djinn_fs_seek(i64 handle, i64 offset, i32 whence);
    i64 __djinn_fs_truncate(i64 handle, i64 length);
    i64 __djinn_fs_sync(i64 handle);
    i64 __djinn_fs_fstat(i64 handle, i64* out);
    i64 __djinn_fs_stat(i64 dir, i8* path, i64 length, i32 flags, i64* out);
    i64 __djinn_fs_mkdir(i64 dir, i8* path, i64 length, i32 mode);
    i64 __djinn_fs_remove(i64 dir, i8* path, i64 length, i32 is_directory);
    i64 __djinn_fs_rename(i64 from_dir, i8* from, i64 from_length, i64 to_dir, i8* to, i64 to_length, i32 replace);
    i64 __djinn_fs_list_open(i64 dir);
    i64 __djinn_fs_list_next(i64 list, ListCursor* cursor);
    void __djinn_fs_list_free(i64 list);
    i64 __djinn_fs_temp_name(i8* leaf, i64 leaf_length, i8* out, i64 capacity);
}

// Filled by list_next; must match djfs_cursor in runtime/fs_safe.c.
struct ListCursor {
    i8* name;
    i32 length;
    i32 kind;
}

// Native handle operations: a negative result is the negated error code of runtime/fs_safe.c.
// Nothing here validates paths or tracks handle ownership; use std::filesystem unless you need this.
struct Native {
    public static unsafe i64 open_root(str path, i32 flags) {
        return __djinn_fs_open_root(path.data, (i64)path.length, flags);
    }

    public static unsafe i64 open_dir(i64 dir, str path, i32 flags) {
        return __djinn_fs_open_dir(dir, path.data, (i64)path.length, flags);
    }

    public static unsafe i64 open_file(i64 dir, str path, i32 flags, i32 mode) {
        return __djinn_fs_open_file(dir, path.data, (i64)path.length, flags, mode);
    }

    public static unsafe i64 close(i64 handle) {
        return __djinn_fs_close(handle);
    }

    public static unsafe i64 read(i64 handle, void* buffer, i64 count) {
        return __djinn_fs_read(handle, buffer, count);
    }

    public static unsafe i64 write(i64 handle, void* buffer, i64 count) {
        return __djinn_fs_write(handle, buffer, count);
    }

    public static unsafe i64 seek(i64 handle, i64 offset, i32 whence) {
        return __djinn_fs_seek(handle, offset, whence);
    }

    public static unsafe i64 truncate(i64 handle, i64 length) {
        return __djinn_fs_truncate(handle, length);
    }

    public static unsafe i64 sync(i64 handle) {
        return __djinn_fs_sync(handle);
    }

    public static unsafe i64 fstat(i64 handle, i64* out) {
        return __djinn_fs_fstat(handle, out);
    }

    public static unsafe i64 stat(i64 dir, str path, i32 flags, i64* out) {
        return __djinn_fs_stat(dir, path.data, (i64)path.length, flags, out);
    }

    public static unsafe i64 mkdir(i64 dir, str path, i32 mode) {
        return __djinn_fs_mkdir(dir, path.data, (i64)path.length, mode);
    }

    public static unsafe i64 remove(i64 dir, str path, bool is_directory) {
        mut i32 flag = 0;
        if (is_directory) { flag = 1; }
        return __djinn_fs_remove(dir, path.data, (i64)path.length, flag);
    }

    public static unsafe i64 rename(i64 from_dir, str from, i64 to_dir, str to, bool replace) {
        mut i32 flag = 0;
        if (replace) { flag = 1; }
        return __djinn_fs_rename(from_dir, from.data, (i64)from.length, to_dir, to.data, (i64)to.length, flag);
    }

    public static unsafe i64 list_open(i64 dir) {
        return __djinn_fs_list_open(dir);
    }

    public static unsafe i64 list_next(i64 list, ListCursor* cursor) {
        return __djinn_fs_list_next(list, cursor);
    }

    public static unsafe void list_free(i64 list) {
        __djinn_fs_list_free(list);
    }

    public static unsafe i64 temp_name(str leaf, i8* out, i64 capacity) {
        return __djinn_fs_temp_name(leaf.data, (i64)leaf.length, out, capacity);
    }
}
