import std::types;

namespace std::filesystem;

// A validated path. Values only come from Path.parse (or Path.unchecked, which is unsafe), so every Path:
//   - is 1..4096 bytes, without NUL, control characters or any of \ : < > " | ? *
//   - has no empty, ".." or Windows-reserved (CON, NUL, COM1...) components and no component ending in '.' or ' '
// The text is borrowed, not copied: it must outlive the Path.
// Relative paths are resolved from a Directory and can never leave it. Absolute paths (a leading '/' or "X:/")
// are only accepted by Directory.open_root, the single place where ambient authority enters.
struct Path {
    str text;
    bool absolute;

    public static result<Path, FsError> parse(str text) {
        if (text.length == 0u) { return result::Error(FsError::InvalidPath()); }
        if (text.length > 4096u) { return result::Error(FsError::NameTooLong()); }

        mut size start = 0;
        mut bool absolute = false;
        unsafe {
            if (text.data[0] == 47) {
                absolute = true;
                start = 1;
            } else if (text.length >= 3u && text.data[1] == 58 && text.data[2] == 47 && Path.is_letter(text.data[0])) {
                absolute = true;
                start = 3;
            }
        }
        if (absolute && start == text.length) {
            return result::Ok({ .text = text, .absolute = true });
        }

        mut size component = start;
        mut size index = start;
        while (index <= text.length) {
            bool at_end = index == text.length;
            mut bool separator = at_end;
            if (!at_end) {
                unsafe { separator = text.data[index] == 47; }
            }
            if (separator) {
                i64 failure = Path.check_component(text, component, index);
                if (failure != 0) { return result::Error(fs_error_from_code(failure)); }
                component = index + 1;
            }
            index = index + 1;
        }
        return result::Ok({ .text = text, .absolute = absolute });
    }

    public static unsafe Path unchecked(str text, bool absolute) {
        return { .text = text, .absolute = absolute };
    }

    public bool is_absolute() {
        return this.absolute;
    }

    public str as_str() {
        return this.text;
    }

    public str file_name() {
        mut size cut = this.text.length;
        unsafe {
            while (cut > 0u && this.text.data[cut - 1] != 47) {
                cut = cut - 1;
            }
        }
        return this.text.slice(cut, this.text.length - cut);
    }

    public optional<Path> parent() {
        mut size cut = this.text.length;
        unsafe {
            while (cut > 0u && this.text.data[cut - 1] != 47) {
                cut = cut - 1;
            }
        }
        if (cut == 0u) { return optional::Empty(); }
        mut size end = cut - 1;
        if (end == 0u) {
            if (!this.absolute) { return optional::Empty(); }
            end = 1;
        }
        str head = this.text.slice(0, end);
        return optional::Value({ .text = head, .absolute = this.absolute });
    }

    static bool is_letter(i8 value) {
        return (value >= 65 && value <= 90) || (value >= 97 && value <= 122);
    }

    static bool is_reserved_name(str component) {
        mut size stem = 0;
        unsafe {
            while (stem < component.length && component.data[stem] != 46) {
                stem = stem + 1;
            }
        }
        if (stem == 3u) {
            str name = component.slice(0, 3);
            return name.equalsIgnoreCase("con") || name.equalsIgnoreCase("prn") || name.equalsIgnoreCase("aux") || name.equalsIgnoreCase("nul");
        }
        if (stem == 4u) {
            str name = component.slice(0, 4);
            unsafe {
                i8 digit = name.data[3];
                if (digit < 49 || digit > 57) { return false; }
            }
            return name.slice(0, 3).equalsIgnoreCase("com") || name.slice(0, 3).equalsIgnoreCase("lpt");
        }
        return false;
    }

    static i64 check_component(str text, size from, size to) {
        size length = to - from;
        if (length == 0u) { return 26; }
        if (length > 255u) { return 8; }
        unsafe {
            if (length == 1u && text.data[from] == 46) { return 0; }
            if (length == 2u && text.data[from] == 46 && text.data[from + 1] == 46) { return 27; }
            for (mut size i = from; i < to; i = i + 1) {
                i8 value = text.data[i];
                if (value < 32 || value == 127 || value == 92 || value == 58 || value == 60 || value == 62
                    || value == 34 || value == 124 || value == 63 || value == 42) {
                    return 26;
                }
            }
            i8 last = text.data[to - 1];
            if (last == 46 || last == 32) { return 26; }
        }
        if (Path.is_reserved_name(text.slice(from, length))) { return 26; }
        return 0;
    }
}
