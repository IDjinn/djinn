import std::libc;
import std::types::constraints;

namespace std::memory;

struct owner<T> : Disposable {
    T* pointer;

    owner(T value) {
        this.pointer = (T*)__djinn_alloc(sizeof(T));
        *this.pointer = value;
    }

    public unsafe T* get() {
        return this.pointer;
    }

    public void disposable() {
        __djinn_free(this.pointer);
    }
}
