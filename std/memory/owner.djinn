import std::libc;
import std::types::constraints;

namespace std::memory;

struct owner<T> : Disposable {
    T* pointer;

    unsafe owner(T value) {
        this.pointer = (T*)malloc(sizeof(T));
        *this.pointer = value;
    }

    public unsafe T* get() {
        return this.pointer;
    }

    public unsafe void disposable() {
        free(this.pointer);
    }
}
