import std::libc;
import std::debug;
import std::types::constraints;

namespace std::memory;

struct arena_block {
    arena_block* previous;
    u64 size;
    u64 used;
}

struct arena_mark {
    arena_block* block;
    u64 used;
}

struct arena : Disposable {
    const u64 HEADER_SIZE = 32;
    const u64 MAX_ALIGNMENT = 16;
    const u64 MAX_BLOCK_SIZE = 67108864;

    arena_block* head;
    u64 block_size;
    u64 reserved_bytes;
    u64 allocated_bytes;

    arena(u64 block_size) {
        Debug.assert(block_size > 0, "arena - block size must be greater than zero");
        this.block_size = block_size;
        this.reserved_bytes = 0;
        this.allocated_bytes = 0;
        unsafe {
            this.head = (arena_block*)0;
            this._add_block(block_size);
        }
    }

    public unsafe i8* alloc(u64 size, u64 alignment) {
        Debug.assert(alignment != 0 && alignment <= arena.MAX_ALIGNMENT && (alignment & (alignment - 1)) == 0, "arena::alloc - alignment must be a power of two up to 16");
        mut arena_block* block = this.head;
        mut u64 start = (block.used + alignment - 1) / alignment * alignment;
        if (start + size > block.size) {
            this._grow(size + alignment);
            block = this.head;
            start = (block.used + alignment - 1) / alignment * alignment;
        }
        block.used = start + size;
        this.allocated_bytes = this.allocated_bytes + size;
        i8* base = (i8*)block + arena.HEADER_SIZE;
        return base + start;
    }

    public unsafe i8* alloc_zeroed(u64 size, u64 alignment) {
        i8* memory = this.alloc(size, alignment);
        memset(memory, 0, size);
        return memory;
    }

    public unsafe arena_mark mark() {
        arena_mark point = { .block = this.head, .used = this.head.used };
        return point;
    }

    public unsafe void reset_to(arena_mark point) {
        while (this.head != point.block) {
            arena_block* dropped = this.head;
            this.head = dropped.previous;
            this.reserved_bytes = this.reserved_bytes - dropped.size;
            __djinn_free(dropped);
        }
        this.head.used = point.used;
    }

    public unsafe void reset() {
        while (this.head.previous != (arena_block*)0) {
            arena_block* dropped = this.head;
            this.head = dropped.previous;
            this.reserved_bytes = this.reserved_bytes - dropped.size;
            __djinn_free(dropped);
        }
        this.head.used = 0;
        this.allocated_bytes = 0;
    }

    public u64 allocated() {
        return this.allocated_bytes;
    }

    public u64 reserved() {
        return this.reserved_bytes;
    }

    public unsafe void disposable() {
        while (this.head != (arena_block*)0) {
            arena_block* dropped = this.head;
            this.head = dropped.previous;
            __djinn_free(dropped);
        }
        this.reserved_bytes = 0;
        this.allocated_bytes = 0;
    }

    unsafe void _grow(u64 needed) {
        mut u64 size = this.block_size;
        if (size < arena.MAX_BLOCK_SIZE) {
            size = size * 2;
            this.block_size = size;
        }
        if (size < needed) {
            size = needed;
        }
        this._add_block(size);
    }

    unsafe void _add_block(u64 size) {
        arena_block* block = (arena_block*)__djinn_alloc(size + arena.HEADER_SIZE);
        block.previous = this.head;
        block.size = size;
        block.used = 0;
        this.head = block;
        this.reserved_bytes = this.reserved_bytes + size;
    }
}
