import std::libc;
import std::sys;
import std::types::constraints;

namespace std::memory;

struct shared<T> : Disposable {
    atomic<i32>* count;
    owner<T>* block;

    shared(T value) {
        this.count = (atomic<i32>*)malloc(sizeof(atomic<i32>));
        *this.count = atomic<i32>(1);
        this.block = (owner<T>*)malloc(sizeof(owner<T>));
        *this.block = owner<T>(value);
    }

    public unsafe T* get() {
        return this.block.get();
    }

    public unsafe i32 references() {
        return this.count.load();
    }

    public unsafe shared<T> clone() {
        this.count.fetchAdd(1);
        shared<T> copy = { .count = this.count, .block = this.block };
        return copy;
    }

    public unsafe void disposable() {
        if (this.count.fetchSub(1) != 1) {
            return;
        }
        owner<T> last = *this.block;
        free(this.block);
        free(this.count);
    }
}
