import std::types;
import std::types::constraints;

namespace std::collections;

struct bag<T>
    where T : Hashable, Equatable
{
    array<T> items;

    bag() {
        this.items = array<T>();
    }

    public unsafe void add(T value) {
        this.items.push(value);
    }

    public unsafe bool remove(T value) {
        i32 index = this.items.index_of(value);
        if (index < 0) {
            return false;
        }
        this.items.swap_remove((size)index);
        return true;
    }

    public unsafe T take() {
        return this.items.pop();
    }

    public unsafe T take_at(size index) {
        return this.items.swap_remove(index);
    }

    public unsafe T get(size index) {
        return this.items.get(index);
    }

    public bool contains(T value) {
        return this.items.contains(value);
    }

    public size length() {
        return this.items.length();
    }

    public bool is_empty() {
        return this.items.length() == 0u;
    }

    public void clear() {
        this.items.clear();
    }
}
