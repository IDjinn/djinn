import std::types;
import std::memory;
import std::libc;
import std::debug;
import std::types::constraints;

namespace std::collections;

struct map<Key, Value> : Disposable
    where Key : Hashable, Equatable;
    where Value : Hashable, Equatable
{
    Key* keys;
    Value* values;
    i8* states;
    size count;
    size tombstones;
    allocator source;
    size capacity;

    map() {
        unsafe {
            this.source = allocator.heap();
        }
        this.start();
    }

    map(allocator source) {
        this.source = source;
        this.start();
    }

    private void start() {
        this.capacity = 16u;
        this.count = 0u;
        this.tombstones = 0u;
        unsafe {
            this.allocate(this.capacity);
        }
    }

    public unsafe void set(Key key, Value value) {
        if ((this.count + this.tombstones) * 4u >= this.capacity * 3u) {
            this.rehash();
        }

        u32w capacity = (u32w)this.capacity;
        u32w mask = capacity - 1w;
        mut u32w idx = this.hash_index(key);
        mut u32w insert_idx = capacity;

        for (mut u32w i = 0w; i < capacity; i = i + 1w) {
            i8 state = this.states[idx];

            if (state == (i8)0) {
                if (insert_idx == capacity) {
                    insert_idx = idx;
                }
                break;
            }

            if (state == (i8)2) {
                if (insert_idx == capacity) {
                    insert_idx = idx;
                }
            } else if (this.keys[idx] == key) {
                this.values[idx] = value;
                return;
            }

            idx = (idx + 1w) & mask;
        }

        if (insert_idx < capacity) {
            if (this.states[insert_idx] == (i8)2) {
                this.tombstones = this.tombstones - 1u;
            }
            this.keys[insert_idx] = key;
            this.values[insert_idx] = value;
            this.states[insert_idx] = 1;
            this.count = this.count + 1u;
        }
    }

    public unsafe Value get(Key key) {
        u32w capacity = (u32w)this.capacity;
        u32w mask = capacity - 1w;
        mut u32w idx = this.hash_index(key);

        for (mut u32w i = 0w; i < capacity; i = i + 1w) {
            i8 state = this.states[idx];
            Debug.assert(state != (i8)0, "map::get - key not found");

            if (state == (i8)1 && this.keys[idx] == key) {
                return this.values[idx];
            }

            idx = (idx + 1w) & mask;
        }

        Debug.assert(false, "map::get - key not found");
        return this.values[0];
    }

    public unsafe bool has(Key key) {
        u32w capacity = (u32w)this.capacity;
        u32w mask = capacity - 1w;
        mut u32w idx = this.hash_index(key);

        for (mut u32w i = 0w; i < capacity; i = i + 1w) {
            i8 state = this.states[idx];

            if (state == (i8)0) {
                return false;
            }

            if (state == (i8)1 && this.keys[idx] == key) {
                return true;
            }

            idx = (idx + 1w) & mask;
        }

        return false;
    }

    public unsafe bool remove(Key key) {
        u32w capacity = (u32w)this.capacity;
        u32w mask = capacity - 1w;
        mut u32w idx = this.hash_index(key);

        for (mut u32w i = 0w; i < capacity; i = i + 1w) {
            i8 state = this.states[idx];

            if (state == (i8)0) {
                return false;
            }

            if (state == (i8)1 && this.keys[idx] == key) {
                this.states[idx] = (i8)2;
                this.count = this.count - 1u;
                this.tombstones = this.tombstones + 1u;
                return true;
            }

            idx = (idx + 1w) & mask;
        }

        return false;
    }

    public unsafe void clear() {
        memset(this.states, 0, (u64)this.capacity);
        this.count = 0u;
        this.tombstones = 0u;
    }

    public unsafe array<Key> keys() {
        array<Key> result = array<Key>();
        result.reserve(this.count);
        u32w capacity = (u32w)this.capacity;
        for (mut u32w i = 0w; i < capacity; i = i + 1w) {
            if (this.states[i] == (i8)1) {
                result.push(this.keys[i]);
            }
        }
        return result;
    }

    public unsafe array<Value> values() {
        array<Value> result = array<Value>();
        result.reserve(this.count);
        u32w capacity = (u32w)this.capacity;
        for (mut u32w i = 0w; i < capacity; i = i + 1w) {
            if (this.states[i] == (i8)1) {
                result.push(this.values[i]);
            }
        }
        return result;
    }

    public constexpr size length() {
        return this.count;
    }

    public unsafe u64 hash() {
        mut u64w total = 1;
        u32w capacity = (u32w)this.capacity;
        for (mut u32w i = 0w; i < capacity; i = i + 1w) {
            if (this.states[i] == (i8)1) {
                mut u64w entry = (u64w)this.keys[i].hash() * 31w + (u64w)this.values[i].hash();
                entry = (entry ^ (entry >> 29)) * 0x9e3779b97f4a7c15;
                total = total + (entry ^ (entry >> 32));
            }
        }
        return (u64)total;
    }

    public unsafe void disposable() {
        this.source.release((i8*)this.keys, this.block_bytes(this.capacity));
    }

    private u64 block_bytes(size capacity) {
        u64 slots = (u64)capacity;
        return (slots * sizeof(Key) + 15) / 16 * 16 + (slots * sizeof(Value) + 15) / 16 * 16 + slots;
    }

    private constexpr u32w hash_index(Key key) {
        mut u64w x = (u64w)key.hash();
        x = (x ^ (x >> 32)) * 0x9e3779b97f4a7c15;
        x = x ^ (x >> 29);
        return (u32w)(x & ((u64w)this.capacity - 1w));
    }

    private unsafe void allocate(size capacity) {
        u64 slots = (u64)capacity;
        u64 keys_bytes = (slots * sizeof(Key) + 15u) / 16u * 16u;
        u64 values_bytes = (slots * sizeof(Value) + 15u) / 16u * 16u;
        i8* block = this.source.alloc(keys_bytes + values_bytes + slots);
        this.keys = (Key*)block;
        this.values = (Value*)(block + keys_bytes);
        this.states = block + keys_bytes + values_bytes;
        memset(this.states, 0, slots);
    }

    private unsafe void insert_fresh(Key key, Value value) {
        u32w mask = (u32w)this.capacity - 1w;
        mut u32w idx = this.hash_index(key);
        while (this.states[idx] != (i8)0) {
            idx = (idx + 1w) & mask;
        }
        this.keys[idx] = key;
        this.values[idx] = value;
        this.states[idx] = 1;
        this.count = this.count + 1u;
    }

    private unsafe void rehash() {
        size old_capacity = this.capacity;
        Key* old_keys = this.keys;
        Value* old_values = this.values;
        i8* old_states = this.states;

        if (this.count * 2u >= old_capacity) {
            this.capacity = old_capacity * 2u;
        }
        this.count = 0u;
        this.tombstones = 0u;
        this.allocate(this.capacity);

        u32w old_slots = (u32w)old_capacity;
        for (mut u32w i = 0w; i < old_slots; i = i + 1w) {
            if (old_states[i] == (i8)1) {
                this.insert_fresh(old_keys[i], old_values[i]);
            }
        }

        this.source.release((i8*)old_keys, this.block_bytes(old_capacity));
    }
}
