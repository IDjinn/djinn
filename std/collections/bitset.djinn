import std::types;
import std::debug;
import std::types::constraints;

namespace std::collections;

struct bitset : Disposable {
    u64* words;
    size bits;

    bitset(size bits) {
        Debug.assert(bits > 0u, "bitset - size must be greater than zero");
        this.bits = bits;
        unsafe {
            u64 word_count = ((u64)bits + 63) / 64;
            this.words = (u64*)__djinn_alloc_zeroed(word_count * 8);
        }
    }

    public unsafe void set(size index) {
        Debug.assert(index < this.bits, "bitset::set - index out of bounds");
        this.words[index / 64u] = this.words[index / 64u] | (1 << (u64)(index % 64u));
    }

    public unsafe void clear(size index) {
        Debug.assert(index < this.bits, "bitset::clear - index out of bounds");
        this.words[index / 64u] = this.words[index / 64u] & ~(1 << (u64)(index % 64u));
    }

    public unsafe void flip(size index) {
        Debug.assert(index < this.bits, "bitset::flip - index out of bounds");
        this.words[index / 64u] = this.words[index / 64u] ^ (1 << (u64)(index % 64u));
    }

    public unsafe bool test(size index) {
        Debug.assert(index < this.bits, "bitset::test - index out of bounds");
        return ((this.words[index / 64u] >> (u64)(index % 64u)) & 1) != 0;
    }

    public unsafe size count() {
        mut size total = 0u;
        u32w word_count = (u32w)(((u64)this.bits + 63) / 64);
        for (mut u32w i = 0w; i < word_count; i = i + 1w) {
            mut u64w word = (u64w)this.words[i];
            while (word != 0w) {
                word = word & (word - 1w);
                total = total + 1u;
            }
        }
        return total;
    }

    public size length() {
        return this.bits;
    }

    public unsafe void clear_all() {
        u64 word_count = ((u64)this.bits + 63) / 64;
        memset((void*)this.words, 0, word_count * 8);
    }

    public unsafe void disposable() {
        __djinn_free((void*)this.words);
    }
}
