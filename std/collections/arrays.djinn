import std::types;
import std::memory;
import std::libc;
import std::debug;

namespace std::collections;

// Functional updates of a slice: each call returns a new slice and leaves the argument untouched. This is the native
// counterpart of runtime/js/std/collections.djinn, where the same calls build new JS arrays, so one source (a UI
// component that keeps a list in a signal) builds for the web and natively. The new storage comes from the heap and is
// not freed by the slice: it lives as long as the program keeps it, as the old JS array lives until the garbage
// collector takes it.
struct Arrays {
    public static slice<T> empty<T>() {
        unsafe {
            slice<T> none = { .data = (T*)0, .length = 0u };
            return none;
        }
    }

    public static unsafe slice<T> append<T>(slice<T> items, T item) {
        size count = items.length + 1u;
        T* data = (T*)__djinn_alloc((u64)count * sizeof(T));
        if (items.length > 0u) {
            memcpy((void*)data, (void*)items.data, (u64)items.length * sizeof(T));
        }
        data[items.length] = item;
        slice<T> result = { .data = data, .length = count };
        return result;
    }

    public static unsafe slice<T> remove_at<T>(slice<T> items, i32 index) {
        Debug.assert(index >= 0 && (size)index < items.length, "Arrays::remove_at - index out of bounds");
        size at = (size)index;
        size count = items.length - 1u;
        T* data = (T*)__djinn_alloc((u64)(count + 1u) * sizeof(T));
        if (at > 0u) {
            memcpy((void*)data, (void*)items.data, (u64)at * sizeof(T));
        }
        if (at < count) {
            memcpy((void*)&data[at], (void*)&items.data[at + 1u], (u64)(count - at) * sizeof(T));
        }
        slice<T> result = { .data = data, .length = count };
        return result;
    }

    public static unsafe slice<T> replace_at<T>(slice<T> items, i32 index, T item) {
        Debug.assert(index >= 0 && (size)index < items.length, "Arrays::replace_at - index out of bounds");
        T* data = (T*)__djinn_alloc((u64)(items.length + 1u) * sizeof(T));
        memcpy((void*)data, (void*)items.data, (u64)items.length * sizeof(T));
        data[(size)index] = item;
        slice<T> result = { .data = data, .length = items.length };
        return result;
    }
}
