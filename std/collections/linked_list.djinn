import std::types;
import std::debug;
import std::types::constraints;

namespace std::collections;

struct list_node<T> {
    T value;
    list_node<T>* previous;
    list_node<T>* next;
}

struct linked_list<T> : Disposable
    where T : Hashable, Equatable
{
    list_node<T>* head;
    list_node<T>* tail;
    size count;

    linked_list() {
        this.count = 0u;
        unsafe {
            this.head = (list_node<T>*)0;
            this.tail = (list_node<T>*)0;
        }
    }

    public unsafe void push_back(T value) {
        list_node<T>* node = this.make_node(value);
        node.previous = this.tail;
        if (this.count == 0u) {
            this.head = node;
        } else {
            this.tail.next = node;
        }
        this.tail = node;
        this.count = this.count + 1u;
    }

    public unsafe void push_front(T value) {
        list_node<T>* node = this.make_node(value);
        node.next = this.head;
        if (this.count == 0u) {
            this.tail = node;
        } else {
            this.head.previous = node;
        }
        this.head = node;
        this.count = this.count + 1u;
    }

    public unsafe T pop_front() {
        Debug.assert(this.count > 0u, "linked_list::pop_front - list is empty");
        list_node<T>* node = this.head;
        T value = node.value;
        this.unlink(node);
        return value;
    }

    public unsafe T pop_back() {
        Debug.assert(this.count > 0u, "linked_list::pop_back - list is empty");
        list_node<T>* node = this.tail;
        T value = node.value;
        this.unlink(node);
        return value;
    }

    public unsafe T front() {
        Debug.assert(this.count > 0u, "linked_list::front - list is empty");
        return this.head.value;
    }

    public unsafe T back() {
        Debug.assert(this.count > 0u, "linked_list::back - list is empty");
        return this.tail.value;
    }

    public unsafe T get(size index) {
        Debug.assert(index < this.count, "linked_list::get - index out of bounds");
        return this.node_at(index).value;
    }

    public unsafe bool remove(T value) {
        mut list_node<T>* node = this.head;
        for (mut size i = 0u; i < this.count; i = i + 1u) {
            if (node.value == value) {
                this.unlink(node);
                return true;
            }
            node = node.next;
        }
        return false;
    }

    public unsafe bool contains(T value) {
        mut list_node<T>* node = this.head;
        for (mut size i = 0u; i < this.count; i = i + 1u) {
            if (node.value == value) {
                return true;
            }
            node = node.next;
        }
        return false;
    }

    public unsafe array<T> to_array() {
        array<T> result = array<T>();
        result.reserve(this.count);
        mut list_node<T>* node = this.head;
        for (mut size i = 0u; i < this.count; i = i + 1u) {
            result.push(node.value);
            node = node.next;
        }
        return result;
    }

    public size length() {
        return this.count;
    }

    public bool is_empty() {
        return this.count == 0u;
    }

    public unsafe void clear() {
        while (this.count > 0u) {
            this.unlink(this.head);
        }
    }

    public unsafe void disposable() {
        this.clear();
    }

    private unsafe list_node<T>* make_node(T value) {
        list_node<T>* node = (list_node<T>*)__djinn_alloc(sizeof(list_node<T>));
        node.value = value;
        node.previous = (list_node<T>*)0;
        node.next = (list_node<T>*)0;
        return node;
    }

    private unsafe list_node<T>* node_at(size index) {
        mut list_node<T>* node = this.head;
        for (mut size i = 0u; i < index; i = i + 1u) {
            node = node.next;
        }
        return node;
    }

    private unsafe void unlink(list_node<T>* node) {
        if (this.count == 1u) {
            this.head = (list_node<T>*)0;
            this.tail = (list_node<T>*)0;
        } else if (node == this.head) {
            this.head = node.next;
            this.head.previous = (list_node<T>*)0;
        } else if (node == this.tail) {
            this.tail = node.previous;
            this.tail.next = (list_node<T>*)0;
        } else {
            node.previous.next = node.next;
            node.next.previous = node.previous;
        }
        this.count = this.count - 1u;
        __djinn_free((void*)node);
    }
}
