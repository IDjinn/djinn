import std::types;
import std::types::constraints;

namespace std::collections;

struct priority_queue<T>
    where T : Hashable, Equatable
{

    array<T> heap;

    priority_queue() {
        this.heap = array<T>();
    }

    public unsafe void push(T value) {
        this.heap.push(value);
        mut u32w child = (u32w)this.heap.length() - 1w;
        while (child > 0w) {
            u32w parent = (child - 1w) / 4w;
            if (!(this.heap.get((size)child) < this.heap.get((size)parent))) {
                return;
            }
            this.swap(child, parent);
            child = parent;
        }
    }

    public unsafe T pop() {
        T top = this.heap.first();
        T last = this.heap.pop();
        u32w count = (u32w)this.heap.length();
        if (count == 0w) {
            return top;
        }
        this.heap.set(0u, last);
        mut u32w root = 0w;
        while (true) {
            u32w first = root * 4w + 1w;
            if (first >= count) {
                break;
            }
            mut u32w smallest = first;
            mut u32w end = first + 4w;
            if (end > count) {
                end = count;
            }
            for (mut u32w child = first + 1w; child < end; child = child + 1w) {
                if (this.heap.get((size)child) < this.heap.get((size)smallest)) {
                    smallest = child;
                }
            }
            if (!(this.heap.get((size)smallest) < this.heap.get((size)root))) {
                break;
            }
            this.swap(root, smallest);
            root = smallest;
        }
        return top;
    }

    public unsafe T peek() {
        return this.heap.first();
    }

    public size length() {
        return this.heap.length();
    }

    public bool is_empty() {
        return this.heap.length() == 0u;
    }

    public void clear() {
        this.heap.clear();
    }

    private unsafe void swap(u32w a, u32w b) {
        T held = this.heap.get((size)a);
        this.heap.set((size)a, this.heap.get((size)b));
        this.heap.set((size)b, held);
    }
}
