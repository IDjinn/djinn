import std::types;
import std::types::constraints;

namespace std::collections;

struct set<T>
    where T : Hashable, Equatable
{
    map<T, i8> items;

    set() {
        this.items = map<T, i8>();
    }

    public unsafe bool add(T value) {
        if (this.items.has(value)) {
            return false;
        }
        this.items.set(value, 1);
        return true;
    }

    public unsafe bool has(T value) {
        return this.items.has(value);
    }

    public unsafe bool remove(T value) {
        return this.items.remove(value);
    }

    public size length() {
        return this.items.length();
    }

    public bool is_empty() {
        return this.items.length() == 0u;
    }

    public unsafe void clear() {
        this.items.clear();
    }

    public unsafe array<T> to_array() {
        return this.items.keys();
    }
}
