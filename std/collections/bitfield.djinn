import std::types;
import std::debug;

namespace std::collections;

// A fixed set of up to 1024 flags indexed by T (an enum or an integer). It owns no heap memory, so it can live in a
// constexpr or consteval evaluation and in a constant. Flag values are the indexes 0..1023.
constexpr struct bitfield<T> : Hashable {
    u64 w0;
    u64 w1;
    u64 w2;
    u64 w3;
    u64 w4;
    u64 w5;
    u64 w6;
    u64 w7;
    u64 w8;
    u64 w9;
    u64 w10;
    u64 w11;
    u64 w12;
    u64 w13;
    u64 w14;
    u64 w15;

    bitfield() {
        this.w0 = 0;
        this.w1 = 0;
        this.w2 = 0;
        this.w3 = 0;
        this.w4 = 0;
        this.w5 = 0;
        this.w6 = 0;
        this.w7 = 0;
        this.w8 = 0;
        this.w9 = 0;
        this.w10 = 0;
        this.w11 = 0;
        this.w12 = 0;
        this.w13 = 0;
        this.w14 = 0;
        this.w15 = 0;
    }

    public size capacity() {
        return 1024u;
    }

    private u64 word(size index) {
        switch (index) {
            case 0u: return this.w0;
            case 1u: return this.w1;
            case 2u: return this.w2;
            case 3u: return this.w3;
            case 4u: return this.w4;
            case 5u: return this.w5;
            case 6u: return this.w6;
            case 7u: return this.w7;
            case 8u: return this.w8;
            case 9u: return this.w9;
            case 10u: return this.w10;
            case 11u: return this.w11;
            case 12u: return this.w12;
            case 13u: return this.w13;
            case 14u: return this.w14;
            default: return this.w15;
        }
    }

    private void put(size index, u64 value) {
        switch (index) {
            case 0u: this.w0 = value; break;
            case 1u: this.w1 = value; break;
            case 2u: this.w2 = value; break;
            case 3u: this.w3 = value; break;
            case 4u: this.w4 = value; break;
            case 5u: this.w5 = value; break;
            case 6u: this.w6 = value; break;
            case 7u: this.w7 = value; break;
            case 8u: this.w8 = value; break;
            case 9u: this.w9 = value; break;
            case 10u: this.w10 = value; break;
            case 11u: this.w11 = value; break;
            case 12u: this.w12 = value; break;
            case 13u: this.w13 = value; break;
            case 14u: this.w14 = value; break;
            default: this.w15 = value; break;
        }
    }

    public void set(T flag) {
        size index = (size)flag;
        Debug.assert(index < 1024u, "bitfield::set - flag out of range");
        this.put(index / 64u, this.word(index / 64u) | (1 << (u64)(index % 64u)));
    }

    public void clear(T flag) {
        size index = (size)flag;
        Debug.assert(index < 1024u, "bitfield::clear - flag out of range");
        this.put(index / 64u, this.word(index / 64u) & ~(1 << (u64)(index % 64u)));
    }

    public void flip(T flag) {
        size index = (size)flag;
        Debug.assert(index < 1024u, "bitfield::flip - flag out of range");
        this.put(index / 64u, this.word(index / 64u) ^ (1 << (u64)(index % 64u)));
    }

    public bool test(T flag) {
        size index = (size)flag;
        Debug.assert(index < 1024u, "bitfield::test - flag out of range");
        return ((this.word(index / 64u) >> (u64)(index % 64u)) & 1) != 0;
    }

    public size count() {
        mut size total = 0u;
        for (mut size i = 0u; i < 16u; i = i + 1u) {
            mut u64w word = (u64w)this.word(i);
            while (word != 0w) {
                word = word & (word - 1w);
                total = total + 1u;
            }
        }
        return total;
    }

    public bool any() {
        return this.count() != 0u;
    }

    public bool none() {
        return this.count() == 0u;
    }

    public void clear_all() {
        this.w0 = 0;
        this.w1 = 0;
        this.w2 = 0;
        this.w3 = 0;
        this.w4 = 0;
        this.w5 = 0;
        this.w6 = 0;
        this.w7 = 0;
        this.w8 = 0;
        this.w9 = 0;
        this.w10 = 0;
        this.w11 = 0;
        this.w12 = 0;
        this.w13 = 0;
        this.w14 = 0;
        this.w15 = 0;
    }

    // Set the flags 0..1023 / drop all flags / complement every flag.
    public void set_all() {
        for (mut size i = 0u; i < 16u; i = i + 1u) {
            this.put(i, ~(u64)0);
        }
    }

    public void invert() {
        for (mut size i = 0u; i < 16u; i = i + 1u) {
            this.put(i, ~this.word(i));
        }
    }

    // In-place set algebra with another bitfield.
    public void union_with(bitfield<T> other) {
        for (mut size i = 0u; i < 16u; i = i + 1u) {
            this.put(i, this.word(i) | other.word(i));
        }
    }

    public void intersect_with(bitfield<T> other) {
        for (mut size i = 0u; i < 16u; i = i + 1u) {
            this.put(i, this.word(i) & other.word(i));
        }
    }

    public void subtract(bitfield<T> other) {
        for (mut size i = 0u; i < 16u; i = i + 1u) {
            this.put(i, this.word(i) & ~other.word(i));
        }
    }

    public void xor_with(bitfield<T> other) {
        for (mut size i = 0u; i < 16u; i = i + 1u) {
            this.put(i, this.word(i) ^ other.word(i));
        }
    }

    public void assign(bitfield<T> other) {
        for (mut size i = 0u; i < 16u; i = i + 1u) {
            this.put(i, other.word(i));
        }
    }

    public bitfield<T> copy() {
        mut bitfield<T> result = bitfield<T>();
        result.assign(*this);
        return result;
    }

    // Queries against another bitfield.
    public bool intersects(bitfield<T> other) {
        for (mut size i = 0u; i < 16u; i = i + 1u) {
            if ((this.word(i) & other.word(i)) != 0) {
                return true;
            }
        }
        return false;
    }

    public bool is_subset_of(bitfield<T> other) {
        for (mut size i = 0u; i < 16u; i = i + 1u) {
            if ((this.word(i) & ~other.word(i)) != 0) {
                return false;
            }
        }
        return true;
    }

    public bool contains_all(bitfield<T> other) {
        return other.is_subset_of(*this);
    }

    public bool equals(bitfield<T> other) {
        for (mut size i = 0u; i < 16u; i = i + 1u) {
            if (this.word(i) != other.word(i)) {
                return false;
            }
        }
        return true;
    }

    // Total order: the bitfield read as a 1024-bit unsigned number (flag 1023 is the most significant bit).
    public i32 compare(bitfield<T> other) {
        for (mut i32 i = 15; i >= 0; i = i - 1) {
            u64 mine = this.word((size)i);
            u64 theirs = other.word((size)i);
            if (mine != theirs) {
                if (mine < theirs) {
                    return -1;
                }
                return 1;
            }
        }
        return 0;
    }

    public u64 hash() {
        mut u64w result = 17w;
        for (mut size i = 0u; i < 16u; i = i + 1u) {
            u64 item = this.word(i);
            result = 31w * result + (u64w)(item ^ (item >> 32));
        }
        return (u64)result;
    }

    // Lowest set flag index at or after `from`, or -1 when there is none. Iterate with
    // `for (i32 i = f.next_set(0); i >= 0; i = f.next_set(i + 1))`.
    public i32 next_set(i32 from) {
        mut i32 index = from;
        if (index < 0) {
            index = 0;
        }
        while (index < 1024) {
            if (this.word((size)index / 64u) >> (u64)((size)index % 64u) == 0) {
                index = (index / 64 + 1) * 64;
            } else {
                if (((this.word((size)index / 64u) >> (u64)((size)index % 64u)) & 1) != 0) {
                    return index;
                }
                index = index + 1;
            }
        }
        return -1;
    }

    public i32 first_set() {
        return this.next_set(0);
    }

    operator==(bitfield<T> left, bitfield<T> right) -> bool {
        return left.equals(right);
    }

    operator!=(bitfield<T> left, bitfield<T> right) -> bool {
        return !left.equals(right);
    }

    operator<(bitfield<T> left, bitfield<T> right) -> bool {
        return left.compare(right) < 0;
    }

    operator>(bitfield<T> left, bitfield<T> right) -> bool {
        return left.compare(right) > 0;
    }

    operator<=(bitfield<T> left, bitfield<T> right) -> bool {
        return left.compare(right) <= 0;
    }

    operator>=(bitfield<T> left, bitfield<T> right) -> bool {
        return left.compare(right) >= 0;
    }

    operator|(bitfield<T> left, bitfield<T> right) -> bitfield<T> {
        mut bitfield<T> result = left.copy();
        result.union_with(right);
        return result;
    }

    operator&(bitfield<T> left, bitfield<T> right) -> bitfield<T> {
        mut bitfield<T> result = left.copy();
        result.intersect_with(right);
        return result;
    }

    operator^(bitfield<T> left, bitfield<T> right) -> bitfield<T> {
        mut bitfield<T> result = left.copy();
        result.xor_with(right);
        return result;
    }
}
