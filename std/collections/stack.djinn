import std::types;
import std::types::constraints;

namespace std::collections;

struct stack<T>
    where T : Hashable, Equatable
{
    array<T> items;

    stack() {
        this.items = array<T>();
    }

    public unsafe void push(T value) {
        this.items.push(value);
    }

    public unsafe T pop() {
        return this.items.pop();
    }

    public unsafe T peek() {
        return this.items.last();
    }

    public size length() {
        return this.items.length();
    }

    public bool is_empty() {
        return this.items.length() == 0u;
    }

    public void clear() {
        this.items.clear();
    }
}
