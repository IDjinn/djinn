import std::types;
import std::libc;
import std::debug;

namespace std::collections;

struct slice<T> {
    T* data;
    size length;

    public size length() {
        return this.length;
    }

    public bool is_empty() {
        return this.length == 0u;
    }

    operator get[](slice<T> view, size index) -> T {
        Debug.assert(index < view.length, "slice::get[] - index out of bounds");
        unsafe {
            return view.data[index];
        }
    }

    public unsafe T get(size index) {
        Debug.assert(index < this.length, "slice::get - index out of bounds");
        return this.data[index];
    }

    public unsafe void set(size index, T value) {
        Debug.assert(index < this.length, "slice::set - index out of bounds");
        this.data[index] = value;
    }

    public unsafe slice<T> sub(size start, size length) {
        Debug.assert(start <= this.length, "slice::sub - start out of bounds");
        Debug.assert(length <= this.length - start, "slice::sub - length out of bounds");
        slice<T> view = { .data = &this.data[start], .length = length };
        return view;
    }

    public unsafe void reverse() {
        if (this.length < 2u) {
            return;
        }
        mut u32w low = 0w;
        mut u32w high = (u32w)this.length - 1w;
        while (low < high) {
            T swap = this.data[low];
            this.data[low] = this.data[high];
            this.data[high] = swap;
            low = low + 1w;
            high = high - 1w;
        }
    }
}
