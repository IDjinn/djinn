import std::types;

namespace std::collections;

struct Sorting {
    public static unsafe void sort<T>(slice<T> view) {
        u32w length = (u32w)view.length();
        if (length < 2w) {
            return;
        }
        if (length <= 16w) {
            Sorting.insertion_sort(view, 0w, length);
            return;
        }
        mut u32w start = length / 2w;
        while (start > 0w) {
            start = start - 1w;
            Sorting.sift_down(view, start, length);
        }
        mut u32w end = length;
        while (end > 1w) {
            end = end - 1w;
            T top = view.data[0];
            view.data[0] = view.data[end];
            view.data[end] = top;
            Sorting.sift_down(view, 0w, end);
        }
    }

    public static unsafe bool is_sorted<T>(slice<T> view) {
        u32w length = (u32w)view.length();
        for (mut u32w i = 1w; i < length; i = i + 1w) {
            if (view.data[i] < view.data[i - 1w]) {
                return false;
            }
        }
        return true;
    }

    public static unsafe i32 binary_search<T>(slice<T> view, T value) {
        mut u32w low = 0w;
        mut u32w high = (u32w)view.length();
        while (low < high) {
            u32w middle = low + (high - low) / 2w;
            T candidate = view.data[middle];
            if (candidate < value) {
                low = middle + 1w;
            } else if (value < candidate) {
                high = middle;
            } else {
                return (i32)middle;
            }
        }
        return -1;
    }

    static unsafe void insertion_sort<T>(slice<T> view, u32w from, u32w to) {
        mut u32w i = from + 1w;
        while (i < to) {
            T current = view.data[i];
            mut u32w j = i;
            while (j > from && current < view.data[j - 1w]) {
                view.data[j] = view.data[j - 1w];
                j = j - 1w;
            }
            view.data[j] = current;
            i = i + 1w;
        }
    }

    static unsafe void sift_down<T>(slice<T> view, u32w from, u32w count) {
        mut u32w root = from;
        while (true) {
            u32w left = root * 2w + 1w;
            if (left >= count) {
                return;
            }
            mut u32w largest = root;
            if (view.data[largest] < view.data[left]) {
                largest = left;
            }
            u32w right = left + 1w;
            if (right < count && view.data[largest] < view.data[right]) {
                largest = right;
            }
            if (largest == root) {
                return;
            }
            T swap = view.data[root];
            view.data[root] = view.data[largest];
            view.data[largest] = swap;
            root = largest;
        }
    }
}
