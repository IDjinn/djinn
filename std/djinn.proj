project: "djinn-std"
version: "1.0.0"

compiler:
  library-mode: true
  no-cache: true
  reflection-mode: all
  # the std is built with IEEE 754-2019 semantics whatever a program that uses it selects (a program's --ieee754=none
  # reaches only its own code and the generics it instantiates)
  ieee754: "2019"
  fp-env: "default"

  output:
    file: "std.djlib"
    directory: "build"
    run-after-compile: false

  logger:
    level: 'INFO'

  generator:
    optimization-level: 2

  libs: [ ]
