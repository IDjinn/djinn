namespace std::text;

struct Chars {
    public static constexpr bool is_digit(char value) {
        return value >= '0' && value <= '9';
    }

    public static constexpr bool is_upper(char value) {
        return value >= 'A' && value <= 'Z';
    }

    public static constexpr bool is_lower(char value) {
        return value >= 'a' && value <= 'z';
    }

    public static constexpr bool is_alpha(char value) {
        return Chars.is_upper(value) || Chars.is_lower(value);
    }

    public static constexpr bool is_alnum(char value) {
        return Chars.is_alpha(value) || Chars.is_digit(value);
    }

    public static constexpr bool is_hex_digit(char value) {
        return Chars.is_digit(value) || (value >= 'a' && value <= 'f') || (value >= 'A' && value <= 'F');
    }

    public static constexpr bool is_space(char value) {
        return value == ' ' || value == '\t' || value == '\n' || value == '\r';
    }

    public static constexpr char to_upper(char value) {
        if (Chars.is_lower(value)) {
            return (char)((i32)value - 32);
        }
        return value;
    }

    public static constexpr char to_lower(char value) {
        if (Chars.is_upper(value)) {
            return (char)((i32)value + 32);
        }
        return value;
    }

    public static constexpr i32 digit_value(char value) {
        if (Chars.is_digit(value)) {
            return (i32)value - 48;
        }
        if (value >= 'a' && value <= 'f') {
            return (i32)value - 87;
        }
        if (value >= 'A' && value <= 'F') {
            return (i32)value - 55;
        }
        return -1;
    }
}
