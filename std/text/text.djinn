import std::types;
import std::libc;
import std::debug;
import std::collections;

namespace std::text;

struct Text {
    public static unsafe string join(array<str>* parts, str separator) {
        string_builder builder = string_builder();
        u32w count = (u32w)parts.length();
        if (count != 0w) {
            mut u64 total = (u64)separator.length * ((u64)count - 1);
            for (mut u32w i = 0w; i < count; i = i + 1w) {
                total = total + (u64)parts.get((size)i).length;
            }
            builder.reserve((size)total);
        }
        for (mut u32w i = 0w; i < count; i = i + 1w) {
            if (i != 0w) {
                builder.append(separator);
            }
            builder.append(parts.get((size)i));
        }
        return builder.into_string();
    }

    // A heap string with a NUL terminator holding a copy of the bytes (one allocation, no builder).
    [Inline] public static unsafe string copy_of(i8* data, size length) {
        if (length == 0u) {
            return string.EMPTY();
        }
        i8* copy = __djinn_alloc((u64)length + 1);
        memcpy((void*)copy, (void*)data, (u64)length);
        *(copy + (length)) = 0;
        return { .data = copy, .length = length, .meta = StringMeta.heap() };
    }

    [Inline] public static unsafe string from_i64(i64 value) {
        i8* digits = i8[24];
        size count = Numbers.format_i64(digits, value);
        return Text.copy_of(digits, count);
    }

    [Inline] public static unsafe string from_u64(u64 value) {
        i8* digits = i8[24];
        size count = Numbers.format_u64(digits, value);
        return Text.copy_of(digits, count);
    }

    [Inline] public static unsafe string from_hex(u64 value) {
        i8* digits = i8[24];
        size count = Numbers.format_radix(digits, value, 16, false);
        return Text.copy_of(digits, count);
    }

    [Inline] public static unsafe string from_char(char value) {
        i8* bytes = i8[4];
        size count = encodeChar(bytes, value);
        return Text.copy_of(bytes, count);
    }

    public static constexpr size utf8_width(i8 lead) {
        u32 byte = (u32)(u8)lead;
        if (byte < 128) {
            return 1u;
        }
        if (byte >= 194 && byte < 224) {
            return 2u;
        }
        if (byte >= 224 && byte < 240) {
            return 3u;
        }
        if (byte >= 240 && byte < 245) {
            return 4u;
        }
        return 0u;
    }
}

interface Textual {
    str asStr();
}

impl Textual for str, string {
    [ForceInline] str asStr() {
        return { .data = this.data, .length = this.length };
    }

    [ForceInline] unsafe bool equalsC(ptr<cstring> other) {
        return this.asStr() == str.fromC(other);
    }

    [ForceInline] unsafe bool startsWithAt(size position, str prefix) {
        return position <= this.length && this.matchesAt(position, prefix);
    }

    [ForceInline] unsafe bool matchesAt(size position, str needle) {
        if (needle.length > this.length - position) {
            return false;
        }
        if (needle.length == 0u) {
            return true;
        }
        if (*(this.data + (position)) != *(needle.data + (0))) {
            return false;
        }
        return memcmp((void*)(this.data + (position)), (void*)needle.data, (size_long)needle.length) == 0;
    }

    unsafe array<str> split(str separator) {
        array<str> parts = array<str>();
        if (separator.length == 0u) {
            parts.push(this.asStr());
            return parts;
        }
        mut size start = 0u;
        mut size i = 0u;
        while (i + separator.length <= this.length) {
            if (this.matchesAt(i, separator)) {
                str piece = { .data = (this.data + (start)), .length = i - start };
                parts.push(piece);
                i = i + separator.length;
                start = i;
            } else {
                i = i + 1u;
            }
        }
        str rest = { .data = (this.data + (start)), .length = this.length - start };
        parts.push(rest);
        return parts;
    }

    unsafe array<str> splitChar(char separator) {
        return this.split(encodeCharText(separator));
    }

    unsafe i32 count(str needle) {
        if (needle.length == 0u) {
            return 0;
        }
        mut i32 found = 0;
        mut size i = 0u;
        while (i + needle.length <= this.length) {
            if (this.matchesAt(i, needle)) {
                found = found + 1;
                i = i + needle.length;
            } else {
                i = i + 1u;
            }
        }
        return found;
    }

    unsafe string replace(str from, str to) {
        string_builder builder = string_builder();
        if (from.length == 0u) {
            builder.append(this.asStr());
            return builder.into_string();
        }
        builder.reserve(this.length);
        mut size run = 0u;
        mut size i = 0u;
        while (i < this.length) {
            if (this.matchesAt(i, from)) {
                str before = { .data = (this.data + (run)), .length = i - run };
                builder.append(before);
                builder.append(to);
                i = i + from.length;
                run = i;
            } else {
                i = i + 1u;
            }
        }
        str rest = { .data = (this.data + (run)), .length = this.length - run };
        builder.append(rest);
        return builder.into_string();
    }

    unsafe str trimPrefix(str prefix) {
        if (this.matchesAt(0u, prefix)) {
            str rest = { .data = (this.data + (prefix.length)), .length = this.length - prefix.length };
            return rest;
        }
        return this.asStr();
    }

    unsafe str trimSuffix(str suffix) {
        if (suffix.length <= this.length && this.matchesAt(this.length - suffix.length, suffix)) {
            str head = { .data = this.data, .length = this.length - suffix.length };
            return head;
        }
        return this.asStr();
    }

    unsafe string padLeft(size width, char fill) {
        string_builder builder = string_builder();
        size have = this.utf8Length();
        for (mut size i = have; i < width; i = i + 1u) {
            builder.append_char(fill);
        }
        builder.append(this.asStr());
        return builder.into_string();
    }

    unsafe string padRight(size width, char fill) {
        string_builder builder = string_builder();
        builder.append(this.asStr());
        size have = this.utf8Length();
        for (mut size i = have; i < width; i = i + 1u) {
            builder.append_char(fill);
        }
        return builder.into_string();
    }

    unsafe array<str> lines() {
        array<str> parts = array<str>();
        mut size start = 0u;
        for (mut size i = 0u; i < this.length; i = i + 1u) {
            if (*(this.data + (i)) == 10) {
                mut size end = i;
                if (end > start && *(this.data + (end - 1u)) == 13) {
                    end = end - 1u;
                }
                str piece = { .data = (this.data + (start)), .length = end - start };
                parts.push(piece);
                start = i + 1u;
            }
        }
        if (start < this.length) {
            str rest = { .data = (this.data + (start)), .length = this.length - start };
            parts.push(rest);
        }
        return parts;
    }

    unsafe array<str> splitWhitespace() {
        array<str> parts = array<str>();
        mut size i = 0u;
        while (i < this.length) {
            while (i < this.length && isSpace(*(this.data + (i)))) {
                i = i + 1u;
            }
            if (i >= this.length) {
                break;
            }
            size start = i;
            while (i < this.length && !isSpace(*(this.data + (i)))) {
                i = i + 1u;
            }
            str piece = { .data = (this.data + (start)), .length = i - start };
            parts.push(piece);
        }
        return parts;
    }

    unsafe string repeat(size times) {
        string_builder builder = string_builder();
        if (times != 0u && this.length != 0u && (u64)times <= u64.MAX_VALUE / (u64)this.length) {
            builder.reserve(this.length * times);
        }
        for (mut size i = 0u; i < times; i = i + 1u) {
            builder.append(this.asStr());
        }
        return builder.into_string();
    }

    unsafe string toUpper() {
        if (this.length == 0u) {
            return string.EMPTY();
        }
        i8* out = __djinn_alloc((u64)this.length + 1);
        for (mut size i = 0u; i < this.length; i = i + 1u) {
            i8 value = *(this.data + (i));
            if (value >= 97 && value <= 122) {
                *(out + (i)) = value - 32;
            } else {
                *(out + (i)) = value;
            }
        }
        *(out + (this.length)) = 0;
        return { .data = out, .length = this.length, .meta = StringMeta.heap() };
    }

    unsafe string toLower() {
        if (this.length == 0u) {
            return string.EMPTY();
        }
        i8* out = __djinn_alloc((u64)this.length + 1);
        for (mut size i = 0u; i < this.length; i = i + 1u) {
            i8 value = *(this.data + (i));
            if (value >= 65 && value <= 90) {
                *(out + (i)) = value + 32;
            } else {
                *(out + (i)) = value;
            }
        }
        *(out + (this.length)) = 0;
        return { .data = out, .length = this.length, .meta = StringMeta.heap() };
    }

    unsafe optional<i64> parseI64() {
        return Numbers.parse_i64(this.data, this.length);
    }

    unsafe optional<u64> parseU64() {
        return Numbers.parse_u64(this.data, this.length, 10);
    }

    unsafe optional<u64> parseHex() {
        return Numbers.parse_u64(this.data, this.length, 16);
    }

    unsafe optional<f64> parseF64() {
        return Numbers.parse_f64(this.data, this.length);
    }

    [ForceInline] unsafe bool isValidUtf8() {
        return Utf8.is_valid(this.data, this.length);
    }

    unsafe size utf8Length() {
        mut size count = 0u;
        mut size i = 0u;
        while (i < this.length) {
            mut size width = Text.utf8_width(*(this.data + (i)));
            if (width == 0u) {
                width = 1u;
            }
            i = i + width;
            count = count + 1u;
        }
        return count;
    }

    [ForceInline] unsafe char utf8At(size byteIndex) {
        Debug.assert(byteIndex < this.length, "utf8At - index out of bounds");
        size width = Text.utf8_width(*(this.data + (byteIndex)));
        Debug.assert(width != 0u && width <= this.length - byteIndex, "utf8At - invalid utf-8 sequence");
        u32 lead = (u32)(u8)*(this.data + (byteIndex));
        if (width == 1u) {
            return (char)lead;
        }
        mut u32 code = lead & (255 >> (width + 1u));
        for (mut size k = 1u; k < width; k = k + 1u) {
            code = (code << 6) | ((u32)(u8)*(this.data + (byteIndex + k)) & 63);
        }
        return (char)code;
    }
}
