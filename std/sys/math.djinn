import std::types;
namespace std::math;

extern "C" {
    // Trigonometric functions
    f64 sin(f64 x);
    f64 cos(f64 x);
    f64 tan(f64 x);
    f64 asin(f64 x);
    f64 acos(f64 x);
    f64 atan(f64 x);
    f64 atan2(f64 y, f64 x);

    // Hyperbolic functions
    f64 sinh(f64 x);
    f64 cosh(f64 x);
    f64 tanh(f64 x);
    f64 asinh(f64 x);
    f64 acosh(f64 x);
    f64 atanh(f64 x);

    // Exponential and logarithmic functions
    f64 exp(f64 x);
    f64 exp2(f64 x);
    f64 expm1(f64 x);
    f64 log(f64 x);
    f64 log10(f64 x);
    f64 log2(f64 x);
    f64 log1p(f64 x);

    // Power functions
    f64 pow(f64 base, f64 exponent);
    f64 sqrt(f64 x);
    f64 cbrt(f64 x);
    f64 hypot(f64 x, f64 y);

    // Rounding and remainder functions
    f64 ceil(f64 x);
    f64 floor(f64 x);
    f64 trunc(f64 x);
    f64 round(f64 x);
    f64 fmod(f64 x, f64 y);
    f64 remainder(f64 x, f64 y);

    // Absolute value
    f64 fabs(f64 x);

    // Min/Max
    f64 fmax(f64 x, f64 y);
    f64 fmin(f64 x, f64 y);

    // Error and gamma functions
    f64 erf(f64 x);
    f64 erfc(f64 x);
    f64 tgamma(f64 x);
    f64 lgamma(f64 x);

    // Float versions (32-bit)
    f32 sinf(f32 x);
    f32 cosf(f32 x);
    f32 tanf(f32 x);
    f32 asinf(f32 x);
    f32 acosf(f32 x);
    f32 atanf(f32 x);
    f32 atan2f(f32 y, f32 x);
    f32 sinhf(f32 x);
    f32 coshf(f32 x);
    f32 tanhf(f32 x);
    f32 expf(f32 x);
    f32 logf(f32 x);
    f32 log10f(f32 x);
    f32 powf(f32 base, f32 exponent);
    f32 sqrtf(f32 x);
    f32 cbrtf(f32 x);
    f32 ceilf(f32 x);
    f32 floorf(f32 x);
    f32 truncf(f32 x);
    f32 roundf(f32 x);
    f32 fmodf(f32 x, f32 y);
    f32 fabsf(f32 x);
    f32 fmaxf(f32 x, f32 y);
    f32 fminf(f32 x, f32 y);
}

struct Math {
    const f64 PI = 3.14159265358979323846;
    const f64 TAU = 6.28318530717958647692;
    const f64 HALF_PI = 1.57079632679489661923;
    const f64 EULER_NUMBER = 2.71828182845904523536;
    const f64 SQUARE_ROOT_OF_TWO = 1.41421356237309504880;
    const f64 NATURAL_LOG_OF_TWO = 0.69314718055994530942;
    const f64 NATURAL_LOG_OF_TEN = 2.30258509299404568402;
    const f64 DEGREES_TO_RADIANS = 0.01745329251994329577;
    const f64 RADIANS_TO_DEGREES = 57.29577951308232087680;

    public static f64 abs(f64 x) {
        return fabs(x);
    }

    public static i32 abs(i32 x) {
        if (x < 0) { return 0 - x; }
        return x;
    }

    public static f64 min(f64 a, f64 b) {
        return fmin(a, b);
    }

    public static f64 max(f64 a, f64 b) {
        return fmax(a, b);
    }

    public static i32 min(i32 a, i32 b) {
        if (a < b) { return a; }
        return b;
    }

    public static i32 max(i32 a, i32 b) {
        if (a > b) { return a; }
        return b;
    }

    public static f64 clamp(f64 value, f64 low, f64 high) {
        return fmin(fmax(value, low), high);
    }

    public static i32 clamp(i32 value, i32 low, i32 high) {
        return Math.min(Math.max(value, low), high);
    }

    public static f64 lerp(f64 from, f64 to, f64 t) {
        return from + (to - from) * t;
    }

    public static f64 sign(f64 x) {
        if (x > 0.0) { return 1.0; }
        if (x < 0.0) { return -1.0; }
        return 0.0;
    }

    public static f64 toRadians(f64 degrees) {
        return degrees * Math.DEGREES_TO_RADIANS;
    }

    public static f64 toDegrees(f64 radians) {
        return radians * Math.RADIANS_TO_DEGREES;
    }
}
