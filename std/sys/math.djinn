import std::types;
import std::types::constraints;
import std::math::native;
namespace std::math;

struct Math {
    const f64 PI = 3.14159265358979323846;
    const f64 TAU = 6.28318530717958647692;
    const f64 HALF_PI = 1.57079632679489661923;
    const f64 EULER_NUMBER = 2.71828182845904523536;
    const f64 SQUARE_ROOT_OF_TWO = 1.41421356237309504880;
    const f64 NATURAL_LOG_OF_TWO = 0.69314718055994530942;
    const f64 NATURAL_LOG_OF_TEN = 2.30258509299404568402;
    const f64 DEGREES_TO_RADIANS = 0.01745329251994329577;
    const f64 RADIANS_TO_DEGREES = 57.29577951308232087680;

    [ForceInline] public static constexpr bool isNaN(f64 x) {
        return x.isNaN();
    }

    [ForceInline] public static constexpr bool isInfinity(f64 x) {
        return (float_bits(x) & f64.MAGNITUDE_MASK) == f64.INFINITY_BITS;
    }

    [ForceInline] public static constexpr bool isFinite(f64 x) {
        return (float_bits(x) & f64.INFINITY_BITS) != f64.INFINITY_BITS;
    }

    [ForceInline] public static constexpr bool signBit(f64 x) {
        return x.signBit();
    }

    [ForceInline] public static constexpr f64 truncate(f64 x) {
        if (!(x > -f64.WHOLE_NUMBER_LIMIT && x < f64.WHOLE_NUMBER_LIMIT)) { return x; }
        return (f64)(i64)x;
    }

    [ForceInline] public static constexpr f64 floor(f64 x) {
        mut f64 whole = Math.truncate(x);
        if (whole > x) { whole = whole - 1.0; }
        return whole;
    }

    [ForceInline] public static constexpr f64 ceiling(f64 x) {
        mut f64 whole = Math.truncate(x);
        if (whole < x) { whole = whole + 1.0; }
        return whole;
    }

    [ForceInline] public static constexpr f64 round(f64 x) {
        mut f64 whole = Math.truncate(x);
        f64 fraction = x - whole;
        if (fraction >= 0.5) { whole = whole + 1.0; }
        if (fraction <= -0.5) { whole = whole - 1.0; }
        return whole;
    }

    [ForceInline] public static constexpr f64 fraction(f64 x) {
        return x - Math.truncate(x);
    }

    [ForceInline] public static constexpr f64 remainder(f64 x, f64 y) {
        return remainder(x, y);
    }

    [ForceInline] public static f64 truncatedRemainder(f64 x, f64 y) {
        return x % y;
    }

    [ForceInline] public static constexpr f64 lerp(f64 from, f64 to, f64 t) {
        return from + (to - from) * t;
    }

    [ForceInline] public static f64 toRadians(f64 degrees) {
        return degrees * Math.DEGREES_TO_RADIANS;
    }

    [ForceInline] public static f64 toDegrees(f64 radians) {
        return radians * Math.RADIANS_TO_DEGREES;
    }

    [ForceInline] public static constexpr f64 sin(f64 x) {
        return sin(x);
    }

    [ForceInline] public static constexpr f64 cos(f64 x) {
        return cos(x);
    }

    [ForceInline] public static constexpr f64 tan(f64 x) {
        return tan(x);
    }

    [ForceInline] public static constexpr f64 arcSin(f64 x) {
        return asin(x);
    }

    [ForceInline] public static constexpr f64 arcCos(f64 x) {
        return acos(x);
    }

    [ForceInline] public static constexpr f64 arcTan(f64 x) {
        return atan(x);
    }

    [ForceInline] public static constexpr f64 sinh(f64 x) {
        return sinh(x);
    }

    [ForceInline] public static constexpr f64 cosh(f64 x) {
        return cosh(x);
    }

    [ForceInline] public static constexpr f64 tanh(f64 x) {
        return tanh(x);
    }

    [ForceInline] public static constexpr f64 arcSinh(f64 x) {
        return asinh(x);
    }

    [ForceInline] public static constexpr f64 arcCosh(f64 x) {
        return acosh(x);
    }

    [ForceInline] public static constexpr f64 arcTanh(f64 x) {
        return atanh(x);
    }

    [ForceInline] public static constexpr f64 exp(f64 x) {
        return exp(x);
    }

    [ForceInline] public static constexpr f64 pow2(f64 x) {
        return exp2(x);
    }

    [ForceInline] public static constexpr f64 expMinusOne(f64 x) {
        return expm1(x);
    }

    [ForceInline] public static constexpr f64 log(f64 x) {
        return log(x);
    }

    [ForceInline] public static constexpr f64 log10(f64 x) {
        return log10(x);
    }

    [ForceInline] public static constexpr f64 log2(f64 x) {
        return log2(x);
    }

    [ForceInline] public static constexpr f64 logOnePlus(f64 x) {
        return log1p(x);
    }

    [ForceInline] public static constexpr f64 sqrt(f64 x) {
        return sqrt(x);
    }

    [ForceInline] public static constexpr f64 cubeRoot(f64 x) {
        return cbrt(x);
    }

    [ForceInline] public static constexpr f64 arcTan2(f64 a, f64 b) {
        return atan2(a, b);
    }

    [ForceInline] public static constexpr f64 pow(f64 a, f64 b) {
        return pow(a, b);
    }

    [ForceInline] public static constexpr f64 hypotenuse(f64 a, f64 b) {
        return hypot(a, b);
    }

    [ForceInline] public static constexpr f64 errorFunction(f64 x) {
        return erf(x);
    }

    [ForceInline] public static constexpr f64 complementaryErrorFunction(f64 x) {
        return erfc(x);
    }

    [ForceInline] public static constexpr f64 gamma(f64 x) {
        return tgamma(x);
    }

    [ForceInline] public static constexpr f64 logGamma(f64 x) {
        return lgamma(x);
    }

    [ForceInline] public static constexpr bool isNaN(f32 x) {
        return x.isNaN();
    }

    [ForceInline] public static constexpr bool isInfinity(f32 x) {
        return (float_bits(x) & f32.MAGNITUDE_MASK) == f32.INFINITY_BITS;
    }

    [ForceInline] public static constexpr bool isFinite(f32 x) {
        return (float_bits(x) & f32.INFINITY_BITS) != f32.INFINITY_BITS;
    }

    [ForceInline] public static constexpr bool signBit(f32 x) {
        return x.signBit();
    }

    [ForceInline] public static constexpr f32 truncate(f32 x) {
        if (!(x > -f32.WHOLE_NUMBER_LIMIT && x < f32.WHOLE_NUMBER_LIMIT)) { return x; }
        return (f32)(i32)x;
    }

    [ForceInline] public static constexpr f32 floor(f32 x) {
        mut f32 whole = Math.truncate(x);
        if (whole > x) { whole = whole - 1.0; }
        return whole;
    }

    [ForceInline] public static constexpr f32 ceiling(f32 x) {
        mut f32 whole = Math.truncate(x);
        if (whole < x) { whole = whole + 1.0; }
        return whole;
    }

    [ForceInline] public static constexpr f32 round(f32 x) {
        mut f32 whole = Math.truncate(x);
        f32 fraction = x - whole;
        if (fraction >= 0.5) { whole = whole + 1.0; }
        if (fraction <= -0.5) { whole = whole - 1.0; }
        return whole;
    }

    [ForceInline] public static constexpr f32 fraction(f32 x) {
        return x - Math.truncate(x);
    }

    [ForceInline] public static constexpr f32 remainder(f32 x, f32 y) {
        return (f32)remainder((f64)x, (f64)y);
    }

    [ForceInline] public static f32 truncatedRemainder(f32 x, f32 y) {
        return x % y;
    }

    [ForceInline] public static constexpr f32 lerp(f32 from, f32 to, f32 t) {
        return from + (to - from) * t;
    }

    [ForceInline] public static f32 toRadians(f32 degrees) {
        return (f32)((f64)degrees * Math.DEGREES_TO_RADIANS);
    }

    [ForceInline] public static f32 toDegrees(f32 radians) {
        return (f32)((f64)radians * Math.RADIANS_TO_DEGREES);
    }

    [ForceInline] public static constexpr f32 sin(f32 x) {
        return (f32)sin((f64)x);
    }

    [ForceInline] public static constexpr f32 cos(f32 x) {
        return (f32)cos((f64)x);
    }

    [ForceInline] public static constexpr f32 tan(f32 x) {
        return (f32)tan((f64)x);
    }

    [ForceInline] public static constexpr f32 arcSin(f32 x) {
        return (f32)asin((f64)x);
    }

    [ForceInline] public static constexpr f32 arcCos(f32 x) {
        return (f32)acos((f64)x);
    }

    [ForceInline] public static constexpr f32 arcTan(f32 x) {
        return (f32)atan((f64)x);
    }

    [ForceInline] public static constexpr f32 sinh(f32 x) {
        return (f32)sinh((f64)x);
    }

    [ForceInline] public static constexpr f32 cosh(f32 x) {
        return (f32)cosh((f64)x);
    }

    [ForceInline] public static constexpr f32 tanh(f32 x) {
        return (f32)tanh((f64)x);
    }

    [ForceInline] public static constexpr f32 arcSinh(f32 x) {
        return (f32)asinh((f64)x);
    }

    [ForceInline] public static constexpr f32 arcCosh(f32 x) {
        return (f32)acosh((f64)x);
    }

    [ForceInline] public static constexpr f32 arcTanh(f32 x) {
        return (f32)atanh((f64)x);
    }

    [ForceInline] public static constexpr f32 exp(f32 x) {
        return (f32)exp((f64)x);
    }

    [ForceInline] public static constexpr f32 pow2(f32 x) {
        return (f32)exp2((f64)x);
    }

    [ForceInline] public static constexpr f32 expMinusOne(f32 x) {
        return (f32)expm1((f64)x);
    }

    [ForceInline] public static constexpr f32 log(f32 x) {
        return (f32)log((f64)x);
    }

    [ForceInline] public static constexpr f32 log10(f32 x) {
        return (f32)log10((f64)x);
    }

    [ForceInline] public static constexpr f32 log2(f32 x) {
        return (f32)log2((f64)x);
    }

    [ForceInline] public static constexpr f32 logOnePlus(f32 x) {
        return (f32)log1p((f64)x);
    }

    [ForceInline] public static constexpr f32 sqrt(f32 x) {
        return (f32)sqrt((f64)x);
    }

    [ForceInline] public static constexpr f32 cubeRoot(f32 x) {
        return (f32)cbrt((f64)x);
    }

    [ForceInline] public static constexpr f32 arcTan2(f32 a, f32 b) {
        return (f32)atan2((f64)a, (f64)b);
    }

    [ForceInline] public static constexpr f32 pow(f32 a, f32 b) {
        return (f32)pow((f64)a, (f64)b);
    }

    [ForceInline] public static constexpr f32 hypotenuse(f32 a, f32 b) {
        return (f32)hypot((f64)a, (f64)b);
    }

    [ForceInline] public static constexpr T min<T>(T a, T b) where T : INumber {
        return a.min(b);
    }

    [ForceInline] public static constexpr T max<T>(T a, T b) where T : INumber {
        return a.max(b);
    }

    [ForceInline] public static constexpr T clamp<T>(T value, T low, T high) where T : INumber {
        return Math.min(Math.max(value, low), high);
    }

    [ForceInline] public static constexpr T abs<T>(T x) where T : INumber {
        if (x.isNegative() || x.isZero()) { return (T)0 - x; }
        return x;
    }

    [ForceInline] public static constexpr T sign<T>(T x) where T : INumber {
        if (x.isPositive()) { return (T)1; }
        if (x.isNegative()) { return (T)0 - (T)1; }
        return x;
    }
}
