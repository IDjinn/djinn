import std::types;

namespace std::system;

extern "C" {
    void* __djinn_hook_set(i32 kind, void* handler);
    void* __djinn_hook_take(i32 kind);
    void  __djinn_panic_default_report(i8* message, i8* file, u32 line);
}

enum HookKind {
    PANIC
}

macro hook {
    (panic, identifier handler) => { System.hook(HookKind.PANIC, &handler) }
}

// Runtime event interception, like Rust's panic::set_hook but open to more kinds.
// A handler is a plain function whose address is taken with &handler:
//   PANIC: void handler(i8* message, i8* file, u32 line)
//          runs instead of the default report; the process aborts when it returns.
// System.hook returns the previous handler of that kind (null when none).
struct System {
    public static void* hook(HookKind kind, void* handler) {
        return __djinn_hook_set(kind.getValue(), handler);
    }

    public static void* unhook(HookKind kind) {
        return __djinn_hook_take(kind.getValue());
    }

    public static void print_default_panic_report(i8* message, i8* file, u32 line) {
        __djinn_panic_default_report(message, file, line);
    }
}
