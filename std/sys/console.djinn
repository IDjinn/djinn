import std::types;
import std::debug;
import std::text;

namespace std::sys;

extern "C" {
    i64 __djinn_async_write(i32 fd, void* buf, i64 count, void* coro_handle);
    i64 __djinn_async_read(i32 fd, void* buf, i64 count, void* coro_handle);
}

// Expands "{n}" placeholders of a format into a caller-owned buffer. fill() stops whenever the buffer should be
// handed to the output (full, or at a newline when lines are flushed), so one formatter serves blocking writes,
// asynchronous writes and in-memory formatting.
struct ConsoleFormat {
    const i32 NUMBER_ROOM = 128;

    str format;
    arr<object> args;
    mut i8* buffer;
    mut i32 capacity;
    mut i32 length;
    mut size position;
    mut i8* pending;
    mut u32 pendingLength;
    bool lineFlush;

    constexpr ConsoleFormat(str format, arr<object> args, i8* buffer, i32 capacity, bool lineFlush) {
        this.format = format;
        this.args = args;
        this.buffer = buffer;
        this.capacity = capacity;
        this.length = 0;
        this.position = 0u;
        this.pending = buffer;
        this.pendingLength = 0u;
        this.lineFlush = lineFlush;
    }

    public constexpr bool done() {
        return this.pendingLength == 0u && this.position >= this.format.length;
    }

    public unsafe void fill() {
        while (true) {
            if (this.pendingLength != 0u && !this.copyPending()) {
                return;
            }
            if (this.position >= this.format.length) {
                return;
            }
            i8 current = this.format.data[this.position];
            if (current == 123) {
                if (this.capacity - this.length < NUMBER_ROOM) {
                    return;
                }
                this.placeholder();
            } else {
                if (this.length >= this.capacity) {
                    return;
                }
                this.buffer[this.length] = current;
                this.length = this.length + 1;
                this.position = this.position + 1u;
                if (current == 10 && this.lineFlush) {
                    return;
                }
            }
        }
    }

    unsafe bool copyPending() {
        mut u32 room = (u32)(this.capacity - this.length);
        if (room > this.pendingLength) {
            room = this.pendingLength;
        }
        memcpy(this.buffer + this.length, this.pending, (u64)room);
        this.length = this.length + (i32)room;
        this.pending = this.pending + (i64)room;
        this.pendingLength = this.pendingLength - room;
        return this.pendingLength == 0u;
    }

    unsafe void placeholder() {
        this.position = this.position + 1u;
        mut u64 index = 0;
        while (this.position < this.format.length && this.format.data[this.position] != 125) {
            index = index * 10 + (u64)((i32)this.format.data[this.position] - 48);
            this.position = this.position + 1u;
        }
        this.position = this.position + 1u;
        if (index < (u64)this.args.length) {
            this.value(this.args.data[index]);
        }
    }

    unsafe void value(object arg) {
        TypeInfo* info = arg.type;
        i32 kind = (i32)info.kind;
        i8* out = this.buffer + this.length;
        if (kind == 0) {
            this.length = this.length + (i32)Numbers.format_i64(out, ConsoleFormat.signedOf(info.size, arg.data));
        } else if (kind == 4) {
            this.unsignedValue(info, arg.data);
        } else if (kind == 1) {
            if (info.size == 4) {
                this.length = this.length + __djinn_format_f64(out, (f64)*(f32*)arg.data, 1);
            } else {
                this.length = this.length + __djinn_format_f64(out, *(f64*)arg.data, 0);
            }
        } else if (kind == 2) {
            i8* text = *(i8**)arg.data;
            this.text(text, (u32)strlen(text));
        } else if (kind == 5 || kind == 6) {
            this.text(*(i8**)arg.data, *(u32*)((i8*)arg.data + 8));
        } else {
            this.text(info.name, (u32)strlen(info.name));
        }
    }

    unsafe void unsignedValue(TypeInfo* info, void* data) {
        if (info.size == 1 && ConsoleFormat.isBool(info.name)) {
            if (*(u8*)data != (u8)0) {
                this.text("true", 4u);
            } else {
                this.text("false", 5u);
            }
            return;
        }
        this.length = this.length + (i32)Numbers.format_u64(this.buffer + this.length, ConsoleFormat.unsignedOf(info.size, data));
    }

    unsafe void text(i8* data, u32 length) {
        this.pending = data;
        this.pendingLength = length;
        this.copyPending();
    }

    static unsafe bool isBool(i8* name) {
        return name[0] == 98 && name[1] == 111 && name[2] == 111 && name[3] == 108 && name[4] == 0;
    }

    static unsafe i64 signedOf(i32 width, void* data) {
        if (width == 1) { return (i64)*(i8*)data; }
        if (width == 2) { return (i64)*(i16*)data; }
        if (width == 4) { return (i64)*(i32*)data; }
        return *(i64*)data;
    }

    static unsafe u64 unsignedOf(i32 width, void* data) {
        if (width == 1) { return (u64)*(u8*)data; }
        if (width == 2) { return (u64)*(u16*)data; }
        if (width == 4) { return (u64)*(u32*)data; }
        return *(u64*)data;
    }
}

struct Console {
    const i32 stdin = 0;
    const i32 stderr = 2;
    const i32 stdout = 1;
    const i32 bufferSize = 1024;
    const i32 bufSize = 8192;

    public static c_result error(i8* message) {
        return (c_result)write(stderr, message, (u64)strlen(message));
    }

    public static c_result printf(i8* format) {
        return printf(format);
    }

    public static async i64 print(i8* message, i64 len) {
        void* handle = std::builtin::coro.handle();
        i64 ret = __djinn_async_write(stdout, message, len, handle);
        std::builtin::coro.suspend();

        Debug.assert(ret == (i64)0, "async_write call got invalid return");
        return ret;
    }

    public static async void* readLine() {
        void* buffer = __djinn_alloc_zeroed((u64)bufferSize);
        void* handle = std::builtin::coro.handle();
        i64 ret = __djinn_async_read(stdin, buffer, bufferSize, handle);
        std::builtin::coro.suspend();

        Debug.assert(ret == (i64)0, "async_read call got invalid return");
        return buffer;
    }

    public static unsafe void writeSync(str format, ...args) {
        i8* buffer = i8[bufSize];
        mut ConsoleFormat cursor = ConsoleFormat(format, args, buffer, bufSize, true);
        while (!cursor.done()) {
            cursor.fill();
            if (cursor.length > 0) {
                write(stdout, buffer, (u64)cursor.length);
                cursor.length = 0;
            }
        }
    }

    public static unsafe str format(str format, ...args) {
        mut i32 capacity = bufSize;
        mut i8* buffer = (i8*)__djinn_alloc((u64)capacity);
        mut ConsoleFormat cursor = ConsoleFormat(format, args, buffer, capacity, false);
        cursor.fill();
        while (!cursor.done()) {
            capacity = capacity * 2;
            buffer = (i8*)__djinn_realloc(buffer, (u64)capacity);
            cursor.buffer = buffer;
            cursor.capacity = capacity;
            cursor.fill();
        }
        if (cursor.length >= capacity) {
            buffer = (i8*)__djinn_realloc(buffer, (u64)capacity + 1);
        }
        buffer[cursor.length] = 0;
        return { .data = buffer, .length = (u32)cursor.length };
    }

    public static unsafe async i64 write(str format, ...args) {
        i8* buffer = i8[bufSize];
        void* handle = std::builtin::coro.handle();
        mut ConsoleFormat cursor = ConsoleFormat(format, args, buffer, bufSize, true);
        while (!cursor.done()) {
            cursor.fill();
            if (cursor.length > 0) {
                __djinn_async_write(stdout, buffer, (i64)cursor.length, handle);
                std::builtin::coro.suspend();
                cursor.length = 0;
            }
        }
        return 0;
    }
}
