namespace std::sys;

// A span of time with microsecond precision, so a number of seconds is never read as milliseconds.
struct Duration {
    i64 micros;

    public static constexpr Duration zero() {
        return { .micros = (i64)0 };
    }

    public static constexpr Duration from_micros(i64 value) {
        return { .micros = value };
    }

    public static constexpr Duration from_millis(i64 value) {
        return { .micros = value * (i64)1000 };
    }

    public static constexpr Duration from_seconds(i64 value) {
        return { .micros = value * (i64)1000000 };
    }

    public i64 as_micros() {
        return this.micros;
    }

    public i64 as_millis() {
        return this.micros / (i64)1000;
    }

    public i64 as_seconds() {
        return this.micros / (i64)1000000;
    }

    // Rounded up, so a wait never ends before the duration passed.
    public i64 whole_millis() {
        if (this.micros <= (i64)0) { return (i64)0; }
        return (this.micros - (i64)1) / (i64)1000 + (i64)1;
    }

    operator ==(Duration left, Duration right) -> bool {
        return left.micros == right.micros;
    }
}
