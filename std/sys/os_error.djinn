import std::types;

namespace std::sys;

enum OsError {
    NotFound = 1,
    PermissionDenied = 2,
    AlreadyExists = 3,
    InvalidArgument = 4,
    OutOfMemory = 5,
    Busy = 6,
    TooManyOpenFiles = 7,
    BrokenPipe = 8,
    Unsupported = 9,
    TimedOut = 10,
    BadHandle = 11,
    NotExecutable = 12,
    WouldBlock = 13,
    Interrupted = 14,
    TooLong = 15,
    Unknown = 0
}

str os_error_message(OsError error) {
    return switch error {
        NotFound -> "not found",
        PermissionDenied -> "permission denied",
        AlreadyExists -> "already exists",
        InvalidArgument -> "invalid argument",
        OutOfMemory -> "out of memory",
        Busy -> "resource busy",
        TooManyOpenFiles -> "too many open handles",
        BrokenPipe -> "broken pipe",
        Unsupported -> "unsupported operation",
        TimedOut -> "timed out",
        BadHandle -> "bad handle",
        NotExecutable -> "not an executable",
        WouldBlock -> "operation would block",
        Interrupted -> "interrupted",
        TooLong -> "too long",
        Unknown -> "unknown error"
    };
}

// The runtime reports a failure as a negative status holding the code.
OsError os_error_from_status(i64 status) {
    return OsError::parseValue(-status);
}

[Platform(native)]
struct OsStatus {
    public static result<bool, OsError> done(i64 status) {
        if (status < 0) { return result::Error(os_error_from_status(status)); }
        return result::Ok(true);
    }

    // Takes ownership of a block the runtime allocated for a text result.
    public static unsafe result<string, OsError> text(i64 status, i64 address) {
        if (status < 0) { return result::Error(os_error_from_status(status)); }
        return result::Ok({ .data = (i8*)address, .length = (size)status, .meta = StringMeta.heap() });
    }

    // A view of NUL-terminated text that the runtime keeps alive.
    public static unsafe str borrowed(i8* text) {
        mut size length = 0;
        while (*(text + length) != 0) {
            length = length + 1;
        }
        return { .data = text, .length = length, .meta = StringMeta.literal() };
    }
}
