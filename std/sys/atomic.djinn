import std::types;
namespace std::sys;

struct atomic<T> {
    mut T value;

    constexpr atomic(T initial) {
        this.value = initial;
    }

    [ForceInline] public unsafe T load() {
        return atomic_load(&this.value);
    }

    [ForceInline] public unsafe void store(T value) {
        atomic_store(&this.value, value);
    }

    [ForceInline] public unsafe T exchange(T value) {
        return atomic_swap(&this.value, value);
    }

    [ForceInline] public unsafe T fetchAdd(T delta) {
        return atomic_add(&this.value, delta);
    }

    [ForceInline] public unsafe T fetchSub(T delta) {
        return atomic_sub(&this.value, delta);
    }

    [ForceInline] public unsafe T fetchAnd(T mask) {
        return atomic_and(&this.value, mask);
    }

    [ForceInline] public unsafe T fetchOr(T mask) {
        return atomic_or(&this.value, mask);
    }

    [ForceInline] public unsafe T fetchXor(T mask) {
        return atomic_xor(&this.value, mask);
    }

    [ForceInline] public unsafe bool compareExchange(T expected, T desired) {
        return atomic_cas(&this.value, expected, desired);
    }
}

struct atomic_bool {
    mut u8 value;

    constexpr atomic_bool(bool initial) {
        this.value = (u8)initial;
    }

    [ForceInline] public unsafe bool load() {
        return atomic_load(&this.value) != (u8)0;
    }

    [ForceInline] public unsafe void store(bool value) {
        atomic_store(&this.value, (u8)value);
    }

    [ForceInline] public unsafe bool exchange(bool value) {
        return atomic_swap(&this.value, (u8)value) != (u8)0;
    }

    [ForceInline] public unsafe bool compareExchange(bool expected, bool desired) {
        return atomic_cas(&this.value, (u8)expected, (u8)desired);
    }
}

struct Atomics {
    [ForceInline] public static void fence() {
        atomic_fence();
    }
}
