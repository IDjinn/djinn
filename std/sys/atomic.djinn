import std::types;
namespace std::sys;

extern "C" {
    i32 __djinn_atomic_add(i32* target, i32 delta);
    i32 __djinn_atomic_load_i32(i32* target);
    void __djinn_atomic_store_i32(i32* target, i32 value);
    i32 __djinn_atomic_exchange_i32(i32* target, i32 value);
    i32 __djinn_atomic_cas_i32(i32* target, i32 expected, i32 desired);
    i64 __djinn_atomic_load_i64(i64* target);
    void __djinn_atomic_store_i64(i64* target, i64 value);
    i64 __djinn_atomic_exchange_i64(i64* target, i64 value);
    i64 __djinn_atomic_add_i64(i64* target, i64 delta);
    i32 __djinn_atomic_cas_i64(i64* target, i64 expected, i64 desired);
}

struct atomic<T> {
    mut T value;

    atomic(T initial) {
        this.value = initial;
    }

    public unsafe T load() {
        if constexpr sizeof(T) == 4 {
            return (T)__djinn_atomic_load_i32((i32*)&this.value);
        }
        return (T)__djinn_atomic_load_i64((i64*)&this.value);
    }

    public unsafe void store(T value) {
        if constexpr sizeof(T) == 4 {
            __djinn_atomic_store_i32((i32*)&this.value, (i32)value);
            return;
        }
        __djinn_atomic_store_i64((i64*)&this.value, (i64)value);
    }

    public unsafe T exchange(T value) {
        if constexpr sizeof(T) == 4 {
            return (T)__djinn_atomic_exchange_i32((i32*)&this.value, (i32)value);
        }
        return (T)__djinn_atomic_exchange_i64((i64*)&this.value, (i64)value);
    }

    public unsafe T fetchAdd(T delta) {
        if constexpr sizeof(T) == 4 {
            return (T)__djinn_atomic_add((i32*)&this.value, (i32)delta);
        }
        return (T)__djinn_atomic_add_i64((i64*)&this.value, (i64)delta);
    }

    public unsafe T fetchSub(T delta) {
        if constexpr sizeof(T) == 4 {
            return (T)__djinn_atomic_add((i32*)&this.value, 0 - (i32)delta);
        }
        return (T)__djinn_atomic_add_i64((i64*)&this.value, 0 - (i64)delta);
    }

    public unsafe bool compareExchange(T expected, T desired) {
        if constexpr sizeof(T) == 4 {
            return __djinn_atomic_cas_i32((i32*)&this.value, (i32)expected, (i32)desired) != 0;
        }
        return __djinn_atomic_cas_i64((i64*)&this.value, (i64)expected, (i64)desired) != 0;
    }
}

i32 atomic_bool_bits(bool value) {
    if (value) { return 1; }
    return 0;
}

struct atomic_bool {
    atomic<i32> inner;

    atomic_bool(bool initial) {
        this.inner = atomic<i32>(atomic_bool_bits(initial));
    }

    public unsafe bool load() {
        return this.inner.load() != 0;
    }

    public unsafe void store(bool value) {
        this.inner.store(atomic_bool_bits(value));
    }

    public unsafe bool exchange(bool value) {
        return this.inner.exchange(atomic_bool_bits(value)) != 0;
    }

    public unsafe bool compareExchange(bool expected, bool desired) {
        return this.inner.compareExchange(atomic_bool_bits(expected), atomic_bool_bits(desired));
    }
}
