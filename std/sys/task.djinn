import std::types;
namespace std::sys;

[no_mangle]
struct task<T> {
    void* handle;

    task(void* h) {
        this.handle = h;
    }

    public bool is_completed();
    public void resume();
    public T get_result();
    public void destroy();
}

extern "C" {
    i64 __djinn_unix_timestamp_ms();
    i64 __djinn_async_sleep(i64 milliseconds, void* coro_handle);
}

struct Task {
    public static async void pause() {
        std::builtin::coro.suspend();
    }

    public static async void delay(i64 milliseconds) {
        if (milliseconds <= (i64)0) {
            return;
        }
        void* handle = std::builtin::coro.handle();
        __djinn_async_sleep(milliseconds, handle);
        std::builtin::coro.suspend();
    }
}
