import std::types;
namespace std::sys;

extern "C" {
    i64 __djinn_unix_timestamp_ms();
    i64 __djinn_async_sleep(i64 milliseconds, void* coro_handle);
}

struct Task {
    public static async task<void> pause() {
        std::builtin::coro.suspend();
    }

    public static async task<void> delay(i64 milliseconds) {
        if (milliseconds <= (i64)0) {
            return;
        }
        void* handle = std::builtin::coro.handle();
        __djinn_async_sleep(milliseconds, handle);
        std::builtin::coro.suspend();
    }

    [Platform(native)]
    public static async task<void> sleep(Duration duration) {
        await Task.delay(duration.whole_millis());
    }
}
