import std::types;

namespace std::logger;

extern "C" {
    void* logger_get(i8* name, i32 output, i32 level);
    void logger_log(void* logger, i32 level, i8* format, ...);
    void logger_trace(void* logger, i8* format, ...);
    void logger_debug(void* logger, i8* format, ...);
    void logger_info(void* logger, i8* format, ...);
    void logger_warn(void* logger, i8* format, ...);
    void logger_error(void* logger, i8* format, ...);
    void logger_fatal(void* logger, i8* format, ...);
    void logger_set_level(void* logger, i32 level);
    void logger_set_async(void* logger, i32 enabled);
    void logger_set_sync_level(void* logger, i32 level);
    void logger_flush_all();
    i32 logger_enabled(void* logger, i32 level);
}

enum LoggerOutput {
    STDOUT,
    STDERR
}

enum LoggerLevel {
    TRACE,
    DEBUG,
    INFO,
    WARN,
    ERROR,
    FATAL
}

// logger!(level, message, args...) writes to the shared logger (the runtime's one, found by name); logger!(level, instance, message, args...)
// writes to the given Logger. The message is a printf format and the args follow it.
// logger_if!(condition, level, message, args...) / logger_if!(condition, level, instance, message, args...) add a condition.
// Everything after the level check is lazy: the macro expands to an `if`, so the condition, the instance and the args are only
// evaluated when the level is compiled in (LOG_COMPILE_LEVEL, constexpr: the whole statement is folded away below it) and the
// logger's runtime level lets the message through. The condition is checked after the level, before the args.
//   logger!(info, "ready");
//   logger!(debug, lg, "user %d", expensive(id));
//   logger_if!(Debug.isAttached, debug, "state %s", dump());
constexpr i32 LOG_COMPILE_LEVEL = 0;

macro logger! {
    // trace
    (trace, literal message) => {
        if (Logger.compiled(0) && Logger.shared().enabled(0)) {
            logger_trace(Logger.shared().log, message);
        }
    }
    (trace, literal message, expression... args) => {
        if (Logger.compiled(0) && Logger.shared().enabled(0)) {
            logger_trace(Logger.shared().log, message $for(item in args) { , item });
        }
    }
    (trace, identifier target, expression message) => {
        if (Logger.compiled(0) && target.enabled(0)) {
            logger_trace(target.log, message);
        }
    }
    (trace, identifier target, expression message, expression... args) => {
        if (Logger.compiled(0) && target.enabled(0)) {
            logger_trace(target.log, message $for(item in args) { , item });
        }
    }

    // debug
    (debug, literal message) => {
        if (Logger.compiled(1) && Logger.shared().enabled(1)) {
            logger_debug(Logger.shared().log, message);
        }
    }
    (debug, literal message, expression... args) => {
        if (Logger.compiled(1) && Logger.shared().enabled(1)) {
            logger_debug(Logger.shared().log, message $for(item in args) { , item });
        }
    }
    (debug, identifier target, expression message) => {
        if (Logger.compiled(1) && target.enabled(1)) {
            logger_debug(target.log, message);
        }
    }
    (debug, identifier target, expression message, expression... args) => {
        if (Logger.compiled(1) && target.enabled(1)) {
            logger_debug(target.log, message $for(item in args) { , item });
        }
    }

    // info
    (info, literal message) => {
        if (Logger.compiled(2) && Logger.shared().enabled(2)) {
            logger_info(Logger.shared().log, message);
        }
    }
    (info, literal message, expression... args) => {
        if (Logger.compiled(2) && Logger.shared().enabled(2)) {
            logger_info(Logger.shared().log, message $for(item in args) { , item });
        }
    }
    (info, identifier target, expression message) => {
        if (Logger.compiled(2) && target.enabled(2)) {
            logger_info(target.log, message);
        }
    }
    (info, identifier target, expression message, expression... args) => {
        if (Logger.compiled(2) && target.enabled(2)) {
            logger_info(target.log, message $for(item in args) { , item });
        }
    }

    // warn
    (warn, literal message) => {
        if (Logger.compiled(3) && Logger.shared().enabled(3)) {
            logger_warn(Logger.shared().log, message);
        }
    }
    (warn, literal message, expression... args) => {
        if (Logger.compiled(3) && Logger.shared().enabled(3)) {
            logger_warn(Logger.shared().log, message $for(item in args) { , item });
        }
    }
    (warn, identifier target, expression message) => {
        if (Logger.compiled(3) && target.enabled(3)) {
            logger_warn(target.log, message);
        }
    }
    (warn, identifier target, expression message, expression... args) => {
        if (Logger.compiled(3) && target.enabled(3)) {
            logger_warn(target.log, message $for(item in args) { , item });
        }
    }

    // error
    (error, literal message) => {
        if (Logger.compiled(4) && Logger.shared().enabled(4)) {
            logger_error(Logger.shared().log, message);
        }
    }
    (error, literal message, expression... args) => {
        if (Logger.compiled(4) && Logger.shared().enabled(4)) {
            logger_error(Logger.shared().log, message $for(item in args) { , item });
        }
    }
    (error, identifier target, expression message) => {
        if (Logger.compiled(4) && target.enabled(4)) {
            logger_error(target.log, message);
        }
    }
    (error, identifier target, expression message, expression... args) => {
        if (Logger.compiled(4) && target.enabled(4)) {
            logger_error(target.log, message $for(item in args) { , item });
        }
    }

    // fatal
    (fatal, literal message) => {
        if (Logger.compiled(5) && Logger.shared().enabled(5)) {
            logger_fatal(Logger.shared().log, message);
        }
    }
    (fatal, literal message, expression... args) => {
        if (Logger.compiled(5) && Logger.shared().enabled(5)) {
            logger_fatal(Logger.shared().log, message $for(item in args) { , item });
        }
    }
    (fatal, identifier target, expression message) => {
        if (Logger.compiled(5) && target.enabled(5)) {
            logger_fatal(target.log, message);
        }
    }
    (fatal, identifier target, expression message, expression... args) => {
        if (Logger.compiled(5) && target.enabled(5)) {
            logger_fatal(target.log, message $for(item in args) { , item });
        }
    }
}

macro logger_if! {
    // trace
    (expression condition, trace, literal message) => {
        if (Logger.compiled(0) && Logger.shared().enabled(0) && condition) {
            logger_trace(Logger.shared().log, message);
        }
    }
    (expression condition, trace, literal message, expression... args) => {
        if (Logger.compiled(0) && Logger.shared().enabled(0) && condition) {
            logger_trace(Logger.shared().log, message $for(item in args) { , item });
        }
    }
    (expression condition, trace, identifier target, expression message) => {
        if (Logger.compiled(0) && target.enabled(0) && condition) {
            logger_trace(target.log, message);
        }
    }
    (expression condition, trace, identifier target, expression message, expression... args) => {
        if (Logger.compiled(0) && target.enabled(0) && condition) {
            logger_trace(target.log, message $for(item in args) { , item });
        }
    }

    // debug
    (expression condition, debug, literal message) => {
        if (Logger.compiled(1) && Logger.shared().enabled(1) && condition) {
            logger_debug(Logger.shared().log, message);
        }
    }
    (expression condition, debug, literal message, expression... args) => {
        if (Logger.compiled(1) && Logger.shared().enabled(1) && condition) {
            logger_debug(Logger.shared().log, message $for(item in args) { , item });
        }
    }
    (expression condition, debug, identifier target, expression message) => {
        if (Logger.compiled(1) && target.enabled(1) && condition) {
            logger_debug(target.log, message);
        }
    }
    (expression condition, debug, identifier target, expression message, expression... args) => {
        if (Logger.compiled(1) && target.enabled(1) && condition) {
            logger_debug(target.log, message $for(item in args) { , item });
        }
    }

    // info
    (expression condition, info, literal message) => {
        if (Logger.compiled(2) && Logger.shared().enabled(2) && condition) {
            logger_info(Logger.shared().log, message);
        }
    }
    (expression condition, info, literal message, expression... args) => {
        if (Logger.compiled(2) && Logger.shared().enabled(2) && condition) {
            logger_info(Logger.shared().log, message $for(item in args) { , item });
        }
    }
    (expression condition, info, identifier target, expression message) => {
        if (Logger.compiled(2) && target.enabled(2) && condition) {
            logger_info(target.log, message);
        }
    }
    (expression condition, info, identifier target, expression message, expression... args) => {
        if (Logger.compiled(2) && target.enabled(2) && condition) {
            logger_info(target.log, message $for(item in args) { , item });
        }
    }

    // warn
    (expression condition, warn, literal message) => {
        if (Logger.compiled(3) && Logger.shared().enabled(3) && condition) {
            logger_warn(Logger.shared().log, message);
        }
    }
    (expression condition, warn, literal message, expression... args) => {
        if (Logger.compiled(3) && Logger.shared().enabled(3) && condition) {
            logger_warn(Logger.shared().log, message $for(item in args) { , item });
        }
    }
    (expression condition, warn, identifier target, expression message) => {
        if (Logger.compiled(3) && target.enabled(3) && condition) {
            logger_warn(target.log, message);
        }
    }
    (expression condition, warn, identifier target, expression message, expression... args) => {
        if (Logger.compiled(3) && target.enabled(3) && condition) {
            logger_warn(target.log, message $for(item in args) { , item });
        }
    }

    // error
    (expression condition, error, literal message) => {
        if (Logger.compiled(4) && Logger.shared().enabled(4) && condition) {
            logger_error(Logger.shared().log, message);
        }
    }
    (expression condition, error, literal message, expression... args) => {
        if (Logger.compiled(4) && Logger.shared().enabled(4) && condition) {
            logger_error(Logger.shared().log, message $for(item in args) { , item });
        }
    }
    (expression condition, error, identifier target, expression message) => {
        if (Logger.compiled(4) && target.enabled(4) && condition) {
            logger_error(target.log, message);
        }
    }
    (expression condition, error, identifier target, expression message, expression... args) => {
        if (Logger.compiled(4) && target.enabled(4) && condition) {
            logger_error(target.log, message $for(item in args) { , item });
        }
    }

    // fatal
    (expression condition, fatal, literal message) => {
        if (Logger.compiled(5) && Logger.shared().enabled(5) && condition) {
            logger_fatal(Logger.shared().log, message);
        }
    }
    (expression condition, fatal, literal message, expression... args) => {
        if (Logger.compiled(5) && Logger.shared().enabled(5) && condition) {
            logger_fatal(Logger.shared().log, message $for(item in args) { , item });
        }
    }
    (expression condition, fatal, identifier target, expression message) => {
        if (Logger.compiled(5) && target.enabled(5) && condition) {
            logger_fatal(target.log, message);
        }
    }
    (expression condition, fatal, identifier target, expression message, expression... args) => {
        if (Logger.compiled(5) && target.enabled(5) && condition) {
            logger_fatal(target.log, message $for(item in args) { , item });
        }
    }
}

struct Logger {
    void* log;
    str name;
    str prefix;

    Logger(str loggerName){
        this.name = loggerName;
        this.prefix = "";
        this.log = logger_get(loggerName.ptr(), 1, 0);
        logger_set_async(this.log, 1);
    }

    // An optional prefix (Logger("ui.native", "UI")). It is only stored: the output pattern is not changed from code, it
    // belongs to the config file (runtime.properties), which decides whether and where a prefix is shown.
    Logger(str loggerName, str loggerPrefix){
        this.name = loggerName;
        this.prefix = loggerPrefix;
        this.log = logger_get(loggerName.ptr(), 1, 0);
        logger_set_async(this.log, 1);
    }

    // The logger the runtime itself creates (named RUNTIME): the same instance everywhere, never reconfigured here.
    // A thread-local shared logger needs language support: https://github.com/IDjinn/djinn/issues/160
    static Logger shared() {
        Logger shared = { .log = logger_get("RUNTIME", 1, 0), .name = "RUNTIME", .prefix = "" };
        return shared;
    }

    static constexpr bool compiled(i32 level) {
        return level >= LOG_COMPILE_LEVEL;
    }

    [Inline]
    bool enabled(i32 level) {
        return logger_enabled(this.log, level) != 0;
    }

    [Inline]
    void trace(str message) {
        logger_trace(this.log, "%s", message.ptr());
    }

    [Inline]
    void debug(str message) {
        logger_debug(this.log, "%s", message.ptr());
    }

    [Inline]
    void info(str message) {
        logger_info(this.log, "%s", message.ptr());
    }

    [Inline]
    void warn(str message) {
        logger_warn(this.log, "%s", message.ptr());
    }

    [Inline]
    void error(str message) {
        logger_error(this.log, "%s", message.ptr());
    }

    [Inline]
    void fatal(str message) {
        logger_fatal(this.log, "%s", message.ptr());
    }

    void setLevel(i32 level) {
        logger_set_level(this.log, level);
    }

    void setAsync(bool enabled) {
        if (enabled) {
            logger_set_async(this.log, 1);
        } else {
            logger_set_async(this.log, 0);
        }
    }

    static void flush() {
        logger_flush_all();
    }
}
