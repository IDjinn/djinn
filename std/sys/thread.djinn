import std::types;

namespace std::sys;

extern "C" {
    i64 __djinn_thread_current_id();
    void __djinn_thread_yield();
    i64 __djinn_thread_set_name(i8* name, i64 length);
    void __djinn_os_thread_sleep(i64 milliseconds);
}

[Platform(native)]
struct ThreadId {
    i64 value;

    operator ==(ThreadId left, ThreadId right) -> bool {
        return left.value == right.value;
    }
}

// The calling thread.
[Platform(native)]
struct Thread {
    public static ThreadId current_id() {
        unsafe { return { .value = __djinn_thread_current_id() }; }
    }

    // Blocks the thread: in async code use Task.delay.
    public static void sleep(Duration duration) {
        i64 millis = duration.whole_millis();
        if (millis > (i64)0) {
            unsafe { __djinn_os_thread_sleep(millis); }
        }
    }

    public static void yield_now() {
        unsafe { __djinn_thread_yield(); }
    }

    // The name debuggers and profilers show (Linux keeps 15 bytes).
    public static result<bool, OsError> set_name(str name) {
        unsafe { return OsStatus.done(__djinn_thread_set_name(name.data, (i64)name.length)); }
    }
}
