import std::types;
namespace std::libc;

extern "C" {
  c_result printf(i8* fmt, ...);

  [ConstMemCopy] void* memcpy(void* dest, void* src, size_long n);
  [ConstMemCopy] void* memmove(void* dest, void* src, size_long n);
  [ConstMemSet] void* memset(void* ptr, i32 value, size_long n);
  i32 memcmp(void* left, void* right, size_long n);
  c_result strlen(i8* s);
  f64 strtod(i8* text, i8** end);
  i32 atoi(i8* text);
  i64 atoll(i8* text);
  i64 strtoll(i8* text, i8** end, i32 base);
  u64 strtoull(i8* text, i8** end, i32 base);
  void abort();
  void exit(i32 code);


  // Heap memory comes only from the runtime allocators below (traced, one source); C's malloc/realloc/free are not declared.
  [ConstAlloc, AllocFn("djinn")] void*  __djinn_alloc     ([AllocSize] size_long size);
  [ConstAlloc, AllocFn("djinn"), AllocZeroed] void*  __djinn_alloc_zeroed([AllocSize] size_long size);
  [ConstFree, FreeFn("djinn")] void   __djinn_free      ([AllocPtr] void* pointer);
  [AllocFn("djinn_aligned"), AllocZeroed] void*  __djinn_malloc_aligned([AllocSize] size_long size, [AllocAlign] size_long alignment);
  [FreeFn("djinn_aligned")] void   __djinn_free_aligned([AllocPtr] void* pointer);
  [ConstRealloc, ReallocFn("djinn")] void*  __djinn_realloc   ([AllocPtr] void* pointer, [AllocSize] size_long new_size);
}
