import std::types;
namespace std::libc;

extern "C" {
  c_result printf(i8* fmt, ...);

  void* malloc(size_long size);
  void* realloc(void* ptr, size_long new_size);
  void* memcpy(void* dest, void* src, size_long n);
  void* memmove(void* dest, void* src, size_long n);
  void* memset(void* ptr, i32 value, size_long n);
  i32 memcmp(void* left, void* right, size_long n);
  void free(void* ptr);
  c_result strlen(i8* s);
  f64 strtod(i8* text, i8** end);
  void abort();
  void exit(i32 code);


  void*  __djinn_alloc     (size_long size);
  void*  __djinn_alloc_zeroed(size_long size);
  void   __djinn_free      (void* pointer);
  void*  __djinn_malloc_aligned(size_long size, size_long alignment);
  void   __djinn_free_aligned(void* pointer);
  void*  __djinn_realloc   (void* pointer, size_long new_size);
}
