namespace std::types;

// Questions about a type, answered at compile time. In generic code they pick a branch of 'if constexpr', and only
// that branch is checked for the instance:
//
//     if constexpr is_float<T>() { ... } else { ... }

constexpr bool is_integer<T>() {
    return type_trait(T, integer);
}

constexpr bool is_signed<T>() {
    return type_trait(T, signed);
}

constexpr bool is_unsigned<T>() {
    return type_trait(T, unsigned);
}

constexpr bool is_float<T>() {
    return type_trait(T, float);
}

constexpr bool is_number<T>() {
    return type_trait(T, number);
}

constexpr bool is_bool<T>() {
    return type_trait(T, bool);
}

constexpr bool is_char<T>() {
    return type_trait(T, char);
}

constexpr bool is_pointer<T>() {
    return type_trait(T, pointer);
}

constexpr bool is_enum<T>() {
    return type_trait(T, enum);
}

constexpr bool is_struct<T>() {
    return type_trait(T, struct);
}

constexpr bool is_array<T>() {
    return type_trait(T, array);
}

constexpr bool is_copyable<T>() {
    return type_trait(T, copyable);
}

constexpr bool is_same<A, B>() {
    return same_type(A, B);
}
