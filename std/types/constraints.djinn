namespace std::types::constraints;

interface Hashable {
    [ForceInline] constexpr u64 hash();
}

interface Cloneable<T> {
    T clone();
}

interface Comparable<T> {
    i32 compare<O>(O other);
}

interface Serializable<TOut> {
    TOut serialize();
}

// OPERATORS CONSTRAINTS //

interface Equatable<T> {
    operator == (T left, T right) -> bool;
}

interface NotEquatable<T> {
    operator != (T left, T right) -> bool;
}

interface Less<T> {
    operator < (T left, T right) -> bool;
}

interface LessOrEqual<T> {
    operator <= (T left, T right) -> bool;
}

interface Greater<T> {
    operator > (T left, T right) -> bool;
}

interface GreaterOrEqual<T> {
    operator >= (T left, T right) -> bool;
}

interface Addition<T> {
    operator + (T left, T right) -> T;
}

interface INumber {
    bool isZero();
    bool isNegative();
    bool isPositive();
}
