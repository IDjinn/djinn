// impl u128 { const u128 MAX_VALUE = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF; }

impl f32 {
    const i32 BITS = 32;
    const i32 MANTISSA_DIGITS = 24;
    const f32 INFINITY = 1.0 / 0.0;
    const f32 NEG_INFINITY = -1.0 / 0.0;
    const f32 NAN = 0.0 / 0.0;
    const f32 MAX_VALUE = 3.40282347e+38;
    const f32 MIN_VALUE = -3.40282347e+38;
    const f32 MIN_POSITIVE = 1.17549435e-38;
    const f32 EPSILON = 1.19209290e-7;
    const f32 WHOLE_NUMBER_LIMIT = 8388608.0;
    const u32 MAGNITUDE_MASK = 0x7FFFFFFF;
    const u32 INFINITY_BITS = 0x7F800000;
    const u32 SIGN_BIT = 0x80000000;

    [ForceInline] constexpr bool isNaN() {
        return (float_bits(this) & f32.MAGNITUDE_MASK) > f32.INFINITY_BITS;
    }

    [ForceInline] constexpr bool signBit() {
        return (float_bits(this) & f32.SIGN_BIT) != 0;
    }

    [ForceInline] constexpr bool isInfinity() {
        return Math.isInfinity(this);
    }

    [ForceInline] constexpr bool isFinite() {
        return Math.isFinite(this);
    }

    [ForceInline] constexpr f32 truncate() {
        return Math.truncate(this);
    }

    [ForceInline] constexpr f32 floor() {
        return Math.floor(this);
    }

    [ForceInline] constexpr f32 ceiling() {
        return Math.ceiling(this);
    }

    [ForceInline] constexpr f32 round() {
        return Math.round(this);
    }

    [ForceInline] constexpr f32 fraction() {
        return Math.fraction(this);
    }
}

impl f64 {
    const i32 BITS = 64;
    const i32 MANTISSA_DIGITS = 53;
