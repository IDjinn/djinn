}

// Native-width integer (pointer-sized: i64 on 64-bit targets, i32 on 32-bit)
impl nint {
    const i32 BITS = Runtime.PointerSize * 8;
    const nint MAX_VALUE = (nint)((((u64)1) << (u64)(Runtime.PointerSize * 8 - 1)) - (u64)1);
    const nint MIN_VALUE = (nint)0 - (nint)((((u64)1) << (u64)(Runtime.PointerSize * 8 - 1)) - (u64)1) - (nint)1;
}

