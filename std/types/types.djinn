namespace std::types;

extern "C" {
    u32 __djinn_compare_strings(
        i8* leftData,
        i8* rightData,
        i32 leftLen,
        i32 rightLen
    );

    u64 __djinn_hash_string(i8* data, u32 length);
}

struct size : u32; // TODO: MAYBE UNIQUE TYPE FOR THAT
struct size_long : u64;

struct c_result : i32;

struct bool : u1;

union optional<T> {
    Empty(),
    Value(T)
}

union result<T, E> {
    Ok(T),
    Error(E)
}

// Exceptions are builtin core types (Exception root + derived errors);
// see docs — no std enum needed anymore.

impl Equatable for arr<T> {
    operator ==(arr<T> left, arr<T> right) -> bool {
        if (left.length != right.length) {
            return false;
        }
        unsafe {
            for (mut size i = 0; i < left.length; i = i + 1) {
                if (left.data[i] != right.data[i]) {
                    return false;
                }
            }
        }
        return true;
    }
}

impl Hashable for i128, u128 {
    [ForceInline] u64 hash() {
        u64 hi = (u64)(this >> 64);
        u64w lo = (u64w)this;
        mut u64w x = hi ^ (lo * 0x9e3779b97f4a7c15);

        x = x + 0x9e3779b97f4a7c15;
        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9;
        x = (x ^ (x >> 27)) * 0x94d049bb133111eb;
        x = x ^ (x >> 31);

        return (u64)(x ^ (x >> 32));
    }
}

impl Hashable for i64, u64 {
    [ForceInline] u64 hash() {
        mut u64w x = (u64w)this + 0x9e3779b97f4a7c15;
        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9;
        x = (x ^ (x >> 27)) * 0x94d049bb133111eb;
        x = x ^ (x >> 31);

        return (u64)(x ^ (x >> 32));
    }
}

impl Hashable for i8, i16, i32, u8, u16, u32 {
     [ForceInline] u64 hash() {
        return (u64)this;
    }
}

impl Hashable for f32 {
    [ForceInline] u64 hash() {
        // Reinterpret f32 bits as u32 via pointer cast, then hash as integer
        f32* p = &this;
        u32* ip = (u32*)p;
        mut u64w x = (u64w)*ip + 0x9e3779b97f4a7c15;
        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9;
        x = (x ^ (x >> 27)) * 0x94d049bb133111eb;
        return x ^ (x >> 31);
    }
}

impl Hashable for f64 {
    [ForceInline] u64 hash() {
        // Reinterpret f64 bits as u64 via pointer cast, then hash
        f64* p = &this;
        u64* ip = (u64*)p;
        mut u64w x = (u64w)*ip + 0x9e3779b97f4a7c15;
        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9;
        x = (x ^ (x >> 27)) * 0x94d049bb133111eb;
        return x ^ (x >> 31);
    }
}

impl Hashable, Equatable for i8* {
    u64 hash() {
        return 0;
    }

    operator ==(i8* left, i8* right) -> bool {
        return left == right;
    }
}

struct TypeInfo {
    i32 id;
    i32 size;
    i8* name;
    u8 kind;
    u8 flags;

    [ForceInline] u64 hash() {
        mut u64w x = (u64w)this.id;
        x = x * 31 + (u64)this.size;
        x = x * 31 + (u64)this.kind;
        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9;
        x = (x ^ (x >> 27)) * 0x94d049bb133111eb;
        x = x ^ (x >> 31);

        return (u64)(x ^ (x >> 32));
    }
}

struct AttributeInfo {
    i8* name;
    i8* value;
    void* payload;
}

struct FieldInfo {
    i8* name;
    i32 typeId;
    u16 offset;
    u8 flags;
    u8 attrCount;
    AttributeInfo* attrs;
}

struct ParamInfo {
    i8* name;
    i32 typeId;
    u8 flags;
    u8 attrCount;
    AttributeInfo* attrs;
}

struct MethodInfo {
    i8* name;
    void* funcPtr;
    i32 returnTypeId;
    u8 paramCount;
    u8 flags;
    u8 attrCount;
    AttributeInfo* attrs;
    ParamInfo* params;
}

struct TypeInfoExt {
    TypeInfo base;
    u16 fieldCount;
    u16 methodCount;
    u8 attrCount;
    FieldInfo* fields;
    MethodInfo* methods;
    AttributeInfo* attrs;
    void* detail;
    i8** interfaces;
    u16 interfaceCount;
}

struct object : Hashable {
    TypeInfo* type;
    void* data;

    [ForceInline] u64 hash() {
        return this.type.hash();
    }
}

impl Equatable for object {
    operator ==(object left, object right) -> bool {
        return left.type == right.type && left.data == right.data;
    }
}

struct str {
    i8* data;
    size length;

    public bool is_empty() {
        return this.length == 0u;
    }

    public i8* ptr() {
        return this.data;
    }

    operator get[](str text, size index) -> i8 {
        bounds_check(index, text.length);
        unsafe {
            return text.data[index];
        }
    }

    public unsafe i8* toCString() {
        i8* copy = __djinn_malloc(this.length + 1);
        memcpy(copy, this.data, this.length);
        copy[this.length] = 0;
        return copy;
    }
}

struct arr<T> : Hashable
where T : Hashable, Equatable {
    T* data;
    size length;

    public unsafe u64 hash() {
        mut u64w result = 1;
        for (mut size i = 0; i < this.length; i = i + 1) {
            u64 item_hash = this.data[i].hash();
            result = 31 * result + (u32)((item_hash ^ (item_hash >> 32)) & 4294967295);
        }
        return result;
    }

    public bool is_empty() {
        return this.length == 0u;
    }

    public i8* ptr() {
        return (i8*)this.data;
    }
}

struct string : Disposable {
    mut i8* data;
    size length;
    size capacity;

    public void disposable() {
        __djinn_free(this.data);
    }

    public bool is_empty() {
        return this.length == 0u;
    }

    public i8* ptr() {
        return this.data;
    }

    operator get[](string text, size index) -> i8 {
        bounds_check(index, text.length);
        unsafe {
            return text.data[index];
        }
    }

    public unsafe i8* toCString() {
        i8* copy = __djinn_malloc(this.length + 1);
        memcpy(copy, this.data, this.length);
        copy[this.length] = 0;
        return copy;
    }

    public i32 length() {
        return (i32)this.length;
    }

    public i32 capacity() {
        return (i32)this.capacity;
    }
}

bool isSpace(i8 c) {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

size encodeChar(i8* out, char value) {
    unsafe {
        u32 code = (u32)value;
        if (code < 128) {
            out[0] = (i8)code;
            return 1;
        }
        if (code < 2048) {
            out[0] = (i8)(u8)(192 | (code >> 6));
            out[1] = (i8)(u8)(128 | (code & 63));
            return 2;
        }
        if (code < 65536) {
            out[0] = (i8)(u8)(224 | (code >> 12));
            out[1] = (i8)(u8)(128 | ((code >> 6) & 63));
            out[2] = (i8)(u8)(128 | (code & 63));
            return 3;
        }
        out[0] = (i8)(u8)(240 | (code >> 18));
        out[1] = (i8)(u8)(128 | ((code >> 12) & 63));
        out[2] = (i8)(u8)(128 | ((code >> 6) & 63));
        out[3] = (i8)(u8)(128 | (code & 63));
        return 4;
    }
}

impl Hashable for str, string {
    bool startsWith(char value) {
        unsafe {
            mut u64 buffer = 0;
            i8* bytes = (i8*)&buffer;
            size count = encodeChar(bytes, value);
            str encoded = { .data = bytes, .length = count };
            return this.startsWith(encoded);
        }
    }

    bool endsWith(char value) {
        unsafe {
            mut u64 buffer = 0;
            i8* bytes = (i8*)&buffer;
            size count = encodeChar(bytes, value);
            str encoded = { .data = bytes, .length = count };
            return this.endsWith(encoded);
        }
    }

    i32 indexOf(char value) {
        unsafe {
            mut u64 buffer = 0;
            i8* bytes = (i8*)&buffer;
            size count = encodeChar(bytes, value);
            str encoded = { .data = bytes, .length = count };
            return this.indexOf(encoded);
        }
    }

    i32 lastIndexOf(char value) {
        unsafe {
            mut u64 buffer = 0;
            i8* bytes = (i8*)&buffer;
            size count = encodeChar(bytes, value);
            str encoded = { .data = bytes, .length = count };
            return this.lastIndexOf(encoded);
        }
    }

    bool contains(char value) {
        return this.indexOf(value) >= 0;
    }

    u64 hash() {
        return __djinn_hash_string(this.data, this.length);
    }

    bool startsWith(str prefix) {
        unsafe {
            if (prefix.length > this.length) {
                return false;
            }
            for (mut size i = 0; i < prefix.length; i = i + 1) {
                if (this.data[i] != prefix.data[i]) {
                    return false;
                }
            }
            return true;
        }
    }

    bool endsWith(str suffix) {
        unsafe {
            if (suffix.length > this.length) {
                return false;
            }
            size offset = this.length - suffix.length;
            for (mut size i = 0; i < suffix.length; i = i + 1) {
                if (this.data[offset + i] != suffix.data[i]) {
                    return false;
                }
            }
            return true;
        }
    }

    i32 indexOf(str needle) {
        unsafe {
            if (needle.length > this.length) {
                return -1;
            }
            size last = this.length - needle.length;
            for (mut size i = 0; i <= last; i = i + 1) {
                mut bool matches = true;
                for (mut size j = 0; j < needle.length; j = j + 1) {
                    if (this.data[i + j] != needle.data[j]) {
                        matches = false;
                        break;
                    }
                }
                if (matches) {
                    return (i32)i;
                }
            }
            return -1;
        }
    }

    i32 lastIndexOf(str needle) {
        unsafe {
            if (needle.length > this.length) {
                return -1;
            }
            mut i32 i = (i32)(this.length - needle.length);
            while (i >= 0) {
                mut bool matches = true;
                for (mut size j = 0; j < needle.length; j = j + 1) {
                    if (this.data[(size)i + j] != needle.data[j]) {
                        matches = false;
                        break;
                    }
                }
                if (matches) {
                    return i;
                }
                i = i - 1;
            }
            return -1;
        }
    }

    i32 indexOfChar(i8 value) {
        unsafe {
            for (mut size i = 0; i < this.length; i = i + 1) {
                if (this.data[i] == value) {
                    return (i32)i;
                }
            }
            return -1;
        }
    }

    bool contains(str needle) {
        return this.indexOf(needle) >= 0;
    }

    bool containsChar(i8 value) {
        return this.indexOfChar(value) >= 0;
    }

    i8 charAt(size index) {
        unsafe {
            Debug.assert(index < this.length, "index out of bounds");
            return this.data[index];
        }
    }

    bool equalsIgnoreCase(str other) {
        unsafe {
            if (other.length != this.length) {
                return false;
            }
            for (mut size i = 0; i < this.length; i = i + 1) {
                mut i8 a = this.data[i];
                mut i8 b = other.data[i];
                if (a >= 65 && a <= 90) { a = a + 32; }
                if (b >= 65 && b <= 90) { b = b + 32; }
                if (a != b) {
                    return false;
                }
            }
            return true;
        }
    }

    bool isBlank() {
        unsafe {
            for (mut size i = 0; i < this.length; i = i + 1) {
                i8 c = this.data[i];
                if (c != 32 && c != 9 && c != 10 && c != 13) {
                    return false;
                }
            }
            return true;
        }
    }

    str trimStart() {
        unsafe {
            mut size start = 0;
            while (start < this.length && isSpace(this.data[start])) {
                start = start + 1;
            }
            return { .data = this.data + start, .length = this.length - start };
        }
    }

    str trimEnd() {
        unsafe {
            mut size end = this.length;
            while (end > 0 && isSpace(this.data[end - 1])) {
                end = end - 1;
            }
            return { .data = this.data, .length = end };
        }
    }

    str trim() {
        return this.trimStart().trimEnd();
    }

    str slice(size start, size length) {
        Debug.assert(start <= this.length, "start out of bounds");
        Debug.assert(start + length <= this.length, "length out of bounds");

        return { .data = this.data + start, .length = length };
    }

    string substring(size start, size length) {
        Debug.assert(start <= this.length, "start out of bounds");
        Debug.assert(start + length <= this.length, "length out of bounds");

        size new_size = length - start;
        u32 new_capacity = (u32)((f64)new_size * 1.5);
        void* data_buffer = __djinn_malloc(new_capacity);
        memcpy(data_buffer, (this.data + start), length);
        return { .data = data_buffer, .length = new_size, .capacity = new_capacity };
    }

    string concat(string left, string right) {
        return left + right;
    }

    operator +(string left, string right) -> string { // TODO: THIS DOESNT APPEND IF HAS CAPACITY!
        u32 new_len = left.length + right.length;
        u64 alloc_size = (u64)((f64)new_len * 1.5) + 1;
        i8* new_data = __djinn_malloc(alloc_size);
        memcpy(new_data, left.data, left.length);
        memcpy(new_data + left.length, right.data, right.length);
        return { .data = new_data, .length = new_len, .capacity = new_len };
    }
}

bool charEqualsText(char value, i8* data, u32 length) {
    unsafe {
        if (length == 0 || length > 4) {
            return false;
        }
        u32 code = (u32)value;
        if (code < 128) {
            return length == 1 && data[0] == (i8)code;
        }
        mut u64 buffer = 0;
        i8* bytes = (i8*)&buffer;
        size count = encodeChar(bytes, value);
        if (count != length) {
            return false;
        }
        for (mut size i = 0; i < count; i = i + 1) {
            if (bytes[i] != data[i]) {
                return false;
            }
        }
        return true;
    }
}

impl Equatable for str {
    operator ==(str left, str right) -> bool {
        return __djinn_compare_strings(left.data, right.data, (i32)left.length, (i32)right.length) == 1;
    }

    operator ==(char left, str right) -> bool {
        return charEqualsText(left, right.data, right.length);
    }

    operator ==(str left, char right) -> bool {
        return charEqualsText(right, left.data, left.length);
    }
}

impl Equatable for string {
    operator ==(string left, string right) -> bool {
        return __djinn_compare_strings(left.data, right.data, (i32)left.length, (i32)right.length) == 1;
    }

    operator ==(char left, string right) -> bool {
        return charEqualsText(left, right.data, right.length);
    }

    operator ==(string left, char right) -> bool {
        return charEqualsText(right, left.data, left.length);
    }
}

impl i8 {
    const i32 BITS = 8;
    const i8 MAX_VALUE = 127;
    const i8 MIN_VALUE = -128;
}

impl i16 {
    const i32 BITS = 16;
    const i16 MAX_VALUE = 32767;
    const i16 MIN_VALUE = -32768;
}

impl bool {
    operator <(bool left, bool right) -> bool;
    operator <=(bool left, bool right) -> bool;
    operator >(bool left, bool right) -> bool;
    operator >=(bool left, bool right) -> bool;
}

impl i32 {
    const i32 BITS = 32;
    const i32 MAX_VALUE = 0x7FFFFFFF;
    const i32 MIN_VALUE = 0x80000000w;
}

// Native-width integer (pointer-sized: i64 on 64-bit targets, i32 on 32-bit)
impl nint {
    const i32 BITS = 64;
    const nint MAX_VALUE = 0x7FFFFFFFFFFFFFFF;
    const nint MIN_VALUE = 0x8000000000000000w;
}

// TODO: i128/u128 const fields disabled — primitive impl for 128-bit types
// triggers LLVM verification error (this passed as ptr instead of i128 value)
// impl i128 { const i128 MAX_VALUE = 0x7FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF; }

impl u8 {
    const i32 BITS = 8;
    const u8 MAX_VALUE = 255;
    const u8 MIN_VALUE = 0;
}

impl u16 {
    const i32 BITS = 16;
    const u16 MAX_VALUE = 65535;
    const u16 MIN_VALUE = 0;
}

impl u32 {
    const i32 BITS = 32;
    const u32 MAX_VALUE = 0xFFFFFFFF;
    const u32 MIN_VALUE = 0;
}

impl u64 {
    const i32 BITS = 64;
    const u64 MAX_VALUE = 0xFFFFFFFFFFFFFFFF;
    const u64 MIN_VALUE = 0;
}

// impl u128 { const u128 MAX_VALUE = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF; }

impl f32 {
    const i32 BITS = 32;
    const i32 MANTISSA_DIGITS = 24;
    const f32 INFINITY = 1.0 / 0.0;
    const f32 NEG_INFINITY = -1.0 / 0.0;
    const f32 NAN = 0.0 / 0.0;
    const f32 MAX_VALUE = 3.40282347e+38;
    const f32 MIN_VALUE = -3.40282347e+38;
    const f32 MIN_POSITIVE = 1.17549435e-38;
    const f32 EPSILON = 1.19209290e-7;
}

impl f64 {
    const i32 BITS = 64;
    const i32 MANTISSA_DIGITS = 53;
    const f64 INFINITY = 1.0 / 0.0;
    const f64 NEG_INFINITY = -1.0 / 0.0;
    const f64 NAN = 0.0 / 0.0;
    const f64 MAX_VALUE = 1.7976931348623157e+308;
    const f64 MIN_VALUE = -1.7976931348623157e+308;
    const f64 MIN_POSITIVE = 2.2250738585072014e-308;
    const f64 EPSILON = 2.2204460492503131e-16;
}