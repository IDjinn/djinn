import std::math;
namespace std::types;

struct size : u32; // TODO: MAYBE UNIQUE TYPE FOR THAT
struct size_long : u64;
struct cstring : i8;

struct c_result : i32;

struct bool : u1;

union optional<T> {
    Empty(),
    Value(T)
}

union result<T, E> {
    Ok(T),
    Error(E)
}

// Exceptions are builtin core types (Exception root + derived errors);
// see docs — no std enum needed anymore.

impl Equatable for arr<T> {
    operator ==(arr<T> left, arr<T> right) -> bool {
        if (left.length != right.length) {
            return false;
        }
        unsafe {
            for (mut size i = 0; i < left.length; i = i + 1) {
                if (*(left.data + (i)) != *(right.data + (i))) {
                    return false;
                }
            }
        }
        return true;
    }
}

impl Hashable for i128, u128 {
    [ForceInline] constexpr u64 hash() {
        u64 hi = (u64)(this >> 64);
        u64w lo = (u64w)this;
        mut u64w x = hi ^ (lo * 0x9e3779b97f4a7c15);

        x = x + 0x9e3779b97f4a7c15;
        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9;
        x = (x ^ (x >> 27)) * 0x94d049bb133111eb;
        x = x ^ (x >> 31);

        return (u64)(x ^ (x >> 32));
    }
}

impl Hashable for i64, u64 {
    [ForceInline] constexpr u64 hash() {
        mut u64w x = (u64w)this + 0x9e3779b97f4a7c15;
        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9;
        x = (x ^ (x >> 27)) * 0x94d049bb133111eb;
        x = x ^ (x >> 31);

        return (u64)(x ^ (x >> 32));
    }
}

impl Hashable for i8, i16, i32, u8, u16, u32 {
     [ForceInline] constexpr u64 hash() {
        return (u64)this;
    }
}

impl Hashable for f32 {
    [ForceInline] constexpr u64 hash() {
        // Reinterpret f32 bits as u32 via pointer cast, then hash as integer
        f32* p = &this;
        u32* ip = (u32*)p;
        mut u64w x = (u64w)*ip + 0x9e3779b97f4a7c15;
        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9;
        x = (x ^ (x >> 27)) * 0x94d049bb133111eb;
        return x ^ (x >> 31);
    }
}

impl Hashable for f64 {
    [ForceInline] constexpr u64 hash() {
        // Reinterpret f64 bits as u64 via pointer cast, then hash
        f64* p = &this;
        u64* ip = (u64*)p;
        mut u64w x = (u64w)*ip + 0x9e3779b97f4a7c15;
        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9;
        x = (x ^ (x >> 27)) * 0x94d049bb133111eb;
        return x ^ (x >> 31);
    }
}

impl INumber for i8, i16, i32, i64, u8, u16, u32, u64 {
    [ForceInline] constexpr bool isZero() {
        return this == 0;
    }

    [ForceInline] constexpr bool isNegative() {
        return this < 0;
    }

    [ForceInline] constexpr bool isPositive() {
        return this > 0;
    }
}

impl INumber for f32, f64 {
    [ForceInline] constexpr bool isZero() {
        return this == 0.0;
    }

    [ForceInline] constexpr bool isNegative() {
        return this < 0.0;
    }

    [ForceInline] constexpr bool isPositive() {
        return this > 0.0;
    }
}

impl Hashable, Equatable for i8* {
    [ForceInline] constexpr u64 hash() {
        return 0;
    }

    operator ==(i8* left, i8* right) -> bool {
        return left == right;
    }
}

struct TypeInfo {
    i32 id;
    i32 size;
    i8* name;
    u8 kind;
    u8 flags;

    [ForceInline] constexpr u64 hash() {
        mut u64w x = (u64w)this.id;
        x = x * 31 + (u64)this.size;
        x = x * 31 + (u64)this.kind;
        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9;
        x = (x ^ (x >> 27)) * 0x94d049bb133111eb;
        x = x ^ (x >> 31);

        return (u64)(x ^ (x >> 32));
    }
}

struct AttributeInfo {
    i8* name;
    i8* value;
    void* payload;
}

struct FieldInfo {
    i8* name;
    i32 typeId;
    u16 offset;
    u8 flags;
    u8 attrCount;
    AttributeInfo* attrs;
}

struct ParamInfo {
    i8* name;
    i32 typeId;
    u8 flags;
    u8 attrCount;
    AttributeInfo* attrs;
}

struct MethodInfo {
    i8* name;
    void* funcPtr;
    i32 returnTypeId;
    u8 paramCount;
    u8 flags;
    u8 attrCount;
    AttributeInfo* attrs;
    ParamInfo* params;
}

struct TypeInfoExt {
    TypeInfo base;
    u16 fieldCount;
    u16 methodCount;
    u8 attrCount;
    FieldInfo* fields;
    MethodInfo* methods;
    AttributeInfo* attrs;
    void* detail;
    i8** interfaces;
    u16 interfaceCount;
}

struct object : Hashable {
    TypeInfo* type;
    void* data;

    [ForceInline] constexpr u64 hash() {
        return this.type.hash();
    }
}

impl Equatable for object {
    operator ==(object left, object right) -> bool {
        return left.type == right.type && left.data == right.data;
    }
}

struct str {
    i8* data;
    size length;
    StringMeta meta;

    public const str EMPTY = "";

    public bool is_empty() {
        return this.length == 0u;
    }

    public i8* ptr() {
        return this.data;
    }

    [ForceInline] public static unsafe str view(i8* data, size length) {
        return { .data = data, .length = length };
    }

    [ForceInline] public static unsafe str fromC(ptr<cstring> text) {
        if (text == null) {
            return str.EMPTY;
        }
        return { .data = (i8*)text, .length = (size)strlen((i8*)text) };
    }

    [ForceInline] operator get[](str text, size index) -> i8 {
        bounds_check(index, text.length);
        unsafe {
            return *(text.data + (index));
        }
    }

    public unsafe i8* toCString() {
        i8* copy = __djinn_alloc(this.length + 1);
        memcpy(copy, this.data, this.length);
        *(copy + (this.length)) = 0;
        return copy;
    }
}

struct arr<T> : Hashable
where T : Hashable, Equatable {
    T* data;
    size length;

    [ForceInline] public unsafe constexpr u64 hash() {
        mut u64w result = 1;
        for (mut size i = 0; i < this.length; i = i + 1) {
            u64 item_hash = (*(this.data + (i))).hash();
            result = 31 * result + (u32)((item_hash ^ (item_hash >> 32)) & 4294967295);
        }
        return result;
    }

    public bool is_empty() {
        return this.length == 0u;
    }

    public i8* ptr() {
        return (i8*)this.data;
    }
}

// The 32-bit tag of a string: 4 flag bits, then a 28-bit cached hash (0 = not computed yet).
// The layout is fixed: the compiler builds literals with bits = 1 (STATIC), and the core runtime's string frees its bytes
// exactly when bit 0 is clear. A heap string is bits = 0.
//   bit 0 STATIC    the bytes live in the binary (a literal): never freed
//   bit 1 INTERNED  the bytes belong to an interner: never freed
//   bit 2 ASCII     every byte is below 128 (set only when known)
//   bit 3           reserved
struct StringMeta {
    u32 bits;

    public const u32 STATIC = 1;
    public const u32 INTERNED = 2;
    public const u32 ASCII = 4;
    public const u32 FLAGS_MASK = 15;
    public const u32 HASH_SHIFT = 4;

    [ForceInline] public static constexpr StringMeta heap() {
        return { .bits = 0 };
    }

    [ForceInline] public static constexpr StringMeta literal() {
        return { .bits = StringMeta.STATIC };
    }

    [ForceInline] public static constexpr StringMeta of_flags(u32 flags) {
        return { .bits = flags & StringMeta.FLAGS_MASK };
    }

    [ForceInline] public constexpr bool is_static() {
        return (this.bits & StringMeta.STATIC) != 0;
    }

    [ForceInline] public constexpr bool is_interned() {
        return (this.bits & StringMeta.INTERNED) != 0;
    }

    [ForceInline] public constexpr bool is_ascii() {
        return (this.bits & StringMeta.ASCII) != 0;
    }

    // True when the string owns heap bytes that disposable() must free.
    [ForceInline] public constexpr bool is_owned() {
        return (this.bits & (StringMeta.STATIC | StringMeta.INTERNED)) == 0;
    }

    // The cached 28-bit hash, or 0 when it was not computed.
    [ForceInline] public constexpr u32 hash() {
        return this.bits >> StringMeta.HASH_SHIFT;
    }

    [ForceInline] public constexpr StringMeta with_hash(u32 hash) {
        return { .bits = (this.bits & StringMeta.FLAGS_MASK) | (hash << StringMeta.HASH_SHIFT) };
    }
}

struct string : Disposable {
    i8* data;
    size length;
    StringMeta meta;

    public void disposable() {
        if (this.meta.is_owned()) {
            __djinn_free(this.data);
        }
    }

    [ForceInline] public static constexpr string EMPTY() {
        return { .data = "", .length = 0u, .meta = StringMeta.literal() };
    }

    public bool is_static() {
        return this.meta.is_static();
    }

    public bool is_empty() {
        return this.length == 0u;
    }

    public i8* ptr() {
        return this.data;
    }

    [ForceInline] operator get[](string text, size index) -> i8 {
        bounds_check(index, text.length);
        unsafe {
            return *(text.data + (index));
        }
    }

    public unsafe i8* toCString() {
        i8* copy = __djinn_alloc(this.length + 1);
        memcpy(copy, this.data, this.length);
        *(copy + (this.length)) = 0;
        return copy;
    }

    public i32 length() {
        return (i32)this.length;
    }
}

[ForceInline] bool isSpace(i8 c) {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

[ForceInline] bool isSpace(char c) {
    // Only ASCII whitespace counts; larger code points must not wrap into the i8 range.
    if ((u32)c > 127) {
        return false;
    }
    return isSpace((i8)c);
}

size encodeChar(i8* out, char value) {
    unsafe {
        u32 code = (u32)value;
        if (code < 128) {
            *(out + (0)) = (i8)code;
            return 1;
        }
        if (code < 2048) {
            *(out + (0)) = (i8)(u8)(192 | (code >> 6));
            *(out + (1)) = (i8)(u8)(128 | (code & 63));
            return 2;
        }
        if (code < 65536) {
            *(out + (0)) = (i8)(u8)(224 | (code >> 12));
            *(out + (1)) = (i8)(u8)(128 | ((code >> 6) & 63));
            *(out + (2)) = (i8)(u8)(128 | (code & 63));
            return 3;
        }
        *(out + (0)) = (i8)(u8)(240 | (code >> 18));
        *(out + (1)) = (i8)(u8)(128 | ((code >> 12) & 63));
        *(out + (2)) = (i8)(u8)(128 | ((code >> 6) & 63));
        *(out + (3)) = (i8)(u8)(128 | (code & 63));
        return 4;
    }
}

// Views value as UTF-8 text. ForceInline keeps the i8[4] stack array in the caller's frame, so the str stays valid while the caller runs.
[ForceInline] str encodeCharText(char value) {
    unsafe {
        i8* out = i8[4];
        size count = encodeChar(out, value);
        str encoded = { .data = out, .length = count };
        return encoded;
    }
}

impl Hashable for str, string {
    bool startsWith(char value) {
        return this.startsWith(encodeCharText(value));
    }

    bool endsWith(char value) {
        return this.endsWith(encodeCharText(value));
    }

    i32 indexOf(char value) {
        return this.indexOf(encodeCharText(value));
    }

    i32 lastIndexOf(char value) {
        return this.lastIndexOf(encodeCharText(value));
    }

    bool contains(char value) {
        return this.indexOf(value) >= 0;
    }

    [ForceInline] constexpr u64 hash() {
        unsafe {
            return TextHash.of(this.data, this.length);
        }
    }

    bool startsWith(str prefix) {
        unsafe {
            if (prefix.length > this.length) {
                return false;
            }
            for (mut size i = 0; i < prefix.length; i = i + 1) {
                if (*(this.data + (i)) != *(prefix.data + (i))) {
                    return false;
                }
            }
            return true;
        }
    }

    bool endsWith(str suffix) {
        unsafe {
            if (suffix.length > this.length) {
                return false;
            }
            size offset = this.length - suffix.length;
            for (mut size i = 0; i < suffix.length; i = i + 1) {
                if (*(this.data + (offset + i)) != *(suffix.data + (i))) {
                    return false;
                }
            }
            return true;
        }
    }

    i32 indexOf(str needle) {
        unsafe {
            if (needle.length > this.length) {
                return -1;
            }
            size last = this.length - needle.length;
            for (mut size i = 0; i <= last; i = i + 1) {
                mut bool matches = true;
                for (mut size j = 0; j < needle.length; j = j + 1) {
                    if (*(this.data + (i + j)) != *(needle.data + (j))) {
                        matches = false;
                        break;
                    }
                }
                if (matches) {
                    return (i32)i;
                }
            }
            return -1;
        }
    }

    i32 lastIndexOf(str needle) {
        unsafe {
            if (needle.length > this.length) {
                return -1;
            }
            mut i32 i = (i32)(this.length - needle.length);
            while (i >= 0) {
                mut bool matches = true;
                for (mut size j = 0; j < needle.length; j = j + 1) {
                    if (*(this.data + ((size)i + j)) != *(needle.data + (j))) {
                        matches = false;
                        break;
                    }
                }
                if (matches) {
                    return i;
                }
                i = i - 1;
            }
            return -1;
        }
    }

    i32 indexOfChar(i8 value) {
        unsafe {
            for (mut size i = 0; i < this.length; i = i + 1) {
                if (*(this.data + (i)) == value) {
                    return (i32)i;
                }
            }
            return -1;
        }
    }

    bool contains(str needle) {
        return this.indexOf(needle) >= 0;
    }

    bool containsChar(i8 value) {
        return this.indexOfChar(value) >= 0;
    }

    i8 charAt(size index) {
        unsafe {
            Debug.assert(index < this.length, "index out of bounds");
            return *(this.data + (index));
        }
    }

    bool equalsIgnoreCase(str other) {
        unsafe {
            if (other.length != this.length) {
                return false;
            }
            for (mut size i = 0; i < this.length; i = i + 1) {
                mut i8 a = *(this.data + (i));
                mut i8 b = *(other.data + (i));
                if (a >= 65 && a <= 90) { a = a + 32; }
                if (b >= 65 && b <= 90) { b = b + 32; }
                if (a != b) {
                    return false;
                }
            }
            return true;
        }
    }

    bool isBlank() {
        unsafe {
            for (mut size i = 0; i < this.length; i = i + 1) {
                i8 c = *(this.data + (i));
                if (c != 32 && c != 9 && c != 10 && c != 13) {
                    return false;
                }
            }
            return true;
        }
    }

    str trimStart() {
        unsafe {
            mut size start = 0;
            while (start < this.length && isSpace(*(this.data + (start)))) {
                start = start + 1;
            }
            return { .data = this.data + start, .length = this.length - start };
        }
    }

    str trimEnd() {
        unsafe {
            mut size end = this.length;
            while (end > 0 && isSpace(*(this.data + (end - 1)))) {
                end = end - 1;
            }
            return { .data = this.data, .length = end };
        }
    }

    str trim() {
        return this.trimStart().trimEnd();
    }

    str slice(size start, size length) {
        Debug.assert(start <= this.length, "start out of bounds");
        Debug.assert(start + length <= this.length, "length out of bounds");

        return { .data = this.data + start, .length = length };
    }

    string substring(size start, size length) {
        Debug.assert(start <= this.length, "start out of bounds");
        Debug.assert(start + length <= this.length, "length out of bounds");

        i8* data_buffer = __djinn_alloc((u64)length + 1);
        memcpy(data_buffer, (this.data + start), length);
        unsafe {
            *(data_buffer + (length)) = 0;
        }
        return { .data = data_buffer, .length = (u32)length, .meta = StringMeta.heap() };
    }

    string concat(string left, string right) {
        return left + right;
    }

    operator +(string left, string right) -> string {
        u32 new_len = (u32)((u32t)left.length + right.length);
        i8* new_data = __djinn_alloc((u64)new_len + 1);
        memcpy(new_data, left.data, left.length);
        memcpy(new_data + left.length, right.data, right.length);
        unsafe {
            *(new_data + (new_len)) = 0;
        }
        return { .data = new_data, .length = new_len, .meta = StringMeta.heap() };
    }
}

[ForceInline] bool textEquals(i8* left, i8* right, u32 leftLength, u32 rightLength) {
    if (leftLength != rightLength) {
        return false;
    }
    if (left == right || leftLength == 0) {
        return true;
    }
    unsafe {
        return memcmp(left, right, (size_long)leftLength) == 0;
    }
}

bool charEqualsText(char value, i8* data, u32 length) {
    unsafe {
        if (length == 0 || length > 4) {
            return false;
        }
        u32 code = (u32)value;
        if (code < 128) {
            return length == 1 && *(data + (0)) == (i8)code;
        }
        i8* bytes = i8[4];
        size count = encodeChar(bytes, value);
        if (count != length) {
            return false;
        }
        for (mut size i = 0; i < count; i = i + 1) {
            if (*(bytes + (i)) != *(data + (i))) {
                return false;
            }
        }
        return true;
    }
}

impl Equatable for str {
    operator ==(str left, str right) -> bool {
        return textEquals(left.data, right.data, left.length, right.length);
    }

    operator ==(char left, str right) -> bool {
        return charEqualsText(left, right.data, right.length);
    }

    operator ==(str left, char right) -> bool {
        return charEqualsText(right, left.data, left.length);
    }
}

impl Equatable for string {
    operator ==(string left, string right) -> bool {
        return textEquals(left.data, right.data, left.length, right.length);
    }

    operator ==(char left, string right) -> bool {
        return charEqualsText(left, right.data, right.length);
    }

    operator ==(string left, char right) -> bool {
        return charEqualsText(right, left.data, left.length);
    }
}

impl char {
    const char NULL = '\0';
    const char REPLACEMENT = '�';
    const char MAX_VALUE = '\U0010FFFF';
    const char BOM = '﻿';
    const char TAB = '\t';
    const char LF = '\n';
    const char CR = '\r';
    const char SPACE = ' ';

    [ForceInline] bool is_null() {
        return (u32)this == 0;
    }

    [ForceInline] bool is_ascii() {
        return (u32)this < 128;
    }

    [ForceInline] bool is_replacement() {
        return (u32)this == 65533;
    }
}

impl i8 {
    const i32 BITS = 8;
    const i8 MAX_VALUE = 127;
    const i8 MIN_VALUE = -128;

    constexpr i8 min(i8 other) {
        if (this < other) { return this; }
        return other;
    }

    constexpr i8 max(i8 other) {
        if (this > other) { return this; }
        return other;
    }
}

impl i16 {
    const i32 BITS = 16;
    const i16 MAX_VALUE = 32767;
    const i16 MIN_VALUE = -32768;

    constexpr i16 min(i16 other) {
        if (this < other) { return this; }
        return other;
    }

    constexpr i16 max(i16 other) {
        if (this > other) { return this; }
        return other;
    }
}

