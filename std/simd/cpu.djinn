import std::sys;

namespace std::simd;

extern "C" {
    u32 __djinn_cpu_features();
}

// The SIMD extensions of the CPU the program runs on, read once from the processor. A program is compiled for a
// baseline CPU (SSE2 on x86-64) unless --cpu says more, so a faster path compiled with [Target("avx2")] is taken only
// after asking here:
//
//     if (Cpu.has_avx2()) { unsafe { return sum_avx2(values); } }
//     return sum(values);
//
// On WebAssembly every answer is false.
struct Cpu {
    const u32 SSE2 = 1;
    const u32 SSE3 = 2;
    const u32 SSSE3 = 4;
    const u32 SSE41 = 8;
    const u32 SSE42 = 16;
    const u32 POPCNT = 32;
    const u32 AVX = 64;
    const u32 AVX2 = 128;
    const u32 FMA = 256;
    const u32 BMI2 = 512;
    const u32 AVX512F = 1024;
    const u32 AVX512BW = 2048;
    const u32 NEON = 4096;

    // One bit per extension, as the constants above.
    public static u32 features() {
        if constexpr Platform.Web {
            return 0;
        } else {
            unsafe {
                return __djinn_cpu_features() & 1073741823;
            }
        }
    }

    public static bool has(u32 wanted) {
        return (Cpu.features() & wanted) == wanted;
    }

    public static bool has_sse2() {
        return Cpu.has(Cpu.SSE2);
    }

    public static bool has_ssse3() {
        return Cpu.has(Cpu.SSSE3);
    }

    public static bool has_sse41() {
        return Cpu.has(Cpu.SSE41);
    }

    public static bool has_sse42() {
        return Cpu.has(Cpu.SSE42);
    }

    public static bool has_avx() {
        return Cpu.has(Cpu.AVX);
    }

    public static bool has_avx2() {
        return Cpu.has(Cpu.AVX2);
    }

    public static bool has_fma() {
        return Cpu.has(Cpu.FMA);
    }

    public static bool has_avx512() {
        return Cpu.has(Cpu.AVX512F | Cpu.AVX512BW);
    }

    public static bool has_neon() {
        return Cpu.has(Cpu.NEON);
    }
}
