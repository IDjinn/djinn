import std::types;

namespace std::simd;

// One bool per lane: what the comparisons of vector<T, N> return and what select() reads. N is at most 64, so the
// lanes also fit in the bits of a u64 (bit i is lane i).
struct mask<N> {
    bool[N] lanes;

    public static mask<N> of(bool[N] values) {
        mask<N> made = { .lanes = values };
        return made;
    }

    public i32 length() {
        return N;
    }

    operator get[](mask<N> picked, i32 index) -> bool {
        return picked.lanes[index];
    }

    [Simd("any")] public bool any() {
        for (mut i32 i = 0; i < N; i = i + 1) {
            if (this.lanes[i]) {
                return true;
            }
        }
        return false;
    }

    [Simd("all")] public bool all() {
        for (mut i32 i = 0; i < N; i = i + 1) {
            if (!this.lanes[i]) {
                return false;
            }
        }
        return true;
    }

    public bool none() {
        return !this.any();
    }

    [Simd("count")] public i32 count() {
        mut i32 total = 0;
        for (mut i32 i = 0; i < N; i = i + 1) {
            if (this.lanes[i]) {
                total = total + 1;
            }
        }
        return total;
    }

    // movemask: bit i holds lane i.
    [Simd("bits")] public u64 bits() {
        mut u64 packed = 0;
        for (mut i32 i = 0; i < N; i = i + 1) {
            if (this.lanes[i]) {
                packed = packed | ((u64)1 << (u64)i);
            }
        }
        return packed;
    }

    [Simd("bitwise_not")] public mask<N> invert() {
        mut mask<N> out = {};
        for (mut i32 i = 0; i < N; i = i + 1) {
            out.lanes[i] = !this.lanes[i];
        }
        return out;
    }

    [Simd("and")] operator &(mask<N> left, mask<N> right) -> mask<N> {
        mut mask<N> out = {};
        for (mut i32 i = 0; i < N; i = i + 1) {
            out.lanes[i] = left.lanes[i] && right.lanes[i];
        }
        return out;
    }

    [Simd("or")] operator |(mask<N> left, mask<N> right) -> mask<N> {
        mut mask<N> out = {};
        for (mut i32 i = 0; i < N; i = i + 1) {
            out.lanes[i] = left.lanes[i] || right.lanes[i];
        }
        return out;
    }

    [Simd("xor")] operator ^(mask<N> left, mask<N> right) -> mask<N> {
        mut mask<N> out = {};
        for (mut i32 i = 0; i < N; i = i + 1) {
            out.lanes[i] = left.lanes[i] != right.lanes[i];
        }
        return out;
    }

    [Simd("all_equal")] operator ==(mask<N> left, mask<N> right) -> bool {
        for (mut i32 i = 0; i < N; i = i + 1) {
            if (left.lanes[i] != right.lanes[i]) {
                return false;
            }
        }
        return true;
    }
}
