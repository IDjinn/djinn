project: "djinn-lsp"
version: "0.1.0"

compiler:
  library-mode: false
  no-cache: true

  output:
    file: "djinn-lsp"
    directory: "build"

  libs: ['std']

  entry: "main.djinn"

  sources: [
    '../djinnc/src/support/memory/arena.djinn',
    '../djinnc/src/support/memory/arena_block.djinn',
    '../djinnc/src/support/memory/arena_mark.djinn',
    '../djinnc/src/support/memory/memory.djinn',
    '../djinnc/src/support/collections/pointer_list.djinn',
    '../djinnc/src/support/text/byte_buffer.djinn',
    '../djinnc/src/support/text/strings.djinn',
    '../djinnc/src/support/system/files.djinn',
    '../djinnc/src/support/system/libc.djinn',
    '../djinnc/src/support/system/log.djinn',
    '../djinnc/src/support/system/process.djinn'
  ]
