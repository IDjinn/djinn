namespace djinnc;

struct Rpc {
    static unsafe void emit(ByteBuffer* body) {
        Transport.send(body.cstr(), body.length);
    }

    public static unsafe void respond(JsonValue* id, ByteBuffer* result) {
        ByteBuffer* out = ByteBuffer.create();
        out.append("{\"jsonrpc\":\"2.0\",\"id\":");
        Json.write_id(out, id);
        out.append(",\"result\":");
        if (result == null) {
            out.append("null");
        } else {
            out.append(result.cstr());
        }
        out.append("}");
        Rpc.emit(out);
    }

    public static unsafe void respond_error(JsonValue* id, i32 code, ptr<i8> message) {
        ByteBuffer* out = ByteBuffer.create();
        out.append("{\"jsonrpc\":\"2.0\",\"id\":");
        Json.write_id(out, id);
        out.append(",\"error\":{\"code\":");
        out.append_int((i64)code);
        out.append(",\"message\":");
        out.append_json_string(message);
        out.append("}}");
        Rpc.emit(out);
    }

    public static unsafe void notify(ptr<i8> method, ByteBuffer* params) {
        ByteBuffer* out = ByteBuffer.create();
        out.append("{\"jsonrpc\":\"2.0\",\"method\":");
        out.append_json_string(method);
        out.append(",\"params\":");
        out.append(params.cstr());
        out.append("}");
        Rpc.emit(out);
    }

    public static unsafe void log(i32 level, ptr<i8> message) {
        ByteBuffer* params = ByteBuffer.create();
        params.append("{\"type\":");
        params.append_int((i64)level);
        params.append(",\"message\":");
        params.append_json_string(message);
        params.append("}");
        Rpc.notify("window/logMessage", params);
    }
}
