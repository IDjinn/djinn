namespace djinnc;

struct JsonKind {
    const i32 NULL_VALUE = 0;
    const i32 BOOL = 1;
    const i32 INT = 2;
    const i32 REAL = 3;
    const i32 STRING = 4;
    const i32 ARRAY = 5;
    const i32 OBJECT = 6;
}

import std::util;

struct JsonValue {
    ptr handle;
    ptr document;
    i32 kind;

    static unsafe JsonValue* wrap(ptr handle, ptr document) {
        if (handle == null) {
            return (JsonValue*)0;
        }
        JsonValue* value = (JsonValue*)Memory.zalloc(sizeof(JsonValue));
        value.handle = handle;
        value.document = document;
        value.kind = Json.kind(handle);
        return value;
    }

    public unsafe JsonValue* get(ptr<i8> key) {
        if (this.kind != JsonKind.OBJECT) {
            return (JsonValue*)0;
        }
        return switch Json.get(this.handle, key) {
            Value found -> JsonValue.wrap(found, (ptr)0),
            Empty -> (JsonValue*)0
        };
    }

    public unsafe JsonValue* at(i32 index) {
        if (this.kind != JsonKind.ARRAY) {
            return (JsonValue*)0;
        }
        return switch Json.at(this.handle, index) {
            Value found -> JsonValue.wrap(found, (ptr)0),
            Empty -> (JsonValue*)0
        };
    }

    public unsafe i32 length() {
        if (this.kind != JsonKind.ARRAY && this.kind != JsonKind.OBJECT) {
            return 0;
        }
        return Json.length(this.handle);
    }

    public unsafe ptr<i8> string_or(ptr<i8> fallback) {
        if (this.kind != JsonKind.STRING) {
            return fallback;
        }
        return (ptr<i8>)Json.as_text(this.handle);
    }

    public unsafe i64 int_or(i64 fallback) {
        if (this.kind == JsonKind.INT) {
            return Json.as_int(this.handle);
        }
        if (this.kind == JsonKind.REAL) {
            return (i64)Json.as_real(this.handle);
        }
        return fallback;
    }

    public unsafe bool bool_or(bool fallback) {
        if (this.kind != JsonKind.BOOL) {
            return fallback;
        }
        return Json.as_bool(this.handle);
    }

    public unsafe ptr<i8> field_string(ptr<i8> key) {
        JsonValue* value = this.get(key);
        if (value == null) {
            return null;
        }
        return value.string_or(null);
    }

    public unsafe i64 field_int(ptr<i8> key, i64 fallback) {
        JsonValue* value = this.get(key);
        if (value == null) {
            return fallback;
        }
        return value.int_or(fallback);
    }

    public unsafe bool field_bool(ptr<i8> key, bool fallback) {
        JsonValue* value = this.get(key);
        if (value == null) {
            return fallback;
        }
        return value.bool_or(fallback);
    }

    public unsafe void release() {
        if (this.document != null) {
            Json.release(this.document);
            this.document = (ptr)0;
        }
    }
}

struct JsonDoc {
    public static unsafe JsonValue* parse(ptr<i8> text, i32 length) {
        return switch Json.parse(text, length) {
            Value document -> JsonDoc.root_of(document),
            Empty -> (JsonValue*)0
        };
    }

    static unsafe JsonValue* root_of(ptr document) {
        JsonValue* root = JsonValue.wrap(Json.root(document), document);
        if (root == null) {
            Json.release(document);
        }
        return root;
    }

    public static unsafe void write_id(ByteBuffer* out, JsonValue* id) {
        if (id == null || id.kind == JsonKind.NULL_VALUE) {
            out.append("null");
        } else if (id.kind == JsonKind.STRING) {
            out.append_json_string(id.string_or(""));
        } else {
            out.append_int(id.int_or(0));
        }
    }
}
