namespace djinnc;

struct ST {
    const i32 NAMESPACE = 0;
    const i32 TYPE = 1;
    const i32 CLASS = 2;
    const i32 ENUM = 3;
    const i32 INTERFACE = 4;
    const i32 STRUCT = 5;
    const i32 TYPE_PARAMETER = 6;
    const i32 PARAMETER = 7;
    const i32 VARIABLE = 8;
    const i32 PROPERTY = 9;
    const i32 ENUM_MEMBER = 10;
    const i32 FUNCTION = 11;
    const i32 METHOD = 12;
    const i32 MACRO = 13;
    const i32 KEYWORD = 14;
    const i32 DECORATOR = 15;
    const i32 TAG = 16;
    const i32 OPERATOR = 17;
    const i32 STRING = 18;
    const i32 TEXT = 19;
}

struct SM {
    const i32 DECLARATION = 1;
    const i32 READONLY = 2;
    const i32 STATIC = 4;
    const i32 DEFAULT_LIBRARY = 8;
    const i32 CLASS_MEMBER = 16;
}

struct Semantic {
    public static unsafe ptr<i8> legend() {
        return "{\"tokenTypes\":[\"namespace\",\"type\",\"class\",\"enum\",\"interface\",\"struct\",\"typeParameter\",\"parameter\",\"variable\",\"property\",\"enumMember\",\"function\",\"method\",\"macro\",\"keyword\",\"decorator\",\"tag\",\"operator\",\"string\",\"text\"],\"tokenModifiers\":[\"declaration\",\"readonly\",\"static\",\"defaultLibrary\",\"classMember\"]}";
    }

    static unsafe i32 type_for(Sym* sym) {
        if (sym.kind == SK.STRUCT) {
            return ST.STRUCT;
        }
        if (sym.kind == SK.ENUM) {
            return ST.ENUM;
        }
        if (sym.kind == SK.INTERFACE) {
            return ST.INTERFACE;
        }
        if (sym.kind == SK.NAMESPACE) {
            return ST.NAMESPACE;
        }
        if (sym.kind == SK.FUNCTION) {
            if ((sym.flags & SF.MACRO) != 0) {
                return ST.MACRO;
            }
            return ST.FUNCTION;
        }
        if (sym.kind == SK.METHOD || sym.kind == SK.CONSTRUCTOR || sym.kind == SK.OPERATOR) {
            return ST.METHOD;
        }
        if (sym.kind == SK.FIELD) {
            return ST.PROPERTY;
        }
        if (sym.kind == SK.ENUM_MEMBER) {
            return ST.ENUM_MEMBER;
        }
        if ((sym.flags & SF.PARAM) != 0) {
            return ST.PARAMETER;
        }
        return ST.VARIABLE;
    }

    static unsafe i32 modifiers_for(Sym* sym, bool declaration) {
        mut i32 mods = 0;
        if (declaration) {
            mods = mods | SM.DECLARATION;
        }
        if (sym.kind == SK.CONSTANT || sym.kind == SK.ENUM_MEMBER) {
            mods = mods | SM.READONLY;
        }
        if ((sym.flags & SF.STATIC) != 0) {
            mods = mods | SM.STATIC;
        }
        if (sym.unit.library) {
            mods = mods | SM.DEFAULT_LIBRARY;
        }
        if (sym.kind == SK.FIELD) {
            mods = mods | SM.CLASS_MEMBER;
        }
        return mods;
    }

    // A generic argument list: `<` ... `>` holding only type-like tokens, right after a name.
    static unsafe bool opens_type_arguments(Unit* u, i32 c) {
        if (!u.is_punct(c + 1, 60)) {
            return false;
        }
        mut i32 depth = 0;
        for (mut i32 i = c + 1; i < u.code_count && i < c + 40; i = i + 1) {
            i32 raw = u.code[i];
            i32 kind = u.tkind[raw];
            if (u.is_punct(i, 60)) {
                depth = depth + 1;
            } else if (u.is_punct(i, 62)) {
                depth = depth - 1;
                if (depth == 0) {
                    return true;
                }
            } else if (kind == Tk.IDENT || kind == Tk.TYPE || kind == Tk.NUMBER) {
                continue;
            } else if (u.is_punct(i, 44) || u.is_punct(i, 63) || u.is_punct(i, 42) || u.is_scope(i)) {
                continue;
            } else {
                return false;
            }
        }
        return false;
    }

    static unsafe bool inside_type_arguments(Unit* u, i32 c) {
        mut i32 depth = 0;
        for (mut i32 i = c - 1; i >= 0 && i > c - 40; i = i - 1) {
            i32 raw = u.code[i];
            i32 kind = u.tkind[raw];
            if (u.is_punct(i, 62)) {
                depth = depth + 1;
            } else if (u.is_punct(i, 60)) {
                if (depth == 0) {
                    if (i == 0) {
                        return false;
                    }
                    i32 before = u.code[i - 1];
                    return u.tkind[before] == Tk.IDENT || u.tkind[before] == Tk.TYPE;
                }
                depth = depth - 1;
            } else if (kind == Tk.IDENT || kind == Tk.TYPE || kind == Tk.NUMBER) {
                continue;
            } else if (u.is_punct(i, 44) || u.is_punct(i, 63) || u.is_punct(i, 42) || u.is_scope(i)) {
                continue;
            } else {
                return false;
            }
        }
        return false;
    }

    static unsafe bool is_type_parameter_name(ptr<i8> name) {
        i32 length = strlen(name);
        if (length == 0) {
            return false;
        }
        if (length > 2) {
            // TKey, TValue, TResult: a capital T followed by a capitalised word.
            i32 second = (i32)name[1];
            return name[0] == 84 && second >= 65 && second <= 90;
        }
        for (mut i32 i = 0; i < length; i = i + 1) {
            i32 c = (i32)name[i];
            if (!(c >= 65 && c <= 90) && !(c >= 48 && c <= 57)) {
                return false;
            }
        }
        return true;
    }

    static unsafe i32 classify(Unit* u, i32 raw, i32 c, ptr<i32> mods_out) {
        mods_out[0] = 0;
        i32 kind = u.tkind[raw];
        if (u.tok_sym[raw] != null) {
            Sym* declared = (Sym*)u.tok_sym[raw];
            mods_out[0] = Semantic.modifiers_for(declared, true);
            return Semantic.type_for(declared);
        }
        if (kind == Tk.TYPE) {
            mods_out[0] = SM.DEFAULT_LIBRARY;
            return ST.TYPE;
        }
        if (kind == Tk.KEYWORD) {
            return 0 - 1;
        }
        if (u.tcls[raw] == 1) {
            return ST.NAMESPACE;
        }
        if (c >= 2 && u.is_punct(c - 1, 91) && (u.is_punct(c - 2, 59) || u.is_punct(c - 2, 123) || u.is_punct(c - 2, 125) || u.is_punct(c - 2, 93))) {
            return ST.DECORATOR;
        }
        if (c == 1 && u.is_punct(0, 91)) {
            return ST.DECORATOR;
        }
        bool member = c > 0 && u.is_member_access(c - 1);
        if (member) {
            if (u.is_punct(c + 1, 40)) {
                return ST.METHOD;
            }
            if (c > 1 && u.is_word(c - 2, "this")) {
                mods_out[0] = SM.CLASS_MEMBER;
            }
            return ST.PROPERTY;
        }
        if (u.is_punct(c + 1, 33) && u.is_punct(c + 2, 40)) {
            return ST.MACRO;
        }
        ptr<i8> name = u.token_text(raw);
        bool scoped_left = c > 0 && u.is_scope(c - 1);
        Sym* function = Resolve.enclosing_callable(u, raw);
        if (function != null && !scoped_left) {
            Sym* local = Resolve.local(u, function, name, raw);
            if (local != null) {
                return Semantic.type_for(local);
            }
        }
        PointerList* list = Workspace.find(name);
        if (list != null) {
            for (mut i32 i = 0; i < list.length; i = i + 1) {
                Sym* sym = (Sym*)list.get(i);
                if (sym.is_global() || (sym.parent != null && sym.parent.kind == SK.NAMESPACE) || sym.is_member()) {
                    if (sym.is_member() && !scoped_left && !(function != null && function.parent != null && Strings.same(function.parent.name, sym.parent.name))) {
                        continue;
                    }
                    mods_out[0] = Semantic.modifiers_for(sym, false);
                    return Semantic.type_for(sym);
                }
            }
        }
        if (u.is_scope(c + 1)) {
            return ST.NAMESPACE;
        }
        if (u.is_punct(c + 1, 40)) {
            return ST.FUNCTION;
        }
        if (Semantic.is_type_parameter_name(name)) {
            return ST.TYPE_PARAMETER;
        }
        if (Semantic.opens_type_arguments(u, c)) {
            return ST.TYPE;
        }
        if (Semantic.inside_type_arguments(u, c)) {
            i32 first = (i32)name[0];
            if (first >= 65 && first <= 90) {
                return ST.TYPE;
            }
        }
        return 0 - 1;
    }

    // `attribute` is a contextual keyword: only the top level of a file declares one (`attribute Name(...);`,
    // `attribute Name { ... }`), so the word is a keyword there (and the name a decorator); inside any `{ }` block, or as the
    // name of something (`[attribute]`, a variable called attribute), it stays a plain identifier.
    static unsafe void mark_attributes(Unit* u, ptr<i8> over) {
        mut i32 c = 0;
        while (c < u.code_count) {
            if (u.is_punct(c, 123) && u.match[c] > c) {
                c = u.match[c] + 1;
                continue;
            }
            bool declaration = u.is_word(c, "attribute") && c + 2 < u.code_count
                && u.kind_at(c + 1) == Tk.IDENT
                && (u.is_punct(c + 2, 40) || u.is_punct(c + 2, 123) || u.is_punct(c + 2, 59))
                && !(c > 0 && u.is_punct(c - 1, 91));
            if (declaration) {
                over[c] = (i8)(ST.KEYWORD + 1);
                over[c + 1] = (i8)(ST.DECORATOR + 1);
                c = c + 2;
                continue;
            }
            c = c + 1;
        }
    }

    // Highlights macro declarations: `macro name! { (word, local expression a, type T) => { body } }`.
    // over[c] holds a token type + 1 for the code tokens that get a fixed colour.
    static unsafe void mark_macros(Unit* u, ptr<i8> over) {
        for (mut i32 c = 0; c + 2 < u.code_count; c = c + 1) {
            if (!u.is_word(c, "macro")) {
                continue;
            }
            mut i32 open = c + 2;
            if (u.is_punct(open, 33)) {
                open = open + 1;
            }
            if (!u.is_punct(open, 123)) {
                continue;
            }
            i32 close = u.match[open];
            if (close <= open) {
                continue;
            }
            over[c + 1] = (i8)(ST.MACRO + 1);
            mut i32 at = open + 1;
            while (at < close) {
                if (u.is_word(at, "local") && u.is_punct(at + 1, 40)) {
                    over[at] = (i8)(ST.KEYWORD + 1);
                    at = at + 1;
                }
                if (!u.is_punct(at, 40)) {
                    at = at + 1;
                    continue;
                }
                i32 params_end = u.match[at];
                if (params_end <= at) {
                    break;
                }
                PointerList* names = PointerList.create();
                mut i32 p = at + 1;
                while (p < params_end) {
                    mut i32 e = p;
                    while (e < params_end && !u.is_punct(e, 44)) {
                        e = e + 1;
                    }
                    if (e - p == 1) {
                        over[p] = (i8)(ST.ENUM_MEMBER + 1);
                    } else if (e - p >= 2) {
                        for (mut i32 k = p; k < e - 1; k = k + 1) {
                            over[k] = (i8)(ST.KEYWORD + 1);
                        }
                        over[e - 1] = (i8)(ST.PARAMETER + 1);
                        names.push((ptr)u.word_at(e - 1));
                    }
                    p = e + 1;
                }
                mut i32 body = params_end + 1;
                while (body < close && body < params_end + 4 && !u.is_punct(body, 123) && !u.is_punct(body, 40)) {
                    body = body + 1;
                }
                if (!u.is_punct(body, 123)) {
                    at = params_end + 1;
                    continue;
                }
                i32 body_end = u.match[body];
                if (body_end <= body) {
                    break;
                }
                for (mut i32 b = body + 1; b < body_end; b = b + 1) {
                    if (u.tkind[u.code[b]] != Tk.IDENT || u.is_member_access(b - 1)) {
                        continue;
                    }
                    ptr<i8> word = u.word_at(b);
                    for (mut i32 n = 0; n < names.length; n = n + 1) {
                        if (Strings.same(word, (ptr<i8>)names.get(n))) {
                            over[b] = (i8)(ST.PARAMETER + 1);
                        }
                    }
                }
                at = body_end + 1;
            }
            c = close;
        }
    }

    public static unsafe ByteBuffer* tokens(Unit* u) {
        ByteBuffer* out = ByteBuffer.create();
        out.append("{\"data\":[");
        mut i32 previous_line = 0;
        mut i32 previous_character = 0;
        mut bool any = false;
        mut i32 mods = 0;
        ptr<i8> over = (ptr<i8>)Memory.zalloc((u64)u.code_count + 8);
        Semantic.mark_macros(u, over);
        Semantic.mark_attributes(u, over);
        Embedded.mark(u, over);
        for (mut i32 c = 0; c < u.code_count; c = c + 1) {
            i32 raw = u.code[c];
            i32 kind = u.tkind[raw];
            mut i32 type = 0 - 1;
            if (over[c] != 0) {
                type = (i32)over[c] - 1;
                mods = 0;
            } else if (kind == Tk.KEYWORD) {
                if (u.is_word(c, "operator")) {
                    type = ST.KEYWORD;
                    mods = 0;
                }
            } else if (kind == Tk.IDENT || kind == Tk.TYPE) {
                type = Semantic.classify(u, raw, c, &mods);
            }
            if (type < 0) {
                continue;
            }
            i32 start = u.tstart[raw];
            i32 line = u.line_of(start);
            i32 character = u.character_of_offset(line, start);
            i32 length = u.character_of_offset(line, u.tend[raw]) - character;
            mut i32 delta_line = line - previous_line;
            mut i32 delta_start = character;
            if (delta_line == 0) {
                delta_start = character - previous_character;
            }
            if (any) {
                out.append(",");
            }
            any = true;
            out.append_int((i64)delta_line);
            out.append(",");
            out.append_int((i64)delta_start);
            out.append(",");
            out.append_int((i64)length);
            out.append(",");
            out.append_int((i64)type);
            out.append(",");
            out.append_int((i64)mods);
            previous_line = line;
            previous_character = character;
        }
        out.append("]}");
        return out;
    }
}
