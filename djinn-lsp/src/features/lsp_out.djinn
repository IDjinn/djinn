namespace djinnc;

struct Lsp {
    public static unsafe void position(ByteBuffer* out, Unit* u, i32 offset) {
        i32 line = u.line_of(offset);
        out.append("{\"line\":");
        out.append_int((i64)line);
        out.append(",\"character\":");
        out.append_int((i64)u.character_of_offset(line, offset));
        out.append("}");
    }

    public static unsafe void range(ByteBuffer* out, Unit* u, i32 from, i32 to) {
        out.append("{\"start\":");
        Lsp.position(out, u, from);
        out.append(",\"end\":");
        Lsp.position(out, u, to);
        out.append("}");
    }

    public static unsafe void token_range(ByteBuffer* out, Unit* u, i32 first, i32 last) {
        Lsp.range(out, u, u.tstart[first], u.tend[last]);
    }

    public static unsafe void name_range(ByteBuffer* out, Sym* sym) {
        Lsp.token_range(out, sym.unit, sym.name_tok, sym.name_end_tok);
    }

    public static unsafe void location(ByteBuffer* out, Sym* sym) {
        out.append("{\"uri\":");
        out.append_json_string(sym.unit.uri);
        out.append(",\"range\":");
        Lsp.name_range(out, sym);
        out.append("}");
    }

    public static unsafe void token_location(ByteBuffer* out, Unit* u, i32 raw) {
        out.append("{\"uri\":");
        out.append_json_string(u.uri);
        out.append(",\"range\":");
        Lsp.token_range(out, u, raw, raw);
        out.append("}");
    }

    public static unsafe void markdown(ByteBuffer* out, ptr<i8> value) {
        out.append("{\"kind\":\"markdown\",\"value\":");
        out.append_json_string(value);
        out.append("}");
    }
}

struct Docs {
    public static unsafe ptr<i8> keyword(ptr<i8> word) {
        if (Strings.same(word, "struct")) {
            return "Declares a value type with fields and methods.";
        }
        if (Strings.same(word, "union")) {
            return "Declares a tagged union; each variant can carry a payload.";
        }
        if (Strings.same(word, "enum")) {
            return "Declares an enumeration, optionally with constructor parameters per member.";
        }
        if (Strings.same(word, "interface")) {
            return "Declares a set of members that a type promises to implement.";
        }
        if (Strings.same(word, "impl")) {
            return "Implements interfaces for one or more types: `impl A, B for T { }`.";
        }
        if (Strings.same(word, "namespace")) {
            return "Names the scope of the declarations that follow in this file.";
        }
        if (Strings.same(word, "import")) {
            return "Brings the declarations of a namespace into scope (after the `namespace` line).";
        }
        if (Strings.same(word, "mut")) {
            return "Makes a local variable assignable; locals are immutable by default.";
        }
        if (Strings.same(word, "unsafe")) {
            return "Marks a function or block that may use raw pointers and unchecked conversions.";
        }
        if (Strings.same(word, "async")) {
            return "Declares a coroutine; calls to it are awaited with `await` or started with `spawn`.";
        }
        if (Strings.same(word, "await")) {
            return "Suspends the current coroutine until the awaited task completes.";
        }
        if (Strings.same(word, "spawn")) {
            return "Starts a task concurrently and returns its handle.";
        }
        if (Strings.same(word, "const")) {
            return "Declares a compile-time constant.";
        }
        if (Strings.same(word, "constexpr")) {
            return "Declares something that is evaluated at compile time.";
        }
        if (Strings.same(word, "static")) {
            return "Declares a member that belongs to the type, not to an instance.";
        }
        if (Strings.same(word, "extern")) {
            return "Declares symbols that are defined outside Djinn, such as C functions.";
        }
        if (Strings.same(word, "operator")) {
            return "Declares an operator overload.";
        }
        if (Strings.same(word, "where")) {
            return "Constrains the type parameters of a generic declaration.";
        }
        if (Strings.same(word, "this")) {
            return "The instance a method is running on.";
        }
        if (Strings.same(word, "throws")) {
            return "Declares that a function may throw.";
        }
        if (Strings.same(word, "require")) {
            return "A precondition checked on entry.";
        }
        if (Strings.same(word, "ensure")) {
            return "A postcondition checked on exit.";
        }
        if (Strings.same(word, "auto")) {
            return "Infers the type of a variable from its initializer.";
        }
        if (Strings.same(word, "ptr")) {
            return "Raw pointer type. `ptr<T>` points to a `T`; plain `ptr` is untyped.";
        }
        if (Strings.same(word, "str")) {
            return "String view type.";
        }
        if (Strings.same(word, "bool")) {
            return "Boolean type: `true` or `false`.";
        }
        if (Strings.same(word, "void")) {
            return "No value.";
        }
        if (Strings.same(word, "size") || Strings.same(word, "usize")) {
            return "Unsigned integer sized for the target pointer width.";
        }
        i32 length = strlen(word);
        if (length >= 2 && (word[0] == 105 || word[0] == 117) && Strings.is_digit((i32)word[1])) {
            if (word[0] == 105) {
                return "Signed integer type. The suffix `w` selects wrapping arithmetic.";
            }
            return "Unsigned integer type. The suffix `w` selects wrapping arithmetic.";
        }
        if (length >= 2 && word[0] == 102 && Strings.is_digit((i32)word[1])) {
            return "Floating point type.";
        }
        return null;
    }
}
