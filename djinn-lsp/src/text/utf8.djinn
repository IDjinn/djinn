namespace djinnc;

struct Utf8 {
    public static unsafe void append(ByteBuffer* out, i32 code) {
        if (code < 128) {
            out.append_char(code);
        } else if (code < 2048) {
            out.append_char(192 | (code >> 6));
            out.append_char(128 | (code & 63));
        } else if (code < 65536) {
            out.append_char(224 | (code >> 12));
            out.append_char(128 | ((code >> 6) & 63));
            out.append_char(128 | (code & 63));
        } else {
            out.append_char(240 | (code >> 18));
            out.append_char(128 | ((code >> 12) & 63));
            out.append_char(128 | ((code >> 6) & 63));
            out.append_char(128 | (code & 63));
        }
    }

    public static i32 sequence_length(i32 lead) {
        if (lead < 192) {
            return 1;
        }
        if (lead < 224) {
            return 2;
        }
        if (lead < 240) {
            return 3;
        }
        return 4;
    }

    public static i32 utf16_units(i32 lead) {
        if (lead >= 240) {
            return 2;
        }
        return 1;
    }
}
