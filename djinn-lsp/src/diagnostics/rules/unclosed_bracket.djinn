namespace djinnc;

// `unclosed-bracket`: a `(`, `[` or `{` that is never closed.
struct UnclosedBracketRule {
    static unsafe void check(DiagContext* context) {
        PointerList* nodes = context.ast.of_kind(AstKind.UNCLOSED_BRACKET);
        for (mut i32 i = 0; i < nodes.length && !context.expired(); i = i + 1) {
            LintItem* item = context.report((AstNode*)nodes.get(i), "unclosed-bracket", "unclosed bracket", DiagSeverity.ERROR);
            if (item != null) {
                item.note("this bracket is never closed");
                item.help("add the matching closing bracket where the block or the list ends");
            }
        }
    }
}
