namespace djinnc;

// `unmatched-bracket`: a `)`, `]` or `}` with no opener.
struct UnmatchedBracketRule {
    static unsafe void check(DiagContext* context) {
        PointerList* nodes = context.ast.of_kind(AstKind.UNMATCHED_BRACKET);
        for (mut i32 i = 0; i < nodes.length && !context.expired(); i = i + 1) {
            AstNode* node = (AstNode*)nodes.get(i);
            LintItem* item = context.report(node, "unmatched-bracket", "unmatched closing bracket", DiagSeverity.ERROR);
            if (item != null) {
                item.note("this closing bracket has no matching opener");
                item.help("remove it, or add the missing opening bracket before it");
                item.fix("Remove the unmatched bracket", *(context.unit.tstart + (node.first)), *(context.unit.tend + (node.first)), "");
            }
        }
    }
}
