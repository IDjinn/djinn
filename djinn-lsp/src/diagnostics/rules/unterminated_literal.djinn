namespace djinnc;

// `unterminated-literal`: a string or a block comment that runs to the end of the file.
struct UnterminatedLiteralRule {
    static unsafe void check(DiagContext* context) {
        Unit* u = context.unit;
        PointerList* nodes = context.ast.of_kind(AstKind.UNTERMINATED);
        for (mut i32 i = 0; i < nodes.length; i = i + 1) {
            AstNode* node = (AstNode*)nodes.get(i);
            mut ptr<i8> message = "unterminated string literal";
            if (u.tend[node.first] > u.tstart[node.first] + 1 && u.text[u.tstart[node.first]] == 47) {
                message = "unterminated block comment";
            }
            context.report(node, "unterminated-literal", message, DiagSeverity.ERROR);
        }
    }
}
