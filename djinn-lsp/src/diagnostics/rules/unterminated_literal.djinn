namespace djinnc;

// `unterminated-literal`: a string or a block comment that runs to the end of the file.
struct UnterminatedLiteralRule {
    static unsafe void check(DiagContext* context) {
        Unit* u = context.unit;
        PointerList* nodes = context.ast.of_kind(AstKind.UNTERMINATED);
        for (mut i32 i = 0; i < nodes.length; i = i + 1) {
            AstNode* node = (AstNode*)nodes.get(i);
            i32 from = u.tstart[node.first];
            i32 to = u.tend[node.first];
            bool comment = to > from + 1 && u.text[from] == 47;
            mut ptr<i8> message = "unterminated string literal";
            if (comment) {
                message = "unterminated block comment";
            }
            LintItem* item = context.report(node, "unterminated-literal", message, DiagSeverity.ERROR);
            if (item == null) {
                continue;
            }
            if (comment) {
                item.fix("Close the comment", to, to, "*/");
            } else {
                // a string ends at its line: close it before the line break
                mut i32 at = from;
                while (at < to && u.text[at] != 10 && u.text[at] != 13) {
                    at = at + 1;
                }
                item.fix("Close the string", at, at, "\"");
            }
        }
    }
}
