namespace djinnc;

// The rules of the languages bound to macros in `djinn.editor` (html!, css!, ...); each language reports its own ids.
struct EmbeddedLanguageRule {
    static unsafe void check(DiagContext* context) {
        PointerList* found = Embedded.lint(context.unit);
        for (mut i32 i = 0; i < found.length; i = i + 1) {
            context.add((LintItem*)found.get(i));
        }
    }
}
