namespace djinnc;

// textDocument/codeAction: the quick fixes of the findings of the rules (LintItem.fix) and the "did you mean" fixes of the
// compiler's name errors. A rule that offers a fix needs nothing here: the fix travels with its finding.
struct CodeActions {
    // The finding of a rule behind a diagnostic the editor sent back (same id, same start), or null.
    static unsafe LintItem* finding_of(Unit* u, PointerList* items, ptr<i8> code, i32 offset) {
        for (mut i32 i = 0; i < items.length; i = i + 1) {
            LintItem* item = (LintItem*)items.get(i);
            if (Strings.same(item.id, code) && u.tstart[item.token] == offset) {
                return item;
            }
        }
        return (LintItem*)0;
    }

    static unsafe void append_fixes(ByteBuffer* out, i32* count, Unit* u, JsonValue* diagnostics) {
        PointerList* items = Diagnostics.collect(u);
        for (mut i32 i = 0; i < diagnostics.length(); i = i + 1) {
            JsonValue* diag = diagnostics.at(i);
            ptr<i8> code = diag.field_string("code");
            JsonValue* range = diag.get("range");
            if (code == null || range == null || range.get("start") == null) {
                continue;
            }
            JsonValue* start = range.get("start");
            i32 offset = u.offset_of_position((i32)start.field_int("line", 0), (i32)start.field_int("character", 0));
            LintItem* item = CodeActions.finding_of(u, items, code, offset);
            if (item == null || item.fix_title == null) {
                continue;
            }
            if (count[0] > 0) {
                out.append(",");
            }
            count[0] = count[0] + 1;
            out.append("{\"title\":");
            out.append_json_string(item.fix_title);
            out.append(",\"kind\":\"quickfix\",\"isPreferred\":true,\"edit\":{\"changes\":{");
            out.append_json_string(u.uri);
            out.append(":[{\"range\":");
            Lsp.range(out, u, item.fix_from, item.fix_to);
            out.append(",\"newText\":");
            out.append_json_string(item.fix_text);
            out.append("}]}}}");
        }
    }

    public static unsafe ByteBuffer* collect(Unit* u, JsonValue* diagnostics) {
        ByteBuffer* out = ByteBuffer.create();
        out.append("[");
        mut i32 count = 0;
        Suggest.append_actions(out, &count, u, diagnostics);
        CodeActions.append_fixes(out, &count, u, diagnostics);
        out.append("]");
        return out;
    }
}
