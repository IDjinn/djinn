namespace djinnc;

// Every diagnostic rule lives in its own file under src/diagnostics/rules and is a struct with
// `static unsafe void check(DiagContext* context)`.
//
// To add a diagnostic:
//   1. create src/diagnostics/rules/<name>.djinn (copy rules/unclosed_bracket.djinn)
//   2. add its `check` call to `Diagnostics.run` below
// Nothing else changes: the publisher, the server and the `lint-disable` handling see only the findings.
struct Diagnostics {
    static unsafe void run(DiagContext* context) {
        UnterminatedLiteralRule.check(context);
        UnclosedBracketRule.check(context);
        UnmatchedBracketRule.check(context);
        EmbeddedLanguageRule.check(context);
    }

    // The findings of every rule for the file, as of its current text (the workspace configuration is read now).
    public static unsafe PointerList* collect(Unit* u) {
        DiagContext context = { .unit = u, .ast = u.ast, .items = PointerList.create() };
        if (u.ast != null) {
            Diagnostics.run(&context);
        }
        return context.items;
    }
}
