namespace djinnc;

// A finding of a rule, in tokens (raw indices, `first` and `last` included).
struct LintItem {
    i32 token;
    i32 end_token;
    ptr<i8> message;
    ptr<i8> id;
    i32 severity;
    // optional quick fix: replace the bytes [fix_from, fix_to) with fix_text (an insertion has from == to)
    ptr<i8> fix_title;
    ptr<i8> fix_text;
    i32 fix_from;
    i32 fix_to;

    // Rust-style details: what the problem is (note) and how to solve it (help), shown under the message
    ptr<i8> note_text;
    ptr<i8> help_text;

    public unsafe void note(ptr<i8> text) {
        this.note_text = text;
    }

    public unsafe void help(ptr<i8> text) {
        this.help_text = text;
    }

    // optional range in bytes, when the finding should cover more than its tokens (span_to > span_from)
    i32 span_from;
    i32 span_to;

    public unsafe void span(i32 from, i32 to) {
        this.span_from = from;
        this.span_to = to;
    }

    // Offers a quick fix with the finding. A finding without one is only reported.
    public unsafe void fix(ptr<i8> title, i32 from, i32 to, ptr<i8> text) {
        this.fix_title = title;
        this.fix_from = from;
        this.fix_to = to;
        this.fix_text = text;
    }
}

struct DiagSeverity {
    const i32 ERROR = 1;
    const i32 WARNING = 2;
    const i32 INFORMATION = 3;
    const i32 HINT = 4;
}

struct Findings {
    // Columns (characters, not bytes) between two offsets of a line.
    static unsafe i32 columns(Unit* u, i32 from, i32 to) {
        mut i32 count = 0;
        for (mut i32 i = from; i < to; i = i + 1) {
            if (((i32)(u8)u.text[i] & 192) != 128) {
                count = count + 1;
            }
        }
        return count;
    }

    // Spaces (tabs stay tabs) that bring a caret under the column of `offset`.
    static unsafe void indent(ByteBuffer* out, Unit* u, i32 line_start, i32 offset) {
        for (mut i32 i = line_start; i < offset; i = i + 1) {
            i32 b = (i32)(u8)u.text[i];
            if ((b & 192) == 128) {
                continue;
            }
            if (b == 9) {
                out.append_char((char)(9));
            } else {
                out.append_char((char)(32));
            }
        }
    }

    // `,"code":"X","codeDescription":{...}`: the editor shows the code as a link to the page that explains it.
    public static unsafe void append_code(ByteBuffer* out, ptr<i8> code) {
        if (code == null || strlen(code) == 0) {
            return;
        }
        out.append(",\"code\":");
        out.append_json_string(code);
        ByteBuffer* link = ByteBuffer.create();
        link.append("https://docs.link/errors/");
        link.append(code);
        out.append(",\"codeDescription\":{\"href\":");
        out.append_json_string(link.cstr());
        out.append("}");
    }

    // The diagnostic the way rustc prints it: the message, the line with `^~~~` under the problem, the note and the
    // help, then the line as it would be after the quick fix with a `^` under what was added. There is no gutter and
    // no line number, so the carets stay under the source whatever the font.
    //
    //   Unterminated string literal
    //       auto s = "open;
    //                ^~~~~~
    //   note: a string that is not closed keeps reading to the end of the file
    //   help: add a closing '"' where the string ends
    //
    //       auto s = "open";
    //                     ^ suggestion: add the quote after `open`
    //   docs: docs.link/errors/E1002
    public static unsafe ptr<i8> describe(Unit* u, ptr<i8> message, LintItem* item, i32 from, i32 to, ptr<i8> code) {
        ByteBuffer* out = ByteBuffer.create();
        if (message != null && strlen(message) > 0) {
            mut i32 first = (i32)(u8)message[0];
            if (first >= 97 && first <= 122) {
                first = first - 32;
            }
            out.append_char((char)(first));
            out.append(message + 1);
        }
        i32 line = u.line_of(from);
        i32 line_start = u.line_starts[line];
        mut i32 line_end = u.line_starts[line + 1] - 1;
        if (line_end > u.length) {
            line_end = u.length;
        }
        if (line_end > line_start && u.text[line_end - 1] == 13) {
            line_end = line_end - 1;
        }
        if (from >= line_start && from <= line_end) {
            out.append("\n");
            out.append_slice(u.text + line_start, line_end - line_start);
            out.append("\n");
            Findings.indent(out, u, line_start, from);
            mut i32 stop = to;
            if (stop > line_end) {
                stop = line_end;
            }
            mut i32 span = Findings.columns(u, from, stop);
            if (span < 1) {
                span = 1;
            }
            out.append_char((char)(94));
            for (mut i32 i = 1; i < span; i = i + 1) {
                out.append_char((char)(126));
            }
            if (item != null && item.note_text != null) {
                out.append("\nnote: ");
                out.append(item.note_text);
            }
            if (item != null && item.help_text != null) {
                out.append("\nhelp: ");
                out.append(item.help_text);
            }
            if (item != null && item.fix_title != null && item.fix_from >= line_start && item.fix_to <= line_end && item.fix_from <= item.fix_to) {
                out.append("\n\n");
                out.append_slice(u.text + line_start, item.fix_from - line_start);
                out.append(item.fix_text);
                out.append_slice(u.text + item.fix_to, line_end - item.fix_to);
                out.append("\n");
                Findings.indent(out, u, line_start, item.fix_from);
                mut i32 added = (i32)strlen(item.fix_text);
                if (added < 1) {
                    added = 1;
                }
                for (mut i32 i = 0; i < added; i = i + 1) {
                    out.append_char((char)(94));
                }
                out.append(" suggestion: ");
                mut i32 letter = (i32)(u8)item.fix_title[0];
                if (letter >= 65 && letter <= 90) {
                    letter = letter + 32;
                }
                out.append_char((char)(letter));
                out.append(item.fix_title + 1);
                // where it goes: after the word before the insertion
                if (item.fix_from == item.fix_to) {
                    mut i32 word = item.fix_from;
                    while (word > line_start && u.text[word - 1] != 32 && u.text[word - 1] != 9 && item.fix_from - word < 16) {
                        word = word - 1;
                    }
                    if (word < item.fix_from) {
                        out.append(" after `");
                        out.append_slice(u.text + word, item.fix_from - word);
                        out.append("`");
                    }
                }
            }
        }
        if (code != null && strlen(code) > 0) {
            out.append("\ndocs: docs.link/errors/");
            out.append(code);
        }
        return out.cstr();
    }

    public static unsafe i32 start_of(Unit* u, LintItem* item) {
        if (item.span_to > item.span_from) {
            return item.span_from;
        }
        return u.tstart[item.token];
    }

    // The finding of a rule that starts at `offset`, preferring the one with this id (the editor sends back the
    // diagnostic it got, which may be the compiler's own report of the same problem).
    public static unsafe LintItem* at(Unit* u, PointerList* items, i32 offset, ptr<i8> code) {
        mut LintItem* any = (LintItem*)0;
        for (mut i32 i = 0; i < items.length; i = i + 1) {
            LintItem* item = (LintItem*)items.get(i);
            if (Findings.start_of(u, item) != offset) {
                continue;
            }
            if (code != null && Strings.same(item.id, code)) {
                return item;
            }
            if (any == null) {
                any = item;
            }
        }
        return any;
    }
}

// What a rule receives: the file, its syntax tree, and the way to report. A rule never talks to the protocol and
// never checks `djinn.editor` (`lint-disable: <id>`) itself: `report` drops what the user turned off.
struct DiagContext {
    Unit* unit;
    Ast* ast;
    PointerList* items;
    // when the rules must stop (microseconds); a rule with a loop over the file should poll `expired()`
    i64 deadline;

    public unsafe bool expired() {
        return __djinn_now_us() > this.deadline;
    }

    public unsafe LintItem* report_tokens(i32 first, i32 last, ptr<i8> id, ptr<i8> message, i32 severity) {
        if (first < 0 || last < first || last >= this.unit.token_count) {
            return (LintItem*)0;
        }
        if (!EditorConfig.get().lint_enabled(id)) {
            return (LintItem*)0;
        }
        LintItem* item = (LintItem*)Memory.zalloc(sizeof(LintItem));
        item.token = first;
        item.end_token = last;
        item.message = message;
        item.id = id;
        item.severity = severity;
        this.items.push((ptr)item);
        return item;
    }

    // Reports the whole node. Returns the finding (null when the user turned the rule off) to attach a fix to.
    public unsafe LintItem* report(AstNode* node, ptr<i8> id, ptr<i8> message, i32 severity) {
        return this.report_tokens(node.first, node.last, id, message, severity);
    }

    // Reports the name of a declaration (the whole node when it has none).
    public unsafe LintItem* report_name(AstNode* node, ptr<i8> id, ptr<i8> message, i32 severity) {
        if (node.name_tok >= 0) {
            return this.report_tokens(node.name_tok, node.name_tok, id, message, severity);
        }
        return this.report(node, id, message, severity);
    }

    public unsafe void add(LintItem* item) {
        this.items.push((ptr)item);
    }
}
