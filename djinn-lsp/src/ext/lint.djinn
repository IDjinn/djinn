namespace djinnc;

// Every rule has an id (`lint-disable: unclosed-bracket` in a `djinn.editor` turns it off). The lexical rules run when
// a file is analysed; rules that depend on the workspace configuration (embedded languages) run when diagnostics are published.
struct Lint {
    public static unsafe PointerList* collect(Unit* u) {
        EditorConfig* config = EditorConfig.get();
        PointerList* items = PointerList.create();
        for (mut i32 i = 0; i < u.lint.length; i = i + 1) {
            LintItem* item = (LintItem*)u.lint.get(i);
            if (config.lint_enabled(item.id)) {
                items.push((ptr)item);
            }
        }
        PointerList* embedded = Embedded.lint(u);
        for (mut i32 i = 0; i < embedded.length; i = i + 1) {
            items.push(embedded.get(i));
        }
        return items;
    }
}
