namespace djinnc;

struct Tk {
    const i32 IDENT = 1;
    const i32 KEYWORD = 2;
    const i32 TYPE = 3;
    const i32 NUMBER = 4;
    const i32 STRING = 5;
    const i32 COMMENT = 6;
    const i32 DOC = 7;
    const i32 PUNCT = 8;
    const i32 ERROR = 9;
}

unsafe static mut ptr keyword_table = null;
unsafe static mut ptr type_table = null;

struct Words {
    public static unsafe void init() {
        if (keyword_table != null) {
            return;
        }
        ptr<i8> keywords = "void return auto extern struct union namespace import mut if else for while do switch case default break continue interface public private static this enum new impl where async await yield spawn in true false operator const constexpr consteval macro is null throw throws try require ensure unsafe catch finally defer override";
        ptr<i8> types = "bool size size_long str string ptr arr optional result task object usize isize c_result";
        keyword_table = (ptr)Words.split(keywords);
        type_table = (ptr)Words.split(types);
    }

    static unsafe PointerList* split(ptr<i8> list) {
        PointerList* words = PointerList.create();
        i32 length = strlen(list);
        mut i32 start = 0;
        for (mut i32 i = 0; i <= length; i = i + 1) {
            if (i == length || list[i] == 32) {
                if (i > start) {
                    words.push((ptr)Strings.duplicate(list + start, i - start));
                }
                start = i + 1;
            }
        }
        return words;
    }

    static unsafe bool listed(ptr slot, ptr<i8> text, i32 start, i32 length) {
        PointerList* words = (PointerList*)slot;
        for (mut i32 i = 0; i < words.length; i = i + 1) {
            ptr<i8> word = (ptr<i8>)words.get(i);
            if (Strings.equals(text + start, length, word)) {
                return true;
            }
        }
        return false;
    }

    public static unsafe bool is_keyword(ptr<i8> text, i32 start, i32 length) {
        return Words.listed(keyword_table, text, start, length);
    }

    public static unsafe bool is_builtin_type(ptr<i8> text, i32 start, i32 length) {
        i32 first = (i32)text[start];
        if ((first == 105 || first == 117 || first == 102) && length >= 2) {
            mut i32 digits = 0;
            mut i32 i = start + 1;
            while (i < start + length && Strings.is_digit((i32)text[i])) {
                digits = digits + 1;
                i = i + 1;
            }
            if (digits > 0 && (i == start + length || (i == start + length - 1 && text[i] == 119))) {
                return true;
            }
        }
        return Words.listed(type_table, text, start, length);
    }
}

struct Lexer {
    ptr<i8> text;
    i32 length;
    i32 count;
    i32 capacity;
    ptr<i32> kinds;
    ptr<i32> starts;
    ptr<i32> ends;

    public static unsafe void run(Unit* unit) {
        Words.init();
        Lexer* lexer = (Lexer*)Memory.zalloc(sizeof(Lexer));
        lexer.text = unit.text;
        lexer.length = unit.length;
        lexer.capacity = unit.length / 3 + 16;
        lexer.kinds = (ptr<i32>)Memory.zalloc((u64)lexer.capacity * 4);
        lexer.starts = (ptr<i32>)Memory.zalloc((u64)lexer.capacity * 4);
        lexer.ends = (ptr<i32>)Memory.zalloc((u64)lexer.capacity * 4);
        lexer.scan();
        unit.token_count = lexer.count;
        unit.tkind = lexer.kinds;
        unit.tstart = lexer.starts;
        unit.tend = lexer.ends;
    }

    unsafe void push(i32 kind, i32 start, i32 end) {
        if (this.count == this.capacity) {
            i32 grown = this.capacity * 2;
            ptr<i32> kinds = (ptr<i32>)Memory.zalloc((u64)grown * 4);
            ptr<i32> starts = (ptr<i32>)Memory.zalloc((u64)grown * 4);
            ptr<i32> ends = (ptr<i32>)Memory.zalloc((u64)grown * 4);
            memcpy((ptr)kinds, (ptr)this.kinds, (u64)this.count * 4);
            memcpy((ptr)starts, (ptr)this.starts, (u64)this.count * 4);
            memcpy((ptr)ends, (ptr)this.ends, (u64)this.count * 4);
            this.kinds = kinds;
            this.starts = starts;
            this.ends = ends;
            this.capacity = grown;
        }
        this.kinds[this.count] = kind;
        this.starts[this.count] = start;
        this.ends[this.count] = end;
        this.count = this.count + 1;
    }

    unsafe i32 at(i32 position) {
        if (position >= this.length) {
            return 0;
        }
        return (i32)(u8)this.text[position];
    }

    unsafe void scan() {
        mut i32 pos = 0;
        if (this.length >= 3 && this.at(0) == 239 && this.at(1) == 187 && this.at(2) == 191) {
            pos = 3;
        }
        while (pos < this.length) {
            i32 c = this.at(pos);
            if (c == 32 || c == 9 || c == 10 || c == 13) {
                pos = pos + 1;
                continue;
            }
            i32 start = pos;
            if (c == 47 && this.at(pos + 1) == 47) {
                while (pos < this.length && this.at(pos) != 10) {
                    pos = pos + 1;
                }
                mut i32 kind = Tk.COMMENT;
                if (this.at(start + 2) == 47 && this.at(start + 3) != 47) {
                    kind = Tk.DOC;
                }
                this.push(kind, start, pos);
            } else if (c == 47 && this.at(pos + 1) == 42) {
                pos = this.block_comment_end(pos + 2);
                if (pos < 0) {
                    this.push(Tk.ERROR, start, this.length);
                    pos = this.length;
                } else {
                    mut i32 kind = Tk.COMMENT;
                    if (this.at(start + 2) == 42 && this.at(start + 3) != 47) {
                        kind = Tk.DOC;
                    }
                    this.push(kind, start, pos);
                }
            } else if (Strings.is_ident_start(c) || c >= 128) {
                while (pos < this.length && (Strings.is_ident_part(this.at(pos)) || this.at(pos) >= 128)) {
                    pos = pos + 1;
                }
                mut i32 kind = Tk.IDENT;
                if (Words.is_keyword(this.text, start, pos - start)) {
                    kind = Tk.KEYWORD;
                } else if (Words.is_builtin_type(this.text, start, pos - start)) {
                    kind = Tk.TYPE;
                }
                this.push(kind, start, pos);
            } else if (Strings.is_digit(c)) {
                pos = this.number_end(pos);
                this.push(Tk.NUMBER, start, pos);
            } else if (c == 34) {
                pos = this.string_end(pos, false);
            } else if (c == 36 && this.at(pos + 1) == 34) {
                pos = this.string_end(pos + 1, true);
            } else if (c == 39) {
                i32 close = this.char_end(pos);
                if (close > 0) {
                    pos = close;
                    this.push(Tk.STRING, start, pos);
                } else {
                    pos = pos + 1;
                    this.push(Tk.PUNCT, start, pos);
                }
            } else {
                pos = pos + this.punct_width(pos);
                this.push(Tk.PUNCT, start, pos);
            }
            if (pos <= start) {
                pos = start + 1;
            }
        }
    }

    unsafe i32 block_comment_end(i32 from) {
        mut i32 pos = from;
        while (pos + 1 < this.length) {
            if (this.at(pos) == 42 && this.at(pos + 1) == 47) {
                return pos + 2;
            }
            pos = pos + 1;
        }
        return 0 - 1;
    }

    unsafe i32 number_end(i32 from) {
        mut i32 pos = from;
        bool hex = this.at(from) == 48 && (this.at(from + 1) == 120 || this.at(from + 1) == 88);
        while (pos < this.length) {
            i32 c = this.at(pos);
            if (Strings.is_ident_part(c) || c == 39) {
                if (!hex && (c == 101 || c == 69) && (this.at(pos + 1) == 43 || this.at(pos + 1) == 45) && Strings.is_digit(this.at(pos + 2))) {
                    pos = pos + 2;
                } else {
                    pos = pos + 1;
                }
            } else if (c == 46 && Strings.is_digit(this.at(pos + 1)) && !hex) {
                pos = pos + 1;
            } else {
                break;
            }
        }
        return pos;
    }

    unsafe i32 string_end(i32 quote, bool interpolated) {
        mut i32 token_start = quote;
        if (interpolated) {
            token_start = quote - 1;
        }
        if (this.at(quote + 1) == 34 && this.at(quote + 2) == 34) {
            mut i32 pos = quote + 3;
            while (pos + 2 < this.length + 0) {
                if (this.at(pos) == 34 && this.at(pos + 1) == 34 && this.at(pos + 2) == 34) {
                    this.push(Tk.STRING, token_start, pos + 3);
                    return pos + 3;
                }
                pos = pos + 1;
            }
            this.push(Tk.ERROR, token_start, this.length);
            return this.length;
        }
        mut i32 pos = quote + 1;
        mut i32 depth = 0;
        while (pos < this.length) {
            i32 c = this.at(pos);
            if (c == 92) {
                pos = pos + 2;
                continue;
            }
            if (interpolated && c == 123) {
                depth = depth + 1;
            } else if (interpolated && c == 125 && depth > 0) {
                depth = depth - 1;
            } else if (c == 34 && depth > 0) {
                pos = pos + 1;
                while (pos < this.length && this.at(pos) != 34) {
                    pos = pos + 1;
                }
            } else if (c == 34) {
                this.push(Tk.STRING, token_start, pos + 1);
                return pos + 1;
            }
            pos = pos + 1;
        }
        this.push(Tk.ERROR, token_start, this.length);
        return this.length;
    }

    unsafe i32 char_end(i32 from) {
        if (this.at(from + 1) == 92) {
            for (mut i32 i = from + 3; i < from + 10 && i < this.length; i = i + 1) {
                if (this.at(i) == 39) {
                    return i + 1;
                }
                if (this.at(i) == 10) {
                    return 0 - 1;
                }
            }
            return 0 - 1;
        }
        i32 lead = this.at(from + 1);
        if (lead == 0 || lead == 10 || lead == 39) {
            return 0 - 1;
        }
        i32 width = Utf8.sequence_length(lead);
        if (this.at(from + 1 + width) == 39) {
            return from + width + 2;
        }
        return 0 - 1;
    }

    unsafe i32 punct_width(i32 pos) {
        i32 c = this.at(pos);
        i32 n = this.at(pos + 1);
        if (c == 58 && n == 58) {
            return 2;
        }
        if (c == 45 && n == 62) {
            return 2;
        }
        if (c == 61 && (n == 62 || n == 61)) {
            return 2;
        }
        if ((c == 33 || c == 60 || c == 62) && n == 61) {
            return 2;
        }
        if (c == 38 && n == 38) {
            return 2;
        }
        if (c == 124 && n == 124) {
            return 2;
        }
        if ((c == 63 || c == 33) && n == 46) {
            return 2;
        }
        if (c == 63 && n == 63) {
            return 2;
        }
        if (c == 46 && n == 46) {
            if (this.at(pos + 2) == 46 || this.at(pos + 2) == 61) {
                return 3;
            }
            return 2;
        }
        return 1;
    }
}
