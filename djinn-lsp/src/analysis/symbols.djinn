namespace djinnc;

struct SK {
    const i32 NAMESPACE = 3;
    const i32 CLASS = 5;
    const i32 METHOD = 6;
    const i32 PROPERTY = 7;
    const i32 FIELD = 8;
    const i32 CONSTRUCTOR = 9;
    const i32 ENUM = 10;
    const i32 INTERFACE = 11;
    const i32 FUNCTION = 12;
    const i32 VARIABLE = 13;
    const i32 CONSTANT = 14;
    const i32 ENUM_MEMBER = 22;
    const i32 STRUCT = 23;
    const i32 OPERATOR = 25;
    const i32 IMPORT = 1000;
    const i32 IMPL = 1001;
}

struct SF {
    const i32 PARAM = 1;
    const i32 LOCAL = 2;
    const i32 STATIC = 4;
    const i32 EXTERN = 8;
    const i32 MACRO = 16;
    const i32 CONST = 32;
}

struct Sym {
    i32 kind;
    i32 flags;
    ptr<i8> name;
    i32 name_tok;
    i32 name_end_tok;
    i32 first_tok;
    i32 last_tok;
    i32 body_open;
    i32 body_close;
    i32 scope_end;
    Sym* parent;
    Unit* unit;
    ptr<i8> type_name;
    ptr<i8> detail;

    public bool is_type() {
        return this.kind == SK.STRUCT || this.kind == SK.ENUM || this.kind == SK.INTERFACE || this.kind == SK.CLASS;
    }

    public bool is_container() {
        return this.is_type() || this.kind == SK.IMPL;
    }

    public bool is_callable() {
        return this.kind == SK.FUNCTION || this.kind == SK.METHOD || this.kind == SK.CONSTRUCTOR || this.kind == SK.OPERATOR;
    }

    public bool is_local() {
        return (this.flags & (SF.LOCAL | SF.PARAM)) != 0;
    }

    public bool is_global() {
        return this.parent == null && !this.is_local() && this.kind != SK.IMPORT && this.kind != SK.IMPL;
    }

    public bool is_member() {
        return this.parent != null && this.parent.is_container() && !this.is_local();
    }
}
