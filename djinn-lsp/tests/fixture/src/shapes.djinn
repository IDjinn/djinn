namespace fixture;

// A point in the plane.
struct Point {
    i32 x;
    i32 y;

    // Sum of both coordinates.
    public i32 sum() {
        return this.x + this.y;
    }

    public static Point make(i32 x, i32 y) {
        mut Point p;
        p.x = x;
        p.y = y;
        return p;
    }
}

i32 add(i32 left, i32 right) {
    return left + right;
}
