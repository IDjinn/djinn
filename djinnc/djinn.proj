project: "djinnc"
version: "0.1.0"

compiler:
  library-mode: false
  no-cache: true

  output:
    file: "djinnc"
    directory: "djinnc/build"

  generator:
    optimization-level: 2

  libs: []

  test-libs: ['std', 'testing']

  entry: "main.djinn"

  native-libs: [
    '-LC:/dev/llvm-21.1.1/llvm-21.1.1-windows-amd64-msvc17-msvcrt/lib',
    '-lLLVM-C'
  ]
