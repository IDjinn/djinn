namespace djinnc;

impl CodeGenerator {
    Value* gen_text_value(Node* node, void* text, u32 type) {
        return this.gen_constant_text(node.text(), text, type);
    }

    Value* gen_constant_text(i8* content, void* text, u32 type) {
        StructInfo* info = this.struct_of(type);
        PointerList* fields = info.fields;
        FieldInfo* length_field = (FieldInfo*)fields.get(1);
        void* llvm = this.llvm_type(type);
        void* slot = this.create_slot(type, "text");
        void* data_address = LLVMBuildStructGEP2(this.builder, llvm, slot, 0, "text.data");
        LLVMBuildStore(this.builder, text, data_address);
        void* length_address = LLVMBuildStructGEP2(this.builder, llvm, slot, 1, "text.length");
        Value* length = Value.create(LLVMConstInt(LLVMIntTypeInContext(this.context, 64), (u64)strlen(content), 0), Types.i64_type());
        LLVMBuildStore(this.builder, this.coerce(length, length_field.type), length_address);
        if (fields.length > 2) {
            void* capacity_address = LLVMBuildStructGEP2(this.builder, llvm, slot, 2, "text.capacity");
            LLVMBuildStore(this.builder, this.coerce(length, length_field.type), capacity_address);
        }
        return Value.create(LLVMBuildLoad2(this.builder, llvm, slot, "text.loaded"), type);
    }

    void* call_runtime(i8* name, void* return_type, void** parameters, void** arguments, i32 count) {
        void* function_type = LLVMFunctionType(return_type, parameters, (u32)count, 0);
        mut void* function = LLVMGetNamedFunction(this.module, name);
        if (function == null) {
            function = LLVMAddFunction(this.module, name, function_type);
        }
        return LLVMBuildCall2(this.builder, function_type, function, arguments, (u32)count, "");
    }

    void append_text(void* handle, i8* name, void* argument_type, void* argument) {
        void* pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
        void** parameters = CodeGenerator.array_of(2);
        void** arguments = CodeGenerator.array_of(2);
        parameters[0] = pointer_llvm;
        parameters[1] = argument_type;
        arguments[0] = handle;
        arguments[1] = argument;
        this.call_runtime(name, LLVMVoidTypeInContext(this.context), parameters, arguments, 2);
    }

    void append_value(void* handle, i8* name, void* argument_type, void* argument, u64 format) {
        if (format == 0) {
            this.append_text(handle, name, argument_type, argument);
            return;
        }
        void* pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
        void* i64_type = LLVMIntTypeInContext(this.context, 64);
        ByteBuffer* formatted = ByteBuffer.create();
        formatted.append(name);
        formatted.append("_format");
        void** parameters = CodeGenerator.array_of(3);
        void** arguments = CodeGenerator.array_of(3);
        parameters[0] = pointer_llvm;
        parameters[1] = argument_type;
        parameters[2] = i64_type;
        arguments[0] = handle;
        arguments[1] = argument;
        arguments[2] = LLVMConstInt(i64_type, format, 0);
        this.call_runtime(formatted.cstr(), LLVMVoidTypeInContext(this.context), parameters, arguments, 3);
    }

    void append_slice_format(void* handle, void* data, void* length, void* format) {
        void* pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
        void* i32_type = LLVMIntTypeInContext(this.context, 32);
        void* i64_type = LLVMIntTypeInContext(this.context, 64);
        void** parameters = CodeGenerator.array_of(4);
        void** arguments = CodeGenerator.array_of(4);
        parameters[0] = pointer_llvm;
        parameters[1] = pointer_llvm;
        parameters[2] = i32_type;
        parameters[3] = i64_type;
        arguments[0] = handle;
        arguments[1] = data;
        arguments[2] = length;
        arguments[3] = format;
        this.call_runtime("__djinn_text_slice_format", LLVMVoidTypeInContext(this.context), parameters, arguments, 4);
    }

    void append_slice(void* handle, void* data, void* length) {
        void* pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
        void* i32_type = LLVMIntTypeInContext(this.context, 32);
        void** parameters = CodeGenerator.array_of(3);
        void** arguments = CodeGenerator.array_of(3);
        parameters[0] = pointer_llvm;
        parameters[1] = pointer_llvm;
        parameters[2] = i32_type;
        arguments[0] = handle;
        arguments[1] = data;
        arguments[2] = length;
        this.call_runtime("__djinn_text_slice", LLVMVoidTypeInContext(this.context), parameters, arguments, 3);
    }

    bool fold_interpolation(Node* node, ByteBuffer* out, i32 depth) {
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* part = node.child(i);
            if (i % 2 == 0) {
                i64 text_length = part.int_value() & 4294967295;
                if (text_length > 0) {
                    out.append(part.text());
                }
                continue;
            }
            Node* before = node.child(i - 1);
            if ((before.int_value() >> 32) != 0) {
                return false;
            }
            if (!this.fold_constant(part, out, depth)) {
                return false;
            }
        }
        return true;
    }

    bool fold_constant(Node* part, ByteBuffer* out, i32 depth) {
        if (depth > 8) {
            return false;
        }
        i32 kind = part.kind;
        if (kind == NodeKind.STRING_LITERAL) {
            out.append(part.text());
            return true;
        }
        if (kind == NodeKind.INT_LITERAL) {
            u32 type = part.value_type();
            if (Types.is_float(type) || (!Types.is_signed(type) && part.int_value() < 0)) {
                return false;
            }
            out.append_int(part.int_value());
            return true;
        }
        if (kind == NodeKind.BOOL_LITERAL) {
            if (part.int_value() != 0) {
                out.append("true");
            } else {
                out.append("false");
            }
            return true;
        }
        if (kind == NodeKind.INTERPOLATION) {
            return this.fold_interpolation(part, out, depth + 1);
        }
        if (kind == NodeKind.IDENTIFIER && part.symbol_kind() == SymbolKind.LOCAL) {
            LocalVariable* variable = (LocalVariable*)part.symbol();
            Node* declaration = variable.node;
            if (variable.is_mutable || declaration == null || declaration.kind != NodeKind.VAR_DECL) {
                return false;
            }
            Node* initial = declaration.first();
            if (initial == null) {
                return false;
            }
            return this.fold_constant(initial, out, depth + 1);
        }
        return false;
    }

    Value* gen_interpolation(Node* node) {
        u32 type = node.value_type();
        ByteBuffer* folded = ByteBuffer.create();
        if (this.fold_interpolation(node, folded, 0)) {
            void* constant = LLVMBuildGlobalStringPtr(this.builder, folded.cstr(), "interp.const");
            return this.gen_constant_text(folded.cstr(), constant, type);
        }
        void* pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
        void* i32_type = LLVMIntTypeInContext(this.context, 32);
        void* i64_type = LLVMIntTypeInContext(this.context, 64);
        void* f64_type = LLVMDoubleTypeInContext(this.context);
        u32 owned = this.symbols_core_type("string");
        u32 view = this.symbols_core_type("str");

        void* handle = this.call_runtime("__djinn_text_begin", pointer_llvm, null, null, 0);
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* part = node.child(i);
            if (i % 2 == 0) {
                i64 text_length = part.int_value() & 4294967295;
                if (text_length > 0) {
                    void* literal = LLVMBuildGlobalStringPtr(this.builder, part.text(), "interp.text");
                    this.append_slice(handle, literal, LLVMConstInt(i32_type, (u64)text_length, 0));
                }
                continue;
            }
            Value* value = this.gen_expression(part);
            u32 value_type = value.type;
            Node* before = node.child(i - 1);
            u64 format = (u64)(before.int_value() >> 32);
            void* format_value = LLVMConstInt(i64_type, format, 0);
            if (value_type == owned || value_type == view) {
                void* data = LLVMBuildExtractValue(this.builder, value.ref, 0, "interp.data");
                void* length = LLVMBuildExtractValue(this.builder, value.ref, 1, "interp.length");
                if (format != 0) {
                    this.append_slice_format(handle, data, length, format_value);
                } else {
                    this.append_slice(handle, data, length);
                }
            } else if (Types.is_pointer(value_type)) {
                this.append_value(handle, "__djinn_text_cstr", pointer_llvm, value.ref, format);
            } else if (Types.is_float(value_type)) {
                this.append_value(handle, "__djinn_text_f64", f64_type, this.coerce(value, Types.floating(64)), format);
            } else if (Types.is_integer(value_type) && Types.bits(value_type) == 1) {
                this.append_value(handle, "__djinn_text_bool", i32_type, this.coerce(value, Types.i32_type()), format);
            } else if (Types.is_signed(value_type)) {
                this.append_value(handle, "__djinn_text_i64", i64_type, this.coerce(value, Types.i64_type()), format);
            } else {
                this.append_value(handle, "__djinn_text_u64", i64_type, this.coerce(value, Types.integer(64, false)), format);
            }
        }

        void* length_slot = this.create_slot(Types.integer(32, false), "interp.size");
        void** parameters = CodeGenerator.array_of(2);
        void** arguments = CodeGenerator.array_of(2);
        parameters[0] = pointer_llvm;
        parameters[1] = pointer_llvm;
        arguments[0] = handle;
        arguments[1] = length_slot;
        void* data = this.call_runtime("__djinn_text_finish", pointer_llvm, parameters, arguments, 2);
        void* length = LLVMBuildLoad2(this.builder, i32_type, length_slot, "interp.length");

        void* llvm = this.llvm_type(type);
        void* slot = this.create_slot(type, "interp");
        LLVMBuildStore(this.builder, LLVMConstNull(llvm), slot);
        LLVMBuildStore(this.builder, data, LLVMBuildStructGEP2(this.builder, llvm, slot, 0, "interp.data.ptr"));
        LLVMBuildStore(this.builder, length, LLVMBuildStructGEP2(this.builder, llvm, slot, 1, "interp.length.ptr"));
        LLVMBuildStore(this.builder, length, LLVMBuildStructGEP2(this.builder, llvm, slot, 2, "interp.capacity.ptr"));
        return Value.create(LLVMBuildLoad2(this.builder, llvm, slot, "interp.loaded"), type);
    }
}
