namespace djinnc;

impl CodeGenerator {
    Value* gen_text_value(Node* node, ptr text, u32 type) {
        return this.gen_constant_text(node.text(), text, type);
    }

    unsafe Value* gen_constant_text(ptr<i8> content, ptr text, u32 type) {
        StructInfo* info = this.struct_of(type);
        PointerList* fields = info.fields;
        FieldInfo* length_field = (FieldInfo*)fields.get(1);
        ptr llvm = this.llvm_type(type);
        ptr slot = this.create_slot(type, "text");
        ptr data_address = LLVMBuildStructGEP2(this.builder, llvm, slot, 0, "text.data");
        mut ptr data = text;
        if (fields.length > 2) {
            ptr pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
            ptr i32_type = LLVMIntTypeInContext(this.context, 32);
            ptr<ptr> copy_parameters = CodeGenerator.array_of(2);
            ptr<ptr> copy_arguments = CodeGenerator.array_of(2);
            copy_parameters[0] = pointer_llvm;
            copy_parameters[1] = i32_type;
            copy_arguments[0] = text;
            copy_arguments[1] = LLVMConstInt(i32_type, (u64)strlen(content), 0);
            data = this.call_runtime("__djinn_text_duplicate", pointer_llvm, copy_parameters, copy_arguments, 2);
        }
        LLVMBuildStore(this.builder, data, data_address);
        ptr length_address = LLVMBuildStructGEP2(this.builder, llvm, slot, 1, "text.length");
        Value* length = Value.create(LLVMConstInt(LLVMIntTypeInContext(this.context, 64), (u64)strlen(content), 0), Types.i64_type());
        LLVMBuildStore(this.builder, this.coerce(length, length_field.type), length_address);
        if (fields.length > 2) {
            ptr capacity_address = LLVMBuildStructGEP2(this.builder, llvm, slot, 2, "text.capacity");
            LLVMBuildStore(this.builder, this.coerce(length, length_field.type), capacity_address);
        }
        return Value.create(LLVMBuildLoad2(this.builder, llvm, slot, "text.loaded"), type);
    }

    unsafe ptr static_text(ptr<i8> content, u32 type) {
        ptr llvm = this.llvm_type(type);
        StructInfo* info = this.struct_of(type);
        PointerList* fields = info.fields;
        FieldInfo* length_field = (FieldInfo*)fields.get(1);
        ptr<ptr> values = CodeGenerator.array_of(2);
        values[0] = this.string_constant(content);
        values[1] = LLVMConstInt(this.llvm_type(length_field.type), (u64)strlen(content), 0);
        return LLVMConstNamedStruct(llvm, values, 2);
    }

    ptr call_runtime(ptr<i8> name, ptr return_type, ptr<ptr> parameters, ptr<ptr> arguments, i32 count) {
        ptr function_type = LLVMFunctionType(return_type, parameters, (u32)count, 0);
        mut ptr function = LLVMGetNamedFunction(this.module, name);
        if (function == null) {
            function = LLVMAddFunction(this.module, name, function_type);
        }
        return LLVMBuildCall2(this.builder, function_type, function, arguments, (u32)count, "");
    }

    unsafe void append_text(ptr handle, ptr<i8> name, ptr argument_type, ptr argument) {
        ptr pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
        ptr<ptr> parameters = CodeGenerator.array_of(2);
        ptr<ptr> arguments = CodeGenerator.array_of(2);
        parameters[0] = pointer_llvm;
        parameters[1] = argument_type;
        arguments[0] = handle;
        arguments[1] = argument;
        this.call_runtime(name, LLVMVoidTypeInContext(this.context), parameters, arguments, 2);
    }

    unsafe void append_value(ptr handle, ptr<i8> name, ptr argument_type, ptr argument, u64 format) {
        if (format == 0) {
            this.append_text(handle, name, argument_type, argument);
            return;
        }
        ptr pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
        ptr i64_type = LLVMIntTypeInContext(this.context, 64);
        ByteBuffer* formatted = ByteBuffer.create();
        formatted.append(name);
        formatted.append("_format");
        ptr<ptr> parameters = CodeGenerator.array_of(3);
        ptr<ptr> arguments = CodeGenerator.array_of(3);
        parameters[0] = pointer_llvm;
        parameters[1] = argument_type;
        parameters[2] = i64_type;
        arguments[0] = handle;
        arguments[1] = argument;
        arguments[2] = LLVMConstInt(i64_type, format, 0);
        this.call_runtime(formatted.cstr(), LLVMVoidTypeInContext(this.context), parameters, arguments, 3);
    }

    unsafe void append_slice_format(ptr handle, ptr data, ptr length, ptr format) {
        ptr pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
        ptr i32_type = LLVMIntTypeInContext(this.context, 32);
        ptr i64_type = LLVMIntTypeInContext(this.context, 64);
        ptr<ptr> parameters = CodeGenerator.array_of(4);
        ptr<ptr> arguments = CodeGenerator.array_of(4);
        parameters[0] = pointer_llvm;
        parameters[1] = pointer_llvm;
        parameters[2] = i32_type;
        parameters[3] = i64_type;
        arguments[0] = handle;
        arguments[1] = data;
        arguments[2] = length;
        arguments[3] = format;
        this.call_runtime("__djinn_text_slice_format", LLVMVoidTypeInContext(this.context), parameters, arguments, 4);
    }

    unsafe void append_slice(ptr handle, ptr data, ptr length) {
        ptr pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
        ptr i32_type = LLVMIntTypeInContext(this.context, 32);
        ptr<ptr> parameters = CodeGenerator.array_of(3);
        ptr<ptr> arguments = CodeGenerator.array_of(3);
        parameters[0] = pointer_llvm;
        parameters[1] = pointer_llvm;
        parameters[2] = i32_type;
        arguments[0] = handle;
        arguments[1] = data;
        arguments[2] = length;
        this.call_runtime("__djinn_text_slice", LLVMVoidTypeInContext(this.context), parameters, arguments, 3);
    }

    bool fold_interpolation(Node* node, ByteBuffer* out, i32 depth) {
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* part = node.child(i);
            if (i % 2 == 0) {
                i64 text_length = part.int_value() & 4294967295;
                if (text_length > 0) {
                    out.append(part.text());
                }
                continue;
            }
            Node* before = node.child(i - 1);
            if ((before.int_value() >> 32) != 0) {
                return false;
            }
            if (!this.fold_constant(part, out, depth)) {
                return false;
            }
        }
        return true;
    }

    ptr string_constant(ptr<i8> literal) {
        mut ptr<i8> text = literal;
        if (text == null) {
            text = "";
        }
        u64 length = (u64)strlen(text);
        ptr initializer = LLVMConstStringInContext2(this.context, text, length, 0);
        ptr global = LLVMAddGlobal(this.module, LLVMTypeOf(initializer), ".str");
        LLVMSetInitializer(global, initializer);
        LLVMSetGlobalConstant(global, 1);
        LLVMSetLinkage(global, LlvmConst.LINKAGE_PRIVATE);
        LLVMSetUnnamedAddr(global, 1);
        return global;
    }

    unsafe bool fold_constant(Node* part, ByteBuffer* out, i32 depth) {
        if (depth > 8) {
            return false;
        }
        NodeKind kind = part.kind();
        if (kind == NodeKind::STRING_LITERAL) {
            out.append(part.text());
            return true;
        }
        if (kind == NodeKind::INT_LITERAL) {
            u32 type = part.value_type();
            if (type == Types.byte_pointer() || type == this.symbols_core_type("str") || type == this.symbols_core_type("string")) {
                out.append((ptr<i8>)part.int_value());
                return true;
            }
            if (Types.is_char(type)) {
                out.append_utf8(part.int_value());
                return true;
            }
            if (Types.is_float(type) || (!Types.is_signed(type) && part.int_value() < 0)) {
                return false;
            }
            out.append_int(part.int_value());
            return true;
        }
        if (kind == NodeKind::BOOL_LITERAL) {
            if (part.int_value() != 0) {
                out.append("true");
            } else {
                out.append("false");
            }
            return true;
        }
        if (kind == NodeKind::INTERPOLATION) {
            return this.fold_interpolation(part, out, depth + 1);
        }
        if (kind == NodeKind::ARRAY_LITERAL) {
            return this.fold_array(part, out, depth + 1);
        }
        if (kind == NodeKind::IDENTIFIER && part.symbol_kind() == SymbolKind.LOCAL) {
            LocalVariable* variable = (LocalVariable*)part.symbol();
            Node* declaration = variable.node;
            if (variable.is_mutable || declaration == null || declaration.kind() != NodeKind::VAR_DECL) {
                return false;
            }
            Node* initial = declaration.first();
            if (initial == null) {
                return false;
            }
            return this.fold_constant(initial, out, depth + 1);
        }
        return false;
    }

    unsafe Node* initial_of(Node* node) {
        if (node.kind() != NodeKind::IDENTIFIER || node.symbol_kind() != SymbolKind.LOCAL) {
            return node;
        }
        LocalVariable* variable = (LocalVariable*)node.symbol();
        Node* declaration = variable.node;
        if (variable.is_mutable || declaration == null || declaration.kind() != NodeKind::VAR_DECL || declaration.first() == null) {
            return (Node*)0;
        }
        return declaration.first();
    }

    unsafe bool fold_element(Node* item, ByteBuffer* out, i32 depth) {
        if (depth > 8) {
            return false;
        }
        Node* source = this.initial_of(item);
        if (source == null) {
            return false;
        }
        NodeKind kind = source.kind();
        u32 type = source.value_type();
        u32 view = this.symbols_core_type("str");
        u32 owned = this.symbols_core_type("string");
        if (kind == NodeKind::STRING_LITERAL) {
            out.append("\"");
            out.append(source.text());
            out.append("\"");
            return true;
        }
        if (kind == NodeKind::INT_LITERAL) {
            if (type == Types.byte_pointer() || type == view || type == owned) {
                out.append("\"");
                out.append((ptr<i8>)source.int_value());
                out.append("\"");
                return true;
            }
            if (!Types.is_integer(type) || Types.is_char(type) || Types.bits(type) == 1 || (!Types.is_signed(type) && source.int_value() < 0)) {
                return false;
            }
            out.append_int(source.int_value());
            return true;
        }
        if (kind == NodeKind::STRUCT_INIT && Types.is_struct(type) && type != view && type != owned) {
            StructInfo* info = this.struct_of(type);
            FunctionInfo* formatter = this.formatter_of(type);
            if (info.is_enum || info.origin != null) {
                return false;
            }
            if (formatter != null) {
                ConstEval* evaluator = this.const_eval;
                if (formatter.const_kind == 0 || evaluator == null || !evaluator.format_text(source, formatter)) {
                    return false;
                }
                out.append("\"");
                out.append((ptr<i8>)evaluator.ri);
                out.append("\"");
                return true;
            }
            SymbolTable* symbols = this.symbols;
            symbols.describe_type(type, out);
            return true;
        }
        return false;
    }

    unsafe bool fold_array(Node* literal, ByteBuffer* out, i32 depth) {
        out.append("[");
        for (mut i32 i = 0; i < literal.count(); i = i + 1) {
            if (i == 0) {
                out.append(" ");
            } else {
                out.append(", ");
            }
            if (!this.fold_element(literal.child(i), out, depth)) {
                return false;
            }
        }
        out.append(" ]");
        return true;
    }

    unsafe Value* gen_interpolation(Node* node) {
        u32 type = node.value_type();
        ByteBuffer* folded = ByteBuffer.create();
        if (this.fold_interpolation(node, folded, 0)) {
            if (type == this.symbols_core_type("str")) {
                return Value.create(this.static_text(folded.cstr(), type), type);
            }
            ptr constant = LLVMBuildGlobalStringPtr(this.builder, folded.cstr(), "interp.const");
            return this.gen_constant_text(folded.cstr(), constant, type);
        }
        ptr pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
        ptr i32_type = LLVMIntTypeInContext(this.context, 32);
        ptr i64_type = LLVMIntTypeInContext(this.context, 64);
        ptr f64_type = LLVMDoubleTypeInContext(this.context);
        u32 owned = this.symbols_core_type("string");
        u32 view = this.symbols_core_type("str");

        mut i64 hint = 0;
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            if (i % 2 == 0) {
                hint = hint + (node.child(i).int_value() & 4294967295);
            } else {
                hint = hint + 24;
            }
        }
        ptr handle = LLVMBuildAlloca(this.alloca_builder, LLVMArrayType2(LLVMIntTypeInContext(this.context, 8), 16), "text.builder");
        LLVMSetAlignment(handle, 8);
        this.append_text(handle, "__djinn_text_init", i32_type, LLVMConstInt(i32_type, (u64)hint, 0));
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* part = node.child(i);
            if (i % 2 == 0) {
                i64 text_length = part.int_value() & 4294967295;
                if (text_length > 0) {
                    ptr literal = LLVMBuildGlobalStringPtr(this.builder, part.text(), "interp.text");
                    this.append_slice(handle, literal, LLVMConstInt(i32_type, (u64)text_length, 0));
                }
                continue;
            }
            Value* value = this.gen_expression(part);
            u32 value_type = value.type;
            Node* before = node.child(i - 1);
            u64 format = (u64)(before.int_value() >> 32);
            ptr format_value = LLVMConstInt(i64_type, format, 0);
            if (value_type == owned || value_type == view) {
                ptr data = LLVMBuildExtractValue(this.builder, value.ref, 0, "interp.data");
                ptr length = LLVMBuildExtractValue(this.builder, value.ref, 1, "interp.length");
                if (format != 0) {
                    this.append_slice_format(handle, data, length, format_value);
                } else {
                    this.append_slice(handle, data, length);
                }
            } else if (this.array_element_of(value_type) != 0) {
                Value* listed = this.format_array(value, this.array_element_of(value_type));
                this.append_value(handle, "__djinn_text_cstr", pointer_llvm, listed.ref, format);
            } else if (Types.is_pointer(value_type)) {
                this.append_value(handle, "__djinn_text_cstr", pointer_llvm, value.ref, format);
            } else if (Types.is_float(value_type) && Types.bits(value_type) == 32) {
                this.append_value(handle, "__djinn_text_f32", LLVMFloatTypeInContext(this.context), this.coerce(value, Types.floating(32)), format);
            } else if (Types.is_float(value_type)) {
                this.append_value(handle, "__djinn_text_f64", f64_type, this.coerce(value, Types.floating(64)), format);
            } else if (Types.is_char(value_type)) {
                this.append_value(handle, "__djinn_text_char", i32_type, value.ref, format);
            } else if (Types.is_integer(value_type) && Types.bits(value_type) == 1) {
                this.append_value(handle, "__djinn_text_bool", i32_type, this.coerce(value, Types.i32_type()), format);
            } else if (Types.is_signed(value_type)) {
                this.append_value(handle, "__djinn_text_i64", i64_type, this.coerce(value, Types.i64_type()), format);
            } else {
                this.append_value(handle, "__djinn_text_u64", i64_type, this.coerce(value, Types.integer(64, false)), format);
            }
        }

        ptr length_slot = this.create_slot(Types.integer(32, false), "interp.size");
        ptr<ptr> parameters = CodeGenerator.array_of(2);
        ptr<ptr> arguments = CodeGenerator.array_of(2);
        parameters[0] = pointer_llvm;
        parameters[1] = pointer_llvm;
        arguments[0] = handle;
        arguments[1] = length_slot;
        ptr data = this.call_runtime("__djinn_text_finish", pointer_llvm, parameters, arguments, 2);
        ptr length = LLVMBuildLoad2(this.builder, i32_type, length_slot, "interp.length");

        ptr llvm = this.llvm_type(type);
        ptr slot = this.create_slot(type, "interp");
        LLVMBuildStore(this.builder, LLVMConstNull(llvm), slot);
        LLVMBuildStore(this.builder, data, LLVMBuildStructGEP2(this.builder, llvm, slot, 0, "interp.data.ptr"));
        LLVMBuildStore(this.builder, length, LLVMBuildStructGEP2(this.builder, llvm, slot, 1, "interp.length.ptr"));
        PointerList* result_fields = this.struct_of(type).fields;
        if (result_fields.length > 2) {
            LLVMBuildStore(this.builder, length, LLVMBuildStructGEP2(this.builder, llvm, slot, 2, "interp.capacity.ptr"));
        }
        return Value.create(LLVMBuildLoad2(this.builder, llvm, slot, "interp.loaded"), type);
    }
}
