namespace djinnc;

impl CodeGenerator {
    unsafe void gen_statement(Node* node) {
        NodeKind kind = node.kind();
        this.locate(node);

        switch (kind) {
            case BLOCK:
                mut ptr outer_scope = (ptr)0;
                if (this.debug != null) {
                    DebugInfo* debug = this.debug;
                    outer_scope = debug.enter_block(node);
                }
                i32 block_mark = this.drop_mark();
                for (mut i32 i = 0; i < node.count(); i = i + 1) {
                    this.gen_statement(node.child(i));
                }
                this.end_scope(block_mark);
                if (this.debug != null) {
                    DebugInfo* debug = this.debug;
                    debug.leave_block(outer_scope);
                }
            case VAR_DECL:
                this.gen_variable(node);
            case EXPR_STMT:
                this.gen_expression(node.first());
            case SPAWN_STMT:
                this.gen_spawn(node);
            case RETURN:
                this.gen_return(node);
            case THROW_STMT:
                this.generate_throw_statement(node);
            case IF:
                this.gen_if(node);
            case WHILE:
                this.gen_while(node);
            case DO_WHILE:
                this.gen_do_while(node);
            case FOR:
                this.gen_for(node);
            case SWITCH:
                this.gen_switch(node);
            case BREAK:
                FunctionContext* function_context = this.function_context;
                this.emit_drops(function_context.break_depth());
                LLVMBuildBr(this.builder, function_context.break_block());
                this.start_dead_block();
            case CONTINUE:
                FunctionContext* function_context = this.function_context;
                this.emit_drops(function_context.continue_depth());
                LLVMBuildBr(this.builder, function_context.continue_block());
                this.start_dead_block();
            default:
                this.error_code(node, DiagnosticErrors.CODEGEN_NOT_SUPPORTED, "statement is not supported by code generation yet");
        }
    }

    unsafe void gen_variable(Node* node) {
        LocalVariable* variable = (LocalVariable*)node.symbol();
        u32 declared = variable.type;
        variable.slot = this.create_slot(declared, variable.name);
        if (node.first() != null) {
            Value* initial = this.gen_expression(node.first());
            LLVMBuildStore(this.builder, this.coerce(initial, declared), variable.slot);
        } else {
            LLVMBuildStore(this.builder, LLVMConstNull(this.llvm_type(declared)), variable.slot);
        }
        this.track_disposable(variable, node.first() != null);
        this.release_moved(node.first());
        this.declare_variable(variable.slot, variable.name, declared, node, 0);
    }

    void gen_return(Node* node) {
        FunctionContext* function_context = this.function_context;
        if (this.current_function().has_throws) {
            this.generate_throwing_return(node, this.current_function());
            return;
        }
        if (function_context.is_async) {
            if (node.first() != null) {
                Value* produced = this.gen_expression(node.first());
                LLVMBuildStore(this.builder, this.coerce(produced, this.current_function().return_type), function_context.promise);
                this.release_moved(node.first());
            }
            this.emit_drops(0);
            LLVMBuildBr(this.builder, function_context.final_block);
            this.start_dead_block();
            return;
        }
        FunctionInfo* current = this.current_function();
        if (node.first() == null) {
            this.emit_drops(0);
            this.emit_frame_pop();
            LLVMBuildRetVoid(this.builder);
        } else {
            Value* returned = this.gen_expression(node.first());
            ptr coerced = this.coerce(returned, current.return_type);
            this.release_moved(node.first());
            this.emit_drops(0);
            this.emit_frame_pop();
            LLVMBuildRet(this.builder, coerced);
        }
        this.start_dead_block();
    }

    void gen_if(Node* node) {
        if (node.op() == 2) {
            this.gen_statement(node.second());
            return;
        }
        if (node.op() == 3) {
            if (node.third() != null) {
                this.gen_statement(node.third());
            }
            return;
        }
        ptr condition = this.to_condition(this.gen_expression(node.first()));
        ptr then_block = this.new_block("if.then");
        ptr end_block = this.new_block("if.end");
        mut ptr else_block = end_block;
        if (node.third() != null) {
            else_block = this.new_block("if.else");
        }

        LLVMBuildCondBr(this.builder, condition, then_block, else_block);
        LLVMPositionBuilderAtEnd(this.builder, then_block);
        this.gen_statement(node.second());
        this.branch_if_open(end_block);

        if (node.third() != null) {
            LLVMPositionBuilderAtEnd(this.builder, else_block);
            this.gen_statement(node.third());
            this.branch_if_open(end_block);
        }
        LLVMPositionBuilderAtEnd(this.builder, end_block);
    }

    unsafe void gen_switch(Node* node) {
        Value* subject = this.gen_expression(node.first());
        u32 subject_type = subject.type;
        ptr end_block = this.new_block("switch.end");
        mut ptr default_block = end_block;
        PointerList* blocks = PointerList.create();
        PointerList* labels = PointerList.create();
        mut u32 case_count = 0;

        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* arm = node.child(i);
            if (arm.first() == null) {
                default_block = this.new_block("switch.default");
                blocks.push(default_block);
                labels.push(null);
            } else {
                blocks.push(this.new_block("switch.case"));
                Node* label = arm.first();
                if (label.symbol_kind() == SymbolKind.CONSTANT) {
                    Node* variant = (Node*)label.symbol();
                    Node* tag_value = variant.first();
                    labels.push(this.int_constant(this.llvm_type(subject_type), tag_value.int_value()));
                } else {
                    labels.push(this.coerce(this.gen_expression(label), subject_type));
                }
                case_count = case_count + 1;
            }
        }

        ptr dispatch = LLVMBuildSwitch(this.builder, subject.ref, default_block, case_count);
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            if (labels.get(i) != null) {
                LLVMAddCase(dispatch, labels.get(i), blocks.get(i));
            }
        }

        FunctionContext* function_context = this.function_context;
        function_context.enter_switch(end_block);
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* arm = node.child(i);
            LLVMPositionBuilderAtEnd(this.builder, blocks.get(i));
            i32 arm_mark = this.drop_mark();
            for (mut i32 j = 0; j < arm.count(); j = j + 1) {
                this.gen_statement(arm.child(j));
            }
            this.end_scope(arm_mark);
            this.branch_if_open(end_block);
        }
        function_context.leave_loop();
        LLVMPositionBuilderAtEnd(this.builder, end_block);
    }

    void gen_while(Node* node) {
        ptr condition_block = this.new_block("while.cond");
        ptr body_block = this.new_block("while.body");
        ptr end_block = this.new_block("while.end");

        this.branch_if_open(condition_block);
        LLVMPositionBuilderAtEnd(this.builder, condition_block);
        ptr condition = this.to_condition(this.gen_expression(node.first()));
        LLVMBuildCondBr(this.builder, condition, body_block, end_block);

        this.run_loop_body(node.second(), body_block, end_block, condition_block);
        bool open = !this.is_terminated();
        this.branch_if_open(condition_block);
        if (open) {
            this.mark_loop(node);
        }
        LLVMPositionBuilderAtEnd(this.builder, end_block);
    }

    void gen_do_while(Node* node) {
        ptr body_block = this.new_block("do.body");
        ptr condition_block = this.new_block("do.cond");
        ptr end_block = this.new_block("do.end");

        this.branch_if_open(body_block);
        this.run_loop_body(node.second(), body_block, end_block, condition_block);
        this.branch_if_open(condition_block);

        LLVMPositionBuilderAtEnd(this.builder, condition_block);
        ptr condition = this.to_condition(this.gen_expression(node.first()));
        LLVMBuildCondBr(this.builder, condition, body_block, end_block);
        this.mark_loop(node);
        LLVMPositionBuilderAtEnd(this.builder, end_block);
    }

    void gen_for(Node* node) {
        if (node.first() != null) {
            this.gen_statement(node.first());
        }

        ptr condition_block = this.new_block("for.cond");
        ptr body_block = this.new_block("for.body");
        ptr step_block = this.new_block("for.step");
        ptr end_block = this.new_block("for.end");

        this.branch_if_open(condition_block);
        LLVMPositionBuilderAtEnd(this.builder, condition_block);
        if (node.second() != null) {
            ptr condition = this.to_condition(this.gen_expression(node.second()));
            LLVMBuildCondBr(this.builder, condition, body_block, end_block);
        } else {
            LLVMBuildBr(this.builder, body_block);
        }

        this.run_loop_body(node.fourth(), body_block, end_block, step_block);
        this.branch_if_open(step_block);

        LLVMPositionBuilderAtEnd(this.builder, step_block);
        if (node.third() != null) {
            this.gen_expression(node.third());
        }
        LLVMBuildBr(this.builder, condition_block);
        this.mark_loop(node);
        LLVMPositionBuilderAtEnd(this.builder, end_block);
    }

    unsafe ptr loop_hint(ptr<i8> name, u32 bits, u64 value) {
        ptr<ptr> operands = CodeGenerator.array_of(2);
        operands[0] = LLVMMDStringInContext2(this.context, name, (u64)strlen(name));
        if (bits == 0) {
            return LLVMMDNodeInContext2(this.context, operands, 1);
        }
        operands[1] = LLVMValueAsMetadata(LLVMConstInt(LLVMIntTypeInContext(this.context, bits), value, 0));
        return LLVMMDNodeInContext2(this.context, operands, 2);
    }

    unsafe void mark_loop(Node* node) {
        PointerList* uses = Attributes.of(node);
        if (uses.length == 0) {
            return;
        }
        ptr<ptr> operands = CodeGenerator.array_of(uses.length + 1);
        ptr placeholder = LLVMTemporaryMDNode(this.context, null, 0);
        operands[0] = placeholder;
        mut u64 count = 1;
        for (mut i32 i = 0; i < uses.length; i = i + 1) {
            AttributeUse* use = (AttributeUse*)uses.get(i);
            mut ptr hint = (ptr)0;
            if (Strings.same(use.name, "Unroll")) {
                if (use.int_arg > 0) {
                    hint = this.loop_hint("llvm.loop.unroll.count", 32, (u64)use.int_arg);
                } else {
                    hint = this.loop_hint("llvm.loop.unroll.enable", 0, 0);
                }
            } else if (Strings.same(use.name, "NoUnroll")) {
                hint = this.loop_hint("llvm.loop.unroll.disable", 0, 0);
            } else if (Strings.same(use.name, "Vectorize")) {
                hint = this.loop_hint("llvm.loop.vectorize.enable", 1, 1);
            } else if (Strings.same(use.name, "NoVectorize")) {
                hint = this.loop_hint("llvm.loop.vectorize.enable", 1, 0);
            }
            if (hint != null) {
                operands[(i32)count] = hint;
                count = count + 1;
            }
        }
        ptr identity = LLVMMDNodeInContext2(this.context, operands, count);
        LLVMMetadataReplaceAllUsesWith(placeholder, identity);
        ptr branch = LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(this.builder));
        u32 kind = LLVMGetMDKindIDInContext(this.context, "llvm.loop", 9);
        LLVMSetMetadata(branch, kind, LLVMMetadataAsValue(this.context, identity));
    }

    void run_loop_body(Node* body, ptr body_block, ptr break_block, ptr continue_block) {
        FunctionContext* function_context = this.function_context;
        function_context.enter_loop(break_block, continue_block);
        LLVMPositionBuilderAtEnd(this.builder, body_block);
        this.gen_statement(body);
        function_context.leave_loop();
    }

    unsafe Value* gen_switch_expression(Node* node) {
        if (node.symbol_kind() == SymbolKind.ERROR_SWITCH) {
            return this.generate_error_switch(node);
        }
        SymbolTable* symbols = this.symbols;
        Node* subject_node = node.first();
        Value* subject = this.gen_expression(subject_node);
        u32 subject_type = subject.type;
        StructInfo* owner = symbols.enum_of_type(subject_type);
        u32 result_type = node.value_type();

        mut ptr tag = subject.ref;
        mut ptr spill = (ptr)0;
        ptr enum_llvm = this.llvm_type(subject_type);
        if (Types.is_struct(subject_type)) {
            spill = this.create_slot(subject_type, "match.subject");
            LLVMBuildStore(this.builder, subject.ref, spill);
            tag = this.load_tag(subject_type, enum_llvm, spill, "match.tag");
        }

        ptr result_slot = this.create_slot(result_type, "match.result");
        ptr end_block = this.new_block("match.end");
        PointerList* blocks = PointerList.create();
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            blocks.push(this.new_block("match.arm"));
        }
        mut i32 fallback = node.count() - 1;
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* wildcard_arm = node.child(i);
            if (Strings.same(wildcard_arm.text(), "_")) {
                fallback = i;
            }
        }
        ptr dispatch = LLVMBuildSwitch(this.builder, tag, blocks.get(fallback), (u32)node.count());
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* case_arm = node.child(i);
            if (i == fallback && Strings.same(case_arm.text(), "_")) {
                continue;
            }
            Node* variant = (Node*)case_arm.symbol();
            Node* tag_value = variant.first();
            ptr label = LLVMConstInt(LLVMIntTypeInContext(this.context, 32), (u64)tag_value.int_value(), 0);
            LLVMAddCase(dispatch, label, blocks.get(i));
        }

        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* arm = node.child(i);
            LLVMPositionBuilderAtEnd(this.builder, blocks.get(i));
            Node* arm_variant = (Node*)arm.symbol();
            for (mut i32 b = 0; b < arm.count(); b = b + 1) {
                Node* binding = arm.child(b);
                LocalVariable* variable = (LocalVariable*)binding.symbol();
                variable.slot = this.create_slot(variable.type, variable.name);
                ptr address = this.payload_address(subject_type, enum_llvm, spill, arm_variant, b);
                ptr loaded = LLVMBuildLoad2(this.builder, this.llvm_type(variable.type), address, "match.bound");
                LLVMBuildStore(this.builder, loaded, variable.slot);
                this.declare_variable(variable.slot, variable.name, variable.type, binding, 0);
            }
            Value* produced = this.gen_expression(arm.first());
            LLVMBuildStore(this.builder, this.coerce(produced, result_type), result_slot);
            this.branch_if_open(end_block);
        }
        LLVMPositionBuilderAtEnd(this.builder, end_block);
        return Value.create(LLVMBuildLoad2(this.builder, this.llvm_type(result_type), result_slot, "match.value"), result_type);
    }
}
