namespace djinnc;

struct CoroWrappers {
    public static void emit(CodeGen* gen) {
        void* ptr_type = LLVMPointerTypeInContext(gen.context, 0);
        void* i32_type = LLVMIntTypeInContext(gen.context, 32);
        void* i1_type = LLVMIntTypeInContext(gen.context, 1);
        void* void_type = LLVMVoidTypeInContext(gen.context);

        CoroWrappers.emit_void_call(gen, "__djinn_coro_resume", "llvm.coro.resume", void_type, ptr_type);
        CoroWrappers.emit_void_call(gen, "__djinn_coro_destroy", "llvm.coro.destroy", void_type, ptr_type);
        CoroWrappers.emit_done(gen, ptr_type, i32_type, i1_type);
        CoroWrappers.emit_promise(gen, ptr_type, i32_type, i1_type);
    }

    static void* begin(CodeGen* gen, i8* name, void* return_type, void** params, u32 count) {
        void* function_type = LLVMFunctionType(return_type, params, count, 0);
        void* function = LLVMAddFunction(gen.module, name, function_type);
        void* entry = LLVMAppendBasicBlockInContext(gen.context, function, "entry");
        LLVMPositionBuilderAtEnd(gen.builder, entry);
        return function;
    }

    static void emit_void_call(CodeGen* gen, i8* name, i8* intrinsic, void* void_type, void* ptr_type) {
        void** params = CodeGen.array_of(1);
        params[0] = ptr_type;
        void* function = CoroWrappers.begin(gen, name, void_type, params, 1);

        u32 id = LLVMLookupIntrinsicID(intrinsic, (u64)strlen(intrinsic));
        void* callee_type = LLVMIntrinsicGetType(gen.context, id, (void**)0, 0);
        void* callee = LLVMGetIntrinsicDeclaration(gen.module, id, (void**)0, 0);
        void** args = CodeGen.array_of(1);
        args[0] = LLVMGetParam(function, 0);
        LLVMBuildCall2(gen.builder, callee_type, callee, args, 1, "");
        LLVMBuildRetVoid(gen.builder);
    }

    static void emit_done(CodeGen* gen, void* ptr_type, void* i32_type, void* i1_type) {
        void** params = CodeGen.array_of(1);
        params[0] = ptr_type;
        void* function = CoroWrappers.begin(gen, "__djinn_coro_done", i32_type, params, 1);

        u32 id = LLVMLookupIntrinsicID("llvm.coro.done", (u64)strlen("llvm.coro.done"));
        void* callee_type = LLVMIntrinsicGetType(gen.context, id, (void**)0, 0);
        void* callee = LLVMGetIntrinsicDeclaration(gen.module, id, (void**)0, 0);
        void** args = CodeGen.array_of(1);
        args[0] = LLVMGetParam(function, 0);
        void* done = LLVMBuildCall2(gen.builder, callee_type, callee, args, 1, "done");
        void* extended = LLVMBuildCast(gen.builder, LlvmConst.OP_ZEXT, done, i32_type, "done.ext");
        LLVMBuildRet(gen.builder, extended);
    }

    static void emit_promise(CodeGen* gen, void* ptr_type, void* i32_type, void* i1_type) {
        void** params = CodeGen.array_of(2);
        params[0] = ptr_type;
        params[1] = i32_type;
        void* function = CoroWrappers.begin(gen, "__djinn_coro_promise", ptr_type, params, 2);

        u32 id = LLVMLookupIntrinsicID("llvm.coro.promise", (u64)strlen("llvm.coro.promise"));
        void* callee_type = LLVMIntrinsicGetType(gen.context, id, (void**)0, 0);
        void* callee = LLVMGetIntrinsicDeclaration(gen.module, id, (void**)0, 0);

        void* fallback = LLVMAppendBasicBlockInContext(gen.context, function, "alignment.default");
        void* dispatch = LLVMBuildSwitch(gen.builder, LLVMGetParam(function, 1), fallback, 5);
        mut i32 alignment = 1;
        while (alignment <= 16) {
            void* block = LLVMAppendBasicBlockInContext(gen.context, function, "alignment");
            LLVMAddCase(dispatch, LLVMConstInt(i32_type, (u64)alignment, 0), block);
            LLVMPositionBuilderAtEnd(gen.builder, block);
            void** args = CodeGen.array_of(3);
            args[0] = LLVMGetParam(function, 0);
            args[1] = LLVMConstInt(i32_type, (u64)alignment, 0);
            args[2] = LLVMConstInt(i1_type, 0, 0);
            void* result = LLVMBuildCall2(gen.builder, callee_type, callee, args, 3, "promise");
            LLVMBuildRet(gen.builder, result);
            alignment = alignment * 2;
        }
        LLVMPositionBuilderAtEnd(gen.builder, fallback);
        LLVMBuildRet(gen.builder, LLVMConstNull(ptr_type));
    }
}
