namespace djinnc;

struct CoroWrappers {
    public static unsafe void emit(CodeGenerator* gen) {
        ptr ptr_type = LLVMPointerTypeInContext(gen.context, 0);
        ptr i32_type = LLVMIntTypeInContext(gen.context, 32);
        ptr i1_type = LLVMIntTypeInContext(gen.context, 1);
        ptr void_type = LLVMVoidTypeInContext(gen.context);

        CoroWrappers.emit_void_call(gen, "__djinn_coro_resume", "llvm.coro.resume", void_type, ptr_type);
        CoroWrappers.emit_void_call(gen, "__djinn_coro_destroy", "llvm.coro.destroy", void_type, ptr_type);
        CoroWrappers.emit_done(gen, ptr_type, i32_type, i1_type);
        CoroWrappers.emit_promise(gen, ptr_type, i32_type, i1_type);
    }

    static unsafe ptr begin(CodeGenerator* gen, ptr<i8> name, ptr return_type, ptr<ptr> params, u32 count) {
        ptr function_type = LLVMFunctionType(return_type, params, count, 0);
        ptr function = LLVMAddFunction(gen.module, name, function_type);
        ptr entry = LLVMAppendBasicBlockInContext(gen.context, function, "entry");
        LLVMPositionBuilderAtEnd(gen.builder, entry);
        return function;
    }

    static unsafe void emit_void_call(CodeGenerator* gen, ptr<i8> name, ptr<i8> intrinsic, ptr void_type, ptr ptr_type) {
        ptr<ptr> params = CodeGenerator.array_of(1);
        params[0] = ptr_type;
        ptr function = CoroWrappers.begin(gen, name, void_type, params, 1);

        u32 id = LLVMLookupIntrinsicID(intrinsic, (u64)strlen(intrinsic));
        ptr callee_type = LLVMIntrinsicGetType(gen.context, id, null, 0);
        ptr callee = LLVMGetIntrinsicDeclaration(gen.module, id, null, 0);
        ptr<ptr> args = CodeGenerator.array_of(1);
        args[0] = LLVMGetParam(function, 0);
        LLVMBuildCall2(gen.builder, callee_type, callee, args, 1, "");
        LLVMBuildRetVoid(gen.builder);
    }

    static unsafe void emit_done(CodeGenerator* gen, ptr ptr_type, ptr i32_type, ptr i1_type) {
        ptr<ptr> params = CodeGenerator.array_of(1);
        params[0] = ptr_type;
        ptr function = CoroWrappers.begin(gen, "__djinn_coro_done", i32_type, params, 1);

        u32 id = LLVMLookupIntrinsicID("llvm.coro.done", (u64)strlen("llvm.coro.done"));
        ptr callee_type = LLVMIntrinsicGetType(gen.context, id, null, 0);
        ptr callee = LLVMGetIntrinsicDeclaration(gen.module, id, null, 0);
        ptr<ptr> args = CodeGenerator.array_of(1);
        args[0] = LLVMGetParam(function, 0);
        ptr done = LLVMBuildCall2(gen.builder, callee_type, callee, args, 1, "done");
        ptr extended = LLVMBuildCast(gen.builder, LlvmConst.OP_ZEXT, done, i32_type, "done.ext");
        LLVMBuildRet(gen.builder, extended);
    }

    static unsafe void emit_promise(CodeGenerator* gen, ptr ptr_type, ptr i32_type, ptr i1_type) {
        ptr<ptr> params = CodeGenerator.array_of(2);
        params[0] = ptr_type;
        params[1] = i32_type;
        ptr function = CoroWrappers.begin(gen, "__djinn_coro_promise", ptr_type, params, 2);

        u32 id = LLVMLookupIntrinsicID("llvm.coro.promise", (u64)strlen("llvm.coro.promise"));
        ptr callee_type = LLVMIntrinsicGetType(gen.context, id, null, 0);
        ptr callee = LLVMGetIntrinsicDeclaration(gen.module, id, null, 0);

        ptr fallback = LLVMAppendBasicBlockInContext(gen.context, function, "alignment.default");
        ptr dispatch = LLVMBuildSwitch(gen.builder, LLVMGetParam(function, 1), fallback, 5);
        mut i32 alignment = 1;
        while (alignment <= 16) {
            ptr block = LLVMAppendBasicBlockInContext(gen.context, function, "alignment");
            LLVMAddCase(dispatch, LLVMConstInt(i32_type, (u64)alignment, 0), block);
            LLVMPositionBuilderAtEnd(gen.builder, block);
            ptr<ptr> args = CodeGenerator.array_of(3);
            args[0] = LLVMGetParam(function, 0);
            args[1] = LLVMConstInt(i32_type, (u64)alignment, 0);
            args[2] = LLVMConstInt(i1_type, 0, 0);
            ptr result = LLVMBuildCall2(gen.builder, callee_type, callee, args, 3, "promise");
            LLVMBuildRet(gen.builder, result);
            alignment = alignment * 2;
        }
        LLVMPositionBuilderAtEnd(gen.builder, fallback);
        LLVMBuildRet(gen.builder, LLVMConstNull(ptr_type));
    }
}
