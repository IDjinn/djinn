namespace djinnc;

struct AtomicSave {
    ptr address;
    ptr save;
    ptr llvm_type;
}

impl CodeGenerator {
    unsafe void gen_atomic(Node* node) {
        Node* operands = node.second();
        PointerList* region = PointerList.create();
        for (mut i32 i = 0; i < operands.count(); i = i + 1) {
            Node* operand = operands.child(i);
            ptr llvm = this.llvm_type(operand.value_type());
            ptr address = this.gen_address(operand);
            ptr save = LLVMBuildAlloca(this.alloca_builder, llvm, "atomic.save");
            LLVMBuildStore(this.builder, LLVMBuildLoad2(this.builder, llvm, address, "atomic.value"), save);
            AtomicSave* entry = (AtomicSave*)Memory.zalloc(sizeof(AtomicSave));
            entry.address = address;
            entry.save = save;
            entry.llvm_type = llvm;
            region.push((ptr)entry);
        }
        FunctionContext* function_context = this.function_context;
        PointerList* regions = function_context.atomics;
        regions.push((ptr)region);
        this.gen_statement(node.first());
        regions.truncate(regions.length - 1);
    }

    unsafe void emit_rollbacks(ptr record) {
        FunctionContext* function_context = this.function_context;
        PointerList* regions = function_context.atomics;
        if (regions.length == 0) {
            return;
        }
        ptr i32_type = LLVMIntTypeInContext(this.context, 32);
        ptr tag = LLVMBuildExtractValue(this.builder, record, 0, "atomic.tag");
        ptr failed = LLVMBuildICmp(this.builder, LlvmConst.INT_NE, tag, LLVMConstInt(i32_type, 0, 0), "atomic.failed");
        ptr restore_block = this.new_block("atomic.rollback");
        ptr next_block = this.new_block("atomic.next");
        LLVMBuildCondBr(this.builder, failed, restore_block, next_block);
        LLVMPositionBuilderAtEnd(this.builder, restore_block);
        for (mut i32 r = regions.length - 1; r >= 0; r = r - 1) {
            PointerList* region = (PointerList*)regions.get(r);
            for (mut i32 i = region.length - 1; i >= 0; i = i - 1) {
                AtomicSave* entry = (AtomicSave*)region.get(i);
                LLVMBuildStore(this.builder, LLVMBuildLoad2(this.builder, entry.llvm_type, entry.save, "atomic.restore"), entry.address);
            }
        }
        LLVMBuildBr(this.builder, next_block);
        LLVMPositionBuilderAtEnd(this.builder, next_block);
    }
}
