namespace djinnc;

impl CodeGenerator {
    Value* gen_sizeof(Node* node) {
        u32 measured = (u32)(u64)node.symbol();
        u32 result = Types.integer(32, true);
        if (Types.is_struct(measured)) {
            StructInfo* info = this.struct_of(measured);
            ptr size = LLVMBuildIntCast2(this.builder, LLVMSizeOf(info.llvm), this.llvm_type(result), 0, "sizeof");
            return Value.create(size, result);
        }
        mut i64 bytes = 8;
        if (Types.is_integer(measured)) {
            bytes = (i64)((Types.bits(measured) + 7) / 8);
        } else if (Types.is_float(measured)) {
            bytes = (i64)(Types.bits(measured) / 8);
        }
        return Value.create(LLVMConstInt(this.llvm_type(result), (u64)bytes, 0), result);
    }

    bool is_struct_name(Node* node) {
        return node.kind() == NodeKind::IDENTIFIER && node.symbol_kind() == SymbolKind.STRUCT_NAME;
    }

    bool is_addressable(Node* node) {
        NodeKind kind = node.kind();
        if (kind == NodeKind::INDEX) {
            return node.symbol_kind() != SymbolKind.INDEX_GET && node.symbol_kind() != SymbolKind.INDEX_SET;
        }
        if (kind == NodeKind::IDENTIFIER) {
            return true;
        }
        if (kind == NodeKind::FIELD_ACCESS) {
            return !this.is_struct_name(node.first()) && node.symbol_kind() != SymbolKind.PROPERTY_GET && node.symbol_kind() != SymbolKind.PROPERTY_SET;
        }
        return kind == NodeKind::UNARY && node.op_kind() == TokenKind::STAR;
    }

    ptr index_collection(Node* base, u32 parameter) {
        if (Types.is_pointer(parameter)) {
            return this.struct_pointer(base);
        }
        return this.coerce(this.gen_expression(base), parameter);
    }

    unsafe Value* gen_index_get(Node* node) {
        FunctionInfo* getter = (FunctionInfo*)node.symbol();
        IdList* parameters = getter.param_types;
        ptr<ptr> args = CodeGenerator.array_of(2);
        args[0] = this.index_collection(node.first(), parameters.get(0));
        args[1] = this.coerce(this.gen_expression(node.second()), parameters.get(1));
        ptr result = LLVMBuildCall2(this.builder, getter.function_type, getter.function, args, 2, "index.get");
        return Value.create(result, getter.return_type);
    }

    unsafe Value* gen_index_set(Node* node) {
        Node* target = node.first();
        FunctionInfo* setter = (FunctionInfo*)target.symbol();
        IdList* parameters = setter.param_types;
        ptr<ptr> args = CodeGenerator.array_of(3);
        args[0] = this.index_collection(target.first(), parameters.get(0));
        args[1] = this.coerce(this.gen_expression(target.second()), parameters.get(1));
        Value* assigned = this.gen_expression(node.second());
        args[2] = this.coerce(assigned, parameters.get(2));
        LLVMBuildCall2(this.builder, setter.function_type, setter.function, args, 3, "");
        return Value.create(args[2], parameters.get(2));
    }

    ptr struct_pointer(Node* base) {
        if (this.is_addressable(base)) {
            ptr address = this.gen_address(base);
            u32 base_type = base.value_type();
            if (Types.is_pointer(base_type)) {
                return LLVMBuildLoad2(this.builder, this.llvm_type(base_type), address, "load");
            }
            return address;
        }
        Value* value = this.gen_expression(base);
        if (!Types.is_pointer(value.type)) {
            ptr spill = this.create_slot(value.type, "receiver");
            LLVMBuildStore(this.builder, value.ref, spill);
            return spill;
        }
        return value.ref;
    }

    unsafe ptr field_address(Node* node) {
        Node* base = node.first();
        ptr pointer = this.struct_pointer(base);
        StructInfo* info = this.struct_behind(base.value_type());
        FieldInfo* field = (FieldInfo*)node.symbol();
        return LLVMBuildStructGEP2(this.builder, info.llvm, pointer, (u32)field.index, node.text());
    }

    unsafe Value* gen_member(Node* node) {
        Node* base = node.first();
        if (this.is_struct_name(base)) {
            Node* constant = (Node*)node.symbol();
            u32 declared = constant.value_type();
            Value* value = this.gen_expression(constant.first());
            return Value.create(this.coerce(value, declared), declared);
        }
        if (node.symbol_kind() == SymbolKind.PROPERTY_GET) {
            FunctionInfo* getter = (FunctionInfo*)node.symbol();
            ptr<ptr> args = CodeGenerator.array_of(1);
            args[0] = this.method_receiver(getter.owner, base);
            ptr result = LLVMBuildCall2(this.builder, getter.function_type, getter.function, args, 1, "property.get");
            return Value.create(result, getter.return_type);
        }
        if (node.symbol_kind() == SymbolKind.ENUM_FIELD) {
            return this.gen_enum_field(node);
        }
        return this.load_through(this.field_address(node), node.value_type());
    }

    unsafe Value* gen_enum_field(Node* node) {
        Node* base = node.first();
        u32 enum_type = base.value_type();
        SymbolTable* symbols = this.symbols;
        StructInfo* info = symbols.enum_of_type(enum_type);
        Value* value = this.gen_expression(base);
        mut ptr tag = value.ref;
        if (Types.is_pointer(value.type)) {
            tag = LLVMBuildLoad2(this.builder, this.llvm_type(enum_type), value.ref, "enum.tag");
        }
        i32 index = (i32)(u64)node.symbol();
        u32 field_type = node.value_type();
        ptr element = this.llvm_type(field_type);
        if (index == 0) {
            return Value.create(LLVMBuildIntCast2(this.builder, tag, element, 0, "enum.flag"), field_type);
        }
        ptr table = this.enum_field_table(info, index, field_type);
        ptr<ptr> rows = (ptr<ptr>)info.field_rows;
        ptr array_type = LLVMArrayType2(element, (u64)rows[index]);
        ptr<ptr> indices = CodeGenerator.array_of(2);
        indices[0] = LLVMConstInt(LLVMIntTypeInContext(this.context, 64), 0, 0);
        indices[1] = LLVMBuildIntCast2(this.builder, tag, LLVMIntTypeInContext(this.context, 64), 0, "enum.row");
        ptr address = LLVMBuildGEP2(this.builder, array_type, table, indices, 2, "enum.field.ptr");
        return Value.create(LLVMBuildLoad2(this.builder, element, address, "enum.field"), field_type);
    }

    unsafe ptr enum_field_table(StructInfo* info, i32 index, u32 field_type) {
        if (info.field_tables == null) {
            info.field_tables = (ptr)CodeGenerator.array_of(info.header_count);
            info.field_rows = (ptr)CodeGenerator.array_of(info.header_count);
        }
        ptr<ptr> tables = (ptr<ptr>)info.field_tables;
        ptr<ptr> rows = (ptr<ptr>)info.field_rows;
        if (tables[index] != null) {
            return tables[index];
        }
        PointerList* constants = info.constants;
        mut i64 highest = 0;
        for (mut i32 c = 0; c < constants.length; c = c + 1) {
            Node* variant = (Node*)constants.get(c);
            Node* flag = variant.first();
            if (flag.int_value() > highest) {
                highest = flag.int_value();
            }
        }
        i32 row_count = (i32)highest + 1;
        ptr element = this.llvm_type(field_type);
        ptr<ptr> values = CodeGenerator.array_of(row_count);
        for (mut i32 r = 0; r < row_count; r = r + 1) {
            values[r] = LLVMConstNull(element);
        }
        for (mut i32 c = 0; c < constants.length; c = c + 1) {
            Node* variant = (Node*)constants.get(c);
            Node* flag = variant.first();
            if (flag.int_value() >= 0) {
                Value* produced = this.gen_expression(variant.child(index));
                values[(i32)flag.int_value()] = this.coerce(produced, field_type);
            }
        }
        ptr global = LLVMAddGlobal(this.module, LLVMArrayType2(element, (u64)row_count), "enum.table");
        LLVMSetInitializer(global, LLVMConstArray2(element, values, (u64)row_count));
        LLVMSetGlobalConstant(global, 1);
        LLVMSetLinkage(global, 9);
        tables[index] = global;
        rows[index] = (ptr)(u64)row_count;
        return global;
    }

    ptr method_receiver(StructInfo* owner, Node* base) {
        if (owner.is_enum || owner.is_primitive) {
            Value* value = this.gen_expression(base);
            mut ptr receiver = value.ref;
            if (Types.is_pointer(value.type)) {
                receiver = LLVMBuildLoad2(this.builder, this.llvm_type(owner.type_id), value.ref, "enum.load");
            }
            return receiver;
        }
        return this.struct_pointer(base);
    }

    unsafe ptr implicit_field_address(Node* node) {
        FunctionContext* context = this.function_context;
        FunctionInfo* current = context.function;
        LocalVariable* self = current.this_variable;
        StructInfo* owner = current.owner;
        ptr pointer = LLVMBuildLoad2(this.builder, this.llvm_type(self.type), self.slot, "this");
        FieldInfo* field = (FieldInfo*)node.symbol();
        return LLVMBuildStructGEP2(this.builder, owner.llvm, pointer, (u32)field.index, node.text());
    }

    ptr implicit_receiver() {
        FunctionContext* context = this.function_context;
        FunctionInfo* current = context.function;
        LocalVariable* self = current.this_variable;
        return LLVMBuildLoad2(this.builder, this.llvm_type(self.type), self.slot, "this");
    }

    unsafe Value* gen_identifier(Node* node) {
        if (node.symbol_kind() == SymbolKind.IMPLICIT_GET) {
            FunctionInfo* getter = (FunctionInfo*)node.symbol();
            ptr<ptr> args = CodeGenerator.array_of(1);
            args[0] = this.implicit_receiver();
            ptr result = LLVMBuildCall2(this.builder, getter.function_type, getter.function, args, 1, "property.get");
            return Value.create(result, getter.return_type);
        }
        if (node.symbol_kind() == SymbolKind.IMPLICIT_FIELD) {
            return this.load_through(this.implicit_field_address(node), node.value_type());
        }
        if (node.symbol_kind() == SymbolKind.CONSTANT) {
            Node* sibling = (Node*)node.symbol();
            return Value.create(this.coerce(this.gen_expression(sibling.first()), sibling.value_type()), sibling.value_type());
        }
        LocalVariable* variable = (LocalVariable*)node.symbol();
        ptr loaded = LLVMBuildLoad2(this.builder, this.llvm_type(variable.type), variable.slot, node.text());
        return Value.create(loaded, variable.type);
    }

    Value* load_through(ptr address, u32 type) {
        ptr loaded = LLVMBuildLoad2(this.builder, this.llvm_type(type), address, "load");
        return Value.create(loaded, type);
    }

    unsafe ptr gen_address(Node* node) {
        NodeKind kind = node.kind();

        if (kind == NodeKind::IDENTIFIER) {
            if (node.symbol_kind() == SymbolKind.IMPLICIT_FIELD) {
                return this.implicit_field_address(node);
            }
            LocalVariable* variable = (LocalVariable*)node.symbol();
            return variable.slot;
        }

        if (kind == NodeKind::FIELD_ACCESS) {
            return this.field_address(node);
        }

        if (kind == NodeKind::INDEX) {
            mut Value* base = this.gen_expression(node.first());
            Value* index = this.gen_expression(node.second());
            if (Types.is_struct(base.type)) {
                base = Value.create(LLVMBuildExtractValue(this.builder, base.ref, 0, "array.data"), Types.pointer_to(node.value_type()));
            }
            ptr<ptr> indices = CodeGenerator.array_of(1);
            indices[0] = this.coerce(index, Types.i64_type());
            ptr element_type = this.llvm_type(node.value_type());
            return LLVMBuildGEP2(this.builder, element_type, base.ref, indices, 1, "index");
        }

        Value* pointer = this.gen_expression(node.first());
        return pointer.ref;
    }
}
