namespace djinnc;

impl CodeGenerator {
    unsafe Value* gen_operator_call(Node* node, bool negated) {
        FunctionInfo* info = (FunctionInfo*)node.symbol();
        IdList* param_types = info.param_types;
        ptr<ptr> args = CodeGenerator.array_of(2);
        args[0] = this.coerce(this.gen_expression(node.first()), param_types.get(0));
        mut u32 count = 1;
        if (param_types.length == 2) {
            args[1] = this.coerce(this.gen_expression(node.second()), param_types.get(1));
            count = 2;
        }
        mut ptr result = LLVMBuildCall2(this.builder, info.function_type, info.function, args, count, "op");
        if (negated) {
            result = LLVMBuildNot(this.builder, result, "op.not");
        }
        return Value.create(result, info.return_type);
    }

    Value* gen_enum_construct(Node* node, Node* variant, u32 enum_type) {
        ptr llvm = this.llvm_type(enum_type);
        ptr slot = this.create_slot(enum_type, "enum.value");
        StructInfo* info = this.struct_of(enum_type);
        if (info.is_niche) {
            ptr pointer_slot = LLVMBuildStructGEP2(this.builder, llvm, slot, 0, "niche.slot");
            LLVMBuildStore(this.builder, LLVMConstPointerNull(LLVMPointerTypeInContext(this.context, 0)), pointer_slot);
        } else {
            ptr tag_address = LLVMBuildStructGEP2(this.builder, llvm, slot, 0, "enum.tag");
            Node* tag_value = variant.first();
            ptr tag = LLVMConstInt(LLVMIntTypeInContext(this.context, 32), (u64)tag_value.int_value(), 0);
            LLVMBuildStore(this.builder, tag, tag_address);
        }
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* payload = variant.child(i);
            Value* argument = this.gen_expression(node.child(i));
            ptr address = this.payload_address(enum_type, llvm, slot, variant, i);
            LLVMBuildStore(this.builder, this.coerce(argument, payload.value_type()), address);
        }
        return Value.create(LLVMBuildLoad2(this.builder, llvm, slot, "enum.loaded"), enum_type);
    }

    unsafe void call_constructor(Node* node, ptr target, FunctionInfo* constructor) {
        if (constructor == null) {
            return;
        }
        IdList* param_types = constructor.param_types;
        ptr<ptr> args = CodeGenerator.array_of(node.count() + 1);
        args[0] = target;
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Value* argument = this.gen_expression(node.child(i));
            args[i + 1] = this.coerce(argument, param_types.get(i + 1));
        }
        LLVMBuildCall2(this.builder, constructor.function_type, constructor.function, args, (u32)(node.count() + 1), "");
    }

    unsafe Value* gen_let(Node* node) {
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* item = node.child(i);
            LocalVariable* variable = (LocalVariable*)item.symbol();
            Value* initial = this.gen_expression(item.first());
            variable.slot = this.create_slot(variable.type, variable.name);
            LLVMBuildStore(this.builder, this.coerce(initial, variable.type), variable.slot);
            this.declare_variable(variable.slot, variable.name, variable.type, item, 0);
        }
        return this.gen_expression(node.first());
    }

    unsafe Value* gen_new(Node* node) {
        u32 pointer_type = node.value_type();
        StructInfo* info = this.struct_of(Types.element(pointer_type));
        ptr memory = this.allocate_aligned(LLVMSizeOf(info.llvm), info.align);
        this.call_constructor(node, memory, (FunctionInfo*)node.symbol());
        return Value.create(memory, pointer_type);
    }

    unsafe Value* gen_call(Node* node) {
        return this.generate_call_with_propagation(node, true);
    }

    unsafe Value* generate_call_with_propagation(Node* node, bool propagate) {
        Node* callee = node.first();
        if (callee.symbol_kind() == SymbolKind.CONSTANT) {
            Node* variant = (Node*)callee.symbol();
            u32 declared = variant.value_type();
            if (Types.is_struct(declared)) {
                return this.gen_enum_construct(node, variant, declared);
            }
            Value* tag = this.gen_expression(variant.first());
            return Value.create(this.coerce(tag, declared), declared);
        }
        if (callee.symbol_kind() == SymbolKind.CONSTRUCTOR) {
            u32 constructed = node.value_type();
            ptr slot = this.create_slot(constructed, "ctor");
            LLVMBuildStore(this.builder, LLVMConstNull(this.llvm_type(constructed)), slot);
            this.call_constructor(node, slot, (FunctionInfo*)callee.symbol());
            return Value.create(LLVMBuildLoad2(this.builder, this.llvm_type(constructed), slot, "ctor.loaded"), constructed);
        }
        if (callee.symbol_kind() == SymbolKind.ENUM_VALUE) {
            Value* enum_value = this.gen_expression(callee.first());
            mut ptr raw = enum_value.ref;
            if (Types.is_pointer(enum_value.type)) {
                raw = LLVMBuildLoad2(this.builder, this.llvm_type(Types.element(enum_value.type)), enum_value.ref, "enum.value");
            }
            return Value.create(raw, Types.i32_type());
        }
        FunctionInfo* info = (FunctionInfo*)callee.symbol();
        if (info.is_extern && info.owner != null && info.owner.node != null && Attributes.has(info.owner.node, "intrinsic")) {
            return this.gen_coro_primitive(node, info);
        }
        mut ptr receiver = (ptr)0;
        mut i32 offset = 0;

        if (callee.symbol_kind() == SymbolKind.INSTANCE_METHOD) {
            StructInfo* receiver_owner = info.owner;
            if (receiver_owner.is_enum || receiver_owner.is_primitive) {
                Value* enum_value = this.gen_expression(callee.first());
                receiver = enum_value.ref;
                if (Types.is_pointer(enum_value.type)) {
                    receiver = LLVMBuildLoad2(this.builder, this.llvm_type(receiver_owner.type_id), enum_value.ref, "enum.load");
                }
            } else {
                receiver = this.struct_pointer(callee.first());
            }
            offset = 1;
        }

        IdList* param_types = info.param_types;
        i32 fixed = param_types.length;
        mut i32 given = node.count() + offset;
        mut i32 normal = fixed;
        if (info.packs_variadic) {
            normal = fixed - 1;
        }

        ptr<ptr> args = CodeGenerator.array_of(given + 1);
        if (offset == 1) {
            args[0] = receiver;
        }
        for (mut i32 i = offset; i < given; i = i + 1) {
            Node* argument_node = node.child(i - offset);
            if (i < normal) {
                Value* argument = this.gen_expression(argument_node);
                args[i] = this.coerce(argument, param_types.get(i));
            } else if (!info.packs_variadic) {
                Value* extra = this.promote_variadic(this.gen_expression(argument_node));
                args[i] = extra.ref;
            }
        }
        if (info.packs_variadic) {
            args[normal] = this.pack_boxed_arguments(node, offset, normal, param_types.get(normal));
            given = fixed;
        }

        mut ptr<i8> label = "call";
        if (Types.is_void(info.return_type)) {
            label = "";
        }
        if (info.is_async) {
            ptr handle = LLVMBuildCall2(this.builder, info.function_type, info.function, args, (u32)given, "async.handle");
            u32 task_type = node.value_type();
            ptr task_llvm = this.llvm_type(task_type);
            ptr task_slot = this.create_slot(task_type, "task");
            LLVMBuildStore(this.builder, handle, LLVMBuildStructGEP2(this.builder, task_llvm, task_slot, 0, "task.handle.ptr"));
            return Value.create(LLVMBuildLoad2(this.builder, task_llvm, task_slot, "task.value"), task_type);
        }
        ptr result = LLVMBuildCall2(this.builder, info.function_type, info.function, args, (u32)given, label);
        if (info.node != null && Attributes.has(info.node, "NoReturn")) {
            this.emit_noreturn();
            if (Types.is_void(info.return_type)) {
                return Value.create(null, info.return_type);
            }
            return Value.create(LLVMConstNull(this.llvm_type(info.return_type)), info.return_type);
        }
        if (info.has_throws) {
            return this.finish_throwing_call(node, info, result, propagate);
        }
        return Value.create(result, info.return_type);
    }

    unsafe ptr pack_boxed_arguments(Node* node, i32 offset, i32 normal, u32 pack_type) {
        i32 count = node.count() + offset - normal;
        u32 boxed = this.symbols_core_type("object");
        SymbolTable* pack_symbols = this.symbols;
        u32 element_type = pack_symbols.pack_element(pack_type);
        ptr object_llvm = this.llvm_type(element_type);
        ptr i32_type = LLVMIntTypeInContext(this.context, 32);
        ptr storage = LLVMBuildAlloca(this.alloca_builder, LLVMArrayType2(object_llvm, (u64)(count + 1)), "va.storage");
        for (mut i32 i = 0; i < count; i = i + 1) {
            Value* value = this.gen_expression(node.child(normal - offset + i));
            mut ptr element = value.ref;
            if (element_type == boxed && value.type != boxed) {
                element = this.box_value(this.format_for_boxing(value));
            } else if (element_type != boxed) {
                element = this.coerce(value, element_type);
            }
            ptr<ptr> indices = CodeGenerator.array_of(2);
            indices[0] = LLVMConstInt(i32_type, 0, 0);
            indices[1] = LLVMConstInt(i32_type, (u64)i, 0);
            ptr address = LLVMBuildGEP2(this.builder, LLVMArrayType2(object_llvm, (u64)(count + 1)), storage, indices, 2, "va.slot");
            LLVMBuildStore(this.builder, element, address);
        }
        ptr pack_llvm = this.llvm_type(pack_type);
        ptr pack_slot = this.create_slot(pack_type, "va.pack");
        LLVMBuildStore(this.builder, storage, LLVMBuildStructGEP2(this.builder, pack_llvm, pack_slot, 0, "va.data"));
        LLVMBuildStore(this.builder, LLVMConstInt(i32_type, (u64)count, 0), LLVMBuildStructGEP2(this.builder, pack_llvm, pack_slot, 1, "va.length"));
        return LLVMBuildLoad2(this.builder, pack_llvm, pack_slot, "va.value");
    }
}
