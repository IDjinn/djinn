namespace djinnc;

struct ReflectionKind {
    const i32 SIGNED = 0;
    const i32 FLOAT = 1;
    const i32 POINTER = 2;
    const i32 STRUCT = 3;
    const i32 UNSIGNED = 4;
    const i32 STR = 5;
    const i32 STRING = 6;
    const i32 ENUM = 7;
    const i32 UNION = 8;
    const i32 INTERFACE = 9;

    const i32 TYPE_REFLECTED = 1;

    const i32 METHOD_STATIC = 2;
    const i32 METHOD_ASYNC = 4;
    const i32 METHOD_VARIADIC = 8;
    const i32 METHOD_EXTERN = 16;

    const i32 PARAM_PACK = 1;
    const i32 FIELD_MUTABLE = 1;
}
