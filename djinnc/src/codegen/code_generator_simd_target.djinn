namespace djinnc;

// The safe wrappers of compiler builtins that have no generic LLVM form: each one calls the instruction of the target
// when the code may use it (x86 SSSE3/AVX2/AVX-512, AArch64 NEON, WebAssembly SIMD128) and otherwise keeps the Djinn
// body, so the result is the same everywhere.
impl CodeGenerator {
    bool simd_feature(FunctionInfo* info, ptr<i8> name) {
        return CpuFeatures.enabled(name, CpuFeatures.of(info.node));
    }

    unsafe ptr simd_fixed_call(ptr<i8> name, ptr<ptr> args, i32 count) {
        return this.coro_intrinsic(name, (ptr<ptr>)0, 0, args, count, "builtin");
    }

    // Byte indices of 'shuffle_bytes' in the form tbl and swizzle read: a set top bit stays out of range, so the lane
    // is zero, and the rest picks within the 16 bytes.
    unsafe ptr simd_table_indices(ptr indices, u32 shape) {
        return LLVMBuildAnd(this.builder, indices, this.simd_constant(shape, 143), "shuffle.indices");
    }

    unsafe ptr simd_target_operation(FunctionInfo* info, ptr<i8> op, u32 shape, u32 element) {
        u32 count = this.simd_count(shape);
        bool x86 = Target.is_x64() || Target.is_x86();
        if (Strings.same(op, "shuffle_bytes")) {
            if (Types.bits(element) != 8 || this.simd_is_mask(shape)) {
                return (ptr)0;
            }
            ptr<ptr> args = CodeGenerator.array_of(2);
            args[0] = this.simd_operand(info, 0);
            args[1] = this.simd_operand(info, 1);
            if (x86 && count == 16 && this.simd_feature(info, "ssse3")) {
                return this.simd_fixed_call("llvm.x86.ssse3.pshuf.b.128", args, 2);
            }
            if (x86 && count == 32 && this.simd_feature(info, "avx2")) {
                return this.simd_fixed_call("llvm.x86.avx2.pshuf.b", args, 2);
            }
            if (x86 && count == 64 && this.simd_feature(info, "avx512bw")) {
                return this.simd_fixed_call("llvm.x86.avx512.pshuf.b.512", args, 2);
            }
            if (Target.is_arm64() && count == 16) {
                args[1] = this.simd_table_indices(args[1], shape);
                return this.simd_call("llvm.aarch64.neon.tbl1", LLVMTypeOf(args[0]), args, 2);
            }
            if (Target.is_wasm() && count == 16 && this.simd_feature(info, "simd128")) {
                args[1] = this.simd_table_indices(args[1], shape);
                return this.simd_fixed_call("llvm.wasm.swizzle", args, 2);
            }
            return (ptr)0;
        }
        if (Strings.same(op, "multiply_add_adjacent")) {
            if (Types.bits(element) != 16 || !Types.is_signed(element) || this.simd_count(info.return_type) * 2 != count) {
                return (ptr)0;
            }
            ptr left = this.simd_operand(info, 0);
            ptr right = this.simd_operand(info, 1);
            if (x86 && count == 8) {
                ptr<ptr> args = CodeGenerator.array_of(2);
                args[0] = left;
                args[1] = right;
                return this.simd_fixed_call("llvm.x86.sse2.pmadd.wd", args, 2);
            }
            if (x86 && count == 16 && this.simd_feature(info, "avx2")) {
                ptr<ptr> args = CodeGenerator.array_of(2);
                args[0] = left;
                args[1] = right;
                return this.simd_fixed_call("llvm.x86.avx2.pmadd.wd", args, 2);
            }
            ptr wide = this.simd_wide_type(shape);
            ptr products = LLVMBuildMul(this.builder, LLVMBuildCast(this.builder, LlvmConst.OP_SEXT, left, wide, "madd.left"),
                LLVMBuildCast(this.builder, LlvmConst.OP_SEXT, right, wide, "madd.right"), "madd.products");
            i32 half = (i32)count / 2;
            ptr<i32> even = (ptr<i32>)Memory.zalloc((u64)half * 4 + 4);
            ptr<i32> odd = (ptr<i32>)Memory.zalloc((u64)half * 4 + 4);
            for (mut i32 i = 0; i < half; i = i + 1) {
                even[i] = i * 2;
                odd[i] = i * 2 + 1;
            }
            ptr unused = LLVMGetPoison(wide);
            return LLVMBuildAdd(this.builder, this.simd_shuffle(products, unused, even, half, "madd.even"),
                this.simd_shuffle(products, unused, odd, half, "madd.odd"), "madd");
        }
        if (Strings.same(op, "sum_absolute_differences")) {
            if (Types.bits(element) != 8 || Types.is_signed(element) || this.simd_count(info.return_type) * 8 != count) {
                return (ptr)0;
            }
            ptr<ptr> args = CodeGenerator.array_of(2);
            args[0] = this.simd_operand(info, 0);
            args[1] = this.simd_operand(info, 1);
            if (x86 && count == 16) {
                return this.simd_fixed_call("llvm.x86.sse2.psad.bw", args, 2);
            }
            if (x86 && count == 32 && this.simd_feature(info, "avx2")) {
                return this.simd_fixed_call("llvm.x86.avx2.psad.bw", args, 2);
            }
            return (ptr)0;
        }
        return (ptr)0;
    }

    // [Target("avx2")]: the function is compiled for the target features plus these, whatever the CPU of the program.
    unsafe void apply_target_features(FunctionInfo* info, AttributeUse* use) {
        PointerList* names = CpuFeatures.names_of(use.text_arg);
        ByteBuffer* list = ByteBuffer.create();
        ptr<i8> base = ObjectWriter.feature_list();
        list.append(base);
        mut bool applied = false;
        for (mut i32 i = 0; i < names.length; i = i + 1) {
            ptr<i8> name = (ptr<i8>)names.get(i);
            if (!CpuFeatures.known(name)) {
                continue;
            }
            if (list.length > 0) {
                list.append_char(',');
            }
            list.append_char('+');
            list.append(name);
            applied = true;
        }
        if (applied) {
            this.add_string_attribute(info.function, "target-features", list.cstr());
        }
    }
}
