namespace djinnc;

struct FunctionContext {
    FunctionInfo* function;
    PointerList* loops;
    bool is_async;
    ptr promise;
    ptr coro_id;
    ptr handle;
    ptr final_block;
    ptr cleanup_block;
    ptr suspend_block;

    public static unsafe FunctionContext* create() {
        FunctionContext* context = (FunctionContext*)Memory.zalloc(sizeof(FunctionContext));
        context.loops = PointerList.create();
        return context;
    }

    public void begin(FunctionInfo* function) {
        this.function = function;
        this.is_async = false;
        PointerList* loops = this.loops;
        loops.truncate(0);
    }

    public unsafe void enter_loop(ptr break_block, ptr continue_block) {
        LoopTargets* targets = (LoopTargets*)Memory.zalloc(sizeof(LoopTargets));
        targets.break_block = break_block;
        targets.continue_block = continue_block;
        PointerList* loops = this.loops;
        loops.push((ptr)targets);
    }

    public void leave_loop() {
        PointerList* loops = this.loops;
        loops.truncate(loops.length - 1);
    }

    public bool in_loop() {
        PointerList* loops = this.loops;
        return loops.length > 0;
    }

    public unsafe ptr break_block() {
        PointerList* loops = this.loops;
        LoopTargets* targets = (LoopTargets*)loops.get(loops.length - 1);
        return targets.break_block;
    }

    public unsafe ptr continue_block() {
        PointerList* loops = this.loops;
        LoopTargets* targets = (LoopTargets*)loops.get(loops.length - 1);
        return targets.continue_block;
    }
}
