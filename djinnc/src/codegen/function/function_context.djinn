namespace djinnc;

struct FunctionContext {
    FunctionInfo* function;
    PointerList* loops;
    PointerList* drops;
    PointerList* atomics;
    bool is_async;
    ptr promise;
    ptr coro_id;
    ptr handle;
    ptr final_block;
    ptr cleanup_block;
    ptr suspend_block;

    public static unsafe FunctionContext* create() {
        FunctionContext* context = (FunctionContext*)Memory.zalloc(sizeof(FunctionContext));
        context.loops = PointerList.create();
        context.drops = PointerList.create();
        context.atomics = PointerList.create();
        return context;
    }

    public void begin(FunctionInfo* function) {
        this.function = function;
        this.is_async = false;
        PointerList* loops = this.loops;
        loops.truncate(0);
        PointerList* drops = this.drops;
        drops.truncate(0);
        PointerList* atomics = this.atomics;
        atomics.truncate(0);
    }

    public unsafe void enter_loop(ptr break_block, ptr continue_block) {
        PointerList* drops = this.drops;
        LoopTargets* targets = (LoopTargets*)Memory.zalloc(sizeof(LoopTargets));
        targets.break_block = break_block;
        targets.continue_block = continue_block;
        targets.break_depth = drops.length;
        targets.continue_depth = drops.length;
        PointerList* atomics = this.atomics;
        targets.break_atomics = atomics.length;
        targets.continue_atomics = atomics.length;
        PointerList* loops = this.loops;
        loops.push((ptr)targets);
    }

    public unsafe void enter_switch(ptr break_block) {
        PointerList* drops = this.drops;
        PointerList* loops = this.loops;
        LoopTargets* targets = (LoopTargets*)Memory.zalloc(sizeof(LoopTargets));
        targets.break_block = break_block;
        targets.break_depth = drops.length;
        targets.continue_depth = drops.length;
        PointerList* atomics = this.atomics;
        targets.break_atomics = atomics.length;
        targets.continue_atomics = atomics.length;
        if (loops.length > 0) {
            LoopTargets* enclosing = (LoopTargets*)loops.get(loops.length - 1);
            targets.continue_block = enclosing.continue_block;
            targets.continue_depth = enclosing.continue_depth;
            targets.continue_atomics = enclosing.continue_atomics;
        }
        loops.push((ptr)targets);
    }

    public void leave_loop() {
        PointerList* loops = this.loops;
        loops.truncate(loops.length - 1);
    }

    public bool in_loop() {
        PointerList* loops = this.loops;
        return loops.length > 0;
    }

    public unsafe ptr break_block() {
        PointerList* loops = this.loops;
        LoopTargets* targets = (LoopTargets*)loops.get(loops.length - 1);
        return targets.break_block;
    }

    public unsafe ptr continue_block() {
        PointerList* loops = this.loops;
        LoopTargets* targets = (LoopTargets*)loops.get(loops.length - 1);
        return targets.continue_block;
    }

    public unsafe i32 break_depth() {
        PointerList* loops = this.loops;
        LoopTargets* targets = (LoopTargets*)loops.get(loops.length - 1);
        return targets.break_depth;
    }

    public unsafe i32 break_atomics() {
        PointerList* loops = this.loops;
        LoopTargets* targets = (LoopTargets*)loops.get(loops.length - 1);
        return targets.break_atomics;
    }

    public unsafe i32 continue_atomics() {
        PointerList* loops = this.loops;
        LoopTargets* targets = (LoopTargets*)loops.get(loops.length - 1);
        return targets.continue_atomics;
    }

    public unsafe i32 continue_depth() {
        PointerList* loops = this.loops;
        LoopTargets* targets = (LoopTargets*)loops.get(loops.length - 1);
        return targets.continue_depth;
    }
}
