namespace djinnc;

// The web target: the type-checked program becomes one JavaScript file instead of an object. Only what main reaches
// is emitted (functions are queued the first time a call names them), each Djinn function is a plain JS function,
// a struct value is an object literal, numbers are JS numbers (32-bit integers wrapped with |0 / >>>0), str and
// string are JS strings, arr and slice are JS arrays and a fn value is a JS closure. A function marked
// [Js("template")] is never emitted: each call is replaced by the template, with $this for the receiver and $0, $1,
// ... for the arguments, which is how the std and ui bindings (runtime/js, libs/<name>/js) reach the browser with no
// wrapper in between. The .js files of those bindings are inlined in front of the program.
struct JsEmitter {
    CodeGenerator* gen;
    SymbolTable* symbols;
    Diagnostics* diagnostics;
    PointerList* functions;
    PointerList* globals;
    ByteBuffer* global_code;
    ByteBuffer* code;
    i32 depth;
    u32 str_type;
    u32 string_type;
    i32 temporaries;
    FunctionInfo* current;

    public static unsafe i32 write(CodeGenerator* gen, Options* options) {
        JsEmitter* emitter = (JsEmitter*)Memory.zalloc(sizeof(JsEmitter));
        emitter.gen = gen;
        emitter.symbols = gen.symbols;
        emitter.diagnostics = gen.diagnostics;
        emitter.functions = PointerList.create();
        emitter.globals = PointerList.create();
        emitter.global_code = ByteBuffer.create();
        emitter.code = ByteBuffer.create();
        emitter.str_type = gen.symbols_core_type("str");
        emitter.string_type = gen.symbols_core_type("string");
        FunctionInfo* main = emitter.find_main();
        if (main == null) {
            Diagnostics* missing = gen.diagnostics;
            missing.error(DiagnosticErrors.MISSING_MAIN, 1, 1, "the web target needs a 'main' function (or an [Application] struct)");
            return 1;
        }
        ptr<i8> entry = emitter.use_function(main);
        PointerList* queue = emitter.functions;
        for (mut i32 i = 0; i < queue.length; i = i + 1) {
            emitter.emit_function((FunctionInfo*)queue.get(i));
        }
        Diagnostics* diagnostics = gen.diagnostics;
        if (diagnostics.failed()) {
            return 1;
        }
        ByteBuffer* out = ByteBuffer.create();
        out.append("// Generated by djinnc --target web.\n\"use strict\";\n(() => {\n");
        PointerList* scripts = WebLibraries.scripts();
        for (mut i32 i = 0; i < scripts.length; i = i + 1) {
            ptr<i8> script = Files.read_all((ptr<i8>)scripts.get(i));
            if (script == null) {
                logger_error(Log.get(), "djinnc: cannot read '%s'", (ptr<i8>)scripts.get(i));
                return 1;
            }
            out.append(script);
            out.append("\n");
        }
        ByteBuffer* global_code = emitter.global_code;
        ByteBuffer* program_code = emitter.code;
        out.append(global_code.cstr());
        out.append(program_code.cstr());
        out.append(entry);
        out.append("();\n})();\n");
        ptr<i8> path = JsEmitter.output_path(options.output);
        if (!Files.write_bytes(path, out.data, out.length)) {
            logger_error(Log.get(), "djinnc: cannot write '%s'", path);
            return 1;
        }
        logger_info(Log.get(), "djinnc: wrote '%s' (%d bytes, %d functions)", path, out.length, queue.length);
        return 0;
    }

    static unsafe ptr<i8> output_path(ptr<i8> output) {
        i32 length = strlen(output);
        if (length > 3 && Strings.equals(output + length - 3, 3, ".js")) {
            return output;
        }
        ByteBuffer* path = ByteBuffer.create();
        mut i32 end = length;
        if (length > 4 && Strings.equals(output + length - 4, 4, ".exe")) {
            end = length - 4;
        }
        path.append_slice(output, end);
        path.append(".js");
        return path.cstr();
    }

    unsafe FunctionInfo* find_main() {
        SymbolTable* symbols = this.symbols;
        PointerList* functions = symbols.functions;
        for (mut i32 i = 0; i < functions.length; i = i + 1) {
            FunctionInfo* info = (FunctionInfo*)functions.get(i);
            if (!info.is_extern && !info.is_template && info.owner == null && info.name_atom == Atoms.MAIN_ATOM) {
                return info;
            }
        }
        return (FunctionInfo*)0;
    }

    void error(Node* at, ptr<i8> message) {
        Diagnostics* diagnostics = this.diagnostics;
        diagnostics.error_span(DiagnosticErrors.WEB_NOT_SUPPORTED, at.file_name(), at.line(), at.column(), at.length(), message);
    }

    // The name of a function in the output, queued for emission the first time it is used.
    unsafe ptr<i8> use_function(FunctionInfo* info) {
        PointerList* functions = this.functions;
        if (!info.is_extern && !functions.contains((ptr)info)) {
            functions.push((ptr)info);
        }
        return JsEmitter.function_name(info);
    }

    static unsafe ptr<i8> function_name(FunctionInfo* info) {
        if (info.is_extern) {
            return info.name;
        }
        ByteBuffer* name = ByteBuffer.create();
        JsEmitter.sanitize(name, info.name);
        if (info.overload_index > 0) {
            name.append("$");
            name.append_int((i64)info.overload_index);
        }
        ptr<i8> text = name.cstr();
        for (mut i32 i = 0; text[i] != 0; i = i + 1) {
            if (text[i] == 36) {
                return text;
            }
        }
        ByteBuffer* prefixed = ByteBuffer.create();
        prefixed.append("$");
        prefixed.append(text);
        return prefixed.cstr();
    }

    // Letters, digits and '_' are kept, every run of anything else becomes one '$' ('ui::Node.attr' -> 'ui$Node$attr').
    static unsafe void sanitize(ByteBuffer* out, ptr<i8> text) {
        mut bool joined = false;
        for (mut i32 i = 0; text[i] != 0; i = i + 1) {
            i32 c = (i32)text[i];
            bool word = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c < 0;
            if (word) {
                out.append_byte(c);
                joined = false;
            } else if (!joined) {
                out.append_byte(36);
                joined = true;
            }
        }
    }

    unsafe ptr<i8> use_global(LocalVariable* variable) {
        ByteBuffer* name = ByteBuffer.create();
        name.append("$g$");
        JsEmitter.sanitize(name, variable.name);
        PointerList* globals = this.globals;
        if (!globals.contains((ptr)variable)) {
            globals.push((ptr)variable);
            Node* declaration = variable.node;
            mut ptr<i8> initial = this.default_value(variable.type);
            if (declaration != null && declaration.first() != null) {
                initial = this.expression(declaration.first());
            }
            ByteBuffer* code = this.global_code;
            code.append("let ");
            code.append(name.cstr());
            code.append(" = ");
            code.append(initial);
            code.append(";\n");
        }
        return name.cstr();
    }

    static bool is_reserved(ptr<i8> name) {
        return Strings.same(name, "break") || Strings.same(name, "case") || Strings.same(name, "catch") || Strings.same(name, "class")
            || Strings.same(name, "const") || Strings.same(name, "continue") || Strings.same(name, "debugger") || Strings.same(name, "default")
            || Strings.same(name, "delete") || Strings.same(name, "do") || Strings.same(name, "else") || Strings.same(name, "enum")
            || Strings.same(name, "export") || Strings.same(name, "extends") || Strings.same(name, "false") || Strings.same(name, "finally")
            || Strings.same(name, "for") || Strings.same(name, "function") || Strings.same(name, "if") || Strings.same(name, "import")
            || Strings.same(name, "in") || Strings.same(name, "instanceof") || Strings.same(name, "new") || Strings.same(name, "null")
            || Strings.same(name, "return") || Strings.same(name, "super") || Strings.same(name, "switch") || Strings.same(name, "this")
            || Strings.same(name, "throw") || Strings.same(name, "true") || Strings.same(name, "try") || Strings.same(name, "typeof")
            || Strings.same(name, "var") || Strings.same(name, "void") || Strings.same(name, "while") || Strings.same(name, "with")
            || Strings.same(name, "yield") || Strings.same(name, "let") || Strings.same(name, "static") || Strings.same(name, "await")
            || Strings.same(name, "arguments") || Strings.same(name, "eval") || Strings.same(name, "undefined") || Strings.same(name, "NaN")
            || Strings.same(name, "Infinity") || Strings.same(name, "document") || Strings.same(name, "window") || Strings.same(name, "Math")
            || Strings.same(name, "console") || Strings.same(name, "String") || Strings.same(name, "Number") || Strings.same(name, "Array")
            || Strings.same(name, "Object") || Strings.same(name, "JSON") || Strings.same(name, "Symbol") || Strings.same(name, "Map")
            || Strings.same(name, "Set") || Strings.same(name, "Promise") || Strings.same(name, "self") || Strings.same(name, "globalThis");
    }

    unsafe ptr<i8> local_name(LocalVariable* variable) {
        FunctionInfo* current = this.current;
        if (current != null && variable == current.this_variable) {
            return "self";
        }
        if (Strings.same(variable.name, "this")) {
            return "self";
        }
        if (JsEmitter.is_reserved(variable.name)) {
            ByteBuffer* name = ByteBuffer.create();
            name.append(variable.name);
            name.append("_");
            return name.cstr();
        }
        return variable.name;
    }

    // The [Js("...")] template of a function, or null.
    unsafe ptr<i8> template_of(FunctionInfo* info) {
        Node* declaration = info.node;
        if (declaration == null) {
            return (ptr<i8>)0;
        }
        PointerList* uses = Attributes.of(declaration);
        for (mut i32 i = 0; i < uses.length; i = i + 1) {
            AttributeUse* use = (AttributeUse*)uses.get(i);
            if (Strings.same(use.name, "Js") && use.text_arg != null) {
                return use.text_arg;
            }
        }
        return (ptr<i8>)0;
    }

    // Replaces $this, $0..$9 and $* (every argument) in a template.
    static unsafe ptr<i8> expand(ptr<i8> template, ptr<i8> receiver, PointerList* args) {
        ByteBuffer* out = ByteBuffer.create();
        mut i32 i = 0;
        while (template[i] != 0) {
            i32 c = (i32)template[i];
            if (c == 36 && Strings.starts_with(template, i + 1, i + 5, "this") && receiver != null) {
                out.append(JsEmitter.grouped(receiver));
                i = i + 5;
                continue;
            }
            i32 next = (i32)template[i + 1];
            if (c == 36 && next == 42) {
                for (mut i32 a = 0; a < args.length; a = a + 1) {
                    if (a > 0) {
                        out.append(", ");
                    }
                    out.append((ptr<i8>)args.get(a));
                }
                i = i + 2;
                continue;
            }
            if (c == 36 && next >= 48 && next <= 57) {
                i32 index = next - 48;
                if (index < args.length) {
                    out.append(JsEmitter.grouped((ptr<i8>)args.get(index)));
                } else {
                    out.append("undefined");
                }
                i = i + 2;
                continue;
            }
            out.append_byte(c);
            i = i + 1;
        }
        return out.cstr();
    }

    // The expression as one operand: kept when it is simple or already one parenthesized group.
    static unsafe ptr<i8> enclosed(ptr<i8> code) {
        ptr<i8> simple = JsEmitter.grouped(code);
        if (simple == code || code[0] != 40) {
            return simple;
        }
        mut i32 depth = 0;
        mut bool quoted = false;
        i32 length = strlen(code);
        for (mut i32 i = 0; i < length; i = i + 1) {
            i32 c = (i32)code[i];
            if (quoted) {
                if (c == 92) {
                    i = i + 1;
                } else if (c == 34) {
                    quoted = false;
                }
                continue;
            }
            if (c == 34) {
                quoted = true;
            } else if (c == 40) {
                depth = depth + 1;
            } else if (c == 41) {
                depth = depth - 1;
                if (depth == 0 && i < length - 1) {
                    return simple;
                }
            }
        }
        return code;
    }

    // Wraps an expression in parentheses unless it is a name, a member path, a call or a literal already.
    static unsafe ptr<i8> grouped(ptr<i8> code) {
        mut bool simple = true;
        mut i32 depth = 0;
        mut bool quoted = false;
        for (mut i32 i = 0; code[i] != 0; i = i + 1) {
            i32 c = (i32)code[i];
            if (quoted) {
                if (c == 92) {
                    i = i + 1;
                } else if (c == 34) {
                    quoted = false;
                }
                continue;
            }
            if (c == 34) {
                quoted = true;
            } else if (c == 40 || c == 91) {
                depth = depth + 1;
            } else if (c == 41 || c == 93) {
                depth = depth - 1;
            } else if (depth == 0) {
                bool word = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 36 || c == 46 || c < 0;
                if (!word) {
                    simple = false;
                    break;
                }
            }
        }
        if (simple) {
            return code;
        }
        ByteBuffer* out = ByteBuffer.create();
        out.append("(");
        out.append(code);
        out.append(")");
        return out.cstr();
    }

    unsafe void emit_function(FunctionInfo* info) {
        Node* declaration = info.node;
        if (declaration == null || this.template_of(info) != null) {
            return;
        }
        FunctionInfo* saved = this.current;
        this.current = info;
        ByteBuffer* saved_code = this.code;
        ByteBuffer* own = ByteBuffer.create();
        this.code = own;
        own.append("function ");
        own.append(JsEmitter.function_name(info));
        own.append("(");
        mut bool first = true;
        if (info.is_instance) {
            own.append("self");
            first = false;
        }
        for (mut i32 i = 0; i < declaration.count(); i = i + 1) {
            Node* parameter = declaration.child(i);
            if (parameter.kind() != NodeKind::PARAMETER) {
                continue;
            }
            if (!first) {
                own.append(", ");
            }
            first = false;
            own.append(this.parameter_name(parameter));
        }
        own.append(") {\n");
        this.depth = 1;
        this.block_body(declaration.first());
        own.append("}\n");
        this.code = saved_code;
        this.current = saved;
        ByteBuffer* code = this.code;
        code.append(own.cstr());
    }

    unsafe ptr<i8> parameter_name(Node* parameter) {
        LocalVariable* variable = (LocalVariable*)parameter.symbol();
        if (variable == null) {
            return parameter.text();
        }
        return this.local_name(variable);
    }

    void line_start() {
        ByteBuffer* code = this.code;
        for (mut i32 i = 0; i < this.depth; i = i + 1) {
            code.append("  ");
        }
    }

    void line(ptr<i8> text) {
        this.line_start();
        ByteBuffer* code = this.code;
        code.append(text);
        code.append("\n");
    }

    unsafe ptr<i8> temporary() {
        this.temporaries = this.temporaries + 1;
        ByteBuffer* name = ByteBuffer.create();
        name.append("$t");
        name.append_int((i64)this.temporaries);
        return name.cstr();
    }

    bool is_text(u32 type) {
        return type != 0 && (type == this.str_type || type == this.string_type || type == Types.byte_pointer());
    }

    unsafe StructInfo* struct_info(u32 type) {
        if (!Types.is_struct(type)) {
            return (StructInfo*)0;
        }
        SymbolTable* symbols = this.symbols;
        return symbols.struct_at(Types.struct_index(type));
    }

    // A struct whose fields (or nested fields) can change in place: a value of it is copied when it is stored, as Djinn
    // copies struct values. A struct of immutable fields is shared, since nobody can tell.
    unsafe bool needs_copy(u32 type) {
        return this.is_mutable_struct(type, 0);
    }

    unsafe bool is_mutable_struct(u32 type, i32 level) {
        if (level > 8 || this.is_text(type)) {
            return false;
        }
        StructInfo* info = this.struct_info(type);
        if (info == null || info.is_enum || info.is_primitive || info.fields == null) {
            return false;
        }
        if (this.is_sequence(type) || this.is_closure(type)) {
            return false;
        }
        PointerList* fields = info.fields;
        for (mut i32 i = 0; i < fields.length; i = i + 1) {
            FieldInfo* field = (FieldInfo*)fields.get(i);
            Node* declaration = field.node;
            if (declaration != null && declaration.flag()) {
                return true;
            }
            if (this.is_mutable_struct(field.type, level + 1)) {
                return true;
            }
        }
        return false;
    }

    // arr<T> and slice<T>: JS arrays.
    unsafe bool is_sequence(u32 type) {
        StructInfo* info = this.struct_info(type);
        if (info == null || info.name == null) {
            return false;
        }
        return Strings.starts_with(info.name, 0, strlen(info.name), "arr<") || Strings.starts_with(info.name, 0, strlen(info.name), "slice<");
    }

    unsafe bool is_closure(u32 type) {
        SymbolTable* symbols = this.symbols;
        return Types.is_struct(type) && symbols.closure_signature(type) != null;
    }

    // The zero value of a type, as a variable without initializer holds it.
    unsafe ptr<i8> default_value(u32 type) {
        if (Types.is_integer(type) || Types.is_float(type)) {
            if (type == Types.bool_type()) {
                return "false";
            }
            return "0";
        }
        if (this.is_text(type)) {
            return "\"\"";
        }
        if (this.is_sequence(type)) {
            return "[]";
        }
        if (this.is_closure(type) || Types.is_pointer(type)) {
            return "null";
        }
        StructInfo* info = this.struct_info(type);
        if (info != null && info.is_enum) {
            return "0";
        }
        if (info == null || info.fields == null) {
            return "null";
        }
        PointerList* fields = info.fields;
        if (fields.length == 0) {
            return "null";
        }
        ByteBuffer* out = ByteBuffer.create();
        out.append("{");
        for (mut i32 i = 0; i < fields.length; i = i + 1) {
            FieldInfo* field = (FieldInfo*)fields.get(i);
            if (i > 0) {
                out.append(", ");
            }
            out.append(JsEmitter.field_name(field.name));
            out.append(": ");
            out.append(this.default_value(field.type));
        }
        out.append("}");
        return out.cstr();
    }

    static unsafe ptr<i8> field_name(ptr<i8> name) {
        if (JsEmitter.is_reserved(name) && !Strings.same(name, "length")) {
            ByteBuffer* out = ByteBuffer.create();
            out.append(name);
            out.append("_");
            return out.cstr();
        }
        return name;
    }

    static unsafe ptr<i8> quote(ptr<i8> text) {
        ByteBuffer* out = ByteBuffer.create();
        out.append_byte(34);
        if (text != null) {
            for (mut i32 i = 0; text[i] != 0; i = i + 1) {
                i32 c = (i32)text[i];
                if (c == 34 || c == 92) {
                    out.append_byte(92);
                    out.append_byte(c);
                } else if (c == 10) {
                    out.append("\\n");
                } else if (c == 13) {
                    out.append("\\r");
                } else if (c == 9) {
                    out.append("\\t");
                } else if (c >= 0 && c < 32) {
                    out.append("\\x");
                    out.append_byte(48 + c / 16);
                    i32 low = c % 16;
                    if (low < 10) {
                        out.append_byte(48 + low);
                    } else {
                        out.append_byte(87 + low);
                    }
                } else {
                    out.append_byte(c);
                }
            }
        }
        out.append_byte(34);
        return out.cstr();
    }
}
