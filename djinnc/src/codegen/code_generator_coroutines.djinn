namespace djinnc;

impl CodeGenerator {
    ptr coro_intrinsic(ptr<i8> name, ptr<ptr> types, u32 type_count, ptr<ptr> args, i32 count, ptr<i8> label) {
        u32 id = LLVMLookupIntrinsicID(name, (u64)strlen(name));
        ptr callee_type = LLVMIntrinsicGetType(this.context, id, types, (u64)type_count);
        ptr callee = LLVMGetIntrinsicDeclaration(this.module, id, types, (u64)type_count);
        return LLVMBuildCall2(this.builder, callee_type, callee, args, (u32)count, label);
    }

    ptr none_token() {
        return LLVMConstNull(LLVMTokenTypeInContext(this.context));
    }

    unsafe ptr frame_size() {
        ptr<ptr> size_types = CodeGenerator.array_of(1);
        size_types[0] = LLVMIntTypeInContext(this.context, 64);
        return this.coro_intrinsic("llvm.coro.size.i64", size_types, 1, CodeGenerator.array_of(0), 0, "coro.size");
    }

    unsafe ptr frame_call(ptr<i8> name, ptr return_type, ptr frame, u32 count) {
        ptr<ptr> params = (ptr<ptr>)u64[2];
        ptr<ptr> args = (ptr<ptr>)u64[2];
        mut i32 at = 0;
        if (frame != null) {
            params[0] = LLVMPointerTypeInContext(this.context, 0);
            args[0] = frame;
            at = 1;
        }
        params[at] = LLVMIntTypeInContext(this.context, 64);
        args[at] = this.frame_size();
        return this.call_runtime(name, return_type, params, args, (i32)count);
    }

    unsafe ptr suspend_switch(ptr ready_block, ptr<i8> label) {
        ptr<ptr> args = CodeGenerator.array_of(2);
        args[0] = this.none_token();
        args[1] = LLVMConstInt(LLVMIntTypeInContext(this.context, 1), 0, 0);
        ptr state = this.coro_intrinsic("llvm.coro.suspend", null, 0, args, 2, label);
        FunctionContext* function_context = this.function_context;
        ptr dispatch = LLVMBuildSwitch(this.builder, state, function_context.suspend_block, 2);
        ptr i8_type = LLVMIntTypeInContext(this.context, 8);
        LLVMAddCase(dispatch, LLVMConstInt(i8_type, 0, 0), ready_block);
        LLVMAddCase(dispatch, LLVMConstInt(i8_type, 1, 0), function_context.cleanup_block);
        return dispatch;
    }

    unsafe void begin_coroutine(FunctionInfo* info, ptr prologue, ptr body) {
        FunctionContext* function_context = this.function_context;
        function_context.is_async = true;
        ptr pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
        ptr i32_type = LLVMIntTypeInContext(this.context, 32);

        u32 kind = LLVMGetEnumAttributeKindForName("presplitcoroutine", 17);
        LLVMAddAttributeAtIndex(info.function, 4294967295, LLVMCreateEnumAttribute(this.context, kind, 0));

        mut ptr promise = (ptr)0;
        mut u64 alignment = 0;
        if (!Types.is_void(info.return_type) || info.has_throws) {
            ptr promise_llvm = this.promise_type(info);
            promise = LLVMBuildAlloca(this.alloca_builder, promise_llvm, "coro.promise");
            alignment = LLVMABIAlignmentOfType(this.layout_data, promise_llvm);
        } else {
            promise = LLVMConstNull(pointer_llvm);
        }
        function_context.promise = promise;

        ptr alloc_block = LLVMAppendBasicBlockInContext(this.context, info.function, "coro.alloc");
        ptr begin_block = LLVMAppendBasicBlockInContext(this.context, info.function, "coro.begin");
        function_context.final_block = LLVMAppendBasicBlockInContext(this.context, info.function, "coro.final");
        function_context.cleanup_block = LLVMAppendBasicBlockInContext(this.context, info.function, "coro.cleanup");
        function_context.suspend_block = LLVMAppendBasicBlockInContext(this.context, info.function, "coro.suspend");

        LLVMPositionBuilderAtEnd(this.builder, prologue);
        ptr<ptr> id_args = CodeGenerator.array_of(4);
        id_args[0] = LLVMConstInt(i32_type, alignment, 0);
        id_args[1] = promise;
        id_args[2] = LLVMConstNull(pointer_llvm);
        id_args[3] = LLVMConstNull(pointer_llvm);
        ptr coro_id = this.coro_intrinsic("llvm.coro.id", null, 0, id_args, 4, "coro.id");
        ptr<ptr> alloc_args = CodeGenerator.array_of(1);
        alloc_args[0] = coro_id;
        ptr needs_alloc = this.coro_intrinsic("llvm.coro.alloc", null, 0, alloc_args, 1, "coro.need");
        LLVMBuildCondBr(this.builder, needs_alloc, alloc_block, begin_block);

        LLVMPositionBuilderAtEnd(this.builder, alloc_block);
        ptr frame = this.frame_call("__djinn_coro_alloc", pointer_llvm, null, 1);
        LLVMBuildBr(this.builder, begin_block);

        LLVMPositionBuilderAtEnd(this.builder, begin_block);
        ptr frame_phi = LLVMBuildPhi(this.builder, pointer_llvm, "coro.frame.phi");
        ptr<ptr> incoming = CodeGenerator.array_of(2);
        ptr<ptr> blocks = CodeGenerator.array_of(2);
        incoming[0] = frame;
        incoming[1] = LLVMConstNull(pointer_llvm);
        blocks[0] = alloc_block;
        blocks[1] = prologue;
        LLVMAddIncoming(frame_phi, incoming, blocks, 2);
        ptr<ptr> begin_args = CodeGenerator.array_of(2);
        begin_args[0] = coro_id;
        begin_args[1] = frame_phi;
        function_context.handle = this.coro_intrinsic("llvm.coro.begin", null, 0, begin_args, 2, "coro.handle");
        function_context.coro_id = coro_id;

        this.suspend_switch(body, "coro.init");
    }

    unsafe void finish_coroutine() {
        FunctionContext* function_context = this.function_context;
        ptr pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
        ptr i1_type = LLVMIntTypeInContext(this.context, 1);
        ptr i8_type = LLVMIntTypeInContext(this.context, 8);

        LLVMPositionBuilderAtEnd(this.builder, function_context.final_block);
        ptr<ptr> final_args = CodeGenerator.array_of(2);
        final_args[0] = this.none_token();
        final_args[1] = LLVMConstInt(i1_type, 1, 0);
        ptr final_state = this.coro_intrinsic("llvm.coro.suspend", null, 0, final_args, 2, "coro.final.state");
        ptr trap_block = LLVMAppendBasicBlockInContext(this.context, this.current_function().function, "coro.trap");
        ptr dispatch = LLVMBuildSwitch(this.builder, final_state, function_context.suspend_block, 2);
        LLVMAddCase(dispatch, LLVMConstInt(i8_type, 0, 0), trap_block);
        LLVMAddCase(dispatch, LLVMConstInt(i8_type, 1, 0), function_context.cleanup_block);

        LLVMPositionBuilderAtEnd(this.builder, trap_block);
        this.coro_intrinsic("llvm.trap", null, 0, CodeGenerator.array_of(0), 0, "");
        LLVMBuildUnreachable(this.builder);

        ptr release_block = LLVMAppendBasicBlockInContext(this.context, this.current_function().function, "coro.release");
        LLVMPositionBuilderAtEnd(this.builder, function_context.cleanup_block);
        ptr<ptr> free_args = CodeGenerator.array_of(2);
        free_args[0] = function_context.coro_id;
        free_args[1] = function_context.handle;
        ptr memory = this.coro_intrinsic("llvm.coro.free", null, 0, free_args, 2, "coro.memory");
        ptr has_memory = LLVMBuildICmp(this.builder, LlvmConst.INT_NE, memory, LLVMConstNull(pointer_llvm), "coro.owned");
        LLVMBuildCondBr(this.builder, has_memory, release_block, function_context.suspend_block);

        LLVMPositionBuilderAtEnd(this.builder, release_block);
        this.frame_call("__djinn_coro_free", LLVMVoidTypeInContext(this.context), memory, 2);
        LLVMBuildBr(this.builder, function_context.suspend_block);

        LLVMPositionBuilderAtEnd(this.builder, function_context.suspend_block);
        ptr<ptr> end_args = CodeGenerator.array_of(3);
        end_args[0] = function_context.handle;
        end_args[1] = LLVMConstInt(i1_type, 0, 0);
        end_args[2] = this.none_token();
        this.coro_intrinsic("llvm.coro.end", null, 0, end_args, 3, "");
        LLVMBuildRet(this.builder, function_context.handle);
    }

    ptr task_handle(Node* operand) {
        Value* task = this.gen_expression(operand);
        return LLVMBuildExtractValue(this.builder, task.ref, 0, "task.handle");
    }

    unsafe void gen_spawn(Node* node) {
        ptr handle = this.task_handle(node.first());
        ptr pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
        ptr<ptr> params = CodeGenerator.array_of(1);
        ptr<ptr> args = CodeGenerator.array_of(1);
        params[0] = pointer_llvm;
        args[0] = handle;
        this.call_runtime("__djinn_spawn", LLVMVoidTypeInContext(this.context), params, args, 1);
    }

    unsafe Value* gen_await(Node* node) {
        return this.generate_await_with_propagation(node, true);
    }

    unsafe Value* generate_await_with_propagation(Node* node, bool propagate) {
        Node* operand = node.first();
        if (operand.kind() == NodeKind::CALL) {
            Node* callee_node = operand.first();
            i32 kind = callee_node.symbol_kind();
            if (kind == SymbolKind.FUNCTION || kind == SymbolKind.STATIC_METHOD) {
                FunctionInfo* callee = (FunctionInfo*)callee_node.symbol();
                if (callee.runs_sync) {
                    return this.generate_call_with_propagation(operand, propagate);
                }
            }
        }
        FunctionContext* function_context = this.function_context;
        u32 result_type = node.value_type();
        ptr handle = this.task_handle(node.first());
        ptr pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
        ptr void_llvm = LLVMVoidTypeInContext(this.context);
        ptr<ptr> params = CodeGenerator.array_of(2);
        ptr<ptr> args = CodeGenerator.array_of(2);
        params[0] = pointer_llvm;
        args[0] = handle;
        if (function_context.is_async) {
            params[1] = pointer_llvm;
            args[1] = function_context.handle;
            this.call_runtime("__djinn_await", void_llvm, params, args, 2);
            ptr ready = this.new_block("await.ready");
            this.suspend_switch(ready, "await.state");
            LLVMPositionBuilderAtEnd(this.builder, ready);
        } else {
            this.call_runtime("__djinn_event_loop_run", void_llvm, params, args, 1);
        }

        if (node.symbol_kind() == SymbolKind.FUNCTION) {
            FunctionInfo* view = (FunctionInfo*)node.symbol();
            this.prepare_result(view);
            return this.finish_await(handle, this.promise_address(handle, view.result_type), view, propagate);
        }

        mut ptr result = handle;
        if (!Types.is_void(result_type)) {
            ptr promise = this.promise_address(handle, this.llvm_type(result_type));
            result = LLVMBuildLoad2(this.builder, this.llvm_type(result_type), promise, "await.result");
        }
        this.destroy_task(handle);
        return Value.create(result, result_type);
    }

    // 'return await g(...)' between functions of one converted tail-recursive cycle: a guaranteed tail call, so the
    // recursion runs in constant stack. The analysis only groups functions with identical scalar signatures and
    // nothing to dispose, which is what makes 'musttail' valid; pending drops fall back to an ordinary call.
    unsafe bool generate_tail_await(Node* node) {
        FunctionInfo* current = this.current_function();
        Node* awaited = node.first();
        if (current.tail_group == 0 || Types.is_void(current.return_type) || awaited == null || awaited.kind() != NodeKind::AWAIT_EXPR) {
            return false;
        }
        Node* call = awaited.first();
        if (call.kind() != NodeKind::CALL) {
            return false;
        }
        Node* callee_node = call.first();
        i32 kind = callee_node.symbol_kind();
        if (kind != SymbolKind.FUNCTION && kind != SymbolKind.STATIC_METHOD) {
            return false;
        }
        FunctionInfo* callee = (FunctionInfo*)callee_node.symbol();
        FunctionContext* function_context = this.function_context;
        PointerList* drops = function_context.drops;
        if (callee.tail_group != current.tail_group || drops.length > 0) {
            return false;
        }
        this.tail_call = true;
        Value* produced = this.generate_call_with_propagation(call, false);
        ptr instruction = produced.ref;
        LLVMSetTailCallKind(instruction, LlvmConst.TAIL_CALL_MUST);
        ptr block = LLVMGetInsertBlock(this.builder);
        LLVMPositionBuilderBefore(this.builder, instruction);
        this.emit_frame_pop();
        LLVMPositionBuilderAtEnd(this.builder, block);
        LLVMBuildRet(this.builder, instruction);
        this.start_dead_block();
        return true;
    }

    unsafe ptr promise_address(ptr handle, ptr promise_llvm) {
        ptr<ptr> promise_args = CodeGenerator.array_of(3);
        promise_args[0] = handle;
        promise_args[1] = LLVMConstInt(LLVMIntTypeInContext(this.context, 32), LLVMABIAlignmentOfType(this.layout_data, promise_llvm), 0);
        promise_args[2] = LLVMConstInt(LLVMIntTypeInContext(this.context, 1), 0, 0);
        return this.coro_intrinsic("llvm.coro.promise", null, 0, promise_args, 3, "await.promise");
    }
}

impl CodeGenerator {
    unsafe Value* gen_intrinsic(Node* node) {
        i32 id = node.op();
        u32 void_result = Types.void_type();
        ptr<ptr> none = CodeGenerator.array_of(0);
        if (id == Intrinsic.ALLOCA) {
            u32 element = Types.element(node.value_type());
            ptr count = this.coerce(this.gen_expression(node.first()), Types.i64_type());
            mut ptr allocator = this.alloca_builder;
            if (LLVMIsConstant(count) == 0) {
                allocator = this.builder;
            }
            return Value.create(LLVMBuildArrayAlloca(allocator, this.llvm_type(element), count, "stack"), node.value_type());
        }
        if (id >= Intrinsic.FIELDS && id <= Intrinsic.INTERFACES) {
            return this.gen_member_query(id, (u32)(u64)node.symbol(), node.value_type());
        }
        if (id == Intrinsic.TYPEOF && node.symbol_kind() == SymbolKind.FUNCTION) {
            return Value.create(this.function_info_of((FunctionInfo*)node.symbol()), node.value_type());
        }
        if (id == Intrinsic.TYPEOF && node.symbol_kind() == SymbolKind.INTERFACE_NAME) {
            return Value.create(this.interface_info_of((InterfaceInfo*)node.symbol()), node.value_type());
        }
        if (id == Intrinsic.TYPEOF) {
            u32 described = (u32)(u64)node.symbol();
            return Value.create(this.type_info_of(described), node.value_type());
        }
        if (id == Intrinsic.DEBUGTRAP) {
            this.coro_intrinsic("llvm.debugtrap", null, 0, none, 0, "");
            return Value.create(null, void_result);
        }
        if (id == Intrinsic.TRAP) {
            this.coro_intrinsic("llvm.trap", null, 0, none, 0, "");
            return Value.create(null, void_result);
        }
        if (id == Intrinsic.UNREACHABLE) {
            this.emit_noreturn();
            return Value.create(null, void_result);
        }
        if (id == Intrinsic.PANIC) {
            return this.generate_panic(node);
        }
        if (id == Intrinsic.PREFETCH) {
            return this.generate_prefetch(node);
        }
        if (id == Intrinsic.EXPECT) {
            return this.generate_expect(node);
        }
        if (id == Intrinsic.BOUNDS_CHECK) {
            return this.generate_bounds_check(node);
        }
        if (id == Intrinsic.FLOAT_BITS) {
            return this.generate_float_bits(node);
        }
        if (Intrinsic.is_atomic(id)) {
            return this.generate_atomic(node, id);
        }
        ptr condition = this.to_condition(this.gen_expression(node.first()));
        ptr<ptr> args = CodeGenerator.array_of(2);
        args[0] = condition;
        if (id == Intrinsic.ASSUME) {
            this.coro_intrinsic("llvm.assume", null, 0, args, 1, "");
            return Value.create(null, void_result);
        }
        ptr flag = LLVMIntTypeInContext(this.context, 1);
        ptr<ptr> overload = CodeGenerator.array_of(1);
        overload[0] = flag;
        mut u64 expectation = 0;
        mut ptr<i8> label = "unlikely";
        if (id == Intrinsic.LIKELY) {
            expectation = 1;
            label = "likely";
        }
        args[1] = LLVMConstInt(flag, expectation, 0);
        ptr expected = this.coro_intrinsic("llvm.expect", overload, 1, args, 2, label);
        return Value.create(expected, Types.bool_type());
    }
}

impl CodeGenerator {
    unsafe Value* generate_bounds_check(Node* node) {
        u32 widest = Types.integer(64, false);
        ptr index = this.coerce(this.gen_expression(node.first()), widest);
        ptr length = this.coerce(this.gen_expression(node.second()), widest);
        if (this.proven(node, widest, RangeProof.INDEX_IN_BOUNDS)) {
            return Value.create(null, Types.void_type());
        }
        ptr outside = LLVMBuildICmp(this.builder, LlvmConst.INT_UGE, index, length, "bounds.outside");
        this.stop_when(outside, node, RuntimeErrors.INDEX_OUT_OF_RANGE);
        return Value.create(null, Types.void_type());
    }

    unsafe Value* generate_float_bits(Node* node) {
        ptr value = this.coerce(this.gen_expression(node.first()), node.first().value_type());
        ptr bits = LLVMBuildCast(this.builder, LlvmConst.OP_BITCAST, value, this.llvm_type(node.value_type()), "float.bits");
        return Value.create(bits, node.value_type());
    }

    unsafe Value* generate_atomic(Node* node, i32 id) {
        i32 order = LlvmConst.ATOMIC_SEQ_CST;
        if (id == Intrinsic.ATOMIC_FENCE) {
            LLVMBuildFence(this.builder, order, 0, "");
            return Value.create(null, Types.void_type());
        }
        u32 address_type = node.first().value_type();
        u32 element = Types.element(address_type);
        ptr address = this.coerce(this.gen_expression(node.first()), address_type);
        if (id == Intrinsic.ATOMIC_LOAD) {
            ptr loaded = LLVMBuildLoad2(this.builder, this.llvm_type(element), address, "atomic.load");
            LLVMSetOrdering(loaded, order);
            return Value.create(loaded, element);
        }
        ptr value = this.coerce(this.gen_expression(node.second()), element);
        if (id == Intrinsic.ATOMIC_STORE) {
            LLVMSetOrdering(LLVMBuildStore(this.builder, value, address), order);
            return Value.create(null, Types.void_type());
        }
        if (id == Intrinsic.ATOMIC_CAS) {
            ptr desired = this.coerce(this.gen_expression(node.third()), element);
            ptr exchanged = LLVMBuildAtomicCmpXchg(this.builder, address, value, desired, order, order, 0);
            return Value.create(LLVMBuildExtractValue(this.builder, exchanged, 1, "atomic.swapped"), Types.bool_type());
        }
        return Value.create(LLVMBuildAtomicRMW(this.builder, CodeGenerator.atomic_operation(id), address, value, order, 0), element);
    }

    static i32 atomic_operation(i32 id) {
        if (id == Intrinsic.ATOMIC_ADD) { return LlvmConst.ATOMIC_RMW_ADD; }
        if (id == Intrinsic.ATOMIC_SUB) { return LlvmConst.ATOMIC_RMW_SUB; }
        if (id == Intrinsic.ATOMIC_AND) { return LlvmConst.ATOMIC_RMW_AND; }
        if (id == Intrinsic.ATOMIC_OR) { return LlvmConst.ATOMIC_RMW_OR; }
        if (id == Intrinsic.ATOMIC_XOR) { return LlvmConst.ATOMIC_RMW_XOR; }
        return LlvmConst.ATOMIC_RMW_XCHG;
    }

    unsafe Value* generate_expect(Node* node) {
        u32 type = node.value_type();
        ptr value = this.coerce(this.gen_expression(node.first()), type);
        ptr expected = this.coerce(this.gen_expression(node.second()), type);
        ptr<ptr> args = CodeGenerator.array_of(2);
        args[0] = value;
        args[1] = expected;
        ptr<ptr> overload = CodeGenerator.array_of(1);
        overload[0] = this.llvm_type(type);
        ptr hinted = this.coro_intrinsic("llvm.expect", overload, 1, args, 2, "expect");
        return Value.create(hinted, type);
    }

    unsafe Value* generate_prefetch(Node* node) {
        ptr address = this.gen_expression(node.first()).ref;
        mut u64 access = 0;
        mut u64 locality = 3;
        if (node.second() != null) {
            access = this.literal_of(node.second());
            locality = this.literal_of(node.third());
        }
        this.build_prefetch(address, access, locality);
        return Value.create(null, Types.void_type());
    }

    unsafe void build_prefetch(ptr address, u64 access, u64 locality) {
        ptr count = LLVMIntTypeInContext(this.context, 32);
        ptr<ptr> args = CodeGenerator.array_of(4);
        args[0] = address;
        args[1] = LLVMConstInt(count, access, 0);
        args[2] = LLVMConstInt(count, locality, 0);
        args[3] = LLVMConstInt(count, 1, 0);
        ptr<ptr> overload = CodeGenerator.array_of(1);
        overload[0] = LLVMPointerTypeInContext(this.context, 0);
        this.coro_intrinsic("llvm.prefetch", overload, 1, args, 4, "");
    }

    unsafe u64 literal_of(Node* node) {
        return (u64)node.int_value();
    }
}

impl CodeGenerator {
    unsafe Value* gen_coro_primitive(Node* call, FunctionInfo* info) {
        FunctionContext* function_context = this.function_context;
        ptr<i8> name = info.name;
        i32 length = strlen(name);
        ptr none = (ptr)0;
        u32 void_result = Types.void_type();
        ptr<ptr> args = CodeGenerator.array_of(1);
        if (Strings.equals(name + length - 6, 6, "handle")) {
            if (!function_context.is_async) {
                this.error_code(call, DiagnosticErrors.CORO_OUTSIDE_ASYNC, "coro.handle is only valid inside an async function");
                return this.fallback();
            }
            return Value.create(function_context.handle, Types.byte_pointer());
        }
        if (Strings.equals(name + length - 7, 7, "suspend")) {
            if (!function_context.is_async) {
                this.error_code(call, DiagnosticErrors.CORO_OUTSIDE_ASYNC, "coro.suspend is only valid inside an async function");
                return this.fallback();
            }
            ptr ready = this.new_block("coro.resumed");
            this.suspend_switch(ready, "coro.state");
            LLVMPositionBuilderAtEnd(this.builder, ready);
            return Value.create(none, void_result);
        }
        Node* argument = call.child(0);
        args[0] = this.gen_expression(argument).ref;
        if (Strings.equals(name + length - 4, 4, "done")) {
            return Value.create(this.coro_intrinsic("llvm.coro.done", null, 0, args, 1, "coro.done"), Types.bool_type());
        }
        if (Strings.equals(name + length - 6, 6, "resume")) {
            this.coro_intrinsic("llvm.coro.resume", null, 0, args, 1, "");
            return Value.create(none, void_result);
        }
        this.coro_intrinsic("llvm.coro.destroy", null, 0, args, 1, "");
        return Value.create(none, void_result);
    }
}
