namespace djinnc;

struct ObjectWriter {
    static bool run_passes(void* module, void* machine, i8* pipeline) {
        void* options = LLVMCreatePassBuilderOptions();
        void* error = LLVMRunPasses(module, pipeline, machine, options);
        LLVMDisposePassBuilderOptions(options);
        if (error != null) {
            i8* message = LLVMGetErrorMessage(error);
            logger_error(Log.get(), "djinnc: optimization failed: %s", message);
            LLVMDisposeErrorMessage(message);
            return false;
        }
        return true;
    }

    public static bool emit(void* module, i8* path, bool optimize) {
        LLVMInitializeX86TargetInfo();
        LLVMInitializeX86Target();
        LLVMInitializeX86TargetMC();
        LLVMInitializeX86AsmPrinter();

        i8* triple = LLVMGetDefaultTargetTriple();
        void* target = null;
        i8* message = null;
        if (LLVMGetTargetFromTriple(triple, &target, &message) != 0) {
            logger_error(Log.get(), "djinnc: no LLVM target for '%s': %s", triple, message);
            return false;
        }

        mut i32 level = LlvmConst.CODEGEN_OPT_NONE;
        if (optimize) {
            level = LlvmConst.CODEGEN_OPT_DEFAULT;
        }
        mut i32 relocation = LlvmConst.RELOC_DEFAULT;
        if (!Linker.is_windows()) {
            relocation = LlvmConst.RELOC_PIC;
        }
        void* machine = LLVMCreateTargetMachine(target, triple, "generic", "", level, relocation, LlvmConst.CODE_MODEL_DEFAULT);
        if (machine == null) {
            logger_error(Log.get(), "djinnc: cannot create a target machine for '%s'", triple);
            return false;
        }

        mut i8* pipeline = "default<O0>";
        if (optimize) {
            pipeline = "default<O2>";
        }
        if (!ObjectWriter.run_passes(module, machine, pipeline)) {
            LLVMDisposeTargetMachine(machine);
            LLVMDisposeMessage(triple);
            return false;
        }

        i32 failed = LLVMTargetMachineEmitToFile(machine, module, path, LlvmConst.CODEGEN_OBJECT_FILE, &message);
        LLVMDisposeTargetMachine(machine);
        LLVMDisposeMessage(triple);
        if (failed != 0) {
            logger_error(Log.get(), "djinnc: cannot write '%s': %s", path, message);
            return false;
        }
        return true;
    }
}
