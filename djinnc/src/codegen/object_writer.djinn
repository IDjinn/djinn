namespace djinnc;

unsafe static mut ptr<i8> target_cpu = null;
unsafe static mut ptr<i8> target_features = null;

unsafe static mut i32 harden_code = 1;
unsafe static mut i32 sanitize_code = 0;

struct ObjectWriter {
    public static void set_target(ptr<i8> cpu, ptr<i8> features) {
        target_cpu = cpu;
        target_features = features;
    }

    // Ahead-of-time code gets stack protectors on desktop ELF targets. Not Android: bionic keeps the guard in a TLS slot,
    // which needs the stack-protector-guard module flags per architecture; without them lld rejects a reference to
    // __stack_chk_guard in a shared library. The Android runtime is still built with the protector by the NDK clang.
    public static void set_hardening(i32 level) {
        harden_code = level;
    }

    public static void set_sanitizers(i32 mask) {
        sanitize_code = mask;
    }

    // The sanitizer passes run after the optimizer, as clang does; the attribute makes the functions eligible.
    static unsafe ptr<i8> with_sanitizers(ptr module, ptr<i8> pipeline) {
        if ((sanitize_code & Sanitizer.ADDRESS) == 0 && (sanitize_code & Sanitizer.THREAD) == 0) {
            return pipeline;
        }
        ByteBuffer* text = ByteBuffer.create();
        text.append(pipeline);
        if ((sanitize_code & Sanitizer.ADDRESS) != 0) {
            ObjectWriter.add_function_attribute(module, "sanitize_address");
            text.append(",asan");
        } else {
            ObjectWriter.add_function_attribute(module, "sanitize_thread");
            text.append(",tsan-module,function(tsan)");
        }
        return text.cstr();
    }

    // 'sspstrong' on every defined function: a canary guards each frame that has an array or a taken address.
    static unsafe void add_flag(ptr module, ptr<i8> key, i32 value) {
        ptr i32_type = LLVMIntTypeInContext(LLVMGetModuleContext(module), 32);
        LLVMAddModuleFlag(module, 2, key, (u64)strlen(key), LLVMValueAsMetadata(LLVMConstInt(i32_type, (u64)value, 0)));
    }

    static unsafe void add_function_attribute(ptr module, ptr<i8> name) {
        u32 kind = LLVMGetEnumAttributeKindForName(name, (u64)strlen(name));
        ptr attribute = LLVMCreateEnumAttribute(LLVMGetModuleContext(module), kind, 0);
        for (mut ptr function = LLVMGetFirstFunction(module); function != null; function = LLVMGetNextFunction(function)) {
            if (LLVMIsDeclaration(function) == 0) {
                LLVMAddAttributeAtIndex(function, AttributeIndex.FUNCTION, attribute);
            }
        }
    }

    // Module flags LLVM turns into code: hardware control-flow markers (endbr64 / BTI+PAC) at standard, Control Flow
    // Guard tables and checks on Windows and ShadowCallStack on Android arm64 at strict.
    static unsafe void flow_hardening(ptr module) {
        if (harden_code < HardenLevel.STANDARD || Target.is_wasm()) {
            return;
        }
        if (Target.is_x64() && !Linker.is_windows()) {
            ObjectWriter.add_flag(module, "cf-protection-branch", 1);
        }
        if (Target.is_arm64() && !Linker.is_windows()) {
            ObjectWriter.add_flag(module, "branch-target-enforcement", 1);
            ObjectWriter.add_flag(module, "sign-return-address", 1);
            ObjectWriter.add_flag(module, "sign-return-address-all", 0);
            ObjectWriter.add_flag(module, "sign-return-address-with-bkey", 0);
        }
        if (harden_code == HardenLevel.STRICT) {
            if (Linker.is_windows() && !Target.is_android()) {
                ObjectWriter.add_flag(module, "cfguard", 2);
            }
            if (Target.is_android() && Target.is_arm64()) {
                ObjectWriter.add_function_attribute(module, "shadowcallstack");
            }
        }
    }

    static unsafe void hardening_attributes(ptr module) {
        ObjectWriter.flow_hardening(module);
        // standard (3): sspstrong; strict (4): sspreq, a canary in every function. Not on Windows (the canary calls
        // __security_cookie, which the JIT cannot resolve when it runs a library's procedural macros) and not on Android
        // (bionic's guard needs TLS module flags).
        if (harden_code < HardenLevel.STANDARD || Target.is_wasm() || Linker.is_windows() || Target.is_android()) {
            return;
        }
        mut ptr<i8> name = "sspstrong";
        if (harden_code == HardenLevel.STRICT) {
            name = "sspreq";
        }
        u32 kind = LLVMGetEnumAttributeKindForName(name, (u64)strlen(name));
        ptr attribute = LLVMCreateEnumAttribute(LLVMGetModuleContext(module), kind, 0);
        for (mut ptr function = LLVMGetFirstFunction(module); function != null; function = LLVMGetNextFunction(function)) {
            if (LLVMIsDeclaration(function) == 0) {
                LLVMAddAttributeAtIndex(function, AttributeIndex.FUNCTION, attribute);
            }
        }
    }

    static ptr<i8> cpu_name() {
        if (target_cpu == null) {
            return "generic";
        }
        if (Strings.same(target_cpu, "native")) {
            return LLVMGetHostCPUName();
        }
        return target_cpu;
    }

    public static ptr<i8> feature_list() {
        if (target_cpu != null && Strings.same(target_cpu, "native") && target_features == null) {
            return LLVMGetHostCPUFeatures();
        }
        mut ptr<i8> features = "";
        if (target_features != null) {
            features = target_features;
        }
        // ShadowCallStack keeps return addresses in x18 (strict hardening, Android arm64)
        if (harden_code == HardenLevel.STRICT && Target.is_android() && Target.is_arm64()) {
            ByteBuffer* joined = ByteBuffer.create();
            joined.append(features);
            if (strlen(features) > 0) {
                joined.append(",");
            }
            joined.append("+reserve-x18");
            return joined.cstr();
        }
        return features;
    }

    public static bool run_passes(ptr module, ptr machine, ptr<i8> pipeline) {
        ptr options = LLVMCreatePassBuilderOptions();
        ptr error = LLVMRunPasses(module, pipeline, machine, options);
        LLVMDisposePassBuilderOptions(options);
        if (error != null) {
            ptr<i8> message = LLVMGetErrorMessage(error);
            logger_error(Log.get(), "djinnc: optimization failed: %s", message);
            LLVMDisposeErrorMessage(message);
            return false;
        }
        return true;
    }

    static bool is_optimized(ptr<i8> level) {
        return !Strings.same(level, "O0");
    }

    static ptr<i8> pipeline_level(ptr<i8> level) {
        if (Strings.same(level, "Os") || Strings.same(level, "Oz")) {
            return "O2";
        }
        return level;
    }

    static unsafe void size_attributes(ptr module, ptr<i8> level) {
        if (!Strings.same(level, "Os") && !Strings.same(level, "Oz")) {
            return;
        }
        mut ptr<i8> name = "optsize";
        if (Strings.same(level, "Oz")) {
            name = "minsize";
        }
        u32 kind = LLVMGetEnumAttributeKindForName(name, (u64)strlen(name));
        ptr attribute = LLVMCreateEnumAttribute(LLVMGetModuleContext(module), kind, 0);
        for (mut ptr function = LLVMGetFirstFunction(module); function != null; function = LLVMGetNextFunction(function)) {
            if (LLVMIsDeclaration(function) == 0) {
                LLVMAddAttributeAtIndex(function, AttributeIndex.FUNCTION, attribute);
            }
        }
    }

    static ptr<i8> pipeline(ptr<i8> level, bool drop_dependencies, bool lower) {
        ByteBuffer* text = ByteBuffer.create();
        bool optimized = ObjectWriter.is_optimized(level);
        bool has_base = optimized || lower;
        if (optimized) {
            text.append("default<");
            text.append(ObjectWriter.pipeline_level(level));
            text.append(">");
        } else if (lower) {
            text.append("default<O0>");
        }
        if (drop_dependencies) {
            if (has_base) {
                text.append(",");
            }
            text.append("elim-avail-extern,globaldce");
        }
        return text.cstr();
    }

    static i32 codegen_level(ptr<i8> level) {
        if (Strings.same(level, "O1")) {
            return LlvmConst.CODEGEN_OPT_LESS;
        }
        if (Strings.same(level, "O3")) {
            return LlvmConst.CODEGEN_OPT_AGGRESSIVE;
        }
        if (ObjectWriter.is_optimized(level)) {
            return LlvmConst.CODEGEN_OPT_DEFAULT;
        }
        return LlvmConst.CODEGEN_OPT_NONE;
    }

    public static unsafe bool optimize_module(ptr module, ptr<i8> level, bool drop_dependencies) {
        ObjectWriter.size_attributes(module, level);
        return ObjectWriter.run_passes(module, (ptr)0, ObjectWriter.pipeline(level, drop_dependencies, false));
    }

    public static unsafe ptr jit_machine(ptr<i8> level) {
        return ObjectWriter.jit_machine_model(level, LlvmConst.CODE_MODEL_DEFAULT);
    }

    // The JIT (procedural macros, --run) always runs on the host.
    public static unsafe ptr jit_machine_model(ptr<i8> level, i32 model) {
        ptr<i8> triple = Target.host_triple();
        ptr target = (ptr)0;
        ptr<i8> message = (ptr<i8>)0;
        if (LLVMGetTargetFromTriple(triple, &target, &message) != 0) {
            logger_error(Log.get(), "djinnc: no LLVM target for '%s': %s", triple, message);
            return (ptr)0;
        }

        mut ptr<i8> cpu = ObjectWriter.cpu_name();
        mut ptr<i8> features = ObjectWriter.feature_list();
        if (target_cpu == null) {
            cpu = LLVMGetHostCPUName();
            features = LLVMGetHostCPUFeatures();
        }
        ptr machine = LLVMCreateTargetMachine(target, triple, cpu, features, ObjectWriter.codegen_level(level), LlvmConst.RELOC_DEFAULT, model);
        if (machine == null) {
            logger_error(Log.get(), "djinnc: cannot create a target machine for '%s'", triple);
        }
        return machine;
    }

    public static unsafe bool emit(ptr module, ptr<i8> path, ptr<i8> level, i32 kind, bool drop_dependencies) {
        if (!Target.initialize_backend()) {
            return false;
        }

        ptr<i8> triple = Target.triple();
        ptr target = (ptr)0;
        ptr<i8> message = (ptr<i8>)0;
        if (LLVMGetTargetFromTriple(triple, &target, &message) != 0) {
            logger_error(Log.get(), "djinnc: no LLVM target for '%s': %s", triple, message);
            return false;
        }

        i32 codegen = ObjectWriter.codegen_level(level);
        mut i32 relocation = LlvmConst.RELOC_DEFAULT;
        if (Target.is_wasm()) {
            relocation = LlvmConst.RELOC_STATIC;
        } else if (!Linker.is_windows() || Target.is_android()) {
            relocation = LlvmConst.RELOC_PIC;
        }
        ptr machine = LLVMCreateTargetMachine(target, triple, ObjectWriter.cpu_name(), ObjectWriter.feature_list(), codegen, relocation, LlvmConst.CODE_MODEL_DEFAULT);
        if (machine == null) {
            logger_error(Log.get(), "djinnc: cannot create a target machine for '%s'", triple);
            return false;
        }

        ObjectWriter.size_attributes(module, level);
        ObjectWriter.hardening_attributes(module);
        ptr<i8> pipeline = ObjectWriter.with_sanitizers(module, ObjectWriter.pipeline(level, drop_dependencies, true));
        if (!ObjectWriter.run_passes(module, machine, pipeline)) {
            LLVMDisposeTargetMachine(machine);
            return false;
        }

        i32 failed = LLVMTargetMachineEmitToFile(machine, module, path, kind, &message);
        LLVMDisposeTargetMachine(machine);
        if (failed != 0) {
            logger_error(Log.get(), "djinnc: cannot write '%s': %s", path, message);
            return false;
        }
        return true;
    }
}
