namespace djinnc;

struct ObjectWriter {
    public static bool run_passes(void* module, void* machine, i8* pipeline) {
        void* options = LLVMCreatePassBuilderOptions();
        void* error = LLVMRunPasses(module, pipeline, machine, options);
        LLVMDisposePassBuilderOptions(options);
        if (error != null) {
            i8* message = LLVMGetErrorMessage(error);
            logger_error(Log.get(), "djinnc: optimization failed: %s", message);
            LLVMDisposeErrorMessage(message);
            return false;
        }
        return true;
    }

    static bool is_optimized(i8* level) {
        return !Strings.same(level, "O0");
    }

    static i8* pipeline(i8* level, bool drop_dependencies) {
        ByteBuffer* text = ByteBuffer.create();
        bool optimized = ObjectWriter.is_optimized(level);
        if (optimized) {
            text.append("default<");
            text.append(level);
            text.append(">");
        } else if (!drop_dependencies) {
            text.append("default<O0>");
        }
        if (drop_dependencies) {
            if (optimized) {
                text.append(",");
            }
            text.append("elim-avail-extern,globaldce");
        }
        return text.cstr();
    }

    static i32 codegen_level(i8* level) {
        if (Strings.same(level, "O1")) {
            return LlvmConst.CODEGEN_OPT_LESS;
        }
        if (Strings.same(level, "O3")) {
            return LlvmConst.CODEGEN_OPT_AGGRESSIVE;
        }
        if (ObjectWriter.is_optimized(level)) {
            return LlvmConst.CODEGEN_OPT_DEFAULT;
        }
        return LlvmConst.CODEGEN_OPT_NONE;
    }

    public static bool optimize_module(void* module, i8* level, bool drop_dependencies) {
        return ObjectWriter.run_passes(module, (void*)0, ObjectWriter.pipeline(level, drop_dependencies));
    }

    public static bool emit(void* module, i8* path, i8* level, i32 kind, bool drop_dependencies) {
        if (!Target.initialize_backend()) {
            return false;
        }

        i8* triple = Target.triple();
        void* target = (void*)0;
        i8* message = (i8*)0;
        if (LLVMGetTargetFromTriple(triple, &target, &message) != 0) {
            logger_error(Log.get(), "djinnc: no LLVM target for '%s': %s", triple, message);
            return false;
        }

        i32 codegen = ObjectWriter.codegen_level(level);
        mut i32 relocation = LlvmConst.RELOC_DEFAULT;
        if (!Linker.is_windows()) {
            relocation = LlvmConst.RELOC_PIC;
        }
        void* machine = LLVMCreateTargetMachine(target, triple, "generic", "", codegen, relocation, LlvmConst.CODE_MODEL_DEFAULT);
        if (machine == null) {
            logger_error(Log.get(), "djinnc: cannot create a target machine for '%s'", triple);
            return false;
        }

        i8* pipeline = ObjectWriter.pipeline(level, drop_dependencies);
        if (!ObjectWriter.run_passes(module, machine, pipeline)) {
            LLVMDisposeTargetMachine(machine);
            return false;
        }

        i32 failed = LLVMTargetMachineEmitToFile(machine, module, path, kind, &message);
        LLVMDisposeTargetMachine(machine);
        if (failed != 0) {
            logger_error(Log.get(), "djinnc: cannot write '%s': %s", path, message);
            return false;
        }
        return true;
    }
}
