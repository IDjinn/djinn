namespace djinnc;

unsafe static mut ptr<i8> target_cpu = null;
unsafe static mut ptr<i8> target_features = null;

struct ObjectWriter {
    public static void set_target(ptr<i8> cpu, ptr<i8> features) {
        target_cpu = cpu;
        target_features = features;
    }

    static ptr<i8> cpu_name() {
        if (target_cpu == null) {
            return "generic";
        }
        if (Strings.same(target_cpu, "native")) {
            return LLVMGetHostCPUName();
        }
        return target_cpu;
    }

    static ptr<i8> feature_list() {
        if (target_cpu != null && Strings.same(target_cpu, "native") && target_features == null) {
            return LLVMGetHostCPUFeatures();
        }
        if (target_features == null) {
            return "";
        }
        return target_features;
    }

    public static bool run_passes(ptr module, ptr machine, ptr<i8> pipeline) {
        ptr options = LLVMCreatePassBuilderOptions();
        ptr error = LLVMRunPasses(module, pipeline, machine, options);
        LLVMDisposePassBuilderOptions(options);
        if (error != null) {
            ptr<i8> message = LLVMGetErrorMessage(error);
            logger_error(Log.get(), "djinnc: optimization failed: %s", message);
            LLVMDisposeErrorMessage(message);
            return false;
        }
        return true;
    }

    static bool is_optimized(ptr<i8> level) {
        return !Strings.same(level, "O0");
    }

    static ptr<i8> pipeline(ptr<i8> level, bool drop_dependencies, bool lower) {
        ByteBuffer* text = ByteBuffer.create();
        bool optimized = ObjectWriter.is_optimized(level);
        bool has_base = optimized || lower;
        if (optimized) {
            text.append("default<");
            text.append(level);
            text.append(">");
        } else if (lower) {
            text.append("default<O0>");
        }
        if (drop_dependencies) {
            if (has_base) {
                text.append(",");
            }
            text.append("elim-avail-extern,globaldce");
        }
        return text.cstr();
    }

    static i32 codegen_level(ptr<i8> level) {
        if (Strings.same(level, "O1")) {
            return LlvmConst.CODEGEN_OPT_LESS;
        }
        if (Strings.same(level, "O3")) {
            return LlvmConst.CODEGEN_OPT_AGGRESSIVE;
        }
        if (ObjectWriter.is_optimized(level)) {
            return LlvmConst.CODEGEN_OPT_DEFAULT;
        }
        return LlvmConst.CODEGEN_OPT_NONE;
    }

    public static bool optimize_module(ptr module, ptr<i8> level, bool drop_dependencies) {
        return ObjectWriter.run_passes(module, (ptr)0, ObjectWriter.pipeline(level, drop_dependencies, false));
    }

    public static bool emit(ptr module, ptr<i8> path, ptr<i8> level, i32 kind, bool drop_dependencies) {
        if (!Target.initialize_backend()) {
            return false;
        }

        ptr<i8> triple = Target.triple();
        ptr target = (ptr)0;
        ptr<i8> message = (ptr<i8>)0;
        if (LLVMGetTargetFromTriple(triple, &target, &message) != 0) {
            logger_error(Log.get(), "djinnc: no LLVM target for '%s': %s", triple, message);
            return false;
        }

        i32 codegen = ObjectWriter.codegen_level(level);
        mut i32 relocation = LlvmConst.RELOC_DEFAULT;
        if (!Linker.is_windows()) {
            relocation = LlvmConst.RELOC_PIC;
        }
        ptr machine = LLVMCreateTargetMachine(target, triple, ObjectWriter.cpu_name(), ObjectWriter.feature_list(), codegen, relocation, LlvmConst.CODE_MODEL_DEFAULT);
        if (machine == null) {
            logger_error(Log.get(), "djinnc: cannot create a target machine for '%s'", triple);
            return false;
        }

        ptr<i8> pipeline = ObjectWriter.pipeline(level, drop_dependencies, true);
        if (!ObjectWriter.run_passes(module, machine, pipeline)) {
            LLVMDisposeTargetMachine(machine);
            return false;
        }

        i32 failed = LLVMTargetMachineEmitToFile(machine, module, path, kind, &message);
        LLVMDisposeTargetMachine(machine);
        if (failed != 0) {
            logger_error(Log.get(), "djinnc: cannot write '%s': %s", path, message);
            return false;
        }
        return true;
    }
}
