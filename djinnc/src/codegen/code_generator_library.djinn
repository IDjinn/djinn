namespace djinnc;

impl CodeGenerator {
    public unsafe void exclude_dependencies(PointerList* files, bool show_async) {
        SymbolTable* symbols = this.symbols;
        PointerList* functions = symbols.functions;
        for (mut i32 i = 0; i < functions.length; i = i + 1) {
            FunctionInfo* info = (FunctionInfo*)functions.get(i);
            if (info.function == null || info.is_extern || info.is_template || info.node == null) {
                continue;
            }
            if (LLVMCountBasicBlocks(info.function) == 0) {
                continue;
            }
            Node* node = info.node;
            i32 name_length = (i32)strlen(info.name);
            i32 linkage = LLVMGetLinkage(info.function);
            // No dependency is bound to have the instances a library object uses, so it defines them itself.
            bool shared_instance = linkage == LlvmConst.LINKAGE_LINKONCE_ODR
                && (this.library_mode || Strings.starts_with(info.name, 0, name_length, "std::meta::") || Strings.starts_with(info.name, 0, name_length, "__closure"));
            if (files.contains_string(node.owner_file()) && !shared_instance) {
                LLVMSetLinkage(info.function, LlvmConst.LINKAGE_AVAILABLE_EXTERNALLY);
            }
        }
        PointerList* globals = symbols.globals;
        for (mut i32 i = 0; i < globals.length; i = i + 1) {
            LocalVariable* variable = (LocalVariable*)globals.get(i);
            Node* declaration = variable.node;
            if (variable.slot == null || declaration == null || !files.contains_string(declaration.owner_file())) {
                continue;
            }
            // A constant is internal to whoever declares it: a library object keeps its own copy.
            if (this.library_mode && LLVMGetLinkage(variable.slot) == LlvmConst.LINKAGE_INTERNAL) {
                continue;
            }
            LLVMSetInitializer(variable.slot, (ptr)0);
            LLVMSetLinkage(variable.slot, LlvmConst.LINKAGE_EXTERNAL);
            LLVMSetGlobalConstant(variable.slot, 0);
        }
        if (show_async) {
            return;
        }
        this.demote_named("__djinn_coro_resume");
        this.demote_named("__djinn_coro_destroy");
        this.demote_named("__djinn_coro_done");
        this.demote_named("__djinn_coro_promise");
        ptr user_main = LLVMGetNamedFunction(this.module, "__djinn_sync_main");
        if (user_main != null) {
            this.demote_named("main");
        }
    }

    // Library objects call into the core, which only the program defines: internalizing it before linking would drop
    // what they refer to.
    public unsafe void export_core() {
        PointerList* functions = this.symbols.functions;
        for (mut i32 i = 0; i < functions.length; i = i + 1) {
            FunctionInfo* info = (FunctionInfo*)functions.get(i);
            if (info.function == null || info.node == null) {
                continue;
            }
            Node* node = info.node;
            if (node.is_core_source()) {
                this.add_function_attribute(info.function, "djinn-export");
            }
        }
    }

    // A library object carries the instances its code uses and no others: an unused one would make whoever links the
    // object provide everything it refers to, which the JIT of a procedural macro cannot do.
    public unsafe bool drop_unused_definitions() {
        return ObjectWriter.run_passes(this.module, (ptr)0, "globaldce");
    }

    void make_linkonce(ptr global, ptr<i8> name) {
        LLVMSetLinkage(global, LlvmConst.LINKAGE_LINKONCE_ODR);
        ptr comdat = LLVMGetOrInsertComdat(this.module, name);
        LLVMSetComdatSelectionKind(comdat, 0);
        LLVMSetComdat(global, comdat);
    }

    void share_definition(FunctionInfo* info) {
        StructInfo* owner = info.owner;
        bool instance = info.bindings != null || info.const_kind != 0 || (owner != null && owner.origin != null);
        if (instance) {
            this.make_linkonce(info.function, info.name);
        }
    }

    void demote_named(ptr<i8> name) {
        ptr function = LLVMGetNamedFunction(this.module, name);
        if (function != null && LLVMCountBasicBlocks(function) != 0) {
            LLVMSetLinkage(function, LlvmConst.LINKAGE_AVAILABLE_EXTERNALLY);
        }
    }
}
