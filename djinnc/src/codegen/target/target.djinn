namespace djinnc;

unsafe static mut ptr target_triple = null;
unsafe static mut i32 target_bits = 0;
unsafe static mut i32 target_debug = 0;
unsafe static mut i64 target_static_cache = 31536000;

struct Target {
    public static void init(ptr<i8> triple) {
        ptr<i8> chosen = Target.normalize(triple);
        target_triple = (ptr)chosen;
        target_bits = Target.bits_for(chosen);
    }

    // The triple a --target value names: the host when there is none, js-unknown-web (JavaScript) for 'web' and
    // wasm32-unknown-unknown for 'wasm'.
    public static ptr<i8> normalize(ptr<i8> triple) {
        if (triple == null) {
            return Target.native_triple();
        }
        if (Strings.same(triple, "web") || Strings.same(triple, "js")) {
            return "js-unknown-web";
        }
        if (Strings.same(triple, "wasm")) {
            return "wasm32-unknown-unknown";
        }
        return triple;
    }

    // The machine djinnc runs on, which also runs procedural macros and the JIT whatever the target is.
    public static ptr<i8> host_triple() {
        return Target.native_triple();
    }

    // True when a --target value names another machine than the host.
    public static bool is_cross(ptr<i8> triple) {
        return triple != null && !Strings.same(Target.normalize(triple), Target.native_triple());
    }

    static ptr<i8> native_triple() {
        ptr<i8> triple = LLVMGetDefaultTargetTriple();
        return Strings.duplicate(triple, strlen(triple));
    }

    public static unsafe void set_debug(bool enabled) {
        target_debug = 0;
        if (enabled) {
            target_debug = 1;
        }
    }

    // Build.StaticCache: seconds a browser may keep a file named after its content (djinn.proj "static-cache:"); a year
    // when the project does not say.
    public static unsafe void set_static_cache(i64 seconds) {
        target_static_cache = seconds;
    }

    public static unsafe i64 static_cache() {
        return target_static_cache;
    }

    public static unsafe bool is_debug() {
        return target_debug != 0;
    }

    public static unsafe bool triple_mentions(ptr<i8> needle) {
        ptr<i8> triple = Target.triple();
        i32 length = strlen(triple);
        i32 wanted = strlen(needle);
        for (mut i32 i = 0; i + wanted <= length; i = i + 1) {
            if (Strings.equals(triple + i, wanted, needle)) {
                return true;
            }
        }
        return false;
    }

    public static bool is_windows() {
        return Target.triple_mentions("windows") || Target.triple_mentions("win32");
    }

    public static bool is_macos() {
        return Target.triple_mentions("darwin") || Target.triple_mentions("macos");
    }

    public static bool is_linux() {
        return Target.triple_mentions("linux");
    }

    public static bool is_android() {
        return Target.triple_mentions("android");
    }

    public static bool is_ios() {
        return Target.triple_mentions("-ios");
    }

    // The web platform: JavaScript (the 'web' target) or WebAssembly.
    public static bool is_web() {
        return Target.is_js() || Target.is_wasm();
    }

    // The 'web' target: the program is emitted as a JavaScript module instead of an object (codegen/js).
    public static bool is_js() {
        return Target.arch_is(Target.triple(), "js");
    }

    public static bool is_wasm() {
        ptr<i8> triple = Target.triple();
        return Target.arch_is(triple, "wasm32") || Target.arch_is(triple, "wasm64");
    }

    // The platform that selects 'name.<platform>.djinn' files and '[Platform(...)]' declarations.
    public static ptr<i8> platform_name() {
        if (Target.is_web()) {
            return "web";
        }
        if (Target.is_android()) {
            return "android";
        }
        if (Target.is_ios()) {
            return "ios";
        }
        if (Target.is_windows()) {
            return "windows";
        }
        if (Target.is_macos()) {
            return "macos";
        }
        if (Target.is_linux()) {
            return "linux";
        }
        return "other";
    }

    public static bool is_platform_word(ptr<i8> word, i32 length) {
        return Strings.equals(word, length, "windows") || Strings.equals(word, length, "linux") || Strings.equals(word, length, "macos")
            || Strings.equals(word, length, "android") || Strings.equals(word, length, "ios") || Strings.equals(word, length, "web")
            || Strings.equals(word, length, "desktop") || Strings.equals(word, length, "mobile") || Strings.equals(word, length, "native");
    }

    // 3 for the exact platform, 2 for its group (desktop, mobile), 1 for 'native' (anything but the web), 0 otherwise.
    public static i32 platform_rank(ptr<i8> word, i32 length) {
        ptr<i8> platform = Target.platform_name();
        if (Strings.equals(word, length, platform)) {
            return 3;
        }
        bool desktop = Strings.same(platform, "windows") || Strings.same(platform, "linux") || Strings.same(platform, "macos");
        bool mobile = Strings.same(platform, "android") || Strings.same(platform, "ios");
        if ((desktop && Strings.equals(word, length, "desktop")) || (mobile && Strings.equals(word, length, "mobile"))) {
            return 2;
        }
        if (!Target.is_web() && Strings.equals(word, length, "native")) {
            return 1;
        }
        return 0;
    }

    // A set of platforms as bits: windows 1, linux 2, macos 4, android 8, ios 16, web 32. The words desktop, mobile and
    // native name several at once. 0 for a word that is not a platform word.
    public static i32 platform_mask(ptr<i8> word, i32 length) {
        if (Strings.equals(word, length, "windows")) { return 1; }
        if (Strings.equals(word, length, "linux")) { return 2; }
        if (Strings.equals(word, length, "macos")) { return 4; }
        if (Strings.equals(word, length, "android")) { return 8; }
        if (Strings.equals(word, length, "ios")) { return 16; }
        if (Strings.equals(word, length, "web")) { return 32; }
        if (Strings.equals(word, length, "desktop")) { return 7; }
        if (Strings.equals(word, length, "mobile")) { return 24; }
        if (Strings.equals(word, length, "native")) { return 31; }
        return 0;
    }

    // The bit of the platform being built for (see platform_mask).
    public static i32 platform_bit() {
        ptr<i8> platform = Target.platform_name();
        return Target.platform_mask(platform, strlen(platform));
    }

    // "windows, linux": the platforms of a mask, for messages.
    public static void append_platforms(ByteBuffer* out, i32 mask) {
        mut bool first = true;
        for (mut i32 bit = 0; bit < 6; bit = bit + 1) {
            if ((mask & (1 << bit)) == 0) {
                continue;
            }
            if (!first) {
                out.append(", ");
            }
            first = false;
            if (bit == 0) { out.append("windows"); }
            if (bit == 1) { out.append("linux"); }
            if (bit == 2) { out.append("macos"); }
            if (bit == 3) { out.append("android"); }
            if (bit == 4) { out.append("ios"); }
            if (bit == 5) { out.append("web"); }
        }
    }

    public static bool is_embedded() {
        ptr<i8> triple = Target.triple();
        return Target.triple_mentions("-none") || Target.arch_is(triple, "msp430") || Target.arch_is(triple, "avr");
    }

    public static bool supports_threads() {
        ptr<i8> triple = Target.triple();
        return !Target.is_embedded() && !Target.is_web();
    }

    public static bool is_x64() {
        ptr<i8> triple = Target.triple();
        return Target.arch_is(triple, "x86_64") || Target.arch_is(triple, "amd64");
    }

    public static bool is_x86() {
        ptr<i8> triple = Target.triple();
        return Target.arch_is(triple, "i386") || Target.arch_is(triple, "i486") || Target.arch_is(triple, "i586")
            || Target.arch_is(triple, "i686") || Target.arch_is(triple, "x86");
    }

    public static bool is_arm64() {
        ptr<i8> triple = Target.triple();
        return Target.arch_is(triple, "aarch64") || Target.arch_is(triple, "arm64");
    }

    public static bool is_big_endian() {
        ptr<i8> triple = Target.triple();
        return Target.arch_is(triple, "s390x") || Target.arch_is(triple, "sparc") || Target.arch_is(triple, "sparcv9")
            || Target.arch_is(triple, "powerpc") || Target.arch_is(triple, "powerpc64") || Target.arch_is(triple, "mips")
            || Target.arch_is(triple, "mips64") || Target.arch_is(triple, "armeb") || Target.arch_is(triple, "aarch64_be");
    }

    public static bool is_win64_abi() {
        return Target.is_windows() && Target.is_x64();
    }

    public static bool is_sysv_abi() {
        return !Target.is_windows() && Target.is_x64();
    }

    public static unsafe bool has_cpu_feature(ptr<i8> name) {
        ptr<i8> list = ObjectWriter.feature_list();
        i32 length = strlen(list);
        i32 wanted = strlen(name);
        for (mut i32 i = 0; i + wanted < length; i = i + 1) {
            if (list[i] != 43 || (i > 0 && list[i - 1] != 44)) {
                continue;
            }
            if (Strings.equals(list + i + 1, wanted, name) && (list[i + 1 + wanted] == 0 || list[i + 1 + wanted] == 44)) {
                return true;
            }
        }
        return false;
    }

    public static bool has_x64_feature(ptr<i8> name) {
        return Target.is_x64() && Target.has_cpu_feature(name);
    }

    public static bool is_arm() {
        ptr<i8> triple = Target.triple();
        if (Target.arch_starts(triple, "arm64") || Target.arch_starts(triple, "aarch64")) {
            return false;
        }
        return Target.arch_starts(triple, "arm") || Target.arch_starts(triple, "thumb");
    }

    public static bool is_riscv64() {
        return Target.arch_is(Target.triple(), "riscv64");
    }

    public static bool is_riscv32() {
        return Target.arch_is(Target.triple(), "riscv32");
    }

    public static bool is_wasm32() {
        return Target.arch_is(Target.triple(), "wasm32");
    }

    public static ptr<i8> triple() {
        if (target_triple == null) {
            Target.init(null);
        }
        return (ptr<i8>)target_triple;
    }

    public static u32 pointer_bits() {
        if (target_triple == null) {
            Target.init(null);
        }
        return (u32)target_bits;
    }

    public static bool is_native() {
        return Strings.same(Target.triple(), Target.native_triple());
    }

    static unsafe i32 arch_length(ptr<i8> triple) {
        mut i32 length = 0;
        while (triple[length] != 0 && triple[length] != 45) {
            length = length + 1;
        }
        return length;
    }

    static bool arch_is(ptr<i8> triple, ptr<i8> name) {
        return Strings.equals(triple, Target.arch_length(triple), name);
    }

    static bool arch_starts(ptr<i8> triple, ptr<i8> prefix) {
        i32 wanted = strlen(prefix);
        return Target.arch_length(triple) >= wanted && Strings.equals(triple, wanted, prefix);
    }

    static unsafe bool arch_has_64(ptr<i8> triple) {
        i32 length = Target.arch_length(triple);
        for (mut i32 i = 0; i + 1 < length; i = i + 1) {
            if (triple[i] == 54 && triple[i + 1] == 52) {
                return true;
            }
        }
        return false;
    }

    public static unsafe i32 bits_for(ptr<i8> triple) {
        i32 length = strlen(triple);
        if (length >= 3 && Strings.equals(triple + length - 3, 3, "x32")) {
            return 32;
        }
        if (Target.arch_is(triple, "msp430") || Target.arch_is(triple, "avr")) {
            return 16;
        }
        if (Target.arch_is(triple, "arm64_32") || Target.arch_is(triple, "aarch64_32")) {
            return 32;
        }
        if (Target.arch_has_64(triple) || Target.arch_is(triple, "s390x") || Target.arch_is(triple, "amdgcn") || Target.arch_is(triple, "sparcv9")) {
            return 64;
        }
        return 32;
    }

    public static ptr<i8> backend_family() {
        ptr<i8> triple = Target.triple();
        if (Target.arch_is(triple, "x86_64") || Target.arch_is(triple, "amd64") || Target.arch_is(triple, "i386") || Target.arch_is(triple, "i486")
            || Target.arch_is(triple, "i586") || Target.arch_is(triple, "i686") || Target.arch_is(triple, "x86")) {
            return "x86";
        }
        if (Target.arch_is(triple, "aarch64") || Target.arch_is(triple, "arm64")) {
            return "aarch64";
        }
        if (Target.arch_is(triple, "wasm32")) {
            return "wasm";
        }
        if (Target.is_js()) {
            return "js";
        }
        return null;
    }

    // The data layout of the module. x86 keeps the layout the compiler always used (the backend fills in the rest);
    // wasm32 needs its own, with 32-bit pointers.
    public static ptr<i8> data_layout() {
        if (Target.is_wasm32()) {
            return "e-m:e-p:32:32-p10:8:8-p20:8:8-i64:64-i128:128-n32:64-S128-ni:1:10:20";
        }
        if (Strings.same(Target.backend_family(), "aarch64")) {
            // AArch64 ELF (Android, Linux)
            return "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32";
        }
        return "e-p:64:64-i64:64-i128:128-f64:64-n8:16:32:64";
    }

    // The x86 backend is always set up (the host runs procedural macros and the JIT); WebAssembly when it is the target.
    // The JavaScript target has no LLVM backend of its own.
    public static bool initialize_backend() {
        ptr<i8> family = Target.backend_family();
        if (family == null) {
            logger_error(Log.get(), "djinnc: '%s' can be compiled with --emit-ir but not to an object (supported: x86, x86_64, aarch64, wasm32)", Target.triple());
            return false;
        }
        LLVMInitializeX86TargetInfo();
        LLVMInitializeX86Target();
        LLVMInitializeX86TargetMC();
        LLVMInitializeX86AsmPrinter();
        if (Strings.same(family, "aarch64")) {
            LLVMInitializeAArch64TargetInfo();
            LLVMInitializeAArch64Target();
            LLVMInitializeAArch64TargetMC();
            LLVMInitializeAArch64AsmPrinter();
        }
        if (Strings.same(family, "wasm")) {
            LLVMInitializeWebAssemblyTargetInfo();
            LLVMInitializeWebAssemblyTarget();
            LLVMInitializeWebAssemblyTargetMC();
            LLVMInitializeWebAssemblyAsmPrinter();
        }
        return true;
    }
}
