namespace djinnc;

unsafe static mut ptr target_triple = null;
unsafe static mut i32 target_bits = 0;
unsafe static mut i32 target_debug = 0;

struct Target {
    public static void init(ptr<i8> triple) {
        mut ptr<i8> chosen = triple;
        if (chosen == null) {
            chosen = Target.native_triple();
        }
        target_triple = (ptr)chosen;
        target_bits = Target.bits_for(chosen);
    }

    static unsafe ptr<i8> native_triple() {
        ptr<i8> triple = LLVMGetDefaultTargetTriple();
        return Strings.duplicate(triple, strlen(triple));
    }

    public static unsafe void set_debug(bool enabled) {
        target_debug = 0;
        if (enabled) {
            target_debug = 1;
        }
    }

    public static unsafe bool is_debug() {
        return target_debug != 0;
    }

    public static unsafe bool triple_mentions(ptr<i8> needle) {
        ptr<i8> triple = Target.triple();
        i32 length = strlen(triple);
        i32 wanted = strlen(needle);
        for (mut i32 i = 0; i + wanted <= length; i = i + 1) {
            if (Strings.equals(triple + i, wanted, needle)) {
                return true;
            }
        }
        return false;
    }

    public static bool is_windows() {
        return Target.triple_mentions("windows") || Target.triple_mentions("win32");
    }

    public static bool is_macos() {
        return Target.triple_mentions("darwin") || Target.triple_mentions("macos");
    }

    public static bool is_linux() {
        return Target.triple_mentions("linux");
    }

    public static bool is_embedded() {
        ptr<i8> triple = Target.triple();
        return Target.triple_mentions("-none") || Target.arch_is(triple, "msp430") || Target.arch_is(triple, "avr");
    }

    public static bool supports_threads() {
        ptr<i8> triple = Target.triple();
        return !Target.is_embedded() && !Target.arch_is(triple, "wasm32") && !Target.arch_is(triple, "wasm64");
    }

    public static bool is_x64() {
        ptr<i8> triple = Target.triple();
        return Target.arch_is(triple, "x86_64") || Target.arch_is(triple, "amd64");
    }

    public static bool is_x86() {
        ptr<i8> triple = Target.triple();
        return Target.arch_is(triple, "i386") || Target.arch_is(triple, "i486") || Target.arch_is(triple, "i586")
            || Target.arch_is(triple, "i686") || Target.arch_is(triple, "x86");
    }

    public static bool is_arm64() {
        ptr<i8> triple = Target.triple();
        return Target.arch_is(triple, "aarch64") || Target.arch_is(triple, "arm64");
    }

    public static bool is_big_endian() {
        ptr<i8> triple = Target.triple();
        return Target.arch_is(triple, "s390x") || Target.arch_is(triple, "sparc") || Target.arch_is(triple, "sparcv9")
            || Target.arch_is(triple, "powerpc") || Target.arch_is(triple, "powerpc64") || Target.arch_is(triple, "mips")
            || Target.arch_is(triple, "mips64") || Target.arch_is(triple, "armeb") || Target.arch_is(triple, "aarch64_be");
    }

    public static bool is_win64_abi() {
        return Target.is_windows() && Target.is_x64();
    }

    public static bool is_sysv_abi() {
        return !Target.is_windows() && Target.is_x64();
    }

    public static unsafe bool has_cpu_feature(ptr<i8> name) {
        ptr<i8> list = ObjectWriter.feature_list();
        i32 length = strlen(list);
        i32 wanted = strlen(name);
        for (mut i32 i = 0; i + wanted < length; i = i + 1) {
            if (list[i] != 43 || (i > 0 && list[i - 1] != 44)) {
                continue;
            }
            if (Strings.equals(list + i + 1, wanted, name) && (list[i + 1 + wanted] == 0 || list[i + 1 + wanted] == 44)) {
                return true;
            }
        }
        return false;
    }

    public static bool has_x64_feature(ptr<i8> name) {
        return Target.is_x64() && Target.has_cpu_feature(name);
    }

    public static bool is_arm() {
        ptr<i8> triple = Target.triple();
        if (Target.arch_starts(triple, "arm64") || Target.arch_starts(triple, "aarch64")) {
            return false;
        }
        return Target.arch_starts(triple, "arm") || Target.arch_starts(triple, "thumb");
    }

    public static bool is_riscv64() {
        return Target.arch_is(Target.triple(), "riscv64");
    }

    public static bool is_riscv32() {
        return Target.arch_is(Target.triple(), "riscv32");
    }

    public static bool is_wasm32() {
        return Target.arch_is(Target.triple(), "wasm32");
    }

    public static ptr<i8> triple() {
        if (target_triple == null) {
            Target.init(null);
        }
        return (ptr<i8>)target_triple;
    }

    public static u32 pointer_bits() {
        if (target_triple == null) {
            Target.init(null);
        }
        return (u32)target_bits;
    }

    public static bool is_native() {
        return Strings.same(Target.triple(), Target.native_triple());
    }

    static unsafe i32 arch_length(ptr<i8> triple) {
        mut i32 length = 0;
        while (triple[length] != 0 && triple[length] != 45) {
            length = length + 1;
        }
        return length;
    }

    static bool arch_is(ptr<i8> triple, ptr<i8> name) {
        return Strings.equals(triple, Target.arch_length(triple), name);
    }

    static unsafe bool arch_starts(ptr<i8> triple, ptr<i8> prefix) {
        i32 wanted = strlen(prefix);
        return Target.arch_length(triple) >= wanted && Strings.equals(triple, wanted, prefix);
    }

    static unsafe bool arch_has_64(ptr<i8> triple) {
        i32 length = Target.arch_length(triple);
        for (mut i32 i = 0; i + 1 < length; i = i + 1) {
            if (triple[i] == 54 && triple[i + 1] == 52) {
                return true;
            }
        }
        return false;
    }

    public static unsafe i32 bits_for(ptr<i8> triple) {
        i32 length = strlen(triple);
        if (length >= 3 && Strings.equals(triple + length - 3, 3, "x32")) {
            return 32;
        }
        if (Target.arch_is(triple, "msp430") || Target.arch_is(triple, "avr")) {
            return 16;
        }
        if (Target.arch_is(triple, "arm64_32") || Target.arch_is(triple, "aarch64_32")) {
            return 32;
        }
        if (Target.arch_has_64(triple) || Target.arch_is(triple, "s390x") || Target.arch_is(triple, "amdgcn") || Target.arch_is(triple, "sparcv9")) {
            return 64;
        }
        return 32;
    }

    public static ptr<i8> backend_family() {
        ptr<i8> triple = Target.triple();
        if (Target.arch_is(triple, "x86_64") || Target.arch_is(triple, "amd64") || Target.arch_is(triple, "i386") || Target.arch_is(triple, "i486")
            || Target.arch_is(triple, "i586") || Target.arch_is(triple, "i686") || Target.arch_is(triple, "x86")) {
            return "x86";
        }
        return null;
    }

    public static unsafe bool initialize_backend() {
        ptr<i8> family = Target.backend_family();
        if (family == null) {
            logger_error(Log.get(), "djinnc: this djinnc was linked with the x86 LLVM backend only, so '%s' can be compiled with --emit-ir but not to an object", Target.triple());
            return false;
        }
        LLVMInitializeX86TargetInfo();
        LLVMInitializeX86Target();
        LLVMInitializeX86TargetMC();
        LLVMInitializeX86AsmPrinter();
        return true;
    }
}
