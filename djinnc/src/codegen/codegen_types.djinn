namespace djinnc;

impl CodeGenerator {
    void* llvm_type(u32 type) {
        i32 kind = Types.kind(type);
        if (kind == TypeKind.VOID) {
            return LLVMVoidTypeInContext(this.context);
        }
        if (kind == TypeKind.INTEGER) {
            return LLVMIntTypeInContext(this.context, Types.bits(type));
        }
        if (kind == TypeKind.FLOAT) {
            if (Types.bits(type) == 32) {
                return LLVMFloatTypeInContext(this.context);
            }
            return LLVMDoubleTypeInContext(this.context);
        }
        if (kind == TypeKind.POINTER) {
            return LLVMPointerTypeInContext(this.context, 0);
        }
        if (kind == TypeKind.NAMED) {
            StructInfo* info = this.struct_of(type);
            return info.llvm;
        }
        logger_error(Log.get(), "djinnc: type %d has no code generation", type);
        exit(1);
        return null;
    }

    StructInfo* struct_of(u32 type) {
        SymbolTable* symbols = this.symbols;
        return symbols.struct_at(Types.struct_index(type));
    }

    StructInfo* struct_behind(u32 type) {
        if (Types.is_pointer(type)) {
            return this.struct_of(Types.element(type));
        }
        return this.struct_of(type);
    }

    void declare_structs() {
        SymbolTable* symbols = this.symbols;
        PointerList* structs = symbols.structs;
        for (mut i32 i = 0; i < structs.length; i = i + 1) {
            StructInfo* info = (StructInfo*)structs.get(i);
            if (!info.is_template) {
                info.llvm = LLVMStructCreateNamed(this.context, info.name);
            }
        }
        for (mut i32 i = 0; i < structs.length; i = i + 1) {
            StructInfo* info = (StructInfo*)structs.get(i);
            if (!info.is_template) {
                this.define_struct(info);
            }
        }
    }

    void require_layout(u32 type, Node* at) {
        if (!Types.is_struct(type)) {
            return;
        }
        StructInfo* dependency = this.struct_of(type);
        if (dependency.is_template) {
            return;
        }
        if (dependency.layout_state == 1) {
            this.error(at, "recursive type has infinite size; hold it through a pointer");
            return;
        }
        this.define_struct(dependency);
    }

    void define_struct(StructInfo* info) {
        if (info.layout_state != 0) {
            return;
        }
        info.layout_state = 1;
        Node* declaration = info.node;
        if (info.has_payload) {
            mut u64 largest = 0;
            for (mut i32 v = 0; v < declaration.count(); v = v + 1) {
                Node* variant = declaration.child(v);
                for (mut i32 p = 0; p < variant.count(); p = p + 1) {
                    Node* payload = variant.child(p);
                    this.require_layout(payload.value_type(), declaration);
                }
                u64 size = this.payload_offset(variant, variant.count());
                if (size > largest) {
                    largest = size;
                }
            }
            void** layout = CodeGenerator.array_of(2);
            layout[0] = LLVMIntTypeInContext(this.context, 32);
            layout[1] = LLVMArrayType2(LLVMIntTypeInContext(this.context, 64), (largest + 7) / 8);
            LLVMStructSetBody(info.llvm, layout, 2, 0);
        } else {
            PointerList* fields = info.fields;
            for (mut i32 f = 0; f < fields.length; f = f + 1) {
                FieldInfo* field = (FieldInfo*)fields.get(f);
                this.require_layout(field.type, declaration);
            }
            void** types = CodeGenerator.array_of(fields.length);
            for (mut i32 f = 0; f < fields.length; f = f + 1) {
                FieldInfo* field = (FieldInfo*)fields.get(f);
                types[f] = this.llvm_type(field.type);
            }
            LLVMStructSetBody(info.llvm, types, (u32)fields.length, 0);
        }
        info.layout_state = 2;
    }

    u64 payload_offset(Node* variant, i32 index) {
        mut u64 offset = 0;
        for (mut i32 j = 0; j <= index && j < variant.count(); j = j + 1) {
            void* field_type = this.llvm_type(variant.child(j).value_type());
            u64 alignment = (u64)LLVMABIAlignmentOfType(this.layout_data, field_type);
            offset = (offset + alignment - 1) / alignment * alignment;
            if (j < index) {
                offset = offset + LLVMABISizeOfType(this.layout_data, field_type);
            }
        }
        return offset;
    }

    void* payload_address(void* enum_llvm, void* slot, Node* variant, i32 index) {
        void* area = LLVMBuildStructGEP2(this.builder, enum_llvm, slot, 1, "enum.area");
        void** offsets = CodeGenerator.array_of(1);
        offsets[0] = LLVMConstInt(LLVMIntTypeInContext(this.context, 64), this.payload_offset(variant, index), 0);
        return LLVMBuildGEP2(this.builder, LLVMIntTypeInContext(this.context, 8), area, offsets, 1, "enum.payload");
    }

    u32 symbols_core_type(i8* name) {
        SymbolTable* symbols = this.symbols;
        u32 atom = Ast.intern_base_name(name, (i32)strlen(name));
        StructInfo* info = symbols.find_struct(atom, atom, 0);
        if (info == null || info.is_template) {
            return 0;
        }
        return info.type_id;
    }
}
