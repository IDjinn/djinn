namespace djinnc;

struct DebugInfo {
    ptr context;
    ptr module;
    ptr builder;
    ptr ir_builder;
    i32 optimized;
    i32 finalized;
    ptr target_data;
    ptr unit;
    ptr scope;
    ptr file;
    ptr<i8> file_name;
    PointerList* file_names;
    PointerList* files;
    PointerList* type_list;
    U32Map* types;
    ByteBuffer* natvis;

    public static unsafe DebugInfo* create(ptr context, ptr module, ptr ir_builder, ptr<i8> first_file, bool optimized, bool dwarf) {
        DebugInfo* debug = (DebugInfo*)Memory.zalloc(sizeof(DebugInfo));
        debug.context = context;
        debug.module = module;
        debug.ir_builder = ir_builder;
        debug.file_name = first_file;
        if (optimized) {
            debug.optimized = 1;
        }
        debug.builder = LLVMCreateDIBuilder(module);
        debug.target_data = LLVMCreateTargetData("");
        debug.file_names = PointerList.create();
        debug.files = PointerList.create();
        debug.type_list = PointerList.create();
        debug.types = U32Map.create(Memory.arena(), 64);
        debug.natvis = ByteBuffer.create();

        ptr file = debug.file_for(first_file);
        ptr<i8> producer = "djinnc";
        debug.unit = LLVMDIBuilderCreateCompileUnit(debug.builder, 11, file, producer, (u64)strlen(producer), debug.optimized, "", 0, 0, "", 0, 1, 0, 0, 0, "", 0, "", 0);

        ptr i32_type = LLVMIntTypeInContext(context, 32);
        ptr version = LLVMValueAsMetadata(LLVMConstInt(i32_type, 3, 0));
        LLVMAddModuleFlag(module, 1, "Debug Info Version", 18, version);
        // CodeView is for Windows targets; an Android build made on Windows gets DWARF like any other Linux target
        if (Linker.is_windows() && !dwarf && !Target.is_android()) {
            LLVMAddModuleFlag(module, 1, "CodeView", 8, LLVMValueAsMetadata(LLVMConstInt(i32_type, 1, 0)));
        } else {
            LLVMAddModuleFlag(module, 1, "Dwarf Version", 13, LLVMValueAsMetadata(LLVMConstInt(i32_type, 4, 0)));
        }
        return debug;
    }

    ptr file_for(ptr<i8> name) {
        PointerList* names = this.file_names;
        PointerList* files = this.files;
        for (mut i32 i = 0; i < names.length; i = i + 1) {
            if (Strings.same((ptr<i8>)names.get(i), name)) {
                return files.get(i);
            }
        }
        ptr file = LLVMDIBuilderCreateFile(this.builder, name, (u64)strlen(name), "", 0);
        names.push((ptr)name);
        files.push(file);
        return file;
    }

    public unsafe ptr type_of(u32 type, CodeGenerator* gen) {
        if (Types.is_void(type)) {
            return null;
        }
        U32Map* cache = this.types;
        PointerList* list = this.type_list;
        i64 cached = cache.find(type);
        if (cached >= 0) {
            return list.get((i32)cached);
        }
        mut ptr result = (ptr)0;
        i32 kind = Types.kind(type);
        SymbolTable* symbols = gen.symbols;
        StructInfo* enumeration = symbols.enum_of_type(type);
        if (enumeration != null && !enumeration.has_payload) {
            result = this.enumeration_type(enumeration, gen);
        } else if (kind == TypeKind.INTEGER) {
            ByteBuffer* name = ByteBuffer.create();
            Types.describe(type, name);
            u32 bits = Types.bits(type);
            mut u32 encoding = 7;
            mut u64 storage = (u64)bits;
            if (bits == 1) {
                // a bool occupies a whole byte in memory; a 1 bit DI size makes debuggers print <Unable to read memory>
                encoding = 2;
                storage = 8;
            } else if (Types.is_signed(type)) {
                encoding = 5;
            }
            result = LLVMDIBuilderCreateBasicType(this.builder, name.cstr(), (u64)strlen(name.cstr()), storage, encoding, 0);
        } else if (kind == TypeKind.FLOAT) {
            ByteBuffer* name = ByteBuffer.create();
            Types.describe(type, name);
            result = LLVMDIBuilderCreateBasicType(this.builder, name.cstr(), (u64)strlen(name.cstr()), (u64)Types.bits(type), 4, 0);
        } else if (kind == TypeKind.POINTER) {
            ptr pointee = this.type_of(Types.element(type), gen);
            ptr address = LLVMDIBuilderCreatePointerType(this.builder, pointee, 64, 0, 0, "", 0);
            if (Types.is_void(Types.element(type))) {
                result = this.handle_type(address);
            } else {
                result = address;
            }
        } else {
            return this.struct_type(type, gen);
        }
        cache.put(type, (u32)list.length);
        list.push(result);
        return result;
    }

    // An untyped `ptr` is an opaque handle (OS handle, FFI cookie): a one-member struct lets djinn.natvis show it as [handle 0x...]
    unsafe ptr handle_type(ptr address) {
        ptr file = this.file_for(this.file_name);
        ptr<ptr> entries = CodeGenerator.array_of(1);
        entries[0] = LLVMDIBuilderCreateMemberType(this.builder, this.unit, "address", 7, file, 0, 64, 0, 0, 0, address);
        return LLVMDIBuilderCreateStructType(this.builder, this.unit, "handle", 6, file, 0, 64, 0, 0, null, entries, 1, 0, null, "", 0);
    }

    unsafe ptr enumeration_type(StructInfo* info, CodeGenerator* gen) {
        mut ptr file = this.file_for(this.file_name);
        mut u32 line = 0;
        if (info.node != null) {
            Node* declaration = info.node;
            file = this.file_for(declaration.file_name());
            line = (u32)declaration.line();
        }
        PointerList* constants = info.constants;
        ptr<ptr> entries = CodeGenerator.array_of(constants.length);
        for (mut i32 i = 0; i < constants.length; i = i + 1) {
            Node* member = (Node*)constants.get(i);
            Node* tag = member.first();
            AtomTable* atoms = Ast.atoms();
            ptr<i8> label = atoms.text(member.name());
            entries[i] = LLVMDIBuilderCreateEnumerator(this.builder, label, (u64)strlen(label), tag.int_value(), 0);
        }
        ptr underlying = this.type_of(Types.integer(32, true), gen);
        return LLVMDIBuilderCreateEnumerationType(this.builder, this.unit, info.name, (u64)strlen(info.name), file, line, 32, 0, entries, (u32)constants.length, underlying);
    }

    unsafe ptr struct_type(u32 type, CodeGenerator* gen) {
        U32Map* cache = this.types;
        PointerList* list = this.type_list;
        StructInfo* info = gen.struct_of(type);
        mut ptr file = this.file_for(this.file_name);
        mut u32 line = 0;
        if (info.node != null) {
            Node* declaration = info.node;
            file = this.file_for(declaration.file_name());
            line = (u32)declaration.line();
        }
        ptr placeholder = LLVMTemporaryMDNode(this.context, null, 0);
        u32 slot = (u32)list.length;
        cache.put(type, slot);
        list.push(placeholder);

        PointerList* members = PointerList.create();
        if (info.is_enum) {
            ptr tag_type = this.type_of(Types.integer(32, true), gen);
            members.push(LLVMDIBuilderCreateMemberType(this.builder, this.unit, "tag", 3, file, line, 32, 0, 0, 0, tag_type));
        } else {
            PointerList* fields = info.fields;
            for (mut i32 i = 0; i < fields.length; i = i + 1) {
                FieldInfo* field = (FieldInfo*)fields.get(i);
                ptr field_type = this.type_of(field.type, gen);
                u64 field_bits = LLVMABISizeOfType(this.target_data, gen.llvm_type(field.type)) * 8;
                u64 offset = LLVMOffsetOfElement(this.target_data, info.llvm, (u32)field.index) * 8;
                members.push(LLVMDIBuilderCreateMemberType(this.builder, this.unit, field.name, (u64)strlen(field.name), file, 0, field_bits, 0, offset, 0, field_type));
            }
        }
        if (!info.is_enum) {
            this.describe_struct(info, gen);
        }
        ptr<ptr> entries = CodeGenerator.array_of(members.length);
        for (mut i32 i = 0; i < members.length; i = i + 1) {
            entries[i] = members.get(i);
        }
        u64 size = LLVMABISizeOfType(this.target_data, info.llvm) * 8;
        ptr result = LLVMDIBuilderCreateStructType(this.builder, this.unit, info.name, (u64)strlen(info.name), file, line, size, 0, 0, null, entries, (u32)members.length, 0, null, "", 0);
        LLVMMetadataReplaceAllUsesWith(placeholder, result);
        ptr<ptr> raw = list.data;
        raw[slot] = result;
        return result;
    }

    // How a field is listed in the debugger: 0 value, 1 text, 2 reference to another object (grouped, hidden while null)
    unsafe i32 natvis_class(u32 type) {
        if (Types.is_pointer(type) && !Types.is_void(Types.element(type))) {
            u32 target = Types.element(type);
            if (Types.is_integer(target) && Types.bits(target) == 8) {
                return 1;
            }
            return 2;
        }
        return 0;
    }

    unsafe bool natvis_key(ptr<i8> name) {
        return Strings.same(name, "name") || Strings.same(name, "text") || Strings.same(name, "kind") || Strings.same(name, "type")
            || Strings.same(name, "id") || Strings.same(name, "length") || Strings.same(name, "count") || Strings.same(name, "value");
    }

    unsafe void natvis_text(ptr<i8> text) {
        ByteBuffer* out = this.natvis;
        i32 count = strlen(text);
        for (mut i32 i = 0; i < count; i = i + 1) {
            i32 c = (i32)*(text + i);
            if (c == 60) {
                out.append("&lt;");
            } else if (c == 62) {
                out.append("&gt;");
            } else if (c == 38) {
                out.append("&amp;");
            } else {
                out.append_byte(c);
            }
        }
    }

    // One natvis entry per struct: a one line summary of the identifying fields, values first, references grouped and hidden while null
    unsafe void describe_struct(StructInfo* info, CodeGenerator* gen) {
        PointerList* fields = info.fields;
        ptr<i8> label = info.name;
        bool is_array = label[0] == 97 && label[1] == 114 && label[2] == 114 && label[3] == 60;
        if (fields.length == 0 || is_array) {
            return;
        }
        ByteBuffer* out = this.natvis;
        out.append("  <Type Name=\"");
        this.natvis_text(info.name);
        out.append("\">\n");

        mut i32 shown = 0;
        mut i32 references = 0;
        for (mut i32 i = 0; i < fields.length; i = i + 1) {
            FieldInfo* field = (FieldInfo*)fields.get(i);
            i32 how = this.natvis_class(field.type);
            if (how == 2) {
                references = references + 1;
            } else if (shown < 3 && this.natvis_key(field.name)) {
                if (shown == 0) {
                    out.append("    <DisplayString>{{ ");
                } else {
                    out.append(", ");
                }
                this.natvis_text(field.name);
                out.append("={");
                this.natvis_text(field.name);
                out.append("}");
                shown = shown + 1;
            }
        }
        if (shown > 0) {
            out.append(" }}</DisplayString>\n");
        }
        out.append("    <Expand>\n");
        for (mut i32 i = 0; i < fields.length; i = i + 1) {
            FieldInfo* field = (FieldInfo*)fields.get(i);
            if (this.natvis_class(field.type) != 2) {
                out.append("      <Item Name=\"");
                this.natvis_text(field.name);
                out.append("\">");
                this.natvis_text(field.name);
                out.append("</Item>\n");
            }
        }
        if (references > 0) {
            out.append("      <Synthetic Name=\"[references]\"><Expand>\n");
            for (mut i32 i = 0; i < fields.length; i = i + 1) {
                FieldInfo* field = (FieldInfo*)fields.get(i);
                if (this.natvis_class(field.type) == 2) {
                    out.append("        <Item Name=\"");
                    this.natvis_text(field.name);
                    out.append("\" Condition=\"");
                    this.natvis_text(field.name);
                    out.append(" != 0\">");
                    this.natvis_text(field.name);
                    out.append("</Item>\n");
                }
            }
            out.append("      </Expand></Synthetic>\n");
        }
        out.append("    </Expand>\n  </Type>\n");
    }

    // The visualizers for the debugger (Visual Studio natvis), next to the program: generated from the structs the program uses
    public unsafe bool write_natvis(ptr<i8> path) {
        ByteBuffer* out = ByteBuffer.create();
        out.append("<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<AutoVisualizer xmlns=\"http://schemas.microsoft.com/vstudio/debugger/natvis/2010\">\n");
        out.append("  <Type Name=\"handle\">\n    <DisplayString Condition=\"address == 0\">[handle NULL]</DisplayString>\n    <DisplayString>[handle {(void*)address}]</DisplayString>\n    <Expand><Item Name=\"Address\">address</Item></Expand>\n  </Type>\n");
        out.append("  <Type Name=\"arr&lt;*&gt;\">\n    <DisplayString Condition=\"length == 0\">[0] {{}}</DisplayString>\n    <DisplayString>[{length}] {{ ...}}</DisplayString>\n");
        out.append("    <Expand>\n      <Item Name=\"[length]\">length</Item>\n      <Item Name=\"[data]\">(void*)data</Item>\n      <ArrayItems><Size>length</Size><ValuePointer>data</ValuePointer></ArrayItems>\n    </Expand>\n  </Type>\n");
        ByteBuffer* structs = this.natvis;
        out.append_slice(structs.data, structs.length);
        out.append("</AutoVisualizer>\n");
        return Files.write_bytes(path, out.data, out.length);
    }

    public ptr enter_block(Node* node) {
        ptr outer = this.scope;
        if (outer != null) {
            this.scope = LLVMDIBuilderCreateLexicalBlock(this.builder, outer, this.file, (u32)node.line(), (u32)node.column());
        }
        return outer;
    }

    public void leave_block(ptr outer) {
        this.scope = outer;
    }

    public unsafe void begin_function(FunctionInfo* info, Node* declaration, CodeGenerator* gen) {
        this.file_name = declaration.file_name();
        this.file = this.file_for(this.file_name);
        PointerList* signature = PointerList.create();
        signature.push(this.type_of(info.return_type, gen));
        IdList* params = info.param_types;
        for (mut i32 i = 0; i < params.length; i = i + 1) {
            signature.push(this.type_of(params.get(i), gen));
        }
        ptr<ptr> entries = CodeGenerator.array_of(signature.length);
        for (mut i32 i = 0; i < signature.length; i = i + 1) {
            entries[i] = signature.get(i);
        }
        ptr subroutine = LLVMDIBuilderCreateSubroutineType(this.builder, this.file, entries, (u32)signature.length, 0);
        u32 line = (u32)declaration.line();
        mut i32 display_length = strlen(info.name);
        for (mut i32 i = 0; i < display_length; i = i + 1) {
            if (info.name[i] == 36) {
                display_length = i;
                break;
            }
        }
        this.scope = LLVMDIBuilderCreateFunction(this.builder, this.file, info.name, (u64)display_length, info.name, (u64)strlen(info.name), this.file, line, subroutine, 0, 1, line, 0, this.optimized);
        LLVMSetSubprogram(info.function, this.scope);
        this.locate(declaration);
    }

    public void end_function() {
        this.scope = null;
        LLVMSetCurrentDebugLocation2(this.ir_builder, null);
    }

    public void locate(Node* node) {
        if (this.scope == null) {
            return;
        }
        ptr location = LLVMDIBuilderCreateDebugLocation(this.context, (u32)node.line(), (u32)node.column(), this.scope, null);
        LLVMSetCurrentDebugLocation2(this.ir_builder, location);
    }

    public unsafe void declare(ptr slot, ptr<i8> name, u32 type, Node* at, i32 argument, ptr block, CodeGenerator* gen) {
        ptr di_type = this.type_of(type, gen);
        u32 line = (u32)at.line();
        mut ptr variable = (ptr)0;
        if (argument > 0) {
            variable = LLVMDIBuilderCreateParameterVariable(this.builder, this.scope, name, (u64)strlen(name), (u32)argument, this.file, line, di_type, 1, 0);
        } else {
            variable = LLVMDIBuilderCreateAutoVariable(this.builder, this.scope, name, (u64)strlen(name), this.file, line, di_type, 1, 0, 0);
        }
        ptr expression = LLVMDIBuilderCreateExpression(this.builder, null, 0);
        ptr location = LLVMDIBuilderCreateDebugLocation(this.context, line, (u32)at.column(), this.scope, null);
        LLVMDIBuilderInsertDeclareRecordAtEnd(this.builder, slot, variable, expression, location, block);
    }

    public void declare_global(ptr global, ptr<i8> name, u32 type, Node* at, CodeGenerator* gen) {
        ptr file = this.file_for(at.file_name());
        ptr di_type = this.type_of(type, gen);
        ptr expression = LLVMDIBuilderCreateExpression(this.builder, null, 0);
        ptr variable = LLVMDIBuilderCreateGlobalVariableExpression(this.builder, this.unit, name, (u64)strlen(name), name, (u64)strlen(name), file, (u32)at.line(), di_type, 0, expression, null, 0);
        LLVMGlobalSetMetadata(global, 0, variable);
    }

    public void finalize() {
        if (this.finalized == 0) {
            LLVMDIBuilderFinalize(this.builder);
            this.finalized = 1;
        }
    }

    public unsafe void release() {
        this.finalize();
        LLVMDisposeDIBuilder(this.builder);
        LLVMDisposeTargetData(this.target_data);
        this.builder = (ptr)0;
        this.target_data = (ptr)0;
    }
}
