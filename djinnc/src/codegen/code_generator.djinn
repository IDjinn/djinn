namespace djinnc;

struct CodeGenerator {
    void* context;

    void* module;

    void* builder;

    void* alloca_builder;

    Diagnostics* diagnostics;

    SymbolTable* symbols;

    FunctionContext* function_context;

    DebugInfo* debug;

    void* layout_data;

    public static CodeGenerator* create(Diagnostics* diagnostics, i8* module_name) {
        CodeGenerator* gen = (CodeGenerator*)Memory.zalloc(sizeof(CodeGenerator));
        gen.context = LLVMContextCreate();
        gen.module = LLVMModuleCreateWithNameInContext(module_name, gen.context);
        gen.builder = LLVMCreateBuilderInContext(gen.context);
        gen.alloca_builder = LLVMCreateBuilderInContext(gen.context);
        gen.diagnostics = diagnostics;
        gen.symbols = SymbolTable.create(Memory.arena());
        gen.function_context = FunctionContext.create();
        gen.layout_data = LLVMCreateTargetData("e-p:64:64-i64:64-i128:128-f64:64-n8:16:32:64");
        LLVMSetTarget(gen.module, Target.triple());
        return gen;
    }

    public void enable_debug(i8* first_file, bool optimized) {
        this.debug = DebugInfo.create(this.context, this.module, this.builder, first_file, optimized);
    }

    void locate(Node* node) {
        if (this.debug != null) {
            DebugInfo* debug = this.debug;
            debug.locate(node);
        }
    }

    void declare_variable(void* slot, i8* name, u32 type, Node* at, i32 argument) {
        if (this.debug != null) {
            DebugInfo* debug = this.debug;
            debug.declare(slot, name, type, at, argument, LLVMGetInsertBlock(this.builder), this);
        }
    }

    public bool generate(Node* program) {
        SemanticAnalyzer* analyzer = SemanticAnalyzer.create(this.diagnostics, this.symbols);
        if (!analyzer.collect(program)) {
            return false;
        }
        TypeChecker* checker = TypeChecker.create(this.diagnostics, this.symbols);
        if (!checker.run()) {
            return false;
        }
        this.declare_structs();
        Diagnostics* layout_diagnostics = this.diagnostics;
        if (layout_diagnostics.failed()) {
            return false;
        }
        this.declare_functions();
        this.declare_globals();
        this.define_all();
        this.emit_entry_point();
        CoroWrappers.emit(this);
        if (this.debug != null) {
            DebugInfo* debug = this.debug;
            debug.finalize();
        }
        Diagnostics* diagnostics = this.diagnostics;
        if (diagnostics.failed()) {
            return false;
        }

        i8* message = (i8*)0;
        i32 invalid = LLVMVerifyModule(this.module, LlvmConst.VERIFY_RETURN_STATUS, &message);
        if (invalid != 0) {
            logger_error(Log.get(), "djinnc: LLVM module verification failed: %s", message);
            return false;
        }
        return true;
    }

    public bool write_ir(i8* path) {
        i8* message = (i8*)0;
        i32 failed = LLVMPrintModuleToFile(this.module, path, &message);
        if (failed != 0) {
            logger_error(Log.get(), "djinnc: cannot write '%s': %s", path, message);
            return false;
        }
        return true;
    }

    public bool write_object(i8* path, i8* level) {
        return ObjectWriter.emit(this.module, path, level, LlvmConst.CODEGEN_OBJECT_FILE, false);
    }

    public bool write_assembly(i8* path, i8* level, bool drop_dependencies) {
        return ObjectWriter.emit(this.module, path, level, LlvmConst.CODEGEN_ASSEMBLY_FILE, drop_dependencies);
    }

    public bool optimize_ir(i8* level, bool drop_dependencies) {
        return ObjectWriter.optimize_module(this.module, level, drop_dependencies);
    }

    void error(Node* at, i8* message) {
        Diagnostics* diagnostics = this.diagnostics;
        diagnostics.error_in(at.file_name(), at.line(), at.column(), message);
    }

    static void** array_of(i32 count) {
        return (void**)Memory.zalloc(((i64)count + 1) * 8);
    }

    static i8* base_name(i8* qualified) {
        i32 length = strlen(qualified);
        mut i32 last = 0;
        for (mut i32 i = 0; i + 1 < length; i = i + 1) {
            if (qualified[i] == 58 && qualified[i + 1] == 58) {
                last = i + 2;
            }
        }
        return qualified + last;
    }

    Value* fallback() {
        return Value.create(LLVMConstInt(LLVMIntTypeInContext(this.context, 32), 0, 0), Types.i32_type());
    }

    Value* gen_expression(Node* node) {
        i32 kind = node.kind;
        this.locate(node);
        u32 type = node.value_type();

        if (kind == NodeKind.INT_LITERAL) {
            if (Types.is_float(type)) {
                return Value.create(LLVMConstReal(this.llvm_type(type), (f64)node.int_value()), type);
            }
            return Value.create(LLVMConstInt(this.llvm_type(type), (u64)node.int_value(), 0), type);
        }
        if (kind == NodeKind.FLOAT_LITERAL) {
            return Value.create(LLVMConstReal(this.llvm_type(type), node.float_value()), type);
        }
        if (kind == NodeKind.FLOAT_CONST) {
            return Value.create(LLVMConstReal(this.llvm_type(type), ConstBits.to_float(node.int_value())), type);
        }
        if (kind == NodeKind.STRING_LITERAL) {
            void* text = LLVMBuildGlobalStringPtr(this.builder, node.text(), "str");
            if (Types.is_struct(type)) {
                return this.gen_text_value(node, text, type);
            }
            return Value.create(text, type);
        }
        if (kind == NodeKind.BOOL_LITERAL) {
            return Value.create(LLVMConstInt(this.llvm_type(type), (u64)node.int_value(), 0), type);
        }
        if (kind == NodeKind.NULL_LITERAL) {
            return Value.create(LLVMConstNull(this.llvm_type(type)), type);
        }
        if (kind == NodeKind.IDENTIFIER) {
            return this.gen_identifier(node);
        }
        if (kind == NodeKind.UNARY) {
            return this.gen_unary(node);
        }
        if (kind == NodeKind.BINARY) {
            return this.gen_binary(node);
        }
        if (kind == NodeKind.ASSIGN) {
            return this.gen_assign(node);
        }
        if (kind == NodeKind.CALL) {
            return this.gen_call(node);
        }
        if (kind == NodeKind.CAST) {
            Value* operand = this.gen_expression(node.first());
            return Value.create(this.coerce(operand, type), type);
        }
        if (kind == NodeKind.INDEX) {
            if (node.symbol_kind() == SymbolKind.INDEX_GET) {
                return this.gen_index_get(node);
            }
            return this.load_through(this.gen_address(node), type);
        }
        if (kind == NodeKind.SWITCH_EXPR) {
            return this.gen_switch_expression(node);
        }
        if (kind == NodeKind.STRUCT_INIT) {
            return this.gen_struct_init(node);
        }
        if (kind == NodeKind.ARRAY_LITERAL) {
            return this.gen_array_literal(node);
        }
        if (kind == NodeKind.NEW_EXPR) {
            return this.gen_new(node);
        }
        if (kind == NodeKind.INTERPOLATION) {
            return this.gen_interpolation(node);
        }
        if (kind == NodeKind.IS_EXPR) {
            return this.gen_is(node);
        }
        if (kind == NodeKind.AWAIT_EXPR) {
            return this.gen_await(node);
        }
        if (kind == NodeKind.LET_EXPR) {
            return this.gen_let(node);
        }
        if (kind == NodeKind.INTRINSIC) {
            return this.gen_sizeof(node);
        }
        if (kind == NodeKind.FIELD_ACCESS) {
            return this.gen_member(node);
        }

        this.error(node, "expression is not supported by code generation yet");
        return this.fallback();
    }
}
