namespace djinnc;

struct Value {
    void* ref;
    u32 type;

    public static Value* create(void* ref, u32 type) {
        Value* value = (Value*)Memory.zalloc(sizeof(Value));
        value.ref = ref;
        value.type = type;
        return value;
    }
}

struct CodeGenerator {
    void* context;
    void* module;
    void* builder;
    void* alloca_builder;
    Diagnostics* diagnostics;
    SymbolTable* symbols;
    FunctionContext* function_context;
    DebugInfo* debug;

    public static CodeGenerator* create(Diagnostics* diagnostics, i8* module_name) {
        CodeGenerator* gen = (CodeGenerator*)Memory.zalloc(sizeof(CodeGenerator));
        gen.context = LLVMContextCreate();
        gen.module = LLVMModuleCreateWithNameInContext(module_name, gen.context);
        gen.builder = LLVMCreateBuilderInContext(gen.context);
        gen.alloca_builder = LLVMCreateBuilderInContext(gen.context);
        gen.diagnostics = diagnostics;
        gen.symbols = SymbolTable.create(Memory.arena());
        gen.function_context = FunctionContext.create();
        i8* triple = LLVMGetDefaultTargetTriple();
        LLVMSetTarget(gen.module, triple);
        LLVMDisposeMessage(triple);
        return gen;
    }

    public void enable_debug(i8* first_file) {
        this.debug = DebugInfo.create(this.context, this.module, this.builder, first_file);
    }

    void locate(Node* node) {
        if (this.debug != null) {
            DebugInfo* debug = this.debug;
            debug.locate(node);
        }
    }

    void declare_variable(void* slot, i8* name, u32 type, Node* at, i32 argument) {
        if (this.debug != null) {
            DebugInfo* debug = this.debug;
            debug.declare(slot, name, type, at, argument, LLVMGetInsertBlock(this.builder), this);
        }
    }

    public bool generate(Node* program) {
        SemanticAnalyzer* analyzer = SemanticAnalyzer.create(this.diagnostics, this.symbols);
        if (!analyzer.collect(program)) {
            return false;
        }
        TypeChecker* checker = TypeChecker.create(this.diagnostics, this.symbols);
        if (!checker.run()) {
            return false;
        }
        this.declare_structs();
        this.declare_functions();
        this.declare_globals();
        this.define_all();
        this.emit_entry_point();
        CoroWrappers.emit(this);
        if (this.debug != null) {
            DebugInfo* debug = this.debug;
            debug.finalize();
        }
        Diagnostics* diagnostics = this.diagnostics;
        if (diagnostics.failed()) {
            return false;
        }

        i8* message = (i8*)0;
        i32 invalid = LLVMVerifyModule(this.module, LlvmConst.VERIFY_RETURN_STATUS, &message);
        if (invalid != 0) {
            logger_error(Log.get(), "djinnc: LLVM module verification failed: %s", message);
            return false;
        }
        return true;
    }

    public bool write_ir(i8* path) {
        i8* message = (i8*)0;
        i32 failed = LLVMPrintModuleToFile(this.module, path, &message);
        if (failed != 0) {
            logger_error(Log.get(), "djinnc: cannot write '%s': %s", path, message);
            return false;
        }
        return true;
    }

    public bool write_object(i8* path, bool optimize) {
        return ObjectWriter.emit(this.module, path, optimize);
    }

    void error(Node* at, i8* message) {
        Diagnostics* diagnostics = this.diagnostics;
        diagnostics.error_in(at.file_name(), at.line(), at.column(), message);
    }

    static void** array_of(i32 count) {
        return (void**)Memory.zalloc(((i64)count + 1) * 8);
    }

    static i8* base_name(i8* qualified) {
        i32 length = strlen(qualified);
        mut i32 last = 0;
        for (mut i32 i = 0; i + 1 < length; i = i + 1) {
            if (qualified[i] == 58 && qualified[i + 1] == 58) {
                last = i + 2;
            }
        }
        return qualified + last;
    }

    void* llvm_type(u32 type) {
        i32 kind = Types.kind(type);
        if (kind == TypeKind.VOID) {
            return LLVMVoidTypeInContext(this.context);
        }
        if (kind == TypeKind.INTEGER) {
            return LLVMIntTypeInContext(this.context, Types.bits(type));
        }
        if (kind == TypeKind.FLOAT) {
            if (Types.bits(type) == 32) {
                return LLVMFloatTypeInContext(this.context);
            }
            return LLVMDoubleTypeInContext(this.context);
        }
        if (kind == TypeKind.POINTER) {
            return LLVMPointerTypeInContext(this.context, 0);
        }
        if (kind == TypeKind.NAMED) {
            StructInfo* info = this.struct_of(type);
            return info.llvm;
        }
        logger_error(Log.get(), "djinnc: type %d has no code generation", type);
        exit(1);
        return (void*)0;
    }

    StructInfo* struct_of(u32 type) {
        SymbolTable* symbols = this.symbols;
        return symbols.struct_at(Types.struct_index(type));
    }

    StructInfo* struct_behind(u32 type) {
        if (Types.is_pointer(type)) {
            return this.struct_of(Types.element(type));
        }
        return this.struct_of(type);
    }

    void declare_structs() {
        SymbolTable* symbols = this.symbols;
        PointerList* structs = symbols.structs;
        for (mut i32 i = 0; i < structs.length; i = i + 1) {
            StructInfo* info = (StructInfo*)structs.get(i);
            if (!info.is_template) {
                info.llvm = LLVMStructCreateNamed(this.context, info.name);
            }
        }
        for (mut i32 i = 0; i < structs.length; i = i + 1) {
            StructInfo* info = (StructInfo*)structs.get(i);
            if (info.is_template) {
                continue;
            }
            if (info.has_payload) {
                i32 slots = info.slot_count + 1;
                void** layout = CodeGenerator.array_of(slots);
                layout[0] = LLVMIntTypeInContext(this.context, 32);
                for (mut i32 s = 1; s < slots; s = s + 1) {
                    layout[s] = LLVMIntTypeInContext(this.context, 64);
                }
                LLVMStructSetBody(info.llvm, layout, (u32)slots, 0);
                continue;
            }
            PointerList* fields = info.fields;
            void** types = CodeGenerator.array_of(fields.length);
            for (mut i32 f = 0; f < fields.length; f = f + 1) {
                FieldInfo* field = (FieldInfo*)fields.get(f);
                types[f] = this.llvm_type(field.type);
            }
            LLVMStructSetBody(info.llvm, types, (u32)fields.length, 0);
        }
    }

    void declare_functions() {
        SymbolTable* symbols = this.symbols;
        PointerList* functions = symbols.functions;
        for (mut i32 i = 0; i < functions.length; i = i + 1) {
            FunctionInfo* info = (FunctionInfo*)functions.get(i);
            if (info.is_template) {
                continue;
            }
            IdList* param_types = info.param_types;
            i32 count = param_types.length;
            void** params = CodeGenerator.array_of(count);
            for (mut i32 p = 0; p < count; p = p + 1) {
                params[p] = this.llvm_type(param_types.get(p));
            }

            void* return_type = this.llvm_type(info.return_type);
            mut i32 variadic = 0;
            if (info.is_variadic) {
                variadic = 1;
            }
            info.function_type = LLVMFunctionType(return_type, params, (u32)count, variadic);

            mut i8* symbol = info.name;
            if (!info.is_extern && info.owner == null && info.name_atom == Atoms.MAIN_ATOM) {
                symbol = "__djinn_sync_main";
            }
            info.function = LLVMAddFunction(this.module, symbol, info.function_type);
        }
    }

    void declare_globals() {
        SymbolTable* symbols = this.symbols;
        PointerList* globals = symbols.globals;
        for (mut i32 i = 0; i < globals.length; i = i + 1) {
            LocalVariable* variable = (LocalVariable*)globals.get(i);
            Node* declaration = variable.node;
            u32 type = variable.type;
            void* global = LLVMAddGlobal(this.module, this.llvm_type(type), variable.name);
            Value* initial = this.gen_expression(declaration.first());
            LLVMSetInitializer(global, this.coerce(initial, type));
            if (!variable.is_mutable) {
                LLVMSetGlobalConstant(global, 1);
            }
            variable.slot = global;
        }
    }

    void define_all() {
        SymbolTable* symbols = this.symbols;
        PointerList* functions = symbols.functions;
        for (mut i32 i = 0; i < functions.length; i = i + 1) {
            FunctionInfo* info = (FunctionInfo*)functions.get(i);
            if (!info.is_extern && !info.is_template) {
                this.define_function(info.node, info);
            }
        }
    }

    void define_function(Node* declaration, FunctionInfo* info) {
        FunctionContext* function_context = this.function_context;
        function_context.begin(info);
        if (this.debug != null) {
            DebugInfo* debug = this.debug;
            debug.begin_function(info, declaration, this);
        }

        void* entry = LLVMAppendBasicBlockInContext(this.context, info.function, "entry");
        void* body = LLVMAppendBasicBlockInContext(this.context, info.function, "body");
        LLVMPositionBuilderAtEnd(this.builder, entry);
        void* jump = LLVMBuildBr(this.builder, body);
        LLVMPositionBuilderBefore(this.alloca_builder, jump);
        LLVMPositionBuilderAtEnd(this.builder, body);

        mut i32 offset = 0;
        if (info.is_instance) {
            offset = 1;
            LocalVariable* receiver = info.this_variable;
            receiver.slot = this.create_slot(receiver.type, "this");
            LLVMBuildStore(this.builder, LLVMGetParam(info.function, 0), receiver.slot);
            this.declare_variable(receiver.slot, "this", receiver.type, declaration, 1);
        }
        for (mut i32 i = 0; i < declaration.count(); i = i + 1) {
            Node* parameter = declaration.child(i);
            LocalVariable* variable = (LocalVariable*)parameter.symbol();
            variable.slot = this.create_slot(variable.type, variable.name);
            LLVMBuildStore(this.builder, LLVMGetParam(info.function, (u32)(i + offset)), variable.slot);
            this.declare_variable(variable.slot, variable.name, variable.type, parameter, i + offset + 1);
        }

        this.gen_statement(declaration.first());

        if (!this.is_terminated()) {
            if (Types.is_void(info.return_type)) {
                LLVMBuildRetVoid(this.builder);
            } else {
                LLVMBuildUnreachable(this.builder);
            }
        }
        if (this.debug != null) {
            DebugInfo* debug = this.debug;
            debug.end_function();
        }
    }

    void* create_slot(u32 type, i8* name) {
        return LLVMBuildAlloca(this.alloca_builder, this.llvm_type(type), name);
    }

    FunctionInfo* current_function() {
        FunctionContext* function_context = this.function_context;
        return function_context.function;
    }

    bool is_terminated() {
        void* block = LLVMGetInsertBlock(this.builder);
        return LLVMGetBasicBlockTerminator(block) != null;
    }

    void* new_block(i8* name) {
        return LLVMAppendBasicBlockInContext(this.context, this.current_function().function, name);
    }

    void branch_if_open(void* target) {
        if (!this.is_terminated()) {
            LLVMBuildBr(this.builder, target);
        }
    }

    void start_dead_block() {
        void* dead = this.new_block("dead");
        LLVMPositionBuilderAtEnd(this.builder, dead);
    }

    void emit_entry_point() {
        SymbolTable* symbols = this.symbols;
        mut FunctionInfo* user = (FunctionInfo*)0;
        PointerList* functions = symbols.functions;
        for (mut i32 i = 0; i < functions.length; i = i + 1) {
            FunctionInfo* candidate = (FunctionInfo*)functions.get(i);
            if (candidate.name_atom == Atoms.MAIN_ATOM && candidate.owner == null && !candidate.is_extern) {
                user = candidate;
                break;
            }
        }
        if (user == null) {
            Diagnostics* diagnostics = this.diagnostics;
            diagnostics.error(1, 1, "no 'main' function defined");
            return;
        }

        void* i32_type = LLVMIntTypeInContext(this.context, 32);
        void* void_type = LLVMVoidTypeInContext(this.context);
        void** init_params = CodeGenerator.array_of(1);
        init_params[0] = i32_type;
        void* init_type = LLVMFunctionType(void_type, init_params, 1, 0);
        void* init_fn = LLVMAddFunction(this.module, "__djinn_runtime_init", init_type);
        void* shutdown_type = LLVMFunctionType(void_type, CodeGenerator.array_of(0), 0, 0);
        void* shutdown_fn = LLVMAddFunction(this.module, "__djinn_runtime_shutdown", shutdown_type);

        void* main_type = LLVMFunctionType(i32_type, CodeGenerator.array_of(0), 0, 0);
        void* main_fn = LLVMAddFunction(this.module, "main", main_type);
        void* entry = LLVMAppendBasicBlockInContext(this.context, main_fn, "entry");
        LLVMPositionBuilderAtEnd(this.builder, entry);

        void** init_args = CodeGenerator.array_of(1);
        init_args[0] = LLVMConstInt(i32_type, 4, 0);
        LLVMBuildCall2(this.builder, init_type, init_fn, init_args, 1, "");

        mut void* exit_code = LLVMConstInt(i32_type, 0, 0);
        if (Types.is_void(user.return_type)) {
            LLVMBuildCall2(this.builder, user.function_type, user.function, CodeGenerator.array_of(0), 0, "");
        } else {
            void* returned = LLVMBuildCall2(this.builder, user.function_type, user.function, CodeGenerator.array_of(0), 0, "exit");
            Value* wrapped = Value.create(returned, user.return_type);
            exit_code = this.coerce(wrapped, Types.i32_type());
        }

        LLVMBuildCall2(this.builder, shutdown_type, shutdown_fn, CodeGenerator.array_of(0), 0, "");
        LLVMBuildRet(this.builder, exit_code);
    }

    void* coerce(Value* source, u32 target) {
        u32 from = source.type;
        void* ref = source.ref;
        if (target == 0 || from == target) {
            return ref;
        }
        void* destination = this.llvm_type(target);

        if (Types.is_integer(from) && Types.is_integer(target)) {
            if (Types.bits(from) == Types.bits(target)) {
                return ref;
            }
            if (Types.bits(from) > Types.bits(target)) {
                return LLVMBuildCast(this.builder, LlvmConst.OP_TRUNC, ref, destination, "trunc");
            }
            if (Types.is_signed(from) && Types.bits(from) > 1) {
                return LLVMBuildCast(this.builder, LlvmConst.OP_SEXT, ref, destination, "sext");
            }
            return LLVMBuildCast(this.builder, LlvmConst.OP_ZEXT, ref, destination, "zext");
        }
        if (Types.is_integer(from) && Types.is_float(target)) {
            if (Types.is_signed(from)) {
                return LLVMBuildCast(this.builder, LlvmConst.OP_SITOFP, ref, destination, "sitofp");
            }
            return LLVMBuildCast(this.builder, LlvmConst.OP_UITOFP, ref, destination, "uitofp");
        }
        if (Types.is_float(from) && Types.is_integer(target)) {
            if (Types.is_signed(target)) {
                return LLVMBuildCast(this.builder, LlvmConst.OP_FPTOSI, ref, destination, "fptosi");
            }
            return LLVMBuildCast(this.builder, LlvmConst.OP_FPTOUI, ref, destination, "fptoui");
        }
        if (Types.is_float(from) && Types.is_float(target)) {
            if (Types.bits(from) == Types.bits(target)) {
                return ref;
            }
            if (Types.bits(from) < Types.bits(target)) {
                return LLVMBuildCast(this.builder, LlvmConst.OP_FPEXT, ref, destination, "fpext");
            }
            return LLVMBuildCast(this.builder, LlvmConst.OP_FPTRUNC, ref, destination, "fptrunc");
        }
        if (Types.is_integer(from) && Types.is_pointer(target)) {
            return LLVMBuildCast(this.builder, LlvmConst.OP_INTTOPTR, ref, destination, "inttoptr");
        }
        if (Types.is_pointer(from) && Types.is_integer(target)) {
            return LLVMBuildCast(this.builder, LlvmConst.OP_PTRTOINT, ref, destination, "ptrtoint");
        }
        return ref;
    }

    void* to_condition(Value* source) {
        u32 type = source.type;
        void* ref = source.ref;
        if (Types.is_integer(type) && Types.bits(type) == 1) {
            return ref;
        }
        void* zero = LLVMConstNull(LLVMTypeOf(ref));
        if (Types.is_float(type)) {
            return LLVMBuildFCmp(this.builder, LlvmConst.REAL_UNE, ref, zero, "tobool");
        }
        return LLVMBuildICmp(this.builder, LlvmConst.INT_NE, ref, zero, "tobool");
    }

    void gen_statement(Node* node) {
        i32 kind = node.kind;
        this.locate(node);

        if (kind == NodeKind.BLOCK) {
            for (mut i32 i = 0; i < node.count(); i = i + 1) {
                this.gen_statement(node.child(i));
            }
        } else if (kind == NodeKind.VAR_DECL) {
            this.gen_variable(node);
        } else if (kind == NodeKind.EXPR_STMT) {
            this.gen_expression(node.first());
        } else if (kind == NodeKind.RETURN) {
            this.gen_return(node);
        } else if (kind == NodeKind.IF) {
            this.gen_if(node);
        } else if (kind == NodeKind.WHILE) {
            this.gen_while(node);
        } else if (kind == NodeKind.DO_WHILE) {
            this.gen_do_while(node);
        } else if (kind == NodeKind.FOR) {
            this.gen_for(node);
        } else if (kind == NodeKind.SWITCH) {
            this.gen_switch(node);
        } else if (kind == NodeKind.BREAK) {
            FunctionContext* function_context = this.function_context;
            LLVMBuildBr(this.builder, function_context.break_block());
            this.start_dead_block();
        } else if (kind == NodeKind.CONTINUE) {
            FunctionContext* function_context = this.function_context;
            LLVMBuildBr(this.builder, function_context.continue_block());
            this.start_dead_block();
        } else {
            this.error(node, "statement is not supported by code generation yet");
        }
    }

    void gen_variable(Node* node) {
        LocalVariable* variable = (LocalVariable*)node.symbol();
        u32 declared = variable.type;
        variable.slot = this.create_slot(declared, variable.name);
        if (node.first() != null) {
            Value* initial = this.gen_expression(node.first());
            LLVMBuildStore(this.builder, this.coerce(initial, declared), variable.slot);
        } else {
            LLVMBuildStore(this.builder, LLVMConstNull(this.llvm_type(declared)), variable.slot);
        }
        this.declare_variable(variable.slot, variable.name, declared, node, 0);
    }

    void gen_return(Node* node) {
        if (node.first() == null) {
            LLVMBuildRetVoid(this.builder);
        } else {
            u32 expected = this.current_function().return_type;
            Value* returned = this.gen_expression(node.first());
            LLVMBuildRet(this.builder, this.coerce(returned, expected));
        }
        this.start_dead_block();
    }

    void gen_if(Node* node) {
        void* condition = this.to_condition(this.gen_expression(node.first()));
        void* then_block = this.new_block("if.then");
        void* end_block = this.new_block("if.end");
        mut void* else_block = end_block;
        if (node.third() != null) {
            else_block = this.new_block("if.else");
        }

        LLVMBuildCondBr(this.builder, condition, then_block, else_block);
        LLVMPositionBuilderAtEnd(this.builder, then_block);
        this.gen_statement(node.second());
        this.branch_if_open(end_block);

        if (node.third() != null) {
            LLVMPositionBuilderAtEnd(this.builder, else_block);
            this.gen_statement(node.third());
            this.branch_if_open(end_block);
        }
        LLVMPositionBuilderAtEnd(this.builder, end_block);
    }

    void gen_switch(Node* node) {
        Value* subject = this.gen_expression(node.first());
        u32 subject_type = subject.type;
        void* end_block = this.new_block("switch.end");
        mut void* default_block = end_block;
        PointerList* blocks = PointerList.create();
        PointerList* labels = PointerList.create();
        mut u32 case_count = 0;

        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* arm = node.child(i);
            if (arm.first() == null) {
                default_block = this.new_block("switch.default");
                blocks.push(default_block);
                labels.push((void*)0);
            } else {
                blocks.push(this.new_block("switch.case"));
                labels.push(this.coerce(this.gen_expression(arm.first()), subject_type));
                case_count = case_count + 1;
            }
        }

        void* dispatch = LLVMBuildSwitch(this.builder, subject.ref, default_block, case_count);
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            if (labels.get(i) != null) {
                LLVMAddCase(dispatch, labels.get(i), blocks.get(i));
            }
        }

        FunctionContext* function_context = this.function_context;
        mut void* continue_target = (void*)0;
        if (function_context.in_loop()) {
            continue_target = function_context.continue_block();
        }
        function_context.enter_loop(end_block, continue_target);
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* arm = node.child(i);
            LLVMPositionBuilderAtEnd(this.builder, blocks.get(i));
            for (mut i32 j = 0; j < arm.count(); j = j + 1) {
                this.gen_statement(arm.child(j));
            }
            this.branch_if_open(end_block);
        }
        function_context.leave_loop();
        LLVMPositionBuilderAtEnd(this.builder, end_block);
    }

    void gen_while(Node* node) {
        void* condition_block = this.new_block("while.cond");
        void* body_block = this.new_block("while.body");
        void* end_block = this.new_block("while.end");

        this.branch_if_open(condition_block);
        LLVMPositionBuilderAtEnd(this.builder, condition_block);
        void* condition = this.to_condition(this.gen_expression(node.first()));
        LLVMBuildCondBr(this.builder, condition, body_block, end_block);

        this.run_loop_body(node.second(), body_block, end_block, condition_block);
        this.branch_if_open(condition_block);
        LLVMPositionBuilderAtEnd(this.builder, end_block);
    }

    void gen_do_while(Node* node) {
        void* body_block = this.new_block("do.body");
        void* condition_block = this.new_block("do.cond");
        void* end_block = this.new_block("do.end");

        this.branch_if_open(body_block);
        this.run_loop_body(node.second(), body_block, end_block, condition_block);
        this.branch_if_open(condition_block);

        LLVMPositionBuilderAtEnd(this.builder, condition_block);
        void* condition = this.to_condition(this.gen_expression(node.first()));
        LLVMBuildCondBr(this.builder, condition, body_block, end_block);
        LLVMPositionBuilderAtEnd(this.builder, end_block);
    }

    void gen_for(Node* node) {
        if (node.first() != null) {
            this.gen_statement(node.first());
        }

        void* condition_block = this.new_block("for.cond");
        void* body_block = this.new_block("for.body");
        void* step_block = this.new_block("for.step");
        void* end_block = this.new_block("for.end");

        this.branch_if_open(condition_block);
        LLVMPositionBuilderAtEnd(this.builder, condition_block);
        if (node.second() != null) {
            void* condition = this.to_condition(this.gen_expression(node.second()));
            LLVMBuildCondBr(this.builder, condition, body_block, end_block);
        } else {
            LLVMBuildBr(this.builder, body_block);
        }

        this.run_loop_body(node.fourth(), body_block, end_block, step_block);
        this.branch_if_open(step_block);

        LLVMPositionBuilderAtEnd(this.builder, step_block);
        if (node.third() != null) {
            this.gen_expression(node.third());
        }
        LLVMBuildBr(this.builder, condition_block);
        LLVMPositionBuilderAtEnd(this.builder, end_block);
    }

    void run_loop_body(Node* body, void* body_block, void* break_block, void* continue_block) {
        FunctionContext* function_context = this.function_context;
        function_context.enter_loop(break_block, continue_block);
        LLVMPositionBuilderAtEnd(this.builder, body_block);
        this.gen_statement(body);
        function_context.leave_loop();
    }

    Value* fallback() {
        return Value.create(LLVMConstInt(LLVMIntTypeInContext(this.context, 32), 0, 0), Types.i32_type());
    }

    Value* gen_expression(Node* node) {
        i32 kind = node.kind;
        this.locate(node);
        u32 type = node.value_type();

        if (kind == NodeKind.INT_LITERAL) {
            if (Types.is_float(type)) {
                return Value.create(LLVMConstReal(this.llvm_type(type), (f64)node.int_value()), type);
            }
            return Value.create(LLVMConstInt(this.llvm_type(type), (u64)node.int_value(), 0), type);
        }
        if (kind == NodeKind.FLOAT_LITERAL) {
            return Value.create(LLVMConstReal(this.llvm_type(type), node.float_value()), type);
        }
        if (kind == NodeKind.STRING_LITERAL) {
            void* text = LLVMBuildGlobalStringPtr(this.builder, node.text(), "str");
            if (Types.is_struct(type)) {
                return this.gen_text_value(node, text, type);
            }
            return Value.create(text, type);
        }
        if (kind == NodeKind.BOOL_LITERAL) {
            return Value.create(LLVMConstInt(this.llvm_type(type), (u64)node.int_value(), 0), type);
        }
        if (kind == NodeKind.NULL_LITERAL) {
            return Value.create(LLVMConstNull(this.llvm_type(type)), type);
        }
        if (kind == NodeKind.IDENTIFIER) {
            return this.gen_identifier(node);
        }
        if (kind == NodeKind.UNARY) {
            return this.gen_unary(node);
        }
        if (kind == NodeKind.BINARY) {
            return this.gen_binary(node);
        }
        if (kind == NodeKind.ASSIGN) {
            return this.gen_assign(node);
        }
        if (kind == NodeKind.CALL) {
            return this.gen_call(node);
        }
        if (kind == NodeKind.CAST) {
            Value* operand = this.gen_expression(node.first());
            return Value.create(this.coerce(operand, type), type);
        }
        if (kind == NodeKind.INDEX) {
            return this.load_through(this.gen_address(node), type);
        }
        if (kind == NodeKind.SWITCH_EXPR) {
            return this.gen_switch_expression(node);
        }
        if (kind == NodeKind.STRUCT_INIT) {
            return this.gen_struct_init(node);
        }
        if (kind == NodeKind.ARRAY_LITERAL) {
            return this.gen_array_literal(node);
        }
        if (kind == NodeKind.NEW_EXPR) {
            return this.gen_new(node);
        }
        if (kind == NodeKind.INTRINSIC) {
            return this.gen_sizeof(node);
        }
        if (kind == NodeKind.FIELD_ACCESS) {
            return this.gen_member(node);
        }

        this.error(node, "expression is not supported by code generation yet");
        return this.fallback();
    }

    Value* gen_sizeof(Node* node) {
        u32 measured = (u32)(u64)node.symbol();
        u32 result = Types.i64_type();
        if (Types.is_struct(measured)) {
            StructInfo* info = this.struct_of(measured);
            return Value.create(LLVMSizeOf(info.llvm), result);
        }
        mut i64 bytes = 8;
        if (Types.is_integer(measured)) {
            bytes = (i64)((Types.bits(measured) + 7) / 8);
        } else if (Types.is_float(measured)) {
            bytes = (i64)(Types.bits(measured) / 8);
        }
        return Value.create(LLVMConstInt(this.llvm_type(result), (u64)bytes, 0), result);
    }

    bool is_struct_name(Node* node) {
        return node.kind == NodeKind.IDENTIFIER && node.symbol_kind() == SymbolKind.STRUCT_NAME;
    }

    bool is_addressable(Node* node) {
        i32 kind = node.kind;
        if (kind == NodeKind.IDENTIFIER || kind == NodeKind.INDEX) {
            return true;
        }
        if (kind == NodeKind.FIELD_ACCESS) {
            return !this.is_struct_name(node.first());
        }
        return kind == NodeKind.UNARY && node.op() == TokenKind.STAR;
    }

    void* struct_pointer(Node* base) {
        if (this.is_addressable(base)) {
            void* address = this.gen_address(base);
            u32 base_type = base.value_type();
            if (Types.is_pointer(base_type)) {
                return LLVMBuildLoad2(this.builder, this.llvm_type(base_type), address, "load");
            }
            return address;
        }
        Value* value = this.gen_expression(base);
        if (!Types.is_pointer(value.type)) {
            void* spill = this.create_slot(value.type, "receiver");
            LLVMBuildStore(this.builder, value.ref, spill);
            return spill;
        }
        return value.ref;
    }

    void* field_address(Node* node) {
        Node* base = node.first();
        void* pointer = this.struct_pointer(base);
        StructInfo* info = this.struct_behind(base.value_type());
        FieldInfo* field = (FieldInfo*)node.symbol();
        return LLVMBuildStructGEP2(this.builder, info.llvm, pointer, (u32)field.index, node.text());
    }

    Value* gen_member(Node* node) {
        Node* base = node.first();
        if (this.is_struct_name(base)) {
            Node* constant = (Node*)node.symbol();
            u32 declared = constant.value_type();
            Value* value = this.gen_expression(constant.first());
            return Value.create(this.coerce(value, declared), declared);
        }
        return this.load_through(this.field_address(node), node.value_type());
    }

    Value* gen_identifier(Node* node) {
        LocalVariable* variable = (LocalVariable*)node.symbol();
        void* loaded = LLVMBuildLoad2(this.builder, this.llvm_type(variable.type), variable.slot, node.text());
        return Value.create(loaded, variable.type);
    }

    Value* load_through(void* address, u32 type) {
        void* loaded = LLVMBuildLoad2(this.builder, this.llvm_type(type), address, "load");
        return Value.create(loaded, type);
    }

    void* gen_address(Node* node) {
        i32 kind = node.kind;

        if (kind == NodeKind.IDENTIFIER) {
            LocalVariable* variable = (LocalVariable*)node.symbol();
            return variable.slot;
        }

        if (kind == NodeKind.FIELD_ACCESS) {
            return this.field_address(node);
        }

        if (kind == NodeKind.INDEX) {
            mut Value* base = this.gen_expression(node.first());
            Value* index = this.gen_expression(node.second());
            if (Types.is_struct(base.type)) {
                base = Value.create(LLVMBuildExtractValue(this.builder, base.ref, 0, "array.data"), Types.pointer_to(node.value_type()));
            }
            void** indices = CodeGenerator.array_of(1);
            indices[0] = this.coerce(index, Types.i64_type());
            void* element_type = this.llvm_type(node.value_type());
            return LLVMBuildGEP2(this.builder, element_type, base.ref, indices, 1, "index");
        }

        Value* pointer = this.gen_expression(node.first());
        return pointer.ref;
    }

    Value* gen_unary(Node* node) {
        i32 op = node.op();

        if (op == TokenKind.AMPERSAND) {
            return Value.create(this.gen_address(node.first()), node.value_type());
        }
        if (op == TokenKind.STAR) {
            return this.load_through(this.gen_address(node), node.value_type());
        }

        Value* operand = this.gen_expression(node.first());
        u32 type = operand.type;
        if (op == TokenKind.MINUS) {
            if (Types.is_float(type)) {
                return Value.create(LLVMBuildFNeg(this.builder, operand.ref, "neg"), type);
            }
            return Value.create(LLVMBuildNeg(this.builder, operand.ref, "neg"), type);
        }
        if (op == TokenKind.TILDE) {
            return Value.create(LLVMBuildNot(this.builder, operand.ref, "not"), type);
        }
        void* condition = this.to_condition(operand);
        return Value.create(LLVMBuildNot(this.builder, condition, "lnot"), Types.bool_type());
    }

    Value* gen_assign(Node* node) {
        void* address = this.gen_address(node.first());
        u32 element = node.value_type();
        Value* value = this.gen_expression(node.second());
        void* stored = this.coerce(value, element);
        LLVMBuildStore(this.builder, stored, address);
        return Value.create(stored, element);
    }

    Value* gen_logical(Node* node) {
        bool is_and = node.op() == TokenKind.AND_AND;
        u32 flag = Types.bool_type();
        void* left = this.to_condition(this.gen_expression(node.first()));
        void* left_block = LLVMGetInsertBlock(this.builder);
        void* right_block = this.new_block("logic.rhs");
        void* end_block = this.new_block("logic.end");

        if (is_and) {
            LLVMBuildCondBr(this.builder, left, right_block, end_block);
        } else {
            LLVMBuildCondBr(this.builder, left, end_block, right_block);
        }

        LLVMPositionBuilderAtEnd(this.builder, right_block);
        void* right = this.to_condition(this.gen_expression(node.second()));
        void* right_end = LLVMGetInsertBlock(this.builder);
        LLVMBuildBr(this.builder, end_block);

        LLVMPositionBuilderAtEnd(this.builder, end_block);
        void* merged = LLVMBuildPhi(this.builder, this.llvm_type(flag), "logic");
        void** values = CodeGenerator.array_of(2);
        void** blocks = CodeGenerator.array_of(2);
        mut u64 shortcut = 1;
        if (is_and) {
            shortcut = 0;
        }
        values[0] = LLVMConstInt(this.llvm_type(flag), shortcut, 0);
        blocks[0] = left_block;
        values[1] = right;
        blocks[1] = right_end;
        LLVMAddIncoming(merged, values, blocks, 2);
        return Value.create(merged, flag);
    }

    Value* gen_coalesce(Node* node) {
        Value* left = this.gen_expression(node.first());
        u32 type = left.type;
        void* present = LLVMBuildICmp(this.builder, LlvmConst.INT_NE, left.ref, LLVMConstNull(LLVMTypeOf(left.ref)), "present");
        void* left_block = LLVMGetInsertBlock(this.builder);
        void* right_block = this.new_block("coalesce.rhs");
        void* end_block = this.new_block("coalesce.end");
        LLVMBuildCondBr(this.builder, present, end_block, right_block);

        LLVMPositionBuilderAtEnd(this.builder, right_block);
        void* right = this.coerce(this.gen_expression(node.second()), type);
        void* right_end = LLVMGetInsertBlock(this.builder);
        LLVMBuildBr(this.builder, end_block);

        LLVMPositionBuilderAtEnd(this.builder, end_block);
        void* merged = LLVMBuildPhi(this.builder, this.llvm_type(type), "coalesce");
        void** values = CodeGenerator.array_of(2);
        void** blocks = CodeGenerator.array_of(2);
        values[0] = left.ref;
        blocks[0] = left_block;
        values[1] = right;
        blocks[1] = right_end;
        LLVMAddIncoming(merged, values, blocks, 2);
        return Value.create(merged, type);
    }

    Value* gen_binary(Node* node) {
        i32 op = node.op();
        if (op == TokenKind.QUESTION_QUESTION) {
            return this.gen_coalesce(node);
        }
        if (op == TokenKind.AND_AND || op == TokenKind.OR_OR) {
            return this.gen_logical(node);
        }

        i32 symbol = node.symbol_kind();
        if (symbol == SymbolKind.OPERATOR || symbol == SymbolKind.NEGATED_OPERATOR) {
            return this.gen_operator_call(node, symbol == SymbolKind.NEGATED_OPERATOR);
        }

        Value* left = this.gen_expression(node.first());
        Value* right = this.gen_expression(node.second());

        if (Types.is_pointer(left.type) && Types.is_integer(right.type)
            && (op == TokenKind.PLUS || op == TokenKind.MINUS)) {
            return this.gen_pointer_offset(node, left, right);
        }

        u32 common = Types.common(left.type, right.type);
        void* lhs = this.coerce(left, common);
        void* rhs = this.coerce(right, common);

        if (TypeChecker.is_comparison(op)) {
            return this.gen_comparison(node, common, lhs, rhs);
        }
        return this.gen_arithmetic(node, common, lhs, rhs);
    }

    Value* gen_operator_call(Node* node, bool negated) {
        FunctionInfo* info = (FunctionInfo*)node.symbol();
        IdList* param_types = info.param_types;
        void** args = CodeGenerator.array_of(2);
        args[0] = this.coerce(this.gen_expression(node.first()), param_types.get(0));
        args[1] = this.coerce(this.gen_expression(node.second()), param_types.get(1));
        mut void* result = LLVMBuildCall2(this.builder, info.function_type, info.function, args, 2, "op");
        if (negated) {
            result = LLVMBuildNot(this.builder, result, "op.not");
        }
        return Value.create(result, info.return_type);
    }

    Value* gen_pointer_offset(Node* node, Value* pointer, Value* offset) {
        mut void* amount = this.coerce(offset, Types.i64_type());
        if (node.op() == TokenKind.MINUS) {
            amount = LLVMBuildNeg(this.builder, amount, "negoffset");
        }
        void** indices = CodeGenerator.array_of(1);
        indices[0] = amount;
        void* byte_type = LLVMIntTypeInContext(this.context, 8);
        void* moved = LLVMBuildGEP2(this.builder, byte_type, pointer.ref, indices, 1, "ptradd");
        return Value.create(moved, pointer.type);
    }

    Value* gen_comparison(Node* node, u32 common, void* lhs, void* rhs) {
        i32 op = node.op();
        u32 flag = Types.bool_type();

        if (Types.is_float(common)) {
            mut i32 real = LlvmConst.REAL_OEQ;
            if (op == TokenKind.BANG_EQUAL) { real = LlvmConst.REAL_UNE; }
            if (op == TokenKind.LESS) { real = LlvmConst.REAL_OLT; }
            if (op == TokenKind.LESS_EQUAL) { real = LlvmConst.REAL_OLE; }
            if (op == TokenKind.GREATER) { real = LlvmConst.REAL_OGT; }
            if (op == TokenKind.GREATER_EQUAL) { real = LlvmConst.REAL_OGE; }
            return Value.create(LLVMBuildFCmp(this.builder, real, lhs, rhs, "fcmp"), flag);
        }

        bool is_signed = Types.is_integer(common) && Types.is_signed(common);
        mut i32 predicate = LlvmConst.INT_EQ;
        if (op == TokenKind.BANG_EQUAL) { predicate = LlvmConst.INT_NE; }
        if (op == TokenKind.LESS) { predicate = LlvmConst.INT_ULT; }
        if (op == TokenKind.LESS_EQUAL) { predicate = LlvmConst.INT_ULE; }
        if (op == TokenKind.GREATER) { predicate = LlvmConst.INT_UGT; }
        if (op == TokenKind.GREATER_EQUAL) { predicate = LlvmConst.INT_UGE; }
        if (is_signed) {
            if (op == TokenKind.LESS) { predicate = LlvmConst.INT_SLT; }
            if (op == TokenKind.LESS_EQUAL) { predicate = LlvmConst.INT_SLE; }
            if (op == TokenKind.GREATER) { predicate = LlvmConst.INT_SGT; }
            if (op == TokenKind.GREATER_EQUAL) { predicate = LlvmConst.INT_SGE; }
        }
        return Value.create(LLVMBuildICmp(this.builder, predicate, lhs, rhs, "icmp"), flag);
    }

    Value* gen_arithmetic(Node* node, u32 common, void* lhs, void* rhs) {
        i32 op = node.op();
        void* builder = this.builder;

        if (Types.is_float(common)) {
            if (op == TokenKind.PLUS) { return Value.create(LLVMBuildFAdd(builder, lhs, rhs, "fadd"), common); }
            if (op == TokenKind.MINUS) { return Value.create(LLVMBuildFSub(builder, lhs, rhs, "fsub"), common); }
            if (op == TokenKind.STAR) { return Value.create(LLVMBuildFMul(builder, lhs, rhs, "fmul"), common); }
            if (op == TokenKind.SLASH) { return Value.create(LLVMBuildFDiv(builder, lhs, rhs, "fdiv"), common); }
            return Value.create(LLVMBuildFRem(builder, lhs, rhs, "frem"), common);
        }

        if (op == TokenKind.PLUS) { return Value.create(LLVMBuildAdd(builder, lhs, rhs, "add"), common); }
        if (op == TokenKind.MINUS) { return Value.create(LLVMBuildSub(builder, lhs, rhs, "sub"), common); }
        if (op == TokenKind.STAR) { return Value.create(LLVMBuildMul(builder, lhs, rhs, "mul"), common); }
        if (op == TokenKind.AMPERSAND) { return Value.create(LLVMBuildAnd(builder, lhs, rhs, "and"), common); }
        if (op == TokenKind.PIPE) { return Value.create(LLVMBuildOr(builder, lhs, rhs, "or"), common); }
        if (op == TokenKind.CARET) { return Value.create(LLVMBuildXor(builder, lhs, rhs, "xor"), common); }
        if (op == TokenKind.LESS_LESS) { return Value.create(LLVMBuildShl(builder, lhs, rhs, "shl"), common); }
        bool is_signed = Types.is_signed(common);
        if (op == TokenKind.SLASH) {
            if (is_signed) { return Value.create(LLVMBuildSDiv(builder, lhs, rhs, "sdiv"), common); }
            return Value.create(LLVMBuildUDiv(builder, lhs, rhs, "udiv"), common);
        }
        if (op == TokenKind.PERCENT) {
            if (is_signed) { return Value.create(LLVMBuildSRem(builder, lhs, rhs, "srem"), common); }
            return Value.create(LLVMBuildURem(builder, lhs, rhs, "urem"), common);
        }
        if (op == TokenKind.GREATER_GREATER) {
            if (is_signed) { return Value.create(LLVMBuildAShr(builder, lhs, rhs, "ashr"), common); }
            return Value.create(LLVMBuildLShr(builder, lhs, rhs, "lshr"), common);
        }

        this.error(node, "binary operator is not supported by code generation yet");
        return Value.create(lhs, common);
    }

    Value* promote_variadic(Value* argument) {
        u32 type = argument.type;
        if (Types.is_integer(type) && Types.bits(type) < 32) {
            u32 wide = Types.integer(32, Types.is_signed(type));
            return Value.create(this.coerce(argument, wide), wide);
        }
        if (Types.is_float(type) && Types.bits(type) < 64) {
            u32 wide = Types.floating(64);
            return Value.create(this.coerce(argument, wide), wide);
        }
        return argument;
    }

    Value* gen_enum_construct(Node* node, Node* variant, u32 enum_type) {
        void* llvm = this.llvm_type(enum_type);
        void* slot = this.create_slot(enum_type, "enum.value");
        void* tag_address = LLVMBuildStructGEP2(this.builder, llvm, slot, 0, "enum.tag");
        Node* tag_value = variant.first();
        void* tag = LLVMConstInt(LLVMIntTypeInContext(this.context, 32), (u64)tag_value.int_value(), 0);
        LLVMBuildStore(this.builder, tag, tag_address);
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* payload = variant.child(i);
            Value* argument = this.gen_expression(node.child(i));
            void* address = LLVMBuildStructGEP2(this.builder, llvm, slot, (u32)(i + 1), "enum.payload");
            LLVMBuildStore(this.builder, this.coerce(argument, payload.value_type()), address);
        }
        return Value.create(LLVMBuildLoad2(this.builder, llvm, slot, "enum.loaded"), enum_type);
    }

    void call_constructor(Node* node, void* target, FunctionInfo* constructor) {
        if (constructor == null) {
            return;
        }
        IdList* param_types = constructor.param_types;
        void** args = CodeGenerator.array_of(node.count() + 1);
        args[0] = target;
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Value* argument = this.gen_expression(node.child(i));
            args[i + 1] = this.coerce(argument, param_types.get(i + 1));
        }
        LLVMBuildCall2(this.builder, constructor.function_type, constructor.function, args, (u32)(node.count() + 1), "");
    }

    Value* gen_new(Node* node) {
        u32 pointer_type = node.value_type();
        StructInfo* info = this.struct_of(Types.element(pointer_type));
        void* i64_type = LLVMIntTypeInContext(this.context, 64);
        void* pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
        void** params = CodeGenerator.array_of(1);
        params[0] = i64_type;
        void* allocator_type = LLVMFunctionType(pointer_llvm, params, 1, 0);
        mut void* allocator = LLVMGetNamedFunction(this.module, "__djinn_malloc");
        if (allocator == null) {
            allocator = LLVMAddFunction(this.module, "__djinn_malloc", allocator_type);
        }
        void** args = CodeGenerator.array_of(1);
        args[0] = LLVMSizeOf(info.llvm);
        void* memory = LLVMBuildCall2(this.builder, allocator_type, allocator, args, 1, "new");
        this.call_constructor(node, memory, (FunctionInfo*)node.symbol());
        return Value.create(memory, pointer_type);
    }

    Value* gen_text_value(Node* node, void* text, u32 type) {
        StructInfo* info = this.struct_of(type);
        PointerList* fields = info.fields;
        FieldInfo* length_field = (FieldInfo*)fields.get(1);
        void* llvm = this.llvm_type(type);
        void* slot = this.create_slot(type, "text");
        void* data_address = LLVMBuildStructGEP2(this.builder, llvm, slot, 0, "text.data");
        LLVMBuildStore(this.builder, text, data_address);
        void* length_address = LLVMBuildStructGEP2(this.builder, llvm, slot, 1, "text.length");
        Value* length = Value.create(LLVMConstInt(LLVMIntTypeInContext(this.context, 64), (u64)strlen(node.text()), 0), Types.i64_type());
        LLVMBuildStore(this.builder, this.coerce(length, length_field.type), length_address);
        return Value.create(LLVMBuildLoad2(this.builder, llvm, slot, "text.loaded"), type);
    }

    Value* gen_array_literal(Node* node) {
        u32 type = node.value_type();
        StructInfo* info = this.struct_of(type);
        IdList* arguments = info.type_args;
        u32 element = arguments.get(0);
        void* element_llvm = this.llvm_type(element);
        PointerList* fields = info.fields;
        FieldInfo* length_field = (FieldInfo*)fields.get(1);
        void* i64_type = LLVMIntTypeInContext(this.context, 64);
        void* pointer_llvm = LLVMPointerTypeInContext(this.context, 0);
        void** params = CodeGenerator.array_of(1);
        params[0] = i64_type;
        void* allocator_type = LLVMFunctionType(pointer_llvm, params, 1, 0);
        mut void* allocator = LLVMGetNamedFunction(this.module, "__djinn_malloc");
        if (allocator == null) {
            allocator = LLVMAddFunction(this.module, "__djinn_malloc", allocator_type);
        }
        void** args = CodeGenerator.array_of(1);
        args[0] = LLVMBuildMul(this.builder, LLVMSizeOf(element_llvm), LLVMConstInt(i64_type, (u64)node.count(), 0), "array.size");
        void* memory = LLVMBuildCall2(this.builder, allocator_type, allocator, args, 1, "array.new");
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Value* item = this.gen_expression(node.child(i));
            void** indices = CodeGenerator.array_of(1);
            indices[0] = LLVMConstInt(i64_type, (u64)i, 0);
            void* address = LLVMBuildGEP2(this.builder, element_llvm, memory, indices, 1, "array.item");
            LLVMBuildStore(this.builder, this.coerce(item, element), address);
        }
        void* llvm = this.llvm_type(type);
        void* slot = this.create_slot(type, "array");
        void* data_address = LLVMBuildStructGEP2(this.builder, llvm, slot, 0, "array.data.ptr");
        LLVMBuildStore(this.builder, memory, data_address);
        void* length_address = LLVMBuildStructGEP2(this.builder, llvm, slot, 1, "array.length.ptr");
        Value* length = Value.create(LLVMConstInt(i64_type, (u64)node.count(), 0), Types.i64_type());
        LLVMBuildStore(this.builder, this.coerce(length, length_field.type), length_address);
        return Value.create(LLVMBuildLoad2(this.builder, llvm, slot, "array.loaded"), type);
    }

    Value* gen_struct_init(Node* node) {
        u32 type = node.value_type();
        void* llvm = this.llvm_type(type);
        void* slot = this.create_slot(type, "init");
        LLVMBuildStore(this.builder, LLVMConstNull(llvm), slot);
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* init = node.child(i);
            FieldInfo* field = (FieldInfo*)init.symbol();
            Value* value = this.gen_expression(init.first());
            void* address = LLVMBuildStructGEP2(this.builder, llvm, slot, (u32)field.index, "init.field");
            LLVMBuildStore(this.builder, this.coerce(value, field.type), address);
        }
        return Value.create(LLVMBuildLoad2(this.builder, llvm, slot, "init.loaded"), type);
    }

    Value* gen_switch_expression(Node* node) {
        SymbolTable* symbols = this.symbols;
        Node* subject_node = node.first();
        Value* subject = this.gen_expression(subject_node);
        u32 subject_type = subject.type;
        StructInfo* owner = symbols.enum_of_type(subject_type);
        u32 result_type = node.value_type();

        mut void* tag = subject.ref;
        mut void* spill = (void*)0;
        void* enum_llvm = this.llvm_type(subject_type);
        if (Types.is_struct(subject_type)) {
            spill = this.create_slot(subject_type, "match.subject");
            LLVMBuildStore(this.builder, subject.ref, spill);
            void* tag_address = LLVMBuildStructGEP2(this.builder, enum_llvm, spill, 0, "match.tag.ptr");
            tag = LLVMBuildLoad2(this.builder, LLVMIntTypeInContext(this.context, 32), tag_address, "match.tag");
        }

        void* result_slot = this.create_slot(result_type, "match.result");
        void* end_block = this.new_block("match.end");
        PointerList* blocks = PointerList.create();
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            blocks.push(this.new_block("match.arm"));
        }
        void* dispatch = LLVMBuildSwitch(this.builder, tag, blocks.get(node.count() - 1), (u32)node.count());
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* case_arm = node.child(i);
            Node* variant = (Node*)case_arm.symbol();
            Node* tag_value = variant.first();
            void* label = LLVMConstInt(LLVMIntTypeInContext(this.context, 32), (u64)tag_value.int_value(), 0);
            LLVMAddCase(dispatch, label, blocks.get(i));
        }

        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* arm = node.child(i);
            LLVMPositionBuilderAtEnd(this.builder, blocks.get(i));
            for (mut i32 b = 0; b < arm.count(); b = b + 1) {
                Node* binding = arm.child(b);
                LocalVariable* variable = (LocalVariable*)binding.symbol();
                variable.slot = this.create_slot(variable.type, variable.name);
                void* address = LLVMBuildStructGEP2(this.builder, enum_llvm, spill, (u32)(b + 1), "match.payload");
                void* loaded = LLVMBuildLoad2(this.builder, this.llvm_type(variable.type), address, "match.bound");
                LLVMBuildStore(this.builder, loaded, variable.slot);
            }
            Value* produced = this.gen_expression(arm.first());
            LLVMBuildStore(this.builder, this.coerce(produced, result_type), result_slot);
            this.branch_if_open(end_block);
        }
        LLVMPositionBuilderAtEnd(this.builder, end_block);
        return Value.create(LLVMBuildLoad2(this.builder, this.llvm_type(result_type), result_slot, "match.value"), result_type);
    }

    Value* gen_call(Node* node) {
        Node* callee = node.first();
        if (callee.symbol_kind() == SymbolKind.CONSTANT) {
            Node* variant = (Node*)callee.symbol();
            u32 declared = variant.value_type();
            if (Types.is_struct(declared)) {
                return this.gen_enum_construct(node, variant, declared);
            }
            Value* tag = this.gen_expression(variant.first());
            return Value.create(this.coerce(tag, declared), declared);
        }
        if (callee.symbol_kind() == SymbolKind.CONSTRUCTOR) {
            u32 constructed = node.value_type();
            void* slot = this.create_slot(constructed, "ctor");
            LLVMBuildStore(this.builder, LLVMConstNull(this.llvm_type(constructed)), slot);
            this.call_constructor(node, slot, (FunctionInfo*)callee.symbol());
            return Value.create(LLVMBuildLoad2(this.builder, this.llvm_type(constructed), slot, "ctor.loaded"), constructed);
        }
        FunctionInfo* info = (FunctionInfo*)callee.symbol();
        mut void* receiver = (void*)0;
        mut i32 offset = 0;

        if (callee.symbol_kind() == SymbolKind.INSTANCE_METHOD) {
            StructInfo* receiver_owner = info.owner;
            if (receiver_owner.is_enum) {
                Value* enum_value = this.gen_expression(callee.first());
                receiver = enum_value.ref;
                if (Types.is_pointer(enum_value.type)) {
                    receiver = LLVMBuildLoad2(this.builder, this.llvm_type(receiver_owner.type_id), enum_value.ref, "enum.load");
                }
            } else {
                receiver = this.struct_pointer(callee.first());
            }
            offset = 1;
        }

        IdList* param_types = info.param_types;
        i32 fixed = param_types.length;
        i32 given = node.count() + offset;

        void** args = CodeGenerator.array_of(given);
        if (offset == 1) {
            args[0] = receiver;
        }
        for (mut i32 i = offset; i < given; i = i + 1) {
            Node* argument_node = node.child(i - offset);
            if (i < fixed) {
                Value* argument = this.gen_expression(argument_node);
                args[i] = this.coerce(argument, param_types.get(i));
            } else {
                Value* extra = this.promote_variadic(this.gen_expression(argument_node));
                args[i] = extra.ref;
            }
        }

        mut i8* label = "call";
        if (Types.is_void(info.return_type)) {
            label = "";
        }
        void* result = LLVMBuildCall2(this.builder, info.function_type, info.function, args, (u32)given, label);
        return Value.create(result, info.return_type);
    }
}
