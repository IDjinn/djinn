namespace djinnc;

unsafe static mut i32 contract_project_mode = 0;

struct ContractMode {
    const i32 CHECK = 0;
    const i32 OBSERVE = 1;
    const i32 IGNORE = 2;
    const i32 UNKNOWN = -1;

    public static i32 parse(ptr<i8> text) {
        if (Strings.same(text, "check")) { return ContractMode.CHECK; }
        if (Strings.same(text, "observe")) { return ContractMode.OBSERVE; }
        if (Strings.same(text, "ignore")) { return ContractMode.IGNORE; }
        return ContractMode.UNKNOWN;
    }

    public static ptr<i8> name(i32 mode) {
        switch (mode) {
            case ContractMode.OBSERVE: return "observe";
            case ContractMode.IGNORE: return "ignore";
            default: return "check";
        }
    }

    public static unsafe void set_project(i32 mode) {
        contract_project_mode = mode;
    }

    public static unsafe i32 project() {
        return contract_project_mode;
    }

    public static unsafe i32 of(SourceFile* file) {
        if (file != null && file.is_library_interface) {
            return file.contract_mode;
        }
        return contract_project_mode;
    }
}
