namespace djinnc;

struct Intrinsic {
    const i32 NONE = 0;
    const i32 SIZEOF = 1;
    const i32 UNLIKELY = 2;
    const i32 ASSUME = 3;
    const i32 DEBUGTRAP = 4;
    const i32 UNREACHABLE = 5;
    const i32 TRAP = 6;
    const i32 TYPEOF = 7;
    const i32 ALLOCA = 8;
    const i32 LIKELY = 9;
    const i32 FIELDS = 10;
    const i32 METHODS = 11;
    const i32 PROPERTIES = 12;
    const i32 ATTRIBUTES = 13;
    const i32 CONSTRUCTORS = 14;
    const i32 INTERFACES = 15;
    const i32 PANIC = 16;
    const i32 PREFETCH = 17;
    const i32 ALIGNOF = 18;
    const i32 EXPECT = 19;
    const i32 BOUNDS_CHECK = 20;
    const i32 FLOAT_BITS = 21;
    const i32 ATOMIC_LOAD = 22;
    const i32 ATOMIC_STORE = 23;
    const i32 ATOMIC_SWAP = 24;
    const i32 ATOMIC_ADD = 25;
    const i32 ATOMIC_SUB = 26;
    const i32 ATOMIC_AND = 27;
    const i32 ATOMIC_OR = 28;
    const i32 ATOMIC_XOR = 29;
    const i32 ATOMIC_CAS = 30;
    const i32 ATOMIC_FENCE = 31;
    const i32 CONTRACT = 32;
    // 'type_trait(T, integer)' and 'same_type(A, B)': questions about types, answered while checking.
    const i32 TYPE_TRAIT = 33;
    const i32 SAME_TYPE = 34;

    const i32 REQUIRE_CLAUSE = 0;
    const i32 ENSURE_CLAUSE = 1;
    const i32 INVARIANT_CLAUSE = 2;

    public static bool is_atomic(i32 id) {
        return id >= Intrinsic.ATOMIC_LOAD && id <= Intrinsic.ATOMIC_FENCE;
    }

    public static i32 atomic_operands(i32 id) {
        switch (id) {
            case Intrinsic.ATOMIC_FENCE: return 0;
            case Intrinsic.ATOMIC_LOAD: return 1;
            case Intrinsic.ATOMIC_CAS: return 3;
            default: return 2;
        }
    }

    public static i32 member_query(ptr<i8> name) {
        if (Strings.same(name, "fields")) { return Intrinsic.FIELDS; }
        if (Strings.same(name, "methods")) { return Intrinsic.METHODS; }
        if (Strings.same(name, "properties")) { return Intrinsic.PROPERTIES; }
        if (Strings.same(name, "attributes")) { return Intrinsic.ATTRIBUTES; }
        if (Strings.same(name, "constructors")) { return Intrinsic.CONSTRUCTORS; }
        if (Strings.same(name, "interfaces")) { return Intrinsic.INTERFACES; }
        return Intrinsic.NONE;
    }

    public static i32 lookup(u32 atom) {
        switch (atom) {
            case Atoms.SIZEOF_ATOM: return Intrinsic.SIZEOF;
            case Atoms.UNLIKELY_ATOM: return Intrinsic.UNLIKELY;
            case Atoms.ASSUME_ATOM: return Intrinsic.ASSUME;
            case Atoms.DEBUGTRAP_ATOM: return Intrinsic.DEBUGTRAP;
            case Atoms.UNREACHABLE_ATOM: return Intrinsic.UNREACHABLE;
            case Atoms.TRAP_ATOM: return Intrinsic.TRAP;
            case Atoms.TYPEOF_ATOM: return Intrinsic.TYPEOF;
            case Atoms.LIKELY_ATOM: return Intrinsic.LIKELY;
            case Atoms.PANIC_ATOM: return Intrinsic.PANIC;
            case Atoms.PREFETCH_ATOM: return Intrinsic.PREFETCH;
            case Atoms.ALIGNOF_ATOM: return Intrinsic.ALIGNOF;
            case Atoms.EXPECT_ATOM: return Intrinsic.EXPECT;
            case Atoms.BOUNDS_CHECK_ATOM: return Intrinsic.BOUNDS_CHECK;
            case Atoms.FLOAT_BITS_ATOM: return Intrinsic.FLOAT_BITS;
            case Atoms.TYPE_TRAIT_ATOM: return Intrinsic.TYPE_TRAIT;
            case Atoms.SAME_TYPE_ATOM: return Intrinsic.SAME_TYPE;
        }
        if (atom >= Atoms.ATOMIC_LOAD_ATOM && atom <= Atoms.ATOMIC_FENCE_ATOM) {
            return Intrinsic.ATOMIC_LOAD + (i32)(atom - Atoms.ATOMIC_LOAD_ATOM);
        }
        return Intrinsic.NONE;
    }

    public static ptr<i8> name(i32 id) {
        switch (id) {
            case Intrinsic.SIZEOF: return "sizeof";
            case Intrinsic.UNLIKELY: return "unlikely";
            case Intrinsic.ASSUME: return "assume";
            case Intrinsic.DEBUGTRAP: return "debugtrap";
            case Intrinsic.UNREACHABLE: return "unreachable";
            case Intrinsic.TRAP: return "trap";
            case Intrinsic.TYPEOF: return "typeof";
            case Intrinsic.ALLOCA: return "alloca";
            case Intrinsic.LIKELY: return "likely";
            case Intrinsic.PANIC: return "panic";
            case Intrinsic.PREFETCH: return "prefetch";
            case Intrinsic.ALIGNOF: return "alignof";
            case Intrinsic.EXPECT: return "expect";
            case Intrinsic.BOUNDS_CHECK: return "bounds_check";
            case Intrinsic.FLOAT_BITS: return "float_bits";
            case Intrinsic.ATOMIC_LOAD: return "atomic_load";
            case Intrinsic.ATOMIC_STORE: return "atomic_store";
            case Intrinsic.ATOMIC_SWAP: return "atomic_swap";
            case Intrinsic.ATOMIC_ADD: return "atomic_add";
            case Intrinsic.ATOMIC_SUB: return "atomic_sub";
            case Intrinsic.ATOMIC_AND: return "atomic_and";
            case Intrinsic.ATOMIC_OR: return "atomic_or";
            case Intrinsic.ATOMIC_XOR: return "atomic_xor";
            case Intrinsic.ATOMIC_CAS: return "atomic_cas";
            case Intrinsic.ATOMIC_FENCE: return "atomic_fence";
            case Intrinsic.CONTRACT: return "contract";
            case Intrinsic.TYPE_TRAIT: return "type_trait";
            case Intrinsic.SAME_TYPE: return "same_type";
            case Intrinsic.FIELDS: return "#fields";
            case Intrinsic.METHODS: return "#methods";
            case Intrinsic.PROPERTIES: return "#properties";
            case Intrinsic.ATTRIBUTES: return "#attributes";
            case Intrinsic.CONSTRUCTORS: return "#constructors";
            case Intrinsic.INTERFACES: return "#interfaces";
            default: return "?";
        }
    }
}
