namespace djinnc;

struct Intrinsic {
    const i32 NONE = 0;
    const i32 SIZEOF = 1;
    const i32 UNLIKELY = 2;
    const i32 ASSUME = 3;
    const i32 DEBUGTRAP = 4;
    const i32 UNREACHABLE = 5;
    const i32 TRAP = 6;
    const i32 TYPEOF = 7;
    const i32 ALLOCA = 8;
    const i32 LIKELY = 9;
    const i32 FIELDS = 10;
    const i32 METHODS = 11;
    const i32 PROPERTIES = 12;
    const i32 ATTRIBUTES = 13;
    const i32 CONSTRUCTORS = 14;
    const i32 INTERFACES = 15;
    const i32 PANIC = 16;
    const i32 PREFETCH = 17;
    const i32 ALIGNOF = 18;
    const i32 EXPECT = 19;
    const i32 BOUNDS_CHECK = 20;
    const i32 FLOAT_BITS = 21;

    public static i32 member_query(ptr<i8> name) {
        if (Strings.same(name, "fields")) { return Intrinsic.FIELDS; }
        if (Strings.same(name, "methods")) { return Intrinsic.METHODS; }
        if (Strings.same(name, "properties")) { return Intrinsic.PROPERTIES; }
        if (Strings.same(name, "attributes")) { return Intrinsic.ATTRIBUTES; }
        if (Strings.same(name, "constructors")) { return Intrinsic.CONSTRUCTORS; }
        if (Strings.same(name, "interfaces")) { return Intrinsic.INTERFACES; }
        return Intrinsic.NONE;
    }

    public static i32 lookup(u32 atom) {
        if (atom == Atoms.SIZEOF_ATOM) {
            return Intrinsic.SIZEOF;
        }
        if (atom == Atoms.UNLIKELY_ATOM) {
            return Intrinsic.UNLIKELY;
        }
        if (atom == Atoms.ASSUME_ATOM) {
            return Intrinsic.ASSUME;
        }
        if (atom == Atoms.DEBUGTRAP_ATOM) {
            return Intrinsic.DEBUGTRAP;
        }
        if (atom == Atoms.UNREACHABLE_ATOM) {
            return Intrinsic.UNREACHABLE;
        }
        if (atom == Atoms.TRAP_ATOM) {
            return Intrinsic.TRAP;
        }
        if (atom == Atoms.TYPEOF_ATOM) {
            return Intrinsic.TYPEOF;
        }
        if (atom == Atoms.LIKELY_ATOM) {
            return Intrinsic.LIKELY;
        }
        if (atom == Atoms.PANIC_ATOM) {
            return Intrinsic.PANIC;
        }
        if (atom == Atoms.PREFETCH_ATOM) {
            return Intrinsic.PREFETCH;
        }
        if (atom == Atoms.ALIGNOF_ATOM) {
            return Intrinsic.ALIGNOF;
        }
        if (atom == Atoms.EXPECT_ATOM) {
            return Intrinsic.EXPECT;
        }
        if (atom == Atoms.BOUNDS_CHECK_ATOM) {
            return Intrinsic.BOUNDS_CHECK;
        }
        if (atom == Atoms.FLOAT_BITS_ATOM) {
            return Intrinsic.FLOAT_BITS;
        }
        return Intrinsic.NONE;
    }

    public static ptr<i8> name(i32 id) {
        if (id == Intrinsic.SIZEOF) { return "sizeof"; }
        if (id == Intrinsic.UNLIKELY) { return "unlikely"; }
        if (id == Intrinsic.ASSUME) { return "assume"; }
        if (id == Intrinsic.DEBUGTRAP) { return "debugtrap"; }
        if (id == Intrinsic.UNREACHABLE) { return "unreachable"; }
        if (id == Intrinsic.TRAP) { return "trap"; }
        if (id == Intrinsic.TYPEOF) { return "typeof"; }
        if (id == Intrinsic.ALLOCA) { return "alloca"; }
        if (id == Intrinsic.LIKELY) { return "likely"; }
        if (id == Intrinsic.PANIC) { return "panic"; }
        if (id == Intrinsic.PREFETCH) { return "prefetch"; }
        if (id == Intrinsic.ALIGNOF) { return "alignof"; }
        if (id == Intrinsic.EXPECT) { return "expect"; }
        if (id == Intrinsic.BOUNDS_CHECK) { return "bounds_check"; }
        if (id == Intrinsic.FLOAT_BITS) { return "float_bits"; }
        if (id == Intrinsic.FIELDS) { return "#fields"; }
        if (id == Intrinsic.METHODS) { return "#methods"; }
        if (id == Intrinsic.PROPERTIES) { return "#properties"; }
        if (id == Intrinsic.ATTRIBUTES) { return "#attributes"; }
        if (id == Intrinsic.CONSTRUCTORS) { return "#constructors"; }
        if (id == Intrinsic.INTERFACES) { return "#interfaces"; }
        return "?";
    }
}
