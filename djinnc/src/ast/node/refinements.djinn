namespace djinnc;

// The op of a CAST node: '(T)x', '(T!)x', or the unchecked conversion inside the functions a refinement synthesizes.
struct CastForm {
    const i32 PLAIN = 0;
    const i32 FORCED = 1;
    const i32 RAW = 2;
}

// The names of the functions synthesized for a refinement type 'X'.
struct Refinements {
    public static ptr<i8> holds_name(ptr<i8> type_name) {
        return Refinements.prefixed("__holds_", type_name);
    }

    public static ptr<i8> force_name(ptr<i8> type_name) {
        return Refinements.prefixed("__force_", type_name);
    }

    public static ptr<i8> try_name(ptr<i8> type_name) {
        return Refinements.prefixed("__try_", type_name);
    }

    static ptr<i8> prefixed(ptr<i8> prefix, ptr<i8> type_name) {
        ByteBuffer* name = ByteBuffer.create();
        name.append(prefix);
        name.append(type_name);
        return name.cstr();
    }
}
