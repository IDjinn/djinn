namespace djinnc;

enum NodeKind {
    PROGRAM,
    IMPORT,
    NAMESPACE_DECL,
    FUNCTION,
    EXTERN_FUNCTION,
    PARAMETER,
    STRUCT_DECL,
    FIELD_DECL,
    STATIC_VAR,
    INTERFACE_DECL,
    IMPL_DECL,
    EMPTY,
    BLOCK,
    VAR_DECL,
    EXPR_STMT,
    RETURN,
    IF,
    WHILE,
    DO_WHILE,
    FOR,
    BREAK,
    CONTINUE,
    SWITCH,
    CASE,
    SWITCH_EXPR,
    MATCH_ARM,
    INT_LITERAL,
    FLOAT_LITERAL,
    STRING_LITERAL,
    BOOL_LITERAL,
    NULL_LITERAL,
    IDENTIFIER,
    UNARY,
    BINARY,
    ASSIGN,
    CALL,
    CAST,
    INDEX,
    FIELD_ACCESS,
    INTRINSIC,
    STRUCT_INIT,
    FIELD_INIT,
    NEW_EXPR,
    ARRAY_LITERAL,
    NAMED_ARG,
    INTERPOLATION,
    IS_EXPR,
    AWAIT_EXPR,
    SPAWN_STMT,
    LET_EXPR,
    FLOAT_CONST
}

struct NodeKinds {
    const i32 COUNT = 51;

    public static i8* name(NodeKind kind) {
        return switch kind {
            PROGRAM -> "Program",
            IMPORT -> "Import",
            NAMESPACE_DECL -> "Namespace",
            FUNCTION -> "Function",
            EXTERN_FUNCTION -> "ExternFunction",
            PARAMETER -> "Parameter",
            STRUCT_DECL -> "Struct",
            FIELD_DECL -> "Field",
            STATIC_VAR -> "StaticVar",
            INTERFACE_DECL -> "Interface",
            IMPL_DECL -> "Impl",
            EMPTY -> "Empty",
            BLOCK -> "Block",
            VAR_DECL -> "VarDecl",
            EXPR_STMT -> "ExprStmt",
            RETURN -> "Return",
            IF -> "If",
            WHILE -> "While",
            DO_WHILE -> "DoWhile",
            FOR -> "For",
            BREAK -> "Break",
            CONTINUE -> "Continue",
            SWITCH -> "Switch",
            CASE -> "Case",
            SWITCH_EXPR -> "SwitchExpr",
            STRUCT_INIT -> "StructInit",
            NEW_EXPR -> "NewExpr",
            ARRAY_LITERAL -> "ArrayLiteral",
            FIELD_INIT -> "FieldInit",
            NAMED_ARG -> "NamedArg",
            INTERPOLATION -> "Interpolation",
            IS_EXPR -> "IsExpr",
            AWAIT_EXPR -> "AwaitExpr",
            SPAWN_STMT -> "SpawnStmt",
            LET_EXPR -> "LetExpr",
            MATCH_ARM -> "MatchArm",
            INT_LITERAL -> "IntLiteral",
            FLOAT_LITERAL -> "FloatLiteral",
            FLOAT_CONST -> "FloatConst",
            STRING_LITERAL -> "StringLiteral",
            BOOL_LITERAL -> "BoolLiteral",
            NULL_LITERAL -> "NullLiteral",
            IDENTIFIER -> "Identifier",
            UNARY -> "Unary",
            BINARY -> "Binary",
            ASSIGN -> "Assign",
            CALL -> "Call",
            CAST -> "Cast",
            INDEX -> "Index",
            FIELD_ACCESS -> "FieldAccess",
            INTRINSIC -> "Intrinsic"
        };
    }
}
