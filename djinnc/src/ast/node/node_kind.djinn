namespace djinnc;

enum NodeKind(i32 flag, ptr<i8> name) {
    PROGRAM(0, "Program"),
    IMPORT(1, "Import"),
    NAMESPACE_DECL(2, "Namespace"),
    FUNCTION(3, "Function"),
    EXTERN_FUNCTION(4, "ExternFunction"),
    PARAMETER(5, "Parameter"),
    STRUCT_DECL(6, "Struct"),
    FIELD_DECL(7, "Field"),
    STATIC_VAR(8, "StaticVar"),
    INTERFACE_DECL(9, "Interface"),
    IMPL_DECL(10, "Impl"),
    EMPTY(11, "Empty"),
    BLOCK(12, "Block"),
    VAR_DECL(13, "VarDecl"),
    EXPR_STMT(14, "ExprStmt"),
    RETURN(15, "Return"),
    IF(16, "If"),
    WHILE(17, "While"),
    DO_WHILE(18, "DoWhile"),
    FOR(19, "For"),
    BREAK(20, "Break"),
    CONTINUE(21, "Continue"),
    SWITCH(22, "Switch"),
    CASE(23, "Case"),
    SWITCH_EXPR(24, "SwitchExpr"),
    MATCH_ARM(25, "MatchArm"),
    INT_LITERAL(26, "IntLiteral"),
    FLOAT_LITERAL(27, "FloatLiteral"),
    STRING_LITERAL(28, "StringLiteral"),
    BOOL_LITERAL(29, "BoolLiteral"),
    NULL_LITERAL(30, "NullLiteral"),
    IDENTIFIER(31, "Identifier"),
    UNARY(32, "Unary"),
    BINARY(33, "Binary"),
    ASSIGN(34, "Assign"),
    CALL(35, "Call"),
    CAST(36, "Cast"),
    INDEX(37, "Index"),
    FIELD_ACCESS(38, "FieldAccess"),
    INTRINSIC(39, "Intrinsic"),
    STRUCT_INIT(40, "StructInit"),
    FIELD_INIT(41, "FieldInit"),
    NEW_EXPR(42, "NewExpr"),
    ARRAY_LITERAL(43, "ArrayLiteral"),
    NAMED_ARG(44, "NamedArg"),
    INTERPOLATION(45, "Interpolation"),
    IS_EXPR(46, "IsExpr"),
    AWAIT_EXPR(47, "AwaitExpr"),
    SPAWN_STMT(48, "SpawnStmt"),
    LET_EXPR(49, "LetExpr"),
    FLOAT_CONST(50, "FloatConst"),
    INSPECT_DECL(51, "InspectDecl"),
    THROW_STMT(52, "ThrowStmt"),
    TRY_EXPR(53, "TryExpr")
