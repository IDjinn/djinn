namespace djinnc;

unsafe static mut void* ast_base = null;
unsafe static mut void* ast_types = null;
unsafe static mut void* ast_lists = null;
unsafe static mut void* ast_extra = null;
unsafe static mut void* ast_value_types = null;
unsafe static mut void* ast_symbols = null;
unsafe static mut void* ast_symbol_kinds = null;
unsafe static mut void* ast_layout = null;
unsafe static mut void* ast_extra_sizes = null;
unsafe static mut i32 ast_count = 0;
unsafe static mut i32 ast_capacity = 0;
unsafe static mut i32 ast_extra_count = 0;
unsafe static mut i32 ast_extra_capacity = 0;

struct Ast {
    public static void init(i32 capacity) {
        Arena* arena = Memory.arena();
        ast_capacity = capacity;
        ast_count = 1;
        ast_base = arena.zalloc((u64)capacity * sizeof(Node), 8);
        ast_types = (void*)PointerList.create();
        ast_lists = (void*)PointerList.create();
        ast_extra_capacity = capacity + 64;
        ast_extra_count = 1;
        ast_extra = arena.zalloc((u64)ast_extra_capacity * 4, 4);
        ast_value_types = arena.zalloc((u64)capacity * 4, 4);
        ast_symbols = arena.zalloc((u64)capacity * 8, 8);
        ast_symbol_kinds = arena.zalloc((u64)capacity, 1);
        NodeLayout.build();
    }

    public static Node* at(i32 id) {
        if (id == 0) {
            return null;
        }
        i8* base = (i8*)ast_base;
        return (Node*)(base + (i64)id * sizeof(Node));
    }

    public static i32 id_of(Node* node) {
        if (node == null) {
            return 0;
        }
        i8* base = (i8*)ast_base;
        i8* address = (i8*)node;
        return (i32)(((i64)address - (i64)base) / (i64)sizeof(Node));
    }

    public static u32 intern_base_name(i8* text, i32 length) {
        mut i32 last = 0;
        for (mut i32 i = 0; i + 1 < length; i = i + 1) {
            if (text[i] == 58 && text[i + 1] == 58) {
                last = i + 2;
            }
        }
        AtomTable* table = Ast.atoms();
        return table.intern_copy(text + last, (u32)(length - last));
    }

    public static AtomTable* atoms() {
        return Atoms.get();
    }

    public static i32 node_count() {
        return ast_count - 1;
    }
}
