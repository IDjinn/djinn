namespace djinnc;

struct SymbolKind {
    const i32 NONE = 0;
    const i32 LOCAL = 1;
    const i32 GLOBAL = 2;
    const i32 FUNCTION = 3;
    const i32 STATIC_METHOD = 4;
    const i32 INSTANCE_METHOD = 5;
    const i32 FIELD = 6;
    const i32 CONSTANT = 7;
    const i32 STRUCT_NAME = 8;
    const i32 TYPE = 9;
    const i32 OPERATOR = 10;
    const i32 NEGATED_OPERATOR = 11;
    const i32 CONSTRUCTOR = 12;
    const i32 PROPERTY_GET = 13;
    const i32 PROPERTY_SET = 14;
    const i32 IMPLICIT_FIELD = 15;
    const i32 IMPLICIT_GET = 16;
    const i32 IMPLICIT_SET = 17;
    const i32 INDEX_GET = 18;
    const i32 INDEX_SET = 19;
    const i32 ENUM_VALUE = 20;
    const i32 ENUM_FIELD = 21;
    const i32 INTERFACE_NAME = 22;
    const i32 ERROR_SWITCH = 23;
}
