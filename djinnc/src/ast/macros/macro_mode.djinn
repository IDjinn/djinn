namespace djinnc;

// Macros are token templates. Every macro of every file is collected before parsing, so the order of declarations
// does not matter. A call matches the first rule whose fragments parse from its arguments; the body tokens are then
// copied after the lexed files (parameters replaced by their argument tokens, locals declared by the template renamed)
// and parsed in place as an expression, statements or declarations, depending on where the call is.
struct MacroMode {
    const i32 EXPRESSION = 0;
    const i32 STATEMENT = 1;
    const i32 ITEM = 2;
}
