namespace djinnc;

// Procedural macros: 'proc macro name => handler;' and 'proc attribute Name => handler;'. The library that declares one
// gets an exported entry, '__djinn_proc_<name>', generated by 'std::meta::proc_macro_entry!'. A program that imports
// the library calls the entry while parsing (ProcMacros runs the library object in a JIT): the argument tokens go in
// as 'class,span,joint,length:text' records and the tokens that come back are parsed like a declarative expansion.
struct TokenClassCodes {
    const i32 IDENTIFIER = 0;
    const i32 KEYWORD = 1;
    const i32 NUMBER = 2;
    const i32 STRING = 3;
    const i32 PUNCT = 4;
    const i32 OPEN = 5;
    const i32 CLOSE = 6;
    const i32 CHAR = 7;
    const i32 ERROR = 8;
    const i32 SEPARATOR = 9;
    // The pieces of an interpolated string ($"a {x} b"): their text is the decoded value, so they keep their own kind.
    const i32 INTERP_BEGIN = 10;
    const i32 INTERP_MIDDLE = 11;
    const i32 INTERP_END = 12;
    const i32 INTERP_FORMAT = 13;
}
