namespace djinnc;

struct NodeKind {
    const i32 PROGRAM = 0;
    const i32 IMPORT = 1;
    const i32 NAMESPACE_DECL = 2;
    const i32 FUNCTION = 3;
    const i32 EXTERN_FUNCTION = 4;
    const i32 PARAMETER = 5;
    const i32 STRUCT_DECL = 6;
    const i32 FIELD_DECL = 7;
    const i32 STATIC_VAR = 8;
    const i32 INTERFACE_DECL = 9;
    const i32 IMPL_DECL = 10;

    const i32 BLOCK = 20;
    const i32 VAR_DECL = 21;
    const i32 EXPR_STMT = 22;
    const i32 RETURN = 23;
    const i32 IF = 24;
    const i32 WHILE = 25;
    const i32 DO_WHILE = 26;
    const i32 FOR = 27;
    const i32 BREAK = 28;
    const i32 CONTINUE = 29;
    const i32 SWITCH = 30;
    const i32 CASE = 31;
    const i32 SWITCH_EXPR = 32;
    const i32 MATCH_ARM = 33;

    const i32 INT_LITERAL = 40;
    const i32 FLOAT_LITERAL = 41;
    const i32 STRING_LITERAL = 42;
    const i32 BOOL_LITERAL = 43;
    const i32 NULL_LITERAL = 44;
    const i32 IDENTIFIER = 45;
    const i32 UNARY = 46;
    const i32 BINARY = 47;
    const i32 ASSIGN = 48;
    const i32 CALL = 49;
    const i32 CAST = 50;
    const i32 INDEX = 51;
    const i32 FIELD_ACCESS = 52;
    const i32 INTRINSIC = 53;
    const i32 STRUCT_INIT = 54;
    const i32 FIELD_INIT = 55;
    const i32 NEW_EXPR = 56;
    const i32 ARRAY_LITERAL = 57;
    const i32 NAMED_ARG = 58;
    const i32 INTERPOLATION = 59;
    const i32 COUNT = 60;

    public static i8* name(i32 kind) {
        if (kind == NodeKind.PROGRAM) { return "Program"; }
        if (kind == NodeKind.IMPORT) { return "Import"; }
        if (kind == NodeKind.NAMESPACE_DECL) { return "Namespace"; }
        if (kind == NodeKind.FUNCTION) { return "Function"; }
        if (kind == NodeKind.EXTERN_FUNCTION) { return "ExternFunction"; }
        if (kind == NodeKind.PARAMETER) { return "Parameter"; }
        if (kind == NodeKind.STRUCT_DECL) { return "Struct"; }
        if (kind == NodeKind.FIELD_DECL) { return "Field"; }
        if (kind == NodeKind.STATIC_VAR) { return "StaticVar"; }
        if (kind == NodeKind.INTERFACE_DECL) { return "Interface"; }
        if (kind == NodeKind.IMPL_DECL) { return "Impl"; }
        if (kind == NodeKind.BLOCK) { return "Block"; }
        if (kind == NodeKind.VAR_DECL) { return "VarDecl"; }
        if (kind == NodeKind.EXPR_STMT) { return "ExprStmt"; }
        if (kind == NodeKind.RETURN) { return "Return"; }
        if (kind == NodeKind.IF) { return "If"; }
        if (kind == NodeKind.WHILE) { return "While"; }
        if (kind == NodeKind.DO_WHILE) { return "DoWhile"; }
        if (kind == NodeKind.FOR) { return "For"; }
        if (kind == NodeKind.BREAK) { return "Break"; }
        if (kind == NodeKind.CONTINUE) { return "Continue"; }
        if (kind == NodeKind.SWITCH) { return "Switch"; }
        if (kind == NodeKind.CASE) { return "Case"; }
        if (kind == NodeKind.SWITCH_EXPR) { return "SwitchExpr"; }
        if (kind == NodeKind.STRUCT_INIT) { return "StructInit"; }
        if (kind == NodeKind.NEW_EXPR) { return "NewExpr"; }
        if (kind == NodeKind.ARRAY_LITERAL) { return "ArrayLiteral"; }
        if (kind == NodeKind.FIELD_INIT) { return "FieldInit"; }
        if (kind == NodeKind.NAMED_ARG) { return "NamedArg"; }
        if (kind == NodeKind.INTERPOLATION) { return "Interpolation"; }
        if (kind == NodeKind.MATCH_ARM) { return "MatchArm"; }
        if (kind == NodeKind.INT_LITERAL) { return "IntLiteral"; }
        if (kind == NodeKind.FLOAT_LITERAL) { return "FloatLiteral"; }
        if (kind == NodeKind.STRING_LITERAL) { return "StringLiteral"; }
        if (kind == NodeKind.BOOL_LITERAL) { return "BoolLiteral"; }
        if (kind == NodeKind.NULL_LITERAL) { return "NullLiteral"; }
        if (kind == NodeKind.IDENTIFIER) { return "Identifier"; }
        if (kind == NodeKind.UNARY) { return "Unary"; }
        if (kind == NodeKind.BINARY) { return "Binary"; }
        if (kind == NodeKind.ASSIGN) { return "Assign"; }
        if (kind == NodeKind.CALL) { return "Call"; }
        if (kind == NodeKind.CAST) { return "Cast"; }
        if (kind == NodeKind.INDEX) { return "Index"; }
        if (kind == NodeKind.FIELD_ACCESS) { return "FieldAccess"; }
        if (kind == NodeKind.INTRINSIC) { return "Intrinsic"; }
        return "?";
    }
}

struct Intrinsic {
    const i32 NONE = 0;
    const i32 SIZEOF = 1;

    public static i32 lookup(u32 atom) {
        if (atom == Atoms.SIZEOF_ATOM) {
            return Intrinsic.SIZEOF;
        }
        return Intrinsic.NONE;
    }

    public static i8* name(i32 id) {
        if (id == Intrinsic.SIZEOF) { return "sizeof"; }
        return "?";
    }
}

unsafe static mut void* ast_base = null;
unsafe static mut void* ast_types = null;
unsafe static mut void* ast_lists = null;
unsafe static mut void* ast_extra = null;
unsafe static mut void* ast_value_types = null;
unsafe static mut void* ast_symbols = null;
unsafe static mut void* ast_symbol_kinds = null;
unsafe static mut void* ast_layout = null;
unsafe static mut void* ast_extra_sizes = null;
unsafe static mut i32 ast_count = 0;
unsafe static mut i32 ast_capacity = 0;
unsafe static mut i32 ast_extra_count = 0;
unsafe static mut i32 ast_extra_capacity = 0;

struct Ast {
    public static void init(i32 capacity) {
        Arena* arena = Memory.arena();
        ast_capacity = capacity;
        ast_count = 1;
        ast_base = arena.zalloc((u64)capacity * sizeof(Node), 8);
        ast_types = (void*)PointerList.create();
        ast_lists = (void*)PointerList.create();
        ast_extra_capacity = capacity + 64;
        ast_extra_count = 1;
        ast_extra = arena.zalloc((u64)ast_extra_capacity * 4, 4);
        ast_value_types = arena.zalloc((u64)capacity * 4, 4);
        ast_symbols = arena.zalloc((u64)capacity * 8, 8);
        ast_symbol_kinds = arena.zalloc((u64)capacity, 1);
        NodeLayout.build();
    }

    public static Node* at(i32 id) {
        if (id == 0) {
            return (Node*)0;
        }
        i8* base = (i8*)ast_base;
        return (Node*)(base + (i64)id * sizeof(Node));
    }

    public static i32 id_of(Node* node) {
        if (node == null) {
            return 0;
        }
        i8* base = (i8*)ast_base;
        i8* address = (i8*)node;
        return (i32)(((i64)address - (i64)base) / (i64)sizeof(Node));
    }

    public static u32 intern_base_name(i8* text, i32 length) {
        mut i32 last = 0;
        for (mut i32 i = 0; i + 1 < length; i = i + 1) {
            if (text[i] == 58 && text[i + 1] == 58) {
                last = i + 2;
            }
        }
        AtomTable* table = Ast.atoms();
        return table.intern_copy(text + last, (u32)(length - last));
    }

    public static AtomTable* atoms() {
        return Atoms.get();
    }

    public static i32 node_count() {
        return ast_count - 1;
    }
}

struct SymbolKind {
    const i32 NONE = 0;
    const i32 LOCAL = 1;
    const i32 GLOBAL = 2;
    const i32 FUNCTION = 3;
    const i32 STATIC_METHOD = 4;
    const i32 INSTANCE_METHOD = 5;
    const i32 FIELD = 6;
    const i32 CONSTANT = 7;
    const i32 STRUCT_NAME = 8;
    const i32 TYPE = 9;
    const i32 OPERATOR = 10;
    const i32 NEGATED_OPERATOR = 11;
    const i32 CONSTRUCTOR = 12;
}

struct NodeField {
    const i32 FIRST = 0;
    const i32 SECOND = 1;
    const i32 THIRD = 2;
    const i32 FOURTH = 3;
    const i32 TEXT = 4;
    const i32 TYPE = 5;
    const i32 LIST = 6;
    const i32 VALUE_LOW = 7;
    const i32 VALUE_HIGH = 8;
    const i32 GENERICS = 9;
    const i32 COUNT = 10;
}

struct Slot {
    const i32 NONE = 0;
    const i32 TOKEN = 1;
    const i32 A = 2;
    const i32 B = 3;
    const i32 EXTRA = 4;
}

struct NodeLayout {
    public static void build() {
        Arena* arena = Memory.arena();
        ast_layout = arena.zalloc((u64)NodeKind.COUNT * NodeField.COUNT, 1);
        ast_extra_sizes = arena.zalloc((u64)NodeKind.COUNT, 1);

        NodeLayout.list_only(NodeKind.PROGRAM);
        NodeLayout.define(NodeKind.IMPORT, NodeField.TEXT, Slot.A);
        NodeLayout.define(NodeKind.NAMESPACE_DECL, NodeField.LIST, Slot.A);
        NodeLayout.define(NodeKind.NAMESPACE_DECL, NodeField.TEXT, Slot.B);
        NodeLayout.define(NodeKind.FUNCTION, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind.FUNCTION, NodeField.TEXT, Slot.EXTRA);
        NodeLayout.define(NodeKind.FUNCTION, NodeField.TYPE, Slot.EXTRA + 1);
        NodeLayout.define(NodeKind.FUNCTION, NodeField.LIST, Slot.EXTRA + 2);
        NodeLayout.define(NodeKind.FUNCTION, NodeField.GENERICS, Slot.EXTRA + 3);
        NodeLayout.define(NodeKind.EXTERN_FUNCTION, NodeField.LIST, Slot.A);
        NodeLayout.define(NodeKind.EXTERN_FUNCTION, NodeField.TEXT, Slot.EXTRA);
        NodeLayout.define(NodeKind.EXTERN_FUNCTION, NodeField.TYPE, Slot.EXTRA + 1);
        NodeLayout.define(NodeKind.PARAMETER, NodeField.TYPE, Slot.A);
        NodeLayout.define(NodeKind.PARAMETER, NodeField.TEXT, Slot.B);
        NodeLayout.define(NodeKind.STRUCT_DECL, NodeField.LIST, Slot.A);
        NodeLayout.define(NodeKind.STRUCT_DECL, NodeField.TEXT, Slot.EXTRA);
        NodeLayout.define(NodeKind.STRUCT_DECL, NodeField.TYPE, Slot.EXTRA + 1);
        NodeLayout.define(NodeKind.STRUCT_DECL, NodeField.GENERICS, Slot.EXTRA + 2);
        NodeLayout.define(NodeKind.INTERFACE_DECL, NodeField.LIST, Slot.A);
        NodeLayout.define(NodeKind.INTERFACE_DECL, NodeField.TEXT, Slot.EXTRA);
        NodeLayout.define(NodeKind.INTERFACE_DECL, NodeField.GENERICS, Slot.EXTRA + 1);
        NodeLayout.define(NodeKind.IMPL_DECL, NodeField.LIST, Slot.A);
        NodeLayout.define(NodeKind.IMPL_DECL, NodeField.TYPE, Slot.EXTRA);
        NodeLayout.declaration(NodeKind.FIELD_DECL);
        NodeLayout.define(NodeKind.FIELD_DECL, NodeField.LIST, Slot.EXTRA + 2);
        NodeLayout.declaration(NodeKind.STATIC_VAR);
        NodeLayout.declaration(NodeKind.VAR_DECL);
        NodeLayout.list_only(NodeKind.BLOCK);
        NodeLayout.define(NodeKind.EXPR_STMT, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind.RETURN, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind.IF, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind.IF, NodeField.SECOND, Slot.EXTRA);
        NodeLayout.define(NodeKind.IF, NodeField.THIRD, Slot.EXTRA + 1);
        NodeLayout.pair(NodeKind.WHILE);
        NodeLayout.pair(NodeKind.DO_WHILE);
        NodeLayout.define(NodeKind.FOR, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind.FOR, NodeField.SECOND, Slot.EXTRA);
        NodeLayout.define(NodeKind.FOR, NodeField.THIRD, Slot.EXTRA + 1);
        NodeLayout.define(NodeKind.FOR, NodeField.FOURTH, Slot.EXTRA + 2);
        NodeLayout.define(NodeKind.SWITCH, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind.SWITCH, NodeField.LIST, Slot.B);
        NodeLayout.define(NodeKind.CASE, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind.CASE, NodeField.LIST, Slot.B);
        NodeLayout.list_only(NodeKind.STRUCT_INIT);
        NodeLayout.list_only(NodeKind.ARRAY_LITERAL);
        NodeLayout.list_only(NodeKind.INTERPOLATION);
        NodeLayout.define(NodeKind.NEW_EXPR, NodeField.TYPE, Slot.A);
        NodeLayout.define(NodeKind.NEW_EXPR, NodeField.LIST, Slot.B);
        NodeLayout.define(NodeKind.FIELD_INIT, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind.FIELD_INIT, NodeField.TEXT, Slot.B);
        NodeLayout.define(NodeKind.NAMED_ARG, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind.NAMED_ARG, NodeField.TEXT, Slot.B);
        NodeLayout.define(NodeKind.SWITCH_EXPR, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind.SWITCH_EXPR, NodeField.LIST, Slot.B);
        NodeLayout.define(NodeKind.MATCH_ARM, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind.MATCH_ARM, NodeField.TEXT, Slot.EXTRA);
        NodeLayout.define(NodeKind.MATCH_ARM, NodeField.LIST, Slot.EXTRA + 1);
        NodeLayout.define(NodeKind.INT_LITERAL, NodeField.TEXT, Slot.TOKEN);
        NodeLayout.define(NodeKind.INT_LITERAL, NodeField.VALUE_LOW, Slot.A);
        NodeLayout.define(NodeKind.INT_LITERAL, NodeField.VALUE_HIGH, Slot.B);
        NodeLayout.define(NodeKind.FLOAT_LITERAL, NodeField.TEXT, Slot.TOKEN);
        NodeLayout.define(NodeKind.STRING_LITERAL, NodeField.TEXT, Slot.TOKEN);
        NodeLayout.define(NodeKind.STRING_LITERAL, NodeField.VALUE_LOW, Slot.A);
        NodeLayout.define(NodeKind.BOOL_LITERAL, NodeField.VALUE_LOW, Slot.A);
        NodeLayout.define(NodeKind.IDENTIFIER, NodeField.TEXT, Slot.A);
        NodeLayout.define(NodeKind.IDENTIFIER, NodeField.TYPE, Slot.B);
        NodeLayout.define(NodeKind.UNARY, NodeField.FIRST, Slot.A);
        NodeLayout.pair(NodeKind.BINARY);
        NodeLayout.pair(NodeKind.ASSIGN);
        NodeLayout.pair(NodeKind.INDEX);
        NodeLayout.define(NodeKind.CALL, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind.CALL, NodeField.LIST, Slot.B);
        NodeLayout.define(NodeKind.CAST, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind.CAST, NodeField.TYPE, Slot.B);
        NodeLayout.define(NodeKind.FIELD_ACCESS, NodeField.FIRST, Slot.A);
        NodeLayout.define(NodeKind.FIELD_ACCESS, NodeField.TEXT, Slot.EXTRA);
        NodeLayout.define(NodeKind.FIELD_ACCESS, NodeField.TYPE, Slot.EXTRA + 1);
        NodeLayout.define(NodeKind.INTRINSIC, NodeField.TYPE, Slot.A);
    }

    static void list_only(i32 kind) {
        NodeLayout.define(kind, NodeField.LIST, Slot.A);
    }

    static void pair(i32 kind) {
        NodeLayout.define(kind, NodeField.FIRST, Slot.A);
        NodeLayout.define(kind, NodeField.SECOND, Slot.B);
    }

    static void declaration(i32 kind) {
        NodeLayout.define(kind, NodeField.FIRST, Slot.A);
        NodeLayout.define(kind, NodeField.TEXT, Slot.EXTRA);
        NodeLayout.define(kind, NodeField.TYPE, Slot.EXTRA + 1);
    }

    static void define(i32 kind, i32 field, i32 slot) {
        u8* layout = (u8*)ast_layout;
        u8* sizes = (u8*)ast_extra_sizes;
        layout[kind * NodeField.COUNT + field] = (u8)slot;
        if (slot >= Slot.EXTRA) {
            i32 needed = slot - Slot.EXTRA + 1;
            if (needed > (i32)sizes[kind]) {
                sizes[kind] = (u8)needed;
            }
        }
    }

    public static i32 slot(i32 kind, i32 field) {
        u8* layout = (u8*)ast_layout;
        return (i32)layout[kind * NodeField.COUNT + field];
    }

    public static i32 extra_size(i32 kind) {
        u8* sizes = (u8*)ast_extra_sizes;
        return (i32)sizes[kind];
    }
}

struct IdList {
    u32* data;
    i32 length;
    i32 capacity;

    public static IdList* create() {
        Arena* arena = Memory.arena();
        IdList* list = (IdList*)arena.zalloc(sizeof(IdList), 8);
        list.capacity = 4;
        list.data = (u32*)arena.alloc(16, 4);
        return list;
    }

    public void push(u32 id) {
        if (this.length == this.capacity) {
            Arena* arena = Memory.arena();
            i32 capacity = this.capacity * 2;
            u32* grown = (u32*)arena.alloc((u64)capacity * 4, 4);
            memcpy(grown, this.data, (u64)this.length * 4);
            this.data = grown;
            this.capacity = capacity;
        }
        this.data[this.length] = id;
        this.length = this.length + 1;
    }

    public u32 get(i32 index) {
        return this.data[index];
    }
}

struct Node {
    u16 kind;
    u16 flags;
    i32 token;
    u32 a;
    u32 b;

    public static Node* create(i32 kind, i32 token) {
        if (ast_count >= ast_capacity) {
            logger_error(Log.get(), "djinnc: ast node capacity exceeded (%d)", ast_capacity);
            exit(1);
        }
        Node* node = Ast.at(ast_count);
        ast_count = ast_count + 1;
        node.kind = (u16)kind;
        node.token = token;
        i32 extra = NodeLayout.extra_size(kind);
        if (extra > 0) {
            Node.reserve_extra(extra);
            node.b = (u32)ast_extra_count;
            ast_extra_count = ast_extra_count + extra;
        }
        return node;
    }

    static void reserve_extra(i32 count) {
        if (ast_extra_count + count <= ast_extra_capacity) {
            return;
        }
        Arena* arena = Memory.arena();
        i32 capacity = ast_extra_capacity * 2;
        u32* grown = (u32*)arena.zalloc((u64)capacity * 4, 4);
        memcpy(grown, ast_extra, (u64)ast_extra_count * 4);
        ast_extra = (void*)grown;
        ast_extra_capacity = capacity;
    }

    public static Node* create_list(i32 kind, i32 token) {
        Node* node = Node.create(kind, token);
        PointerList* lists = (PointerList*)ast_lists;
        lists.push((void*)IdList.create());
        node.set_field(NodeField.LIST, (u32)lists.length);
        return node;
    }

    u32 get_field(i32 field) {
        i32 slot = NodeLayout.slot((i32)this.kind, field);
        if (slot == Slot.NONE) {
            return 0;
        }
        u32* words = (u32*)this;
        if (slot == Slot.A) {
            return words[2];
        }
        if (slot == Slot.B) {
            return words[3];
        }
        if (slot == Slot.TOKEN) {
            TokenList* tokens = TokenList.get();
            return tokens.raw_atom(this.token);
        }
        u32* extra = (u32*)ast_extra;
        return extra[(i32)words[3] + slot - Slot.EXTRA];
    }

    void set_field(i32 field, u32 value) {
        i32 slot = NodeLayout.slot((i32)this.kind, field);
        if (slot == Slot.NONE || slot == Slot.TOKEN) {
            return;
        }
        u32* words = (u32*)this;
        if (slot == Slot.A) {
            words[2] = value;
        } else if (slot == Slot.B) {
            words[3] = value;
        } else {
            u32* extra = (u32*)ast_extra;
            extra[(i32)words[3] + slot - Slot.EXTRA] = value;
        }
    }

    public u32 value_type() {
        u32* types = (u32*)ast_value_types;
        return types[Ast.id_of(this)];
    }

    public void set_value_type(u32 type) {
        u32* types = (u32*)ast_value_types;
        types[Ast.id_of(this)] = type;
    }

    public void* symbol() {
        void** symbols = (void**)ast_symbols;
        return symbols[Ast.id_of(this)];
    }

    public i32 symbol_kind() {
        u8* kinds = (u8*)ast_symbol_kinds;
        return (i32)kinds[Ast.id_of(this)];
    }

    public void set_symbol(i32 kind, void* symbol) {
        i32 id = Ast.id_of(this);
        void** symbols = (void**)ast_symbols;
        u8* kinds = (u8*)ast_symbol_kinds;
        symbols[id] = symbol;
        kinds[id] = (u8)kind;
    }

    public i32 line() {
        TokenList* tokens = TokenList.get();
        return tokens.line(this.token);
    }

    public i32 column() {
        TokenList* tokens = TokenList.get();
        return tokens.column(this.token);
    }

    public i8* file_name() {
        SourceFile* file = Sources.of_token(this.token);
        return file.path;
    }

    public Node* first() {
        return Ast.at((i32)this.get_field(NodeField.FIRST));
    }

    public Node* second() {
        return Ast.at((i32)this.get_field(NodeField.SECOND));
    }

    public Node* third() {
        return Ast.at((i32)this.get_field(NodeField.THIRD));
    }

    public Node* fourth() {
        return Ast.at((i32)this.get_field(NodeField.FOURTH));
    }

    public void set_first(Node* node) {
        this.set_field(NodeField.FIRST, (u32)Ast.id_of(node));
    }

    public void set_second(Node* node) {
        this.set_field(NodeField.SECOND, (u32)Ast.id_of(node));
    }

    public void set_third(Node* node) {
        this.set_field(NodeField.THIRD, (u32)Ast.id_of(node));
    }

    public void set_fourth(Node* node) {
        this.set_field(NodeField.FOURTH, (u32)Ast.id_of(node));
    }

    public i8* text() {
        u32 stored = this.get_field(NodeField.TEXT);
        if (stored == 0) {
            return (i8*)0;
        }
        AtomTable* atoms = Ast.atoms();
        return atoms.text(stored - 1);
    }

    public void set_text(i8* text) {
        this.set_text_n(text, strlen(text));
    }

    public void set_text_n(i8* text, i32 length) {
        AtomTable* atoms = Ast.atoms();
        this.set_field(NodeField.TEXT, atoms.intern_copy(text, (u32)length) + 1);
    }

    public void set_text_atom(u32 atom) {
        this.set_field(NodeField.TEXT, atom + 1);
    }

    public u32 text_atom() {
        u32 stored = this.get_field(NodeField.TEXT);
        if (stored == 0) {
            return 0;
        }
        return stored - 1;
    }

    public u32 name() {
        u32 stored = this.get_field(NodeField.TEXT);
        if (stored == 0) {
            return 0;
        }
        AtomTable* atoms = Ast.atoms();
        return atoms.base_of(stored - 1);
    }

    public TypeRef* type() {
        u32 stored = this.get_field(NodeField.TYPE);
        if (stored == 0) {
            return (TypeRef*)0;
        }
        PointerList* types = (PointerList*)ast_types;
        return (TypeRef*)types.get((i32)stored - 1);
    }

    public void set_type(TypeRef* type) {
        PointerList* types = (PointerList*)ast_types;
        types.push((void*)type);
        this.set_field(NodeField.TYPE, (u32)types.length);
    }

    public GenericParams* generics() {
        u32 stored = this.get_field(NodeField.GENERICS);
        if (stored == 0) {
            return (GenericParams*)0;
        }
        PointerList* lists = (PointerList*)ast_lists;
        return (GenericParams*)lists.get((i32)stored - 1);
    }

    public void set_generics(GenericParams* params) {
        PointerList* lists = (PointerList*)ast_lists;
        lists.push((void*)params);
        this.set_field(NodeField.GENERICS, (u32)lists.length);
    }

    public static Node* clone(Node* source) {
        mut Node* copy = (Node*)0;
        if (source.has_items()) {
            copy = Node.create_list((i32)source.kind, source.token);
        } else {
            copy = Node.create((i32)source.kind, source.token);
        }
        copy.flags = source.flags;
        for (mut i32 field = NodeField.FIRST; field <= NodeField.FOURTH; field = field + 1) {
            u32 stored = source.get_field(field);
            if (stored != 0) {
                Node* child = Ast.at((i32)stored);
                copy.set_field(field, (u32)Ast.id_of(Node.clone(child)));
            }
        }
        copy.set_field(NodeField.TEXT, source.get_field(NodeField.TEXT));
        copy.set_field(NodeField.TYPE, source.get_field(NodeField.TYPE));
        copy.set_field(NodeField.VALUE_LOW, source.get_field(NodeField.VALUE_LOW));
        copy.set_field(NodeField.VALUE_HIGH, source.get_field(NodeField.VALUE_HIGH));
        copy.set_field(NodeField.GENERICS, source.get_field(NodeField.GENERICS));
        if (source.has_items()) {
            for (mut i32 i = 0; i < source.count(); i = i + 1) {
                copy.add(Node.clone(source.child(i)));
            }
        }
        return copy;
    }

    public bool flag() {
        return ((u32)this.flags & 1) != 0;
    }

    public void set_flag(bool value) {
        u32 cleared = (u32)this.flags & 65534;
        if (value) {
            this.flags = (u16)(cleared | 1);
        } else {
            this.flags = (u16)cleared;
        }
    }

    public bool is_variadic() {
        return ((u32)this.flags & 2) != 0;
    }

    public void set_variadic(bool value) {
        u32 cleared = (u32)this.flags & 65533;
        if (value) {
            this.flags = (u16)(cleared | 2);
        } else {
            this.flags = (u16)cleared;
        }
    }

    public i32 op() {
        return (i32)((u32)this.flags >> 2);
    }

    public void set_op(i32 op) {
        this.flags = (u16)(((u32)this.flags & 3) | ((u32)op << 2));
    }

    public i64 int_value() {
        u64 low = (u64)this.get_field(NodeField.VALUE_LOW);
        u64 high = (u64)this.get_field(NodeField.VALUE_HIGH);
        return (i64)(low | (high << 32));
    }

    public void set_int_value(i64 value) {
        u64 bits = (u64)value;
        this.set_field(NodeField.VALUE_LOW, (u32)(bits & Limits.U32_MAX));
        this.set_field(NodeField.VALUE_HIGH, (u32)(bits >> 32));
    }

    public f64 float_value() {
        i8* literal = this.text();
        return Strings.parse_float(literal, strlen(literal));
    }

    public void add(Node* child) {
        IdList* list = this.items();
        list.push((u32)Ast.id_of(child));
    }

    public bool has_items() {
        return this.get_field(NodeField.LIST) != 0;
    }

    IdList* items() {
        PointerList* lists = (PointerList*)ast_lists;
        return (IdList*)lists.get((i32)this.get_field(NodeField.LIST) - 1);
    }

    public Node* child(i32 index) {
        IdList* list = this.items();
        return Ast.at((i32)list.data[index]);
    }

    public i32 count() {
        IdList* list = this.items();
        return list.length;
    }

    public void set_child(i32 index, Node* child) {
        IdList* list = this.items();
        list.data[index] = (u32)Ast.id_of(child);
    }
}
