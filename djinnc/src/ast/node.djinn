namespace djinnc;

struct NodeKind {
    const i32 PROGRAM = 0;
    const i32 IMPORT = 1;
    const i32 NAMESPACE_DECL = 2;
    const i32 FUNCTION = 3;
    const i32 EXTERN_FUNCTION = 4;
    const i32 PARAMETER = 5;
    const i32 STRUCT_DECL = 6;
    const i32 FIELD_DECL = 7;
    const i32 STATIC_VAR = 8;

    const i32 BLOCK = 20;
    const i32 VAR_DECL = 21;
    const i32 EXPR_STMT = 22;
    const i32 RETURN = 23;
    const i32 IF = 24;
    const i32 WHILE = 25;
    const i32 DO_WHILE = 26;
    const i32 FOR = 27;
    const i32 BREAK = 28;
    const i32 CONTINUE = 29;

    const i32 INT_LITERAL = 40;
    const i32 FLOAT_LITERAL = 41;
    const i32 STRING_LITERAL = 42;
    const i32 BOOL_LITERAL = 43;
    const i32 NULL_LITERAL = 44;
    const i32 IDENTIFIER = 45;
    const i32 UNARY = 46;
    const i32 BINARY = 47;
    const i32 ASSIGN = 48;
    const i32 CALL = 49;
    const i32 CAST = 50;
    const i32 INDEX = 51;
    const i32 FIELD_ACCESS = 52;
    const i32 SIZEOF = 53;

    public static i8* name(i32 kind) {
        if (kind == NodeKind.PROGRAM) { return "Program"; }
        if (kind == NodeKind.IMPORT) { return "Import"; }
        if (kind == NodeKind.NAMESPACE_DECL) { return "Namespace"; }
        if (kind == NodeKind.FUNCTION) { return "Function"; }
        if (kind == NodeKind.EXTERN_FUNCTION) { return "ExternFunction"; }
        if (kind == NodeKind.PARAMETER) { return "Parameter"; }
        if (kind == NodeKind.STRUCT_DECL) { return "Struct"; }
        if (kind == NodeKind.FIELD_DECL) { return "Field"; }
        if (kind == NodeKind.STATIC_VAR) { return "StaticVar"; }
        if (kind == NodeKind.BLOCK) { return "Block"; }
        if (kind == NodeKind.VAR_DECL) { return "VarDecl"; }
        if (kind == NodeKind.EXPR_STMT) { return "ExprStmt"; }
        if (kind == NodeKind.RETURN) { return "Return"; }
        if (kind == NodeKind.IF) { return "If"; }
        if (kind == NodeKind.WHILE) { return "While"; }
        if (kind == NodeKind.DO_WHILE) { return "DoWhile"; }
        if (kind == NodeKind.FOR) { return "For"; }
        if (kind == NodeKind.BREAK) { return "Break"; }
        if (kind == NodeKind.CONTINUE) { return "Continue"; }
        if (kind == NodeKind.INT_LITERAL) { return "IntLiteral"; }
        if (kind == NodeKind.FLOAT_LITERAL) { return "FloatLiteral"; }
        if (kind == NodeKind.STRING_LITERAL) { return "StringLiteral"; }
        if (kind == NodeKind.BOOL_LITERAL) { return "BoolLiteral"; }
        if (kind == NodeKind.NULL_LITERAL) { return "NullLiteral"; }
        if (kind == NodeKind.IDENTIFIER) { return "Identifier"; }
        if (kind == NodeKind.UNARY) { return "Unary"; }
        if (kind == NodeKind.BINARY) { return "Binary"; }
        if (kind == NodeKind.ASSIGN) { return "Assign"; }
        if (kind == NodeKind.CALL) { return "Call"; }
        if (kind == NodeKind.CAST) { return "Cast"; }
        if (kind == NodeKind.INDEX) { return "Index"; }
        if (kind == NodeKind.FIELD_ACCESS) { return "FieldAccess"; }
        if (kind == NodeKind.SIZEOF) { return "SizeOf"; }
        return "?";
    }
}

unsafe static mut void* ast_base = null;
unsafe static mut void* ast_atoms = null;
unsafe static mut void* ast_types = null;
unsafe static mut void* ast_lists = null;
unsafe static mut i32 ast_count = 0;
unsafe static mut i32 ast_capacity = 0;
unsafe static mut i32 ast_file = 0;
unsafe static mut void* ast_files = null;

struct Ast {
    public static void init(i32 capacity) {
        Arena* arena = Memory.arena();
        ast_capacity = capacity;
        ast_count = 1;
        ast_base = arena.zalloc((u64)capacity * sizeof(Node), 8);
        ast_atoms = (void*)AtomTable.create(arena);
        ast_types = (void*)PointerList.create();
        ast_lists = (void*)PointerList.create();
        ast_files = (void*)PointerList.create();
    }

    public static void begin_file(i8* path) {
        PointerList* files = (PointerList*)ast_files;
        files.push((void*)path);
        ast_file = files.length - 1;
    }

    public static i8* file_name(i32 index) {
        PointerList* files = (PointerList*)ast_files;
        return (i8*)files.get(index);
    }

    public static Node* at(i32 id) {
        if (id == 0) {
            return (Node*)0;
        }
        i8* base = (i8*)ast_base;
        return (Node*)(base + (i64)id * sizeof(Node));
    }

    public static i32 id_of(Node* node) {
        if (node == null) {
            return 0;
        }
        i8* base = (i8*)ast_base;
        i8* address = (i8*)node;
        return (i32)(((i64)address - (i64)base) / (i64)sizeof(Node));
    }

    public static AtomTable* atoms() {
        return (AtomTable*)ast_atoms;
    }

    public static i32 node_count() {
        return ast_count - 1;
    }
}

struct Node {
    i32 kind;
    i32 op;
    i32 line;
    i32 column;
    i32 file;
    i32 text_atom;
    i32 type_id;
    i32 list_id;
    i32 first_id;
    i32 second_id;
    i32 third_id;
    i32 fourth_id;
    i32 flag_value;
    i32 variadic_value;
    i32 value_low;
    i32 value_high;

    public static Node* create(i32 kind, Token* at) {
        if (ast_count >= ast_capacity) {
logger_error(Log.get(), "djinnc: ast node capacity exceeded (%d)", ast_capacity);
            exit(1);
        }
        Node* node = Ast.at(ast_count);
        ast_count = ast_count + 1;
        node.kind = kind;
        node.line = at.line;
        node.column = at.column;
        node.file = ast_file;
        return node;
    }

    public static Node* create_list(i32 kind, Token* at) {
        Node* node = Node.create(kind, at);
        PointerList* lists = (PointerList*)ast_lists;
        lists.push(PointerList.create());
        node.list_id = lists.length;
        return node;
    }

    public Node* first() {
        return Ast.at(this.first_id);
    }

    public Node* second() {
        return Ast.at(this.second_id);
    }

    public Node* third() {
        return Ast.at(this.third_id);
    }

    public Node* fourth() {
        return Ast.at(this.fourth_id);
    }

    public void set_first(Node* node) {
        this.first_id = Ast.id_of(node);
    }

    public void set_second(Node* node) {
        this.second_id = Ast.id_of(node);
    }

    public void set_third(Node* node) {
        this.third_id = Ast.id_of(node);
    }

    public void set_fourth(Node* node) {
        this.fourth_id = Ast.id_of(node);
    }

    public i8* text() {
        if (this.text_atom == 0) {
            return (i8*)0;
        }
        AtomTable* atoms = Ast.atoms();
        return atoms.text((u32)this.text_atom - 1);
    }

    public void set_text(i8* text) {
        this.set_text_n(text, strlen(text));
    }

    public void set_text_n(i8* text, i32 length) {
        AtomTable* atoms = Ast.atoms();
        this.text_atom = (i32)atoms.intern_copy(text, (u32)length) + 1;
    }

    public TypeRef* type() {
        if (this.type_id == 0) {
            return (TypeRef*)0;
        }
        PointerList* types = (PointerList*)ast_types;
        return (TypeRef*)types.get(this.type_id - 1);
    }

    public void set_type(TypeRef* type) {
        PointerList* types = (PointerList*)ast_types;
        types.push((void*)type);
        this.type_id = types.length;
    }

    public bool flag() {
        return this.flag_value != 0;
    }

    public void set_flag(bool value) {
        this.flag_value = 0;
        if (value) {
            this.flag_value = 1;
        }
    }

    public bool is_variadic() {
        return this.variadic_value != 0;
    }

    public void set_variadic(bool value) {
        this.variadic_value = 0;
        if (value) {
            this.variadic_value = 1;
        }
    }

    public i64 int_value() {
        u64 low = (u64)this.value_low & 4294967295;
        u64 high = (u64)this.value_high & 4294967295;
        return (i64)(low | (high << 32));
    }

    public void set_int_value(i64 value) {
        u64 bits = (u64)value;
        this.value_low = (i32)(bits & 4294967295);
        this.value_high = (i32)(bits >> 32);
    }

    public f64 float_value() {
        i8* literal = this.text();
        return Strings.parse_float(literal, strlen(literal));
    }

    public void add(Node* child) {
        PointerList* list = this.items();
        list.push((void*)Ast.id_of(child));
    }

    public bool has_items() {
        return this.list_id != 0;
    }

    PointerList* items() {
        PointerList* lists = (PointerList*)ast_lists;
        return (PointerList*)lists.get(this.list_id - 1);
    }

    public Node* child(i32 index) {
        PointerList* list = this.items();
        return Ast.at((i32)list.get(index));
    }

    public i32 count() {
        PointerList* list = this.items();
        return list.length;
    }
}
