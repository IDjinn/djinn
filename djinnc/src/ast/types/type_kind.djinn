namespace djinnc;

struct TypeKind {
    const i32 VOID = 0;
    const i32 INTEGER = 1;
    const i32 FLOAT = 2;
    const i32 POINTER = 3;
    const i32 NAMED = 4;
    const i32 AUTO = 5;
    const i32 NONE = 6;
    // A constant given as a template argument ('4' in 'vector<u64, 4>'); its operand is the constant's type.
    const i32 VALUE = 7;
    // An array held inline ('T[N]'); its operand is the element type and its value the element count.
    const i32 ARRAY = 8;
}
