namespace djinnc;

struct GenericParams {
    IdList* names;
    PointerList* bounds;
    IdList* bound_owner;
    // One entry per parameter: the declared type of a value parameter ('i32 N'), or null when the parameter
    // takes anything (a type or a constant), like a C++ template parameter.
    PointerList* value_types;

    public static unsafe GenericParams* create() {
        GenericParams* params = (GenericParams*)Memory.zalloc(sizeof(GenericParams));
        params.names = IdList.create();
        params.bounds = PointerList.create();
        params.bound_owner = IdList.create();
        params.value_types = PointerList.create();
        return params;
    }

    public unsafe TypeRef* value_type(i32 index) {
        PointerList* types = this.value_types;
        if (index < 0 || index >= types.length) {
            return (TypeRef*)0;
        }
        return (TypeRef*)types.get(index);
    }

    public i32 count() {
        IdList* names = this.names;
        return names.length;
    }

    public i32 index_of(u32 atom) {
        IdList* names = this.names;
        for (mut i32 i = 0; i < names.length; i = i + 1) {
            if (names.get(i) == atom) {
                return i;
            }
        }
        return 0 - 1;
    }

    public void add_bound(i32 owner, TypeRef* bound) {
        PointerList* bounds = this.bounds;
        IdList* owners = this.bound_owner;
        bounds.push((ptr)bound);
        owners.push((u32)owner);
    }
}
