namespace djinnc;

struct GenericParams {
    IdList* names;
    PointerList* bounds;
    IdList* bound_owner;

    public static GenericParams* create() {
        GenericParams* params = (GenericParams*)Memory.zalloc(sizeof(GenericParams));
        params.names = IdList.create();
        params.bounds = PointerList.create();
        params.bound_owner = IdList.create();
        return params;
    }

    public i32 count() {
        IdList* names = this.names;
        return names.length;
    }

    public i32 index_of(u32 atom) {
        IdList* names = this.names;
        for (mut i32 i = 0; i < names.length; i = i + 1) {
            if (names.get(i) == atom) {
                return i;
            }
        }
        return 0 - 1;
    }

    public void add_bound(i32 owner, TypeRef* bound) {
        PointerList* bounds = this.bounds;
        IdList* owners = this.bound_owner;
        bounds.push((void*)bound);
        owners.push((u32)owner);
    }
}
