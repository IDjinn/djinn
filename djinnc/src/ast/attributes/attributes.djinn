namespace djinnc;

unsafe static mut void* attribute_uses = null;
unsafe static mut void* declared_attributes = null;

struct Attributes {
    public static PointerList* all() {
        if (attribute_uses == null) {
            attribute_uses = (void*)PointerList.create();
        }
        return (PointerList*)attribute_uses;
    }

    public static void record(AttributeUse* use) {
        PointerList* uses = Attributes.all();
        uses.push((void*)use);
    }

    public static bool has(Node* target, i8* name) {
        PointerList* uses = Attributes.all();
        for (mut i32 i = 0; i < uses.length; i = i + 1) {
            AttributeUse* use = (AttributeUse*)uses.get(i);
            if (use.target == target && Strings.same(use.name, name)) {
                return true;
            }
        }
        return false;
    }

    public static PointerList* declared() {
        if (declared_attributes == null) {
            declared_attributes = (void*)PointerList.create();
        }
        return (PointerList*)declared_attributes;
    }

    public static void declare(i8* name) {
        PointerList* names = Attributes.declared();
        if (!names.contains_string(name)) {
            names.push((void*)name);
        }
    }

    public static PointerList* of(Node* target) {
        PointerList* found = PointerList.create();
        PointerList* uses = Attributes.all();
        for (mut i32 i = 0; i < uses.length; i = i + 1) {
            AttributeUse* use = (AttributeUse*)uses.get(i);
            if (use.target == target) {
                found.push((void*)use);
            }
        }
        return found;
    }

    static bool named(i8* name, i8* literal) {
        return Strings.equals(name, (i32)strlen(name), literal);
    }

    public static i32 allowed_targets(i8* name) {
        i32 callable = AttributeTarget.FUNCTION | AttributeTarget.METHOD;
        if (Attributes.named(name, "ForceInline") || Attributes.named(name, "NoInline") || Attributes.named(name, "NoReturn")
            || Attributes.named(name, "Hot") || Attributes.named(name, "Cold") || Attributes.named(name, "NoSync")
            || Attributes.named(name, "NoUnwind") || Attributes.named(name, "WillReturn") || Attributes.named(name, "NoRecurse")
            || Attributes.named(name, "Llvm")) {
            return callable;
        }
        if (Attributes.named(name, "Align")) {
            return AttributeTarget.STRUCT | AttributeTarget.FIELD | AttributeTarget.PARAMETER;
        }
        if (Attributes.named(name, "Volatile")) {
            return AttributeTarget.FIELD | AttributeTarget.VARIABLE;
        }
        if (Attributes.named(name, "ReadOnly")) {
            return AttributeTarget.FIELD | AttributeTarget.PARAMETER;
        }
        if (Attributes.named(name, "Restrict") || Attributes.named(name, "NoCapture") || Attributes.named(name, "WriteOnly")) {
            return AttributeTarget.PARAMETER;
        }
        if (Attributes.named(name, "NonNull")) {
            return AttributeTarget.PARAMETER | AttributeTarget.RETURN_VALUE;
        }
        if (Attributes.named(name, "Location")) {
            return AttributeTarget.PARAMETER | AttributeTarget.FIELD | AttributeTarget.VARIABLE;
        }
        if (Attributes.named(name, "attribute") || Attributes.named(name, "intrinsic")) {
            return AttributeTarget.STRUCT;
        }
        if (Attributes.named(name, "no_mangle") || Attributes.named(name, "sync")) {
            return callable | AttributeTarget.STRUCT;
        }
        if (Attributes.named(name, "NoMangle")) {
            return callable | AttributeTarget.STRUCT;
        }
        if (Attributes.named(name, "Reflect")) {
            return AttributeTarget.STRUCT;
        }
        if (Attributes.named(name, "Deprecated")) {
            return AttributeTarget.ALL;
        }
        if (Attributes.declared().contains_string(name)) {
            return AttributeTarget.ALL;
        }
        return 0;
    }

    public static i8* llvm_name(i8* name) {
        if (Attributes.named(name, "ForceInline")) { return "alwaysinline"; }
        if (Attributes.named(name, "NoInline")) { return "noinline"; }
        if (Attributes.named(name, "NoReturn")) { return "noreturn"; }
        if (Attributes.named(name, "Hot")) { return "hot"; }
        if (Attributes.named(name, "Cold")) { return "cold"; }
        if (Attributes.named(name, "NoSync")) { return "nosync"; }
        if (Attributes.named(name, "NoUnwind")) { return "nounwind"; }
        if (Attributes.named(name, "WillReturn")) { return "willreturn"; }
        if (Attributes.named(name, "NoRecurse")) { return "norecurse"; }
        return null;
    }

    public static i8* target_name(i32 target_kind) {
        if (target_kind == AttributeTarget.FUNCTION) { return "function"; }
        if (target_kind == AttributeTarget.METHOD) { return "method"; }
        if (target_kind == AttributeTarget.STRUCT) { return "struct"; }
        if (target_kind == AttributeTarget.FIELD) { return "field"; }
        if (target_kind == AttributeTarget.PARAMETER) { return "parameter"; }
        if (target_kind == AttributeTarget.RETURN_VALUE) { return "return value"; }
        if (target_kind == AttributeTarget.VARIABLE) { return "variable"; }
        return "declaration";
    }
}
