namespace djinnc;

i32 main() {
    Options* options = Options.parse();
    if (!options.ok) {
        Options.usage();
        return 2;
    }

    if (options.self_test) {
        return SelfTest.run();
    }

    PerformanceMonitor* monitor = PerformanceMonitor.create("djinnc", options.stats);
    PointerList* inputs = options.inputs;
    inputs.sort_strings();
    logger_info(Log.get(), "djinnc: compiling %d file(s) to '%s'", inputs.length, options.output);
    PointerList* diagnostics_list = PointerList.create();
    mut i64 total_bytes = 0;
    for (mut i32 i = 0; i < inputs.length; i = i + 1) {
        i8* path = (i8*)inputs.get(i);
        i8* source = Files.read_all(path);
        if (source == null) {
            logger_error(Log.get(), "djinnc: cannot read '%s'", path);
            return 1;
        }
        i32 length = strlen(source);
        Sources.add(path, source, (u32)length);
        diagnostics_list.push((void*)Diagnostics.create(path));
        total_bytes = total_bytes + length;
    }
    ByteBuffer* core_path = ByteBuffer.create();
    core_path.append(options.runtime_dir);
    core_path.append("/core.djinn");
    i8* core = Files.read_all(core_path.cstr());
    if (core == null) {
        logger_error(Log.get(), "djinnc: cannot read the core library '%s' (see --runtime-dir)", core_path.cstr());
        return 1;
    }
    i32 core_length = strlen(core);
    Sources.add(core_path.cstr(), core, (u32)core_length);
    diagnostics_list.push((void*)Diagnostics.create(core_path.cstr()));
    total_bytes = total_bytes + core_length;
    i32 source_count = inputs.length + 1;

    TokenList* tokens = TokenList.create((i32)(total_bytes / 3) + 64);
    for (mut i32 i = 0; i < source_count; i = i + 1) {
        SourceFile* file = Sources.get(i);
        Diagnostics* file_diagnostics = (Diagnostics*)diagnostics_list.get(i);
        Lexer* lexer = Lexer.create(file, tokens, file_diagnostics);
        lexer.tokenize();
        if (file_diagnostics.failed()) {
            return 1;
        }
    }
    monitor.lap("lex");
    logger_info(Log.get(), "djinnc: lexed %d tokens", tokens.length);
    if (options.emit_tokens) {
        Dump.tokens(tokens);
        return 0;
    }

    U32Map* type_names = U32Map.create(Memory.arena(), 256);
    for (mut i32 i = 0; i < source_count; i = i + 1) {
        Parser.collect_type_names(tokens, Sources.get(i), type_names);
    }

    Ast.init(tokens.length * 2 + 64);
    Diagnostics* diagnostics = (Diagnostics*)diagnostics_list.get(0);
    Node* program = Node.create_list(NodeKind.PROGRAM, 0);
    for (mut i32 i = 0; i < source_count; i = i + 1) {
        SourceFile* file = Sources.get(i);
        Diagnostics* file_diagnostics = (Diagnostics*)diagnostics_list.get(i);
        Parser* parser = Parser.create(tokens, file, file_diagnostics, type_names);
        Node* unit = parser.parse_program();
        if (file_diagnostics.failed()) {
            return 1;
        }
        for (mut i32 c = 0; c < unit.count(); c = c + 1) {
            program.add(unit.child(c));
        }
    }
    if (options.stats) {
        Arena* arena = Memory.arena();
        printf("files: %d\n", inputs.length);
        printf("tokens: %d (%d bytes)\n", tokens.length, tokens.length * 9);
        printf("ast: %d nodes (%d bytes)\n", Ast.node_count(), Ast.node_count() * (i32)sizeof(Node));
        printf("arena: %d bytes allocated, %d bytes reserved\n", (i32)arena.total_allocated, (i32)arena.total_reserved);
    }
    monitor.lap("parse");
    logger_info(Log.get(), "djinnc: parsed %d ast nodes", Ast.node_count());
    if (options.emit_ast) {
        Dump.node(program, 0);
        return 0;
    }

    CodeGenerator* gen = CodeGenerator.create(diagnostics, options.input);
    if (options.debug) {
        gen.enable_debug((i8*)inputs.get(0), options.optimize);
    }
    if (!gen.generate(program)) {
        return 1;
    }
    monitor.lap("codegen");
    logger_info(Log.get(), "djinnc: generated and verified LLVM module");

    bool ir_only = options.emit_ir || options.no_link;
    if (ir_only || options.keep_ir) {
        ByteBuffer* ir_path = ByteBuffer.create();
        ir_path.append(options.output);
        ir_path.append(".ll");
        if (!gen.write_ir(ir_path.cstr())) {
            return 1;
        }
    }
    monitor.lap("write-ir");
    if (ir_only) {
        monitor.finish();
        return 0;
    }

    ByteBuffer* object_path = ByteBuffer.create();
    object_path.append(options.output);
    object_path.append(".obj");
    if (!gen.write_object(object_path.cstr(), options.optimize)) {
        return 1;
    }

    monitor.lap("object");
    logger_info(Log.get(), "djinnc: wrote object '%s'", object_path.cstr());

    logger_info(Log.get(), "djinnc: linking '%s'", options.output);
    i32 status = Linker.link(options, object_path.cstr());
    monitor.lap("link");
    if (status != 0) {
        logger_error(Log.get(), "djinnc: linking failed (exit %d)", status);
        return 1;
    }
    logger_info(Log.get(), "djinnc: done '%s'", options.output);
    monitor.finish();
    return 0;
}
