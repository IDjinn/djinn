namespace djinnc;

i32 main() {
    Options* options = Options.parse();
    if (!options.ok) {
        Options.usage();
        return 2;
    }

    if (options.self_test) {
        return SelfTest.run();
    }

    i32 started_at = clock();
    PointerList* inputs = options.inputs;
    PointerList* diagnostics_list = PointerList.create();
    mut i64 total_bytes = 0;
    for (mut i32 i = 0; i < inputs.length; i = i + 1) {
        i8* path = (i8*)inputs.get(i);
        i8* source = Files.read_all(path);
        if (source == null) {
            logger_error(Log.get(), "djinnc: cannot read '%s'", path);
            return 1;
        }
        i32 length = strlen(source);
        Sources.add(path, source, (u32)length);
        diagnostics_list.push((void*)Diagnostics.create(path));
        total_bytes = total_bytes + length;
    }

    TokenList* tokens = TokenList.create((i32)(total_bytes / 3) + 64);
    for (mut i32 i = 0; i < inputs.length; i = i + 1) {
        SourceFile* file = Sources.get(i);
        Diagnostics* file_diagnostics = (Diagnostics*)diagnostics_list.get(i);
        Lexer* lexer = Lexer.create(file, tokens, file_diagnostics);
        lexer.tokenize();
        if (file_diagnostics.failed()) {
            return 1;
        }
    }
    if (options.emit_tokens) {
        Dump.tokens(tokens);
        return 0;
    }

    U32Map* type_names = U32Map.create(Memory.arena(), 256);
    for (mut i32 i = 0; i < inputs.length; i = i + 1) {
        Parser.collect_type_names(tokens, Sources.get(i), type_names);
    }

    Ast.init(tokens.length * 2 + 64);
    Diagnostics* diagnostics = (Diagnostics*)diagnostics_list.get(0);
    Node* program = Node.create_list(NodeKind.PROGRAM, 0);
    for (mut i32 i = 0; i < inputs.length; i = i + 1) {
        SourceFile* file = Sources.get(i);
        Diagnostics* file_diagnostics = (Diagnostics*)diagnostics_list.get(i);
        Parser* parser = Parser.create(tokens, file, file_diagnostics, type_names);
        Node* unit = parser.parse_program();
        if (file_diagnostics.failed()) {
            return 1;
        }
        for (mut i32 c = 0; c < unit.count(); c = c + 1) {
            program.add(unit.child(c));
        }
    }
    if (options.stats) {
        Arena* arena = Memory.arena();
        printf("files: %d\n", inputs.length);
        printf("tokens: %d (%d bytes)\n", tokens.length, tokens.length * 9);
        printf("ast: %d nodes (%d bytes)\n", Ast.node_count(), Ast.node_count() * (i32)sizeof(Node));
        printf("arena: %d bytes allocated, %d bytes reserved\n", (i32)arena.total_allocated, (i32)arena.total_reserved);
        printf("ticks: lex+parse %d\n", clock() - started_at);
    }
    if (options.emit_ast) {
        Dump.node(program, 0);
        return 0;
    }

    CodeGenerator* gen = CodeGenerator.create(diagnostics, options.input);
    if (!gen.generate(program)) {
        return 1;
    }

    ByteBuffer* ir_path = ByteBuffer.create();
    ir_path.append(options.output);
    ir_path.append(".ll");
    if (!gen.write_ir(ir_path.cstr())) {
        return 1;
    }
    if (options.emit_ir || options.no_link) {
        return 0;
    }

    i32 status = Linker.link(options, ir_path.cstr());
    if (status != 0) {
        logger_error(Log.get(), "djinnc: linking failed (exit %d)", status);
        return 1;
    }
    return 0;
}
