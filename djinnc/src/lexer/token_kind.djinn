namespace djinnc;

enum TokenKind {
    UNKNOWN,
    END_OF_FILE,
    IDENTIFIER,
    STRING_LITERAL,
    INTEGER_LITERAL,
    FLOAT_LITERAL,
    VOID,
    RETURN,
    AUTO,
    EXTERN,
    STRUCT,
    NAMESPACE,
    IMPORT,
    MUT,
    IF,
    ELSE,
    FOR,
    WHILE,
    DO,
    SWITCH,
    CASE,
    DEFAULT,
    BREAK,
    CONTINUE,
    INTERFACE,
    PUBLIC,
    PRIVATE,
    STATIC,
    THIS,
    ENUM,
    NEW,
    IMPL,
    WHERE,
    ASYNC,
    AWAIT,
    YIELD,
    SPAWN,
    IN,
    TRUE,
    FALSE,
    OPERATOR,
    CONST,
    CONSTEXPR,
    CONSTEVAL,
    MACRO,
    IS,
    NULL,
    THROW,
    THROWS,
    TRY,
    REQUIRE,
    ENSURE,
    LPAREN,
    RPAREN,
    LBRACE,
    RBRACE,
    LBRACKET,
    RBRACKET,
    SEMICOLON,
    COMMA,
    COLON,
    COLON_COLON,
    DOT,
    DOT_DOT,
    DOT_DOT_EQUAL,
    DOT_DOT_DOT,
    PLUS,
    MINUS,
    PLUS_PLUS,
    MINUS_MINUS,
    STAR,
    SLASH,
    PERCENT,
    EQUAL_EQUAL,
    BANG_EQUAL,
    LESS,
    LESS_EQUAL,
    GREATER,
    GREATER_EQUAL,
    BANG,
    AND_AND,
    OR_OR,
    AMPERSAND,
    PIPE,
    CARET,
    TILDE,
    LESS_LESS,
    GREATER_GREATER,
    EQUAL,
    ARROW,
    THIN_ARROW,
    PLUS_EQUAL,
    MINUS_EQUAL,
    STAR_EQUAL,
    SLASH_EQUAL,
    PERCENT_EQUAL,
    AMPERSAND_EQUAL,
    PIPE_EQUAL,
    CARET_EQUAL,
    LESS_LESS_EQUAL,
    GREATER_GREATER_EQUAL,
    AT,
    QUESTION,
    QUESTION_DOT,
    QUESTION_QUESTION,
    QUESTION_QUESTION_EQUAL,
    BANG_DOT,
    UNSAFE,
    INTERP_BEGIN,
    INTERP_MIDDLE,
    INTERP_END,
    INTERP_FORMAT
}

struct TokenKinds {
    const i32 COUNT = 112;    static i32 packed(TokenKind kind, i32 width) {
        return kind.getValue() | (width << 16);
    }

    public static i32 symbol(i8* source, i32 pos, i32 length) {
        i32 c0 = (i32)(u8)source[pos];
        mut i32 c1 = 0;
        mut i32 c2 = 0;
        if (pos + 1 < length) {
            c1 = (i32)(u8)source[pos + 1];
        }
        if (pos + 2 < length) {
            c2 = (i32)(u8)source[pos + 2];
        }
        if (c0 == 46) {
            if (c1 == 46) {
                if (c2 == 61) { return TokenKinds.packed(TokenKind::DOT_DOT_EQUAL, 3); }
                if (c2 == 46) { return TokenKinds.packed(TokenKind::DOT_DOT_DOT, 3); }
                return TokenKinds.packed(TokenKind::DOT_DOT, 2);
            }
            return TokenKinds.packed(TokenKind::DOT, 1);
        }
        if (c0 == 60) {
            if (c1 == 60) {
                if (c2 == 61) { return TokenKinds.packed(TokenKind::LESS_LESS_EQUAL, 3); }
                return TokenKinds.packed(TokenKind::LESS_LESS, 2);
            }
            if (c1 == 61) { return TokenKinds.packed(TokenKind::LESS_EQUAL, 2); }
            return TokenKinds.packed(TokenKind::LESS, 1);
        }
        if (c0 == 62) {
            if (c1 == 62) {
                if (c2 == 61) { return TokenKinds.packed(TokenKind::GREATER_GREATER_EQUAL, 3); }
                return TokenKinds.packed(TokenKind::GREATER_GREATER, 2);
            }
            if (c1 == 61) { return TokenKinds.packed(TokenKind::GREATER_EQUAL, 2); }
            return TokenKinds.packed(TokenKind::GREATER, 1);
        }
        if (c0 == 63) {
            if (c1 == 63) {
                if (c2 == 61) { return TokenKinds.packed(TokenKind::QUESTION_QUESTION_EQUAL, 3); }
                return TokenKinds.packed(TokenKind::QUESTION_QUESTION, 2);
            }
            if (c1 == 46) { return TokenKinds.packed(TokenKind::QUESTION_DOT, 2); }
            return TokenKinds.packed(TokenKind::QUESTION, 1);
        }
        if (c0 == 58) {
            if (c1 == 58) { return TokenKinds.packed(TokenKind::COLON_COLON, 2); }
            return TokenKinds.packed(TokenKind::COLON, 1);
        }
        if (c0 == 43) {
            if (c1 == 43) { return TokenKinds.packed(TokenKind::PLUS_PLUS, 2); }
            if (c1 == 61) { return TokenKinds.packed(TokenKind::PLUS_EQUAL, 2); }
            return TokenKinds.packed(TokenKind::PLUS, 1);
        }
        if (c0 == 45) {
            if (c1 == 45) { return TokenKinds.packed(TokenKind::MINUS_MINUS, 2); }
            if (c1 == 61) { return TokenKinds.packed(TokenKind::MINUS_EQUAL, 2); }
            if (c1 == 62) { return TokenKinds.packed(TokenKind::THIN_ARROW, 2); }
            return TokenKinds.packed(TokenKind::MINUS, 1);
        }
        if (c0 == 61) {
            if (c1 == 61) { return TokenKinds.packed(TokenKind::EQUAL_EQUAL, 2); }
            if (c1 == 62) { return TokenKinds.packed(TokenKind::ARROW, 2); }
            return TokenKinds.packed(TokenKind::EQUAL, 1);
        }
        if (c0 == 33) {
            if (c1 == 61) { return TokenKinds.packed(TokenKind::BANG_EQUAL, 2); }
            if (c1 == 46) { return TokenKinds.packed(TokenKind::BANG_DOT, 2); }
            return TokenKinds.packed(TokenKind::BANG, 1);
        }
        if (c0 == 38) {
            if (c1 == 38) { return TokenKinds.packed(TokenKind::AND_AND, 2); }
            if (c1 == 61) { return TokenKinds.packed(TokenKind::AMPERSAND_EQUAL, 2); }
            return TokenKinds.packed(TokenKind::AMPERSAND, 1);
        }
        if (c0 == 124) {
            if (c1 == 124) { return TokenKinds.packed(TokenKind::OR_OR, 2); }
            if (c1 == 61) { return TokenKinds.packed(TokenKind::PIPE_EQUAL, 2); }
            return TokenKinds.packed(TokenKind::PIPE, 1);
        }
        if (c0 == 42) {
            if (c1 == 61) { return TokenKinds.packed(TokenKind::STAR_EQUAL, 2); }
            return TokenKinds.packed(TokenKind::STAR, 1);
        }
        if (c0 == 47) {
            if (c1 == 61) { return TokenKinds.packed(TokenKind::SLASH_EQUAL, 2); }
            return TokenKinds.packed(TokenKind::SLASH, 1);
        }
        if (c0 == 37) {
            if (c1 == 61) { return TokenKinds.packed(TokenKind::PERCENT_EQUAL, 2); }
            return TokenKinds.packed(TokenKind::PERCENT, 1);
        }
        if (c0 == 94) {
            if (c1 == 61) { return TokenKinds.packed(TokenKind::CARET_EQUAL, 2); }
            return TokenKinds.packed(TokenKind::CARET, 1);
        }
        if (c0 == 40) { return TokenKinds.packed(TokenKind::LPAREN, 1); }
        if (c0 == 41) { return TokenKinds.packed(TokenKind::RPAREN, 1); }
        if (c0 == 123) { return TokenKinds.packed(TokenKind::LBRACE, 1); }
        if (c0 == 125) { return TokenKinds.packed(TokenKind::RBRACE, 1); }
        if (c0 == 91) { return TokenKinds.packed(TokenKind::LBRACKET, 1); }
        if (c0 == 93) { return TokenKinds.packed(TokenKind::RBRACKET, 1); }
        if (c0 == 59) { return TokenKinds.packed(TokenKind::SEMICOLON, 1); }
        if (c0 == 44) { return TokenKinds.packed(TokenKind::COMMA, 1); }
        if (c0 == 126) { return TokenKinds.packed(TokenKind::TILDE, 1); }
        if (c0 == 64) { return TokenKinds.packed(TokenKind::AT, 1); }
        return TokenKinds.packed(TokenKind::UNKNOWN, 1);
    }

    public static i8* text(TokenKind kind) {
        return switch kind {
            VOID -> "void",
            RETURN -> "return",
            AUTO -> "auto",
            EXTERN -> "extern",
            STRUCT -> "struct",
            NAMESPACE -> "namespace",
            IMPORT -> "import",
            MUT -> "mut",
            IF -> "if",
            ELSE -> "else",
            FOR -> "for",
            WHILE -> "while",
            DO -> "do",
            SWITCH -> "switch",
            CASE -> "case",
            DEFAULT -> "default",
            BREAK -> "break",
            CONTINUE -> "continue",
            INTERFACE -> "interface",
            PUBLIC -> "public",
            PRIVATE -> "private",
            STATIC -> "static",
            UNSAFE -> "unsafe",
            THIS -> "this",
            ENUM -> "enum",
            NEW -> "new",
            IMPL -> "impl",
            WHERE -> "where",
            ASYNC -> "async",
            AWAIT -> "await",
            YIELD -> "yield",
            SPAWN -> "spawn",
            IN -> "in",
            TRUE -> "true",
            FALSE -> "false",
            OPERATOR -> "operator",
            CONST -> "const",
            CONSTEXPR -> "constexpr",
            CONSTEVAL -> "consteval",
            MACRO -> "macro",
            IS -> "is",
            NULL -> "null",
            THROW -> "throw",
            THROWS -> "throws",
            TRY -> "try",
            REQUIRE -> "require",
            ENSURE -> "ensure",
            LPAREN -> "(",
            RPAREN -> ")",
            LBRACE -> "{",
            RBRACE -> "}",
            LBRACKET -> "[",
            RBRACKET -> "]",
            SEMICOLON -> ";",
            COMMA -> ",",
            COLON -> ":",
            COLON_COLON -> "::",
            DOT -> ".",
            DOT_DOT -> "..",
            DOT_DOT_EQUAL -> "..=",
            DOT_DOT_DOT -> "...",
            PLUS -> "+",
            MINUS -> "-",
            PLUS_PLUS -> "++",
            MINUS_MINUS -> "--",
            STAR -> "*",
            SLASH -> "/",
            PERCENT -> "%",
            EQUAL_EQUAL -> "==",
            BANG_EQUAL -> "!=",
            LESS -> "<",
            LESS_EQUAL -> "<=",
            GREATER -> ">",
            GREATER_EQUAL -> ">=",
            BANG -> "!",
            AND_AND -> "&&",
            OR_OR -> "||",
            AMPERSAND -> "&",
            PIPE -> "|",
            CARET -> "^",
            TILDE -> "~",
            LESS_LESS -> "<<",
            GREATER_GREATER -> ">>",
            EQUAL -> "=",
            ARROW -> "=>",
            THIN_ARROW -> "->",
            PLUS_EQUAL -> "+=",
            MINUS_EQUAL -> "-=",
            STAR_EQUAL -> "*=",
            SLASH_EQUAL -> "/=",
            PERCENT_EQUAL -> "%=",
            AMPERSAND_EQUAL -> "&=",
            PIPE_EQUAL -> "|=",
            CARET_EQUAL -> "^=",
            LESS_LESS_EQUAL -> "<<=",
            GREATER_GREATER_EQUAL -> ">>=",
            AT -> "@",
            QUESTION -> "?",
            QUESTION_DOT -> "?.",
            QUESTION_QUESTION -> "??",
            QUESTION_QUESTION_EQUAL -> "??=",
            BANG_DOT -> "!.",
            _ -> ""
        };
    }

    public static i8* name(TokenKind kind) {
        return switch kind {
            UNKNOWN -> "UNKNOWN",
            END_OF_FILE -> "END_OF_FILE",
            IDENTIFIER -> "IDENTIFIER",
            STRING_LITERAL -> "STRING_LITERAL",
            INTERP_BEGIN -> "INTERP_BEGIN",
            INTERP_MIDDLE -> "INTERP_MIDDLE",
            INTERP_END -> "INTERP_END",
            INTERP_FORMAT -> "INTERP_FORMAT",
            INTEGER_LITERAL -> "INTEGER_LITERAL",
            FLOAT_LITERAL -> "FLOAT_LITERAL",
            VOID -> "VOID",
            RETURN -> "RETURN",
            AUTO -> "AUTO",
            EXTERN -> "EXTERN",
            STRUCT -> "STRUCT",
            NAMESPACE -> "NAMESPACE",
            IMPORT -> "IMPORT",
            MUT -> "MUT",
            IF -> "IF",
            ELSE -> "ELSE",
            FOR -> "FOR",
            WHILE -> "WHILE",
            DO -> "DO",
            SWITCH -> "SWITCH",
            CASE -> "CASE",
            DEFAULT -> "DEFAULT",
            BREAK -> "BREAK",
            CONTINUE -> "CONTINUE",
            INTERFACE -> "INTERFACE",
            PUBLIC -> "PUBLIC",
            PRIVATE -> "PRIVATE",
            STATIC -> "STATIC",
            UNSAFE -> "UNSAFE",
            THIS -> "THIS",
            ENUM -> "ENUM",
            NEW -> "NEW",
            IMPL -> "IMPL",
            WHERE -> "WHERE",
            ASYNC -> "ASYNC",
            AWAIT -> "AWAIT",
            YIELD -> "YIELD",
            SPAWN -> "SPAWN",
            IN -> "IN",
            TRUE -> "TRUE",
            FALSE -> "FALSE",
            OPERATOR -> "OPERATOR",
            CONST -> "CONST",
            CONSTEXPR -> "CONSTEXPR",
            CONSTEVAL -> "CONSTEVAL",
            MACRO -> "MACRO",
            IS -> "IS",
            NULL -> "NULL",
            THROW -> "THROW",
            THROWS -> "THROWS",
            TRY -> "TRY",
            REQUIRE -> "REQUIRE",
            ENSURE -> "ENSURE",
            LPAREN -> "LPAREN",
            RPAREN -> "RPAREN",
            LBRACE -> "LBRACE",
            RBRACE -> "RBRACE",
            LBRACKET -> "LBRACKET",
            RBRACKET -> "RBRACKET",
            SEMICOLON -> "SEMICOLON",
            COMMA -> "COMMA",
            COLON -> "COLON",
            COLON_COLON -> "COLON_COLON",
            DOT -> "DOT",
            DOT_DOT -> "DOT_DOT",
            DOT_DOT_EQUAL -> "DOT_DOT_EQUAL",
            DOT_DOT_DOT -> "DOT_DOT_DOT",
            PLUS -> "PLUS",
            MINUS -> "MINUS",
            PLUS_PLUS -> "PLUS_PLUS",
            MINUS_MINUS -> "MINUS_MINUS",
            STAR -> "STAR",
            SLASH -> "SLASH",
            PERCENT -> "PERCENT",
            EQUAL_EQUAL -> "EQUAL_EQUAL",
            BANG_EQUAL -> "BANG_EQUAL",
            LESS -> "LESS",
            LESS_EQUAL -> "LESS_EQUAL",
            GREATER -> "GREATER",
            GREATER_EQUAL -> "GREATER_EQUAL",
            BANG -> "BANG",
            AND_AND -> "AND_AND",
            OR_OR -> "OR_OR",
            AMPERSAND -> "AMPERSAND",
            PIPE -> "PIPE",
            CARET -> "CARET",
            TILDE -> "TILDE",
            LESS_LESS -> "LESS_LESS",
            GREATER_GREATER -> "GREATER_GREATER",
            EQUAL -> "EQUAL",
            ARROW -> "ARROW",
            THIN_ARROW -> "THIN_ARROW",
            PLUS_EQUAL -> "PLUS_EQUAL",
            MINUS_EQUAL -> "MINUS_EQUAL",
            STAR_EQUAL -> "STAR_EQUAL",
            SLASH_EQUAL -> "SLASH_EQUAL",
            PERCENT_EQUAL -> "PERCENT_EQUAL",
            AMPERSAND_EQUAL -> "AMPERSAND_EQUAL",
            PIPE_EQUAL -> "PIPE_EQUAL",
            CARET_EQUAL -> "CARET_EQUAL",
            LESS_LESS_EQUAL -> "LESS_LESS_EQUAL",
            GREATER_GREATER_EQUAL -> "GREATER_GREATER_EQUAL",
            AT -> "AT",
            QUESTION -> "QUESTION",
            QUESTION_DOT -> "QUESTION_DOT",
            QUESTION_QUESTION -> "QUESTION_QUESTION",
            QUESTION_QUESTION_EQUAL -> "QUESTION_QUESTION_EQUAL",
            BANG_DOT -> "BANG_DOT",
            _ -> "?"
        };
    }
}
