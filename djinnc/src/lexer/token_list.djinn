namespace djinnc;

unsafe static mut ptr all_tokens = null;

struct TokenList {
    ptr<u8> kinds;
    ptr<u32> starts;
    ptr<u32> atoms;
    i32 length;
    i32 capacity;
    i32 synthetic_base;
    IdList* origins;
    IdList* sites;

    public static unsafe TokenList* create(i32 capacity) {
        Arena* arena = Memory.arena();
        TokenList* list = (TokenList*)arena.zalloc(sizeof(TokenList), 8);
        list.capacity = capacity;
        list.kinds = (ptr<u8>)arena.alloc((u64)capacity, 1);
        list.starts = (ptr<u32>)arena.alloc((u64)capacity * 4, 4);
        list.atoms = (ptr<u32>)arena.alloc((u64)capacity * 4, 4);
        all_tokens = (ptr)list;
        return list;
    }

    public static unsafe TokenList* get() {
        return (TokenList*)all_tokens;
    }

    public static unsafe void restore(TokenList* list) {
        all_tokens = (ptr)list;
    }

    public unsafe void push(TokenKind kind, u32 start, u32 atom) {
        if (this.length == this.capacity) {
            this.grow();
        }
        this.kinds[this.length] = (u8)kind.getValue();
        this.starts[this.length] = start;
        this.atoms[this.length] = atom;
        this.length = this.length + 1;
    }

    // Macro expansions append tokens after every lexed file. Each one keeps the token it was copied from (for its line and
    // file) and the token of the call that produced it (to decide whether it belongs to a library interface).
    public unsafe i32 push_synthetic(TokenKind kind, u32 raw_atom, i32 origin, i32 site) {
        if (this.origins == null) {
            this.synthetic_base = this.length;
            this.origins = IdList.create();
            this.sites = IdList.create();
        }
        i32 located = this.located(origin);
        IdList* origins = this.origins;
        IdList* sites = this.sites;
        origins.push((u32)located);
        sites.push((u32)this.site_of(site));
        i32 index = this.length;
        this.push(kind, this.starts[located], raw_atom);
        return index;
    }

    public bool is_synthetic(i32 index) {
        return this.origins != null && index >= this.synthetic_base;
    }

    public unsafe i32 located(i32 index) {
        if (!this.is_synthetic(index)) {
            return index;
        }
        IdList* origins = this.origins;
        return (i32)origins.get(index - this.synthetic_base);
    }

    public unsafe i32 site_of(i32 index) {
        if (!this.is_synthetic(index)) {
            return index;
        }
        IdList* sites = this.sites;
        return (i32)sites.get(index - this.synthetic_base);
    }

    public unsafe TokenKind kind(i32 index) {
        return (TokenKind)(i32)this.kinds[index];
    }

    public unsafe u32 start(i32 index) {
        return this.starts[index];
    }

    public unsafe u32 atom(i32 index) {
        return this.atoms[index] - 1;
    }

    public unsafe u32 raw_atom(i32 index) {
        return this.atoms[index];
    }    public unsafe ptr<i8> text(i32 index) {
        if (this.atoms[index] == 0) {
            TokenKind kind = this.kind(index);
            if (kind == TokenKind::END_OF_FILE) {
                return "";
            }
            return kind.text;
        }
        AtomTable* table = Atoms.get();
        return table.text(this.atoms[index] - 1);
    }

    public unsafe i32 text_length(i32 index) {
        if (this.atoms[index] == 0) {
            return strlen(this.text(index));
        }
        AtomTable* table = Atoms.get();
        return (i32)table.length(this.atoms[index] - 1);
    }

    public ptr<i8> copy_text(i32 index) {
        return Strings.duplicate(this.text(index), this.text_length(index));
    }

    public unsafe i32 line(i32 index) {
        SourceFile* file = Sources.of_token(index);
        return (i32)file.line_of(this.starts[index]);
    }

    public unsafe i32 column(i32 index) {
        SourceFile* file = Sources.of_token(index);
        return (i32)file.column_of(this.starts[index]);
    }

    void grow() {
        Arena* arena = Memory.arena();
        i32 capacity = this.capacity * 2;
        ptr<u8> kinds = (ptr<u8>)arena.alloc((u64)capacity, 1);
        ptr<u32> starts = (ptr<u32>)arena.alloc((u64)capacity * 4, 4);
        ptr<u32> atoms = (ptr<u32>)arena.alloc((u64)capacity * 4, 4);
        memcpy(kinds, this.kinds, (u64)this.length);
        memcpy(starts, this.starts, (u64)this.length * 4);
        memcpy(atoms, this.atoms, (u64)this.length * 4);
        this.kinds = kinds;
        this.starts = starts;
        this.atoms = atoms;
        this.capacity = capacity;
    }
}
