namespace djinnc;

unsafe static mut void* all_tokens = null;

struct TokenList {
    u8* kinds;
    u32* starts;
    u32* atoms;
    i32 length;
    i32 capacity;

    public static TokenList* create(i32 capacity) {
        Arena* arena = Memory.arena();
        TokenList* list = (TokenList*)arena.zalloc(sizeof(TokenList), 8);
        list.capacity = capacity;
        list.kinds = (u8*)arena.alloc((u64)capacity, 1);
        list.starts = (u32*)arena.alloc((u64)capacity * 4, 4);
        list.atoms = (u32*)arena.alloc((u64)capacity * 4, 4);
        all_tokens = (void*)list;
        return list;
    }

    public static TokenList* get() {
        return (TokenList*)all_tokens;
    }

    public void push(i32 kind, u32 start, u32 atom) {
        if (this.length == this.capacity) {
            this.grow();
        }
        this.kinds[this.length] = (u8)kind;
        this.starts[this.length] = start;
        this.atoms[this.length] = atom;
        this.length = this.length + 1;
    }

    public i32 kind(i32 index) {
        return (i32)this.kinds[index];
    }

    public u32 start(i32 index) {
        return this.starts[index];
    }

    public u32 atom(i32 index) {
        return this.atoms[index] - 1;
    }

    public bool has_atom(i32 index) {
        return this.atoms[index] != 0;
    }

    public i8* text(i32 index) {
        if (this.atoms[index] == 0) {
            i32 kind = this.kind(index);
            if (kind == TokenKind.END_OF_FILE) {
                return "";
            }
            return TokenKind.text(kind);
        }
        AtomTable* table = Atoms.get();
        return table.text(this.atoms[index] - 1);
    }

    public i32 text_length(i32 index) {
        if (this.atoms[index] == 0) {
            return strlen(this.text(index));
        }
        AtomTable* table = Atoms.get();
        return (i32)table.length(this.atoms[index] - 1);
    }

    public i8* copy_text(i32 index) {
        return Strings.duplicate(this.text(index), this.text_length(index));
    }

    public i32 line(i32 index) {
        SourceFile* file = Sources.of_token(index);
        return (i32)file.line_of(this.starts[index]);
    }

    public i32 column(i32 index) {
        SourceFile* file = Sources.of_token(index);
        return (i32)file.column_of(this.starts[index]);
    }

    void grow() {
        Arena* arena = Memory.arena();
        i32 capacity = this.capacity * 2;
        u8* kinds = (u8*)arena.alloc((u64)capacity, 1);
        u32* starts = (u32*)arena.alloc((u64)capacity * 4, 4);
        u32* atoms = (u32*)arena.alloc((u64)capacity * 4, 4);
        memcpy(kinds, this.kinds, (u64)this.length);
        memcpy(starts, this.starts, (u64)this.length * 4);
        memcpy(atoms, this.atoms, (u64)this.length * 4);
        this.kinds = kinds;
        this.starts = starts;
        this.atoms = atoms;
        this.capacity = capacity;
    }
}
