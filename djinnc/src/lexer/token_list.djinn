namespace djinnc;

struct TokenList {
    Token* data;
    i32 length;
    i32 capacity;

    public static TokenList* create(i32 capacity) {
        TokenList* list = (TokenList*)Mem.zalloc(sizeof(TokenList));
        list.capacity = capacity;
        list.data = (Token*)Mem.zalloc((i64)capacity * sizeof(Token));
        return list;
    }

    public void push(i32 kind, i8* text, i32 count, i32 line, i32 column) {
        if (this.length == this.capacity) {
            this.grow();
        }
        Token* token = this.at(this.length);
        token.kind = kind;
        token.text = text;
        token.length = count;
        token.line = line;
        token.column = column;
        this.length = this.length + 1;
    }

    public Token* at(i32 index) {
        i8* base = (i8*)this.data;
        return (Token*)(base + (i64)index * sizeof(Token));
    }

    void grow() {
        i32 newCapacity = this.capacity * 2;
        Token* newData = (Token*)Mem.zalloc((i64)newCapacity * sizeof(Token));
        memcpy(newData, this.data, (u64)this.length * sizeof(Token));
        this.data = newData;
        this.capacity = newCapacity;
    }
}
