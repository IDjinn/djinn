namespace djinnc;

enum OverflowMode {
    NONE,
    WRAPPED,
    TRAPPED,
    CHECKED,
    SATURATING
}

impl OverflowMode {
    bool conflicts(OverflowMode other) {
        return this != OverflowMode::NONE && other != OverflowMode::NONE && this != other;
    }

    OverflowMode merge(OverflowMode other) {
        if (this != OverflowMode::NONE) {
            return this;
        }
        return other;
    }
}

struct OverflowModes {
    public static OverflowMode from_suffix(i32 character) {
        if (character == 119) { return OverflowMode::WRAPPED; }
        if (character == 116) { return OverflowMode::TRAPPED; }
        if (character == 99) { return OverflowMode::CHECKED; }
        if (character == 115) { return OverflowMode::SATURATING; }
        return OverflowMode::NONE;
    }
}
