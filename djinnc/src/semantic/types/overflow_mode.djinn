namespace djinnc;

enum OverflowMode {
    NONE,
    WRAPPED,
    TRAPPED,
    CHECKED,
    SATURATING
}

impl OverflowMode {
    bool conflicts(OverflowMode other) {
        return this != OverflowMode::NONE && other != OverflowMode::NONE && this != other;
    }

    // Without a suffix integer arithmetic is checked: an overflow throws Overflow when the function lists it in
    // 'throws' and stops the program with a report otherwise. Only 'w' wraps and only 's' clamps.
    bool detects_overflow() {
        return this == OverflowMode::NONE || this == OverflowMode::TRAPPED || this == OverflowMode::CHECKED;
    }

    OverflowMode merge(OverflowMode other) {
        if (this != OverflowMode::NONE) {
            return this;
        }
        return other;
    }
}

struct OverflowModes {
    public static OverflowMode from_suffix(char character) {
        if (character == 'w') { return OverflowMode::WRAPPED; }
        if (character == 't') { return OverflowMode::TRAPPED; }
        if (character == 'c') { return OverflowMode::CHECKED; }
        if (character == 's') { return OverflowMode::SATURATING; }
        return OverflowMode::NONE;
    }
}
