namespace djinnc;

impl TypeChecker {
    bool in_unsafe() {
        if (this.unsafe_depth > 0) {
            return true;
        }
        FunctionInfo* current = this.function;
        return current != null && current.is_unsafe;
    }

    void require_unsafe(Node* at, ptr<i8> operation) {
        if (this.in_unsafe()) {
            return;
        }
        ByteBuffer* message = ByteBuffer.create();
        message.append(operation);
        message.append(" needs an 'unsafe' block or an 'unsafe' function");
        this.error_code(at, DiagnosticErrors.UNSAFE_REQUIRED, message.cstr());
    }

    // A [Target("avx2")] function runs instructions the CPU may not have: the caller promises them with the same
    // features, or takes the risk in 'unsafe' after checking the CPU (std::simd::Cpu).
    unsafe void require_target_features(Node* call, FunctionInfo* callee) {
        ptr<i8> needed = CpuFeatures.of(callee.node);
        if (needed == null || !CpuFeatures.applies(needed)) {
            return;
        }
        mut ptr<i8> held = (ptr<i8>)0;
        if (this.function != null) {
            FunctionInfo* caller = this.function;
            held = CpuFeatures.of(caller.node);
        }
        if (CpuFeatures.covers(held, needed)) {
            return;
        }
        ByteBuffer* message = ByteBuffer.create();
        message.append("calling a function compiled for [Target(\"");
        message.append(needed);
        message.append("\")], which the CPU may not have,");
        this.require_unsafe(call, message.cstr());
    }

    void check_pointer_cast(Node* node, u32 target, u32 source) {
        if (Types.is_float(target) && (Types.is_pointer(source) || this.symbols.nullable_payload(source) != 0)) {
            this.error_pointer_to_float(node, target, source);
        }
        if (Types.is_pointer(target) && Types.is_integer(source)) {
            this.require_unsafe(node, "converting an integer to a pointer");
        }
        if (Types.is_raw_pointer(source) && Types.is_pointer(target) && !Types.is_raw_pointer(target)) {
            this.require_unsafe(node, "converting a raw pointer to a typed pointer");
        }
    }

    void error_pointer_to_float(Node* node, u32 target, u32 source) {
        SymbolTable* symbols = this.symbols;
        ByteBuffer* message = ByteBuffer.create();
        message.append("cannot cast '");
        symbols.describe_type(source, message);
        message.append("' to '");
        symbols.describe_type(target, message);
        message.append("': an address is not a floating-point number; cast to 'u64' first to convert its value");
        this.error_code(node, DiagnosticErrors.INVALID_CAST, message.cstr());
    }
}
