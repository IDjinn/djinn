namespace djinnc;

impl TypeChecker {
    bool in_unsafe() {
        if (this.unsafe_depth > 0) {
            return true;
        }
        FunctionInfo* current = this.function;
        return current != null && current.is_unsafe;
    }

    void require_unsafe(Node* at, ptr<i8> operation) {
        if (this.in_unsafe()) {
            return;
        }
        ByteBuffer* message = ByteBuffer.create();
        message.append(operation);
        message.append(" needs an 'unsafe' block or an 'unsafe' function");
        this.error_code(at, DiagnosticErrors.UNSAFE_REQUIRED, message.cstr());
    }

    bool is_native_extern(FunctionInfo* info) {
        return info.node != null && info.node.kind() == NodeKind::EXTERN_FUNCTION;
    }

    void check_pointer_cast(Node* node, u32 target, u32 source) {
        if (Types.is_pointer(target) && Types.is_integer(source)) {
            this.require_unsafe(node, "converting an integer to a pointer");
        }
        if (Types.is_raw_pointer(source) && Types.is_pointer(target) && !Types.is_raw_pointer(target)) {
            this.require_unsafe(node, "converting a raw pointer to a typed pointer");
        }
    }
}
