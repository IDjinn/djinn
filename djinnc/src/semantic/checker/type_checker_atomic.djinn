namespace djinnc;

impl TypeChecker {
    unsafe void check_atomic(Node* node) {
        Node* operands = node.second();
        for (mut i32 i = 0; i < operands.count(); i = i + 1) {
            Node* operand = operands.child(i);
            if (!this.is_addressable(operand)) {
                this.error_code(operand, DiagnosticErrors.ATOMIC_OPERAND, "an atomic operand must be a variable, a field, an element or a dereference");
                continue;
            }
            u32 type = this.check_lvalue(operand);
            if (!Ownership.is_copy(this.symbols, type)) {
                this.error_code(operand, DiagnosticErrors.ATOMIC_OPERAND, "an atomic operand must be a plain value that can be copied");
            }
        }
        this.check_statement(node.first());
    }
}
