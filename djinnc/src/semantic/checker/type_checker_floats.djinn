namespace djinnc;

// Methods every f32/f64 has without std, for the IEEE 754 operations that are not operators. A method with the
// same name declared in an impl block wins. Using an operation the selected revision does not define (fma
// before 2008, minimum/maximum/minimum_number/maximum_number before 2019) is error E3056.
struct FloatBuiltin {
    const i32 NONE = 0;
    const i32 MIN = 1;
    const i32 MAX = 2;
    const i32 MINIMUM = 3;
    const i32 MAXIMUM = 4;
    const i32 MINIMUM_NUMBER = 5;
    const i32 MAXIMUM_NUMBER = 6;
    const i32 FMA = 7;

    public static i32 lookup(ptr<i8> name) {
        if (Strings.same(name, "min")) { return FloatBuiltin.MIN; }
        if (Strings.same(name, "max")) { return FloatBuiltin.MAX; }
        if (Strings.same(name, "minimum")) { return FloatBuiltin.MINIMUM; }
        if (Strings.same(name, "maximum")) { return FloatBuiltin.MAXIMUM; }
        if (Strings.same(name, "minimum_number")) { return FloatBuiltin.MINIMUM_NUMBER; }
        if (Strings.same(name, "maximum_number")) { return FloatBuiltin.MAXIMUM_NUMBER; }
        if (Strings.same(name, "fma")) { return FloatBuiltin.FMA; }
        return FloatBuiltin.NONE;
    }

    public static i32 arguments(i32 builtin) {
        if (builtin == FloatBuiltin.FMA) {
            return 2;
        }
        return 1;
    }

    public static bool needs_minimum(i32 builtin) {
        return builtin >= FloatBuiltin.MINIMUM && builtin <= FloatBuiltin.MAXIMUM_NUMBER;
    }
}

impl TypeChecker {
    unsafe u32 check_float_builtin(Node* node, Node* callee, u32 type, i32 builtin) {
        if (node.count() != FloatBuiltin.arguments(builtin)) {
            this.error_code(node, DiagnosticErrors.WRONG_ARGUMENT_COUNT, "wrong number of arguments");
            return type;
        }
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* argument = node.child(i);
            this.require_value_type(argument, this.check_expression(argument, type), type);
        }
        FloatSettings* settings = FloatSettings.current();
        FloatStandard standard = settings.standard;
        bool missing_minimum = FloatBuiltin.needs_minimum(builtin) && !standard.has_minimum();
        bool missing_fma = builtin == FloatBuiltin.FMA && !standard.has_fma();
        if (missing_minimum || missing_fma) {
            ByteBuffer* message = ByteBuffer.create();
            message.append(callee.text());
            if (missing_fma) {
                message.append(" needs IEEE 754-2008 or later");
            } else {
                message.append(" is an IEEE 754-2019 operation");
            }
            message.append("; it is not available with --ieee754=");
            message.append(standard.name());
            message.append(" (see https://djinn-docs.lucas-romero.com/docs/types/numbers#ieee-754 and https://standards.ieee.org/ieee/754/6210/)");
            this.error_code(callee, DiagnosticErrors.FLOAT_OPERATION_UNAVAILABLE, message.cstr());
        }
        callee.set_symbol(SymbolKind.FLOAT_BUILTIN, (ptr)(u64)builtin);
        return type;
    }
}
