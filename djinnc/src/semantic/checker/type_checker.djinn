namespace djinnc;

struct TypeChecker {
    ConstEval* const_eval;

    Diagnostics* diagnostics;

    SymbolTable* symbols;

    LocalScopes* scopes;

    FunctionInfo* function;

    u32 scope;

    i32 loop_depth;

    i32 switch_depth;

    i32 unsafe_depth;

    i32 span_start;
    i32 span_end;

    Node* assign_target;
    bool negated_literal;

    Node* try_target;

    PointerList* borrows;
    PointerList* scan_path;

    public static unsafe TypeChecker* create(Diagnostics* diagnostics, SymbolTable* symbols) {
        TypeChecker* checker = (TypeChecker*)Memory.zalloc(sizeof(TypeChecker));
        checker.borrows = PointerList.create();
        checker.scan_path = PointerList.create();
        checker.diagnostics = diagnostics;
        checker.symbols = symbols;
        checker.scopes = LocalScopes.create();
        checker.const_eval = ConstEval.create(checker);
        return checker;
    }

    void error(Node* at, ptr<i8> message) {
        this.error_code(at, DiagnosticErrors.SEMANTIC, message);
    }

    void error_code(Node* at, i32 code, ptr<i8> message) {
        Diagnostics* diagnostics = this.diagnostics;
        diagnostics.error_span(code, at.file_name(), at.line(), at.column(), at.length(), message);
    }

    void warning_code(Node* at, i32 code, ptr<i8> message) {
        Diagnostics* diagnostics = this.diagnostics;
        diagnostics.warning_in(code, at.file_name(), at.line(), at.column(), message);
    }

    public u32 resolve_type(TypeRef* ref, Node* at) {
        SymbolTable* symbols = this.symbols;
        symbols.blame = at;
        u32 resolved = symbols.resolve_type(ref, this.scope);
        if (resolved == 0) {
            this.error_code(at, DiagnosticErrors.UNKNOWN_TYPE, "unknown type");
            return Types.i32_type();
        }
        return resolved;
    }

    public unsafe bool run() {
        SymbolTable* symbols = this.symbols;
        PointerList* structs = symbols.structs;
        for (mut i32 i = 0; i < structs.length; i = i + 1) {
            StructInfo* info = (StructInfo*)structs.get(i);
            if (info.is_template) {
                continue;
            }
            symbols.bindings = info.bindings;
            PointerList* constants = info.constants;
            for (mut i32 c = 0; c < constants.length; c = c + 1) {
                Node* constant = (Node*)constants.get(c);
                this.check_constant(constant, info.namespace_id);
                if (info.header_count > 0) {
                    this.check_enum_row(info, constant);
                }
            }
            symbols.bindings = (U32Map*)0;
        }
        PointerList* primitives = symbols.primitives;
        for (mut i32 i = 0; i < primitives.length; i = i + 1) {
            StructInfo* info = (StructInfo*)primitives.get(i);
            PointerList* constants = info.constants;
            for (mut i32 c = 0; c < constants.length; c = c + 1) {
                this.check_constant((Node*)constants.get(c), info.namespace_id);
            }
        }
        PointerList* globals = symbols.globals;
        for (mut i32 i = 0; i < globals.length; i = i + 1) {
            this.check_global((LocalVariable*)globals.get(i));
        }
        this.check_attribute_payloads();
        PointerList* functions = symbols.functions;
        for (mut i32 i = 0; i < functions.length; i = i + 1) {
            FunctionInfo* info = (FunctionInfo*)functions.get(i);
            if (!info.is_extern && !info.is_template && info.check_state == 0) {
                this.check_function(info);
            }
        }
        Diagnostics* diagnostics = this.diagnostics;
        return !diagnostics.failed();
    }

    public u32 check_expression(Node* node, u32 expected) {
        u32 type = this.compute_expression(node, expected);
        node.set_value_type(type);
        node.set_mode(this.compute_mode(node));
        return type;
    }

    unsafe u32 compute_expression(Node* node, u32 expected) {
        NodeKind kind = node.kind();

        switch (kind) {
            case INT_LITERAL:
                bool negated = this.negated_literal;
                this.negated_literal = false;
                if (expected != 0 && Types.is_integer(expected)) {
                    this.require_literal_fits(node, expected, negated);
                }
                if (expected != 0 && (Types.is_float(expected) || Types.is_integer(expected))) {
                    return expected;
                }
                if (node.int_value() > 2147483647) {
                    return Types.i64_type();
                }
                return Types.i32_type();
            case FLOAT_LITERAL:
                if (expected != 0 && Types.is_float(expected)) {
                    return expected;
                }
                return Types.floating(64);
            case STRING_LITERAL:
                u32 text_type = this.core_type("str");
                u32 owned_type = this.core_type("string");
                if (expected != 0 && (expected == text_type || expected == owned_type)) {
                    return expected;
                }
                return Types.byte_pointer();
            case ARRAY_LITERAL:
                return this.check_array_literal(node, expected);
            case BOOL_LITERAL:
                return Types.bool_type();
            case NULL_LITERAL:
                return this.check_null(expected);
            case IDENTIFIER:
                u32 named = this.type_name_operand(node, expected);
                if (named != 0) {
                    node.set_symbol(SymbolKind.TYPE, (ptr)(u64)named);
                    return expected;
                }
                return this.fold_constant(node, this.check_lvalue(node));
            case INDEX:
                return this.check_lvalue(node);
            case FIELD_ACCESS:
                return this.check_member(node);
            case UNARY:
                return this.check_unary(node, expected);
            case BINARY:
                return this.check_binary(node, expected);
            case ASSIGN:
                return this.check_assign(node);
            case CALL:
                return this.check_call(node, expected);
            case CAST:
                u32 target = this.resolve_type(node.type(), node);
                mut u32 operand_hint = target;
                if (this.narrows_literal_arithmetic(node.first(), target)) {
                    operand_hint = 0;
                }
                u32 source = this.check_expression(node.first(), operand_hint);
                this.check_pointer_cast(node, target, source);
                this.check_constant_cast(node, source, target);
                return target;
            case SWITCH_EXPR:
                return this.check_switch_expression(node, expected);
            case STRUCT_INIT:
                return this.check_struct_init(node, expected);
            case IS_EXPR:
                return this.check_is(node);
            case AWAIT_EXPR:
                return this.check_await(node);
            case TRY_EXPR:
                return this.check_try(node, expected);
            case LET_EXPR:
                return this.check_let(node, expected);
            case NEW_EXPR:
                return this.check_new(node);
            case INTERPOLATION:
                return this.check_interpolation(node, expected);
            case INTRINSIC:
                return this.check_intrinsic_expression(node);
        }

        this.error_code(node, DiagnosticErrors.NOT_SUPPORTED_YET, "expression is not supported yet");
        return Types.i32_type();
    }

    unsafe u32 measured_type_of_operand(Node* node) {
        TypeRef* reference = node.type();
        if (reference.kind == TypeKind.NAMED && reference.args == null) {
            LocalVariable* variable = this.find_variable(reference.name_atom);
            SymbolTable* symbols = this.symbols;
            if (variable != null && symbols.find_struct(reference.full_atom, reference.name_atom, this.scope) == null) {
                return variable.type;
            }
        }
        return this.resolve_type(reference, node);
    }

    unsafe u32 check_intrinsic_expression(Node* node) {
        if (node.op() != Intrinsic.SIZEOF && node.op() != Intrinsic.ALIGNOF) {
            return this.check_intrinsic(node);
        }
        mut u32 measured = 0;
        if (node.type() == null) {
            measured = this.check_expression(node.first(), 0);
        } else {
            measured = this.measured_type_of_operand(node);
        }
        if (Types.is_void(measured) || measured == Types.auto_type()) {
            this.error_code(node, DiagnosticErrors.NOT_SUPPORTED_YET, "sizeof and alignof of this type are not supported yet");
        }
        node.set_symbol(SymbolKind.TYPE, (ptr)(u64)measured);
        return Types.integer(Target.pointer_bits(), false);
    }
}
