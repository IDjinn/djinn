namespace djinnc;

struct TypeChecker {
    ConstEval* const_eval;

    Diagnostics* diagnostics;

    SymbolTable* symbols;

    LocalScopes* scopes;

    FunctionInfo* function;

    u32 scope;

    i32 loop_depth;

    i32 switch_depth;

    i32 unsafe_depth;

    i32 span_start;
    i32 span_end;

    Node* assign_target;
    bool negated_literal;

    Node* try_target;
    Node* returned_value;

    PointerList* borrows;
    PointerList* scan_path;

    LambdaScope* lambda;

    i64 template_value;
    u32 folded_type;

    public static unsafe TypeChecker* create(Diagnostics* diagnostics, SymbolTable* symbols) {
        TypeChecker* checker = (TypeChecker*)Memory.zalloc(sizeof(TypeChecker));
        checker.borrows = PointerList.create();
        checker.scan_path = PointerList.create();
        checker.diagnostics = diagnostics;
        checker.symbols = symbols;
        checker.scopes = LocalScopes.create();
        checker.const_eval = ConstEval.create(checker);
        symbols.checker = checker;
        return checker;
    }

    void error(Node* at, ptr<i8> message) {
        this.error_code(at, DiagnosticErrors.SEMANTIC, message);
    }

    void error_code(Node* at, i32 code, ptr<i8> message) {
        Diagnostics* diagnostics = this.diagnostics;
        diagnostics.error_span(code, at.file_name(), at.line(), at.column(), at.length(), message);
    }

    // Underlines the whole argument list of a call ('(' ... ')') instead of just the '(' token.
    void error_arguments(Node* call, i32 code, ptr<i8> message) {
        if (call.kind() != NodeKind::CALL) {
            this.error_code(call, code, message);
            return;
        }
        Diagnostics* diagnostics = this.diagnostics;
        diagnostics.error_span(code, call.file_name(), call.arguments_line(), call.arguments_column(), call.arguments_length(), message);
    }

    void warning_code(Node* at, i32 code, ptr<i8> message) {
        Diagnostics* diagnostics = this.diagnostics;
        diagnostics.warning_in(code, at.file_name(), at.line(), at.column(), message);
    }

    public u32 resolve_type(TypeRef* ref, Node* at) {
        SymbolTable* symbols = this.symbols;
        symbols.blame = at;
        symbols.template_failed = false;
        u32 resolved = symbols.resolve_type(ref, this.scope);
        if (resolved == 0 && ref.is_brain_float()) {
            this.error_code(at, DiagnosticErrors.BRAIN_FLOAT_UNAVAILABLE, "bf16 is not available on this target (x86, ARM, AArch64 and RISC-V only)");
            return Types.i32_type();
        }
        if (resolved == 0 && symbols.template_failed) {
            return Types.i32_type();
        }
        if (resolved == 0) {
            this.error_code(at, DiagnosticErrors.UNKNOWN_TYPE, "unknown type");
            return Types.i32_type();
        }
        this.reject_unfit_array(resolved, at);
        return resolved;
    }

    // The most scalar values the inline arrays of one type may hold. Such a value is copied and passed as one LLVM
    // value, which makes the compiler very slow, and then crashes it, as it grows.
    const i64 MAX_INLINE_VALUES = 4096;
    const i32 MAX_VALUE_NESTING = 64;

    // Scalar values that 'type' holds in inline arrays (all of them when 'inside' one), counting just past the limit.
    unsafe i64 inline_values(u32 type, bool inside, i32 depth) {
        i64 over = TypeChecker.MAX_INLINE_VALUES + 1;
        if (Types.is_array(type)) {
            i64 each = this.inline_values(Types.element(type), true, depth + 1);
            i64 length = Types.value_of(type);
            if (each > 0 && length > TypeChecker.MAX_INLINE_VALUES / each) {
                return over;
            }
            return length * each;
        }
        mut PointerList* fields = (PointerList*)0;
        if (Types.is_struct(type) && depth < TypeChecker.MAX_VALUE_NESTING) {
            SymbolTable* symbols = this.symbols;
            StructInfo* info = symbols.struct_at(Types.struct_index(type));
            if (info != null && !info.is_enum) {
                fields = info.fields;
            }
        }
        if (fields == null) {
            if (inside) {
                return 1;
            }
            return 0;
        }
        mut i64 total = 0;
        for (mut i32 f = 0; f < fields.length && total < over; f = f + 1) {
            FieldInfo* field = (FieldInfo*)fields.get(f);
            total = total + this.inline_values(field.type, inside, depth + 1);
        }
        if (total > over) {
            return over;
        }
        return total;
    }

    // An inline array is copied bit for bit and never disposed, so its elements must be trivially copyable, and it
    // cannot be larger than the compiler can copy.
    unsafe void reject_unfit_array(u32 type, Node* at) {
        if (!Types.is_array(type)) {
            return;
        }
        if (this.inline_values(type, false, 0) > TypeChecker.MAX_INLINE_VALUES) {
            SymbolTable* described = this.symbols;
            ByteBuffer* name = ByteBuffer.create();
            described.describe_type(type, name);
            this.report_inline_size(name.cstr(), at);
            return;
        }
        mut u32 element = Types.element(type);
        while (Types.is_array(element)) {
            element = Types.element(element);
        }
        SymbolTable* symbols = this.symbols;
        if (Ownership.is_copy(symbols, element)) {
            return;
        }
        ByteBuffer* message = ByteBuffer.create();
        message.append("an inline array holds trivially copyable elements, and '");
        symbols.describe_type(element, message);
        message.append("' owns resources: use an arr<T> or a List instead");
        this.error_code(at, DiagnosticErrors.INVALID_ARRAY_SIZE, message.cstr());
    }

    unsafe void report_inline_size(ptr<i8> name, Node* at) {
        ByteBuffer* message = ByteBuffer.create();
        message.append("'");
        message.append(name);
        message.append("' holds more than ");
        message.append_int(TypeChecker.MAX_INLINE_VALUES);
        message.append(" values in inline arrays, which are copied as a whole: use an arr<T> or a List for a buffer this large");
        this.error_code(at, DiagnosticErrors.INVALID_ARRAY_SIZE, message.cstr());
    }

    public unsafe bool run() {
        SymbolTable* symbols = this.symbols;
        PointerList* structs = symbols.structs;
        for (mut i32 i = 0; i < structs.length; i = i + 1) {
            StructInfo* info = (StructInfo*)structs.get(i);
            if (info.is_template) {
                continue;
            }
            symbols.bindings = info.bindings;
            PointerList* constants = info.constants;
            for (mut i32 c = 0; c < constants.length; c = c + 1) {
                Node* constant = (Node*)constants.get(c);
                this.check_constant(constant, info.namespace_id);
                if (info.header_count > 0) {
                    this.check_enum_row(info, constant);
                }
            }
            symbols.bindings = (U32Map*)0;
        }
        PointerList* primitives = symbols.primitives;
        for (mut i32 i = 0; i < primitives.length; i = i + 1) {
            StructInfo* info = (StructInfo*)primitives.get(i);
            PointerList* constants = info.constants;
            for (mut i32 c = 0; c < constants.length; c = c + 1) {
                this.check_constant((Node*)constants.get(c), info.namespace_id);
            }
        }
        PointerList* globals = symbols.globals;
        for (mut i32 i = 0; i < globals.length; i = i + 1) {
            this.check_global((LocalVariable*)globals.get(i));
        }
        this.check_attribute_payloads();
        this.check_abi_functions();
        this.check_foreign_refinements();
        this.check_generic_definitions();
        PointerList* functions = symbols.functions;
        for (mut i32 i = 0; i < functions.length; i = i + 1) {
            FunctionInfo* info = (FunctionInfo*)functions.get(i);
            if (!info.is_extern && !info.is_template && info.check_state == 0) {
                this.check_function(info);
            }
        }
        this.check_held_arrays();
        Diagnostics* diagnostics = this.diagnostics;
        return !diagnostics.failed();
    }

    // Runs last: checking a body creates instances, and their fields and signatures may hold inline arrays.
    unsafe void check_held_arrays() {
        SymbolTable* symbols = this.symbols;
        PointerList* structs = symbols.structs;
        for (mut i32 i = 0; i < structs.length; i = i + 1) {
            StructInfo* info = (StructInfo*)structs.get(i);
            PointerList* held_fields = info.fields;
            if (info.is_template || held_fields == null || info.node == null) {
                continue;
            }
            mut i64 held = 0;
            mut bool field_too_large = false;
            for (mut i32 f = 0; f < held_fields.length; f = f + 1) {
                FieldInfo* field = (FieldInfo*)held_fields.get(f);
                mut Node* at = field.node;
                if (at == null) {
                    at = info.node;
                }
                this.reject_unfit_array(field.type, at);
                i64 values = this.inline_values(field.type, false, 0);
                held = held + values;
                if (values > TypeChecker.MAX_INLINE_VALUES) {
                    field_too_large = true;
                }
            }
            // Fields that each fit can still add up to too much.
            if (!field_too_large && !info.is_enum && held > TypeChecker.MAX_INLINE_VALUES) {
                this.report_inline_size(info.name, info.node);
            }
        }
        PointerList* functions = symbols.functions;
        for (mut i32 i = 0; i < functions.length; i = i + 1) {
            FunctionInfo* info = (FunctionInfo*)functions.get(i);
            Node* declaration = info.node;
            IdList* types = info.param_types;
            if (info.is_extern || info.is_template || declaration == null || types == null) {
                continue;
            }
            mut i32 declared = 0;
            while (declared < declaration.count() && declaration.child(declared).kind() == NodeKind::PARAMETER) {
                declared = declared + 1;
            }
            i32 receiver = types.length - declared;
            for (mut i32 p = 0; p < declared && receiver >= 0; p = p + 1) {
                this.reject_unfit_array(types.get(receiver + p), declaration.child(p));
            }
        }
    }

    // Runs before the instances are checked, so an error both find is reported once, as the generic declares it.
    void check_generic_definitions() {
        Diagnostics* diagnostics = this.diagnostics;
        diagnostics.settling = true;
        GenericDefinitionCheck* generics = GenericDefinitionCheck.create(this);
        generics.run();
        diagnostics.settling = false;
    }

    unsafe u32 value_inside_nullable_context(u32 expected) {
        SymbolTable* symbols = this.symbols;
        u32 payload = symbols.nullable_value_payload(expected);
        if (payload != 0) {
            return payload;
        }
        return expected;
    }

    public u32 check_expression(Node* node, u32 expected) {
        node.set_text_conversion(0);
        u32 type = this.compute_expression(node, this.operand_hint_of(node, expected));
        node.set_value_type(type);
        node.set_mode(this.compute_mode(node));
        return type;
    }

    unsafe u32 compute_expression(Node* node, u32 expected) {
        NodeKind kind = node.kind();

        switch (kind) {
            case INT_LITERAL:
                bool negated = this.negated_literal;
                this.negated_literal = false;
                if (node.flag()) {
                    return Types.char_type();
                }
                if (expected != 0 && Types.is_integer(expected) && !Types.is_char(expected)) {
                    this.require_literal_fits(node, expected, negated);
                }
                if (expected != 0 && !Types.is_char(expected) && (Types.is_float(expected) || Types.is_integer(expected))) {
                    return expected;
                }
                if (node.int_value() > 2147483647) {
                    return Types.i64_type();
                }
                return Types.i32_type();
            case FLOAT_LITERAL:
                if (expected != 0 && Types.is_float(expected)) {
                    return expected;
                }
                return Types.floating(64);
            case FLOAT_CONST:
                return node.value_type();
            case STRING_LITERAL:
                u32 text_type = this.core_type("str");
                u32 owned_type = this.core_type("string");
                if (expected != 0 && (expected == text_type || expected == owned_type)) {
                    return expected;
                }
                return Types.byte_pointer();
            case ARRAY_LITERAL:
                return this.check_array_literal(node, this.value_inside_nullable_context(expected));
            case BOOL_LITERAL:
                return Types.bool_type();
            case NULL_LITERAL:
                return this.check_null(expected);
            case IDENTIFIER:
                if (this.folds_template_constant(node)) {
                    if (this.folded_type != 0) {
                        return this.folded_type;
                    }
                    return this.compute_expression(node, expected);
                }
                u32 converted = this.check_function_as_closure(node, expected);
                if (converted != 0) {
                    return converted;
                }
                u32 named = this.type_name_operand(node, expected);
                if (named != 0) {
                    node.set_symbol(SymbolKind.TYPE, (ptr)(u64)named);
                    return expected;
                }
                return this.fold_constant(node, this.check_lvalue(node));
            case INDEX:
                return this.check_lvalue(node);
            case FIELD_ACCESS:
                return this.check_member(node);
            case UNARY:
                return this.check_unary(node, expected);
            case BINARY:
                return this.check_binary(node, expected);
            case ASSIGN:
                return this.check_assign(node);
            case CALL:
                return this.check_call(node, expected);
            case CAST:
                u32 target = this.resolve_type(node.type(), node);
                if (node.op() != CastForm.RAW) {
                    SymbolTable* cast_symbols = this.symbols;
                    AliasInfo* refinement = cast_symbols.refinement_of(target);
                    if (refinement != null) {
                        return this.check_refinement_cast(node, refinement);
                    }
                    if (node.op() == CastForm.FORCED) {
                        this.error_code(node, DiagnosticErrors.FORCED_CAST_TARGET, "'(T!)x' builds a refinement type; this type has no predicate");
                    }
                }
                mut u32 operand_hint = target;
                if (this.narrows_literal_arithmetic(node.first(), target)) {
                    operand_hint = 0;
                }
                u32 source = this.check_expression(node.first(), operand_hint);
                this.check_pointer_cast(node, target, source);
                this.check_constant_cast(node, source, target);
                return target;
            case SWITCH_EXPR:
                return this.check_switch_expression(node, expected);
            case STRUCT_INIT:
                return this.check_struct_init(node, this.value_inside_nullable_context(expected));
            case IS_EXPR:
                return this.check_is(node);
            case AWAIT_EXPR:
                return this.check_await(node);
            case TRY_EXPR:
                return this.check_try(node, expected);
            case THROW_STMT:
                this.check_throw(node);
                return expected;
            case LET_EXPR:
                return this.check_let(node, expected);
            case COND_EXPR:
                return this.check_conditional(node, expected);
            case NEW_EXPR:
                return this.check_new(node);
            case INTERPOLATION:
                return this.check_interpolation(node, expected);
            case INTRINSIC:
                return this.check_intrinsic_expression(node);
            case LAMBDA:
                return this.check_lambda(node, expected);
        }

        this.error_code(node, DiagnosticErrors.NOT_SUPPORTED_YET, "expression is not supported yet");
        return Types.i32_type();
    }

    // 'N' of 'struct S<T, N>' inside an instance: the name becomes the literal it was given, so it folds,
    // sizes arrays and adapts to the integer type around it like any literal does.
    unsafe bool folds_template_constant(Node* node) {
        SymbolTable* symbols = this.symbols;
        U32Map* bindings = symbols.bindings;
        if (bindings == null || node.text_atom() != node.name() || this.find_variable(node.name()) != null) {
            return false;
        }
        i64 bound = bindings.find(node.name());
        if (bound < 0 || !Types.is_value((u32)bound)) {
            return false;
        }
        u32 type = Types.element((u32)bound);
        i64 value = Types.value_of((u32)bound);
        if (Types.bits(type) == 1 || Types.enum_index(type) >= 0) {
            ConstEval* evaluator = this.const_eval;
            evaluator.ri = value;
            evaluator.rf = (f64)value;
            evaluator.fold(node, type);
            this.folded_type = type;
            return true;
        }
        this.folded_type = 0;
        node.flags = (u16)0;
        node.set_kind(NodeKind::INT_LITERAL);
        node.set_int_value(value);
        ByteBuffer* digits = ByteBuffer.create();
        digits.append_int(value);
        node.set_text(digits.cstr());
        node.set_flag(Types.is_char(type));
        return true;
    }

    unsafe u32 measured_type_of_operand(Node* node) {
        TypeRef* reference = node.type();
        if (reference.kind == TypeKind.NAMED && reference.args == null) {
            LocalVariable* variable = this.find_variable(reference.name_atom);
            SymbolTable* symbols = this.symbols;
            if (variable != null && symbols.find_struct(reference.full_atom, reference.name_atom, this.scope) == null) {
                return variable.type;
            }
        }
        return this.resolve_type(reference, node);
    }

    // 'type_trait(T, integer)', 'same_type(A, B)': folded to a bool literal here, so 'if constexpr' can branch
    // on them in generic code and only the taken branch is checked.
    unsafe u32 check_type_question(Node* node) {
        u32 subject = this.resolve_type(node.type(), node);
        mut bool answer = false;
        if (node.op() == Intrinsic.SAME_TYPE) {
            Node* other = node.first();
            answer = subject == this.resolve_type(other.type(), node);
        } else {
            SymbolTable* symbols = this.symbols;
            bool is_enum = symbols.enum_of_type(subject) != null;
            bool flag = Types.is_integer(subject) && Types.bits(subject) == 1;
            bool integer = Types.is_integer(subject) && !flag && !Types.is_char(subject) && !is_enum;
            ptr<i8> trait = node.text();
            if (Strings.same(trait, "integer")) {
                answer = integer;
            } else if (Strings.same(trait, "signed")) {
                answer = (integer && Types.is_signed(subject)) || Types.is_float(subject);
            } else if (Strings.same(trait, "unsigned")) {
                answer = integer && !Types.is_signed(subject);
            } else if (Strings.same(trait, "float")) {
                answer = Types.is_float(subject);
            } else if (Strings.same(trait, "number")) {
                answer = integer || Types.is_float(subject);
            } else if (Strings.same(trait, "bool")) {
                answer = flag;
            } else if (Strings.same(trait, "char")) {
                answer = Types.is_char(subject);
            } else if (Strings.same(trait, "pointer")) {
                answer = Types.is_pointer(subject);
            } else if (Strings.same(trait, "enum")) {
                answer = is_enum;
            } else if (Strings.same(trait, "struct")) {
                answer = Types.is_struct(subject) && !is_enum;
            } else if (Strings.same(trait, "array")) {
                answer = Types.is_array(subject);
            } else if (Strings.same(trait, "copyable")) {
                answer = Ownership.is_copy(symbols, subject);
            } else {
                this.error_code(node, DiagnosticErrors.INVALID_TYPE_TRAIT, "unknown trait: expected integer, signed, unsigned, float, number, bool, char, pointer, struct, enum, array or copyable");
            }
        }
        node.flags = (u16)0;
        node.set_kind(NodeKind::BOOL_LITERAL);
        if (answer) {
            node.set_int_value(1);
        } else {
            node.set_int_value(0);
        }
        return Types.bool_type();
    }

    unsafe u32 check_intrinsic_expression(Node* node) {
        if (node.op() == Intrinsic.TYPE_TRAIT || node.op() == Intrinsic.SAME_TYPE) {
            return this.check_type_question(node);
        }
        if (node.op() != Intrinsic.SIZEOF && node.op() != Intrinsic.ALIGNOF) {
            return this.check_intrinsic(node);
        }
        mut u32 measured = 0;
        if (node.type() == null) {
            measured = this.check_expression(node.first(), 0);
        } else {
            measured = this.measured_type_of_operand(node);
        }
        if (Types.is_void(measured) || measured == Types.auto_type()) {
            this.error_code(node, DiagnosticErrors.NOT_SUPPORTED_YET, "sizeof and alignof of this type are not supported yet");
        }
        node.set_symbol(SymbolKind.TYPE, (ptr)(u64)measured);
        return Types.integer(Target.pointer_bits(), false);
    }
}
