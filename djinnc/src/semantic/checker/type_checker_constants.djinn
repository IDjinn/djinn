namespace djinnc;

impl TypeChecker {
    unsafe void check_constant(Node* member, u32 namespace_id) {
        this.scope = namespace_id;
        this.function = (FunctionInfo*)0;
        LocalScopes* scopes = this.scopes;
        scopes.reset_to(0);
        this.check_expression(member.first(), member.value_type());
    }

    void check_enum_row(StructInfo* info, Node* variant) {
        Node* declaration = info.node;
        if (variant.count() != info.header_count) {
            this.error_code(variant, DiagnosticErrors.MISSING_ENUM_FIELD_VALUE, "an enum variant must give a value for every enum field");
            return;
        }
        for (mut i32 k = 0; k < variant.count(); k = k + 1) {
            Node* header = declaration.child(k);
            this.check_expression(variant.child(k), this.resolve_type(header.type(), header));
        }
    }

    unsafe void check_global(LocalVariable* variable) {
        if (variable.const_state != 0) {
            return;
        }
        this.scope = variable.namespace_id;
        this.function = (FunctionInfo*)0;
        LocalScopes* scopes = this.scopes;
        scopes.reset_to(0);
        Node* declaration = variable.node;
        declaration.set_value_type(variable.type);
        if (declaration.op() == 0) {
            variable.const_state = 3;
            this.require_value_type(declaration.first(), this.check_expression(declaration.first(), variable.type), variable.type);
            return;
        }
        variable.const_state = 1;
        this.require_value_type(declaration.first(), this.check_expression(declaration.first(), variable.type), variable.type);
        this.evaluate_variable(variable, declaration);
    }

    public void ensure_checked(FunctionInfo* info) {
        if (info.check_state != 0 || info.is_extern || info.is_template) {
            return;
        }
        CheckState* state = this.enter_nested();
        this.check_function(info);
        this.leave_nested(state);
    }

    // Folds a constant template argument ('(N * 2)', 'LANES', 'square(N)') in the namespace that wrote it.
    // Returns its type, or 0 when it is not an integer, bool, char or enum constant (reported here).
    public unsafe u32 evaluate_template_constant(Node* expression, u32 expected, u32 scope) {
        CheckState* state = this.enter_nested();
        this.scope = scope;
        this.function = (FunctionInfo*)0;
        Diagnostics* diagnostics = this.diagnostics;
        i32 errors_before = diagnostics.errors;
        mut u32 type = this.check_expression(expression, expected);
        if (diagnostics.errors != errors_before) {
            this.leave_nested(state);
            return 0;
        }
        ConstEval* evaluator = this.const_eval;
        if (!Types.is_integer(type) || !evaluator.evaluate(expression, type, type)) {
            mut Node* at = evaluator.failure_node;
            if (at == null || !Types.is_integer(type)) {
                at = expression;
            }
            this.error_code(at, DiagnosticErrors.INVALID_TEMPLATE_CONSTANT, "a constant template argument must be an integer, bool, char or enum known at compile time");
            type = 0;
        }
        this.template_value = evaluator.ri;
        this.leave_nested(state);
        return type;
    }

    public void ensure_global(LocalVariable* variable) {
        if (variable.const_state != 0 || variable.node == null) {
            return;
        }
        CheckState* state = this.enter_nested();
        this.check_global(variable);
        this.leave_nested(state);
    }

    void error_reason(Node* at, ptr<i8> prefix, ptr<i8> reason) {
        ByteBuffer* message = ByteBuffer.create();
        message.append(prefix);
        message.append(reason);
        this.error_code(at, DiagnosticErrors.INVALID_CONSTANT_EXPRESSION, message.cstr());
    }

    void evaluate_variable(LocalVariable* variable, Node* declaration) {
        Node* initial = declaration.first();
        if (initial == null) {
            this.error_code(declaration, DiagnosticErrors.CONSTEXPR_NEEDS_INITIALIZER, "a constexpr variable needs an initializer");
            variable.const_state = 3;
            return;
        }
        if (variable.type == this.core_type("string")) {
            this.error_code(declaration, DiagnosticErrors.INVALID_CONSTANT_EXPRESSION, "a constexpr variable cannot be a string: it must own heap memory, use str");
            variable.const_state = 3;
            return;
        }
        if (this.array_element(variable.type) != 0 || initial.kind() == NodeKind::STRUCT_INIT) {
            this.evaluate_static_data_variable(variable, initial);
            return;
        }
        ConstEval* evaluator = this.const_eval;
        if (evaluator.evaluate(initial, initial.value_type(), variable.type)) {
            variable.const_int = evaluator.ri;
            variable.const_float = evaluator.rf;
            variable.const_state = 2;
            evaluator.fold(initial, variable.type);
            return;
        }
        variable.const_state = 3;
        mut Node* at = evaluator.failure_node;
        if (at == null) {
            at = initial;
        }
        this.error_reason(at, "not a compile-time constant: ", evaluator.failure);
    }

    // A constexpr array or struct global becomes read-only static data (const_state 4 for an array, 5 for a struct): no
    // allocation per use. Its leaves are numbers, booleans, chars and text literals (str, string), nested in array
    // literals and struct initializers.
    void evaluate_static_data_variable(LocalVariable* variable, Node* initial) {
        if (!this.is_static_data(initial, variable.type)) {
            variable.const_state = 3;
            return;
        }
        if (this.array_element(variable.type) != 0) {
            variable.const_state = 4;
        } else {
            variable.const_state = 5;
        }
    }

    unsafe bool is_static_data(Node* node, u32 type) {
        u32 element = this.array_element(type);
        if (element != 0) {
            if (node.kind() != NodeKind::ARRAY_LITERAL) {
                this.error_code(node, DiagnosticErrors.INVALID_CONSTANT_EXPRESSION, "a constexpr array must be an array literal of numbers, booleans, chars, text or structs");
                return false;
            }
            for (mut i32 i = 0; i < node.count(); i = i + 1) {
                if (!this.is_static_data(node.child(i), element)) {
                    return false;
                }
            }
            return true;
        }
        if (type == this.core_type("str") || type == this.core_type("string")) {
            if (node.kind() != NodeKind::STRING_LITERAL) {
                this.error_code(node, DiagnosticErrors.INVALID_CONSTANT_EXPRESSION, "a constexpr text field must be a string literal");
                return false;
            }
            return true;
        }
        if (Types.is_struct(type)) {
            if (node.kind() != NodeKind::STRUCT_INIT) {
                this.error_code(node, DiagnosticErrors.INVALID_CONSTANT_EXPRESSION, "a constexpr struct is built with a brace initializer: { .field = value }");
                return false;
            }
            for (mut i32 i = 0; i < node.count(); i = i + 1) {
                Node* field_initializer = node.child(i);
                FieldInfo* field = (FieldInfo*)field_initializer.symbol();
                if (field == null || !this.is_static_data(field_initializer.first(), field.type)) {
                    return false;
                }
            }
            return true;
        }
        ConstEval* evaluator = this.const_eval;
        if (!evaluator.evaluate(node, node.value_type(), type)) {
            mut Node* at = evaluator.failure_node;
            if (at == null) {
                at = node;
            }
            this.error_reason(at, "not a compile-time constant: ", evaluator.failure);
            return false;
        }
        evaluator.fold(node, type);
        return true;
    }

    void check_compile_time_if(Node* node) {
        Node* condition = node.first();
        this.check_condition(condition);
        ConstEval* evaluator = this.const_eval;
        if (!evaluator.evaluate(condition, condition.value_type(), Types.bool_type())) {
            mut Node* at = evaluator.failure_node;
            if (at == null) {
                at = condition;
            }
            this.error_reason(at, "compile-time condition is not constant: ", evaluator.failure);
            node.set_op(3);
            return;
        }
        if (evaluator.ri != 0) {
            node.set_op(2);
            this.check_statement(node.second());
            return;
        }
        node.set_op(3);
        if (node.third() != null) {
            this.check_statement(node.third());
        }
    }

    void check_constant_operands(Node* node, TokenKind op, u32 common) {
        bool division = op == TokenKind::SLASH || op == TokenKind::PERCENT;
        bool shift = op == TokenKind::LESS_LESS || op == TokenKind::GREATER_GREATER;
        if ((!division && !shift) || !Types.is_integer(common)) {
            return;
        }
        ConstEval* evaluator = this.const_eval;
        Node* amount = node.second();
        if (!evaluator.evaluate(amount, amount.value_type(), amount.value_type())) {
            return;
        }
        i64 value = evaluator.ri;
        if (division && value == 0) {
            this.error_code(amount, DiagnosticErrors.INVALID_CONSTANT_EXPRESSION, "division by zero");
        }
        if (shift && (value < 0 || value >= (i64)Types.bits(common))) {
            this.error_code(amount, DiagnosticErrors.INVALID_CONSTANT_EXPRESSION, "shift amount is out of range");
        }
        if (op == TokenKind::SLASH && value == 0 - 1 && Types.is_signed(common)) {
            Node* dividend = node.first();
            if (evaluator.evaluate(dividend, dividend.value_type(), common) && evaluator.ri == ConstEval.minimum(ConstEval.describe(common))) {
                this.error_code(node, DiagnosticErrors.INVALID_CONSTANT_EXPRESSION, "integer overflow: the minimum value divided by -1");
            }
        }
    }

    void require_literal_fits(Node* node, u32 type, bool negated) {
        if (Types.bits(type) == 1) {
            mut i64 flag = node.int_value();
            if (negated) {
                flag = 0 - flag;
            }
            if (flag != 0 && flag != 1) {
                this.error_code(node, DiagnosticErrors.INVALID_CONSTANT_EXPRESSION, "only 0 or 1 can be converted to bool");
            }
            return;
        }
        if (node.mode() == OverflowMode::WRAPPED || node.mode() == OverflowMode::SATURATING) {
            return;
        }
        mut i64 value = node.int_value();
        if (negated) {
            value = 0w - value;
        }
        if (!ConstEval.holds(value, !negated, ConstEval.describe(type))) {
            this.error_code(node, DiagnosticErrors.INVALID_CONSTANT_EXPRESSION, "integer literal does not fit in its type (the w suffix wraps it, the s suffix clamps it)");
        }
    }

    bool is_literal_arithmetic(Node* node) {
        NodeKind kind = node.kind();
        if (kind == NodeKind::INT_LITERAL) {
            return true;
        }
        if (kind == NodeKind::UNARY) {
            TokenKind unary = node.op_kind();
            return (unary == TokenKind::MINUS || unary == TokenKind::TILDE) && this.is_literal_arithmetic(node.first());
        }
        if (kind != NodeKind::BINARY) {
            return false;
        }
        TokenKind op = node.op_kind();
        bool arithmetic = this.is_arithmetic_operator(op) || op == TokenKind::AMPERSAND || op == TokenKind::PIPE
            || op == TokenKind::CARET || op == TokenKind::LESS_LESS || op == TokenKind::GREATER_GREATER;
        return arithmetic && this.is_literal_arithmetic(node.first()) && this.is_literal_arithmetic(node.second());
    }

    // Arithmetic on literals is computed in its own type and only then narrowed, so (u8)(200 + 100) is an error like
    // (u8)300 instead of wrapping inside u8. Wider targets keep taking their type from the cast.
    bool narrows_literal_arithmetic(Node* operand, u32 target) {
        if (operand.kind() == NodeKind::INT_LITERAL || !Types.is_integer(target)) {
            return false;
        }
        return Types.bits(target) > 1 && Types.bits(target) < 32 && this.is_literal_arithmetic(operand);
    }

    void check_constant_cast(Node* node, u32 source, u32 target) {
        if (source == target || !Types.is_integer(target)) {
            return;
        }
        ConstEval* evaluator = this.const_eval;
        Node* operand = node.first();
        if ((!Types.is_float(source) && !Types.is_integer(source)) || !evaluator.evaluate(operand, source, source)) {
            return;
        }
        if (Types.bits(target) == 1) {
            if (Types.is_float(source)) {
                if (evaluator.rf != 0.0 && evaluator.rf != 1.0) {
                    this.error_code(node, DiagnosticErrors.INVALID_CONSTANT_EXPRESSION, "only 0 or 1 can be converted to bool");
                }
            } else if (evaluator.ri != 0 && evaluator.ri != 1) {
                this.error_code(node, DiagnosticErrors.INVALID_CONSTANT_EXPRESSION, "only 0 or 1 can be converted to bool");
            }
            return;
        }
        // the mode of the cast is only stored on the node after it is checked, so it is read from the written type
        TypeRef* written = node.type();
        if (!Types.is_float(source) && written != null && (written.mode == OverflowMode::SATURATING || written.mode == OverflowMode::WRAPPED)) {
            return;
        }
        i32 shape = ConstEval.describe(target);
        if (Types.is_float(source)) {
            if (!ConstEval.fits(evaluator.rf, shape)) {
                this.error_code(node, DiagnosticErrors.INVALID_CONSTANT_EXPRESSION, "float value is out of range for the integer type");
            }
        } else if (!ConstEval.holds(evaluator.ri, !Types.is_signed(source), shape)) {
            this.error_code(node, DiagnosticErrors.INVALID_CONSTANT_EXPRESSION, "integer constant does not fit in the target type");
        }
    }

    unsafe u32 fold_constant(Node* node, u32 type) {
        i32 symbol_kind = node.symbol_kind();
        if (symbol_kind != SymbolKind.LOCAL && symbol_kind != SymbolKind.GLOBAL) {
            return type;
        }
        LocalVariable* variable = (LocalVariable*)node.symbol();
        if (variable.const_state == 0 && symbol_kind == SymbolKind.GLOBAL && variable.node != null) {
            Node* declaration = variable.node;
            if (declaration.op() != 0) {
                this.ensure_global(variable);
            }
        }
        if (variable.const_state != 2) {
            return type;
        }
        ConstEval* evaluator = this.const_eval;
        evaluator.ri = variable.const_int;
        evaluator.rf = variable.const_float;
        evaluator.fold(node, variable.type);
        return variable.type;
    }

    void fold_call(Node* node, FunctionInfo* info) {
        ConstEval* evaluator = this.const_eval;
        if (evaluator.evaluate(node, info.return_type, info.return_type)) {
            evaluator.fold(node, info.return_type);
            return;
        }
        FunctionInfo* current = this.function;
        bool inside_compile_time = current != null && current.const_kind != 0;
        if (info.const_kind == 2 && !inside_compile_time) {
            mut Node* at = evaluator.failure_node;
            if (at == null) {
                at = node;
            }
            this.error_reason(at, "consteval call is not a constant expression: ", evaluator.failure);
        }
    }
}
