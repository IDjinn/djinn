namespace djinnc;

impl TypeChecker {
    unsafe Node* provided_constant(Node* member, u32 type, i64 value) {
        mut Node* literal = Node.create(NodeKind::INT_LITERAL, member.token);
        if (type == Types.bool_type()) {
            literal = Node.create(NodeKind::BOOL_LITERAL, member.token);
        }
        literal.set_int_value(value);
        literal.set_value_type(type);
        Node* constant = Node.create(NodeKind::STATIC_VAR, member.token);
        constant.set_first(literal);
        constant.set_value_type(type);
        return constant;
    }

    unsafe Node* provided_flag(Node* member, bool value) {
        mut i64 raw = 0;
        if (value) {
            raw = 1;
        }
        return this.provided_constant(member, Types.bool_type(), raw);
    }

    unsafe Node* intrinsic_constant(Node* base, Node* member) {
        ptr<i8> group = base.text();
        ptr<i8> name = member.text();
        if (Strings.same(group, "Platform")) {
            if (Strings.same(name, "Windows")) { return this.provided_flag(member, Target.is_windows()); }
            if (Strings.same(name, "Linux")) { return this.provided_flag(member, Target.is_linux()); }
            if (Strings.same(name, "MacOs")) { return this.provided_flag(member, Target.is_macos()); }
            if (Strings.same(name, "Embedded")) { return this.provided_flag(member, Target.is_embedded()); }
        }
        if (Strings.same(group, "Arch")) {
            if (Strings.same(name, "X64")) { return this.provided_flag(member, Target.is_x64()); }
            if (Strings.same(name, "X86")) { return this.provided_flag(member, Target.is_x86()); }
            if (Strings.same(name, "Arm64")) { return this.provided_flag(member, Target.is_arm64()); }
        }
        if (Strings.same(group, "Build")) {
            if (Strings.same(name, "Debug")) { return this.provided_flag(member, Target.is_debug()); }
            if (Strings.same(name, "Release")) { return this.provided_flag(member, !Target.is_debug()); }
        }
        if (Strings.same(group, "ABI")) {
            if (Strings.same(name, "SysV")) { return this.provided_flag(member, Target.is_sysv_abi()); }
            if (Strings.same(name, "Win64")) { return this.provided_flag(member, Target.is_win64_abi()); }
        }
        if (Strings.same(group, "Endian")) {
            if (Strings.same(name, "Little")) { return this.provided_flag(member, !Target.is_big_endian()); }
            if (Strings.same(name, "Big")) { return this.provided_flag(member, Target.is_big_endian()); }
        }
        if (Strings.same(group, "CPU")) {
            if (Strings.same(name, "sse")) { return this.provided_flag(member, Target.is_x64()); }
            if (Strings.same(name, "sse2")) { return this.provided_flag(member, Target.is_x64()); }
            if (Strings.same(name, "sse3")) { return this.provided_flag(member, Target.has_x64_feature("sse3")); }
            if (Strings.same(name, "ssse3")) { return this.provided_flag(member, Target.has_x64_feature("ssse3")); }
            if (Strings.same(name, "sse4_1")) { return this.provided_flag(member, Target.has_x64_feature("sse4.1")); }
            if (Strings.same(name, "sse4_2")) { return this.provided_flag(member, Target.has_x64_feature("sse4.2")); }
            if (Strings.same(name, "avx")) { return this.provided_flag(member, Target.has_x64_feature("avx")); }
            if (Strings.same(name, "avx2")) { return this.provided_flag(member, Target.has_x64_feature("avx2")); }
            if (Strings.same(name, "avx512f")) { return this.provided_flag(member, Target.has_x64_feature("avx512f")); }
            if (Strings.same(name, "fma")) { return this.provided_flag(member, Target.has_x64_feature("fma")); }
            if (Strings.same(name, "bmi")) { return this.provided_flag(member, Target.has_x64_feature("bmi")); }
            if (Strings.same(name, "bmi2")) { return this.provided_flag(member, Target.has_x64_feature("bmi2")); }
            if (Strings.same(name, "popcnt")) { return this.provided_flag(member, Target.has_x64_feature("popcnt")); }
            if (Strings.same(name, "lzcnt")) { return this.provided_flag(member, Target.has_x64_feature("lzcnt")); }
            if (Strings.same(name, "aes")) { return this.provided_flag(member, Target.has_x64_feature("aes")); }
            if (Strings.same(name, "sse_full")) {
                return this.provided_flag(member, Target.is_x64() && Target.has_x64_feature("sse3") && Target.has_x64_feature("ssse3")
                    && Target.has_x64_feature("sse4.1") && Target.has_x64_feature("sse4.2"));
            }
            if (Strings.same(name, "avx_full")) {
                return this.provided_flag(member, Target.has_x64_feature("avx") && Target.has_x64_feature("avx2")
                    && Target.has_x64_feature("fma") && Target.has_x64_feature("avx512f"));
            }
            if (Strings.same(name, "neon")) { return this.provided_flag(member, Target.is_arm64()); }
        }
        if (Strings.same(group, "Threads") && Strings.same(name, "supported")) {
            return this.provided_flag(member, Target.supports_threads());
        }
        if (Strings.same(group, "Runtime")) {
            if (Strings.same(name, "PointerSize")) {
                return this.provided_constant(member, Types.i32_type(), (i64)(Target.pointer_bits() / 8));
            }
        }
        return (Node*)0;
    }
}
