namespace djinnc;

impl TypeChecker {
    unsafe bool names_fit(Node* call, FunctionInfo* info) {
        Node* declaration = info.node;
        if (declaration == null || declaration.count() != call.count()) {
            return false;
        }
        mut bool named_seen = false;
        IdList* taken = IdList.create();
        for (mut i32 i = 0; i < call.count(); i = i + 1) {
            taken.push(0);
        }
        for (mut i32 i = 0; i < call.count(); i = i + 1) {
            Node* argument = call.child(i);
            if (argument.kind() != NodeKind::NAMED_ARG) {
                if (named_seen) {
                    return false;
                }
                taken.data[i] = 1;
            } else {
                named_seen = true;
                i32 position = this.parameter_index(declaration, argument.text());
                if (position < 0 || taken.get(position) != 0) {
                    return false;
                }
                taken.data[position] = 1;
            }
        }
        return true;
    }

    i32 parameter_index(Node* declaration, ptr<i8> name) {
        for (mut i32 i = 0; i < declaration.count(); i = i + 1) {
            Node* member = declaration.child(i);
            if (strcmp(member.text(), name) == 0) {
                return i;
            }
        }
        return 0 - 1;
    }

    unsafe FunctionInfo* apply_named_arguments(Node* call, FunctionInfo* head) {
        mut bool named = false;
        for (mut i32 i = 0; i < call.count(); i = i + 1) {
            Node* candidate = call.child(i);
            if (candidate.kind() == NodeKind::NAMED_ARG) {
                named = true;
            }
        }
        if (!named || head == null) {
            return head;
        }
        mut FunctionInfo* candidate = head;
        while (candidate != null) {
            if (this.names_fit(call, candidate)) {
                Node* declaration = candidate.node;
                i32 count = call.count();
                Node** ordered = (Node**)Memory.zalloc((u64)count * 8);
                for (mut i32 i = 0; i < count; i = i + 1) {
                    Node* argument = call.child(i);
                    if (argument.kind() == NodeKind::NAMED_ARG) {
                        ordered[this.parameter_index(declaration, argument.text())] = argument.first();
                    } else {
                        ordered[i] = argument;
                    }
                }
                for (mut i32 i = 0; i < count; i = i + 1) {
                    call.set_child(i, ordered[i]);
                }
                return candidate;
            }
            candidate = candidate.overload;
        }
        this.error_code(call, DiagnosticErrors.NO_MATCHING_OVERLOAD, "no declaration matches these argument names");
        for (mut i32 i = 0; i < call.count(); i = i + 1) {
            Node* argument = call.child(i);
            if (argument.kind() == NodeKind::NAMED_ARG) {
                call.set_child(i, argument.first());
            }
        }
        return head;
    }

    unsafe bool extern_hidden(FunctionInfo* candidate, Node* at) {
        SymbolTable* symbols = this.symbols;
        if (!symbols.strict_externs || !candidate.is_extern || candidate.is_public) {
            return false;
        }
        Node* declaration = candidate.node;
        if (declaration == null || declaration.kind() != NodeKind::EXTERN_FUNCTION) {
            return false;
        }
        if (CoreLibrary.contains(declaration.file_name())) {
            return false;
        }
        if (candidate.is_internal) {
            return candidate.home_scope != this.scope;
        }
        return !Strings.same(declaration.file_name(), at.file_name());
    }

    unsafe i32 visibility(u32 home) {
        if (home == this.scope) {
            return 2;
        }
        SymbolTable* symbols = this.symbols;
        NamespaceInfo* info = symbols.namespace_at(this.scope);
        if (info.imports != null) {
            IdList* imports = info.imports;
            for (mut i32 i = 0; i < imports.length; i = i + 1) {
                if (imports.get(i) == home) {
                    return 1;
                }
            }
        }
        return 0;
    }

    unsafe void extend_span(Node* node, i32 line) {
        if (node == null) {
            return;
        }
        if (node.line() == line) {
            if (node.column() < this.span_start) {
                this.span_start = node.column();
            }
            mut i32 end = node.column() + node.length();
            if (node.kind() == NodeKind::STRING_LITERAL) {
                end = end + 2;
            }
            if (end > this.span_end) {
                this.span_end = end;
            }
        }
        this.extend_span(node.first(), line);
        this.extend_span(node.second(), line);
        this.extend_span(node.third(), line);
        if (node.kind() == NodeKind::CALL) {
            for (mut i32 i = 0; i < node.count(); i = i + 1) {
                this.extend_span(node.child(i), line);
            }
            if (node.arguments_line() == line) {
                i32 closing = node.first_argument_token() < 0 ? node.column() + 2 : node.arguments_column() + node.arguments_length() + 1;
                if (closing > this.span_end) {
                    this.span_end = closing;
                }
            }
        }
        if (node.kind() == NodeKind::INDEX && node.line() == line) {
            this.span_end = this.span_end + 1;
        }
    }

    unsafe void error_over_expression(Node* at, i32 code, ptr<i8> message) {
        this.span_start = at.column();
        this.span_end = at.column();
        this.extend_span(at, at.line());
        Diagnostics* diagnostics = this.diagnostics;
        diagnostics.error_span(code, at.file_name(), at.line(), this.span_start, this.span_end - this.span_start, message);
    }

    unsafe i32 first_unfit_argument(Node* call, IdList* params, IdList* types, i32 offset, i32 fixed) {
        for (mut i32 i = 0; i < call.count() && i < fixed; i = i + 1) {
            u32 expected = params.get(i + offset);
            u32 actual = types.get(i);
            bool literal = call.child(i).kind() == NodeKind::STRING_LITERAL;
            bool numbers = (Types.is_integer(actual) || Types.is_float(actual)) && (Types.is_integer(expected) || Types.is_float(expected));
            bool pointers = Types.is_pointer(actual) && Types.is_pointer(expected) && !literal
                && (Types.element(actual) == Types.element(expected) || Types.is_void(Types.element(actual)) || Types.is_void(Types.element(expected)));
            bool text = literal && (expected == this.core_type("str") || expected == this.core_type("string")
                || (Types.is_pointer(expected) && (Types.element(expected) == Types.element(actual) || Types.is_void(Types.element(expected)))));
            if (actual != 0 && actual != expected && !numbers && !pointers && !text) {
                return i;
            }
        }
        return 0 - 1;
    }

    unsafe void error_unfit_argument(Node* call, FunctionInfo* candidate, IdList* types, i32 index, i32 offset) {
        SymbolTable* symbols = this.symbols;
        ByteBuffer* message = ByteBuffer.create();
        message.append("invalid argument ");
        message.append_int(index + 1);
        message.append(": got '");
        if (call.child(index).kind() == NodeKind::STRING_LITERAL) {
            message.append("str");
        } else {
            symbols.describe_type(types.get(index), message);
        }
        message.append("', '");
        mut i32 base_length = 0;
        while (candidate.name[base_length] != 0 && candidate.name[base_length] != 36) {
            base_length = base_length + 1;
        }
        message.append_slice(candidate.name, base_length);
        message.append("' requires '");
        symbols.describe_type(candidate.param_types.get(index + offset), message);
        message.append("'");
        this.error_over_expression(call.child(index), DiagnosticErrors.NO_MATCHING_OVERLOAD, message.cstr());
    }

    unsafe FunctionInfo* pick_overload(FunctionInfo* head, Node* call, i32 offset) {
        SymbolTable* symbols = this.symbols;
        IdList* types = IdList.create();
        for (mut i32 i = 0; i < call.count(); i = i + 1) {
            Node* argument = call.child(i);
            if (argument.kind() == NodeKind::STRUCT_INIT) {
                types.push(0);
            } else {
                types.push(this.check_expression(argument, 0));
            }
        }
        mut FunctionInfo* best = (FunctionInfo*)0;
        mut i32 best_score = 0 - 1;
        mut bool ambiguous = false;
        mut FunctionInfo* sole = (FunctionInfo*)0;
        mut i32 sole_count = 0;
        mut i32 sole_bad = 0 - 1;
        mut FunctionInfo* candidate = head;
        while (candidate != null) {
            IdList* params = candidate.param_types;
            i32 fixed = params.length - offset;
            bool arity_ok = call.count() == fixed || (candidate.is_variadic && call.count() >= fixed) || (call.count() + 1 == fixed && this.takes_location(candidate));
            if (!candidate.is_template && arity_ok && !this.extern_hidden(candidate, call)) {
                mut i32 score = 0;
                mut bool fits = true;
                for (mut i32 i = 0; i < call.count() && i < fixed; i = i + 1) {
                    u32 expected = params.get(i + offset);
                    u32 actual = types.get(i);
                    if (actual == 0) {
                        if (Types.is_struct(expected)) {
                            score = score + 1;
                        } else {
                            fits = false;
                        }
                    } else if (call.child(i).kind() == NodeKind::STRING_LITERAL) {
                        if (expected == this.core_type("str")) {
                            score = score + 5;
                        } else if (expected == this.core_type("string")) {
                            score = score + 3;
                        } else if (Types.is_pointer(expected) && (Types.element(expected) == Types.element(actual) || Types.is_void(Types.element(expected)))) {
                            score = score + 2;
                        } else {
                            fits = false;
                        }
                    } else if (actual == expected) {
                        score = score + 4;
                    } else if ((Types.is_integer(actual) || Types.is_float(actual)) && (Types.is_integer(expected) || Types.is_float(expected))) {
                        score = score + 1;
                    } else if (Types.is_pointer(actual) && Types.is_pointer(expected)) {
                        if (Types.element(actual) == Types.element(expected)) {
                            score = score + 3;
                        } else if (Types.is_void(Types.element(actual)) || Types.is_void(Types.element(expected))) {
                            score = score + 1;
                        } else {
                            fits = false;
                        }
                        if (Types.is_raw_pointer(actual) == Types.is_raw_pointer(expected)) {
                            score = score + 1;
                        }
                    } else {
                        fits = false;
                    }
                }
                if (!fits) {
                    sole = candidate;
                    sole_count = sole_count + 1;
                    sole_bad = this.first_unfit_argument(call, params, types, offset, fixed);
                }
                if (fits) {
                    if (candidate.is_extern) {
                        score = score + this.visibility(candidate.home_scope) * 1000;
                    }
                    if (score > best_score) {
                        best = candidate;
                        best_score = score;
                        ambiguous = false;
                    } else if (score == best_score) {
                        if (!(candidate.is_extern && best.is_extern && symbols.same_extern_declaration(best, candidate))) {
                            ambiguous = true;
                        }
                    }
                }
            }
            candidate = candidate.overload;
        }
        if (best == null) {
            if (sole_count == 1 && sole_bad >= 0) {
                this.error_unfit_argument(call, sole, types, sole_bad, offset);
            } else {
                this.error_code(call, DiagnosticErrors.NO_MATCHING_OVERLOAD, TypeChecker.named_message("no overload of '", call.first().text(), "' accepts these argument types"));
            }
            return (FunctionInfo*)0;
        }
        if (ambiguous) {
            this.error_code(call, DiagnosticErrors.AMBIGUOUS_CALL, "call is ambiguous between overloads");
            return (FunctionInfo*)0;
        }
        return best;
    }

    FunctionInfo* check_constructor_arguments(Node* node, StructInfo* owner) {
        SymbolTable* symbols = this.symbols;
        mut FunctionInfo* constructor = symbols.find_method(owner, Ast.intern_base_name(".ctor", 5));
        constructor = this.apply_named_arguments(node, constructor);
        if (constructor != null && constructor.overload != null) {
            constructor = this.pick_overload(constructor, node, 1);
            if (constructor == null) {
                return constructor;
            }
        }
        if (constructor == null) {
            if (node.count() > 0) {
                this.error_arguments(node, DiagnosticErrors.INVALID_CONSTRUCTOR_CALL, "struct has no constructor");
            }
            for (mut i32 i = 0; i < node.count(); i = i + 1) {
                this.check_expression(node.child(i), 0);
            }
            return constructor;
        }
        IdList* params = constructor.param_types;
        if (params.length != node.count() + 1) {
            this.error_arguments(node, DiagnosticErrors.INVALID_CONSTRUCTOR_CALL, "wrong number of constructor arguments");
            return constructor;
        }
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            u32 passed = this.check_expression(node.child(i), params.get(i + 1));
            this.move_argument(node.child(i), passed, params.get(i + 1), constructor);
        }
        return constructor;
    }

    unsafe void move_argument(Node* argument, u32 passed, u32 wanted, FunctionInfo* callee) {
        SymbolTable* symbols = this.symbols;
        if (Ownership.moves_argument(symbols, callee, wanted, passed)) {
            this.move_from(argument, (Node*)0);
        }
    }

    u32 check_result_part(Node* part, u32 expected, bool returned) {
        Node* saved_returned = this.returned_value;
        if (returned) {
            this.returned_value = part;
        }
        u32 type = this.check_expression(part, expected);
        this.returned_value = saved_returned;
        return type;
    }

    unsafe void check_payload(Node* argument, u32 wanted, bool returned) {
        u32 passed = this.check_result_part(argument, wanted, returned);
        this.require_argument_shape(argument, passed, wanted, (FunctionInfo*)0, 0);
        SymbolTable* symbols = this.symbols;
        if (argument.kind() != NodeKind::IDENTIFIER || !Ownership.moves_into(symbols, wanted, passed)) {
            return;
        }
        if (returned) {
            this.move_out(argument);
        } else {
            this.move_from(argument, (Node*)0);
        }
    }

    u32 check_null(u32 expected) {
        SymbolTable* symbols = this.symbols;
        if (expected != 0 && (symbols.nullable_payload(expected) != 0 || symbols.nullable_value_payload(expected) != 0)) {
            return expected;
        }
        return Types.pointer_to(Types.void_type());
    }

    bool wraps_pointer(u32 passed, u32 wanted) {
        SymbolTable* symbols = this.symbols;
        return (Types.is_pointer(passed) && symbols.nullable_payload(wanted) == passed)
            || (passed != 0 && symbols.nullable_value_payload(wanted) == passed);
    }

    void require_safe_pointer(Node* value, u32 passed, u32 wanted) {
        if (!Types.is_safe_pointer(wanted)) {
            return;
        }
        if (value.kind() == NodeKind::NULL_LITERAL) {
            this.error_code(value, DiagnosticErrors.VALUE_TYPE_MISMATCH, "null needs a nullable pointer; declare it as 'T*?'");
        } else if (Types.is_nullable_pointer(passed)) {
            this.error_code(value, DiagnosticErrors.VALUE_TYPE_MISMATCH, "a nullable pointer cannot be used as 'T*' without a cast");
        } else if (this.symbols.nullable_payload(passed) == wanted) {
            this.warning_code(value, DiagnosticWarnings.NULLABLE_TO_NON_NULLABLE, "a nullable pointer is converted to a non-nullable one; check it against null or use '!.'");
        }
    }

    unsafe void error_conversion(Node* value, u32 passed, u32 wanted, FunctionInfo* callee, i32 argument, ptr<i8> reason) {
        SymbolTable* symbols = this.symbols;
        ByteBuffer* message = ByteBuffer.create();
        if (callee != null) {
            this.describe_parameter(callee, argument, message);
        }
        message.append("cannot convert '");
        if (value.kind() == NodeKind::STRING_LITERAL) {
            message.append("str");
        } else {
            symbols.describe_type(passed, message);
        }
        message.append("' to '");
        symbols.describe_type(wanted, message);
        message.append("': ");
        message.append(reason);
        this.error_over_expression(value, DiagnosticErrors.IMPLICIT_CONVERSION, message.cstr());
    }

    unsafe void describe_parameter(FunctionInfo* callee, i32 argument, ByteBuffer* message) {
        Node* declaration = callee.node;
        mut ptr<i8> name = (ptr<i8>)0;
        if (declaration != null && (declaration.kind() == NodeKind::FUNCTION || declaration.kind() == NodeKind::EXTERN_FUNCTION) && declaration.count() > 0) {
            i32 last = declaration.count() - 1;
            Node* parameter = declaration.child(argument < last ? argument : last);
            if (parameter.kind() == NodeKind::PARAMETER) {
                name = parameter.text();
            }
        }
        if (name != null && name[0] != 0) {
            message.append("parameter '");
            message.append(name);
            message.append("' of '");
        } else {
            message.append("parameter of '");
        }
        mut i32 length = 0;
        while (callee.name[length] != 0 && callee.name[length] != 36) {
            length = length + 1;
        }
        message.append_slice(callee.name, length);
        message.append("' (argument ");
        message.append_int((i64)(argument + 1));
        message.append("): ");
    }

    void require_explicit_cast(Node* value, u32 passed, u32 wanted, FunctionInfo* callee, i32 argument) {
        bool passed_number = Types.is_integer(passed) || Types.is_float(passed);
        bool wanted_number = Types.is_integer(wanted) || Types.is_float(wanted);
        if (passed_number && wanted_number && !Types.widens(passed, wanted)) {
            this.error_conversion(value, passed, wanted, callee, argument, "only a wider type of the same kind converts implicitly; use an explicit cast");
        }
        if (passed_number && Types.is_pointer(wanted) && value.kind() != NodeKind::NULL_LITERAL) {
            this.error_conversion(value, passed, wanted, callee, argument, "a number does not convert to a pointer implicitly; use an explicit cast");
        }
        if (Types.is_pointer(passed) && Types.is_pointer(wanted) && Types.element(passed) != Types.element(wanted)
            && !Types.is_void(Types.element(passed)) && !Types.is_void(Types.element(wanted))) {
            if (value.kind() == NodeKind::STRING_LITERAL) {
                this.error_conversion(value, passed, wanted, callee, argument, "a string literal converts only to str, string, i8* or ptr<i8>");
            } else {
                this.error_conversion(value, passed, wanted, callee, argument, "a pointer does not convert to a pointer of another type implicitly; use an explicit cast");
            }
        }
    }

    bool is_member_list(u32 type) {
        return type == this.core_type("FieldList") || type == this.core_type("MethodList") || type == this.core_type("PropertyList")
            || type == this.core_type("AttributeList") || type == this.core_type("NameList");
    }

    bool is_byte_pointer(u32 type) {
        return type == Types.byte_pointer() || type == Types.raw_pointer_to(Types.integer(8, true));
    }

    bool mark_text_conversion(Node* value, u32 passed, u32 wanted) {
        if (this.is_byte_pointer(wanted) && value.kind() != NodeKind::NULL_LITERAL) {
            if (passed == this.core_type("str")) {
                value.set_text_conversion(3);
                return true;
            }
            if (passed == this.core_type("string")) {
                value.set_text_conversion(4);
                return true;
            }
        }
        bool bytes = this.is_byte_pointer(passed);
        if (!bytes || value.kind() == NodeKind::NULL_LITERAL || value.kind() == NodeKind::STRING_LITERAL) {
            return false;
        }
        if (wanted == this.core_type("str")) {
            value.set_text_conversion(1);
            return true;
        }
        if (wanted == this.core_type("string")) {
            value.set_text_conversion(2);
            return true;
        }
        return false;
    }

    void require_argument_shape(Node* argument, u32 passed, u32 wanted, FunctionInfo* callee, i32 position) {
        this.require_safe_pointer(argument, passed, wanted);
        this.require_explicit_cast(argument, passed, wanted, callee, position);
        if (this.mark_text_conversion(argument, passed, wanted)) {
            return;
        }
        if (wanted == 0 || passed == wanted || wanted == this.core_type("object") || this.wraps_pointer(passed, wanted)) {
            return;
        }
        if (this.is_member_list(passed)) {
            this.error_code(argument, DiagnosticErrors.ARGUMENT_TYPE_MISMATCH, "a member list from #fields, #methods, #properties or #attributes only converts to object; call .format() to get its text");
            return;
        }
        SymbolTable* symbols = this.symbols;
        bool passed_struct = Types.is_struct(passed) && symbols.enum_of_type(passed) == null;
        bool wanted_struct = Types.is_struct(wanted) && symbols.enum_of_type(wanted) == null;
        bool passed_scalar = Types.is_integer(passed) || Types.is_float(passed) || Types.is_pointer(passed);
        bool wanted_scalar = Types.is_integer(wanted) || Types.is_float(wanted) || Types.is_pointer(wanted);
        if ((passed_struct && wanted_scalar) || (passed_scalar && wanted_struct)) {
            this.error_code(argument, DiagnosticErrors.ARGUMENT_TYPE_MISMATCH, "argument type does not match the parameter; a struct and a scalar or pointer are not convertible (use .toCString() to get a null-terminated text pointer of a str or string)");
        }
    }

    unsafe void require_value_type(Node* value, u32 passed, u32 wanted) {
        this.require_safe_pointer(value, passed, wanted);
        this.require_explicit_cast(value, passed, wanted, (FunctionInfo*)0, 0);
        if (this.mark_text_conversion(value, passed, wanted)) {
            return;
        }
        if (passed == 0 || wanted == 0 || passed == wanted || wanted == this.core_type("object") || this.wraps_pointer(passed, wanted)) {
            return;
        }
        SymbolTable* symbols = this.symbols;
        bool passed_struct = Types.is_struct(passed) && symbols.enum_of_type(passed) == null;
        bool wanted_struct = Types.is_struct(wanted) && symbols.enum_of_type(wanted) == null;
        bool passed_scalar = Types.is_integer(passed) || Types.is_float(passed) || Types.is_pointer(passed);
        bool wanted_number = Types.is_integer(wanted) || Types.is_float(wanted);
        bool wanted_scalar = wanted_number || Types.is_pointer(wanted);
        bool mixes_struct = (passed_struct && wanted_scalar) || (passed_scalar && wanted_struct);
        if (mixes_struct || (Types.is_pointer(passed) && wanted_number)) {
            this.error_code(value, DiagnosticErrors.VALUE_TYPE_MISMATCH, "value type does not match the declared type");
        }
    }

    unsafe bool provided_by_core(StructInfo* owner) {
        return owner != null && owner.node != null && (Attributes.has(owner.node, "intrinsic") || Attributes.has(owner.node, "no_mangle"));
    }

    // 2 for a struct declared in extern "JS", 4 for extern "C", 0 otherwise.
    unsafe i32 extern_kind_of(StructInfo* owner) {
        if (owner == null || owner.node == null || owner.node.kind() != NodeKind::STRUCT_DECL) {
            return 0;
        }
        return owner.node.op() & 6;
    }

    unsafe void check_abstract_call(Node* callee, FunctionInfo* info) {
        if (!info.is_abstract || this.provided_by_core(info.owner)) {
            return;
        }
        i32 kind = this.extern_kind_of(info.owner);
        if (kind == 2) {
            if (!Target.is_web()) {
                this.error_code(callee, DiagnosticErrors.ABSTRACT_CALL, "an extern \"JS\" binding is only available with --target web");
            }
            return;
        }
        if (kind == 4) {
            if (Target.is_web()) {
                this.error_code(callee, DiagnosticErrors.ABSTRACT_CALL, "an extern \"C\" binding is not available with --target web");
            }
            return;
        }
        if (Target.is_web() && info.node != null && Attributes.has(info.node, "Js")) {
            return;
        }
        if (!Target.is_web() && info.node != null && Attributes.has(info.node, "Symbol")) {
            return;
        }
        this.error_code(callee, DiagnosticErrors.ABSTRACT_CALL, "an abstract method has no implementation for this target");
    }

    unsafe void check_abstract_instantiation(Node* at, StructInfo* owner) {
        if (owner.node == null || owner.node.kind() != NodeKind::STRUCT_DECL || (owner.node.op() & 7) == 0 || this.provided_by_core(owner)) {
            return;
        }
        if ((owner.node.op() & 6) != 0) {
            this.error_code(at, DiagnosticErrors.ABSTRACT_INSTANTIATION, "an extern struct cannot be instantiated; a value comes from a binding that returns it");
            return;
        }
        this.error_code(at, DiagnosticErrors.ABSTRACT_INSTANTIATION, "an abstract struct cannot be instantiated");
    }

    u32 constructor_owner_type(Node* at, u32 type) {
        SymbolTable* symbols = this.symbols;
        if (!Types.is_struct(type) || symbols.enum_of_type(type) != null) {
            this.error_code(at, DiagnosticErrors.INVALID_CONSTRUCTOR_CALL, "only structs have constructors");
            return 0;
        }
        return type;
    }

    u32 check_constructor(Node* node, Node* callee, u32 type) {
        if (this.constructor_owner_type(node, type) == 0) {
            return Types.i32_type();
        }
        SymbolTable* symbols = this.symbols;
        StructInfo* owner = symbols.struct_at(Types.struct_index(type));
        this.check_abstract_instantiation(node, owner);
        FunctionInfo* constructor = this.check_constructor_arguments(node, owner);
        callee.set_symbol(SymbolKind.CONSTRUCTOR, (ptr)constructor);
        return type;
    }

    u32 check_new(Node* node) {
        u32 type = this.resolve_type(node.type(), node);
        if (this.constructor_owner_type(node, type) == 0) {
            return Types.pointer_to(Types.i32_type());
        }
        SymbolTable* symbols = this.symbols;
        StructInfo* owner = symbols.struct_at(Types.struct_index(type));
        this.check_abstract_instantiation(node, owner);
        FunctionInfo* constructor = this.check_constructor_arguments(node, owner);
        node.set_symbol(SymbolKind.CONSTRUCTOR, (ptr)constructor);
        return Types.pointer_to(type);
    }

    unsafe StructInfo* enum_named_by_parse_value_call(Node* callee) {
        if (callee.type() != null || callee.flag()) {
            return (StructInfo*)0;
        }
        ptr<i8> text = callee.text();
        i32 length = (i32)strlen(text);
        if (length < 13 || !Strings.same(text + length - 12, "::parseValue")) {
            return (StructInfo*)0;
        }
        i32 split = length - 12;
        AtomTable* atoms = Ast.atoms();
        u32 full = atoms.intern_copy(text, (u32)split);
        u32 base = Ast.intern_base_name(text, split);
        SymbolTable* symbols = this.symbols;
        StructInfo* owner = symbols.find_struct(full, base, this.scope);
        if (owner == null || !owner.is_enum || owner.has_payload || owner.is_template) {
            return (StructInfo*)0;
        }
        return owner;
    }

    unsafe u32 check_enum_variant_from_value_call(Node* node, Node* callee, StructInfo* owner) {
        SymbolTable* symbols = this.symbols;
        if (node.count() != 1) {
            this.error_code(node, DiagnosticErrors.WRONG_ARGUMENT_COUNT, "parseValue takes the value of the variant to look up");
            return owner.type_id;
        }
        this.check_expression(node.child(0), Types.i64_type());
        if (symbols.find_constant(owner, Ast.intern_base_name("Unknown", 7)) == null) {
            this.error_code(node, DiagnosticErrors.UNKNOWN_VARIANT, "parseValue returns the 'Unknown' variant for a value that matches no variant: declare one");
        }
        callee.set_symbol(SymbolKind.ENUM_PARSE_VALUE, (ptr)owner);
        return owner.type_id;
    }

    unsafe bool ambiguous_path_owner(Node* callee) {
        if (callee.type() != null) {
            return false;
        }
        ptr<i8> text = callee.text();
        i32 length = (i32)strlen(text);
        mut i32 split = -1;
        for (mut i32 i = 0; i + 1 < length; i = i + 1) {
            if (text[i] == 58 && text[i + 1] == 58) {
                split = i;
            }
        }
        if (split < 0) {
            return false;
        }
        SymbolTable* symbols = this.symbols;
        if (symbols.find_function(callee.text_atom(), callee.name(), this.scope) != null) {
            return false;
        }
        AtomTable* atoms = Ast.atoms();
        u32 full = atoms.intern_copy(text, (u32)split);
        return symbols.ambiguous_type(full, Ast.intern_base_name(text, split), this.scope, callee);
    }

    u32 recovery_type(u32 expected) {
        if (expected != 0) {
            return expected;
        }
        return Types.i32_type();
    }

    unsafe u32 check_call(Node* node, u32 expected) {
        Node* callee = node.first();
        SymbolTable* symbols = this.symbols;
        mut FunctionInfo* info = (FunctionInfo*)0;
        mut i32 offset = 0;

        if (callee.kind() == NodeKind::IDENTIFIER && !callee.flag()) {
            u32 closure_result = this.check_named_closure_call(node, callee);
            if (closure_result != 0) {
                return closure_result;
            }
        }
        if (callee.kind() == NodeKind::IDENTIFIER) {
            if (this.ambiguous_path_owner(callee)) {
                return this.recovery_type(expected);
            }
            StructInfo* enum_named_by_call = this.enum_named_by_parse_value_call(callee);
            if (enum_named_by_call != null) {
                return this.check_enum_variant_from_value_call(node, callee, enum_named_by_call);
            }
            Node* variant = this.find_enum_variant(callee, node, expected);
            if (variant != null) {
                if (node.count() != variant.payload_count()) {
                    this.error_code(node, DiagnosticErrors.WRONG_ARGUMENT_COUNT, "wrong number of enum variant arguments");
                }
                bool returned = this.returned_value == node;
                for (mut i32 a = 0; a < node.count() && a < variant.payload_count(); a = a + 1) {
                    Node* payload = variant.child(a);
                    this.check_payload(node.child(a), payload.value_type(), returned);
                }
                callee.set_symbol(SymbolKind.CONSTANT, (ptr)variant);
                return variant.value_type();
            }
            if (callee.flag() && callee.type() != null) {
                u32 constructed = this.resolve_type(callee.type(), callee);
                return this.check_constructor(node, callee, constructed);
            }
            info = symbols.find_function(callee.text_atom(), callee.name(), this.scope);
            if (info != null && info.overload == null && this.extern_hidden(info, node)) {
                info = (FunctionInfo*)0;
            }
            info = this.apply_named_arguments(node, info);
            if (info == null) {
                if (symbols.ambiguous_type(callee.text_atom(), callee.name(), this.scope, callee)) {
                    return this.recovery_type(expected);
                }
                StructInfo* named = symbols.find_struct(callee.text_atom(), callee.name(), this.scope);
                if (named != null && !named.is_template && !named.is_enum) {
                    return this.check_constructor(node, callee, named.type_id);
                }
            }
            if (info != null && info.is_template) {
                info = this.instantiate_call(node, callee, info);
                if (info == null) {
                    return Types.i32_type();
                }
            }
            if (info != null && info.overload != null) {
                info = this.pick_overload(info, node, 0);
                if (info == null) {
                    return Types.i32_type();
                }
            }
            callee.set_symbol(SymbolKind.FUNCTION, (ptr)info);
        } else if (callee.kind() == NodeKind::FIELD_ACCESS) {
            Node* base = callee.first();
            if (this.ambiguous_type_name(base)) {
                return this.recovery_type(expected);
            }
            StructInfo* primitive_owner = this.primitive_owner_named_by(base);
            if (primitive_owner != null || this.is_struct_name(base)) {
                mut StructInfo* owner = primitive_owner;
                if (owner == null) {
                    owner = symbols.find_struct(base.text_atom(), base.name(), this.scope);
                }
                base.set_symbol(SymbolKind.STRUCT_NAME, (ptr)owner);
                info = symbols.find_method(owner, callee.name());
                if (info == null && owner.is_enum && !owner.has_payload && !owner.is_template
                    && callee.name() == Ast.intern_base_name("parseValue", 10)) {
                    return this.check_enum_variant_from_value_call(node, callee, owner);
                }
                info = this.apply_named_arguments(node, info);
                if (info != null && info.is_template) {
                    info = this.instantiate_call(node, callee, info);
                    if (info == null) {
                        return Types.i32_type();
                    }
                }
                if (info != null && info.is_instance) {
                    this.error_code(callee, DiagnosticErrors.INSTANCE_STATIC_MISMATCH, "instance method called without an instance");
                    return Types.i32_type();
                }
                if (info != null && info.overload != null) {
                    info = this.pick_overload(info, node, 0);
                    if (info == null) {
                        return Types.i32_type();
                    }
                }
                callee.set_symbol(SymbolKind.STATIC_METHOD, (ptr)info);
            } else {
                StructInfo* owner = this.struct_of_base(callee, base);
                if (owner == null) {
                    return Types.i32_type();
                }
                info = symbols.find_method(owner, callee.name());
                if (info == null) {
                    FieldInfo* closure_field = symbols.find_field(owner, callee.name());
                    if (closure_field != null && symbols.closure_signature(closure_field.type) != null) {
                        return this.check_closure_call(node, this.check_expression(callee, 0));
                    }
                }
                if (info == null && owner.is_enum && !owner.has_payload && node.count() == 0
                    && callee.name() == Ast.intern_base_name("getValue", 8)) {
                    callee.set_symbol(SymbolKind.ENUM_VALUE, null);
                    return Types.i32_type();
                }
                if (info == null && owner.is_primitive && Types.is_float(owner.type_id)) {
                    i32 builtin = FloatBuiltin.lookup(callee.text());
                    if (builtin != FloatBuiltin.NONE) {
                        return this.check_float_builtin(node, callee, owner.type_id, builtin);
                    }
                }
                info = this.apply_named_arguments(node, info);
                if (info != null && info.is_template) {
                    info = this.instantiate_call(node, callee, info);
                    if (info == null) {
                        return Types.i32_type();
                    }
                }
                if (info != null && !info.is_instance) {
                    this.error_code(callee, DiagnosticErrors.INSTANCE_STATIC_MISMATCH, "static method called on an instance");
                    return Types.i32_type();
                }
                if (info != null && info.overload != null) {
                    info = this.pick_overload(info, node, 1);
                    if (info == null) {
                        return Types.i32_type();
                    }
                }
                if (info != null && callee.name() == Ast.intern_base_name("disposable", 10) && node.count() == 0) {
                    this.error_code(callee, DiagnosticErrors.EXPLICIT_DISPOSE, "disposable() is run by the compiler at end of scope and by the field drop glue, an explicit call frees twice");
                }
                callee.set_symbol(SymbolKind.INSTANCE_METHOD, (ptr)info);
                offset = 1;
            }
        } else {
            u32 callee_type = this.check_expression(callee, 0);
            if (symbols.closure_signature(callee_type) != null) {
                return this.check_closure_call(node, callee_type);
            }
            this.error_code(node, DiagnosticErrors.UNDECLARED_FUNCTION, "only calls to named functions and 'fn' values are supported");
            return Types.i32_type();
        }

        if (info == null) {
            Diagnostics.add_argument(callee.text());
            this.error_code(callee, DiagnosticErrors.UNDECLARED_FUNCTION, TypeChecker.named_message("function '", callee.text(), "' is not declared; check the spelling, the import or the namespace"));
            return Types.i32_type();
        }
        this.check_abstract_call(callee, info);

        if (!this.can_access(info)) {
            this.error_code(callee, DiagnosticErrors.PRIVATE_ACCESS, "call to a private function from outside its type or namespace");
        }
        IdList* param_types = info.param_types;
        i32 fixed = param_types.length;
        if (node.count() + offset + 1 == fixed && this.takes_location(info)) {
            this.append_location(node);
        }
        i32 given = node.count() + offset;
        mut i32 normal = fixed;
        if (info.packs_variadic) {
            normal = fixed - 1;
        }
        if (given < normal || (given > fixed && !info.is_variadic && !info.packs_variadic)) {
            this.error_code(node, DiagnosticErrors.WRONG_ARGUMENT_COUNT, this.argument_count_message(info, given, normal, fixed));
            return info.return_type;
        }

        for (mut i32 i = offset; i < given; i = i + 1) {
            Node* argument = node.child(i - offset);
            if (i < normal) {
                u32 wanted = param_types.get(i);
                u32 passed = this.check_expression(argument, wanted);
                this.require_argument_shape(argument, passed, wanted, info, i - offset);
                this.move_argument(argument, passed, wanted, info);
            } else if (info.packs_variadic) {
                SymbolTable* pack_symbols = this.symbols;
                u32 element = pack_symbols.pack_element(param_types.get(fixed - 1));
                u32 passed = this.check_expression(argument, element);
                if (element != this.core_type("object")) {
                    this.require_argument_shape(argument, passed, element, info, i - offset);
                }
            } else {
                this.check_expression(argument, 0);
            }
        }
        this.check_throwing_call(node, info);
        if (info.is_async) {
            if (this.function != null) {
                this.check_public_contract(node, this.function);
            }
            return this.task_of(info.return_type, this.error_of(info), node);
        }
        bool handled_here = info.has_throws && this.try_target == node;
        if (info.const_kind != 0 && !info.is_instance && !info.is_template && !handled_here) {
            this.fold_call(node, info);
        }
        return info.return_type;
    }

    // Private means private to the namespace: the std types call each other's private helpers within one namespace. A
    // private function used from another namespace is rejected, unless the caller is a method of the same type.
    unsafe bool can_access(FunctionInfo* info) {
        if (!info.is_private || info.home_scope == this.scope) {
            return true;
        }
        FunctionInfo* caller = this.function;
        if (info.owner == null || caller == null || caller.owner == null) {
            return caller == null && info.owner != null;
        }
        StructInfo* want = info.owner;
        StructInfo* have = caller.owner;
        if (want == have || want.origin == have || have.origin == want) {
            return true;
        }
        return want.origin != null && want.origin == have.origin;
    }

    unsafe bool takes_location(FunctionInfo* info) {
        Node* declaration = info.node;
        IdList* param_types = info.param_types;
        if (declaration == null || declaration.kind() != NodeKind::FUNCTION || !Types.is_struct(param_types.get(param_types.length - 1))) {
            return false;
        }
        Node* last = declaration.child(declaration.count() - 1);
        if (last.kind() != NodeKind::PARAMETER) {
            return false;
        }
        PointerList* uses = Attributes.all();
        for (mut i32 i = uses.length - 1; i >= 0; i = i - 1) {
            AttributeUse* use = (AttributeUse*)uses.get(i);
            if (use.target == last && Strings.same(use.name, "Location")) {
                return true;
            }
        }
        return false;
    }

    unsafe void append_location(Node* call) {
        i32 token = call.token;
        ptr<i8> path = Strings.duplicate(call.file_name(), strlen(call.file_name()));
        i32 length = strlen(path);
        for (mut i32 i = 0; i < length; i = i + 1) {
            if (path[i] == 92) {
                path[i] = 47;
            }
        }
        Node* init = Node.create_list(NodeKind::STRUCT_INIT, token);
        Node* file_field = Node.create(NodeKind::FIELD_INIT, token);
        file_field.set_text("fileName");
        Node* file = Node.create(NodeKind::STRING_LITERAL, token);
        file.set_text_n(path, length);
        file.set_int_value(length);
        file_field.set_first(file);
        init.add(file_field);
        Node* line_field = Node.create(NodeKind::FIELD_INIT, token);
        line_field.set_text("line");
        Node* line = Node.create(NodeKind::INT_LITERAL, token);
        line.set_int_value(call.line());
        line_field.set_first(line);
        init.add(line_field);
        Node* column_field = Node.create(NodeKind::FIELD_INIT, token);
        column_field.set_text("column");
        Node* column = Node.create(NodeKind::INT_LITERAL, token);
        column.set_int_value(call.column());
        column_field.set_first(column);
        init.add(column_field);
        call.add(init);
    }
}
