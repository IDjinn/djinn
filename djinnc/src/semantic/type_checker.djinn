namespace djinnc;

struct TypeChecker {
    Diagnostics* diagnostics;
    SymbolTable* symbols;
    LocalScopes* scopes;
    FunctionInfo* function;
    u32 scope;
    i32 loop_depth;
    i32 switch_depth;
    Node* assign_target;

    public static TypeChecker* create(Diagnostics* diagnostics, SymbolTable* symbols) {
        TypeChecker* checker = (TypeChecker*)Memory.zalloc(sizeof(TypeChecker));
        checker.diagnostics = diagnostics;
        checker.symbols = symbols;
        checker.scopes = LocalScopes.create();
        return checker;
    }

    void error(Node* at, i8* message) {
        Diagnostics* diagnostics = this.diagnostics;
        diagnostics.error_in(at.file_name(), at.line(), at.column(), message);
    }

    public u32 resolve_type(TypeRef* ref, Node* at) {
        SymbolTable* symbols = this.symbols;
        symbols.blame = at;
        u32 resolved = symbols.resolve_type(ref, this.scope);
        if (resolved == 0) {
            this.error(at, "unknown type");
            return Types.i32_type();
        }
        return resolved;
    }

    public bool run() {
        SymbolTable* symbols = this.symbols;
        PointerList* structs = symbols.structs;
        for (mut i32 i = 0; i < structs.length; i = i + 1) {
            StructInfo* info = (StructInfo*)structs.get(i);
            if (info.is_template) {
                continue;
            }
            symbols.bindings = info.bindings;
            PointerList* constants = info.constants;
            for (mut i32 c = 0; c < constants.length; c = c + 1) {
                this.check_constant((Node*)constants.get(c), info.namespace_id);
            }
            symbols.bindings = null;
        }
        PointerList* globals = symbols.globals;
        for (mut i32 i = 0; i < globals.length; i = i + 1) {
            this.check_global((LocalVariable*)globals.get(i));
        }
        PointerList* functions = symbols.functions;
        for (mut i32 i = 0; i < functions.length; i = i + 1) {
            FunctionInfo* info = (FunctionInfo*)functions.get(i);
            if (!info.is_extern && !info.is_template) {
                this.check_function(info);
            }
        }
        Diagnostics* diagnostics = this.diagnostics;
        return !diagnostics.failed();
    }

    void check_constant(Node* member, u32 namespace_id) {
        this.scope = namespace_id;
        this.function = null;
        LocalScopes* scopes = this.scopes;
        scopes.reset_to(0);
        this.check_expression(member.first(), member.value_type());
    }

    void check_global(LocalVariable* variable) {
        this.scope = variable.namespace_id;
        this.function = null;
        LocalScopes* scopes = this.scopes;
        scopes.reset_to(0);
        Node* declaration = variable.node;
        declaration.set_value_type(variable.type);
        this.check_expression(declaration.first(), variable.type);
    }

    void check_function(FunctionInfo* info) {
        SymbolTable* active = this.symbols;
        active.bindings = info.bindings;
        if (info.owner != null && info.bindings == null) {
            StructInfo* owner = info.owner;
            active.bindings = owner.bindings;
        }
        this.scope = info.namespace_id;
        this.function = info;
        this.loop_depth = 0;
        this.switch_depth = 0;
        LocalScopes* scopes = this.scopes;
        scopes.reset_to(0);

        Node* declaration = info.node;
        IdList* params = info.param_types;
        mut i32 offset = 0;
        if (info.is_instance) {
            offset = 1;
            LocalVariable* receiver = (LocalVariable*)Memory.zalloc(sizeof(LocalVariable));
            receiver.name = "this";
            receiver.name_atom = Atoms.THIS_ATOM;
            receiver.type = params.get(0);
            info.this_variable = receiver;
            scopes.define(Atoms.THIS_ATOM, receiver);
        }
        for (mut i32 i = 0; i < declaration.count(); i = i + 1) {
            Node* parameter = declaration.child(i);
            LocalVariable* variable = (LocalVariable*)Memory.zalloc(sizeof(LocalVariable));
            variable.name = parameter.text();
            variable.name_atom = parameter.name();
            variable.type = params.get(i + offset);
            variable.is_mutable = parameter.flag();
            variable.node = parameter;
            parameter.set_symbol(SymbolKind.LOCAL, (void*)variable);
            parameter.set_value_type(variable.type);
            scopes.define(variable.name_atom, variable);
        }

        this.check_statement(declaration.first());
    }

    void check_statement(Node* node) {
        i32 kind = node.kind;
        LocalScopes* scopes = this.scopes;

        if (kind == NodeKind.BLOCK) {
            i32 mark = scopes.mark();
            for (mut i32 i = 0; i < node.count(); i = i + 1) {
                this.check_statement(node.child(i));
            }
            scopes.reset_to(mark);
        } else if (kind == NodeKind.VAR_DECL) {
            this.check_variable(node);
        } else if (kind == NodeKind.EXPR_STMT) {
            this.check_expression(node.first(), 0);
        } else if (kind == NodeKind.SPAWN_STMT) {
            u32 spawned = this.check_expression(node.first(), 0);
            if (this.task_result(spawned) == 0) {
                this.error(node, "'spawn' needs the task returned by an async function");
            }
        } else if (kind == NodeKind.RETURN) {
            this.check_return(node);
        } else if (kind == NodeKind.IF) {
            this.check_condition(node.first());
            this.check_statement(node.second());
            if (node.third() != null) {
                this.check_statement(node.third());
            }
        } else if (kind == NodeKind.WHILE) {
            this.check_condition(node.first());
            this.check_loop_body(node.second());
        } else if (kind == NodeKind.DO_WHILE) {
            this.check_loop_body(node.second());
            this.check_condition(node.first());
        } else if (kind == NodeKind.FOR) {
            i32 mark = scopes.mark();
            if (node.first() != null) {
                this.check_statement(node.first());
            }
            if (node.second() != null) {
                this.check_condition(node.second());
            }
            if (node.third() != null) {
                this.check_expression(node.third(), 0);
            }
            this.check_loop_body(node.fourth());
            scopes.reset_to(mark);
        } else if (kind == NodeKind.BREAK) {
            if (this.loop_depth == 0 && this.switch_depth == 0) {
                this.error(node, "'break' outside of a loop or switch");
            }
        } else if (kind == NodeKind.CONTINUE) {
            if (this.loop_depth == 0) {
                this.error(node, "'continue' outside of a loop");
            }
        } else if (kind == NodeKind.SWITCH) {
            this.check_switch(node);
        } else {
            this.error(node, "statement is not supported yet");
        }
    }

    void check_switch(Node* node) {
        u32 value_type = this.check_expression(node.first(), 0);
        if (!Types.is_integer(value_type)) {
            this.error(node.first(), "switch value must be an integer");
        }
        mut bool has_default = false;
        this.switch_depth = this.switch_depth + 1;
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* arm = node.child(i);
            if (arm.first() == null) {
                if (has_default) {
                    this.error(arm, "switch has more than one 'default'");
                }
                has_default = true;
            } else {
                u32 label_type = this.check_expression(arm.first(), value_type);
                if (!Types.is_integer(label_type)) {
                    this.error(arm.first(), "case label must be an integer constant");
                }
            }
            LocalScopes* scopes = this.scopes;
            i32 mark = scopes.mark();
            for (mut i32 j = 0; j < arm.count(); j = j + 1) {
                this.check_statement(arm.child(j));
            }
            scopes.reset_to(mark);
        }
        this.switch_depth = this.switch_depth - 1;
    }

    void check_loop_body(Node* body) {
        this.loop_depth = this.loop_depth + 1;
        this.check_statement(body);
        this.loop_depth = this.loop_depth - 1;
    }

    void check_condition(Node* node) {
        u32 type = this.check_expression(node, 0);
        bool usable = Types.is_integer(type) || Types.is_float(type) || Types.is_pointer(type);
        if (!usable) {
            this.error(node, "condition must be a number or a pointer");
        }
    }

    void check_variable(Node* node) {
        mut u32 declared = this.resolve_type(node.type(), node);
        mut u32 initial = 0;
        if (node.first() != null) {
            mut u32 hint = declared;
            if (declared == Types.auto_type()) {
                hint = 0;
            }
            initial = this.check_expression(node.first(), hint);
        }
        if (declared == Types.auto_type()) {
            if (initial == 0) {
                this.error(node, "'auto' variable needs an initializer");
                declared = Types.i32_type();
            } else {
                declared = initial;
            }
        }
        if (Types.is_void(declared)) {
            this.error(node, "variable cannot have type void");
            declared = Types.i32_type();
        }

        LocalVariable* variable = (LocalVariable*)Memory.zalloc(sizeof(LocalVariable));
        variable.name = node.text();
        variable.name_atom = node.name();
        variable.type = declared;
        variable.is_mutable = node.flag();
        variable.node = node;
        node.set_symbol(SymbolKind.LOCAL, (void*)variable);
        node.set_value_type(declared);
        if (node.first() != null) {
            this.move_from(node.first(), null);
        }
        LocalScopes* scopes = this.scopes;
        scopes.define(variable.name_atom, variable);
    }

    void check_return(Node* node) {
        FunctionInfo* info = this.function;
        u32 expected = info.return_type;
        if (node.first() == null) {
            if (!Types.is_void(expected)) {
                this.error(node, "missing return value");
            }
            return;
        }
        if (Types.is_void(expected)) {
            this.error(node, "void function cannot return a value");
            this.check_expression(node.first(), 0);
            return;
        }
        this.check_expression(node.first(), expected);
    }

    LocalVariable* find_variable(u32 name) {
        LocalScopes* scopes = this.scopes;
        LocalVariable* local = scopes.find(name);
        if (local != null) {
            return local;
        }
        SymbolTable* symbols = this.symbols;
        return symbols.find_global(name, name, this.scope);
    }

    bool is_struct_name(Node* node) {
        if (node.kind != NodeKind.IDENTIFIER) {
            return false;
        }
        if (this.find_variable(node.name()) != null) {
            return false;
        }
        SymbolTable* symbols = this.symbols;
        return symbols.find_struct(node.text_atom(), node.name(), this.scope) != null;
    }

    bool is_addressable(Node* node) {
        i32 kind = node.kind;
        if (kind == NodeKind.IDENTIFIER || kind == NodeKind.INDEX) {
            return true;
        }
        if (kind == NodeKind.FIELD_ACCESS) {
            return !this.is_struct_name(node.first());
        }
        return kind == NodeKind.UNARY && node.op() == TokenKind.STAR;
    }

    public u32 check_expression(Node* node, u32 expected) {
        u32 type = this.compute_expression(node, expected);
        node.set_value_type(type);
        return type;
    }

    u32 compute_expression(Node* node, u32 expected) {
        i32 kind = node.kind;

        if (kind == NodeKind.INT_LITERAL) {
            if (expected != 0 && (Types.is_float(expected) || Types.is_integer(expected))) {
                return expected;
            }
            if (node.int_value() > 2147483647) {
                return Types.i64_type();
            }
            return Types.i32_type();
        }
        if (kind == NodeKind.FLOAT_LITERAL) {
            if (expected != 0 && Types.is_float(expected)) {
                return expected;
            }
            return Types.floating(64);
        }
        if (kind == NodeKind.STRING_LITERAL) {
            u32 text_type = this.core_type("str");
            u32 owned_type = this.core_type("string");
            if (expected != 0 && (expected == text_type || expected == owned_type)) {
                return expected;
            }
            return Types.byte_pointer();
        }
        if (kind == NodeKind.ARRAY_LITERAL) {
            return this.check_array_literal(node, expected);
        }
        if (kind == NodeKind.BOOL_LITERAL) {
            return Types.bool_type();
        }
        if (kind == NodeKind.NULL_LITERAL) {
            return Types.pointer_to(Types.void_type());
        }
        if (kind == NodeKind.IDENTIFIER || kind == NodeKind.INDEX) {
            return this.check_lvalue(node);
        }
        if (kind == NodeKind.FIELD_ACCESS) {
            return this.check_member(node);
        }
        if (kind == NodeKind.UNARY) {
            return this.check_unary(node, expected);
        }
        if (kind == NodeKind.BINARY) {
            return this.check_binary(node, expected);
        }
        if (kind == NodeKind.ASSIGN) {
            return this.check_assign(node);
        }
        if (kind == NodeKind.CALL) {
            return this.check_call(node, expected);
        }
        if (kind == NodeKind.CAST) {
            u32 target = this.resolve_type(node.type(), node);
            this.check_expression(node.first(), target);
            return target;
        }
        if (kind == NodeKind.SWITCH_EXPR) {
            return this.check_switch_expression(node, expected);
        }
        if (kind == NodeKind.STRUCT_INIT) {
            return this.check_struct_init(node, expected);
        }
        if (kind == NodeKind.IS_EXPR) {
            return this.check_is(node);
        }
        if (kind == NodeKind.AWAIT_EXPR) {
            return this.check_await(node);
        }
        if (kind == NodeKind.LET_EXPR) {
            return this.check_let(node, expected);
        }
        if (kind == NodeKind.NEW_EXPR) {
            return this.check_new(node);
        }
        if (kind == NodeKind.INTERPOLATION) {
            return this.check_interpolation(node);
        }
        if (kind == NodeKind.INTRINSIC) {
            u32 measured = this.resolve_type(node.type(), node);
            if (Types.is_void(measured) || measured == Types.auto_type()) {
                this.error(node, "sizeof of this type is not supported yet");
            }
            node.set_symbol(SymbolKind.TYPE, (void*)(u64)measured);
            return Types.i64_type();
        }

        this.error(node, "expression is not supported yet");
        return Types.i32_type();
    }

    u32 check_lvalue(Node* node) {
        u32 type = this.compute_lvalue(node);
        node.set_value_type(type);
        return type;
    }

    u32 compute_lvalue(Node* node) {
        i32 kind = node.kind;

        if (kind == NodeKind.IDENTIFIER) {
            LocalVariable* variable = this.find_variable(node.name());
            if (variable == null) {
                FieldInfo* implicit = this.implicit_field(node);
                if (implicit != null) {
                    node.set_symbol(SymbolKind.IMPLICIT_FIELD, (void*)implicit);
                    return implicit.type;
                }
                FunctionInfo* implicit_getter = this.implicit_accessor(node, "get:");
                if (implicit_getter != null) {
                    node.set_symbol(SymbolKind.IMPLICIT_GET, (void*)implicit_getter);
                    return implicit_getter.return_type;
                }
                this.error(node, "undefined variable");
                return Types.i32_type();
            }
            LocalScopes* scopes = this.scopes;
            if (variable.moved && this.assign_target != node) {
                this.error(node, "use of moved value");
            }
            if (scopes.find(node.name()) != null) {
                node.set_symbol(SymbolKind.LOCAL, (void*)variable);
            } else {
                node.set_symbol(SymbolKind.GLOBAL, (void*)variable);
            }
            return variable.type;
        }

        if (kind == NodeKind.FIELD_ACCESS) {
            return this.check_field(node);
        }

        if (kind == NodeKind.INDEX) {
            u32 base = this.check_expression(node.first(), 0);
            this.check_expression(node.second(), Types.i64_type());
            u32 held = this.array_element(base);
            if (held != 0) {
                return held;
            }
            if (!Types.is_sized_pointer(base)) {
                this.error(node, "only pointers to sized types can be indexed");
                return Types.i32_type();
            }
            return Types.element(base);
        }

        if (kind == NodeKind.UNARY && node.op() == TokenKind.STAR) {
            u32 pointer = this.check_expression(node.first(), 0);
            if (!Types.is_sized_pointer(pointer)) {
                this.error(node, "cannot dereference this value");
                return Types.i32_type();
            }
            return Types.element(pointer);
        }

        this.error(node, "expression is not addressable");
        return Types.i32_type();
    }

    StructInfo* struct_of_base(Node* base) {
        mut u32 type = 0;
        if (this.is_addressable(base)) {
            type = this.check_lvalue(base);
        } else {
            type = this.check_expression(base, 0);
            SymbolTable* known = this.symbols;
            if (!Types.is_pointer(type) && known.enum_of_type(type) == null && (Types.is_struct(type) || Types.is_void(type))) {
                this.error(base, "member access needs a struct or a pointer to one");
                return null;
            }
        }
        mut u32 target = type;
        if (Types.is_pointer(type)) {
            target = Types.element(type);
        }
        SymbolTable* enumerations = this.symbols;
        StructInfo* enumeration = enumerations.enum_of_type(target);
        if (enumeration != null) {
            return enumeration;
        }
        SymbolTable* symbols = this.symbols;
        if (!Types.is_struct(target)) {
            if (Types.is_void(target)) {
                this.error(base, "member access on a value that is not a struct");
                return null;
            }
            return symbols.primitive_owner(target);
        }
        return symbols.struct_at(Types.struct_index(target));
    }

    u32 check_field(Node* node) {
        Node* base = node.first();
        if (this.is_struct_name(base)) {
            this.error(node, "a struct constant cannot be used as a variable");
            return Types.i32_type();
        }
        StructInfo* info = this.struct_of_base(base);
        if (info == null) {
            return Types.i32_type();
        }
        SymbolTable* symbols = this.symbols;
        FieldInfo* field = symbols.find_field(info, node.name());
        if (field == null) {
            FunctionInfo* getter = this.find_accessor(info, "get:", node.text());
            if (getter != null) {
                node.set_symbol(SymbolKind.PROPERTY_GET, (void*)getter);
                return getter.return_type;
            }
            this.error(node, "struct has no such field");
            return Types.i32_type();
        }
        node.set_symbol(SymbolKind.FIELD, (void*)field);
        return field.type;
    }

    FunctionInfo* find_accessor(StructInfo* owner, i8* prefix, i8* name) {
        ByteBuffer* full = ByteBuffer.create();
        full.append(prefix);
        full.append(name);
        SymbolTable* symbols = this.symbols;
        return symbols.find_method(owner, Ast.intern_base_name(full.cstr(), (i32)strlen(full.cstr())));
    }

    FunctionInfo* implicit_accessor(Node* node, i8* prefix) {
        FunctionInfo* current = this.function;
        if (current == null || !current.is_instance || current.owner == null) {
            return null;
        }
        return this.find_accessor(current.owner, prefix, node.text());
    }

    FieldInfo* implicit_field(Node* node) {
        FunctionInfo* current = this.function;
        if (current == null || !current.is_instance || current.owner == null) {
            return null;
        }
        StructInfo* owner = current.owner;
        SymbolTable* symbols = this.symbols;
        return symbols.find_field(owner, node.name());
    }

    u32 check_member(Node* node) {
        Node* base = node.first();
        if (this.is_struct_name(base)) {
            SymbolTable* symbols = this.symbols;
            StructInfo* info = symbols.find_struct(base.text_atom(), base.name(), this.scope);
            base.set_symbol(SymbolKind.STRUCT_NAME, (void*)info);
            Node* constant = symbols.find_constant(info, node.name());
            if (constant == null) {
                this.error(node, "struct has no such constant");
                return Types.i32_type();
            }
            if (info.has_payload) {
                this.error(node, "a payload enum is built with Enum::Variant(...)");
            }
            node.set_symbol(SymbolKind.CONSTANT, (void*)constant);
            return constant.value_type();
        }
        return this.check_field(node);
    }

    u32 check_unary(Node* node, u32 expected) {
        i32 op = node.op();

        if (op == TokenKind.AMPERSAND) {
            u32 addressed = this.check_lvalue(node.first());
            if (node.first().symbol_kind() == SymbolKind.PROPERTY_GET) {
                this.error(node, "cannot take the address of a property");
            }
            return Types.pointer_to(addressed);
        }
        if (op == TokenKind.STAR) {
            return this.check_lvalue(node);
        }

        u32 operand = this.check_expression(node.first(), expected);
        if (op == TokenKind.MINUS) {
            if (!Types.is_integer(operand) && !Types.is_float(operand)) {
                this.error(node, "operator is not valid for this operand");
            }
            return operand;
        }
        if (op == TokenKind.TILDE) {
            if (!Types.is_integer(operand)) {
                this.error(node, "operator is not valid for this operand");
            }
            return operand;
        }
        if (op == TokenKind.BANG) {
            return Types.bool_type();
        }

        this.error(node, "unary operator is not supported yet");
        return Types.i32_type();
    }

    bool is_untyped_literal(Node* node) {
        if (node.kind == NodeKind.INT_LITERAL) {
            return true;
        }
        return node.kind == NodeKind.UNARY && node.op() == TokenKind.MINUS && node.first().kind == NodeKind.INT_LITERAL;
    }

    static bool is_comparison(i32 op) {
        return op == TokenKind.EQUAL_EQUAL || op == TokenKind.BANG_EQUAL || op == TokenKind.LESS
            || op == TokenKind.LESS_EQUAL || op == TokenKind.GREATER || op == TokenKind.GREATER_EQUAL;
    }

    FunctionInfo* find_operator(StructInfo* owner, i32 op) {
        SymbolTable* symbols = this.symbols;
        ByteBuffer* name = ByteBuffer.create();
        name.append("operator");
        name.append(TokenKind.text(op));
        return symbols.find_method(owner, Ast.intern_base_name(name.cstr(), (i32)strlen(name.cstr())));
    }

    u32 check_operator(Node* node, i32 op, u32 left, u32 right) {
        SymbolTable* symbols = this.symbols;
        StructInfo* owner = symbols.struct_at(Types.struct_index(left));
        mut FunctionInfo* method = this.find_operator(owner, op);
        mut i32 kind = SymbolKind.OPERATOR;
        if (method == null && op == TokenKind.BANG_EQUAL) {
            method = this.find_operator(owner, TokenKind.EQUAL_EQUAL);
            kind = SymbolKind.NEGATED_OPERATOR;
        }
        if (method == null) {
            this.error(node, "struct does not define this operator");
            return Types.i32_type();
        }
        mut FunctionInfo* exact = (FunctionInfo*)0;
        mut FunctionInfo* walk = method;
        while (walk != null) {
            IdList* candidate_params = walk.param_types;
            if (candidate_params.length == 2 && candidate_params.get(0) == left && candidate_params.get(1) == right) {
                exact = walk;
                break;
            }
            walk = walk.overload;
        }
        if (exact == null) {
            this.error(node, "operator operands do not match its parameters");
            return method.return_type;
        }
        method = exact;
        node.set_symbol(kind, (void*)method);
        return method.return_type;
    }

    u32 check_binary(Node* node, u32 expected) {
        i32 op = node.op();
        if (op == TokenKind.AND_AND || op == TokenKind.OR_OR) {
            this.check_condition(node.first());
            this.check_condition(node.second());
            return Types.bool_type();
        }

        if (op == TokenKind.QUESTION_QUESTION) {
            u32 pointer = this.check_expression(node.first(), expected);
            if (!Types.is_pointer(pointer)) {
                this.error(node, "the left operand of ?? must be a pointer");
                return pointer;
            }
            this.check_expression(node.second(), pointer);
            return pointer;
        }

        mut u32 hint = expected;
        if (TypeChecker.is_comparison(op)) {
            hint = 0;
        }

        mut u32 left = 0;
        mut u32 right = 0;
        if (this.is_untyped_literal(node.first()) && !this.is_untyped_literal(node.second())) {
            right = this.check_expression(node.second(), hint);
            left = this.check_expression(node.first(), right);
        } else {
            left = this.check_expression(node.first(), hint);
            right = this.check_expression(node.second(), left);
        }

        if (Types.is_pointer(left) && Types.is_integer(right) && (op == TokenKind.PLUS || op == TokenKind.MINUS)) {
            return left;
        }

        if (Types.is_struct(left)) {
            return this.check_operator(node, op, left, right);
        }

        u32 common = Types.common(left, right);
        if (TypeChecker.is_comparison(op)) {
            return Types.bool_type();
        }
        if (Types.is_float(common)) {
            bool valid = op == TokenKind.PLUS || op == TokenKind.MINUS || op == TokenKind.STAR
                || op == TokenKind.SLASH || op == TokenKind.PERCENT;
            if (!valid) {
                this.error(node, "operator is not valid for floating point operands");
            }
        } else if (!Types.is_integer(common)) {
            this.error(node, "operator is not valid for these operands");
        }
        return common;
    }

    u32 check_assign(Node* node) {
        Node* target = node.first();
        this.assign_target = target;
        u32 type = this.check_lvalue(target);
        this.assign_target = null;
        if (target.kind == NodeKind.FIELD_ACCESS && target.symbol_kind() == SymbolKind.PROPERTY_GET) {
            FunctionInfo* getter = (FunctionInfo*)target.symbol();
            FunctionInfo* setter = this.find_accessor(getter.owner, "set:", target.text());
            if (setter == null) {
                this.error(target, "property has no setter");
            } else {
                target.set_symbol(SymbolKind.PROPERTY_SET, (void*)setter);
            }
        }
        if (target.kind == NodeKind.IDENTIFIER && target.symbol_kind() == SymbolKind.IMPLICIT_GET) {
            FunctionInfo* implicit_setter = this.implicit_accessor(target, "set:");
            if (implicit_setter == null) {
                this.error(target, "property has no setter");
            } else {
                target.set_symbol(SymbolKind.IMPLICIT_SET, (void*)implicit_setter);
            }
        }
        if (target.kind == NodeKind.IDENTIFIER && (target.symbol_kind() == SymbolKind.LOCAL || target.symbol_kind() == SymbolKind.GLOBAL)) {
            LocalVariable* variable = (LocalVariable*)target.symbol();
            if (!variable.is_mutable) {
                this.error(target, "cannot assign to an immutable variable");
            }
        }
        this.check_expression(node.second(), type);
        this.move_from(node.second(), target);
        if (target.kind == NodeKind.IDENTIFIER && (target.symbol_kind() == SymbolKind.LOCAL || target.symbol_kind() == SymbolKind.GLOBAL)) {
            LocalVariable* reinitialized = (LocalVariable*)target.symbol();
            reinitialized.moved = false;
        }
        return type;
    }

    bool is_copy_type(u32 type) {
        return !Types.is_struct(type);
    }

    void move_from(Node* source, Node* destination) {
        if (source.kind != NodeKind.IDENTIFIER || source.symbol_kind() != SymbolKind.LOCAL) {
            return;
        }
        if (destination != null && destination.kind == NodeKind.IDENTIFIER && destination.symbol() == source.symbol()) {
            return;
        }
        LocalVariable* variable = (LocalVariable*)source.symbol();
        if (!this.is_copy_type(variable.type)) {
            variable.moved = true;
        }
    }

    u32 check_let(Node* node, u32 expected) {
        LocalScopes* scopes = this.scopes;
        i32 mark = scopes.mark();
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* item = node.child(i);
            u32 type = this.check_expression(item.first(), 0);
            LocalVariable* variable = (LocalVariable*)Memory.zalloc(sizeof(LocalVariable));
            variable.name = item.text();
            variable.name_atom = item.name();
            variable.type = type;
            variable.node = item;
            item.set_symbol(SymbolKind.LOCAL, (void*)variable);
            item.set_value_type(type);
            scopes.define(variable.name_atom, variable);
        }
        u32 result = this.check_expression(node.first(), expected);
        scopes.reset_to(mark);
        return result;
    }

    u32 task_result(u32 type) {
        SymbolTable* symbols = this.symbols;
        if (type == 0 || !Types.is_struct(type) || symbols.enum_of_type(type) != null) {
            return 0;
        }
        StructInfo* info = symbols.struct_at(Types.struct_index(type));
        if (info.origin == null || info.type_args == null) {
            return 0;
        }
        StructInfo* origin = info.origin;
        if (origin.name_atom != Ast.intern_base_name("task", 4)) {
            return 0;
        }
        IdList* args = info.type_args;
        return args.get(0) + 1;
    }

    u32 task_of(u32 result, Node* at) {
        SymbolTable* symbols = this.symbols;
        u32 atom = Ast.intern_base_name("task", 4);
        StructInfo* template = symbols.find_struct(atom, atom, 0);
        if (template == null || !template.is_template) {
            this.error(at, "async functions need the core 'task' type");
            return Types.i32_type();
        }
        IdList* args = IdList.create();
        args.push(result);
        symbols.blame = at;
        SemanticAnalyzer* analyzer = symbols.analyzer;
        return analyzer.instantiate(template, args);
    }

    u32 check_await(Node* node) {
        u32 operand = this.check_expression(node.first(), 0);
        u32 held = this.task_result(operand);
        if (held == 0) {
            this.error(node, "'await' needs the task returned by an async function");
            return Types.i32_type();
        }
        return held - 1;
    }

    u32 check_is_variant(Node* node, StructInfo* enumeration) {
        SymbolTable* symbols = this.symbols;
        TypeRef* named = node.type();
        Node* variant = symbols.find_constant(enumeration, named.name_atom);
        if (variant == null) {
            this.error(node, "enum has no such variant");
            return Types.bool_type();
        }
        IsPattern* pattern = (IsPattern*)Memory.zalloc(sizeof(IsPattern));
        pattern.variant = variant;
        pattern.bindings = PointerList.create();
        node.set_symbol(SymbolKind.CONSTANT, (void*)pattern);
        if (!node.flag()) {
            if (variant.count() != 0) {
                this.error(node, "wrong number of bindings for the variant payload");
            }
            return Types.bool_type();
        }

        i8* text = node.text();
        i32 length = (i32)strlen(text);
        mut i32 start = 0;
        mut i32 index = 0;
        LocalScopes* scopes = this.scopes;
        for (mut i32 i = 0; i <= length; i = i + 1) {
            if (i < length && text[i] != 32) {
                continue;
            }
            if (index >= variant.count()) {
                this.error(node, "wrong number of bindings for the variant payload");
                return Types.bool_type();
            }
            ByteBuffer* copy = ByteBuffer.create();
            copy.append_slice(text + start, i - start);
            Node* payload = variant.child(index);
            LocalVariable* variable = (LocalVariable*)Memory.zalloc(sizeof(LocalVariable));
            variable.name = copy.cstr();
            variable.name_atom = Ast.intern_base_name(variable.name, i - start);
            variable.type = payload.value_type();
            variable.node = node;
            scopes.define(variable.name_atom, variable);
            pattern.bindings.push((void*)variable);
            index = index + 1;
            start = i + 1;
        }
        if (index != variant.count()) {
            this.error(node, "wrong number of bindings for the variant payload");
        }
        return Types.bool_type();
    }

    u32 check_is(Node* node) {
        u32 operand = this.check_expression(node.first(), 0);
        SymbolTable* known = this.symbols;
        StructInfo* enumeration = known.enum_of_type(operand);
        if (enumeration != null) {
            return this.check_is_variant(node, enumeration);
        }
        u32 boxed = this.core_type("object");
        if (boxed == 0 || operand != boxed) {
            this.error(node, "'is' needs an object value");
        }
        u32 target = this.resolve_type(node.type(), node);
        LocalVariable* variable = (LocalVariable*)Memory.zalloc(sizeof(LocalVariable));
        variable.name = node.text();
        variable.name_atom = node.name();
        variable.type = target;
        variable.node = node;
        node.set_symbol(SymbolKind.LOCAL, (void*)variable);
        if (node.flag()) {
            LocalScopes* scopes = this.scopes;
            scopes.define(variable.name_atom, variable);
        }
        return Types.bool_type();
    }

    u32 check_interpolation(Node* node) {
        u32 owned = this.core_type("string");
        u32 view = this.core_type("str");
        if (owned == 0) {
            this.error(node, "string interpolation needs the core 'string' type");
            return Types.i32_type();
        }
        for (mut i32 i = 1; i < node.count(); i = i + 2) {
            Node* part = node.child(i);
            u32 type = this.check_expression(part, 0);
            bool printable = Types.is_integer(type) || Types.is_float(type) || type == Types.byte_pointer()
                || type == owned || type == view;
            if (!printable) {
                this.error(part, "this value cannot be interpolated into a string");
            }
        }
        return owned;
    }

    u32 core_type(i8* name) {
        SymbolTable* symbols = this.symbols;
        u32 atom = Ast.intern_base_name(name, (i32)strlen(name));
        StructInfo* info = symbols.find_struct(atom, atom, 0);
        if (info == null || info.is_template) {
            return 0;
        }
        return info.type_id;
    }

    u32 array_element(u32 type) {
        SymbolTable* symbols = this.symbols;
        if (type == 0 || !Types.is_struct(type)) {
            return 0;
        }
        StructInfo* info = symbols.struct_at(Types.struct_index(type));
        if (info.origin == null || info.type_args == null) {
            return 0;
        }
        StructInfo* origin = info.origin;
        u32 atom = Ast.intern_base_name("arr", 3);
        if (origin.name_atom != atom) {
            return 0;
        }
        IdList* args = info.type_args;
        return args.get(0);
    }

    u32 check_array_literal(Node* node, u32 expected) {
        SymbolTable* symbols = this.symbols;
        mut u32 element = this.array_element(expected);
        if (element == 0 && node.count() == 0) {
            this.error(node, "an empty array literal needs an array type from its context");
            return Types.i32_type();
        }
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            u32 actual = this.check_expression(node.child(i), element);
            if (element == 0) {
                element = actual;
            }
        }
        u32 atom = Ast.intern_base_name("arr", 3);
        StructInfo* template = symbols.find_struct(atom, atom, 0);
        if (template == null || !template.is_template) {
            this.error(node, "array literals need the core 'arr' type");
            return Types.i32_type();
        }
        IdList* args = IdList.create();
        args.push(element);
        symbols.blame = node;
        SemanticAnalyzer* analyzer = symbols.analyzer;
        return analyzer.instantiate(template, args);
    }

    u32 check_struct_init(Node* node, u32 declared) {
        SymbolTable* symbols = this.symbols;
        mut u32 expected = declared;
        if (node.type() != null) {
            expected = this.resolve_type(node.type(), node);
        }
        if (expected == 0 || !Types.is_struct(expected) || symbols.enum_of_type(expected) != null) {
            this.error(node, "a struct initializer needs a struct type from its context");
            return Types.i32_type();
        }
        StructInfo* info = symbols.struct_at(Types.struct_index(expected));
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* init = node.child(i);
            FieldInfo* field = symbols.find_field(info, init.name());
            if (field == null) {
                this.error(init, "struct has no such field");
                this.check_expression(init.first(), 0);
            } else {
                init.set_symbol(SymbolKind.FIELD, (void*)field);
                this.check_expression(init.first(), field.type);
            }
        }
        return expected;
    }

    u32 check_switch_expression(Node* node, u32 expected) {
        SymbolTable* symbols = this.symbols;
        u32 subject_type = this.check_expression(node.first(), 0);
        StructInfo* owner = symbols.enum_of_type(subject_type);
        if (owner == null) {
            this.error(node.first(), "switch expression needs an enum value");
            return Types.i32_type();
        }

        PointerList* constants = owner.constants;
        mut i32 covered = 0;
        mut u32 result = expected;
        LocalScopes* scopes = this.scopes;
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            Node* arm = node.child(i);
            Node* variant = symbols.find_constant(owner, arm.name());
            if (variant == null) {
                this.error(arm, "enum has no such variant");
                continue;
            }
            if (arm.symbol() != null) {
                this.error(arm, "variant is matched more than once");
            } else {
                covered = covered + 1;
            }
            arm.set_symbol(SymbolKind.CONSTANT, (void*)variant);
            if (arm.count() != variant.count()) {
                this.error(arm, "wrong number of bindings for the variant payload");
                continue;
            }

            i32 mark = scopes.mark();
            for (mut i32 b = 0; b < arm.count(); b = b + 1) {
                Node* binding = arm.child(b);
                Node* payload = variant.child(b);
                LocalVariable* variable = (LocalVariable*)Memory.zalloc(sizeof(LocalVariable));
                variable.name = binding.text();
                variable.name_atom = binding.name();
                variable.type = payload.value_type();
                variable.node = binding;
                binding.set_symbol(SymbolKind.LOCAL, (void*)variable);
                binding.set_value_type(variable.type);
                scopes.define(variable.name_atom, variable);
            }
            u32 arm_type = this.check_expression(arm.first(), result);
            if (result == 0) {
                result = arm_type;
            }
            scopes.reset_to(mark);
        }
        if (covered < constants.length) {
            this.error(node, "switch expression does not cover every variant");
        }
        if (result == 0) {
            return Types.i32_type();
        }
        return result;
    }

    Node* infer_enum_variant(StructInfo* template, u32 variant_atom, Node* call, u32 expected) {
        SymbolTable* symbols = this.symbols;
        StructInfo* hinted = symbols.enum_of_type(expected);
        if (hinted != null && hinted.origin == template) {
            return symbols.find_constant(hinted, variant_atom);
        }
        Node* pattern = symbols.find_constant(template, variant_atom);
        if (pattern == null) {
            return null;
        }
        GenericParams* params = template.generics;
        IdList* found = IdList.create();
        for (mut i32 p = 0; p < params.count(); p = p + 1) {
            found.push(0);
        }
        for (mut i32 a = 0; a < call.count() && a < pattern.count(); a = a + 1) {
            Node* payload = pattern.child(a);
            u32 actual = this.check_expression(call.child(a), 0);
            this.unify(payload.type(), actual, params, found);
        }
        for (mut i32 p = 0; p < found.length; p = p + 1) {
            if (found.get(p) == 0) {
                this.error(call, "cannot infer the type arguments of the generic enum; write them or give the expected type");
                return null;
            }
        }
        symbols.blame = call;
        SemanticAnalyzer* analyzer = symbols.analyzer;
        u32 instance = analyzer.instantiate(template, found);
        return symbols.find_constant(symbols.enum_of_type(instance), variant_atom);
    }

    Node* find_enum_variant(Node* callee, Node* call, u32 expected) {
        TypeRef* owner_ref = callee.type();
        if (owner_ref != null && owner_ref.name != null && !callee.flag()) {
            u32 owner_type = this.resolve_type(callee.type(), callee);
            SymbolTable* known = this.symbols;
            StructInfo* generic_owner = known.enum_of_type(owner_type);
            if (generic_owner == null) {
                this.error(callee, "type is not an enum");
                return null;
            }
            i8* variant_text = callee.text();
            i32 variant_length = (i32)strlen(variant_text);
            return known.find_constant(generic_owner, Ast.intern_base_name(variant_text, variant_length));
        }
        i8* text = callee.text();
        i32 length = (i32)strlen(text);
        mut i32 split = -1;
        for (mut i32 i = 0; i + 1 < length; i = i + 1) {
            if (text[i] == 58 && text[i + 1] == 58) {
                split = i;
            }
        }
        if (split < 0) {
            return null;
        }
        AtomTable* atoms = Ast.atoms();
        u32 full = atoms.intern_copy(text, (u32)split);
        u32 base = Ast.intern_base_name(text, split);
        SymbolTable* symbols = this.symbols;
        StructInfo* owner = symbols.find_struct(full, base, this.scope);
        if (owner == null || !owner.is_enum) {
            return null;
        }
        u32 variant_atom = Ast.intern_base_name(text, length);
        if (owner.is_template) {
            return this.infer_enum_variant(owner, variant_atom, call, expected);
        }
        return symbols.find_constant(owner, variant_atom);
    }

    bool unify(TypeRef* pattern, u32 actual, GenericParams* params, IdList* found) {
        SymbolTable* symbols = this.symbols;
        if (pattern.kind == TypeKind.POINTER) {
            if (!Types.is_pointer(actual)) {
                return false;
            }
            return this.unify(pattern.element, Types.element(actual), params, found);
        }
        if (pattern.kind != TypeKind.NAMED) {
            return true;
        }
        if (pattern.args == null) {
            i32 index = params.index_of(pattern.name_atom);
            if (index < 0) {
                return true;
            }
            u32 current = found.get(index);
            if (current == 0) {
                found.data[index] = actual;
                return true;
            }
            return current == actual;
        }
        if (!Types.is_struct(actual)) {
            return true;
        }
        StructInfo* instance = symbols.struct_at(Types.struct_index(actual));
        if (instance.origin == null) {
            return true;
        }
        PointerList* inner = pattern.args;
        IdList* actual_args = instance.type_args;
        for (mut i32 i = 0; i < inner.length && i < actual_args.length; i = i + 1) {
            if (!this.unify((TypeRef*)inner.get(i), actual_args.get(i), params, found)) {
                return false;
            }
        }
        return true;
    }

    FunctionInfo* instantiate_call(Node* node, Node* callee, FunctionInfo* template) {
        GenericParams* generics = template.generics;
        i32 count = generics.count();
        IdList* found = IdList.create();
        for (mut i32 i = 0; i < count; i = i + 1) {
            found.push(0);
        }
        if (callee.type() != null) {
            TypeRef* holder = callee.type();
            PointerList* given = holder.args;
            for (mut i32 i = 0; i < given.length && i < count; i = i + 1) {
                found.data[i] = this.resolve_type((TypeRef*)given.get(i), callee);
            }
        }
        Node* declaration = template.node;
        for (mut i32 a = 0; a < node.count() && a < declaration.count(); a = a + 1) {
            Node* parameter = declaration.child(a);
            mut u32 hint = 0;
            TypeRef* pattern = parameter.type();
            if (pattern.kind == TypeKind.NAMED && pattern.args == null) {
                i32 slot = generics.index_of(pattern.name_atom);
                if (slot >= 0) {
                    hint = found.get(slot);
                }
            }
            u32 actual = this.check_expression(node.child(a), hint);
            if (!this.unify(parameter.type(), actual, generics, found)) {
                this.error(node.child(a), "argument conflicts with the inferred type argument");
                return null;
            }
        }
        for (mut i32 i = 0; i < count; i = i + 1) {
            if (found.get(i) == 0) {
                this.error(node, "cannot infer a type argument of this generic function");
                return null;
            }
        }
        SymbolTable* symbols = this.symbols;
        SemanticAnalyzer* analyzer = symbols.analyzer;
        U32Map* saved_bindings = symbols.bindings;
        FunctionInfo* instance = analyzer.instantiate_function(template, found, node);
        symbols.bindings = saved_bindings;
        return instance;
    }

    bool names_fit(Node* call, FunctionInfo* info) {
        Node* declaration = info.node;
        if (declaration == null || declaration.count() != call.count()) {
            return false;
        }
        mut bool named_seen = false;
        IdList* taken = IdList.create();
        for (mut i32 i = 0; i < call.count(); i = i + 1) {
            taken.push(0);
        }
        for (mut i32 i = 0; i < call.count(); i = i + 1) {
            Node* argument = call.child(i);
            if (argument.kind != NodeKind.NAMED_ARG) {
                if (named_seen) {
                    return false;
                }
                taken.data[i] = 1;
            } else {
                named_seen = true;
                i32 position = this.parameter_index(declaration, argument.text());
                if (position < 0 || taken.get(position) != 0) {
                    return false;
                }
                taken.data[position] = 1;
            }
        }
        return true;
    }

    i32 parameter_index(Node* declaration, i8* name) {
        for (mut i32 i = 0; i < declaration.count(); i = i + 1) {
            if (strcmp(declaration.child(i).text(), name) == 0) {
                return i;
            }
        }
        return 0 - 1;
    }

    FunctionInfo* apply_named_arguments(Node* call, FunctionInfo* head) {
        mut bool named = false;
        for (mut i32 i = 0; i < call.count(); i = i + 1) {
            if (call.child(i).kind == NodeKind.NAMED_ARG) {
                named = true;
            }
        }
        if (!named || head == null) {
            return head;
        }
        mut FunctionInfo* candidate = head;
        while (candidate != null) {
            if (this.names_fit(call, candidate)) {
                Node* declaration = candidate.node;
                i32 count = call.count();
                Node** ordered = (Node**)Memory.zalloc((i64)count * 8);
                for (mut i32 i = 0; i < count; i = i + 1) {
                    Node* argument = call.child(i);
                    if (argument.kind == NodeKind.NAMED_ARG) {
                        ordered[this.parameter_index(declaration, argument.text())] = argument.first();
                    } else {
                        ordered[i] = argument;
                    }
                }
                for (mut i32 i = 0; i < count; i = i + 1) {
                    call.set_child(i, ordered[i]);
                }
                return candidate;
            }
            candidate = candidate.overload;
        }
        this.error(call, "no declaration matches these argument names");
        for (mut i32 i = 0; i < call.count(); i = i + 1) {
            Node* argument = call.child(i);
            if (argument.kind == NodeKind.NAMED_ARG) {
                call.set_child(i, argument.first());
            }
        }
        return head;
    }

    FunctionInfo* pick_overload(FunctionInfo* head, Node* call, i32 offset) {
        IdList* types = IdList.create();
        for (mut i32 i = 0; i < call.count(); i = i + 1) {
            Node* argument = call.child(i);
            if (argument.kind == NodeKind.STRUCT_INIT) {
                types.push(0);
            } else {
                types.push(this.check_expression(argument, 0));
            }
        }
        mut FunctionInfo* best = (FunctionInfo*)0;
        mut i32 best_score = 0 - 1;
        mut bool ambiguous = false;
        mut FunctionInfo* candidate = head;
        while (candidate != null) {
            IdList* params = candidate.param_types;
            i32 fixed = params.length - offset;
            bool arity_ok = call.count() == fixed || (candidate.is_variadic && call.count() >= fixed);
            if (!candidate.is_template && arity_ok) {
                mut i32 score = 0;
                mut bool fits = true;
                for (mut i32 i = 0; i < call.count() && i < fixed; i = i + 1) {
                    u32 expected = params.get(i + offset);
                    u32 actual = types.get(i);
                    if (actual == 0) {
                        if (Types.is_struct(expected)) {
                            score = score + 1;
                        } else {
                            fits = false;
                        }
                    } else if (actual == expected) {
                        score = score + 4;
                    } else if ((Types.is_integer(actual) || Types.is_float(actual)) && (Types.is_integer(expected) || Types.is_float(expected))) {
                        score = score + 1;
                    } else if (Types.is_pointer(actual) && Types.is_pointer(expected)) {
                        score = score + 1;
                    } else {
                        fits = false;
                    }
                }
                if (fits) {
                    if (score > best_score) {
                        best = candidate;
                        best_score = score;
                        ambiguous = false;
                    } else if (score == best_score) {
                        ambiguous = true;
                    }
                }
            }
            candidate = candidate.overload;
        }
        if (best == null) {
            this.error(call, "no overload matches these arguments");
            return null;
        }
        if (ambiguous) {
            this.error(call, "call is ambiguous between overloads");
            return null;
        }
        return best;
    }

    FunctionInfo* check_constructor_arguments(Node* node, StructInfo* owner) {
        SymbolTable* symbols = this.symbols;
        mut FunctionInfo* constructor = symbols.find_method(owner, Ast.intern_base_name(".ctor", 5));
        constructor = this.apply_named_arguments(node, constructor);
        if (constructor != null && constructor.overload != null) {
            constructor = this.pick_overload(constructor, node, 1);
            if (constructor == null) {
                return constructor;
            }
        }
        if (constructor == null) {
            if (node.count() > 0) {
                this.error(node, "struct has no constructor");
            }
            for (mut i32 i = 0; i < node.count(); i = i + 1) {
                this.check_expression(node.child(i), 0);
            }
            return constructor;
        }
        IdList* params = constructor.param_types;
        if (params.length != node.count() + 1) {
            this.error(node, "wrong number of constructor arguments");
            return constructor;
        }
        for (mut i32 i = 0; i < node.count(); i = i + 1) {
            this.check_expression(node.child(i), params.get(i + 1));
        }
        return constructor;
    }

    u32 constructor_owner_type(Node* at, u32 type) {
        SymbolTable* symbols = this.symbols;
        if (!Types.is_struct(type) || symbols.enum_of_type(type) != null) {
            this.error(at, "only structs have constructors");
            return 0;
        }
        return type;
    }

    u32 check_constructor(Node* node, Node* callee, u32 type) {
        if (this.constructor_owner_type(node, type) == 0) {
            return Types.i32_type();
        }
        SymbolTable* symbols = this.symbols;
        StructInfo* owner = symbols.struct_at(Types.struct_index(type));
        FunctionInfo* constructor = this.check_constructor_arguments(node, owner);
        callee.set_symbol(SymbolKind.CONSTRUCTOR, (void*)constructor);
        return type;
    }

    u32 check_new(Node* node) {
        u32 type = this.resolve_type(node.type(), node);
        if (this.constructor_owner_type(node, type) == 0) {
            return Types.pointer_to(Types.i32_type());
        }
        SymbolTable* symbols = this.symbols;
        StructInfo* owner = symbols.struct_at(Types.struct_index(type));
        FunctionInfo* constructor = this.check_constructor_arguments(node, owner);
        node.set_symbol(SymbolKind.CONSTRUCTOR, (void*)constructor);
        return Types.pointer_to(type);
    }

    u32 check_call(Node* node, u32 expected) {
        Node* callee = node.first();
        SymbolTable* symbols = this.symbols;
        mut FunctionInfo* info = (FunctionInfo*)0;
        mut i32 offset = 0;

        if (callee.kind == NodeKind.IDENTIFIER) {
            Node* variant = this.find_enum_variant(callee, node, expected);
            if (variant != null) {
                if (node.count() != variant.count()) {
                    this.error(node, "wrong number of enum variant arguments");
                }
                for (mut i32 a = 0; a < node.count() && a < variant.count(); a = a + 1) {
                    Node* payload = variant.child(a);
                    this.check_expression(node.child(a), payload.value_type());
                }
                callee.set_symbol(SymbolKind.CONSTANT, (void*)variant);
                return variant.value_type();
            }
            if (callee.flag() && callee.type() != null) {
                u32 constructed = this.resolve_type(callee.type(), callee);
                return this.check_constructor(node, callee, constructed);
            }
            info = symbols.find_function(callee.text_atom(), callee.name(), this.scope);
            info = this.apply_named_arguments(node, info);
            if (info == null) {
                StructInfo* named = symbols.find_struct(callee.text_atom(), callee.name(), this.scope);
                if (named != null && !named.is_template && !named.is_enum) {
                    return this.check_constructor(node, callee, named.type_id);
                }
            }
            if (info != null && info.is_template) {
                info = this.instantiate_call(node, callee, info);
                if (info == null) {
                    return Types.i32_type();
                }
            }
            if (info != null && info.overload != null) {
                info = this.pick_overload(info, node, 0);
                if (info == null) {
                    return Types.i32_type();
                }
            }
            callee.set_symbol(SymbolKind.FUNCTION, (void*)info);
        } else if (callee.kind == NodeKind.FIELD_ACCESS) {
            Node* base = callee.first();
            if (this.is_struct_name(base)) {
                StructInfo* owner = symbols.find_struct(base.text_atom(), base.name(), this.scope);
                base.set_symbol(SymbolKind.STRUCT_NAME, (void*)owner);
                info = symbols.find_method(owner, callee.name());
                info = this.apply_named_arguments(node, info);
                if (info != null && info.is_template) {
                    info = this.instantiate_call(node, callee, info);
                    if (info == null) {
                        return Types.i32_type();
                    }
                }
                if (info != null && info.is_instance) {
                    this.error(callee, "instance method called without an instance");
                    return Types.i32_type();
                }
                if (info != null && info.overload != null) {
                    info = this.pick_overload(info, node, 0);
                    if (info == null) {
                        return Types.i32_type();
                    }
                }
                callee.set_symbol(SymbolKind.STATIC_METHOD, (void*)info);
            } else {
                StructInfo* owner = this.struct_of_base(base);
                if (owner == null) {
                    return Types.i32_type();
                }
                info = symbols.find_method(owner, callee.name());
                info = this.apply_named_arguments(node, info);
                if (info != null && info.is_template) {
                    info = this.instantiate_call(node, callee, info);
                    if (info == null) {
                        return Types.i32_type();
                    }
                }
                if (info != null && !info.is_instance) {
                    this.error(callee, "static method called on an instance");
                    return Types.i32_type();
                }
                if (info != null && info.overload != null) {
                    info = this.pick_overload(info, node, 1);
                    if (info == null) {
                        return Types.i32_type();
                    }
                }
                callee.set_symbol(SymbolKind.INSTANCE_METHOD, (void*)info);
                offset = 1;
            }
        } else {
            this.error(node, "only calls to named functions are supported yet");
            return Types.i32_type();
        }

        if (info == null) {
            this.error(callee, "call to an undeclared function");
            return Types.i32_type();
        }

        IdList* param_types = info.param_types;
        i32 fixed = param_types.length;
        i32 given = node.count() + offset;
        if (given < fixed || (given > fixed && !info.is_variadic)) {
            this.error(node, "wrong number of arguments");
            return info.return_type;
        }

        for (mut i32 i = offset; i < given; i = i + 1) {
            Node* argument = node.child(i - offset);
            if (i < fixed) {
                this.check_expression(argument, param_types.get(i));
            } else {
                this.check_expression(argument, 0);
            }
        }
        if (info.is_async) {
            return this.task_of(info.return_type, node);
        }
        return info.return_type;
    }
}
