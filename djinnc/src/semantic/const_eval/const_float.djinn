namespace djinnc;

// x.min(y), x.maximum(y)... evaluated with the semantics of the selected IEEE 754 revision, as code_generator_float.djinn emits them.
struct ConstFloat {
    static bool negative(f64 value) {
        return ConstBits.of_float(value) < 0;
    }

    static f64 propagating(bool minimum_side, f64 a, f64 b) {
        if (a != a) { return a; }
        if (b != b) { return b; }
        if (a == b) {
            if (minimum_side == ConstFloat.negative(a)) { return a; }
            return b;
        }
        if ((a < b) == minimum_side) { return a; }
        return b;
    }

    static f64 ignoring_nan(bool minimum_side, f64 a, f64 b) {
        if (a != a) { return b; }
        if (b != b) { return a; }
        return ConstFloat.propagating(minimum_side, a, b);
    }

    public static f64 pick(i32 builtin, FloatStandard standard, f64 a, f64 b) {
        bool minimum_side = builtin == FloatBuiltin.MIN || builtin == FloatBuiltin.MINIMUM || builtin == FloatBuiltin.MINIMUM_NUMBER;
        if (builtin == FloatBuiltin.MINIMUM || builtin == FloatBuiltin.MAXIMUM) {
            return ConstFloat.propagating(minimum_side, a, b);
        }
        if ((builtin == FloatBuiltin.MIN || builtin == FloatBuiltin.MAX) && standard == FloatStandard::IEEE754_1985) {
            if (minimum_side) {
                if (a < b) { return a; }
                return b;
            }
            if (a > b) { return a; }
            return b;
        }
        return ConstFloat.ignoring_nan(minimum_side, a, b);
    }
}
