namespace djinnc;

extern "C" {
    i32 __djinn_host_call_f64(ptr<i8> name, i32 arity, f64 a, f64 b, ptr<f64> result);
}

struct ConstEval {
    const i32 SIGNED = 256;
    const i32 FLOAT = 512;
    const i32 INTEGER = 1024;
    const i32 KNOWN = 2048;
    const i32 NUMERIC = 1536;
    const i32 TEXT = 4096;
    const i32 STRING = 8192;
    const i32 STRUCT = 16384;
    const i32 POINTER = 32768;
    const i32 SCALAR = 54784;
    const i32 BLOCK_LIMIT = 4096;
    const i64 HEAP_LIMIT = 4194304;
    const i32 STEP_LIMIT = 1000000;
    const i64 TIME_LIMIT_US = 2000000;
    const i64 CELL_LIMIT = 16777216;
    const i32 DEPTH_LIMIT = 512;
    const i32 FRAME_CAPACITY = 16384;
    const i32 SHAPE_CAPACITY = 8192;

    TypeChecker* checker;
    ptr<i64> ints;
    ptr<f64> floats;
    ptr<i32> shapes;
    ptr<i32> struct_cache;
    ptr<i64> block_base;
    ptr<i64> block_size;
    ptr<i64> block_live;
    i32 block_count;
    i64 heap_bytes;
    i32 base;
    i32 top;
    i32 depth;
    i32 steps;
    i64 deadline;
    i64 cell_bytes;
    ptr<ptr<i8>> trace_names;
    i32 nesting;
    bool in_frame;
    i32 return_shape;
    i64 ri;
    f64 rf;
    ptr<i8> reason;
    Node* blame;
    ptr<i8> failure;
    Node* failure_node;
    i64 evaluations;
    i64 total_steps;
    u32 str_type;
    u32 string_type;

    public static unsafe ConstEval* create(TypeChecker* checker) {
        Arena* arena = Memory.arena();
        ConstEval* evaluator = (ConstEval*)arena.zalloc(sizeof(ConstEval), 8);
        evaluator.checker = checker;
        evaluator.shapes = (ptr<i32>)arena.zalloc((u64)ConstEval.SHAPE_CAPACITY * 4, 4);
        evaluator.struct_cache = (ptr<i32>)arena.zalloc((u64)ConstEval.SHAPE_CAPACITY * 4, 4);
        return evaluator;
    }

    public static i32 kind_of(i32 op) {
        if ((op & 4) != 0) {
            return 2;
        }
        if ((op & 2) != 0) {
            return 1;
        }
        return 0;
    }

    void ensure_storage() {
        if (this.ints != null) {
            return;
        }
        Arena* arena = Memory.arena();
        this.ints = (ptr<i64>)arena.zalloc((u64)ConstEval.FRAME_CAPACITY * 8, 8);
        this.floats = (ptr<f64>)arena.zalloc((u64)ConstEval.FRAME_CAPACITY * 8, 8);
        this.trace_names = (ptr<ptr<i8>>)arena.zalloc((u64)(ConstEval.DEPTH_LIMIT + 2) * 8, 8);
    }

    // The call chain at the first failure, innermost first, so a limit or a runtime-style error names the constexpr
    // function that was running: "... (in 'push', called from 'fill', called from 'build')".
    unsafe ptr<i8> with_trace(ptr<i8> reason) {
        if (this.depth <= 0 || this.trace_names == null) {
            return reason;
        }
        ByteBuffer* text = ByteBuffer.create();
        text.append(reason);
        mut i32 shown = 0;
        for (mut i32 level = this.depth; level >= 1 && shown < 6; level = level - 1) {
            ptr<i8> name = this.trace_names[level];
            if (name == null) {
                continue;
            }
            if (shown == 0) {
                text.append(" (in '");
            } else {
                text.append(", called from '");
            }
            text.append(name);
            text.append("'");
            shown = shown + 1;
        }
        if (shown > 0) {
            if (this.depth > 6) {
                text.append(", ...");
            }
            text.append(")");
        }
        return text.cstr();
    }

    static i32 describe(u32 type) {
        mut i32 shape = ConstEval.KNOWN;
        if (Types.is_integer(type)) {
            shape = shape | ConstEval.INTEGER | (i32)Types.bits(type);
            if (Types.is_signed(type)) {
                shape = shape | ConstEval.SIGNED;
            }
        } else if (Types.is_float(type)) {
            shape = shape | ConstEval.FLOAT | (i32)Types.bits(type);
        } else if (type == Types.byte_pointer()) {
            shape = shape | ConstEval.TEXT | 64;
        } else if (Types.is_pointer(type)) {
            shape = shape | ConstEval.POINTER | 64;
        }
        return shape;
    }

    // The evaluator computes in 64 bits, so i128 and u128 values are not evaluated: a constexpr call that touches
    // one falls back to run time and a consteval or constant use reports it, rather than overflow or wrap wrongly.
    static bool wide(i32 shape) {
        return (shape & ConstEval.INTEGER) != 0 && (shape & 255) > 64;
    }

    unsafe i32 shape_of(u32 type) {
        i32 text = this.text_shape(type);
        if (text != 0) {
            return text;
        }
        i32 composite = this.struct_shape(type);
        if (composite != 0) {
            return composite;
        }
        if (type < (u32)ConstEval.SHAPE_CAPACITY) {
            i32 cached = this.shapes[type];
            if (cached != 0) {
                return cached;
            }
            i32 shape = ConstEval.describe(type);
            this.shapes[type] = shape;
            return shape;
        }
        return ConstEval.describe(type);
    }

    static i64 wrap(i64 value, i32 shape) {
        i32 bits = shape & 255;
        if (bits >= 64) {
            return value;
        }
        if (bits == 1) {
            if (value != 0) {
                return 1;
            }
            return 0;
        }
        i64 modulus = (i64)1 << bits;
        i64 low = value & (modulus - 1);
        if ((shape & ConstEval.SIGNED) != 0 && (low & (modulus >> 1)) != 0) {
            return low - modulus;
        }
        return low;
    }

    static f64 int_to_float(i64 value, i32 shape) {
        if ((shape & 255) == 64 && (shape & ConstEval.SIGNED) == 0) {
            return (f64)(u64)value;
        }
        return (f64)value;
    }

    public static i64 minimum(i32 shape) {
        i32 bits = shape & 255;
        if (bits >= 64) {
            return (i64)1 << 63;
        }
        return 0 - ((i64)1 << (bits - 1));
    }

    public static bool holds(i64 value, bool from_unsigned, i32 shape) {
        i32 bits = shape & 255;
        bool is_signed = (shape & ConstEval.SIGNED) != 0;
        if (value < 0 && from_unsigned) {
            return !is_signed && bits >= 64;
        }
        if (value < 0) {
            return is_signed && (bits >= 64 || value >= ConstEval.minimum(shape));
        }
        if (bits >= 64) {
            return true;
        }
        if (is_signed) {
            return value < (i64)1 << (bits - 1);
        }
        return value < (i64)1 << bits;
    }

    public static bool fits(f64 value, i32 shape) {
        i32 bits = shape & 255;
        mut f64 limit = 1.0;
        for (mut i32 i = 0; i < bits; i = i + 1) {
            limit = limit * 2.0;
        }
        if ((shape & ConstEval.SIGNED) == 0) {
            return value > 0.0 - 1.0 && value < limit;
        }
        limit = limit / 2.0;
        if (bits > 53) {
            return value >= 0.0 - limit && value < limit;
        }
        return value > 0.0 - limit - 1.0 && value < limit;
    }

    static i64 truncate(f64 value, i32 shape) {
        if (ConstEval.is_wide_unsigned(shape) && ConstEval.fits(value, shape)) {
            return (i64)(u64)value;
        }
        if (ConstEval.fits(value, ConstEval.SIGNED | 64)) {
            return (i64)value;
        }
        return 0;
    }

    void convert(i32 from, i32 to) {
        if (from == to) {
            return;
        }
        bool from_float = (from & ConstEval.FLOAT) != 0;
        if ((to & ConstEval.FLOAT) != 0) {
            if (!from_float) {
                this.rf = ConstEval.int_to_float(this.ri, from);
            }
            if ((to & 255) == 32) {
                this.rf = (f64)(f32)this.rf;
            }
            return;
        }
        if (from_float) {
            if ((to & 255) == 1) {
                if (this.rf != 0.0) {
                    this.ri = 1;
                } else {
                    this.ri = 0;
                }
                return;
            }
            this.ri = ConstEval.truncate(this.rf, to);
        }
        this.ri = ConstEval.wrap(this.ri, to);
    }

    unsafe bool fail(Node* at, ptr<i8> reason) {
        if (this.reason == null) {
            this.reason = this.with_trace(reason);
            this.blame = at;
        }
        return false;
    }

    bool tick(Node* at) {
        this.steps = this.steps + 1;
        if (this.steps > ConstEval.STEP_LIMIT) {
            return this.fail(at, "evaluation step limit exceeded");
        }
        if (this.cell_bytes > ConstEval.CELL_LIMIT) {
            return this.fail(at, "compile-time memory limit exceeded");
        }
        if ((this.steps & 1023) == 0 && __djinn_now_us() > this.deadline) {
            return this.fail(at, "evaluation time limit exceeded");
        }
        return true;
    }

    public unsafe bool evaluate(Node* expression, u32 own_type, u32 target_type) {
        this.ensure_storage();
        i32 saved_base = this.base;
        i32 saved_top = this.top;
        bool saved_frame = this.in_frame;
        i32 saved_return = this.return_shape;
        ptr<i8> saved_reason = this.reason;
        Node* saved_blame = this.blame;
        if (this.nesting == 0) {
            this.steps = 0;
            this.deadline = __djinn_now_us() + ConstEval.TIME_LIMIT_US;
            this.heap_reset();
        }
        this.nesting = this.nesting + 1;
        this.base = this.top;
        this.in_frame = false;
        this.reason = null;
        this.blame = (Node*)0;

        i32 own = this.shape_of(own_type);
        i32 target = this.shape_of(target_type);
        mut bool ok = false;
        if ((own & ConstEval.SCALAR) == 0 || (target & ConstEval.SCALAR) == 0 || ((own | target) & (ConstEval.STRUCT | ConstEval.POINTER)) != 0) {
            ok = this.fail(expression, "only integers, floats, booleans, enums and string literals are supported");
        } else {
            ok = this.eval(expression);
            if (ok) {
                this.convert(own, target);
            }
            if (ok && (own & ConstEval.TEXT) != 0 && this.find_block(this.ri) >= 0) {
                ok = this.fail(expression, "a pointer into compile-time memory cannot be the result of a constant expression");
            }
            if (ok && this.nesting == 1 && this.heap_leaks()) {
                ok = this.fail(expression, "compile-time allocation is never freed");
            }
        }

        this.failure = this.reason;
        this.failure_node = this.blame;
        if (!ok && this.failure == null) {
            this.failure = "not a constant expression";
        }
        this.evaluations = this.evaluations + 1;
        this.nesting = this.nesting - 1;
        if (this.nesting == 0) {
            this.total_steps = this.total_steps + (i64)this.steps;
        }
        this.base = saved_base;
        this.top = saved_top;
        this.in_frame = saved_frame;
        this.return_shape = saved_return;
        this.reason = saved_reason;
        this.blame = saved_blame;
        return ok;
    }

    public void fold(Node* node, u32 type) {
        i32 shape = this.shape_of(type);
        i64 whole = this.ri;
        f64 real = this.rf;
        node.flags = (u16)0;
        if ((shape & ConstEval.TEXT) != 0) {
            node.set_kind(NodeKind::INT_LITERAL);
            node.set_int_value(whole);
        } else if ((shape & ConstEval.FLOAT) != 0) {
            node.set_kind(NodeKind::FLOAT_CONST);
            node.set_int_value(ConstBits.of_float(real));
        } else if ((shape & 255) == 1) {
            node.set_kind(NodeKind::BOOL_LITERAL);
            node.set_int_value(whole);
        } else {
            node.set_kind(NodeKind::INT_LITERAL);
            node.set_int_value(whole);
        }
        node.set_value_type(type);
    }

    bool eval(Node* node) {
        NodeKind kind = node.kind();
        if (kind == NodeKind::INT_LITERAL) {
            this.ri = node.int_value();
            i32 literal_shape = this.shape_of(node.value_type());
            bool sized = (literal_shape & ConstEval.INTEGER) != 0 && (literal_shape & 255) > 1 && (literal_shape & 255) < 64;
            if (sized && node.mode() == OverflowMode::SATURATING && !ConstEval.holds(this.ri, false, literal_shape)) {
                this.ri = ConstEval.limit(this.ri, literal_shape);
            }
            this.rf = (f64)this.ri;
            return true;
        }
        if (kind == NodeKind::IDENTIFIER) {
            return this.eval_identifier(node);
        }
        if (kind == NodeKind::STRING_LITERAL) {
            if ((this.shape_of(node.value_type()) & ConstEval.TEXT) == 0) {
                return this.fail(node, "only ptr<i8> string literals can be evaluated at compile time");
            }
            this.ri = (i64)node.text();
            this.rf = 0.0;
            return true;
        }
        if (kind == NodeKind::INTERPOLATION) {
            return this.eval_interpolation(node);
        }
        if (kind == NodeKind::INDEX) {
            return this.eval_index(node);
        }
        if (kind == NodeKind::BINARY) {
            return this.eval_binary(node);
        }
        if (kind == NodeKind::CALL) {
            return this.eval_call(node);
        }
        if (kind == NodeKind::UNARY) {
            return this.eval_unary(node);
        }
        if (kind == NodeKind::NULL_LITERAL) {
            this.ri = 0;
            this.rf = 0.0;
            return true;
        }
        if (kind == NodeKind::BOOL_LITERAL) {
            this.ri = node.int_value();
            this.rf = (f64)this.ri;
            return true;
        }
        if (kind == NodeKind::FLOAT_LITERAL) {
            this.rf = node.float_value();
            if ((this.shape_of(node.value_type()) & 255) == 32) {
                this.rf = (f64)(f32)this.rf;
            }
            return true;
        }
        if (kind == NodeKind::FLOAT_CONST) {
            this.rf = ConstBits.to_float(node.int_value());
            return true;
        }
        if (kind == NodeKind::CAST) {
            return this.eval_cast(node);
        }
        if (kind == NodeKind::ASSIGN) {
            return this.eval_assign(node);
        }
        if (kind == NodeKind::FIELD_ACCESS) {
            return this.eval_member(node);
        }
        if (kind == NodeKind::STRUCT_INIT) {
            return this.eval_struct_init(node);
        }
        if (kind == NodeKind::INTRINSIC && node.op() == Intrinsic.FLOAT_BITS) {
            return this.eval_float_bits(node);
        }
        if (kind == NodeKind::INTRINSIC && node.op() == Intrinsic.SIZEOF) {
            return this.eval_sizeof(node);
        }
        if (kind == NodeKind::INTRINSIC && (node.op() == Intrinsic.LIKELY || node.op() == Intrinsic.UNLIKELY)) {
            return this.eval_condition(node.first());
        }
        if (kind == NodeKind::INTRINSIC && node.op() == Intrinsic.ASSUME) {
            if (!this.eval_condition(node.first())) {
                return false;
            }
            if (this.ri == 0) {
                return this.fail(node, "an assumption does not hold");
            }
            return true;
        }
        if (kind == NodeKind::INTRINSIC && node.op() == Intrinsic.CONTRACT) {
            if ((node.int_value() >> 4) == ContractMode.IGNORE) {
                return true;
            }
            if (!this.eval_condition(node.first())) {
                return false;
            }
            if (this.ri == 0) {
                return this.fail(node, "a contract clause does not hold");
            }
            return true;
        }
        if (kind == NodeKind::INTRINSIC && (node.op() == Intrinsic.UNREACHABLE || node.op() == Intrinsic.DEBUGTRAP)) {
            return this.fail(node, "execution reached a trap or unreachable code");
        }
        return this.fail(node, "expression cannot be evaluated at compile time");
    }

    unsafe bool eval_float_bits(Node* node) {
        Node* operand = node.first();
        if (!this.eval(operand)) {
            return false;
        }
        i32 shape = this.shape_of(operand.value_type());
        if ((shape & ConstEval.FLOAT) == 0) {
            return this.fail(node, "float_bits needs a float operand");
        }
        if ((shape & 255) == 32) {
            this.ri = ConstBits.of_float32(this.rf);
        } else {
            this.ri = ConstBits.of_float(this.rf);
        }
        return true;
    }

    unsafe bool eval_sizeof(Node* node) {
        u32 measured = (u32)(u64)node.symbol();
        if (Types.is_integer(measured)) {
            this.ri = (i64)((Types.bits(measured) + 7) / 8);
        } else if (Types.is_float(measured)) {
            this.ri = (i64)(Types.bits(measured) / 8);
        } else if (Types.is_struct(measured)) {
            return this.fail(node, "sizeof of a struct is only known when the code is generated");
        } else {
            this.ri = 8;
        }
        this.rf = (f64)this.ri;
        return true;
    }

    bool eval_condition(Node* node) {
        if (!this.eval(node)) {
            return false;
        }
        i32 shape = this.shape_of(node.value_type());
        mut bool truth = false;
        if ((shape & ConstEval.FLOAT) != 0) {
            if (this.rf != 0.0) {
                truth = true;
            }
        } else {
            truth = this.ri != 0;
        }
        if (truth) {
            this.ri = 1;
        } else {
            this.ri = 0;
        }
        return true;
    }

    unsafe bool eval_identifier(Node* node) {
        i32 symbol_kind = node.symbol_kind();
        if (symbol_kind == SymbolKind.LOCAL) {
            LocalVariable* variable = (LocalVariable*)node.symbol();
            if (variable.const_state == 2) {
                this.ri = variable.const_int;
                this.rf = variable.const_float;
                return true;
            }
            if (this.in_frame && variable.eval_slot != 0) {
                i32 index = this.base + variable.eval_slot - 1;
                this.ri = this.ints[index];
                this.rf = this.floats[index];
                return true;
            }
            return this.fail(node, "variable is not a compile-time constant");
        }
        if (symbol_kind == SymbolKind.GLOBAL) {
            LocalVariable* variable = (LocalVariable*)node.symbol();
            if (variable.const_state == 0 && variable.node != null) {
                Node* declaration = variable.node;
                if (declaration.op() != 0) {
                    TypeChecker* checker = this.checker;
                    checker.ensure_global(variable);
                }
            }
            if (variable.const_state == 2) {
                this.ri = variable.const_int;
                this.rf = variable.const_float;
                return true;
            }
            if (variable.const_state == 1) {
                return this.fail(node, "constant depends on itself");
            }
            return this.fail(node, "global is not a compile-time constant");
        }
        return this.fail(node, "name is not a compile-time constant");
    }

    unsafe bool eval_member(Node* node) {
        if (node.symbol_kind() == SymbolKind.FIELD) {
            if ((this.shape_of(node.first().value_type()) & ConstEval.STRUCT) != 0) {
                return this.eval_struct_field(node);
            }
            return this.eval_text_length(node);
        }
        if (node.symbol_kind() != SymbolKind.CONSTANT) {
            return this.fail(node, "field access cannot be evaluated at compile time");
        }
        Node* constant = (Node*)node.symbol();
        return this.eval(constant.first());
    }

    bool eval_cast(Node* node) {
        Node* operand = node.first();
        if (!this.eval(operand)) {
            return false;
        }
        i32 from = this.shape_of(operand.value_type());
        i32 to = this.shape_of(node.value_type());
        if (ConstEval.wide(from) || ConstEval.wide(to)) {
            return this.fail(node, "128-bit integers cannot be evaluated at compile time");
        }
        i32 addressing = ConstEval.TEXT | ConstEval.POINTER | ConstEval.STRUCT;
        if (((from | to) & addressing) != 0) {
            bool from_ok = (from & (addressing | ConstEval.INTEGER)) != 0;
            bool to_ok = (to & (addressing | ConstEval.INTEGER)) != 0;
            if (!from_ok || !to_ok || ((from | to) & ConstEval.STRING) != 0) {
                return this.fail(node, "this cast cannot be evaluated at compile time");
            }
            if ((to & ConstEval.INTEGER) != 0 && (to & 255) < 64) {
                this.ri = ConstEval.wrap(this.ri, to);
            }
            this.rf = 0.0;
            return true;
        }
        if ((from & ConstEval.NUMERIC) == 0 || (to & ConstEval.NUMERIC) == 0) {
            return this.fail(node, "only numeric casts can be evaluated at compile time");
        }
        if ((to & ConstEval.INTEGER) != 0 && (to & 255) == 1) {
            mut bool binary = this.ri == 0 || this.ri == 1;
            if ((from & ConstEval.FLOAT) != 0) {
                binary = this.rf == 0.0 || this.rf == 1.0;
            }
            if (!binary) {
                return this.fail(node, "only 0 or 1 can be converted to bool");
            }
        }
        bool to_number = (to & ConstEval.INTEGER) != 0 && (to & 255) != 1;
        if ((from & ConstEval.FLOAT) != 0 && to_number && !ConstEval.fits(this.rf, to)) {
            return this.fail(node, "float value is out of range for the integer type");
        }
        if (node.mode() == OverflowMode::SATURATING && to_number && (from & ConstEval.FLOAT) == 0) {
            bool from_unsigned = (from & ConstEval.SIGNED) == 0;
            if (!ConstEval.holds(this.ri, from_unsigned, to)) {
                if (from_unsigned && this.ri < 0) {
                    this.ri = ConstEval.maximum(to);
                } else {
                    this.ri = ConstEval.limit(this.ri, to);
                }
                this.rf = 0.0;
                return true;
            }
        }
        this.convert(from, to);
        return true;
    }

    unsafe bool text_reaches(Node* at, ptr<i8> text, i64 offset) {
        if (offset < 0) {
            return this.fail(at, "string index is negative");
        }
        i32 block = this.find_block((i64)text);
        if (block >= 0) {
            if ((i64)text + offset > this.block_base[block] + this.block_size[block]) {
                return this.fail(at, "pointer access is out of bounds");
            }
            return true;
        }
        for (mut i64 i = 0; i < offset; i = i + 1) {
            if (text[i] == 0) {
                return this.fail(at, "string index is out of bounds");
            }
        }
        return true;
    }

    unsafe bool eval_index(Node* node) {
        Node* base = node.first();
        i32 base_shape = this.shape_of(base.value_type());
        if ((base_shape & ConstEval.POINTER) != 0 || ((base_shape & ConstEval.TEXT) != 0 && (base_shape & ConstEval.STRING) == 0 && base.value_type() != Types.byte_pointer())) {
            return this.eval_pointer_load(node, base, node.second());
        }
        if ((base_shape & ConstEval.TEXT) == 0) {
            return this.fail(node, "only strings and pointers can be indexed at compile time");
        }
        if (!this.eval(base)) {
            return false;
        }
        ptr<i8> text = (ptr<i8>)this.ri;
        if (!this.eval(node.second())) {
            return false;
        }
        if (!this.text_reaches(node, text, this.ri)) {
            return false;
        }
        if (this.find_block((i64)text) >= 0) {
            return this.load_typed(node, (i64)text + this.ri, Types.integer(8, true));
        }
        i8 character = text[this.ri];
        this.ri = (i64)character;
        this.rf = (f64)this.ri;
        return true;
    }

    unsafe bool eval_unary(Node* node) {
        TokenKind op = node.op_kind();
        Node* operand = node.first();
        if (node.symbol_kind() == SymbolKind.OPERATOR) {
            return this.eval_operator(node, false);
        }
        if (op == TokenKind::STAR) {
            i32 operand_shape = this.shape_of(operand.value_type());
            if ((operand_shape & ConstEval.POINTER) != 0) {
                return this.eval_pointer_load(node, operand, (Node*)0);
            }
            if ((operand_shape & ConstEval.STRUCT) != 0) {
                return this.eval(operand);
            }
            if ((operand_shape & ConstEval.TEXT) == 0) {
                return this.fail(node, "only strings and pointers can be dereferenced at compile time");
            }
            if (!this.eval(operand)) {
                return false;
            }
            ptr<i8> text = (ptr<i8>)this.ri;
            if (this.find_block((i64)text) >= 0) {
                return this.load_typed(node, (i64)text, Types.integer(8, true));
            }
            i8 first = text[0];
            this.ri = (i64)first;
            this.rf = (f64)this.ri;
            return true;
        }
        if (op == TokenKind::BANG) {
            if (!this.eval_condition(operand)) {
                return false;
            }
            this.ri = 1 - this.ri;
            return true;
        }
        if (op == TokenKind::PLUS_PLUS || op == TokenKind::MINUS_MINUS) {
            return this.eval_count(node);
        }
        if (op != TokenKind::MINUS && op != TokenKind::TILDE) {
            return this.fail(node, "operator cannot be evaluated at compile time");
        }
        if (!this.eval(operand)) {
            return false;
        }
        i32 shape = this.shape_of(node.value_type());
        if ((shape & ConstEval.NUMERIC) == 0) {
            return this.fail(node, "operand is not a number");
        }
        if (op == TokenKind::MINUS) {
            if ((shape & ConstEval.FLOAT) != 0) {
                this.rf = 0.0 - this.rf;
            } else {
                OverflowMode mode = node.mode();
                bool minimum = (shape & ConstEval.SIGNED) != 0 && this.ri == ConstEval.minimum(shape);
                if (minimum && mode.detects_overflow()) {
                    return this.fail(node, "integer overflow");
                }
                if (minimum && mode == OverflowMode::SATURATING) {
                    this.ri = ConstEval.maximum(shape);
                } else {
                    this.ri = ConstEval.wrap(0w - this.ri, shape);
                }
            }
            return true;
        }
        if ((shape & ConstEval.INTEGER) == 0) {
            return this.fail(node, "operand is not an integer");
        }
        this.ri = ConstEval.wrap(this.ri ^ (0 - 1), shape);
        return true;
    }

    unsafe bool eval_binary(Node* node) {
        TokenKind op = node.op_kind();
        i32 operator_kind = node.symbol_kind();
        bool text_operands = ((this.shape_of(node.first().value_type()) | this.shape_of(node.second().value_type())) & (ConstEval.STRING | ConstEval.TEXT)) != 0;
        if (!text_operands && (operator_kind == SymbolKind.OPERATOR || operator_kind == SymbolKind.NEGATED_OPERATOR)) {
            return this.eval_operator(node, operator_kind == SymbolKind.NEGATED_OPERATOR);
        }
        Node* left = node.first();
        Node* right = node.second();
        if (ConstEval.wide(this.shape_of(left.value_type())) || ConstEval.wide(this.shape_of(right.value_type()))) {
            return this.fail(node, "128-bit integers cannot be evaluated at compile time");
        }

        if (op == TokenKind::AND_AND) {
            if (!this.eval_condition(left)) {
                return false;
            }
            if (this.ri == 0) {
                return true;
            }
            return this.eval_condition(right);
        }
        if (op == TokenKind::OR_OR) {
            if (!this.eval_condition(left)) {
                return false;
            }
            if (this.ri != 0) {
                return true;
            }
            return this.eval_condition(right);
        }

        i32 left_shape = this.shape_of(left.value_type());
        i32 right_shape = this.shape_of(right.value_type());
        if ((left_shape & ConstEval.STRING) != 0 && (right_shape & ConstEval.STRING) != 0) {
            return this.eval_text_binary(node, op);
        }
        i32 addressing = ConstEval.TEXT | ConstEval.POINTER | ConstEval.STRUCT;
        if ((left_shape & ConstEval.POINTER) != 0 && (right_shape & ConstEval.INTEGER) != 0 && (op == TokenKind::PLUS || op == TokenKind::MINUS)) {
            return this.eval_pointer_offset(node, op, left, right);
        }
        if ((left_shape & ConstEval.POINTER) != 0 && (right_shape & ConstEval.POINTER) != 0 && op == TokenKind::MINUS) {
            return this.eval_pointer_difference(node);
        }
        if (((left_shape | right_shape) & addressing) != 0 && TypeChecker.is_comparison(op)) {
            if (!this.eval(left)) {
                return false;
            }
            i64 first = this.ri;
            if (!this.eval(right)) {
                return false;
            }
            this.ri = ConstEval.compare(op, first, this.ri, true);
            this.rf = 0.0;
            return true;
        }
        if ((left_shape & ConstEval.TEXT) != 0 && op == TokenKind::MINUS && (right_shape & ConstEval.INTEGER) != 0 && left.value_type() != Types.byte_pointer()) {
            return this.eval_pointer_offset(node, op, left, right);
        }
        if ((left_shape & ConstEval.TEXT) != 0 && op == TokenKind::PLUS && (right_shape & ConstEval.INTEGER) != 0) {
            if (!this.eval(left)) {
                return false;
            }
            ptr<i8> text = (ptr<i8>)this.ri;
            if (!this.eval(right)) {
                return false;
            }
            if (!this.text_reaches(node, text, this.ri)) {
                return false;
            }
            this.ri = (i64)(text + this.ri);
            return true;
        }
        if ((left_shape & ConstEval.NUMERIC) == 0 || (right_shape & ConstEval.NUMERIC) == 0) {
            return this.fail(node, "operands are not numbers");
        }
        bool use_float = ((left_shape | right_shape) & ConstEval.FLOAT) != 0;

        if (!this.eval(left)) {
            return false;
        }
        i64 a = this.ri;
        mut f64 af = this.rf;
        if (use_float && (left_shape & ConstEval.FLOAT) == 0) {
            af = ConstEval.int_to_float(a, left_shape);
        }
        if (!this.eval(right)) {
            return false;
        }
        i64 b = this.ri;
        mut f64 bf = this.rf;
        if (use_float && (right_shape & ConstEval.FLOAT) == 0) {
            bf = ConstEval.int_to_float(b, right_shape);
        }

        if (use_float) {
            return this.float_operation(node, op, af, bf);
        }
        return this.int_operation(node, op, a, b, left_shape, right_shape);
    }

    bool float_operation(Node* node, TokenKind op, f64 a, f64 b) {
        if (op == TokenKind::EQUAL_EQUAL) {
            this.ri = ConstEval.flag(a == b);
            return true;
        }
        if (op == TokenKind::BANG_EQUAL) {
            this.ri = ConstEval.flag(a != b);
            return true;
        }
        if (op == TokenKind::LESS) {
            this.ri = ConstEval.flag(a < b);
            return true;
        }
        if (op == TokenKind::LESS_EQUAL) {
            this.ri = ConstEval.flag(a <= b);
            return true;
        }
        if (op == TokenKind::GREATER) {
            this.ri = ConstEval.flag(a > b);
            return true;
        }
        if (op == TokenKind::GREATER_EQUAL) {
            this.ri = ConstEval.flag(a >= b);
            return true;
        }

        mut f64 value = 0.0;
        if (op == TokenKind::PLUS) {
            value = a + b;
        } else if (op == TokenKind::MINUS) {
            value = a - b;
        } else if (op == TokenKind::STAR) {
            value = a * b;
        } else if (op == TokenKind::SLASH) {
            value = a / b;
        } else {
            return this.fail(node, "operator cannot be evaluated on floating point values");
        }
        if ((this.shape_of(node.value_type()) & 255) == 32) {
            value = (f64)(f32)value;
        }
        this.rf = value;
        return true;
    }

    static i64 flag(bool value) {
        if (value) {
            return 1;
        }
        return 0;
    }

    static bool is_wide_unsigned(i32 shape) {
        return (shape & 255) == 64 && (shape & ConstEval.SIGNED) == 0;
    }

    bool int_operation(Node* node, TokenKind op, i64w a, i64w b, i32 left_shape, i32 right_shape) {
        if (TypeChecker.is_comparison(op)) {
            bool unsigned_compare = ConstEval.is_wide_unsigned(left_shape) || ConstEval.is_wide_unsigned(right_shape);
            this.ri = ConstEval.compare(op, a, b, unsigned_compare);
            return true;
        }

        i32 shape = this.shape_of(node.value_type());
        bool wide_unsigned = ConstEval.is_wide_unsigned(shape);
        mut i64w value = 0;
        if (op == TokenKind::PLUS) {
            value = a + b;
        } else if (op == TokenKind::MINUS) {
            value = a - b;
        } else if (op == TokenKind::STAR) {
            value = a * b;
        } else if (op == TokenKind::SLASH || op == TokenKind::PERCENT) {
            if (b == 0) {
                return this.fail(node, "division by zero");
            }
            if (wide_unsigned) {
                if (op == TokenKind::SLASH) {
                    value = (i64)((u64)a / (u64)b);
                } else {
                    value = (i64)((u64)a % (u64)b);
                }
            } else if (b == 0 - 1) {
                if (op == TokenKind::SLASH) {
                    if ((shape & ConstEval.SIGNED) != 0 && a == ConstEval.minimum(shape)) {
                        return this.fail(node, "integer overflow: the minimum value divided by -1");
                    }
                    value = 0w - a;
                }
            } else if (op == TokenKind::SLASH) {
                value = a / b;
            } else {
                value = a % b;
            }
        } else if (op == TokenKind::AMPERSAND) {
            value = a & b;
        } else if (op == TokenKind::PIPE) {
            value = a | b;
        } else if (op == TokenKind::CARET) {
            value = a ^ b;
        } else if (op == TokenKind::LESS_LESS || op == TokenKind::GREATER_GREATER) {
            if (b < 0 || b >= (i64)(shape & 255)) {
                return this.fail(node, "shift amount is out of range");
            }
            if (b >= 64) {
                return this.fail(node, "constants wider than 64 bits cannot be shifted at compile time");
            }
            if (op == TokenKind::LESS_LESS) {
                value = a << b;
            } else if (wide_unsigned) {
                value = (i64)((u64)a >> (u64)b);
            } else {
                value = a >> b;
            }
        } else {
            return this.fail(node, "operator cannot be evaluated at compile time");
        }
        bool arithmetic = op == TokenKind::PLUS || op == TokenKind::MINUS || op == TokenKind::STAR;
        OverflowMode mode = node.mode();
        if (arithmetic && mode != OverflowMode::WRAPPED) {
            bool wide = (shape & 255) >= 64;
            mut bool overflowed = false;
            if (wide) {
                overflowed = ConstEval.overflows_wide(op, a, b, value, (shape & ConstEval.SIGNED) != 0);
            } else {
                overflowed = !ConstEval.holds(value, false, shape);
            }
            if (overflowed) {
                if (mode != OverflowMode::SATURATING) {
                    return this.fail(node, "integer overflow (use the w suffix to wrap or the s suffix to saturate)");
                }
                if (wide) {
                    value = ConstEval.saturated_wide(op, a, b, (shape & ConstEval.SIGNED) != 0);
                } else {
                    value = ConstEval.limit(value, shape);
                }
            }
        }
        this.ri = ConstEval.wrap(value, shape);
        return true;
    }

    // 64-bit operands cannot be widened inside an i64, so the wrapped result is tested instead.
    static bool overflows_wide(TokenKind op, i64 a, i64 b, i64 wrapped, bool is_signed) {
        if (is_signed) {
            if (op == TokenKind::PLUS) {
                return ((a ^ wrapped) & (b ^ wrapped)) < 0;
            }
            if (op == TokenKind::MINUS) {
                return ((a ^ b) & (a ^ wrapped)) < 0;
            }
            if (a == 0) {
                return false;
            }
            if (a == 0 - 1) {
                return b == ConstEval.minimum(ConstEval.SIGNED | 64);
            }
            return wrapped / a != b;
        }
        if (op == TokenKind::PLUS) {
            return (u64)wrapped < (u64)a;
        }
        if (op == TokenKind::MINUS) {
            return (u64)a < (u64)b;
        }
        return a != 0 && (u64)wrapped / (u64)a != (u64)b;
    }

    static i64 saturated_wide(TokenKind op, i64 a, i64 b, bool is_signed) {
        if (!is_signed) {
            if (op == TokenKind::MINUS) {
                return 0;
            }
            return 0 - 1;
        }
        mut bool upward = a >= 0;
        if (op == TokenKind::STAR) {
            upward = (a < 0) == (b < 0);
        }
        if (upward) {
            return 9223372036854775807;
        }
        return ConstEval.minimum(ConstEval.SIGNED | 64);
    }

    static i64 maximum(i32 shape) {
        i32 bits = shape & 255;
        if ((shape & ConstEval.SIGNED) != 0) {
            if (bits >= 64) {
                return 9223372036854775807;
            }
            return ((i64)1 << (bits - 1)) - 1;
        }
        return ((i64)1 << bits) - 1;
    }

    // The nearest limit of the type for a value that does not fit it.
    static i64 limit(i64 value, i32 shape) {
        if (value < 0) {
            if ((shape & ConstEval.SIGNED) == 0) {
                return 0;
            }
            return ConstEval.minimum(shape);
        }
        return ConstEval.maximum(shape);
    }

    static i64 compare(TokenKind op, i64 a, i64 b, bool unsigned_compare) {
        if (op == TokenKind::EQUAL_EQUAL) {
            return ConstEval.flag(a == b);
        }
        if (op == TokenKind::BANG_EQUAL) {
            return ConstEval.flag(a != b);
        }
        if (unsigned_compare) {
            u64 x = (u64)a;
            u64 y = (u64)b;
            if (op == TokenKind::LESS) {
                return ConstEval.flag(x < y);
            }
            if (op == TokenKind::LESS_EQUAL) {
                return ConstEval.flag(x <= y);
            }
            if (op == TokenKind::GREATER) {
                return ConstEval.flag(x > y);
            }
            return ConstEval.flag(x >= y);
        }
        if (op == TokenKind::LESS) {
            return ConstEval.flag(a < b);
        }
        if (op == TokenKind::LESS_EQUAL) {
            return ConstEval.flag(a <= b);
        }
        if (op == TokenKind::GREATER) {
            return ConstEval.flag(a > b);
        }
        return ConstEval.flag(a >= b);
    }

    unsafe bool eval_count(Node* node) {
        Node* target = node.first();
        if (target.kind() != NodeKind::IDENTIFIER || target.symbol_kind() != SymbolKind.LOCAL) {
            return this.fail(node, "only local variables can be changed at compile time");
        }
        LocalVariable* variable = (LocalVariable*)target.symbol();
        if (!this.in_frame || variable.eval_slot == 0 || variable.const_state == 2) {
            return this.fail(node, "variable cannot be assigned at compile time");
        }
        i32 shape = this.shape_of(variable.type);
        if ((shape & ConstEval.NUMERIC) == 0) {
            return this.fail(node, "operand is not a number");
        }
        i32 index = this.base + variable.eval_slot - 1;
        i64 old_int = this.ints[index];
        f64 old_float = this.floats[index];
        mut i64 delta = 1;
        if (node.op_kind() == TokenKind::MINUS_MINUS) {
            delta = 0 - 1;
        }
        if ((shape & ConstEval.FLOAT) != 0) {
            this.floats[index] = old_float + (f64)delta;
        } else {
            this.ints[index] = ConstEval.wrap(old_int + delta, shape);
            this.floats[index] = (f64)this.ints[index];
        }
        if (node.flag()) {
            this.ri = old_int;
            this.rf = old_float;
        } else {
            this.ri = this.ints[index];
            this.rf = this.floats[index];
        }
        return true;
    }

    unsafe bool eval_assign(Node* node) {
        Node* target = node.first();
        NodeKind target_kind = target.kind();
        if (target_kind == NodeKind::FIELD_ACCESS && target.symbol_kind() == SymbolKind.FIELD) {
            return this.eval_field_store(node, target, node.second());
        }
        if (target_kind == NodeKind::INDEX) {
            return this.eval_pointer_store(node, target, node.second());
        }
        if (target_kind == NodeKind::UNARY && target.op_kind() == TokenKind::STAR) {
            return this.eval_pointer_store(node, target, node.second());
        }
        if (target_kind != NodeKind::IDENTIFIER || target.symbol_kind() != SymbolKind.LOCAL) {
            return this.fail(node, "only local variables, fields and pointer targets can be assigned at compile time");
        }
        LocalVariable* variable = (LocalVariable*)target.symbol();
        if (!this.in_frame || variable.eval_slot == 0 || variable.const_state == 2) {
            return this.fail(node, "variable cannot be assigned at compile time");
        }
        Node* value = node.second();
        if (!this.eval(value)) {
            return false;
        }
        i32 shape = this.shape_of(variable.type);
        this.convert(this.shape_of(value.value_type()), shape);
        this.own_value(value, variable.type);
        i32 index = this.base + variable.eval_slot - 1;
        this.ints[index] = this.ri;
        this.floats[index] = this.rf;
        return true;
    }

    unsafe bool prepare(Node* at, FunctionInfo* info) {
        if (info.eval_ready) {
            return true;
        }
        TypeChecker* checker = this.checker;
        if (info.check_state == 0) {
            checker.ensure_checked(info);
        }
        if (info.check_state != 2) {
            return this.fail(at, "function is still being checked");
        }
        Node* declaration = info.node;
        mut i32 shift = 0;
        if (info.is_instance) {
            shift = 1;
            LocalVariable* receiver = info.this_variable;
            receiver.eval_slot = 1;
        }
        for (mut i32 i = 0; i < declaration.count(); i = i + 1) {
            Node* parameter = declaration.child(i);
            LocalVariable* variable = (LocalVariable*)parameter.symbol();
            variable.eval_slot = i + 1 + shift;
        }
        info.eval_slots = declaration.count() + shift;
        this.number_locals(declaration.first(), info);
        info.eval_ready = true;
        return true;
    }

    unsafe void number_locals(Node* node, FunctionInfo* info) {
        NodeKind kind = node.kind();
        if (kind == NodeKind::BLOCK) {
            for (mut i32 i = 0; i < node.count(); i = i + 1) {
                this.number_locals(node.child(i), info);
            }
        } else if (kind == NodeKind::VAR_DECL) {
            LocalVariable* variable = (LocalVariable*)node.symbol();
            if (variable != null) {
                info.eval_slots = info.eval_slots + 1;
                variable.eval_slot = info.eval_slots;
            }
        } else if (kind == NodeKind::IF) {
            this.number_locals(node.second(), info);
            if (node.third() != null) {
                this.number_locals(node.third(), info);
            }
        } else if (kind == NodeKind::WHILE || kind == NodeKind::DO_WHILE) {
            this.number_locals(node.second(), info);
        } else if (kind == NodeKind::FOR) {
            if (node.first() != null) {
                this.number_locals(node.first(), info);
            }
            this.number_locals(node.fourth(), info);
        } else if (kind == NodeKind::SWITCH) {
            for (mut i32 i = 0; i < node.count(); i = i + 1) {
                Node* arm = node.child(i);
                for (mut i32 j = 0; j < arm.count(); j = j + 1) {
                    this.number_locals(arm.child(j), info);
                }
            }
        }
    }

    unsafe bool eval_float_builtin(Node* node, Node* callee) {
        i32 builtin = (i32)(u64)callee.symbol();
        if (builtin == FloatBuiltin.FMA || node.count() != 1) {
            return this.fail(node, "this floating-point operation cannot be evaluated at compile time");
        }
        i32 shape = this.shape_of(node.value_type());
        if (!this.eval(callee.first())) {
            return false;
        }
        this.convert(this.shape_of(callee.first().value_type()), shape);
        f64 first = this.rf;
        if (!this.eval(node.child(0))) {
            return false;
        }
        this.convert(this.shape_of(node.child(0).value_type()), shape);
        FloatSettings* settings = FloatSettings.current();
        this.rf = ConstFloat.pick(builtin, settings.standard, first, this.rf);
        return true;
    }

    unsafe bool eval_libm(Node* node, ptr<i8> name, FunctionInfo* info) {
        i32 arity = node.count();
        if (info.node == null || !Attributes.has(info.node, "Foldable") || arity < 1 || arity > 2) {
            return this.fail(node, "call to a function that is not constexpr or consteval");
        }
        mut f64 first = 0.0;
        mut f64 second = 0.0;
        IdList* param_types = info.param_types;
        for (mut i32 i = 0; i < arity; i = i + 1) {
            Node* argument = node.child(i);
            if (!this.eval(argument)) {
                return false;
            }
            this.convert(this.shape_of(argument.value_type()), this.shape_of(param_types.get(i)));
            if (i == 0) {
                first = this.rf;
            } else {
                second = this.rf;
            }
        }
        mut f64 result = 0.0;
        if (__djinn_host_call_f64(name, arity, first, second, &result) == 0) {
            return this.fail(node, "this [Foldable] function was not found in the host math library");
        }
        this.rf = result;
        return true;
    }

    unsafe bool eval_call(Node* node) {
        Node* callee = node.first();
        i32 symbol_kind = callee.symbol_kind();
        if (symbol_kind == SymbolKind.FLOAT_BUILTIN) {
            return this.eval_float_builtin(node, callee);
        }
        bool constructing = symbol_kind == SymbolKind.CONSTRUCTOR;
        if (!constructing && symbol_kind != SymbolKind.FUNCTION && symbol_kind != SymbolKind.STATIC_METHOD && symbol_kind != SymbolKind.INSTANCE_METHOD) {
            return this.fail(node, "only calls to constexpr functions can be evaluated");
        }
        FunctionInfo* info = (FunctionInfo*)callee.symbol();
        if (constructing && info == null) {
            StructInfo* plain = this.evaluable_struct(node.value_type());
            if (plain == null || node.count() != 0) {
                return this.fail(node, "this struct cannot be constructed at compile time");
            }
            this.ri = (i64)this.new_struct(plain);
            this.rf = 0.0;
            return true;
        }
        if (info != null && info.is_extern) {
            ptr<i8> external = callee.text();
            ConstHeapKind heap = ConstEval.heap_kind(info, external);
            if (heap == ConstHeapKind::ALLOC || heap == ConstHeapKind::REALLOC || heap == ConstHeapKind::FREE) {
                return this.eval_alloc_call(node, heap);
            }
            if (heap == ConstHeapKind::COPY || heap == ConstHeapKind::FILL) {
                return this.eval_memory_call(node, heap == ConstHeapKind::FILL);
            }
            return this.eval_libm(node, external, info);
        }
        if (info == null || info.const_kind == 0) {
            return this.fail(node, "call to a function that is not constexpr or consteval");
        }
        if (this.is_text_hash(node, callee, info)) {
            return this.eval_text_hash(callee.first());
        }
        bool scalar_receiver = info.is_instance && symbol_kind == SymbolKind.INSTANCE_METHOD && (this.shape_of(callee.first().value_type()) & ConstEval.NUMERIC) != 0;
        bool struct_receiver = info.is_instance && symbol_kind == SymbolKind.INSTANCE_METHOD && (this.shape_of(callee.first().value_type()) & ConstEval.STRUCT) != 0;
        bool has_receiver = scalar_receiver || struct_receiver || constructing;
        if ((info.is_instance && !has_receiver) || info.is_async || info.is_extern || info.is_variadic || info.is_template) {
            return this.fail(node, "this function cannot be evaluated at compile time");
        }
        if (!this.prepare(node, info)) {
            return false;
        }
        if (this.depth >= ConstEval.DEPTH_LIMIT) {
            return this.fail(node, "compile-time recursion is too deep");
        }
        Node* declaration = info.node;
        i32 count = declaration.count();
        if (node.count() != count) {
            return this.fail(node, "wrong number of arguments");
        }
        i32 callee_return = this.shape_of(info.return_type);
        if (!Types.is_void(info.return_type) && ((callee_return & ConstEval.SCALAR) == 0 || ConstEval.wide(callee_return))) {
            return this.fail(node, "the return type cannot be evaluated at compile time");
        }
        if (!this.tick(node)) {
            return false;
        }

        i32 frame_base = this.top;
        i32 frame_top = frame_base + info.eval_slots;
        if (frame_top > ConstEval.FRAME_CAPACITY) {
            return this.fail(node, "compile-time stack overflow");
        }
        this.top = frame_top;

        mut i32 shift = 0;
        mut i64 constructed = 0;
        if (constructing) {
            StructInfo* owner = this.evaluable_struct(node.value_type());
            if (owner == null) {
                this.top = frame_base;
                return this.fail(node, "this struct cannot be constructed at compile time");
            }
            constructed = (i64)this.new_struct(owner);
            this.ints[frame_base] = constructed;
            this.floats[frame_base] = 0.0;
            shift = 1;
        } else if (scalar_receiver || struct_receiver) {
            Node* receiver = callee.first();
            if (!this.eval(receiver)) {
                this.top = frame_base;
                return false;
            }
            if (struct_receiver && this.ri == 0) {
                this.top = frame_base;
                return this.fail(receiver, "null pointer dereference");
            }
            this.ints[frame_base] = this.ri;
            this.floats[frame_base] = this.rf;
            shift = 1;
        }
        IdList* param_types = info.param_types;
        for (mut i32 i = 0; i < count; i = i + 1) {
            Node* argument = node.child(i);
            u32 param_type = param_types.get(i + shift);
            i32 param_shape = this.shape_of(param_type);
            if ((param_shape & ConstEval.SCALAR) == 0 || ConstEval.wide(param_shape)) {
                this.top = frame_base;
                return this.fail(argument, "parameter type cannot be evaluated at compile time");
            }
            if (!this.eval(argument)) {
                this.top = frame_base;
                return false;
            }
            this.convert(this.shape_of(argument.value_type()), param_shape);
            this.own_value(argument, param_type);
            this.ints[frame_base + i + shift] = this.ri;
            this.floats[frame_base + i + shift] = this.rf;
        }

        i32 saved_base = this.base;
        bool saved_frame = this.in_frame;
        i32 saved_return = this.return_shape;
        this.base = frame_base;
        this.in_frame = true;
        this.return_shape = callee_return;
        this.depth = this.depth + 1;
        this.trace_names[this.depth] = info.name;
        i32 status = this.exec(declaration.first());
        this.depth = this.depth - 1;
        this.base = saved_base;
        this.in_frame = saved_frame;
        this.return_shape = saved_return;
        this.top = frame_base;

        if (status == EvalStatus.FAILED) {
            return false;
        }
        if (constructing) {
            this.ri = constructed;
            this.rf = 0.0;
            return true;
        }
        if (status != EvalStatus.RETURN && !Types.is_void(info.return_type)) {
            return this.fail(node, "function ended without returning a value");
        }
        return true;
    }

    i32 exec(Node* node) {
        return switch node.kind() {
            BLOCK -> this.exec_block(node),
            EXPR_STMT -> this.exec_expression_statement(node),
            RETURN -> this.exec_return(node),
            VAR_DECL -> this.exec_declaration(node),
            IF -> this.exec_if(node),
            WHILE -> this.exec_loop(node),
            DO_WHILE -> this.exec_loop(node),
            FOR -> this.exec_loop(node),
            BREAK -> EvalStatus.BREAK,
            CONTINUE -> EvalStatus.CONTINUE,
            SWITCH -> this.exec_switch(node),
            _ -> this.exec_unsupported(node)
        };
    }

    unsafe i32 exec_block(Node* node) {
        mut i32 status = EvalStatus.NORMAL;
        mut i32 reached = 0;
        for (mut i32 i = 0; i < node.count() && status == EvalStatus.NORMAL; i = i + 1) {
            status = this.exec(node.child(i));
            reached = i;
            if (status == EvalStatus.NORMAL) {
                reached = i + 1;
            }
        }
        if (status == EvalStatus.FAILED) {
            return status;
        }
        if (!this.dispose_scope(node, reached)) {
            return EvalStatus.FAILED;
        }
        return status;
    }

    i32 exec_expression_statement(Node* node) {
        if (!this.tick(node)) {
            return EvalStatus.FAILED;
        }
        if (this.eval(node.first())) {
            return EvalStatus.NORMAL;
        }
        return EvalStatus.FAILED;
    }

    i32 exec_return(Node* node) {
        if (node.first() != null) {
            Node* value = node.first();
            if (!this.eval(value)) {
                return EvalStatus.FAILED;
            }
            this.convert(this.shape_of(value.value_type()), this.return_shape);
            this.own_value(value, value.value_type());
        }
        return EvalStatus.RETURN;
    }

    i32 exec_unsupported(Node* node) {
        this.fail(node, "statement cannot be evaluated at compile time");
        return EvalStatus.FAILED;
    }

    unsafe i32 exec_declaration(Node* node) {
        LocalVariable* variable = (LocalVariable*)node.symbol();
        if (variable == null || variable.eval_slot == 0) {
            this.fail(node, "variable cannot be evaluated at compile time");
            return EvalStatus.FAILED;
        }
        if (variable.const_state == 2) {
            return EvalStatus.NORMAL;
        }
        i32 shape = this.shape_of(variable.type);
        if ((shape & ConstEval.SCALAR) == 0 || ConstEval.wide(shape)) {
            this.fail(node, "variable type cannot be evaluated at compile time");
            return EvalStatus.FAILED;
        }
        i32 index = this.base + variable.eval_slot - 1;
        Node* initial = node.first();
        if (initial == null) {
            this.ints[index] = 0;
            this.floats[index] = 0.0;
            StructInfo* fresh = this.evaluable_struct(variable.type);
            if (fresh != null && !Types.is_pointer(variable.type)) {
                this.ints[index] = (i64)this.new_struct(fresh);
            }
            return EvalStatus.NORMAL;
        }
        if (!this.eval(initial)) {
            return EvalStatus.FAILED;
        }
        this.convert(this.shape_of(initial.value_type()), shape);
        this.own_value(initial, variable.type);
        this.ints[index] = this.ri;
        this.floats[index] = this.rf;
        return EvalStatus.NORMAL;
    }

    i32 exec_if(Node* node) {
        i32 mode = node.op();
        if (mode == 2) {
            return this.exec(node.second());
        }
        if (mode == 3) {
            if (node.third() != null) {
                return this.exec(node.third());
            }
            return EvalStatus.NORMAL;
        }
        if (!this.tick(node)) {
            return EvalStatus.FAILED;
        }
        if (!this.eval_condition(node.first())) {
            return EvalStatus.FAILED;
        }
        if (this.ri != 0) {
            return this.exec(node.second());
        }
        if (node.third() != null) {
            return this.exec(node.third());
        }
        return EvalStatus.NORMAL;
    }

    unsafe i32 exec_loop(Node* node) {
        NodeKind kind = node.kind();
        mut Node* condition = node.first();
        mut Node* body = node.second();
        mut Node* step = (Node*)0;
        if (kind == NodeKind::FOR) {
            if (node.first() != null) {
                i32 started = this.exec(node.first());
                if (started != EvalStatus.NORMAL) {
                    return started;
                }
            }
            condition = node.second();
            step = node.third();
            body = node.fourth();
        }

        mut bool first_pass = kind == NodeKind::DO_WHILE;
        while (true) {
            if (!this.tick(node)) {
                return EvalStatus.FAILED;
            }
            if (!first_pass && condition != null) {
                if (!this.eval_condition(condition)) {
                    return EvalStatus.FAILED;
                }
                if (this.ri == 0) {
                    return EvalStatus.NORMAL;
                }
            }
            first_pass = false;
            i32 status = this.exec(body);
            if (status == EvalStatus.BREAK) {
                return EvalStatus.NORMAL;
            }
            if (status == EvalStatus.RETURN || status == EvalStatus.FAILED) {
                return status;
            }
            if (step != null) {
                if (!this.eval(step)) {
                    return EvalStatus.FAILED;
                }
            }
        }
        return EvalStatus.NORMAL;
    }

    i32 exec_switch(Node* node) {
        if (!this.tick(node)) {
            return EvalStatus.FAILED;
        }
        if (!this.eval(node.first())) {
            return EvalStatus.FAILED;
        }
        i64 subject = this.ri;
        bool over_text = (this.shape_of(node.first().value_type()) & ConstEval.STRING) != 0;
        mut i32 selected = 0 - 1;
        mut i32 fallback = 0 - 1;
        for (mut i32 i = 0; i < node.count() && selected < 0; i = i + 1) {
            Node* arm = node.child(i);
            if (arm.first() == null) {
                fallback = i;
            } else {
                if (!this.eval(arm.first())) {
                    return EvalStatus.FAILED;
                }
                mut bool same = this.ri == subject;
                if (over_text) {
                    unsafe {
                        same = strcmp((ptr<i8>)subject, (ptr<i8>)this.ri) == 0;
                    }
                }
                if (same) {
                    selected = i;
                }
            }
        }
        if (selected < 0) {
            selected = fallback;
        }
        if (selected < 0) {
            return EvalStatus.NORMAL;
        }
        // A label with no statements shares the body of the arm after it ('case A: case B: body').
        while (node.child(selected).count() == 0 && selected + 1 < node.count()) {
            selected = selected + 1;
        }
        Node* chosen = node.child(selected);
        for (mut i32 j = 0; j < chosen.count(); j = j + 1) {
            i32 status = this.exec(chosen.child(j));
            if (status == EvalStatus.BREAK) {
                return EvalStatus.NORMAL;
            }
            if (status != EvalStatus.NORMAL) {
                return status;
            }
        }
        return EvalStatus.NORMAL;
    }
}
