namespace djinnc;

struct ConstBits {
    public static i64 of_float(f64 value) {
        mut f64 source = value;
        mut i64 bits = 0;
        memcpy((ptr)&bits, (ptr)&source, 8);
        return bits;
    }

    public static i64 of_float32(f64 value) {
        mut f32 source = (f32)value;
        mut i64 bits = 0;
        memcpy((ptr)&bits, (ptr)&source, 4);
        return bits;
    }

    public static f64 to_float(i64 bits) {
        mut i64 source = bits;
        mut f64 value = 0.0;
        memcpy((ptr)&value, (ptr)&source, 8);
        return value;
    }
}
