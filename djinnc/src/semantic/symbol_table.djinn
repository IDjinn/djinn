namespace djinnc;

struct LocalVariable {
    i8* name;
    u32 name_atom;
    u32 namespace_id;
    void* slot;
    u32 type;
    bool is_mutable;
    Node* node;
}

struct InterfaceInfo {
    i8* name;
    u32 name_atom;
    u32 namespace_id;
    Node* node;
}

struct FieldInfo {
    i8* name;
    u32 name_atom;
    u32 type;
    i32 index;
}

struct StructInfo {
    i8* name;
    u32 name_atom;
    u32 namespace_id;
    u32 index;
    u32 type_id;
    bool is_enum;
    bool is_primitive;
    bool has_payload;
    i32 slot_count;
    i32 layout_state;
    void* llvm;
    PointerList* fields;
    PointerList* constants;
    U32Map* field_map;
    U32Map* constant_map;
    U32Map* method_map;
    Node* node;
    GenericParams* generics;
    bool is_template;
    StructInfo* origin;
    U32Map* bindings;
    IdList* type_args;
    PointerList* impls;
}

struct IsPattern {
    Node* variant;
    PointerList* bindings;
}

struct FunctionInfo {
    i8* name;
    u32 name_atom;
    u32 namespace_id;
    void* function;
    void* function_type;
    u32 return_type;
    IdList* param_types;
    LocalVariable* this_variable;
    bool is_variadic;
    bool is_extern;
    bool is_instance;
    bool is_async;
    Node* node;
    StructInfo* owner;
    GenericParams* generics;
    bool is_template;
    U32Map* bindings;
    FunctionInfo* overload;
    i32 overload_index;
}

struct NamespaceInfo {
    u32 id;
    u32 parent;
    u32 qualified_atom;
}

struct SymbolTable {
    Arena* arena;
    PointerList* structs;
    PointerList* interfaces;
    PointerList* functions;
    PointerList* globals;
    PointerList* namespaces;
    U32Map* struct_map;
    U32Map* interface_map;
    U32Map* function_map;
    U32Map* global_map;
    U32Map* namespace_map;
    U32Map* instance_map;
    U32Map* primitive_map;
    PointerList* primitives;
    U32Map* bindings;
    SemanticAnalyzer* analyzer;
    Node* blame;

    public static SymbolTable* create(Arena* arena) {
        SymbolTable* table = (SymbolTable*)arena.zalloc(sizeof(SymbolTable), 8);
        table.arena = arena;
        table.structs = PointerList.create();
        table.interfaces = PointerList.create();
        table.functions = PointerList.create();
        table.globals = PointerList.create();
        table.namespaces = PointerList.create();
        table.struct_map = U32Map.create(arena, 64);
        table.interface_map = U32Map.create(arena, 16);
        table.function_map = U32Map.create(arena, 256);
        table.global_map = U32Map.create(arena, 16);
        table.namespace_map = U32Map.create(arena, 16);
        table.instance_map = U32Map.create(arena, 16);
        table.primitive_map = U32Map.create(arena, 16);
        table.primitives = PointerList.create();
        NamespaceInfo* root = (NamespaceInfo*)arena.zalloc(sizeof(NamespaceInfo), 8);
        PointerList* namespaces = table.namespaces;
        namespaces.push((void*)root);
        return table;
    }

    static u32 key(u32 namespace_id, u32 atom) {
        if (atom >= 1048576 || namespace_id >= 4096) {
            logger_error(Log.get(), "djinnc: symbol table key space exhausted");
            exit(1);
        }
        return (namespace_id << 20) | atom;
    }

    NamespaceInfo* namespace_at(u32 id) {
        PointerList* namespaces = this.namespaces;
        return (NamespaceInfo*)namespaces.get((i32)id);
    }

    u32 join_atom(u32 parent, u32 name_atom) {
        if (parent == 0) {
            return name_atom;
        }
        AtomTable* atoms = Atoms.get();
        NamespaceInfo* owner = this.namespace_at(parent);
        ByteBuffer* joined = ByteBuffer.create();
        joined.append_slice(atoms.text(owner.qualified_atom), (i32)atoms.length(owner.qualified_atom));
        joined.append("::");
        joined.append_slice(atoms.text(name_atom), (i32)atoms.length(name_atom));
        return atoms.intern_copy(joined.data, (u32)joined.length);
    }

    public u32 enter_namespace(u32 parent, u32 name_atom) {
        u32 qualified = this.join_atom(parent, name_atom);
        U32Map* map = this.namespace_map;
        i64 found = map.find(qualified);
        if (found >= 0) {
            return (u32)found;
        }
        PointerList* namespaces = this.namespaces;
        Arena* arena = this.arena;
        NamespaceInfo* info = (NamespaceInfo*)arena.zalloc(sizeof(NamespaceInfo), 8);
        info.id = (u32)namespaces.length;
        info.parent = parent;
        info.qualified_atom = qualified;
        namespaces.push((void*)info);
        map.put(qualified, info.id);
        return info.id;
    }

    public i8* namespace_prefix(u32 namespace_id) {
        if (namespace_id == 0) {
            return null;
        }
        NamespaceInfo* info = this.namespace_at(namespace_id);
        AtomTable* atoms = Atoms.get();
        return atoms.text(info.qualified_atom);
    }

    i64 find_child_namespace(u32 scope, u32 prefix_atom) {
        U32Map* map = this.namespace_map;
        return map.find(this.join_atom(scope, prefix_atom));
    }

    i64 lookup(U32Map* map, u32 full, u32 base, u32 scope) {
        if (full == base) {
            mut u32 namespace_id = scope;
            while (true) {
                i64 index = map.find(SymbolTable.key(namespace_id, base));
                if (index >= 0) {
                    return index;
                }
                if (namespace_id == 0) {
                    return 0 - 1;
                }
                NamespaceInfo* info = this.namespace_at(namespace_id);
                namespace_id = info.parent;
            }
        }

        AtomTable* atoms = Atoms.get();
        i32 length = (i32)atoms.length(full);
        i8* text = atoms.text(full);
        mut i32 last = 0;
        for (mut i32 i = 0; i + 1 < length; i = i + 1) {
            if (text[i] == 58 && text[i + 1] == 58) {
                last = i + 2;
            }
        }
        u32 prefix = atoms.intern_copy(text, (u32)(last - 2));
        mut u32 namespace_id = scope;
        while (true) {
            i64 target = this.find_child_namespace(namespace_id, prefix);
            if (target >= 0) {
                return map.find(SymbolTable.key((u32)target, base));
            }
            if (namespace_id == 0) {
                return 0 - 1;
            }
            NamespaceInfo* info = this.namespace_at(namespace_id);
            namespace_id = info.parent;
        }
        return 0 - 1;
    }

    public u32 resolve_type(TypeRef* ref, u32 scope) {
        i32 kind = ref.kind;
        if (kind == TypeKind.VOID) {
            return Types.void_type();
        }
        if (kind == TypeKind.AUTO) {
            return Types.auto_type();
        }
        if (kind == TypeKind.INTEGER) {
            return Types.integer((u32)ref.bits, ref.is_signed);
        }
        if (kind == TypeKind.FLOAT) {
            return Types.floating((u32)ref.bits);
        }
        if (kind == TypeKind.POINTER) {
            u32 element = this.resolve_type(ref.element, scope);
            if (element == 0) {
                return 0;
            }
            return Types.pointer_to(element);
        }
        if (ref.args == null && this.bindings != null && ref.full_atom == ref.name_atom) {
            U32Map* active = this.bindings;
            i64 bound = active.find(ref.name_atom);
            if (bound >= 0) {
                return (u32)bound;
            }
        }
        StructInfo* info = this.find_struct(ref.full_atom, ref.name_atom, scope);
        if (info == null) {
            return 0;
        }
        if (info.is_template) {
            if (ref.args == null) {
                return 0;
            }
            PointerList* given = ref.args;
            IdList* resolved = IdList.create();
            for (mut i32 i = 0; i < given.length; i = i + 1) {
                u32 argument = this.resolve_type((TypeRef*)given.get(i), scope);
                if (argument == 0) {
                    return 0;
                }
                resolved.push(argument);
            }
            SemanticAnalyzer* generator = this.analyzer;
            return generator.instantiate(info, resolved);
        }
        if (ref.args != null) {
            return 0;
        }
        return info.type_id;
    }

    public void describe_type(u32 id, ByteBuffer* out) {
        if (Types.is_pointer(id)) {
            this.describe_type(Types.element(id), out);
            out.append_char(42);
            return;
        }
        StructInfo* named = this.enum_of_type(id);
        if (named != null) {
            out.append(named.name);
            return;
        }
        if (Types.is_struct(id)) {
            StructInfo* info = this.struct_at(Types.struct_index(id));
            out.append(info.name);
            return;
        }
        Types.describe(id, out);
    }

    public void add_function_instance(FunctionInfo* info) {
        PointerList* list = this.functions;
        list.push((void*)info);
    }

    public void add_instance(StructInfo* info) {
        PointerList* list = this.structs;
        list.push((void*)info);
    }

    public StructInfo* enum_of_type(u32 type) {
        if (Types.is_struct(type)) {
            StructInfo* info = this.struct_at(Types.struct_index(type));
            if (info.is_enum) {
                return info;
            }
            return null;
        }
        i64 index = Types.enum_index(type);
        if (index < 0) {
            return null;
        }
        return this.struct_at((u32)index);
    }

    public StructInfo* primitive_owner(u32 type) {
        U32Map* map = this.primitive_map;
        PointerList* list = this.primitives;
        i64 found = map.find(type);
        if (found >= 0) {
            return (StructInfo*)list.get((i32)found);
        }
        Arena* arena = this.arena;
        StructInfo* info = (StructInfo*)arena.zalloc(sizeof(StructInfo), 8);
        ByteBuffer* name = ByteBuffer.create();
        this.describe_type(type, name);
        info.name = name.cstr();
        info.type_id = type;
        info.is_primitive = true;
        info.fields = PointerList.create();
        info.constants = PointerList.create();
        info.field_map = U32Map.create(arena, 8);
        info.constant_map = U32Map.create(arena, 8);
        info.method_map = U32Map.create(arena, 8);
        map.put(type, (u32)list.length);
        list.push((void*)info);
        return info;
    }

    public StructInfo* struct_at(u32 index) {
        PointerList* list = this.structs;
        return (StructInfo*)list.get((i32)index);
    }

    public bool add_struct(StructInfo* info) {
        U32Map* map = this.struct_map;
        u32 key = SymbolTable.key(info.namespace_id, info.name_atom);
        if (map.contains(key)) {
            return false;
        }
        PointerList* list = this.structs;
        map.put(key, (u32)list.length);
        list.push((void*)info);
        return true;
    }

    public bool add_interface(InterfaceInfo* info) {
        U32Map* map = this.interface_map;
        u32 key = SymbolTable.key(info.namespace_id, info.name_atom);
        if (map.contains(key)) {
            return false;
        }
        PointerList* list = this.interfaces;
        map.put(key, (u32)list.length);
        list.push((void*)info);
        return true;
    }

    public InterfaceInfo* find_interface(u32 full, u32 base, u32 scope) {
        i64 index = this.lookup(this.interface_map, full, base, scope);
        if (index < 0) {
            return null;
        }
        PointerList* list = this.interfaces;
        return (InterfaceInfo*)list.get((i32)index);
    }

    public StructInfo* find_struct(u32 full, u32 base, u32 scope) {
        i64 index = this.lookup(this.struct_map, full, base, scope);
        if (index < 0) {
            return null;
        }
        PointerList* list = this.structs;
        return (StructInfo*)list.get((i32)index);
    }

    static bool same_signature(FunctionInfo* left, FunctionInfo* right) {
        if (left.is_template || right.is_template) {
            return left.is_template && right.is_template;
        }
        IdList* a = left.param_types;
        IdList* b = right.param_types;
        if (a.length != b.length) {
            return false;
        }
        for (mut i32 i = 0; i < a.length; i = i + 1) {
            if (a.get(i) != b.get(i)) {
                return false;
            }
        }
        return true;
    }

    public bool add_function(FunctionInfo* info) {
        mut U32Map* map = this.function_map;
        mut u32 key = SymbolTable.key(info.namespace_id, info.name_atom);
        if (info.owner != null) {
            StructInfo* owner = info.owner;
            map = owner.method_map;
            key = info.name_atom;
        }
        PointerList* list = this.functions;
        i64 found = map.find(key);
        if (found < 0) {
            map.put(key, (u32)list.length);
            list.push((void*)info);
            return true;
        }
        mut FunctionInfo* tail = (FunctionInfo*)list.get((i32)found);
        mut i32 ordinal = 1;
        while (true) {
            if (SymbolTable.same_signature(tail, info)) {
                return false;
            }
            if (tail.overload == null) {
                break;
            }
            tail = tail.overload;
            ordinal = ordinal + 1;
        }
        tail.overload = info;
        info.overload_index = ordinal;
        if (!info.is_extern) {
            ByteBuffer* mangled = ByteBuffer.create();
            mangled.append(info.name);
            mangled.append_char(36);
            mangled.append_int((i64)ordinal);
            info.name = mangled.cstr();
        }
        list.push((void*)info);
        return true;
    }

    public FunctionInfo* find_function(u32 full, u32 base, u32 scope) {
        i64 index = this.lookup(this.function_map, full, base, scope);
        if (index < 0) {
            return null;
        }
        PointerList* list = this.functions;
        return (FunctionInfo*)list.get((i32)index);
    }

    public FunctionInfo* find_method(StructInfo* owner, u32 name) {
        U32Map* map = owner.method_map;
        i64 index = map.find(name);
        if (index < 0) {
            return null;
        }
        PointerList* list = this.functions;
        return (FunctionInfo*)list.get((i32)index);
    }

    public bool add_global(LocalVariable* variable) {
        U32Map* map = this.global_map;
        u32 key = SymbolTable.key(variable.namespace_id, variable.name_atom);
        if (map.contains(key)) {
            return false;
        }
        PointerList* list = this.globals;
        map.put(key, (u32)list.length);
        list.push((void*)variable);
        return true;
    }

    public LocalVariable* find_global(u32 full, u32 base, u32 scope) {
        i64 index = this.lookup(this.global_map, full, base, scope);
        if (index < 0) {
            return null;
        }
        PointerList* list = this.globals;
        return (LocalVariable*)list.get((i32)index);
    }

    public FieldInfo* find_field(StructInfo* info, u32 name) {
        U32Map* map = info.field_map;
        i64 index = map.find(name);
        if (index < 0) {
            return null;
        }
        PointerList* list = info.fields;
        return (FieldInfo*)list.get((i32)index);
    }

    public Node* find_constant(StructInfo* info, u32 name) {
        U32Map* map = info.constant_map;
        i64 index = map.find(name);
        if (index < 0) {
            return null;
        }
        PointerList* list = info.constants;
        return (Node*)list.get((i32)index);
    }
}
