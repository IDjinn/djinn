namespace djinnc;

struct RangeProof {
    const u32 OVERFLOW_FREE = 1;
    const u32 DIVISOR_NONZERO = 2;
    const u32 NOT_MINIMUM_DIVIDED = 4;
    const u32 SHIFT_IN_RANGE = 8;
}

struct RangeMath {
    public static bool tracks(u32 type) {
        if (!Types.is_integer(type)) {
            return false;
        }
        u32 bits = Types.bits(type);
        return bits > 1 && bits <= 64;
    }

    // u64 values above i64 max have no i64 bound, so the full range of a 64-bit unsigned type is never materialized.
    public static bool wide_unsigned(u32 type) {
        return Types.bits(type) >= 64 && !Types.is_signed(type);
    }

    public static i64 type_min(u32 type) {
        i32 bits = (i32)Types.bits(type);
        if (!Types.is_signed(type)) {
            return 0;
        }
        if (bits >= 64) {
            return i64.MIN_VALUE;
        }
        return 0 - ((i64)1 << (bits - 1));
    }

    public static i64 type_max(u32 type) {
        i32 bits = (i32)Types.bits(type);
        if (bits >= 64) {
            return i64.MAX_VALUE;
        }
        if (Types.is_signed(type)) {
            return ((i64)1 << (bits - 1)) - 1;
        }
        return ((i64)1 << bits) - 1;
    }

    public static bool fits(u32 type, i64 low, i64 high) {
        return low <= high && low >= RangeMath.type_min(type) && high <= RangeMath.type_max(type);
    }

    public static bool add_overflows(i64 a, i64 b) {
        if (b > 0) {
            return a > i64.MAX_VALUE - b;
        }
        return a < i64.MIN_VALUE - b;
    }

    public static bool sub_overflows(i64 a, i64 b) {
        if (b < 0) {
            return a > i64.MAX_VALUE + b;
        }
        return a < i64.MIN_VALUE + b;
    }

    public static bool mul_overflows(i64 a, i64 b) {
        if (a == 0 || b == 0) {
            return false;
        }
        if (a == 0 - 1) {
            return b == i64.MIN_VALUE;
        }
        if (b == 0 - 1) {
            return a == i64.MIN_VALUE;
        }
        if (a > 0 && b > 0) {
            return a > i64.MAX_VALUE / b;
        }
        if (a < 0 && b < 0) {
            return a < i64.MAX_VALUE / b;
        }
        if (a > 0) {
            return b < i64.MIN_VALUE / a;
        }
        return a < i64.MIN_VALUE / b;
    }

    public static i64 lesser(i64 a, i64 b) {
        if (a < b) {
            return a;
        }
        return b;
    }

    public static i64 greater(i64 a, i64 b) {
        if (a > b) {
            return a;
        }
        return b;
    }
}
