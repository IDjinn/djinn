namespace djinnc;

// '(Name)x' answers with a 'result<Name, ContractViolation>'. Where 'result' is not visible that construction is not
// declared, so a file that only uses '(Name!)x' and constants needs no import.
impl SemanticAnalyzer {
    unsafe void drop_unavailable_constructions(Node* container) {
        for (mut i32 i = 0; i < container.count(); i = i + 1) {
            Node* declaration = container.child(i);
            if (declaration.kind() == NodeKind::NAMESPACE_DECL) {
                u32 saved = this.enter(declaration);
                this.drop_unavailable_constructions(declaration);
                this.scope = saved;
                continue;
            }
            if (declaration.kind() != NodeKind::STRUCT_DECL || declaration.first() == null) {
                continue;
            }
            u32 result_atom = Ast.intern_base_name("result", 6);
            SymbolTable* symbols = this.symbols;
            if (symbols.find_struct(result_atom, result_atom, this.scope) != null) {
                continue;
            }
            ptr<i8> unavailable = Refinements.try_name(declaration.text());
            for (mut i32 k = i + 1; k < container.count(); k = k + 1) {
                Node* function = container.child(k);
                if (function.kind() == NodeKind::FUNCTION && Strings.same(function.text(), unavailable)) {
                    function.set_kind(NodeKind::EMPTY);
                    break;
                }
            }
        }
    }
}
