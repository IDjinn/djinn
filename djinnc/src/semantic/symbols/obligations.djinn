namespace djinnc;

unsafe static mut ptr obligation_list = null;

struct Obligation {
    ptr<i8> kind;
    ptr<i8> status;
    Node* at;
    Node* function;
}

struct Obligations {
    public static unsafe PointerList* all() {
        if (obligation_list == null) {
            obligation_list = (ptr)PointerList.create();
        }
        return (PointerList*)obligation_list;
    }

    public static unsafe void record(ptr<i8> kind, ptr<i8> status, Node* at, Node* function) {
        Obligation* entry = (Obligation*)Memory.zalloc(sizeof(Obligation));
        entry.kind = kind;
        entry.status = status;
        entry.at = at;
        entry.function = function;
        PointerList* entries = Obligations.all();
        entries.push((ptr)entry);
    }

    public static unsafe void print() {
        PointerList* entries = Obligations.all();
        mut i32 proved = 0;
        mut i32 enforced = 0;
        mut i32 checked = 0;
        mut i32 best_effort = 0;
        printf("obligations:\n");
        for (mut i32 i = 0; i < entries.length; i = i + 1) {
            Obligation* entry = (Obligation*)entries.get(i);
            mut ptr<i8> name = "<unknown>";
            if (entry.function != null && entry.function.text() != null) {
                name = entry.function.text();
            }
            printf("  %s:%d:%d  %-18s %-12s %s\n", entry.at.file_name(), entry.at.line(), entry.at.column(), entry.kind, entry.status, name);
            if (Strings.same(entry.status, "proved")) {
                proved = proved + 1;
            } else if (Strings.same(entry.status, "enforced")) {
                enforced = enforced + 1;
            } else if (Strings.same(entry.status, "checked")) {
                checked = checked + 1;
            } else {
                best_effort = best_effort + 1;
            }
        }
        printf("summary: %d proved, %d enforced, %d checked, %d best_effort\n", proved, enforced, checked, best_effort);
    }
}
