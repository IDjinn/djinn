namespace djinnc;

struct MemberKinds {
    const i32 ANY = 0 - 1;
    const i32 METHOD = 0;
    const i32 CONSTRUCTOR = 1;
    const i32 GETTER = 2;
    const i32 SETTER = 3;
    const i32 ACCESSOR_PREFIX_LENGTH = 4;

    public static unsafe i32 classify(ptr<i8> declared_name) {
        i32 length = strlen(declared_name);
        if (Strings.same(declared_name, ".ctor")) {
            return MemberKinds.CONSTRUCTOR;
        }
        if (Strings.starts_with(declared_name, 0, length, "get:")) {
            return MemberKinds.GETTER;
        }
        if (Strings.starts_with(declared_name, 0, length, "set:")) {
            return MemberKinds.SETTER;
        }
        return MemberKinds.METHOD;
    }

    public static unsafe ptr<i8> property_name(ptr<i8> accessor_name) {
        return accessor_name + MemberKinds.ACCESSOR_PREFIX_LENGTH;
    }
}
