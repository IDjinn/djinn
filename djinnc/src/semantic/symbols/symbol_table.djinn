namespace djinnc;

struct SymbolTable {
    Arena* arena;
    PointerList* structs;
    PointerList* interfaces;
    PointerList* functions;
    PointerList* globals;
    PointerList* namespaces;
    U32Map* struct_map;
    U32Map* interface_map;
    U32Map* function_map;
    U32Map* global_map;
    U32Map* namespace_map;
    U32Map* instance_map;
    U32Map* primitive_map;
    U32Map* alias_map;
    PointerList* aliases;
    U32Map* ambiguity_sites;
    PointerList* primitives;
    U32Map* bindings;
    SemanticAnalyzer* analyzer;
    // The checker that folds constant template arguments ('(N * 2)', 'LANES'); the real one once checking starts.
    TypeChecker* checker;
    // Set when a template argument was already reported, so the caller adds no 'unknown type' on top.
    bool template_failed;
    Node* blame;
    bool generate_disabled;
    bool strict_externs;
    i32 error_count;

    public static unsafe SymbolTable* create(Arena* arena) {
        SymbolTable* table = (SymbolTable*)arena.zalloc(sizeof(SymbolTable), 8);
        table.arena = arena;
        table.structs = PointerList.create();
        table.interfaces = PointerList.create();
        table.functions = PointerList.create();
        table.globals = PointerList.create();
        table.namespaces = PointerList.create();
        table.struct_map = U32Map.create(arena, 64);
        table.interface_map = U32Map.create(arena, 16);
        table.function_map = U32Map.create(arena, 256);
        table.global_map = U32Map.create(arena, 16);
        table.namespace_map = U32Map.create(arena, 16);
        table.instance_map = U32Map.create(arena, 16);
        table.primitive_map = U32Map.create(arena, 16);
        table.alias_map = U32Map.create(arena, 16);
        table.aliases = PointerList.create();
        table.ambiguity_sites = U32Map.create(arena, 8);
        table.primitives = PointerList.create();
        NamespaceInfo* root = (NamespaceInfo*)arena.zalloc(sizeof(NamespaceInfo), 8);
        PointerList* namespaces = table.namespaces;
        namespaces.push((ptr)root);
        return table;
    }

    public void register_error(StructInfo* info) {
        if (info.error_code == 0) {
            this.error_count = this.error_count + 1;
            info.error_code = this.error_count;
        }
    }

    static u32 key(u32 namespace_id, u32 atom) {
        if (atom >= 1048576 || namespace_id >= 4096) {
            logger_error(Log.get(), "djinnc: symbol table key space exhausted");
            exit(1);
        }
        return (namespace_id << 20) | atom;
    }

    unsafe NamespaceInfo* namespace_at(u32 id) {
        PointerList* namespaces = this.namespaces;
        return (NamespaceInfo*)namespaces.get((i32)id);
    }

    u32 join_atom(u32 parent, u32 name_atom) {
        if (parent == 0) {
            return name_atom;
        }
        AtomTable* atoms = Atoms.get();
        NamespaceInfo* owner = this.namespace_at(parent);
        ByteBuffer* joined = ByteBuffer.create();
        joined.append_slice(atoms.text(owner.qualified_atom), (i32)atoms.length(owner.qualified_atom));
        joined.append("::");
        joined.append_slice(atoms.text(name_atom), (i32)atoms.length(name_atom));
        return atoms.intern_copy(joined.data, (u32)joined.length);
    }

    public unsafe u32 enter_namespace(u32 parent, u32 name_atom) {
        u32 qualified = this.join_atom(parent, name_atom);
        U32Map* map = this.namespace_map;
        i64 found = map.find(qualified);
        if (found >= 0) {
            return (u32)found;
        }
        PointerList* namespaces = this.namespaces;
        Arena* arena = this.arena;
        NamespaceInfo* info = (NamespaceInfo*)arena.zalloc(sizeof(NamespaceInfo), 8);
        info.id = (u32)namespaces.length;
        info.parent = parent;
        info.qualified_atom = qualified;
        namespaces.push((ptr)info);
        map.put(qualified, info.id);
        return info.id;
    }

    public ptr<i8> namespace_prefix(u32 namespace_id) {
        if (namespace_id == 0) {
            return null;
        }
        NamespaceInfo* info = this.namespace_at(namespace_id);
        AtomTable* atoms = Atoms.get();
        return atoms.text(info.qualified_atom);
    }

    i64 find_child_namespace(u32 scope, u32 prefix_atom) {
        U32Map* map = this.namespace_map;
        return map.find(this.join_atom(scope, prefix_atom));
    }

    unsafe i64 lookup(U32Map* map, u32 full, u32 base, u32 scope) {
        if (full == base) {
            i64 declaring = this.declaring_namespace(map, (U32Map*)0, base, scope, (IdList*)0);
            if (declaring < 0) {
                return 0 - 1;
            }
            return map.find(SymbolTable.key((u32)declaring, base));
        }

        AtomTable* atoms = Atoms.get();
        i32 length = (i32)atoms.length(full);
        ptr<i8> text = atoms.text(full);
        mut i32 last = 0;
        for (mut i32 i = 0; i + 1 < length; i = i + 1) {
            if (text[i] == 58 && text[i + 1] == 58) {
                last = i + 2;
            }
        }
        u32 prefix = atoms.intern_copy(text, (u32)(last - 2));
        mut u32 namespace_id = scope;
        while (true) {
            i64 target = this.find_child_namespace(namespace_id, prefix);
            if (target >= 0) {
                return map.find(SymbolTable.key((u32)target, base));
            }
            if (namespace_id == 0) {
                return 0 - 1;
            }
            NamespaceInfo* info = this.namespace_at(namespace_id);
            namespace_id = info.parent;
        }
        return 0 - 1;
    }

    unsafe i64 declaring_namespace(U32Map* map, U32Map* other, u32 base, u32 scope, IdList* rivals) {
        mut u32 namespace_id = scope;
        while (true) {
            u32 own = SymbolTable.key(namespace_id, base);
            if (map.find(own) >= 0 || (other != null && other.find(own) >= 0)) {
                return (i64)namespace_id;
            }
            NamespaceInfo* info = this.namespace_at(namespace_id);
            if (info.imports != null) {
                IdList* imports = info.imports;
                mut i64 chosen = 0 - 1;
                mut bool chosen_primary = false;
                for (mut i32 i = 0; i < imports.length; i = i + 1) {
                    bool written = i < info.explicit_imports;
                    if (!written && chosen >= 0) {
                        break;
                    }
                    u32 imported = imports.get(i);
                    u32 candidate = SymbolTable.key(imported, base);
                    bool primary = map.find(candidate) >= 0;
                    if (!primary && (other == null || other.find(candidate) < 0)) {
                        continue;
                    }
                    if (written && rivals != null) {
                        rivals.push(imported);
                    }
                    if (chosen < 0 || (primary && !chosen_primary)) {
                        chosen = (i64)imported;
                        chosen_primary = primary;
                    }
                }
                if (chosen >= 0) {
                    return chosen;
                }
            }
            if (namespace_id == 0) {
                return 0 - 1;
            }
            namespace_id = info.parent;
        }
        return 0 - 1;
    }

    public unsafe bool ambiguous_type(u32 full, u32 base, u32 scope, Node* at) {
        if (full != base) {
            return false;
        }
        if (this.bindings != null) {
            U32Map* active = this.bindings;
            if (active.find(base) >= 0) {
                return false;
            }
        }
        IdList* rivals = IdList.create();
        this.declaring_namespace(this.struct_map, this.alias_map, base, scope, rivals);
        return this.report_ambiguity(rivals, base, at);
    }

    public unsafe bool ambiguous_interface(u32 full, u32 base, u32 scope, Node* at) {
        if (full != base) {
            return false;
        }
        IdList* rivals = IdList.create();
        this.declaring_namespace(this.interface_map, (U32Map*)0, base, scope, rivals);
        return this.report_ambiguity(rivals, base, at);
    }

    unsafe bool report_ambiguity(IdList* rivals, u32 base, Node* at) {
        if (rivals.length < 2 || at == null) {
            return false;
        }
        AtomTable* atoms = Atoms.get();
        ptr<i8> name = atoms.text(base);
        ByteBuffer* site = ByteBuffer.create();
        site.append(at.file_name());
        site.append_char(':');
        site.append_int((i64)at.line());
        site.append_char(':');
        site.append_int((i64)at.column());
        site.append_char(':');
        site.append(name);
        u32 reported = atoms.intern_copy(site.data, (u32)site.length);
        U32Map* sites = this.ambiguity_sites;
        if (sites.contains(reported)) {
            return true;
        }
        sites.put(reported, 0);
        PointerList* candidates = PointerList.create();
        for (mut i32 i = 0; i < rivals.length; i = i + 1) {
            ByteBuffer* candidate = ByteBuffer.create();
            candidate.append(this.namespace_prefix(rivals.get(i)));
            candidate.append("::");
            candidate.append(name);
            candidates.push((ptr)candidate.cstr());
        }
        candidates.sort_strings();
        ByteBuffer* message = ByteBuffer.create();
        message.append("'");
        message.append(name);
        message.append("' is ambiguous between ");
        for (mut i32 i = 0; i < candidates.length; i = i + 1) {
            if (i > 0) {
                if (i + 1 == candidates.length) {
                    message.append(" and ");
                } else {
                    message.append(", ");
                }
            }
            message.append("'");
            message.append((ptr<i8>)candidates.get(i));
            message.append("'");
        }
        message.append(": qualify it with its namespace");
        Diagnostics.add_argument(name);
        for (mut i32 i = 0; i < candidates.length; i = i + 1) {
            Diagnostics.add_argument((ptr<i8>)candidates.get(i));
        }
        SemanticAnalyzer* analyzer = this.analyzer;
        Diagnostics* diagnostics = analyzer.diagnostics;
        diagnostics.error_span(DiagnosticErrors.AMBIGUOUS_TYPE, at.file_name(), at.line(), at.column(), at.length(), message.cstr());
        return true;
    }

    unsafe i64 lookup_type(U32Map* map, u32 full, u32 base, u32 scope) {
        if (full != base) {
            return this.lookup(map, full, base, scope);
        }
        i64 declaring = this.declaring_namespace(this.struct_map, this.alias_map, base, scope, (IdList*)0);
        if (declaring < 0) {
            return 0 - 1;
        }
        return map.find(SymbolTable.key((u32)declaring, base));
    }

    public unsafe bool add_alias(u32 namespace_id, u32 name_atom, Node* declaration) {
        U32Map* map = this.alias_map;
        u32 key = SymbolTable.key(namespace_id, name_atom);
        if (map.find(key) >= 0) {
            return false;
        }
        Arena* arena = this.arena;
        AliasInfo* info = (AliasInfo*)arena.zalloc(sizeof(AliasInfo), 8);
        info.target = declaration.type();
        info.namespace_id = namespace_id;
        info.node = declaration;
        PointerList* list = this.aliases;
        list.push((ptr)info);
        map.put(key, (u32)(list.length - 1));
        return true;
    }

    unsafe AliasInfo* find_alias(u32 full, u32 base, u32 scope) {
        i64 index = this.lookup_type(this.alias_map, full, base, scope);
        if (index < 0) {
            return (AliasInfo*)0;
        }
        PointerList* list = this.aliases;
        return (AliasInfo*)list.get((i32)index);
    }

    unsafe u32 resolve_alias(AliasInfo* alias) {
        U32Map* saved_bindings = this.bindings;
        Node* saved_blame = this.blame;
        this.bindings = (U32Map*)0;
        this.blame = alias.node;
        u32 resolved = this.resolve_type(alias.target, alias.namespace_id);
        this.bindings = saved_bindings;
        this.blame = saved_blame;
        return resolved;
    }

    public unsafe u32 nullable_of_pointer(u32 pointer_type, u32 scope) {
        AtomTable* atoms = Atoms.get();
        u32 optional_atom = atoms.intern_copy("optional", 8);
        StructInfo* optional_info = this.find_struct(optional_atom, optional_atom, scope);
        if (optional_info == null || !optional_info.is_template) {
            return Types.nullable_pointer_to(Types.element(pointer_type));
        }
        IdList* optional_args = IdList.create();
        optional_args.push(pointer_type);
        SemanticAnalyzer* optional_generator = this.analyzer;
        return optional_generator.instantiate(optional_info, optional_args);
    }

    public unsafe u32 resolve_type(TypeRef* ref, u32 scope) {
        i32 kind = ref.kind;
        if (ref.nullable && kind != TypeKind.VOID && kind != TypeKind.AUTO) {
            AtomTable* atoms = Atoms.get();
            u32 optional_atom = atoms.intern_copy("optional", 8);
            StructInfo* optional_info = this.find_struct(optional_atom, optional_atom, scope);
            if (optional_info == null || !optional_info.is_template) {
                if (kind == TypeKind.POINTER && !ref.is_signed) {
                    u32 pointee = this.resolve_type(ref.element, scope);
                    if (pointee != 0) {
                        return Types.nullable_pointer_to(pointee);
                    }
                }
                return 0;
            }
            TypeRef* inner = TypeRef.create(kind);
            inner.bits = ref.bits;
            inner.is_signed = ref.is_signed;
            inner.is_char = ref.is_char;
            inner.element = ref.element;
            inner.args = ref.args;
            inner.name = ref.name;
            inner.name_atom = ref.name_atom;
            inner.full_atom = ref.full_atom;
            inner.value = ref.value;
            u32 payload = this.resolve_type(inner, scope);
            if (payload == 0) {
                return 0;
            }
            IdList* optional_args = IdList.create();
            optional_args.push(payload);
            SemanticAnalyzer* optional_generator = this.analyzer;
            return optional_generator.instantiate(optional_info, optional_args);
        }
        if (kind == TypeKind.VOID) {
            return Types.void_type();
        }
        if (kind == TypeKind.AUTO) {
            return Types.auto_type();
        }
        if (kind == TypeKind.INTEGER) {
            if (ref.is_char) {
                return Types.char_type();
            }
            return Types.integer((u32)ref.bits, ref.is_signed);
        }
        if (kind == TypeKind.FLOAT) {
            if (ref.is_brain_float()) {
                if (!Target.has_brain_float()) {
                    return 0;
                }
                return Types.brain_float();
            }
            return Types.floating((u32)ref.bits);
        }
        if (kind == TypeKind.POINTER) {
            u32 element = this.resolve_type(ref.element, scope);
            if (element == 0) {
                return 0;
            }
            if (ref.is_signed) {
                return Types.raw_pointer_to(element);
            }
            return Types.pointer_to(element);
        }
        if (kind == TypeKind.VALUE) {
            this.template_error(DiagnosticErrors.TYPE_ARGUMENT_EXPECTED, "a constant is not a type: only a template argument can be a constant");
            return 0;
        }
        if (kind == TypeKind.ARRAY) {
            return this.resolve_inline_array(ref, scope);
        }
        if (ref.args == null && this.bindings != null && ref.full_atom == ref.name_atom) {
            U32Map* active = this.bindings;
            i64 bound = active.find(ref.name_atom);
            if (bound >= 0) {
                if (Types.is_value((u32)bound)) {
                    ByteBuffer* message = ByteBuffer.create();
                    message.append("'");
                    message.append(ref.name);
                    message.append("' stands for the constant ");
                    this.describe_type((u32)bound, message);
                    message.append(" here, not for a type");
                    this.template_error(DiagnosticErrors.TYPE_ARGUMENT_EXPECTED, message.cstr());
                    return 0;
                }
                return (u32)bound;
            }
        }
        this.ambiguous_type(ref.full_atom, ref.name_atom, scope, this.blame);
        StructInfo* info = this.find_struct(ref.full_atom, ref.name_atom, scope);
        if (info == null) {
            AliasInfo* alias = this.find_alias(ref.full_atom, ref.name_atom, scope);
            if (alias != null && ref.args == null) {
                return this.resolve_alias(alias);
            }
            return 0;
        }
        if (info.is_template) {
            if (ref.args == null) {
                return 0;
            }
            PointerList* given = ref.args;
            IdList* resolved = IdList.create();
            GenericParams* params = info.generics;
            for (mut i32 i = 0; i < given.length; i = i + 1) {
                mut TypeRef* declared = (TypeRef*)0;
                if (params != null) {
                    declared = params.value_type(i);
                }
                u32 argument = this.resolve_argument((TypeRef*)given.get(i), declared, scope);
                if (argument == 0) {
                    return 0;
                }
                resolved.push(argument);
            }
            SemanticAnalyzer* generator = this.analyzer;
            return generator.instantiate(info, resolved);
        }
        if (ref.args != null) {
            return 0;
        }
        return info.type_id;
    }

    unsafe void template_error(i32 code, ptr<i8> message) {
        this.template_failed = true;
        Node* at = this.blame;
        if (at == null) {
            return;
        }
        SemanticAnalyzer* analyzer = this.analyzer;
        Diagnostics* diagnostics = analyzer.diagnostics;
        diagnostics.error_span(code, at.file_name(), at.line(), at.column(), at.length(), message);
    }

    // One argument of 'Name<...>'. A parameter declared with a type ('i32 N') takes a constant; an untyped one
    // takes a type or a constant, like a C++ template parameter.
    public unsafe u32 resolve_argument(TypeRef* ref, TypeRef* declared_ref, u32 scope) {
        mut u32 declared = 0;
        if (declared_ref != null) {
            declared = this.resolve_type(declared_ref, scope);
            if (declared == 0) {
                return 0;
            }
            if (!Types.is_integer(declared)) {
                this.template_error(DiagnosticErrors.INVALID_CONSTANT_PARAMETER, "a constant template parameter is an integer, bool, char or enum");
                return 0;
            }
        }
        if (ref.kind == TypeKind.VALUE) {
            return this.constant_argument(Node.clone(ref.value), declared, scope);
        }
        if (ref.kind == TypeKind.NAMED && ref.args == null && !ref.nullable) {
            if (this.bindings != null && ref.full_atom == ref.name_atom) {
                U32Map* active = this.bindings;
                i64 bound = active.find(ref.name_atom);
                if (bound >= 0) {
                    if (Types.is_value((u32)bound)) {
                        return this.convert_constant(Types.element((u32)bound), Types.value_of((u32)bound), declared);
                    }
                    if (declared != 0) {
                        this.template_error(DiagnosticErrors.CONSTANT_ARGUMENT_EXPECTED, "this template parameter takes a constant, not a type");
                        return 0;
                    }
                    return (u32)bound;
                }
            }
            if (declared != 0 || this.names_constant(ref, scope)) {
                Node* variant = this.enum_variant_named(ref, scope);
                if (variant != null) {
                    Node* tag = variant.first();
                    return this.convert_constant(variant.value_type(), tag.int_value(), declared);
                }
                return this.constant_argument(this.name_expression(ref, scope), declared, scope);
            }
        }
        if (declared != 0) {
            this.template_error(DiagnosticErrors.CONSTANT_ARGUMENT_EXPECTED, "this template parameter takes a constant, not a type");
            return 0;
        }
        return this.resolve_type(ref, scope);
    }

    // A plain name in a template argument is a constant when it names no type: a constexpr global, a struct
    // constant ('Limits::SIZE') or an enum variant ('Color::Red').
    unsafe bool names_constant(TypeRef* ref, u32 scope) {
        if (this.find_struct(ref.full_atom, ref.name_atom, scope) != null || this.find_alias(ref.full_atom, ref.name_atom, scope) != null) {
            return false;
        }
        if (this.find_interface(ref.full_atom, ref.name_atom, scope) != null) {
            return false;
        }
        if (ref.full_atom != ref.name_atom) {
            return true;
        }
        return this.find_global(ref.full_atom, ref.name_atom, scope) != null;
    }

    // 'Color::Red' as a template argument: the variant of a plain enum, whose tag is the constant.
    unsafe Node* enum_variant_named(TypeRef* ref, u32 scope) {
        if (ref.full_atom == ref.name_atom) {
            return (Node*)0;
        }
        ptr<i8> text = ref.name;
        i32 length = (i32)strlen(text);
        mut i32 split = 0 - 1;
        for (mut i32 i = 0; i + 1 < length; i = i + 1) {
            if (text[i] == (i8)58 && text[i + 1] == (i8)58) {
                split = i;
            }
        }
        if (split <= 0) {
            return (Node*)0;
        }
        AtomTable* atoms = Atoms.get();
        u32 owner_full = atoms.intern_copy(text, (u32)split);
        StructInfo* owner = this.find_struct(owner_full, atoms.base_of(owner_full), scope);
        if (owner == null || !owner.is_enum || owner.has_payload) {
            return (Node*)0;
        }
        PointerList* constants = owner.constants;
        u32 variant_atom = atoms.intern_copy(text + split + 2, (u32)(length - split - 2));
        for (mut i32 c = 0; c < constants.length; c = c + 1) {
            Node* variant = (Node*)constants.get(c);
            if (variant.text_atom() == variant_atom && variant.first() != null) {
                if (variant.value_type() == 0) {
                    variant.set_value_type(owner.type_id);
                }
                return variant;
            }
        }
        return (Node*)0;
    }

    unsafe Node* name_expression(TypeRef* ref, u32 scope) {
        mut i32 token = 0;
        Node* at = this.blame;
        if (at != null) {
            token = at.token;
        }
        Node* identifier = Node.create(NodeKind::IDENTIFIER, token);
        identifier.set_text(ref.name);
        if (ref.full_atom == ref.name_atom) {
            return identifier;
        }
        Node* scoped = Node.create_list(NodeKind::CALL, token);
        scoped.set_first(identifier);
        return scoped;
    }

    unsafe u32 constant_argument(Node* expression, u32 declared, u32 scope) {
        mut TypeChecker* checker = this.checker;
        if (checker == null) {
            SemanticAnalyzer* analyzer = this.analyzer;
            checker = TypeChecker.create(analyzer.diagnostics, this);
        }
        Node* saved_blame = this.blame;
        u32 type = checker.evaluate_template_constant(expression, declared, scope);
        this.blame = saved_blame;
        if (type == 0) {
            this.template_failed = true;
            return 0;
        }
        return this.convert_constant(type, checker.template_value, declared);
    }

    // Untyped parameters keep one spelling per value: every integer is an i64 constant, so 'vector<u64, 4>' is the
    // same instance whether '4' came from a literal, an i32 constant or another template's parameter.
    unsafe u32 convert_constant(u32 type, i64 value, u32 declared) {
        if (declared == 0) {
            bool keeps_type = Types.bits(type) == 1 || Types.is_char(type) || Types.enum_index(type) >= 0;
            if (keeps_type) {
                return Types.constant(type, value);
            }
            return Types.constant(Types.i64_type(), value);
        }
        bool same_kind = (Types.bits(type) == 1) == (Types.bits(declared) == 1) && Types.is_char(type) == Types.is_char(declared)
            && (Types.enum_index(declared) < 0 || type == declared);
        if (!same_kind) {
            ByteBuffer* mismatch = ByteBuffer.create();
            mismatch.append("this template parameter takes a constant of type '");
            this.describe_type(declared, mismatch);
            mismatch.append("', not '");
            this.describe_type(type, mismatch);
            mismatch.append("'");
            this.template_error(DiagnosticErrors.INVALID_TEMPLATE_CONSTANT, mismatch.cstr());
            return 0;
        }
        u32 bits = Types.bits(declared);
        mut bool fits = true;
        if (bits < 64 && bits > 1) {
            if (Types.is_signed(declared)) {
                i64 limit = (i64)1 << (i64)(bits - 1);
                fits = value >= 0 - limit && value < limit;
            } else {
                fits = value >= 0 && value < ((i64)1 << (i64)bits);
            }
        } else if (bits == 64 && !Types.is_signed(declared) && Types.is_signed(type)) {
            fits = value >= 0;
        }
        if (!fits) {
            ByteBuffer* message = ByteBuffer.create();
            message.append_int(value);
            message.append(" does not fit in '");
            this.describe_type(declared, message);
            message.append("', the type of this template parameter");
            this.template_error(DiagnosticErrors.INVALID_TEMPLATE_CONSTANT, message.cstr());
            return 0;
        }
        return Types.constant(declared, value);
    }

    // 'T[N]': N is a positive integer constant, possibly a parameter of the enclosing template.
    unsafe u32 resolve_inline_array(TypeRef* ref, u32 scope) {
        u32 element = this.resolve_type(ref.element, scope);
        if (element == 0) {
            return 0;
        }
        if (Types.is_void(element) || element == Types.auto_type()) {
            this.template_error(DiagnosticErrors.INVALID_ARRAY_SIZE, "an inline array needs a sized element type");
            return 0;
        }
        PointerList* sizes = ref.args;
        u32 size = this.resolve_argument((TypeRef*)sizes.get(0), (TypeRef*)0, scope);
        if (size == 0) {
            return 0;
        }
        if (!Types.is_value(size) || Types.bits(Types.element(size)) == 1 || Types.is_char(Types.element(size))) {
            this.template_error(DiagnosticErrors.INVALID_ARRAY_SIZE, "the size of an inline array is an integer constant");
            return 0;
        }
        i64 length = Types.value_of(size);
        if (length <= 0 || length > 1073741824) {
            ByteBuffer* message = ByteBuffer.create();
            message.append("an inline array holds 1 to 1073741824 elements, not ");
            message.append_int(length);
            this.template_error(DiagnosticErrors.INVALID_ARRAY_SIZE, message.cstr());
            return 0;
        }
        return Types.array(element, length);
    }

    public void describe_type(u32 id, ByteBuffer* out) {
        if (Types.is_pointer(id)) {
            this.describe_type(Types.element(id), out);
            out.append_char('*');
            return;
        }
        if (Types.is_array(id)) {
            this.describe_type(Types.element(id), out);
            out.append_char('[');
            out.append_int(Types.value_of(id));
            out.append_char(']');
            return;
        }
        StructInfo* named = this.enum_of_type(id);
        if (named != null) {
            out.append(named.name);
            return;
        }
        IdList* signature = this.closure_signature(id);
        if (signature != null) {
            out.append("fn(");
            for (mut i32 i = 1; i < signature.length; i = i + 1) {
                if (i > 1) {
                    out.append(", ");
                }
                this.describe_type(signature.get(i), out);
            }
            out.append_char(')');
            if (!Types.is_void(signature.get(0))) {
                out.append(" -> ");
                this.describe_type(signature.get(0), out);
            }
            return;
        }
        if (Types.is_struct(id)) {
            StructInfo* info = this.struct_at(Types.struct_index(id));
            out.append(info.name);
            return;
        }
        Types.describe(id, out);
    }

    // The instance of a core '__closureN<R, A0, ...>' template behind a 'fn(A0, ...) -> R' type: returns its type
    // arguments, return type first, or null for any other type.
    public unsafe IdList* closure_signature(u32 id) {
        if (id == 0 || !Types.is_struct(id)) {
            return (IdList*)0;
        }
        StructInfo* info = this.struct_at(Types.struct_index(id));
        if (info == null || info.origin == null || info.type_args == null) {
            return (IdList*)0;
        }
        StructInfo* origin = info.origin;
        ptr<i8> name = origin.name;
        if (!Strings.starts_with(name, 0, (i32)strlen(name), "__closure")) {
            return (IdList*)0;
        }
        return info.type_args;
    }

    public void add_function_instance(FunctionInfo* info) {
        PointerList* list = this.functions;
        list.push((ptr)info);
    }

    public void add_instance(StructInfo* info) {
        PointerList* list = this.structs;
        list.push((ptr)info);
    }

    public unsafe u32 nullable_payload(u32 type) {
        u32 payload = this.optional_payload(type);
        if (!Types.is_pointer(payload)) {
            return 0;
        }
        return payload;
    }

    public unsafe u32 nullable_value_payload(u32 type) {
        u32 payload = this.optional_payload(type);
        if (Types.is_pointer(payload)) {
            return 0;
        }
        return payload;
    }

    unsafe u32 optional_payload(u32 type) {
        StructInfo* info = this.enum_of_type(type);
        if (info == null || info.node == null) {
            return 0;
        }
        Node* declaration = info.node;
        if (declaration.count() != 2) {
            return 0;
        }
        Node* first = declaration.child(0);
        Node* second = declaration.child(1);
        mut Node* with_pointer = first;
        mut Node* empty = second;
        if (first.count() == 0) {
            with_pointer = second;
            empty = first;
        }
        if (empty.count() != 0 || with_pointer.count() != 1) {
            return 0;
        }
        Node* payload = with_pointer.child(0);
        return payload.value_type();
    }

    public unsafe StructInfo* enum_of_type(u32 type) {
        if (Types.is_struct(type)) {
            StructInfo* info = this.struct_at(Types.struct_index(type));
            if (info.is_enum) {
                return info;
            }
            return (StructInfo*)0;
        }
        i64 index = Types.enum_index(type);
        if (index < 0) {
            return (StructInfo*)0;
        }
        return this.struct_at((u32)index);
    }

    public unsafe StructInfo* primitive_owner(u32 type) {
        U32Map* map = this.primitive_map;
        PointerList* list = this.primitives;
        i64 found = map.find(type);
        if (found >= 0) {
            return (StructInfo*)list.get((i32)found);
        }
        Arena* arena = this.arena;
        StructInfo* info = (StructInfo*)arena.zalloc(sizeof(StructInfo), 8);
        ByteBuffer* name = ByteBuffer.create();
        this.describe_type(type, name);
        info.name = name.cstr();
        info.type_id = type;
        info.is_primitive = true;
        info.fields = PointerList.create();
        info.constants = PointerList.create();
        info.field_map = U32Map.create(arena, 8);
        info.constant_map = U32Map.create(arena, 8);
        info.method_map = U32Map.create(arena, 8);
        map.put(type, (u32)list.length);
        list.push((ptr)info);
        return info;
    }

    public u32 pack_element(u32 pack_type) {
        StructInfo* pack = this.struct_at(Types.struct_index(pack_type));
        IdList* type_args = pack.type_args;
        return type_args.get(0);
    }

    // The result and error types of a 'task<T, E>' instance, null for any other type.
    public unsafe IdList* task_args(u32 type) {
        if (type == 0 || !Types.is_struct(type) || this.enum_of_type(type) != null) {
            return (IdList*)0;
        }
        StructInfo* info = this.struct_at(Types.struct_index(type));
        if (info.origin == null || info.type_args == null) {
            return (IdList*)0;
        }
        StructInfo* origin = info.origin;
        if (origin.name_atom != Ast.intern_base_name("task", 4)) {
            return (IdList*)0;
        }
        return info.type_args;
    }

    public unsafe StructInfo* find_core_struct(u32 atom) {
        StructInfo* root = this.find_struct(atom, atom, 0);
        if (root != null) {
            return root;
        }
        AtomTable* atoms = Atoms.get();
        i64 library = this.find_child_namespace(0, atoms.intern_copy("std::types", 10));
        if (library < 0) {
            return (StructInfo*)0;
        }
        return this.find_struct(atom, atom, (u32)library);
    }

    public unsafe StructInfo* struct_at(u32 index) {
        PointerList* list = this.structs;
        return (StructInfo*)list.get((i32)index);
    }

    public bool add_struct(StructInfo* info) {
        U32Map* map = this.struct_map;
        u32 key = SymbolTable.key(info.namespace_id, info.name_atom);
        if (map.contains(key)) {
            return false;
        }
        PointerList* list = this.structs;
        map.put(key, (u32)list.length);
        list.push((ptr)info);
        return true;
    }

    public bool add_interface(InterfaceInfo* info) {
        U32Map* map = this.interface_map;
        u32 key = SymbolTable.key(info.namespace_id, info.name_atom);
        if (map.contains(key)) {
            return false;
        }
        PointerList* list = this.interfaces;
        map.put(key, (u32)list.length);
        list.push((ptr)info);
        return true;
    }

    public unsafe InterfaceInfo* find_interface(u32 full, u32 base, u32 scope) {
        i64 index = this.lookup(this.interface_map, full, base, scope);
        if (index < 0) {
            return (InterfaceInfo*)0;
        }
        PointerList* list = this.interfaces;
        return (InterfaceInfo*)list.get((i32)index);
    }

    public unsafe StructInfo* find_struct(u32 full, u32 base, u32 scope) {
        i64 index = this.lookup_type(this.struct_map, full, base, scope);
        if (index < 0) {
            return (StructInfo*)0;
        }
        PointerList* list = this.structs;
        return (StructInfo*)list.get((i32)index);
    }

    public unsafe StructInfo* find_struct_named(u32 base) {
        PointerList* list = this.structs;
        for (mut i32 i = 0; i < list.length; i = i + 1) {
            StructInfo* info = (StructInfo*)list.get(i);
            if (info != null && info.name_atom == base) {
                return info;
            }
        }
        return (StructInfo*)0;
    }

    static bool same_signature(FunctionInfo* left, FunctionInfo* right) {
        if (left.is_template || right.is_template) {
            return left.is_template && right.is_template;
        }
        IdList* a = left.param_types;
        IdList* b = right.param_types;
        if (a.length != b.length) {
            return false;
        }
        for (mut i32 i = 0; i < a.length; i = i + 1) {
            if (a.get(i) != b.get(i)) {
                return false;
            }
        }
        return true;
    }

    static unsafe bool in_other_file(FunctionInfo* left, FunctionInfo* right) {
        Node* a = left.node;
        Node* b = right.node;
        if (a == null || b == null || a.kind() != NodeKind::EXTERN_FUNCTION || b.kind() != NodeKind::EXTERN_FUNCTION) {
            return false;
        }
        return !Strings.same(a.file_name(), b.file_name());
    }

    public unsafe FunctionInfo* find_extern(FunctionInfo* info) {
        U32Map* map = this.function_map;
        i64 found = map.find(SymbolTable.key(info.namespace_id, info.name_atom));
        if (found < 0) {
            return (FunctionInfo*)0;
        }
        PointerList* list = this.functions;
        mut FunctionInfo* entry = (FunctionInfo*)list.get((i32)found);
        while (entry != null) {
            if (entry.is_extern && !entry.is_template && entry.owner == null) {
                return entry;
            }
            entry = entry.overload;
        }
        return (FunctionInfo*)0;
    }

    unsafe u32 extern_abi_type(u32 type) {
        u32 payload = this.nullable_payload(type);
        if (payload != 0) {
            return payload;
        }
        return type;
    }

    unsafe bool same_extern_type(u32 left, u32 right) {
        u32 a = this.extern_abi_type(left);
        u32 b = this.extern_abi_type(right);
        return a == b || (Types.is_pointer(a) && Types.is_pointer(b));
    }

    public unsafe bool same_extern_declaration(FunctionInfo* left, FunctionInfo* right) {
        if (left.is_variadic != right.is_variadic || !this.same_extern_type(left.return_type, right.return_type)) {
            return false;
        }
        IdList* a = left.param_types;
        IdList* b = right.param_types;
        if (a.length != b.length) {
            return false;
        }
        for (mut i32 i = 0; i < a.length; i = i + 1) {
            if (!this.same_extern_type(a.get(i), b.get(i))) {
                return false;
            }
        }
        return true;
    }

    public unsafe bool add_function(FunctionInfo* info) {
        mut U32Map* map = this.function_map;
        mut u32 key = SymbolTable.key(info.namespace_id, info.name_atom);
        if (info.owner != null) {
            StructInfo* owner = info.owner;
            map = owner.method_map;
            key = info.name_atom;
        }
        PointerList* list = this.functions;
        i64 found = map.find(key);
        if (found < 0) {
            map.put(key, (u32)list.length);
            list.push((ptr)info);
            return true;
        }
        mut FunctionInfo* tail = (FunctionInfo*)list.get((i32)found);
        mut i32 ordinal = 1;
        while (true) {
            if (SymbolTable.same_signature(tail, info) && !(tail.is_extern && info.is_extern && (tail.home_scope != info.home_scope || SymbolTable.in_other_file(tail, info)))) {
                return false;
            }
            if (tail.overload == null) {
                break;
            }
            tail = tail.overload;
            ordinal = ordinal + 1;
        }
        tail.overload = info;
        info.overload_index = ordinal;
        if (!info.is_extern) {
            ByteBuffer* mangled = ByteBuffer.create();
            mangled.append(info.name);
            mangled.append_char('$');
            mangled.append_int((i64)ordinal);
            info.name = mangled.cstr();
        }
        list.push((ptr)info);
        return true;
    }

    public unsafe FunctionInfo* find_function(u32 full, u32 base, u32 scope) {
        i64 index = this.lookup(this.function_map, full, base, scope);
        if (index < 0) {
            return (FunctionInfo*)0;
        }
        PointerList* list = this.functions;
        return (FunctionInfo*)list.get((i32)index);
    }

    public unsafe FunctionInfo* find_method(StructInfo* owner, u32 name) {
        U32Map* map = owner.method_map;
        i64 index = map.find(name);
        if (index < 0) {
            return (FunctionInfo*)0;
        }
        PointerList* list = this.functions;
        return (FunctionInfo*)list.get((i32)index);
    }

    public bool add_global(LocalVariable* variable) {
        U32Map* map = this.global_map;
        u32 key = SymbolTable.key(variable.namespace_id, variable.name_atom);
        if (map.contains(key)) {
            return false;
        }
        PointerList* list = this.globals;
        map.put(key, (u32)list.length);
        list.push((ptr)variable);
        return true;
    }

    public unsafe LocalVariable* find_global(u32 full, u32 base, u32 scope) {
        i64 index = this.lookup(this.global_map, full, base, scope);
        if (index < 0) {
            return (LocalVariable*)0;
        }
        PointerList* list = this.globals;
        return (LocalVariable*)list.get((i32)index);
    }

    public unsafe FieldInfo* find_field(StructInfo* info, u32 name) {
        U32Map* map = info.field_map;
        i64 index = map.find(name);
        if (index < 0) {
            return (FieldInfo*)0;
        }
        PointerList* list = info.fields;
        return (FieldInfo*)list.get((i32)index);
    }

    public unsafe Node* find_constant(StructInfo* info, u32 name) {
        U32Map* map = info.constant_map;
        i64 index = map.find(name);
        if (index < 0) {
            return (Node*)0;
        }
        PointerList* list = info.constants;
        return (Node*)list.get((i32)index);
    }
}
