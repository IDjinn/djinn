namespace djinnc;

struct FunctionInfo {
    ptr<i8> name;
    u32 name_atom;
    u32 namespace_id;
    u32 home_scope;
    ptr function;
    ptr function_type;
    u32 return_type;
    IdList* param_types;
    LocalVariable* this_variable;
    bool is_variadic;
    bool packs_variadic;
    bool is_extern;
    bool is_disabled;
    bool is_instance;
    bool is_async;
    bool is_unsafe;
    bool is_pure;
    bool eval_ready;
    i32 const_kind;
    i32 check_state;
    i32 eval_slots;
    Node* node;
    StructInfo* owner;
    GenericParams* generics;
    bool is_template;
    U32Map* bindings;
    FunctionInfo* overload;
    i32 overload_index;
    ptr reflection;
    bool has_throws;
    bool throws_any;
    IdList* throws_types;
    ptr result_type;

    public unsafe bool borrows_parameters() {
        if (this.is_extern) {
            return true;
        }
        Node* declaration = this.node;
        if (declaration == null || declaration.kind() != NodeKind::FUNCTION) {
            return false;
        }
        ptr<i8> text = declaration.text();
        if (text == null) {
            return false;
        }
        i32 length = strlen(text);
        return Strings.starts_with(text, 0, length, "operator") || Strings.starts_with(text, 0, length, "get:") || Strings.starts_with(text, 0, length, "set:");
    }

    public unsafe bool allows(u32 type) {
        if (this.throws_any) {
            return true;
        }
        if (this.throws_types == null) {
            return false;
        }
        IdList* list = this.throws_types;
        for (mut i32 i = 0; i < list.length; i = i + 1) {
            if (list.get(i) == type) {
                return true;
            }
        }
        return false;
    }
}
