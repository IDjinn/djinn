namespace djinnc;

struct FunctionInfo {
    i8* name;
    u32 name_atom;
    u32 namespace_id;
    void* function;
    void* function_type;
    u32 return_type;
    IdList* param_types;
    LocalVariable* this_variable;
    bool is_variadic;
    bool is_extern;
    bool is_instance;
    bool is_async;
    bool eval_ready;
    i32 const_kind;
    i32 check_state;
    i32 eval_slots;
    Node* node;
    StructInfo* owner;
    GenericParams* generics;
    bool is_template;
    U32Map* bindings;
    FunctionInfo* overload;
    i32 overload_index;
}
