namespace djinnc;

struct StructInfo {
    ptr<i8> name;
    u32 name_atom;
    u32 namespace_id;
    u32 index;
    u32 type_id;
    bool is_enum;
    bool is_primitive;
    bool has_payload;
    bool is_niche;
    i32 niche_some_tag;
    i32 niche_none_tag;
    i32 header_count;
    ptr field_tables;
    ptr field_rows;
    i32 slot_count;
    i32 layout_state;
    ptr llvm;
    PointerList* fields;
    PointerList* constants;
    U32Map* field_map;
    U32Map* constant_map;
    U32Map* method_map;
    Node* node;
    GenericParams* generics;
    bool is_template;
    StructInfo* origin;
    U32Map* bindings;
    IdList* type_args;
    PointerList* impls;
    PointerList* contracts;
    ptr type_info;
}
