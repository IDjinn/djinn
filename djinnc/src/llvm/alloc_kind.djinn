namespace djinnc;

struct AllocKind {
    const i32 ALLOC = 0x1;
    const i32 REALLOC = 0x2;
    const i32 FREE = 0x4;
    const i32 UNINITIALIZED = 0x8;
    const i32 ZEROED = 0x10;
    const i32 ALIGNED = 0x20;
    const u64 NO_COUNT_PARAMETER = 0xFFFFFFFF;
    const u64 INACCESSIBLE_MEMORY = 0xC;
    const u64 ARGUMENT_AND_INACCESSIBLE_MEMORY = 0xF;
}
