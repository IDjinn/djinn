namespace djinnc;

struct Parser {
    TokenList* tokens;
    i32 pos;
    i32 end;
    bool failed;
    Diagnostics* diagnostics;
    U32Map* type_names;

    public static Parser* create(TokenList* tokens, SourceFile* file, Diagnostics* diagnostics, U32Map* type_names) {
        Parser* parser = (Parser*)Memory.zalloc(sizeof(Parser));
        parser.tokens = tokens;
        parser.pos = file.first_token;
        parser.end = file.token_end;
        parser.diagnostics = diagnostics;
        parser.type_names = type_names;
        return parser;
    }

    public static void collect_type_names(TokenList* list, SourceFile* file, U32Map* names) {
        for (mut i32 i = file.first_token; i + 1 < file.token_end; i = i + 1) {
            i32 kind = list.kind(i);
            bool declaresType = kind == TokenKind.STRUCT || kind == TokenKind.ENUM;
            if (declaresType && list.kind(i + 1) == TokenKind.IDENTIFIER) {
                names.put(list.atom(i + 1), 1);
            }
        }
    }

    i32 kind_of(i32 token) {
        TokenList* list = this.tokens;
        return list.kind(token);
    }

    i8* text_of(i32 token) {
        TokenList* list = this.tokens;
        return list.text(token);
    }

    i32 length_of(i32 token) {
        TokenList* list = this.tokens;
        return list.text_length(token);
    }

    i32 line_of(i32 token) {
        TokenList* list = this.tokens;
        return list.line(token);
    }

    i32 column_of(i32 token) {
        TokenList* list = this.tokens;
        return list.column(token);
    }

    i8* copy_of(i32 token) {
        TokenList* list = this.tokens;
        return list.copy_text(token);
    }

    u32 atom_of(i32 token) {
        TokenList* list = this.tokens;
        return list.atom(token);
    }

    public Node* parse_program() {
        i32 first = this.current();
        Node* program = Node.create_list(NodeKind.PROGRAM, first);
        while (!this.at_end()) {
            Node* declaration = this.parse_declaration();
            if (declaration != null) {
                program.add(declaration);
            }
        }
        return program;
    }

    i32 current() {
        return this.peek_token(0);
    }

    i32 peek_token(i32 offset) {
        mut i32 index = this.pos + offset;
        if (index >= this.end) {
            index = this.end - 1;
        }
        return index;
    }

    bool at_end() {
        i32 token = this.current();
        return this.failed || this.kind_of(token) == TokenKind.END_OF_FILE;
    }

    i32 advance() {
        i32 token = this.current();
        if (this.kind_of(token) != TokenKind.END_OF_FILE) {
            this.pos = this.pos + 1;
        }
        return token;
    }

    bool check(i32 kind) {
        i32 token = this.current();
        return this.kind_of(token) == kind;
    }

    bool match(i32 kind) {
        if (this.check(kind)) {
            this.advance();
            return true;
        }
        return false;
    }

    void fail(i8* message) {
        if (this.failed) {
            return;
        }
        i32 token = this.current();
        Diagnostics* diagnostics = this.diagnostics;
        mut i8* found = this.copy_of(token);
        if (this.kind_of(token) == TokenKind.END_OF_FILE) {
            found = "end of file";
        }
        diagnostics.error_near(this.line_of(token), this.column_of(token), message, found);
        this.failed = true;
    }

    i32 expect(i32 kind, i8* message) {
        i32 token = this.current();
        if (this.kind_of(token) != kind) {
            this.fail(message);
            return token;
        }
        return this.advance();
    }

    bool is_known_type(i32 token) {
        U32Map* names = this.type_names;
        return names.contains(this.atom_of(token));
    }

    bool is_type_start(i32 token) {
        i32 kind = this.kind_of(token);
        if (kind == TokenKind.VOID || kind == TokenKind.AUTO) {
            return true;
        }
        if (kind != TokenKind.IDENTIFIER) {
            return false;
        }
        TypeRef* primitive = TypeRef.from_primitive_atom(this.atom_of(token));
        if (primitive != null) {
            return true;
        }
        return this.is_known_type(token);
    }

    i32 scan_type_end(i32 start) {
        mut i32 offset = start;
        i32 first = this.peek_token(offset);
        if (!this.is_type_start(first)) {
            return 0 - 1;
        }
        offset = offset + 1;
        while (true) {
            i32 separator = this.peek_token(offset);
            i32 part = this.peek_token(offset + 1);
            if (this.kind_of(separator) == TokenKind.COLON_COLON && this.kind_of(part) == TokenKind.IDENTIFIER) {
                offset = offset + 2;
            } else {
                break;
            }
        }
        while (this.kind_of(this.peek_token(offset)) == TokenKind.STAR) {
            offset = offset + 1;
        }
        if (this.kind_of(this.peek_token(offset)) == TokenKind.QUESTION) {
            offset = offset + 1;
        }
        return offset;
    }

    bool is_declaration_start() {
        if (this.check(TokenKind.MUT)) {
            return true;
        }
        i32 end = this.scan_type_end(0);
        if (end < 0) {
            return false;
        }
        i32 after = this.peek_token(end);
        return this.kind_of(after) == TokenKind.IDENTIFIER || this.kind_of(after) == TokenKind.MUT;
    }

    i8* qualified_name() {
        i32 first = this.expect(TokenKind.IDENTIFIER, "expected identifier");
        ByteBuffer* name = ByteBuffer.create();
        name.append_slice(this.text_of(first), this.length_of(first));
        while (this.check(TokenKind.COLON_COLON)) {
            this.advance();
            i32 part = this.expect(TokenKind.IDENTIFIER, "expected identifier after '::'");
            name.append("::");
            name.append_slice(this.text_of(part), this.length_of(part));
        }
        return name.cstr();
    }

    void skip_attributes() {
        while (this.check(TokenKind.LBRACKET) && !this.failed) {
            mut i32 depth = 0;
            while (!this.at_end()) {
                i32 token = this.advance();
                if (this.kind_of(token) == TokenKind.LBRACKET) {
                    depth = depth + 1;
                } else if (this.kind_of(token) == TokenKind.RBRACKET) {
                    depth = depth - 1;
                    if (depth == 0) {
                        break;
                    }
                }
            }
        }
    }

    TypeRef* parse_type() {
        i32 token = this.current();
        mut TypeRef* base = (TypeRef*)0;

        if (this.kind_of(token) == TokenKind.VOID || this.kind_of(token) == TokenKind.AUTO) {
            this.advance();
            base = TypeRef.from_primitive_atom(this.atom_of(token));
        } else if (this.kind_of(token) == TokenKind.IDENTIFIER) {
            TypeRef* primitive = TypeRef.from_primitive_atom(this.atom_of(token));
            if (primitive != null) {
                this.advance();
                base = primitive;
            } else {
                base = TypeRef.named(this.qualified_name());
            }
        } else {
            this.fail("expected a type");
            return TypeRef.create(TypeKind.VOID);
        }

        while (this.match(TokenKind.STAR)) {
            base = TypeRef.pointer_to(base);
        }

        if (this.check(TokenKind.LBRACKET) && this.kind_of(this.peek_token(1)) == TokenKind.RBRACKET) {
            this.fail("array types are not supported yet");
        }

        if (this.check(TokenKind.LESS) && base.kind == TypeKind.NAMED) {
            this.fail("generic types are not supported yet");
        }

        if (this.match(TokenKind.QUESTION)) {
            base.nullable = true;
        }
        return base;
    }

    Node* parse_declaration() {
        this.skip_attributes();
        i32 token = this.current();

        if (this.kind_of(token) == TokenKind.IMPORT) {
            this.advance();
            Node* import_node = Node.create(NodeKind.IMPORT, token);
            import_node.set_text(this.qualified_name());
            this.expect(TokenKind.SEMICOLON, "expected ';' after import");
            return import_node;
        }

        if (this.kind_of(token) == TokenKind.NAMESPACE) {
            return this.parse_namespace();
        }

        if (this.kind_of(token) == TokenKind.EXTERN) {
            return this.parse_extern();
        }

        if (this.kind_of(token) == TokenKind.STRUCT) {
            return this.parse_struct();
        }

        if (this.kind_of(token) == TokenKind.ENUM) {
            return this.parse_enum();
        }

        if (this.kind_of(token) == TokenKind.UNSAFE || this.kind_of(token) == TokenKind.STATIC) {
            return this.parse_static_var();
        }

        if (this.kind_of(token) == TokenKind.ENUM || this.kind_of(token) == TokenKind.INTERFACE || this.kind_of(token) == TokenKind.IMPL
            || this.kind_of(token) == TokenKind.MACRO) {
            this.fail("this declaration is not supported yet");
            return (Node*)0;
        }

        return this.parse_function(false);
    }

    Node* parse_namespace() {
        i32 start = this.advance();
        Node* node = Node.create_list(NodeKind.NAMESPACE_DECL, start);
        node.set_text(this.qualified_name());
        if (this.match(TokenKind.SEMICOLON)) {
            while (!this.at_end()) {
                Node* declaration = this.parse_declaration();
                if (declaration != null) {
                    node.add(declaration);
                }
            }
            return node;
        }

        this.expect(TokenKind.LBRACE, "expected ';' or '{' after namespace name");
        while (!this.check(TokenKind.RBRACE) && !this.at_end()) {
            Node* declaration = this.parse_declaration();
            if (declaration != null) {
                node.add(declaration);
            }
        }
        this.expect(TokenKind.RBRACE, "expected '}' to close namespace");
        return node;
    }

    Node* parse_extern() {
        i32 start = this.advance();
        Node* group = Node.create_list(NodeKind.NAMESPACE_DECL, start);
        group.set_text("");
        group.set_flag(true);

        if (this.check(TokenKind.STRING_LITERAL)) {
            this.advance();
        }

        if (this.match(TokenKind.LBRACE)) {
            while (!this.check(TokenKind.RBRACE) && !this.at_end()) {
                this.skip_attributes();
                group.add(this.parse_extern_function());
            }
            this.expect(TokenKind.RBRACE, "expected '}' to close extern block");
            return group;
        }

        group.add(this.parse_extern_function());
        return group;
    }

    Node* parse_extern_function() {
        i32 start = this.current();
        Node* node = Node.create_list(NodeKind.EXTERN_FUNCTION, start);
        node.set_type(this.parse_type());
        i32 name = this.expect(TokenKind.IDENTIFIER, "expected extern function name");
        node.set_text(this.copy_of(name));
        this.expect(TokenKind.LPAREN, "expected '(' after function name");
        this.parse_parameters(node);
        this.expect(TokenKind.RPAREN, "expected ')' after parameters");
        this.expect(TokenKind.SEMICOLON, "expected ';' after extern function");
        return node;
    }

    void parse_parameters(Node* owner) {
        if (this.check(TokenKind.RPAREN)) {
            return;
        }
        while (!this.at_end()) {
            if (this.check(TokenKind.DOT_DOT_DOT)) {
                this.advance();
                owner.set_variadic(true);
                if (this.check(TokenKind.IDENTIFIER)) {
                    this.advance();
                }
                break;
            }

            i32 start = this.current();
            Node* parameter = Node.create(NodeKind.PARAMETER, start);
            if (this.match(TokenKind.MUT)) {
                parameter.set_flag(true);
            }
            parameter.set_type(this.parse_type());
            i32 name = this.expect(TokenKind.IDENTIFIER, "expected parameter name");
            parameter.set_text(this.copy_of(name));
            if (this.match(TokenKind.MUT)) {
                parameter.set_flag(true);
            }
            owner.add(parameter);

            if (!this.match(TokenKind.COMMA)) {
                break;
            }
        }
    }

    Node* parse_function(bool allowConstructor) {
        mut bool is_static = false;
        while (this.check(TokenKind.PUBLIC) || this.check(TokenKind.PRIVATE) || this.check(TokenKind.STATIC)) {
            i32 modifier = this.advance();
            if (this.kind_of(modifier) == TokenKind.STATIC) {
                is_static = true;
            }
        }

        if (this.check(TokenKind.ASYNC) || this.check(TokenKind.CONSTEXPR) || this.check(TokenKind.CONSTEVAL)) {
            this.fail("async, constexpr and consteval functions are not supported yet");
            return (Node*)0;
        }

        i32 start = this.current();
        Node* function = Node.create_list(NodeKind.FUNCTION, start);
        function.set_flag(is_static);
        function.set_type(this.parse_type());
        i32 name = this.expect(TokenKind.IDENTIFIER, "expected function name");
        function.set_text(this.copy_of(name));
        this.expect(TokenKind.LPAREN, "expected '(' after function name");
        this.parse_parameters(function);
        this.expect(TokenKind.RPAREN, "expected ')' after parameters");

        if (this.check(TokenKind.THROWS) || this.check(TokenKind.REQUIRE) || this.check(TokenKind.ENSURE)) {
            this.fail("throws and contracts are not supported yet");
            return function;
        }

        if (this.match(TokenKind.ARROW)) {
            i32 arrow = this.current();
            Node* body = Node.create_list(NodeKind.BLOCK, arrow);
            Node* ret = Node.create(NodeKind.RETURN, arrow);
            ret.set_first(this.parse_expression());
            body.add(ret);
            this.expect(TokenKind.SEMICOLON, "expected ';' after expression body");
            function.set_first(body);
            return function;
        }

        function.set_first(this.parse_block());
        return function;
    }

    Node* parse_static_var() {
        i32 start = this.current();
        bool has_unsafe = this.match(TokenKind.UNSAFE);
        Node* node = Node.create(NodeKind.STATIC_VAR, start);
        i32 after_static = this.peek_token(1);
        if (!has_unsafe && this.kind_of(after_static) == TokenKind.MUT) {
            this.fail("'static mut' requires 'unsafe'");
            return node;
        }
        this.expect(TokenKind.STATIC, "expected 'static'");
        bool is_mutable = this.match(TokenKind.MUT);
        if (has_unsafe && !is_mutable) {
            this.fail("'unsafe' is only valid on 'static mut'");
            return node;
        }
        node.set_flag(is_mutable);
        node.set_type(this.parse_type());
        i32 name = this.expect(TokenKind.IDENTIFIER, "expected static variable name");
        node.set_text(this.copy_of(name));
        this.expect(TokenKind.EQUAL, "expected '=' in static variable declaration");
        node.set_first(this.parse_expression());
        this.expect(TokenKind.SEMICOLON, "expected ';' after static variable");
        return node;
    }

    Node* parse_enum() {
        i32 start = this.advance();
        Node* node = Node.create_list(NodeKind.STRUCT_DECL, start);
        node.set_flag(true);
        i32 name = this.expect(TokenKind.IDENTIFIER, "expected enum name");
        node.set_text(this.copy_of(name));

        if (this.check(TokenKind.LESS)) {
            this.fail("generic enums are not supported yet");
            return node;
        }

        this.expect(TokenKind.LBRACE, "expected '{' to open enum body");
        mut i64 next_value = 0;
        while (!this.check(TokenKind.RBRACE) && !this.at_end()) {
            i32 variant = this.expect(TokenKind.IDENTIFIER, "expected enum variant name");
            if (this.match(TokenKind.EQUAL)) {
                i32 literal_token = this.expect(TokenKind.INTEGER_LITERAL, "expected an integer enum value");
                next_value = Strings.parse_integer(this.text_of(literal_token), this.length_of(literal_token));
            }
            if (this.match(TokenKind.LPAREN)) {
                if (!this.check(TokenKind.RPAREN)) {
                    this.fail("enum variants with payloads are not supported yet");
                    return node;
                }
                this.advance();
            }

            Node* constant = Node.create(NodeKind.FIELD_DECL, variant);
            constant.set_flag(true);
            constant.set_type(TypeRef.integer(32, true));
            constant.set_text(this.copy_of(variant));
            Node* value = Node.create(NodeKind.INT_LITERAL, variant);
            value.set_int_value(next_value);
            constant.set_first(value);
            node.add(constant);
            next_value = next_value + 1;

            if (!this.check(TokenKind.RBRACE)) {
                this.expect(TokenKind.COMMA, "expected ',' between enum variants");
            }
        }
        this.expect(TokenKind.RBRACE, "expected '}' to close enum body");
        return node;
    }

    Node* parse_struct() {
        i32 start = this.advance();
        Node* node = Node.create_list(NodeKind.STRUCT_DECL, start);
        i32 name = this.expect(TokenKind.IDENTIFIER, "expected struct name");
        node.set_text(this.copy_of(name));

        if (this.check(TokenKind.LESS)) {
            this.fail("generic structs are not supported yet");
            return node;
        }

        if (this.match(TokenKind.COLON)) {
            node.set_type(this.parse_type());
            while (this.match(TokenKind.COMMA)) {
                this.parse_type();
            }
        }

        if (this.match(TokenKind.SEMICOLON)) {
            return node;
        }

        this.expect(TokenKind.LBRACE, "expected '{' to open struct body");
        while (!this.check(TokenKind.RBRACE) && !this.at_end()) {
            this.skip_attributes();
            this.parse_struct_member(node);
        }
        this.expect(TokenKind.RBRACE, "expected '}' to close struct body");
        return node;
    }

    void parse_struct_member(Node* owner) {
        i32 start = this.current();
        mut i32 lookahead = 0;
        while (this.kind_of(this.peek_token(lookahead)) == TokenKind.PUBLIC || this.kind_of(this.peek_token(lookahead)) == TokenKind.PRIVATE
            || this.kind_of(this.peek_token(lookahead)) == TokenKind.STATIC) {
            lookahead = lookahead + 1;
        }
        i32 head = this.peek_token(lookahead);

        if (this.kind_of(head) == TokenKind.CONST) {
            for (mut i32 i = 0; i < lookahead; i = i + 1) {
                this.advance();
            }
            this.advance();
            Node* constant = Node.create(NodeKind.FIELD_DECL, head);
            constant.set_flag(true);
            constant.set_type(this.parse_type());
            i32 constName = this.expect(TokenKind.IDENTIFIER, "expected constant name");
            constant.set_text(this.copy_of(constName));
            this.expect(TokenKind.EQUAL, "expected '=' in constant declaration");
            constant.set_first(this.parse_expression());
            this.expect(TokenKind.SEMICOLON, "expected ';' after constant");
            owner.add(constant);
            return;
        }

        i32 afterHead = this.peek_token(lookahead + 1);
        bool isConstructor = this.kind_of(head) == TokenKind.IDENTIFIER && this.kind_of(afterHead) == TokenKind.LPAREN;
        if (isConstructor) {
            this.fail("constructors are not supported yet");
            return;
        }

        if (this.kind_of(head) == TokenKind.OPERATOR) {
            this.fail("operator overloads are not supported yet");
            return;
        }

        mut i32 typeEnd = this.scan_type_end(lookahead);
        if (typeEnd < 0) {
            this.fail("expected a struct member");
            return;
        }

        i32 afterType = this.peek_token(typeEnd);
        i32 afterName = this.peek_token(typeEnd + 1);
        if (this.kind_of(afterType) == TokenKind.IDENTIFIER && this.kind_of(afterName) == TokenKind.LPAREN) {
            Node* method = this.parse_function(false);
            if (method != null) {
                owner.add(method);
            }
            return;
        }

        for (mut i32 i = 0; i < lookahead; i = i + 1) {
            this.advance();
        }
        Node* field = Node.create(NodeKind.FIELD_DECL, start);
        if (this.match(TokenKind.MUT)) {
            field.set_flag(true);
        }
        field.set_type(this.parse_type());
        i32 fieldName = this.expect(TokenKind.IDENTIFIER, "expected field name");
        field.set_text(this.copy_of(fieldName));
        this.expect(TokenKind.SEMICOLON, "expected ';' after field");
        owner.add(field);
    }

    Node* parse_block() {
        i32 start = this.expect(TokenKind.LBRACE, "expected '{'");
        Node* block = Node.create_list(NodeKind.BLOCK, start);
        while (!this.check(TokenKind.RBRACE) && !this.at_end()) {
            Node* statement = this.parse_statement();
            if (statement != null) {
                block.add(statement);
            }
        }
        this.expect(TokenKind.RBRACE, "expected '}' to close block");
        return block;
    }

    Node* parse_statement() {
        i32 token = this.current();

        if (this.kind_of(token) == TokenKind.LBRACE) {
            return this.parse_block();
        }
        if (this.kind_of(token) == TokenKind.SEMICOLON) {
            this.advance();
            return (Node*)0;
        }
        if (this.kind_of(token) == TokenKind.RETURN) {
            this.advance();
            Node* ret = Node.create(NodeKind.RETURN, token);
            if (!this.check(TokenKind.SEMICOLON)) {
                ret.set_first(this.parse_expression());
            }
            this.expect(TokenKind.SEMICOLON, "expected ';' after return");
            return ret;
        }
        if (this.kind_of(token) == TokenKind.IF) {
            return this.parse_if();
        }
        if (this.kind_of(token) == TokenKind.WHILE) {
            this.advance();
            Node* loop = Node.create(NodeKind.WHILE, token);
            this.expect(TokenKind.LPAREN, "expected '(' after while");
            loop.set_first(this.parse_expression());
            this.expect(TokenKind.RPAREN, "expected ')' after condition");
            loop.set_second(this.parse_statement_or_empty());
            return loop;
        }
        if (this.kind_of(token) == TokenKind.DO) {
            this.advance();
            Node* loop = Node.create(NodeKind.DO_WHILE, token);
            loop.set_second(this.parse_statement_or_empty());
            this.expect(TokenKind.WHILE, "expected 'while' after do body");
            this.expect(TokenKind.LPAREN, "expected '(' after while");
            loop.set_first(this.parse_expression());
            this.expect(TokenKind.RPAREN, "expected ')' after condition");
            this.expect(TokenKind.SEMICOLON, "expected ';' after do-while");
            return loop;
        }
        if (this.kind_of(token) == TokenKind.FOR) {
            return this.parse_for();
        }
        if (this.kind_of(token) == TokenKind.BREAK) {
            this.advance();
            this.expect(TokenKind.SEMICOLON, "expected ';' after break");
            return Node.create(NodeKind.BREAK, token);
        }
        if (this.kind_of(token) == TokenKind.CONTINUE) {
            this.advance();
            this.expect(TokenKind.SEMICOLON, "expected ';' after continue");
            return Node.create(NodeKind.CONTINUE, token);
        }
        if (this.kind_of(token) == TokenKind.SWITCH) {
            return this.parse_switch();
        }

        if (this.is_declaration_start()) {
            Node* declaration = this.parse_variable_declaration();
            this.expect(TokenKind.SEMICOLON, "expected ';' after declaration");
            return declaration;
        }

        Node* statement = Node.create(NodeKind.EXPR_STMT, token);
        statement.set_first(this.parse_expression());
        this.expect(TokenKind.SEMICOLON, "expected ';' after expression");
        return statement;
    }

    Node* parse_switch() {
        i32 start = this.advance();
        Node* node = Node.create_list(NodeKind.SWITCH, start);
        this.expect(TokenKind.LPAREN, "expected '(' after switch");
        node.set_first(this.parse_expression());
        this.expect(TokenKind.RPAREN, "expected ')' after switch value");
        this.expect(TokenKind.LBRACE, "expected '{' to open switch");
        while (!this.check(TokenKind.RBRACE) && !this.at_end()) {
            i32 label = this.current();
            Node* arm = Node.create_list(NodeKind.CASE, label);
            if (this.match(TokenKind.CASE)) {
                arm.set_first(this.parse_expression());
            } else if (!this.match(TokenKind.DEFAULT)) {
                this.fail("expected 'case' or 'default'");
                return node;
            }
            this.expect(TokenKind.COLON, "expected ':' after case label");
            while (!this.check(TokenKind.CASE) && !this.check(TokenKind.DEFAULT) && !this.check(TokenKind.RBRACE) && !this.at_end()) {
                Node* statement = this.parse_statement();
                if (statement != null) {
                    arm.add(statement);
                }
            }
            node.add(arm);
        }
        this.expect(TokenKind.RBRACE, "expected '}' to close switch");
        return node;
    }

    Node* parse_statement_or_empty() {
        i32 token = this.current();
        Node* statement = this.parse_statement();
        if (statement == null) {
            return Node.create_list(NodeKind.BLOCK, token);
        }
        return statement;
    }

    Node* parse_variable_declaration() {
        i32 start = this.current();
        Node* declaration = Node.create(NodeKind.VAR_DECL, start);
        if (this.match(TokenKind.MUT)) {
            declaration.set_flag(true);
        }
        declaration.set_type(this.parse_type());
        if (this.match(TokenKind.MUT)) {
            declaration.set_flag(true);
        }
        i32 name = this.expect(TokenKind.IDENTIFIER, "expected variable name");
        declaration.set_text(this.copy_of(name));
        if (this.match(TokenKind.EQUAL)) {
            declaration.set_first(this.parse_expression());
        }
        return declaration;
    }

    Node* parse_if() {
        i32 start = this.advance();
        Node* node = Node.create(NodeKind.IF, start);
        this.expect(TokenKind.LPAREN, "expected '(' after if");
        node.set_first(this.parse_expression());
        this.expect(TokenKind.RPAREN, "expected ')' after condition");
        node.set_second(this.parse_statement_or_empty());
        if (this.match(TokenKind.ELSE)) {
            node.set_third(this.parse_statement_or_empty());
        }
        return node;
    }

    Node* parse_for() {
        i32 start = this.advance();
        Node* node = Node.create(NodeKind.FOR, start);
        this.expect(TokenKind.LPAREN, "expected '(' after for");

        if (!this.check(TokenKind.SEMICOLON)) {
            if (this.is_declaration_start()) {
                node.set_first(this.parse_variable_declaration());
                if (this.check(TokenKind.IN)) {
                    this.fail("range-for is not supported yet");
                    return node;
                }
            } else {
                i32 initToken = this.current();
                Node* init = Node.create(NodeKind.EXPR_STMT, initToken);
                init.set_first(this.parse_expression());
                node.set_first(init);
            }
        }
        this.expect(TokenKind.SEMICOLON, "expected ';' after for initializer");

        if (!this.check(TokenKind.SEMICOLON)) {
            node.set_second(this.parse_expression());
        }
        this.expect(TokenKind.SEMICOLON, "expected ';' after for condition");

        if (!this.check(TokenKind.RPAREN)) {
            node.set_third(this.parse_expression());
        }
        this.expect(TokenKind.RPAREN, "expected ')' after for clauses");
        node.set_fourth(this.parse_statement_or_empty());
        return node;
    }

    public Node* parse_expression() {
        return this.parse_assignment();
    }

    static i32 compound_operator(i32 kind) {
        if (kind == TokenKind.PLUS_EQUAL) { return TokenKind.PLUS; }
        if (kind == TokenKind.MINUS_EQUAL) { return TokenKind.MINUS; }
        if (kind == TokenKind.STAR_EQUAL) { return TokenKind.STAR; }
        if (kind == TokenKind.SLASH_EQUAL) { return TokenKind.SLASH; }
        if (kind == TokenKind.PERCENT_EQUAL) { return TokenKind.PERCENT; }
        if (kind == TokenKind.AMPERSAND_EQUAL) { return TokenKind.AMPERSAND; }
        if (kind == TokenKind.PIPE_EQUAL) { return TokenKind.PIPE; }
        if (kind == TokenKind.CARET_EQUAL) { return TokenKind.CARET; }
        if (kind == TokenKind.LESS_LESS_EQUAL) { return TokenKind.LESS_LESS; }
        if (kind == TokenKind.GREATER_GREATER_EQUAL) { return TokenKind.GREATER_GREATER; }
        return 0;
    }

    static i32 precedence(i32 kind) {
        if (kind == TokenKind.QUESTION_QUESTION) { return 1; }
        if (kind == TokenKind.OR_OR) { return 2; }
        if (kind == TokenKind.AND_AND) { return 3; }
        if (kind == TokenKind.PIPE) { return 4; }
        if (kind == TokenKind.CARET) { return 5; }
        if (kind == TokenKind.AMPERSAND) { return 6; }
        if (kind == TokenKind.EQUAL_EQUAL || kind == TokenKind.BANG_EQUAL) { return 7; }
        if (kind == TokenKind.LESS || kind == TokenKind.LESS_EQUAL
            || kind == TokenKind.GREATER || kind == TokenKind.GREATER_EQUAL) { return 8; }
        if (kind == TokenKind.LESS_LESS || kind == TokenKind.GREATER_GREATER) { return 9; }
        if (kind == TokenKind.PLUS || kind == TokenKind.MINUS) { return 10; }
        if (kind == TokenKind.STAR || kind == TokenKind.SLASH || kind == TokenKind.PERCENT) { return 11; }
        return 0;
    }

    Node* make_assignment(Node* target, Node* value, i32 at) {
        Node* assign = Node.create(NodeKind.ASSIGN, at);
        assign.set_first(target);
        assign.set_second(value);
        return assign;
    }

    Node* make_binary(i32 op, Node* left, Node* right, i32 at) {
        Node* binary = Node.create(NodeKind.BINARY, at);
        binary.set_op(op);
        binary.set_first(left);
        binary.set_second(right);
        return binary;
    }

    Node* make_step(Node* target, i32 op, i32 at) {
        Node* one = Node.create(NodeKind.INT_LITERAL, at);
        one.set_int_value(1);
        one.set_text("1");
        Node* sum = this.make_binary(op, target, one, at);
        return this.make_assignment(target, sum, at);
    }

    Node* parse_assignment() {
        Node* left = this.parse_binary(1);
        i32 token = this.current();

        if (this.kind_of(token) == TokenKind.EQUAL) {
            this.advance();
            Node* value = this.parse_assignment();
            return this.make_assignment(left, value, token);
        }

        i32 compound = Parser.compound_operator(this.kind_of(token));
        if (compound != 0) {
            this.advance();
            Node* rhs = this.parse_assignment();
            Node* combined = this.make_binary(compound, left, rhs, token);
            return this.make_assignment(left, combined, token);
        }
        return left;
    }

    Node* parse_binary(i32 min_precedence) {
        mut Node* left = this.parse_unary();
        while (true) {
            i32 op = this.current();
            i32 level = Parser.precedence(this.kind_of(op));
            if (level == 0 || level < min_precedence) {
                break;
            }
            this.advance();
            mut i32 next_level = level + 1;
            if (this.kind_of(op) == TokenKind.QUESTION_QUESTION) {
                next_level = level;
            }
            Node* right = this.parse_binary(next_level);
            left = this.make_binary(this.kind_of(op), left, right, op);
        }
        return left;
    }

    Node* parse_unary() {
        i32 token = this.current();
        bool isPrefix = this.kind_of(token) == TokenKind.BANG || this.kind_of(token) == TokenKind.MINUS
            || this.kind_of(token) == TokenKind.TILDE || this.kind_of(token) == TokenKind.STAR || this.kind_of(token) == TokenKind.AMPERSAND;
        if (isPrefix) {
            this.advance();
            Node* unary = Node.create(NodeKind.UNARY, token);
            unary.set_op(this.kind_of(token));
            unary.set_first(this.parse_unary());
            return unary;
        }

        if (this.kind_of(token) == TokenKind.PLUS_PLUS || this.kind_of(token) == TokenKind.MINUS_MINUS) {
            this.advance();
            Node* target = this.parse_unary();
            mut i32 op = TokenKind.PLUS;
            if (this.kind_of(token) == TokenKind.MINUS_MINUS) {
                op = TokenKind.MINUS;
            }
            return this.make_step(target, op, token);
        }

        if (this.kind_of(token) == TokenKind.AWAIT || this.kind_of(token) == TokenKind.SPAWN || this.kind_of(token) == TokenKind.TRY
            || this.kind_of(token) == TokenKind.NEW || this.kind_of(token) == TokenKind.THROW) {
            this.fail("this expression is not supported yet");
            return Node.create(NodeKind.NULL_LITERAL, token);
        }

        Node* primary = this.parse_primary();
        return this.parse_postfix(primary);
    }

    Node* parse_postfix(Node* start) {
        mut Node* expr = start;
        while (!this.failed) {
            i32 token = this.current();
            if (this.kind_of(token) == TokenKind.LPAREN) {
                this.advance();
                Node* call = Node.create_list(NodeKind.CALL, token);
                call.set_first(expr);
                if (!this.check(TokenKind.RPAREN)) {
                    call.add(this.parse_expression());
                    while (this.match(TokenKind.COMMA)) {
                        call.add(this.parse_expression());
                    }
                }
                this.expect(TokenKind.RPAREN, "expected ')' after arguments");
                expr = call;
            } else if (this.kind_of(token) == TokenKind.LBRACKET) {
                this.advance();
                Node* index = Node.create(NodeKind.INDEX, token);
                index.set_first(expr);
                index.set_second(this.parse_expression());
                this.expect(TokenKind.RBRACKET, "expected ']' after index");
                expr = index;
            } else if (this.kind_of(token) == TokenKind.DOT) {
                this.advance();
                Node* access = Node.create(NodeKind.FIELD_ACCESS, token);
                access.set_first(expr);
                i32 member = this.expect(TokenKind.IDENTIFIER, "expected member name after '.'");
                access.set_text(this.copy_of(member));
                expr = access;
            } else if (this.kind_of(token) == TokenKind.PLUS_PLUS) {
                this.advance();
                expr = this.make_step(expr, TokenKind.PLUS, token);
            } else if (this.kind_of(token) == TokenKind.MINUS_MINUS) {
                this.advance();
                expr = this.make_step(expr, TokenKind.MINUS, token);
            } else {
                break;
            }
        }
        return expr;
    }

    Node* parse_primary() {
        i32 token = this.current();

        if (this.kind_of(token) == TokenKind.INTEGER_LITERAL) {
            this.advance();
            Node* literal = Node.create(NodeKind.INT_LITERAL, token);
            literal.set_text(this.copy_of(token));
            literal.set_int_value(Strings.parse_integer(this.text_of(token), this.length_of(token)));
            return literal;
        }
        if (this.kind_of(token) == TokenKind.FLOAT_LITERAL) {
            this.advance();
            Node* literal = Node.create(NodeKind.FLOAT_LITERAL, token);
            literal.set_text(this.copy_of(token));
            return literal;
        }
        if (this.kind_of(token) == TokenKind.STRING_LITERAL) {
            this.advance();
            Node* literal = Node.create(NodeKind.STRING_LITERAL, token);
            literal.set_text_n(this.text_of(token), this.length_of(token));
            literal.set_int_value(this.length_of(token));
            return literal;
        }
        if (this.kind_of(token) == TokenKind.TRUE || this.kind_of(token) == TokenKind.FALSE) {
            this.advance();
            Node* literal = Node.create(NodeKind.BOOL_LITERAL, token);
            if (this.kind_of(token) == TokenKind.TRUE) {
                literal.set_int_value(1);
            }
            return literal;
        }
        if (this.kind_of(token) == TokenKind.NULL) {
            this.advance();
            return Node.create(NodeKind.NULL_LITERAL, token);
        }
        if (this.kind_of(token) == TokenKind.THIS) {
            this.advance();
            Node* self = Node.create(NodeKind.IDENTIFIER, token);
            self.set_text("this");
            return self;
        }

        if (this.kind_of(token) == TokenKind.IDENTIFIER) {
            bool isSizeof = this.atom_of(token) == Atoms.SIZEOF_ATOM
                && this.kind_of(this.peek_token(1)) == TokenKind.LPAREN;
            if (isSizeof) {
                this.advance();
                this.advance();
                Node* size_node = Node.create(NodeKind.SIZEOF, token);
                size_node.set_type(this.parse_type());
                this.expect(TokenKind.RPAREN, "expected ')' after sizeof type");
                return size_node;
            }

            Node* identifier = Node.create(NodeKind.IDENTIFIER, token);
            identifier.set_text(this.qualified_name());
            return identifier;
        }

        if (this.kind_of(token) == TokenKind.LPAREN) {
            i32 typeEnd = this.scan_type_end(1);
            bool isCast = typeEnd > 0 && this.kind_of(this.peek_token(typeEnd)) == TokenKind.RPAREN;
            this.advance();
            if (isCast) {
                Node* cast = Node.create(NodeKind.CAST, token);
                cast.set_type(this.parse_type());
                this.expect(TokenKind.RPAREN, "expected ')' after cast type");
                cast.set_first(this.parse_unary());
                return cast;
            }
            Node* inner = this.parse_expression();
            this.expect(TokenKind.RPAREN, "expected ')'");
            return inner;
        }

        this.fail("expected an expression");
        return Node.create(NodeKind.NULL_LITERAL, token);
    }
}
