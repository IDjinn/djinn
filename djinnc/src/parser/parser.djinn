namespace djinnc;

struct Parser {
    TokenList* tokens;
    i32 pos;
    i32 end;
    bool failed;
    bool scan_half;
    bool half_greater;
    i32 hidden_count;
    PointerList* extra_declarations;
    Diagnostics* diagnostics;
    U32Map* type_names;

    public static Parser* create(TokenList* tokens, SourceFile* file, Diagnostics* diagnostics, U32Map* type_names) {
        Parser* parser = (Parser*)Memory.zalloc(sizeof(Parser));
        parser.tokens = tokens;
        parser.pos = file.first_token;
        parser.end = file.token_end;
        parser.diagnostics = diagnostics;
        parser.type_names = type_names;
        return parser;
    }

    public static void collect_type_names(TokenList* list, SourceFile* file, U32Map* names) {
        for (mut i32 i = file.first_token; i + 1 < file.token_end; i = i + 1) {
            i32 kind = list.kind(i);
            bool endsType = kind == TokenKind.IDENTIFIER || kind == TokenKind.STAR || kind == TokenKind.GREATER || kind == TokenKind.VOID;
            if (endsType && i + 3 < file.token_end && list.kind(i + 1) == TokenKind.IDENTIFIER
                && list.kind(i + 2) == TokenKind.LESS && list.kind(i + 3) == TokenKind.IDENTIFIER) {
                mut i32 scan = i + 3;
                while (scan + 1 < file.token_end && list.kind(scan) == TokenKind.IDENTIFIER && list.kind(scan + 1) == TokenKind.COMMA) {
                    scan = scan + 2;
                }
                if (scan + 2 < file.token_end && list.kind(scan) == TokenKind.IDENTIFIER
                    && list.kind(scan + 1) == TokenKind.GREATER && list.kind(scan + 2) == TokenKind.LPAREN) {
                    mut i32 cursor = i + 3;
                    while (cursor <= scan) {
                        if (list.kind(cursor) == TokenKind.IDENTIFIER) {
                            names.put(list.atom(cursor), 1);
                        }
                        cursor = cursor + 1;
                    }
                }
            }
            bool declaresType = kind == TokenKind.STRUCT || kind == TokenKind.ENUM || kind == TokenKind.INTERFACE;
            if (declaresType && list.kind(i + 1) == TokenKind.IDENTIFIER) {
                names.put(list.atom(i + 1), 1);
                if (list.kind(i + 2) == TokenKind.LESS) {
                    mut i32 cursor = i + 3;
                    while (cursor < file.token_end && list.kind(cursor) == TokenKind.IDENTIFIER) {
                        names.put(list.atom(cursor), 1);
                        cursor = cursor + 1;
                        if (list.kind(cursor) == TokenKind.COMMA) {
                            cursor = cursor + 1;
                        }
                    }
                }
            }
        }
    }

    i32 kind_of(i32 token) {
        TokenList* list = this.tokens;
        return list.kind(token);
    }

    i8* text_of(i32 token) {
        TokenList* list = this.tokens;
        return list.text(token);
    }

    i32 length_of(i32 token) {
        TokenList* list = this.tokens;
        return list.text_length(token);
    }

    i32 line_of(i32 token) {
        TokenList* list = this.tokens;
        return list.line(token);
    }

    i32 column_of(i32 token) {
        TokenList* list = this.tokens;
        return list.column(token);
    }

    i8* copy_of(i32 token) {
        TokenList* list = this.tokens;
        return list.copy_text(token);
    }

    u32 atom_of(i32 token) {
        TokenList* list = this.tokens;
        return list.atom(token);
    }

    void add_declaration(Node* container, Node* declaration) {
        if (declaration != null) {
            container.add(declaration);
        }
        PointerList* extra = this.extra_declarations;
        if (extra == null) {
            return;
        }
        for (mut i32 i = 0; i < extra.length; i = i + 1) {
            container.add((Node*)extra.get(i));
        }
        extra.length = 0;
    }

    public Node* parse_program() {
        i32 first = this.current();
        Node* program = Node.create_list(NodeKind.PROGRAM, first);
        while (!this.at_end()) {
            this.add_declaration(program, this.parse_declaration());
        }
        return program;
    }

    i32 current() {
        return this.peek_token(0);
    }

    i32 peek_token(i32 offset) {
        mut i32 index = this.pos + offset;
        if (index >= this.end) {
            index = this.end - 1;
        }
        return index;
    }

    bool at_end() {
        i32 token = this.current();
        return this.failed || this.kind_of(token) == TokenKind.END_OF_FILE;
    }

    i32 advance() {
        i32 token = this.current();
        if (this.kind_of(token) != TokenKind.END_OF_FILE) {
            this.pos = this.pos + 1;
        }
        return token;
    }

    bool check(i32 kind) {
        i32 token = this.current();
        return this.kind_of(token) == kind;
    }

    bool match(i32 kind) {
        if (this.check(kind)) {
            this.advance();
            return true;
        }
        return false;
    }

    void fail(i8* message) {
        if (this.failed) {
            return;
        }
        i32 token = this.current();
        Diagnostics* diagnostics = this.diagnostics;
        mut i8* found = this.copy_of(token);
        if (this.kind_of(token) == TokenKind.END_OF_FILE) {
            found = "end of file";
        }
        diagnostics.error_near(this.line_of(token), this.column_of(token), message, found);
        this.failed = true;
    }

    i32 expect(i32 kind, i8* message) {
        i32 token = this.current();
        if (this.kind_of(token) != kind) {
            this.fail(message);
            return token;
        }
        return this.advance();
    }

    bool is_known_type(i32 token) {
        U32Map* names = this.type_names;
        return names.contains(this.atom_of(token));
    }

    bool is_type_start(i32 token) {
        i32 kind = this.kind_of(token);
        if (kind == TokenKind.VOID || kind == TokenKind.AUTO) {
            return true;
        }
        if (kind != TokenKind.IDENTIFIER) {
            return false;
        }
        TypeRef* primitive = TypeRef.from_primitive_atom(this.atom_of(token));
        if (primitive != null) {
            return true;
        }
        return this.is_known_type(token);
    }

    i32 scan_type_end(i32 start) {
        i32 end = this.scan_type_inner(start);
        if (this.scan_half) {
            this.scan_half = false;
            return 0 - 1;
        }
        return end;
    }

    i32 scan_type_inner(i32 start) {
        mut i32 offset = start;
        i32 first = this.peek_token(offset);
        if (!this.is_type_start(first)) {
            return 0 - 1;
        }
        offset = offset + 1;
        while (true) {
            i32 separator = this.peek_token(offset);
            i32 part = this.peek_token(offset + 1);
            if (this.kind_of(separator) == TokenKind.COLON_COLON && this.kind_of(part) == TokenKind.IDENTIFIER) {
                offset = offset + 2;
            } else {
                break;
            }
        }
        if (this.kind_of(this.peek_token(offset)) == TokenKind.LESS) {
            offset = this.scan_type_arguments(offset);
            if (offset < 0) {
                return offset;
            }
        }
        while (this.kind_of(this.peek_token(offset)) == TokenKind.STAR) {
            offset = offset + 1;
        }
        while (this.kind_of(this.peek_token(offset)) == TokenKind.LBRACKET && this.kind_of(this.peek_token(offset + 1)) == TokenKind.RBRACKET) {
            offset = offset + 2;
        }
        if (this.kind_of(this.peek_token(offset)) == TokenKind.QUESTION) {
            offset = offset + 1;
        }
        return offset;
    }

    i32 scan_type_arguments(i32 start) {
        mut i32 offset = start + 1;
        while (true) {
            i32 end = this.scan_type_inner(offset);
            if (end < 0) {
                return end;
            }
            offset = end;
            if (this.scan_half) {
                this.scan_half = false;
                return offset;
            }
            i32 kind = this.kind_of(this.peek_token(offset));
            if (kind == TokenKind.COMMA) {
                offset = offset + 1;
            } else if (kind == TokenKind.GREATER) {
                return offset + 1;
            } else if (kind == TokenKind.GREATER_GREATER) {
                this.scan_half = true;
                return offset + 1;
            } else {
                return 0 - 1;
            }
        }
        return 0 - 1;
    }

    bool scan_generic_head(i32 less) {
        mut i32 offset = less + 1;
        while (this.kind_of(this.peek_token(offset)) == TokenKind.IDENTIFIER) {
            offset = offset + 1;
            if (this.kind_of(this.peek_token(offset)) == TokenKind.COMMA) {
                offset = offset + 1;
            }
        }
        return this.kind_of(this.peek_token(offset)) == TokenKind.GREATER
            && this.kind_of(this.peek_token(offset + 1)) == TokenKind.LPAREN;
    }

    bool is_declaration_start() {
        if (this.check(TokenKind.MUT)) {
            return true;
        }
        i32 end = this.scan_type_end(0);
        if (end < 0) {
            return false;
        }
        i32 after = this.peek_token(end);
        return this.kind_of(after) == TokenKind.IDENTIFIER || this.kind_of(after) == TokenKind.MUT;
    }

    i8* qualified_name() {
        i32 first = this.expect(TokenKind.IDENTIFIER, "expected identifier");
        ByteBuffer* name = ByteBuffer.create();
        name.append_slice(this.text_of(first), this.length_of(first));
        while (this.check(TokenKind.COLON_COLON)) {
            this.advance();
            i32 part = this.expect(TokenKind.IDENTIFIER, "expected identifier after '::'");
            name.append("::");
            name.append_slice(this.text_of(part), this.length_of(part));
        }
        return name.cstr();
    }

    void skip_attributes() {
        while (this.check(TokenKind.LBRACKET) && !this.failed) {
            mut i32 depth = 0;
            while (!this.at_end()) {
                i32 token = this.advance();
                if (this.kind_of(token) == TokenKind.LBRACKET) {
                    depth = depth + 1;
                } else if (this.kind_of(token) == TokenKind.RBRACKET) {
                    depth = depth - 1;
                    if (depth == 0) {
                        break;
                    }
                }
            }
        }
    }

    PointerList* parse_type_arguments() {
        this.expect(TokenKind.LESS, "expected '<'");
        PointerList* args = PointerList.create();
        while (!this.failed) {
            args.push((void*)this.parse_type());
            if (this.half_greater) {
                this.half_greater = false;
                return args;
            }
            if (this.match(TokenKind.COMMA)) {
                continue;
            }
            if (this.match(TokenKind.GREATER)) {
                return args;
            }
            if (this.match(TokenKind.GREATER_GREATER)) {
                this.half_greater = true;
                return args;
            }
            this.fail("expected '>' after type arguments");
        }
        return args;
    }

    GenericParams* parse_generic_params() {
        GenericParams* params = GenericParams.create();
        IdList* names = params.names;
        this.expect(TokenKind.LESS, "expected '<'");
        while (!this.failed) {
            i32 token = this.expect(TokenKind.IDENTIFIER, "expected a type parameter name");
            names.push(this.atom_of(token));
            if (this.match(TokenKind.COMMA)) {
                continue;
            }
            this.expect(TokenKind.GREATER, "expected '>' after type parameters");
            break;
        }
        return params;
    }

    void parse_where_clauses(GenericParams* params) {
        while (this.match(TokenKind.WHERE)) {
            i32 token = this.expect(TokenKind.IDENTIFIER, "expected a type parameter after 'where'");
            i32 owner = params.index_of(this.atom_of(token));
            if (owner < 0) {
                this.fail("'where' names an unknown type parameter");
                return;
            }
            this.expect(TokenKind.COLON, "expected ':' after the constrained type parameter");
            params.add_bound(owner, this.parse_type());
            while (this.match(TokenKind.COMMA)) {
                params.add_bound(owner, this.parse_type());
            }
            if (this.check(TokenKind.SEMICOLON) && this.kind_of(this.peek_token(1)) == TokenKind.WHERE) {
                this.advance();
            }
        }
    }

    TypeRef* parse_type() {
        i32 token = this.current();
        mut TypeRef* base = (TypeRef*)0;

        if (this.kind_of(token) == TokenKind.VOID || this.kind_of(token) == TokenKind.AUTO) {
            this.advance();
            base = TypeRef.from_primitive_atom(this.atom_of(token));
        } else if (this.kind_of(token) == TokenKind.IDENTIFIER) {
            TypeRef* primitive = TypeRef.from_primitive_atom(this.atom_of(token));
            if (primitive != null) {
                this.advance();
                base = primitive;
            } else {
                base = TypeRef.named(this.qualified_name());
            }
        } else {
            this.fail("expected a type");
            return TypeRef.create(TypeKind.VOID);
        }

        if (this.check(TokenKind.LESS) && base.kind == TypeKind.NAMED) {
            base.args = this.parse_type_arguments();
        }

        while (this.match(TokenKind.STAR)) {
            base = TypeRef.pointer_to(base);
        }

        while (this.check(TokenKind.LBRACKET) && this.kind_of(this.peek_token(1)) == TokenKind.RBRACKET) {
            this.advance();
            this.advance();
            TypeRef* array = TypeRef.named("arr");
            PointerList* element = PointerList.create();
            element.push((void*)base);
            array.args = element;
            base = array;
        }

        if (this.match(TokenKind.QUESTION)) {
            base.nullable = true;
        }
        return base;
    }

    PointerList* parse_attributes() {
        PointerList* found = PointerList.create();
        while (this.check(TokenKind.LBRACKET) && !this.failed) {
            this.advance();
            while (!this.check(TokenKind.RBRACKET) && !this.at_end()) {
                i32 name = this.expect(TokenKind.IDENTIFIER, "expected an attribute name");
                AttributeUse* use = (AttributeUse*)Memory.zalloc(sizeof(AttributeUse));
                use.name = this.copy_of(name);
                use.line = this.line_of(name);
                use.column = this.column_of(name);
                if (this.match(TokenKind.LPAREN)) {
                    while (!this.check(TokenKind.RPAREN) && !this.at_end()) {
                        i32 argument = this.advance();
                        if (this.kind_of(argument) == TokenKind.INTEGER_LITERAL) {
                            use.int_arg = Strings.parse_integer(this.text_of(argument), this.length_of(argument));
                        } else if (this.kind_of(argument) == TokenKind.STRING_LITERAL) {
                            use.text_arg = this.copy_of(argument);
                        }
                    }
                    this.expect(TokenKind.RPAREN, "expected ')' after the attribute arguments");
                }
                found.push((void*)use);
                if (!this.match(TokenKind.COMMA)) {
                    break;
                }
            }
            this.expect(TokenKind.RBRACKET, "expected ']' after the attribute");
        }
        return found;
    }

    void attach_attributes(PointerList* found, Node* target, i32 target_kind) {
        Diagnostics* diagnostics = this.diagnostics;
        for (mut i32 i = 0; i < found.length; i = i + 1) {
            AttributeUse* use = (AttributeUse*)found.get(i);
            use.target = target;
            use.target_kind = target_kind;
            i32 allowed = Attributes.allowed_targets(use.name);
            if (allowed == 0) {
                ByteBuffer* message = ByteBuffer.create();
                message.append("unknown attribute '");
                message.append(use.name);
                message.append("'");
                diagnostics.error(use.line, use.column, message.cstr());
                continue;
            }
            if (target != null && (allowed & target_kind) == 0) {
                ByteBuffer* message = ByteBuffer.create();
                message.append("attribute '");
                message.append(use.name);
                message.append("' is not valid on ");
                message.append(Attributes.target_name(target_kind));
                diagnostics.warning(use.line, use.column, message.cstr());
            }
            if (target != null) {
                Attributes.record(use);
            }
        }
    }

    void parse_member(Node* owner) {
        PointerList* found = this.parse_attributes();
        i32 before = owner.count();
        this.parse_struct_member(owner);
        if (found.length == 0) {
            return;
        }
        if (owner.count() <= before) {
            this.attach_attributes(found, null, AttributeTarget.OTHER);
            return;
        }
        Node* member = owner.child(before);
        mut i32 target_kind = AttributeTarget.OTHER;
        if (member.kind == NodeKind.FUNCTION) {
            target_kind = AttributeTarget.METHOD;
        } else if (member.kind == NodeKind.FIELD_DECL) {
            target_kind = AttributeTarget.FIELD;
        }
        this.attach_attributes(found, member, target_kind);
    }

    Node* parse_declaration() {
        PointerList* attributes = this.parse_attributes();
        Node* declaration = this.parse_declaration_body();
        if (attributes.length > 0) {
            mut i32 target_kind = AttributeTarget.OTHER;
            if (declaration != null && declaration.kind == NodeKind.STRUCT_DECL) {
                target_kind = AttributeTarget.STRUCT;
            } else if (declaration != null && declaration.kind == NodeKind.FUNCTION) {
                target_kind = AttributeTarget.FUNCTION;
            }
            this.attach_attributes(attributes, declaration, target_kind);
        }
        return declaration;
    }

    bool is_word(i32 token, i8* word) {
        return Strings.equals(this.text_of(token), this.length_of(token), word);
    }

    Node* parse_macro_declaration() {
        this.advance();
        i32 name = this.expect(TokenKind.IDENTIFIER, "expected the macro name");
        MacroInfo* info = Macros.declare(this.atom_of(name), this.copy_of(name));
        this.expect(TokenKind.LBRACE, "expected '{' to open the macro");
        while (!this.check(TokenKind.RBRACE) && !this.at_end()) {
            this.parse_macro_rule(info, name);
        }
        this.expect(TokenKind.RBRACE, "expected '}' to close the macro");
        return null;
    }

    void parse_macro_rule(MacroInfo* info, i32 name_token) {
        MacroRule* rule = (MacroRule*)Memory.zalloc(sizeof(MacroRule));
        rule.params = PointerList.create();
        PointerList* params = rule.params;
        mut bool rule_local = false;
        if (this.is_word(this.current(), "local") && this.kind_of(this.peek_token(1)) == TokenKind.LPAREN) {
            this.advance();
            rule_local = true;
        }
        this.expect(TokenKind.LPAREN, "expected '(' to open the macro rule");
        while (!this.check(TokenKind.RPAREN) && !this.at_end()) {
            MacroParam* param = (MacroParam*)Memory.zalloc(sizeof(MacroParam));
            mut bool local = rule_local;
            if (this.is_word(this.current(), "local") && this.kind_of(this.peek_token(1)) == TokenKind.IDENTIFIER
                && this.kind_of(this.peek_token(2)) == TokenKind.IDENTIFIER) {
                this.advance();
                local = true;
            }
            i32 word = this.advance();
            bool followedByName = this.kind_of(this.current()) == TokenKind.IDENTIFIER;
            mut i32 kind = MacroParamKind.TOKEN;
            if (followedByName && this.is_word(word, "expression")) {
                kind = MacroParamKind.EXPRESSION;
            } else if (followedByName && this.is_word(word, "identifier")) {
                kind = MacroParamKind.IDENTIFIER;
            } else if (followedByName && this.is_word(word, "literal")) {
                kind = MacroParamKind.LITERAL;
            } else if (followedByName && this.is_word(word, "type")) {
                kind = MacroParamKind.TYPE;
            }
            param.kind = kind;
            if (kind == MacroParamKind.TOKEN) {
                param.name = this.copy_of(word);
                param.name_atom = this.atom_of(word);
            } else {
                i32 parameter_name = this.advance();
                param.name = this.copy_of(parameter_name);
                param.name_atom = Ast.intern_base_name(param.name, this.length_of(parameter_name));
            }
            param.is_local = local && kind == MacroParamKind.EXPRESSION;
            params.push((void*)param);
            if (!this.match(TokenKind.COMMA)) {
                break;
            }
        }
        this.expect(TokenKind.RPAREN, "expected ')' to close the macro rule parameters");
        this.expect(TokenKind.ARROW, "expected '=>' after the macro rule parameters");
        if (this.match(TokenKind.VOID)) {
            rule.body = null;
        } else {
            this.expect(TokenKind.LBRACE, "expected '{' to open the macro body");
            rule.body = this.parse_expression();
            this.match(TokenKind.SEMICOLON);
            this.expect(TokenKind.RBRACE, "expected '}' to close the macro body");
        }

        PointerList* rules = info.rules;
        for (mut i32 i = 0; i < rules.length; i = i + 1) {
            MacroRule* previous = (MacroRule*)rules.get(i);
            if (Macros.same_signature(previous, rule)) {
                ByteBuffer* message = ByteBuffer.create();
                message.append("macro '");
                message.append(info.name);
                message.append("' rule ");
                message.append_int(rules.length + 1);
                message.append(" has the same signature as rule ");
                message.append_int(i + 1);
                Diagnostics* diagnostics = this.diagnostics;
                diagnostics.error(this.line_of(name_token), this.column_of(name_token), message.cstr());
                this.failed = true;
            }
        }
        rules.push((void*)rule);
    }

    bool macro_param_matches(MacroParam* param, i32 start, i32 end) {
        if (end - start <= 0) {
            return false;
        }
        i32 kind = this.kind_of(start);
        bool single = end - start == 1;
        if (param.kind == MacroParamKind.TOKEN) {
            return single && kind == TokenKind.IDENTIFIER && this.atom_of(start) == param.name_atom;
        }
        if (param.kind == MacroParamKind.IDENTIFIER) {
            return single && kind == TokenKind.IDENTIFIER;
        }
        if (param.kind == MacroParamKind.LITERAL) {
            return single && (kind == TokenKind.INTEGER_LITERAL || kind == TokenKind.FLOAT_LITERAL
                || kind == TokenKind.STRING_LITERAL || kind == TokenKind.TRUE || kind == TokenKind.FALSE);
        }
        if (param.kind == MacroParamKind.TYPE) {
            return this.is_type_start(start);
        }
        return true;
    }

    Node* expand_macro(i32 name_token, MacroInfo* info) {
        this.advance();
        this.advance();
        IdList* starts = IdList.create();
        IdList* ends = IdList.create();
        mut i32 depth = 0;
        mut i32 argument_start = this.pos;
        if (!this.check(TokenKind.RPAREN)) {
            while (!this.at_end()) {
                i32 token = this.current();
                i32 kind = this.kind_of(token);
                if (kind == TokenKind.LPAREN || kind == TokenKind.LBRACKET || kind == TokenKind.LBRACE) {
                    depth = depth + 1;
                } else if (kind == TokenKind.RPAREN || kind == TokenKind.RBRACKET || kind == TokenKind.RBRACE) {
                    if (depth == 0) {
                        break;
                    }
                    depth = depth - 1;
                } else if (kind == TokenKind.COMMA && depth == 0) {
                    starts.push((u32)argument_start);
                    ends.push((u32)this.pos);
                    this.advance();
                    argument_start = this.pos;
                    continue;
                }
                this.advance();
            }
            starts.push((u32)argument_start);
            ends.push((u32)this.pos);
        }
        this.expect(TokenKind.RPAREN, "expected ')' after the macro arguments");
        i32 resume = this.pos;

        mut MacroRule* chosen = (MacroRule*)0;
        PointerList* rules = info.rules;
        for (mut i32 r = 0; r < rules.length && chosen == null; r = r + 1) {
            MacroRule* candidate = (MacroRule*)rules.get(r);
            PointerList* candidate_params = candidate.params;
            if (candidate_params.length != starts.length) {
                continue;
            }
            mut bool fits = true;
            for (mut i32 p = 0; p < candidate_params.length; p = p + 1) {
                MacroParam* param = (MacroParam*)candidate_params.get(p);
                if (!this.macro_param_matches(param, (i32)starts.get(p), (i32)ends.get(p))) {
                    fits = false;
                    break;
                }
            }
            if (fits) {
                chosen = candidate;
            }
        }
        if (chosen == null) {
            Diagnostics* diagnostics = this.diagnostics;
            ByteBuffer* message = ByteBuffer.create();
            message.append("no rule of macro '");
            message.append(info.name);
            message.append("' matches these arguments");
            diagnostics.error(this.line_of(name_token), this.column_of(name_token), message.cstr());
            this.failed = true;
            return Node.create(NodeKind.NULL_LITERAL, name_token);
        }

        PointerList* chosen_params = chosen.params;
        PointerList* bindings = PointerList.create();
        mut Node* scope_node = (Node*)0;
        for (mut i32 p = 0; p < chosen_params.length; p = p + 1) {
            MacroParam* param = (MacroParam*)chosen_params.get(p);
            if (param.kind == MacroParamKind.TOKEN) {
                continue;
            }
            i32 start = (i32)starts.get(p);
            i32 end = (i32)ends.get(p);
            this.pos = start;
            mut Node* argument = (Node*)0;
            if (param.kind == MacroParamKind.TYPE) {
                this.parse_type();
            } else if (param.kind == MacroParamKind.IDENTIFIER) {
                argument = Node.create(NodeKind.IDENTIFIER, start);
                argument.set_text(this.copy_of(start));
                this.advance();
            } else {
                argument = this.parse_expression();
            }
            if (this.pos != end && !this.failed) {
                this.fail("invalid macro argument");
            }
            if (param.kind == MacroParamKind.TYPE) {
                continue;
            }
            MacroBinding* binding = (MacroBinding*)Memory.zalloc(sizeof(MacroBinding));
            binding.name_atom = param.name_atom;
            binding.name = param.name;
            binding.node = argument;
            binding.is_local = param.is_local;
            binding.warn = param.kind == MacroParamKind.EXPRESSION && !param.is_local;
            if (param.is_local) {
                binding.temp = Macros.unique_name(param.name);
                if (scope_node == null) {
                    scope_node = Node.create_list(NodeKind.LET_EXPR, name_token);
                }
                Node* item = Node.create(NodeKind.FIELD_DECL, name_token);
                item.set_text(binding.temp);
                item.set_first(argument);
                scope_node.add(item);
            }
            bindings.push((void*)binding);
        }
        this.pos = resume;

        mut Node* result = (Node*)0;
        if (chosen.body == null) {
            result = Node.create(NodeKind.INT_LITERAL, name_token);
            result.set_int_value(0);
        } else {
            result = Macros.replace(Node.clone(chosen.body), bindings);
        }

        Diagnostics* warnings = this.diagnostics;
        for (mut i32 b = 0; b < bindings.length; b = b + 1) {
            MacroBinding* binding = (MacroBinding*)bindings.get(b);
            if (binding.warn && binding.uses > 1) {
                ByteBuffer* message = ByteBuffer.create();
                message.append("macro parameter '");
                message.append(binding.name);
                message.append("' is used ");
                message.append_int(binding.uses);
                message.append(" times without 'local', which may cause side effects");
                warnings.warning(this.line_of(name_token), this.column_of(name_token), message.cstr());
            }
        }
        if (scope_node != null) {
            scope_node.set_first(result);
            return scope_node;
        }
        return result;
    }

    Node* parse_declaration_body() {
        i32 token = this.current();

        if (this.kind_of(token) == TokenKind.IMPORT) {
            this.advance();
            Node* import_node = Node.create(NodeKind.IMPORT, token);
            import_node.set_text(this.qualified_name());
            this.expect(TokenKind.SEMICOLON, "expected ';' after import");
            return import_node;
        }

        if (this.kind_of(token) == TokenKind.NAMESPACE) {
            return this.parse_namespace();
        }

        if (this.kind_of(token) == TokenKind.EXTERN) {
            return this.parse_extern();
        }

        if (this.kind_of(token) == TokenKind.STRUCT) {
            return this.parse_struct();
        }

        if (this.kind_of(token) == TokenKind.ENUM) {
            return this.parse_enum();
        }

        if (this.kind_of(token) == TokenKind.UNSAFE || this.kind_of(token) == TokenKind.STATIC) {
            return this.parse_static_var();
        }

        if (this.kind_of(token) == TokenKind.INTERFACE) {
            return this.parse_interface();
        }

        if (this.kind_of(token) == TokenKind.IMPL) {
            return this.parse_impl();
        }

        if (this.kind_of(token) == TokenKind.MACRO) {
            return this.parse_macro_declaration();
        }

        return this.parse_function(false);
    }

    Node* parse_namespace() {
        i32 start = this.advance();
        Node* node = Node.create_list(NodeKind.NAMESPACE_DECL, start);
        node.set_text(this.qualified_name());
        if (this.match(TokenKind.SEMICOLON)) {
            while (!this.at_end()) {
                this.add_declaration(node, this.parse_declaration());
            }
            return node;
        }

        this.expect(TokenKind.LBRACE, "expected ';' or '{' after namespace name");
        while (!this.check(TokenKind.RBRACE) && !this.at_end()) {
            this.add_declaration(node, this.parse_declaration());
        }
        this.expect(TokenKind.RBRACE, "expected '}' to close namespace");
        return node;
    }

    Node* parse_extern() {
        i32 start = this.advance();
        Node* group = Node.create_list(NodeKind.NAMESPACE_DECL, start);
        group.set_text("");
        group.set_flag(true);

        if (this.check(TokenKind.STRING_LITERAL)) {
            this.advance();
        }

        if (this.match(TokenKind.LBRACE)) {
            while (!this.check(TokenKind.RBRACE) && !this.at_end()) {
                this.skip_attributes();
                group.add(this.parse_extern_function());
            }
            this.expect(TokenKind.RBRACE, "expected '}' to close extern block");
            return group;
        }

        group.add(this.parse_extern_function());
        return group;
    }

    Node* parse_extern_function() {
        i32 start = this.current();
        Node* node = Node.create_list(NodeKind.EXTERN_FUNCTION, start);
        node.set_type(this.parse_type());
        i32 name = this.expect(TokenKind.IDENTIFIER, "expected extern function name");
        node.set_text(this.copy_of(name));
        this.expect(TokenKind.LPAREN, "expected '(' after function name");
        this.parse_parameters(node);
        this.expect(TokenKind.RPAREN, "expected ')' after parameters");
        this.expect(TokenKind.SEMICOLON, "expected ';' after extern function");
        return node;
    }

    void parse_parameters(Node* owner) {
        if (this.check(TokenKind.RPAREN)) {
            return;
        }
        while (!this.at_end()) {
            if (this.check(TokenKind.DOT_DOT_DOT)) {
                this.advance();
                owner.set_variadic(true);
                if (this.check(TokenKind.IDENTIFIER)) {
                    this.advance();
                }
                break;
            }

            i32 start = this.current();
            Node* parameter = Node.create(NodeKind.PARAMETER, start);
            if (this.match(TokenKind.MUT)) {
                parameter.set_flag(true);
            }
            parameter.set_type(this.parse_type());
            i32 name = this.expect(TokenKind.IDENTIFIER, "expected parameter name");
            parameter.set_text(this.copy_of(name));
            if (this.match(TokenKind.MUT)) {
                parameter.set_flag(true);
            }
            owner.add(parameter);

            if (!this.match(TokenKind.COMMA)) {
                break;
            }
        }
    }

    Node* parse_function(bool allowConstructor) {
        mut bool is_static = false;
        mut bool is_async = false;
        while (this.check(TokenKind.PUBLIC) || this.check(TokenKind.PRIVATE) || this.check(TokenKind.STATIC) || this.check(TokenKind.ASYNC)) {
            i32 modifier = this.advance();
            if (this.kind_of(modifier) == TokenKind.STATIC) {
                is_static = true;
            }
            if (this.kind_of(modifier) == TokenKind.ASYNC) {
                is_async = true;
            }
        }

        if (this.check(TokenKind.CONSTEXPR) || this.check(TokenKind.CONSTEVAL)) {
            this.fail("constexpr and consteval functions are not supported yet");
            return null;
        }

        i32 start = this.current();
        Node* function = Node.create_list(NodeKind.FUNCTION, start);
        function.set_flag(is_static);
        if (is_async) {
            function.set_op(1);
        }
        function.set_type(this.parse_type());
        i32 name = this.expect(TokenKind.IDENTIFIER, "expected function name");
        function.set_text(this.copy_of(name));
        if (this.check(TokenKind.LESS)) {
            function.set_generics(this.parse_generic_params());
        }
        this.expect(TokenKind.LPAREN, "expected '(' after function name");
        this.parse_parameters(function);
        this.expect(TokenKind.RPAREN, "expected ')' after parameters");
        if (this.check(TokenKind.WHERE)) {
            GenericParams* constraints = function.generics();
            if (constraints == null) {
                this.fail("'where' needs a generic function");
                return function;
            }
            this.parse_where_clauses(constraints);
        }

        if (this.check(TokenKind.THROWS) || this.check(TokenKind.REQUIRE) || this.check(TokenKind.ENSURE)) {
            this.fail("throws and contracts are not supported yet");
            return function;
        }

        if (this.match(TokenKind.ARROW)) {
            i32 arrow = this.current();
            Node* body = Node.create_list(NodeKind.BLOCK, arrow);
            Node* ret = Node.create(NodeKind.RETURN, arrow);
            ret.set_first(this.parse_expression());
            body.add(ret);
            this.expect(TokenKind.SEMICOLON, "expected ';' after expression body");
            function.set_first(body);
            return function;
        }

        function.set_first(this.parse_block());
        return function;
    }

    Node* parse_operator(bool with_body) {
        i32 start = this.advance();
        Node* function = Node.create_list(NodeKind.FUNCTION, start);
        function.set_flag(true);
        i32 symbol = this.advance();
        ByteBuffer* name = ByteBuffer.create();
        name.append("operator");
        name.append(TokenKind.text(this.kind_of(symbol)));
        function.set_text(name.cstr());
        this.expect(TokenKind.LPAREN, "expected '(' after the operator");
        this.parse_parameters(function);
        this.expect(TokenKind.RPAREN, "expected ')' after parameters");
        this.expect(TokenKind.THIN_ARROW, "expected '->' and the return type of the operator");
        function.set_type(this.parse_type());
        if (with_body) {
            function.set_first(this.parse_block());
        } else {
            this.expect(TokenKind.SEMICOLON, "expected ';' after the operator signature");
        }
        return function;
    }

    Node* parse_static_var() {
        i32 start = this.current();
        bool has_unsafe = this.match(TokenKind.UNSAFE);
        Node* node = Node.create(NodeKind.STATIC_VAR, start);
        i32 after_static = this.peek_token(1);
        if (!has_unsafe && this.kind_of(after_static) == TokenKind.MUT) {
            this.fail("'static mut' requires 'unsafe'");
            return node;
        }
        this.expect(TokenKind.STATIC, "expected 'static'");
        bool is_mutable = this.match(TokenKind.MUT);
        if (has_unsafe && !is_mutable) {
            this.fail("'unsafe' is only valid on 'static mut'");
            return node;
        }
        node.set_flag(is_mutable);
        node.set_type(this.parse_type());
        i32 name = this.expect(TokenKind.IDENTIFIER, "expected static variable name");
        node.set_text(this.copy_of(name));
        this.expect(TokenKind.EQUAL, "expected '=' in static variable declaration");
        node.set_first(this.parse_expression());
        this.expect(TokenKind.SEMICOLON, "expected ';' after static variable");
        return node;
    }

    Node* parse_enum() {
        i32 start = this.advance();
        Node* node = Node.create_list(NodeKind.STRUCT_DECL, start);
        node.set_flag(true);
        i32 name = this.expect(TokenKind.IDENTIFIER, "expected enum name");
        node.set_text(this.copy_of(name));

        if (this.check(TokenKind.LESS)) {
            node.set_generics(this.parse_generic_params());
        }
        this.parse_bases_and_constraints(node);

        this.expect(TokenKind.LBRACE, "expected '{' to open enum body");
        mut i64 next_value = 0;
        while (!this.check(TokenKind.RBRACE) && !this.at_end()) {
            i32 variant = this.expect(TokenKind.IDENTIFIER, "expected enum variant name");
            if (this.match(TokenKind.EQUAL)) {
                i32 literal_token = this.expect(TokenKind.INTEGER_LITERAL, "expected an integer enum value");
                next_value = Strings.parse_integer(this.text_of(literal_token), this.length_of(literal_token));
            }
            Node* constant = Node.create_list(NodeKind.FIELD_DECL, variant);
            constant.set_flag(true);
            constant.set_type(TypeRef.integer(32, true));
            constant.set_text(this.copy_of(variant));
            Node* value = Node.create(NodeKind.INT_LITERAL, variant);
            value.set_int_value(next_value);
            constant.set_first(value);

            if (this.match(TokenKind.LPAREN)) {
                while (!this.check(TokenKind.RPAREN) && !this.at_end()) {
                    i32 payload_token = this.current();
                    Node* payload = Node.create(NodeKind.PARAMETER, payload_token);
                    payload.set_type(this.parse_type());
                    payload.set_text("payload");
                    constant.add(payload);
                    if (!this.match(TokenKind.COMMA)) {
                        break;
                    }
                }
                this.expect(TokenKind.RPAREN, "expected ')' after enum variant payload");
            }
            node.add(constant);
            next_value = next_value + 1;

            if (!this.check(TokenKind.RBRACE)) {
                this.expect(TokenKind.COMMA, "expected ',' between enum variants");
            }
        }
        this.expect(TokenKind.RBRACE, "expected '}' to close enum body");
        return node;
    }

    Node* parse_interface() {
        i32 start = this.advance();
        Node* node = Node.create_list(NodeKind.INTERFACE_DECL, start);
        i32 name = this.expect(TokenKind.IDENTIFIER, "expected interface name");
        node.set_text(this.copy_of(name));

        if (this.check(TokenKind.LESS)) {
            node.set_generics(this.parse_generic_params());
        }
        this.parse_bases_and_constraints(node);

        this.expect(TokenKind.LBRACE, "expected '{' to open interface body");
        while (!this.check(TokenKind.RBRACE) && !this.at_end()) {
            this.parse_interface_member(node);
        }
        this.expect(TokenKind.RBRACE, "expected '}' to close interface body");
        return node;
    }

    void parse_interface_member(Node* owner) {
        i32 start = this.current();
        if (this.check(TokenKind.OPERATOR)) {
            owner.add(this.parse_operator(false));
            return;
        }
        TypeRef* type = this.parse_type();
        i32 name = this.expect(TokenKind.IDENTIFIER, "expected interface member name");
        if (this.check(TokenKind.LPAREN) || this.check(TokenKind.LESS)) {
            Node* method = Node.create_list(NodeKind.FUNCTION, start);
            method.set_type(type);
            method.set_text(this.copy_of(name));
            if (this.check(TokenKind.LESS)) {
                method.set_generics(this.parse_generic_params());
            }
            this.expect(TokenKind.LPAREN, "expected '(' after the method name");
            this.parse_parameters(method);
            this.expect(TokenKind.RPAREN, "expected ')' after parameters");
            this.expect(TokenKind.SEMICOLON, "expected ';' after interface method");
            owner.add(method);
            return;
        }
        Node* field = Node.create(NodeKind.FIELD_DECL, start);
        field.set_type(type);
        field.set_text(this.copy_of(name));
        this.expect(TokenKind.SEMICOLON, "expected ';' after interface field");
        owner.add(field);
    }

    Node* parse_impl() {
        i32 start = this.advance();
        Node* node = Node.create_list(NodeKind.IMPL_DECL, start);
        PointerList* targets = PointerList.create();
        i32 first_token = this.current();
        TypeRef* first = this.parse_type();
        if (this.check(TokenKind.COMMA) || this.check(TokenKind.FOR)) {
            Node* contract = Node.create(NodeKind.PARAMETER, first_token);
            contract.set_type(first);
            node.add(contract);
            while (this.match(TokenKind.COMMA)) {
                Node* more = Node.create(NodeKind.PARAMETER, this.current());
                more.set_type(this.parse_type());
                node.add(more);
            }
            this.expect(TokenKind.FOR, "expected 'for' after the interfaces of an impl");
            node.set_type(this.parse_type());
            while (this.match(TokenKind.COMMA)) {
                targets.push((void*)this.parse_type());
            }
        } else {
            node.set_type(first);
        }

        this.expect(TokenKind.LBRACE, "expected '{' to open impl body");
        while (!this.check(TokenKind.RBRACE) && !this.at_end()) {
            this.parse_member(node);
        }
        this.expect(TokenKind.RBRACE, "expected '}' to close impl body");
        for (mut i32 t = 0; t < targets.length; t = t + 1) {
            Node* copy = Node.clone(node);
            copy.set_type((TypeRef*)targets.get(t));
            if (this.extra_declarations == null) {
                this.extra_declarations = PointerList.create();
            }
            PointerList* pending = this.extra_declarations;
            pending.push((void*)copy);
        }
        return node;
    }

    void parse_bases_and_constraints(Node* node) {
        mut bool has_base = false;
        while (!this.failed) {
            if (this.check(TokenKind.COLON)) {
                this.advance();
                this.match(TokenKind.INTERFACE);
                TypeRef* first = this.parse_type();
                if (has_base) {
                    Node* extra = Node.create(NodeKind.PARAMETER, this.current());
                    extra.set_type(first);
                    node.add(extra);
                } else {
                    node.set_type(first);
                    has_base = true;
                }
                while (this.match(TokenKind.COMMA)) {
                    this.match(TokenKind.INTERFACE);
                    Node* base = Node.create(NodeKind.PARAMETER, this.current());
                    base.set_type(this.parse_type());
                    node.add(base);
                }
            } else if (this.check(TokenKind.WHERE)) {
                GenericParams* params = node.generics();
                if (params == null) {
                    this.fail("'where' needs a generic declaration");
                    return;
                }
                this.parse_where_clauses(params);
            } else {
                return;
            }
        }
    }

    Node* parse_struct() {
        i32 start = this.advance();
        Node* node = Node.create_list(NodeKind.STRUCT_DECL, start);
        i32 name = this.expect(TokenKind.IDENTIFIER, "expected struct name");
        node.set_text(this.copy_of(name));

        if (this.check(TokenKind.LESS)) {
            node.set_generics(this.parse_generic_params());
        }
        this.parse_bases_and_constraints(node);

        if (this.match(TokenKind.SEMICOLON)) {
            return node;
        }

        this.expect(TokenKind.LBRACE, "expected '{' to open struct body");
        while (!this.check(TokenKind.RBRACE) && !this.at_end()) {
            this.parse_member(node);
        }
        this.expect(TokenKind.RBRACE, "expected '}' to close struct body");
        return node;
    }

    void parse_struct_member(Node* owner) {
        i32 start = this.current();
        mut i32 lookahead = 0;
        while (this.kind_of(this.peek_token(lookahead)) == TokenKind.PUBLIC || this.kind_of(this.peek_token(lookahead)) == TokenKind.PRIVATE
            || this.kind_of(this.peek_token(lookahead)) == TokenKind.STATIC) {
            lookahead = lookahead + 1;
        }
        i32 head = this.peek_token(lookahead);

        if (this.kind_of(head) == TokenKind.CONST) {
            for (mut i32 i = 0; i < lookahead; i = i + 1) {
                this.advance();
            }
            this.advance();
            Node* constant = Node.create(NodeKind.FIELD_DECL, head);
            constant.set_flag(true);
            constant.set_type(this.parse_type());
            i32 constName = this.expect(TokenKind.IDENTIFIER, "expected constant name");
            constant.set_text(this.copy_of(constName));
            this.expect(TokenKind.EQUAL, "expected '=' in constant declaration");
            constant.set_first(this.parse_expression());
            this.expect(TokenKind.SEMICOLON, "expected ';' after constant");
            owner.add(constant);
            return;
        }

        i32 afterHead = this.peek_token(lookahead + 1);
        bool isConstructor = this.kind_of(head) == TokenKind.IDENTIFIER && this.kind_of(afterHead) == TokenKind.LPAREN;
        if (isConstructor) {
            for (mut i32 i = 0; i < lookahead; i = i + 1) {
                this.advance();
            }
            this.advance();
            Node* constructor = Node.create_list(NodeKind.FUNCTION, head);
            constructor.set_type(TypeRef.create(TypeKind.VOID));
            constructor.set_text(".ctor");
            this.expect(TokenKind.LPAREN, "expected '(' after the constructor name");
            this.parse_parameters(constructor);
            this.expect(TokenKind.RPAREN, "expected ')' after parameters");
            constructor.set_first(this.parse_block());
            owner.add(constructor);
            return;
        }

        if (this.kind_of(head) == TokenKind.OPERATOR) {
            for (mut i32 i = 0; i < lookahead; i = i + 1) {
                this.advance();
            }
            owner.add(this.parse_operator(true));
            return;
        }

        mut i32 typeEnd = this.scan_type_end(lookahead);
        if (typeEnd < 0) {
            this.fail("expected a struct member");
            return;
        }

        i32 afterType = this.peek_token(typeEnd);
        i32 afterName = this.peek_token(typeEnd + 1);
        bool genericMethod = this.kind_of(afterName) == TokenKind.LESS && this.scan_generic_head(typeEnd + 1);
        if (this.kind_of(afterType) == TokenKind.IDENTIFIER && (this.kind_of(afterName) == TokenKind.LPAREN || genericMethod)) {
            Node* method = this.parse_function(false);
            if (method != null) {
                owner.add(method);
            }
            return;
        }

        bool isProperty = this.kind_of(afterType) == TokenKind.IDENTIFIER
            && (this.kind_of(afterName) == TokenKind.LBRACE || this.kind_of(afterName) == TokenKind.ARROW);
        if (isProperty) {
            for (mut i32 i = 0; i < lookahead; i = i + 1) {
                this.advance();
            }
            this.parse_property(owner);
            return;
        }

        for (mut i32 i = 0; i < lookahead; i = i + 1) {
            this.advance();
        }
        Node* field = Node.create(NodeKind.FIELD_DECL, start);
        if (this.match(TokenKind.MUT)) {
            field.set_flag(true);
        }
        field.set_type(this.parse_type());
        i32 fieldName = this.expect(TokenKind.IDENTIFIER, "expected field name");
        field.set_text(this.copy_of(fieldName));
        this.expect(TokenKind.SEMICOLON, "expected ';' after field");
        owner.add(field);
    }

    Node* property_return(i32 at, Node* value) {
        Node* body = Node.create_list(NodeKind.BLOCK, at);
        Node* ret = Node.create(NodeKind.RETURN, at);
        ret.set_first(value);
        body.add(ret);
        return body;
    }

    Node* backing_access(i32 at, i8* field_name) {
        Node* self = Node.create(NodeKind.IDENTIFIER, at);
        self.set_text("this");
        Node* access = Node.create(NodeKind.FIELD_ACCESS, at);
        access.set_first(self);
        access.set_text(field_name);
        return access;
    }

    Node* property_method(i32 at, i8* prefix, i8* name, TypeRef* type, bool setter, Node* body) {
        Node* method = Node.create_list(NodeKind.FUNCTION, at);
        ByteBuffer* full = ByteBuffer.create();
        full.append(prefix);
        full.append(name);
        method.set_text(full.cstr());
        if (setter) {
            method.set_type(TypeRef.create(TypeKind.VOID));
            Node* parameter = Node.create(NodeKind.PARAMETER, at);
            parameter.set_type(type);
            parameter.set_text("value");
            method.add(parameter);
        } else {
            method.set_type(type);
        }
        method.set_first(body);
        return method;
    }

    void parse_property(Node* owner) {
        i32 start = this.current();
        TypeRef* type = this.parse_type();
        i32 name_token = this.expect(TokenKind.IDENTIFIER, "expected property name");
        i8* name = this.copy_of(name_token);
        ByteBuffer* backing = ByteBuffer.create();
        backing.append("__prop_");
        backing.append(name);
        mut Node* getter_body = (Node*)0;
        mut Node* setter_body = (Node*)0;
        mut bool auto_get = false;
        mut bool auto_set = false;

        if (this.match(TokenKind.ARROW)) {
            getter_body = this.property_return(start, this.parse_expression());
            this.expect(TokenKind.SEMICOLON, "expected ';' after property expression");
        } else {
            this.expect(TokenKind.LBRACE, "expected '{' to open the property");
            while (!this.check(TokenKind.RBRACE) && !this.at_end() && !this.failed) {
                while (this.check(TokenKind.PUBLIC) || this.check(TokenKind.PRIVATE)) {
                    this.advance();
                }
                i32 accessor = this.expect(TokenKind.IDENTIFIER, "expected 'get' or 'set'");
                bool is_get = Strings.equals(this.text_of(accessor), this.length_of(accessor), "get");
                bool is_set = Strings.equals(this.text_of(accessor), this.length_of(accessor), "set");
                if (!is_get && !is_set) {
                    this.fail("expected 'get' or 'set' in a property");
                    return;
                }
                mut Node* body = (Node*)0;
                mut bool automatic = false;
                if (this.match(TokenKind.SEMICOLON)) {
                    automatic = true;
                } else if (this.match(TokenKind.ARROW)) {
                    i32 arrow = this.current();
                    Node* expression = this.parse_expression();
                    this.expect(TokenKind.SEMICOLON, "expected ';' after accessor expression");
                    if (is_get) {
                        body = this.property_return(arrow, expression);
                    } else {
                        body = Node.create_list(NodeKind.BLOCK, arrow);
                        Node* statement = Node.create(NodeKind.EXPR_STMT, arrow);
                        statement.set_first(expression);
                        body.add(statement);
                    }
                } else {
                    body = this.parse_block();
                }
                if (is_get) {
                    getter_body = body;
                    auto_get = automatic;
                } else {
                    setter_body = body;
                    auto_set = automatic;
                }
            }
            this.expect(TokenKind.RBRACE, "expected '}' to close the property");
        }

        if (auto_get || auto_set) {
            Node* field = Node.create(NodeKind.FIELD_DECL, start);
            field.set_flag(true);
            field.set_type(type);
            field.set_text(backing.cstr());
            owner.add(field);
        }
        if (auto_get) {
            getter_body = this.property_return(start, this.backing_access(start, backing.cstr()));
        }
        if (auto_set) {
            Node* assign = Node.create(NodeKind.ASSIGN, start);
            assign.set_first(this.backing_access(start, backing.cstr()));
            Node* value = Node.create(NodeKind.IDENTIFIER, start);
            value.set_text("value");
            assign.set_second(value);
            setter_body = Node.create_list(NodeKind.BLOCK, start);
            Node* statement = Node.create(NodeKind.EXPR_STMT, start);
            statement.set_first(assign);
            setter_body.add(statement);
        }
        if (getter_body == null) {
            this.fail("a property needs a getter");
            return;
        }
        owner.add(this.property_method(start, "get:", name, type, false, getter_body));
        if (setter_body != null) {
            owner.add(this.property_method(start, "set:", name, type, true, setter_body));
        }
    }

    Node* parse_block() {
        i32 start = this.expect(TokenKind.LBRACE, "expected '{'");
        Node* block = Node.create_list(NodeKind.BLOCK, start);
        while (!this.check(TokenKind.RBRACE) && !this.at_end()) {
            Node* statement = this.parse_statement();
            if (statement != null) {
                block.add(statement);
            }
        }
        this.expect(TokenKind.RBRACE, "expected '}' to close block");
        return block;
    }

    Node* parse_statement() {
        i32 token = this.current();

        if (this.kind_of(token) == TokenKind.LBRACE) {
            return this.parse_block();
        }
        if (this.kind_of(token) == TokenKind.SEMICOLON) {
            this.advance();
            return null;
        }
        if (this.kind_of(token) == TokenKind.RETURN) {
            this.advance();
            Node* ret = Node.create(NodeKind.RETURN, token);
            if (!this.check(TokenKind.SEMICOLON)) {
                ret.set_first(this.parse_expression());
            }
            this.expect(TokenKind.SEMICOLON, "expected ';' after return");
            return ret;
        }
        if (this.kind_of(token) == TokenKind.IF) {
            return this.parse_if();
        }
        if (this.kind_of(token) == TokenKind.WHILE) {
            this.advance();
            Node* loop = Node.create(NodeKind.WHILE, token);
            this.expect(TokenKind.LPAREN, "expected '(' after while");
            loop.set_first(this.parse_expression());
            this.expect(TokenKind.RPAREN, "expected ')' after condition");
            loop.set_second(this.parse_statement_or_empty());
            return loop;
        }
        if (this.kind_of(token) == TokenKind.DO) {
            this.advance();
            Node* loop = Node.create(NodeKind.DO_WHILE, token);
            loop.set_second(this.parse_statement_or_empty());
            this.expect(TokenKind.WHILE, "expected 'while' after do body");
            this.expect(TokenKind.LPAREN, "expected '(' after while");
            loop.set_first(this.parse_expression());
            this.expect(TokenKind.RPAREN, "expected ')' after condition");
            this.expect(TokenKind.SEMICOLON, "expected ';' after do-while");
            return loop;
        }
        if (this.kind_of(token) == TokenKind.FOR) {
            return this.parse_for();
        }
        if (this.kind_of(token) == TokenKind.BREAK) {
            this.advance();
            this.expect(TokenKind.SEMICOLON, "expected ';' after break");
            return Node.create(NodeKind.BREAK, token);
        }
        if (this.kind_of(token) == TokenKind.CONTINUE) {
            this.advance();
            this.expect(TokenKind.SEMICOLON, "expected ';' after continue");
            return Node.create(NodeKind.CONTINUE, token);
        }
        if (this.kind_of(token) == TokenKind.SWITCH) {
            return this.parse_switch();
        }
        if (this.kind_of(token) == TokenKind.SPAWN) {
            this.advance();
            Node* spawned = Node.create(NodeKind.SPAWN_STMT, token);
            spawned.set_first(this.parse_expression());
            this.expect(TokenKind.SEMICOLON, "expected ';' after spawn");
            return spawned;
        }

        if (this.is_declaration_start()) {
            Node* declaration = this.parse_variable_declaration();
            this.expect(TokenKind.SEMICOLON, "expected ';' after declaration");
            return declaration;
        }

        Node* statement = Node.create(NodeKind.EXPR_STMT, token);
        statement.set_first(this.parse_expression());
        this.expect(TokenKind.SEMICOLON, "expected ';' after expression");
        return statement;
    }

    Node* parse_switch() {
        i32 start = this.advance();
        Node* node = Node.create_list(NodeKind.SWITCH, start);
        this.expect(TokenKind.LPAREN, "expected '(' after switch");
        node.set_first(this.parse_expression());
        this.expect(TokenKind.RPAREN, "expected ')' after switch value");
        this.expect(TokenKind.LBRACE, "expected '{' to open switch");
        while (!this.check(TokenKind.RBRACE) && !this.at_end()) {
            i32 label = this.current();
            Node* arm = Node.create_list(NodeKind.CASE, label);
            if (this.match(TokenKind.CASE)) {
                arm.set_first(this.parse_expression());
            } else if (!this.match(TokenKind.DEFAULT)) {
                this.fail("expected 'case' or 'default'");
                return node;
            }
            this.expect(TokenKind.COLON, "expected ':' after case label");
            while (!this.check(TokenKind.CASE) && !this.check(TokenKind.DEFAULT) && !this.check(TokenKind.RBRACE) && !this.at_end()) {
                Node* statement = this.parse_statement();
                if (statement != null) {
                    arm.add(statement);
                }
            }
            node.add(arm);
        }
        this.expect(TokenKind.RBRACE, "expected '}' to close switch");
        return node;
    }

    Node* parse_struct_init() {
        i32 start = this.advance();
        Node* node = Node.create_list(NodeKind.STRUCT_INIT, start);
        while (!this.check(TokenKind.RBRACE) && !this.at_end() && !this.failed) {
            this.expect(TokenKind.DOT, "expected '.field = value' in struct initializer");
            i32 name = this.expect(TokenKind.IDENTIFIER, "expected field name in struct initializer");
            Node* field = Node.create(NodeKind.FIELD_INIT, name);
            field.set_text(this.copy_of(name));
            this.expect(TokenKind.EQUAL, "expected '=' after field name");
            field.set_first(this.parse_expression());
            node.add(field);
            if (!this.check(TokenKind.RBRACE)) {
                this.expect(TokenKind.COMMA, "expected ',' between field initializers");
            }
        }
        this.expect(TokenKind.RBRACE, "expected '}' to close struct initializer");
        return node;
    }

    Node* parse_switch_expression() {
        i32 start = this.advance();
        Node* node = Node.create_list(NodeKind.SWITCH_EXPR, start);
        node.set_first(this.parse_expression());
        this.expect(TokenKind.LBRACE, "expected '{' to open switch expression");
        while (!this.check(TokenKind.RBRACE) && !this.at_end()) {
            i32 label = this.current();
            Node* arm = Node.create_list(NodeKind.MATCH_ARM, label);
            arm.set_text(this.qualified_name());
            while (this.check(TokenKind.IDENTIFIER)) {
                i32 binding_token = this.advance();
                Node* binding = Node.create(NodeKind.PARAMETER, binding_token);
                binding.set_text(this.copy_of(binding_token));
                arm.add(binding);
            }
            this.expect(TokenKind.THIN_ARROW, "expected '->' after match pattern");
            arm.set_first(this.parse_expression());
            node.add(arm);
            if (!this.check(TokenKind.RBRACE)) {
                this.expect(TokenKind.COMMA, "expected ',' between match arms");
            }
        }
        this.expect(TokenKind.RBRACE, "expected '}' to close switch expression");
        return node;
    }

    Node* parse_statement_or_empty() {
        i32 token = this.current();
        Node* statement = this.parse_statement();
        if (statement == null) {
            return Node.create_list(NodeKind.BLOCK, token);
        }
        return statement;
    }

    Node* parse_variable_declaration() {
        i32 start = this.current();
        Node* declaration = Node.create(NodeKind.VAR_DECL, start);
        if (this.match(TokenKind.MUT)) {
            declaration.set_flag(true);
        }
        declaration.set_type(this.parse_type());
        if (this.match(TokenKind.MUT)) {
            declaration.set_flag(true);
        }
        i32 name = this.expect(TokenKind.IDENTIFIER, "expected variable name");
        declaration.set_text(this.copy_of(name));
        if (this.match(TokenKind.EQUAL)) {
            declaration.set_first(this.parse_expression());
        }
        return declaration;
    }

    Node* parse_if() {
        i32 start = this.advance();
        Node* node = Node.create(NodeKind.IF, start);
        this.expect(TokenKind.LPAREN, "expected '(' after if");
        node.set_first(this.parse_expression());
        this.expect(TokenKind.RPAREN, "expected ')' after condition");
        node.set_second(this.parse_statement_or_empty());
        if (this.match(TokenKind.ELSE)) {
            node.set_third(this.parse_statement_or_empty());
        }
        return node;
    }

    Node* parse_range_for(i32 start, Node* variable) {
        this.advance();
        bool bracket = this.match(TokenKind.LBRACKET);
        Node* low = this.parse_expression();
        mut bool inclusive = false;
        if (this.match(TokenKind.DOT_DOT_EQUAL)) {
            inclusive = true;
        } else {
            this.expect(TokenKind.DOT_DOT, "expected '..' or '..=' in the range");
        }
        Node* high = this.parse_expression();
        if (bracket) {
            if (this.match(TokenKind.RBRACKET)) {
                inclusive = true;
            } else {
                this.expect(TokenKind.RPAREN, "expected ']' or ')' to close the range");
                inclusive = false;
            }
        }
        this.expect(TokenKind.RPAREN, "expected ')' after the range");

        this.hidden_count = this.hidden_count + 1;
        ByteBuffer* limit_name = ByteBuffer.create();
        limit_name.append("__limit");
        limit_name.append_int((i64)this.hidden_count);

        Node* limit = Node.create(NodeKind.VAR_DECL, start);
        limit.set_type(variable.type());
        limit.set_text(limit_name.cstr());
        limit.set_first(high);

        variable.set_flag(true);
        variable.set_first(low);

        Node* counter = Node.create(NodeKind.IDENTIFIER, start);
        counter.set_text(variable.text());
        Node* bound = Node.create(NodeKind.IDENTIFIER, start);
        bound.set_text(limit_name.cstr());
        mut i32 comparison = TokenKind.LESS;
        if (inclusive) {
            comparison = TokenKind.LESS_EQUAL;
        }

        Node* loop = Node.create(NodeKind.FOR, start);
        loop.set_first(variable);
        loop.set_second(this.make_binary(comparison, counter, bound, start));
        loop.set_third(this.make_step(counter, TokenKind.PLUS, start));
        loop.set_fourth(this.parse_statement_or_empty());

        Node* scope = Node.create_list(NodeKind.BLOCK, start);
        scope.add(limit);
        scope.add(loop);
        return scope;
    }

    Node* parse_for() {
        i32 start = this.advance();
        Node* node = Node.create(NodeKind.FOR, start);
        this.expect(TokenKind.LPAREN, "expected '(' after for");

        if (!this.check(TokenKind.SEMICOLON)) {
            if (this.is_declaration_start()) {
                node.set_first(this.parse_variable_declaration());
                if (this.check(TokenKind.IN)) {
                    return this.parse_range_for(start, node.first());
                }
            } else {
                i32 initToken = this.current();
                Node* init = Node.create(NodeKind.EXPR_STMT, initToken);
                init.set_first(this.parse_expression());
                node.set_first(init);
            }
        }
        this.expect(TokenKind.SEMICOLON, "expected ';' after for initializer");

        if (!this.check(TokenKind.SEMICOLON)) {
            node.set_second(this.parse_expression());
        }
        this.expect(TokenKind.SEMICOLON, "expected ';' after for condition");

        if (!this.check(TokenKind.RPAREN)) {
            node.set_third(this.parse_expression());
        }
        this.expect(TokenKind.RPAREN, "expected ')' after for clauses");
        node.set_fourth(this.parse_statement_or_empty());
        return node;
    }

    public Node* parse_expression() {
        return this.parse_assignment();
    }

    static i32 compound_operator(i32 kind) {
        if (kind == TokenKind.PLUS_EQUAL) { return TokenKind.PLUS; }
        if (kind == TokenKind.MINUS_EQUAL) { return TokenKind.MINUS; }
        if (kind == TokenKind.STAR_EQUAL) { return TokenKind.STAR; }
        if (kind == TokenKind.SLASH_EQUAL) { return TokenKind.SLASH; }
        if (kind == TokenKind.PERCENT_EQUAL) { return TokenKind.PERCENT; }
        if (kind == TokenKind.AMPERSAND_EQUAL) { return TokenKind.AMPERSAND; }
        if (kind == TokenKind.PIPE_EQUAL) { return TokenKind.PIPE; }
        if (kind == TokenKind.CARET_EQUAL) { return TokenKind.CARET; }
        if (kind == TokenKind.LESS_LESS_EQUAL) { return TokenKind.LESS_LESS; }
        if (kind == TokenKind.GREATER_GREATER_EQUAL) { return TokenKind.GREATER_GREATER; }
        return 0;
    }

    static i32 precedence(i32 kind) {
        if (kind == TokenKind.QUESTION_QUESTION) { return 1; }
        if (kind == TokenKind.OR_OR) { return 2; }
        if (kind == TokenKind.AND_AND) { return 3; }
        if (kind == TokenKind.PIPE) { return 4; }
        if (kind == TokenKind.CARET) { return 5; }
        if (kind == TokenKind.AMPERSAND) { return 6; }
        if (kind == TokenKind.EQUAL_EQUAL || kind == TokenKind.BANG_EQUAL || kind == TokenKind.IS) { return 7; }
        if (kind == TokenKind.LESS || kind == TokenKind.LESS_EQUAL
            || kind == TokenKind.GREATER || kind == TokenKind.GREATER_EQUAL) { return 8; }
        if (kind == TokenKind.LESS_LESS || kind == TokenKind.GREATER_GREATER) { return 9; }
        if (kind == TokenKind.PLUS || kind == TokenKind.MINUS) { return 10; }
        if (kind == TokenKind.STAR || kind == TokenKind.SLASH || kind == TokenKind.PERCENT) { return 11; }
        return 0;
    }

    Node* make_assignment(Node* target, Node* value, i32 at) {
        Node* assign = Node.create(NodeKind.ASSIGN, at);
        assign.set_first(target);
        assign.set_second(value);
        return assign;
    }

    Node* make_binary(i32 op, Node* left, Node* right, i32 at) {
        Node* binary = Node.create(NodeKind.BINARY, at);
        binary.set_op(op);
        binary.set_first(left);
        binary.set_second(right);
        return binary;
    }

    Node* make_step(Node* target, i32 op, i32 at) {
        Node* one = Node.create(NodeKind.INT_LITERAL, at);
        one.set_int_value(1);
        one.set_text("1");
        Node* sum = this.make_binary(op, target, one, at);
        return this.make_assignment(target, sum, at);
    }

    Node* parse_assignment() {
        Node* left = this.parse_binary(1);
        i32 token = this.current();

        if (this.kind_of(token) == TokenKind.EQUAL) {
            this.advance();
            Node* value = this.parse_assignment();
            return this.make_assignment(left, value, token);
        }

        i32 compound = Parser.compound_operator(this.kind_of(token));
        if (compound != 0) {
            this.advance();
            Node* rhs = this.parse_assignment();
            Node* combined = this.make_binary(compound, left, rhs, token);
            return this.make_assignment(left, combined, token);
        }
        return left;
    }

    Node* parse_is(Node* operand, i32 at) {
        Node* test = Node.create(NodeKind.IS_EXPR, at);
        test.set_first(operand);
        test.set_type(this.parse_type());
        if (this.check(TokenKind.IDENTIFIER)) {
            ByteBuffer* names = ByteBuffer.create();
            while (this.check(TokenKind.IDENTIFIER)) {
                i32 binding = this.advance();
                if (names.length > 0) {
                    names.append_char(32);
                }
                names.append_slice(this.text_of(binding), this.length_of(binding));
            }
            test.set_text(names.cstr());
            test.set_flag(true);
        }
        return test;
    }

    Node* parse_binary(i32 min_precedence) {
        mut Node* left = this.parse_unary();
        while (true) {
            i32 op = this.current();
            i32 level = Parser.precedence(this.kind_of(op));
            if (level == 0 || level < min_precedence) {
                break;
            }
            this.advance();
            if (this.kind_of(op) == TokenKind.IS) {
                left = this.parse_is(left, op);
                continue;
            }
            mut i32 next_level = level + 1;
            if (this.kind_of(op) == TokenKind.QUESTION_QUESTION) {
                next_level = level;
            }
            Node* right = this.parse_binary(next_level);
            left = this.make_binary(this.kind_of(op), left, right, op);
        }
        return left;
    }

    Node* parse_unary() {
        i32 token = this.current();
        bool isPrefix = this.kind_of(token) == TokenKind.BANG || this.kind_of(token) == TokenKind.MINUS
            || this.kind_of(token) == TokenKind.TILDE || this.kind_of(token) == TokenKind.STAR || this.kind_of(token) == TokenKind.AMPERSAND;
        if (isPrefix) {
            this.advance();
            Node* unary = Node.create(NodeKind.UNARY, token);
            unary.set_op(this.kind_of(token));
            unary.set_first(this.parse_unary());
            return unary;
        }

        if (this.kind_of(token) == TokenKind.PLUS_PLUS || this.kind_of(token) == TokenKind.MINUS_MINUS) {
            this.advance();
            Node* target = this.parse_unary();
            mut i32 op = TokenKind.PLUS;
            if (this.kind_of(token) == TokenKind.MINUS_MINUS) {
                op = TokenKind.MINUS;
            }
            return this.make_step(target, op, token);
        }

        if (this.kind_of(token) == TokenKind.AWAIT) {
            this.advance();
            Node* awaited = Node.create(NodeKind.AWAIT_EXPR, token);
            awaited.set_first(this.parse_unary());
            return awaited;
        }

        if (this.kind_of(token) == TokenKind.SPAWN || this.kind_of(token) == TokenKind.TRY
            || this.kind_of(token) == TokenKind.THROW) {
            this.fail("this expression is not supported yet");
            return Node.create(NodeKind.NULL_LITERAL, token);
        }

        Node* primary = this.parse_primary();
        return this.parse_postfix(primary);
    }

    Node* parse_argument() {
        i32 token = this.current();
        if (this.kind_of(token) == TokenKind.IDENTIFIER && this.kind_of(this.peek_token(1)) == TokenKind.COLON) {
            this.advance();
            this.advance();
            Node* named = Node.create(NodeKind.NAMED_ARG, token);
            named.set_text(this.copy_of(token));
            named.set_first(this.parse_expression());
            return named;
        }
        return this.parse_expression();
    }

    Node* parse_postfix(Node* start) {
        mut Node* expr = start;
        while (!this.failed) {
            i32 token = this.current();
            if (this.kind_of(token) == TokenKind.LPAREN) {
                this.advance();
                Node* call = Node.create_list(NodeKind.CALL, token);
                call.set_first(expr);
                if (!this.check(TokenKind.RPAREN)) {
                    call.add(this.parse_argument());
                    while (this.match(TokenKind.COMMA)) {
                        call.add(this.parse_argument());
                    }
                }
                this.expect(TokenKind.RPAREN, "expected ')' after arguments");
                expr = call;
            } else if (this.kind_of(token) == TokenKind.LBRACKET) {
                this.advance();
                Node* index = Node.create(NodeKind.INDEX, token);
                index.set_first(expr);
                index.set_second(this.parse_expression());
                this.expect(TokenKind.RBRACKET, "expected ']' after index");
                expr = index;
            } else if (this.kind_of(token) == TokenKind.DOT) {
                this.advance();
                Node* access = Node.create(NodeKind.FIELD_ACCESS, token);
                access.set_first(expr);
                i32 member = this.expect(TokenKind.IDENTIFIER, "expected member name after '.'");
                access.set_text(this.copy_of(member));
                if (this.check(TokenKind.LESS)) {
                    i32 close = this.scan_type_arguments(0);
                    bool explicit = close > 0 && !this.scan_half && this.kind_of(this.peek_token(close)) == TokenKind.LPAREN;
                    this.scan_half = false;
                    if (explicit) {
                        TypeRef* holder = TypeRef.create(TypeKind.NAMED);
                        holder.args = this.parse_type_arguments();
                        access.set_type(holder);
                    }
                }
                expr = access;
            } else if (this.kind_of(token) == TokenKind.PLUS_PLUS) {
                this.advance();
                expr = this.make_step(expr, TokenKind.PLUS, token);
            } else if (this.kind_of(token) == TokenKind.MINUS_MINUS) {
                this.advance();
                expr = this.make_step(expr, TokenKind.MINUS, token);
            } else {
                break;
            }
        }
        return expr;
    }

    Node* interpolation_text(i32 token) {
        this.advance();
        Node* literal = Node.create(NodeKind.STRING_LITERAL, token);
        literal.set_text_n(this.text_of(token), this.length_of(token));
        literal.set_int_value(this.length_of(token));
        return literal;
    }

    Node* parse_interpolation() {
        i32 start = this.current();
        Node* node = Node.create_list(NodeKind.INTERPOLATION, start);
        node.add(this.interpolation_text(start));
        while (!this.failed) {
            if (this.kind_of(this.current()) == TokenKind.INTERP_END) {
                node.add(this.interpolation_text(this.current()));
                break;
            }
            node.add(this.parse_expression());
            i32 next = this.current();
            if (this.kind_of(next) == TokenKind.INTERP_MIDDLE) {
                node.add(this.interpolation_text(next));
            } else if (this.kind_of(next) == TokenKind.INTERP_END) {
                node.add(this.interpolation_text(next));
                break;
            } else {
                this.fail("expected the end of the string interpolation");
                break;
            }
        }
        return node;
    }

    Node* parse_primary() {
        i32 token = this.current();

        if (this.kind_of(token) == TokenKind.INTEGER_LITERAL) {
            this.advance();
            Node* literal = Node.create(NodeKind.INT_LITERAL, token);
            literal.set_text(this.copy_of(token));
            literal.set_int_value(Strings.parse_integer(this.text_of(token), this.length_of(token)));
            return literal;
        }
        if (this.kind_of(token) == TokenKind.FLOAT_LITERAL) {
            this.advance();
            Node* literal = Node.create(NodeKind.FLOAT_LITERAL, token);
            literal.set_text(this.copy_of(token));
            return literal;
        }
        if (this.kind_of(token) == TokenKind.INTERP_BEGIN) {
            return this.parse_interpolation();
        }
        if (this.kind_of(token) == TokenKind.STRING_LITERAL) {
            this.advance();
            Node* literal = Node.create(NodeKind.STRING_LITERAL, token);
            literal.set_text_n(this.text_of(token), this.length_of(token));
            literal.set_int_value(this.length_of(token));
            return literal;
        }
        if (this.kind_of(token) == TokenKind.TRUE || this.kind_of(token) == TokenKind.FALSE) {
            this.advance();
            Node* literal = Node.create(NodeKind.BOOL_LITERAL, token);
            if (this.kind_of(token) == TokenKind.TRUE) {
                literal.set_int_value(1);
            }
            return literal;
        }
        if (this.kind_of(token) == TokenKind.NULL) {
            this.advance();
            return Node.create(NodeKind.NULL_LITERAL, token);
        }
        if (this.kind_of(token) == TokenKind.SWITCH) {
            return this.parse_switch_expression();
        }
        if (this.kind_of(token) == TokenKind.LBRACKET) {
            this.advance();
            Node* literal = Node.create_list(NodeKind.ARRAY_LITERAL, token);
            if (!this.check(TokenKind.RBRACKET)) {
                literal.add(this.parse_expression());
                while (this.match(TokenKind.COMMA)) {
                    literal.add(this.parse_expression());
                }
            }
            this.expect(TokenKind.RBRACKET, "expected ']' after the array elements");
            return literal;
        }
        if (this.kind_of(token) == TokenKind.LBRACE) {
            return this.parse_struct_init();
        }
        if (this.kind_of(token) == TokenKind.NEW) {
            this.advance();
            Node* created = Node.create_list(NodeKind.NEW_EXPR, token);
            created.set_type(this.parse_type());
            this.expect(TokenKind.LPAREN, "expected '(' after the type of 'new'");
            if (!this.check(TokenKind.RPAREN)) {
                created.add(this.parse_argument());
                while (this.match(TokenKind.COMMA)) {
                    created.add(this.parse_argument());
                }
            }
            this.expect(TokenKind.RPAREN, "expected ')' after the constructor arguments");
            return created;
        }
        if (this.kind_of(token) == TokenKind.THIS) {
            this.advance();
            Node* self = Node.create(NodeKind.IDENTIFIER, token);
            self.set_text("this");
            return self;
        }

        if (this.kind_of(token) == TokenKind.IDENTIFIER) {
            MacroInfo* called = Macros.find(this.atom_of(token));
            if (called != null && this.kind_of(this.peek_token(1)) == TokenKind.LPAREN) {
                return this.expand_macro(token, called);
            }
            i32 intrinsic = Intrinsic.lookup(this.atom_of(token));
            if (intrinsic != Intrinsic.NONE && this.kind_of(this.peek_token(1)) == TokenKind.LPAREN) {
                this.advance();
                this.advance();
                Node* call = Node.create(NodeKind.INTRINSIC, token);
                call.set_op(intrinsic);
                call.set_type(this.parse_type());
                this.expect(TokenKind.RPAREN, "expected ')' after intrinsic type argument");
                return call;
            }

            if (this.is_known_type(token) && this.kind_of(this.peek_token(1)) == TokenKind.LESS) {
                i32 end = this.scan_type_end(0);
                if (end > 0 && this.kind_of(this.peek_token(end)) == TokenKind.LPAREN) {
                    TypeRef* constructed = this.parse_type();
                    Node* constructor_name = Node.create(NodeKind.IDENTIFIER, token);
                    constructor_name.set_text(constructed.name);
                    constructor_name.set_type(constructed);
                    constructor_name.set_flag(true);
                    return constructor_name;
                }
                if (end > 0 && this.kind_of(this.peek_token(end)) == TokenKind.COLON_COLON
                    && this.kind_of(this.peek_token(end + 1)) == TokenKind.IDENTIFIER) {
                    TypeRef* owner = this.parse_type();
                    this.advance();
                    i32 variant = this.expect(TokenKind.IDENTIFIER, "expected an enum variant");
                    Node* generic_variant = Node.create(NodeKind.IDENTIFIER, token);
                    generic_variant.set_text(this.copy_of(variant));
                    generic_variant.set_type(owner);
                    return generic_variant;
                }
            }

            Node* identifier = Node.create(NodeKind.IDENTIFIER, token);
            identifier.set_text(this.qualified_name());
            if (this.is_known_type(token) && this.check(TokenKind.LBRACE) && this.kind_of(this.peek_token(1)) == TokenKind.DOT) {
                Node* typed_init = this.parse_struct_init();
                typed_init.set_type(TypeRef.named(identifier.text()));
                return typed_init;
            }
            if (this.check(TokenKind.LESS) && !this.is_known_type(token)) {
                i32 close = this.scan_type_arguments(0);
                bool explicit = close > 0 && !this.scan_half && this.kind_of(this.peek_token(close)) == TokenKind.LPAREN;
                this.scan_half = false;
                if (explicit) {
                    TypeRef* holder = TypeRef.create(TypeKind.NAMED);
                    holder.args = this.parse_type_arguments();
                    identifier.set_type(holder);
                }
            }
            return identifier;
        }

        if (this.kind_of(token) == TokenKind.LPAREN) {
            i32 typeEnd = this.scan_type_end(1);
            bool isCast = typeEnd > 0 && this.kind_of(this.peek_token(typeEnd)) == TokenKind.RPAREN;
            this.advance();
            if (isCast) {
                Node* cast = Node.create(NodeKind.CAST, token);
                cast.set_type(this.parse_type());
                this.expect(TokenKind.RPAREN, "expected ')' after cast type");
                cast.set_first(this.parse_unary());
                return cast;
            }
            Node* inner = this.parse_expression();
            this.expect(TokenKind.RPAREN, "expected ')'");
            return inner;
        }

        this.fail("expected an expression");
        return Node.create(NodeKind.NULL_LITERAL, token);
    }
}
