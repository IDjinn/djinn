namespace djinnc;

unsafe static mut ptr uow_declarations = null;

// A 'uow Name { ... }' declaration: the participants and clauses a method binds with 'uow(Name)'. It has no body; the
// method keeps the code. access, ordering and isolation are kept as the text written between the parentheses.
struct UowDeclaration {
    ptr<i8> name;
    i32 token;
    PointerList* participants;
    PointerList* requires;
    PointerList* ensures;
    PointerList* captures;
    PointerList* writes;
    bool has_writes;
    ptr<i8> access;
    ptr<i8> ordering;
    ptr<i8> isolation;
    i32 isolation_token;

    public static unsafe PointerList* all() {
        if (uow_declarations == null) {
            uow_declarations = (ptr)PointerList.create();
        }
        return (PointerList*)uow_declarations;
    }

    public static unsafe UowDeclaration* find(ptr<i8> name) {
        PointerList* declarations = UowDeclaration.all();
        for (mut i32 i = 0; i < declarations.length; i = i + 1) {
            UowDeclaration* declaration = (UowDeclaration*)declarations.get(i);
            if (Strings.same(declaration.name, name)) {
                return declaration;
            }
        }
        return (UowDeclaration*)0;
    }
}
