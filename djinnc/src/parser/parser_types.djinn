namespace djinnc;

impl Parser {
    bool is_known_type(i32 token) {
        U32Map* names = this.type_names;
        return names.contains(this.atom_of(token));
    }

    bool is_ptr_keyword(i32 token) {
        return this.kind_of(token) == TokenKind::IDENTIFIER && Strings.equals(this.text_of(token), this.length_of(token), "ptr");
    }

    bool is_type_start(i32 token) {
        TokenKind kind = this.kind_of(token);
        if (kind == TokenKind::VOID || kind == TokenKind::AUTO) {
            return true;
        }
        if (kind != TokenKind::IDENTIFIER) {
            return false;
        }
        if (this.is_ptr_keyword(token)) {
            return true;
        }
        TypeRef* primitive = TypeRef.from_primitive_atom(this.atom_of(token));
        if (primitive != null) {
            return true;
        }
        return this.is_known_type(token);
    }

    bool is_qualified_start(i32 offset) {
        return this.kind_of(this.peek_token(offset)) == TokenKind::IDENTIFIER
            && this.kind_of(this.peek_token(offset + 1)) == TokenKind::COLON_COLON
            && this.kind_of(this.peek_token(offset + 2)) == TokenKind::IDENTIFIER;
    }

    i32 scan_type_end(i32 start) {
        i32 end = this.scan_type_inner(start);
        if (this.scan_half) {
            this.scan_half = false;
            return 0 - 1;
        }
        return end;
    }

    // 'fn' is a type only when '(' follows, so it stays an ordinary name everywhere else.
    bool is_fn_type_start(i32 offset) {
        i32 token = this.peek_token(offset);
        return this.kind_of(token) == TokenKind::IDENTIFIER
            && Strings.equals(this.text_of(token), this.length_of(token), "fn")
            && this.kind_of(this.peek_token(offset + 1)) == TokenKind::LPAREN;
    }

    i32 scan_fn_type(i32 start) {
        mut i32 offset = start + 2;
        if (this.kind_of(this.peek_token(offset)) == TokenKind::RPAREN) {
            offset = offset + 1;
        } else {
            while (true) {
                i32 end = this.scan_type_inner(offset);
                if (end < 0) {
                    return end;
                }
                offset = end;
                TokenKind kind = this.kind_of(this.peek_token(offset));
                if (kind == TokenKind::COMMA) {
                    offset = offset + 1;
                } else if (kind == TokenKind::RPAREN) {
                    offset = offset + 1;
                    break;
                } else {
                    return 0 - 1;
                }
            }
        }
        if (this.kind_of(this.peek_token(offset)) == TokenKind::THIN_ARROW) {
            return this.scan_type_inner(offset + 1);
        }
        return offset;
    }

    unsafe TypeRef* parse_fn_type() {
        this.advance();
        this.expect(TokenKind::LPAREN, "expected '(' after 'fn'");
        PointerList* params = PointerList.create();
        while (!this.check(TokenKind::RPAREN) && !this.at_end() && !this.failed) {
            params.push((ptr)this.parse_type());
            if (!this.match(TokenKind::COMMA)) {
                break;
            }
        }
        this.expect(TokenKind::RPAREN, "expected ')' after the parameter types of 'fn'");
        PointerList* args = PointerList.create();
        if (this.match(TokenKind::THIN_ARROW)) {
            args.push((ptr)this.parse_type());
        } else {
            args.push((ptr)TypeRef.create(TypeKind.VOID));
        }
        for (mut i32 i = 0; i < params.length; i = i + 1) {
            args.push(params.get(i));
        }
        if (args.length > 9) {
            this.fail("a 'fn' type takes at most 8 parameters");
        }
        ByteBuffer* name = ByteBuffer.create();
        name.append("__closure");
        name.append_int((i64)(args.length - 1));
        TypeRef* type = TypeRef.named(name.cstr());
        type.args = args;
        return type;
    }

    i32 scan_type_inner(i32 start) {
        mut i32 offset = start;
        if (this.is_fn_type_start(offset)) {
            return this.scan_fn_type(offset);
        }
        i32 first = this.peek_token(offset);
        if (!this.is_type_start(first) && !this.is_qualified_start(offset)) {
            return 0 - 1;
        }
        offset = offset + 1;
        while (true) {
            i32 separator = this.peek_token(offset);
            i32 part = this.peek_token(offset + 1);
            if (this.kind_of(separator) == TokenKind::COLON_COLON && this.kind_of(part) == TokenKind::IDENTIFIER) {
                offset = offset + 2;
            } else {
                break;
            }
        }
        if (this.kind_of(this.peek_token(offset)) == TokenKind::LESS) {
            offset = this.scan_arguments_of(offset, this.is_known_type(first));
            if (offset < 0) {
                return offset;
            }
        }
        while (this.kind_of(this.peek_token(offset)) == TokenKind::STAR) {
            offset = offset + 1;
        }
        while (this.kind_of(this.peek_token(offset)) == TokenKind::LBRACKET) {
            if (this.kind_of(this.peek_token(offset + 1)) == TokenKind::RBRACKET) {
                offset = offset + 2;
                continue;
            }
            i32 size_end = this.scan_inline_array_size(offset + 1);
            if (size_end < 0) {
                break;
            }
            offset = size_end + 1;
        }
        if (this.kind_of(this.peek_token(offset)) == TokenKind::QUESTION) {
            offset = offset + 1;
        }
        return offset;
    }

    i32 scan_type_arguments(i32 start) {
        return this.scan_arguments_of(start, false);
    }

    // 'loose' scans the arguments of a known generic type, where a plain name may be a constant ('vector<u64, LANES>').
    // Elsewhere 'a < b' may be a comparison, so a plain name is one only after a type argument.
    i32 scan_arguments_of(i32 start, bool loose) {
        mut i32 offset = start + 1;
        mut bool names_may_be_constants = loose;
        while (true) {
            mut i32 end = 0;
            if (this.at_value_argument(offset)) {
                end = this.scan_value_argument(offset);
            } else if (names_may_be_constants && this.kind_of(this.peek_token(offset)) == TokenKind::IDENTIFIER
                && !this.is_type_start(this.peek_token(offset)) && !this.is_qualified_start(offset)) {
                end = offset + 1;
            } else {
                // After an argument that is plainly a type ('count<i32, WIDTH>()') this cannot be a comparison.
                i32 first = this.peek_token(offset);
                if (this.is_type_start(first) && !this.is_ptr_keyword(first) && !this.is_qualified_start(offset)) {
                    names_may_be_constants = true;
                }
                end = this.scan_type_inner(offset);
            }
            if (end < 0) {
                return end;
            }
            offset = end;
            if (this.scan_half) {
                this.scan_half = false;
                return offset;
            }
            TokenKind kind = this.kind_of(this.peek_token(offset));
            if (kind == TokenKind::COMMA) {
                offset = offset + 1;
            } else if (kind == TokenKind::GREATER) {
                return offset + 1;
            } else if (kind == TokenKind::GREATER_GREATER) {
                this.scan_half = true;
                return offset + 1;
            } else {
                return 0 - 1;
            }
        }
        return 0 - 1;
    }

    // The size of 'T[N]' is a literal, a name or a parenthesized expression followed by ']'; returns the offset of ']'.
    i32 scan_inline_array_size(i32 offset) {
        mut i32 end = 0 - 1;
        if (this.at_value_argument(offset)) {
            end = this.scan_value_argument(offset);
        } else if (this.kind_of(this.peek_token(offset)) == TokenKind::IDENTIFIER) {
            end = offset + 1;
            while (this.kind_of(this.peek_token(end)) == TokenKind::COLON_COLON && this.kind_of(this.peek_token(end + 1)) == TokenKind::IDENTIFIER) {
                end = end + 2;
            }
        }
        if (end < 0 || this.kind_of(this.peek_token(end)) != TokenKind::RBRACKET) {
            return 0 - 1;
        }
        return end;
    }

    bool scan_generic_head(i32 less) {
        mut i32 offset = less + 1;
        while (this.kind_of(this.peek_token(offset)) == TokenKind::IDENTIFIER) {
            offset = offset + 1;
            if (this.kind_of(this.peek_token(offset)) == TokenKind::COMMA) {
                offset = offset + 1;
            }
        }
        return this.kind_of(this.peek_token(offset)) == TokenKind::GREATER
            && this.kind_of(this.peek_token(offset + 1)) == TokenKind::LPAREN;
    }

    bool is_declaration_start() {
        if (this.check(TokenKind::MUT)) {
            return true;
        }
        i32 end = this.scan_type_end(0);
        if (end < 0) {
            return false;
        }
        i32 after = this.peek_token(end);
        return this.kind_of(after) == TokenKind::IDENTIFIER || this.kind_of(after) == TokenKind::MUT;
    }

    ptr<i8> qualified_name() {
        i32 first = this.expect(TokenKind::IDENTIFIER, "expected identifier");
        ByteBuffer* name = ByteBuffer.create();
        name.append_slice(this.text_of(first), this.length_of(first));
        while (this.check(TokenKind::COLON_COLON)) {
            this.advance();
            i32 part = this.expect(TokenKind::IDENTIFIER, "expected identifier after '::'");
            name.append("::");
            name.append_slice(this.text_of(part), this.length_of(part));
        }
        return name.cstr();
    }

    bool at_value_argument(i32 offset) {
        TokenKind kind = this.kind_of(this.peek_token(offset));
        return kind == TokenKind::INTEGER_LITERAL || kind == TokenKind::CHAR_LITERAL || kind == TokenKind::TRUE || kind == TokenKind::FALSE
            || kind == TokenKind::LPAREN || (kind == TokenKind::MINUS && this.kind_of(this.peek_token(offset + 1)) == TokenKind::INTEGER_LITERAL);
    }

    // A template argument is a type, or a constant: a literal, a negated literal or a parenthesized expression.
    // A plain name stays a type reference here and turns into a constant when it names one.
    TypeRef* parse_template_argument() {
        if (!this.at_value_argument(0)) {
            return this.parse_type();
        }
        if (this.check(TokenKind::LPAREN)) {
            this.advance();
            Node* inner = this.parse_expression();
            this.expect(TokenKind::RPAREN, "expected ')' after the constant template argument");
            return TypeRef.constant(inner);
        }
        return TypeRef.constant(this.parse_unary());
    }

    i32 scan_value_argument(i32 offset) {
        TokenKind kind = this.kind_of(this.peek_token(offset));
        if (kind == TokenKind::MINUS) {
            return offset + 2;
        }
        if (kind != TokenKind::LPAREN) {
            return offset + 1;
        }
        mut i32 depth = 0;
        mut i32 at = offset;
        while (true) {
            TokenKind inside = this.kind_of(this.peek_token(at));
            if (inside == TokenKind::END_OF_FILE || inside == TokenKind::SEMICOLON || inside == TokenKind::LBRACE || inside == TokenKind::RBRACE) {
                return 0 - 1;
            }
            if (inside == TokenKind::LPAREN) {
                depth = depth + 1;
            } else if (inside == TokenKind::RPAREN) {
                depth = depth - 1;
                if (depth == 0) {
                    return at + 1;
                }
            }
            at = at + 1;
        }
        return 0 - 1;
    }

    PointerList* parse_type_arguments() {
        this.expect(TokenKind::LESS, "expected '<'");
        PointerList* args = PointerList.create();
        while (!this.failed) {
            args.push((ptr)this.parse_template_argument());
            if (this.half_greater) {
                this.half_greater = false;
                return args;
            }
            if (this.match(TokenKind::COMMA)) {
                continue;
            }
            if (this.match(TokenKind::GREATER)) {
                return args;
            }
            if (this.match(TokenKind::GREATER_GREATER)) {
                this.half_greater = true;
                return args;
            }
            this.fail("expected '>' after type arguments");
        }
        return args;
    }

    unsafe GenericParams* parse_generic_params() {
        GenericParams* params = GenericParams.create();
        IdList* names = params.names;
        PointerList* value_types = params.value_types;
        this.expect(TokenKind::LESS, "expected '<'");
        while (!this.failed) {
            mut TypeRef* value_type = (TypeRef*)0;
            if (this.check(TokenKind::IDENTIFIER) && this.kind_of(this.peek_token(1)) == TokenKind::IDENTIFIER) {
                value_type = this.parse_type();
            }
            i32 token = this.expect(TokenKind::IDENTIFIER, "expected a type parameter name");
            names.push(this.atom_of(token));
            value_types.push((ptr)value_type);
            if (this.match(TokenKind::COMMA)) {
                continue;
            }
            this.expect(TokenKind::GREATER, "expected '>' after type parameters");
            break;
        }
        return params;
    }

    void parse_where_clauses(GenericParams* params) {
        while (this.match(TokenKind::WHERE)) {
            i32 token = this.expect(TokenKind::IDENTIFIER, "expected a type parameter after 'where'");
            i32 owner = params.index_of(this.atom_of(token));
            if (owner < 0) {
                this.fail("'where' names an unknown type parameter");
                return;
            }
            this.expect(TokenKind::COLON, "expected ':' after the constrained type parameter");
            params.add_bound(owner, this.parse_type());
            while (this.match(TokenKind::COMMA)) {
                params.add_bound(owner, this.parse_type());
            }
            if (this.check(TokenKind::SEMICOLON) && this.kind_of(this.peek_token(1)) == TokenKind::WHERE) {
                this.advance();
            }
        }
    }

    // '{ i32 result, f32 other }': a struct declared in place. Its name comes from the shape, so every
    // spelling of the same fields is the same type; the declaration is queued next to the one that uses it.
    unsafe TypeRef* parse_anonymous_struct() {
        i32 start = this.advance();
        Node* node = Node.create_list(NodeKind::STRUCT_DECL, start);
        ByteBuffer* shape = ByteBuffer.create();
        while (!this.check(TokenKind::RBRACE) && !this.at_end() && !this.failed) {
            Node* field = Node.create(NodeKind::FIELD_DECL, this.current());
            TypeRef* field_type = this.parse_type();
            field.set_type(field_type);
            i32 field_name = this.expect(TokenKind::IDENTIFIER, "expected a field name");
            field.set_text(this.copy_of(field_name));
            field_type.describe(shape);
            shape.append_char(' ');
            shape.append(field.text());
            shape.append_char(';');
            node.add(field);
            if (!this.match(TokenKind::COMMA)) {
                break;
            }
        }
        this.expect(TokenKind::RBRACE, "expected '}' to close the anonymous struct");
        if (node.length() == 0) {
            this.fail("an anonymous struct needs at least one field");
        }
        mut u64w hash = 14695981039346656037;
        ptr<i8> text = shape.cstr();
        i32 length = strlen(text);
        for (mut i32 i = 0; i < length; i = i + 1) {
            hash = (hash ^ (u64w)(u8)text[i]) * 1099511628211;
        }
        ByteBuffer* name = ByteBuffer.create();
        name.append("__anon_");
        name.append_int((i64)(hash >> 2));
        node.set_text(Strings.duplicate(name.cstr(), strlen(name.cstr())));
        if (this.extra_declarations == null) {
            this.extra_declarations = PointerList.create();
        }
        PointerList* pending = this.extra_declarations;
        pending.push((ptr)node);
        TypeRef* result = TypeRef.named(node.text());
        return result;
    }

    unsafe TypeRef* parse_type() {
        i32 token = this.current();
        mut TypeRef* base = (TypeRef*)0;

        if (this.is_fn_type_start(0)) {
            return this.parse_fn_type();
        }
        if (this.kind_of(token) == TokenKind::LBRACE) {
            return this.parse_anonymous_struct();
        }
        if (this.kind_of(token) == TokenKind::VOID || this.kind_of(token) == TokenKind::AUTO) {
            this.advance();
            base = TypeRef.from_primitive_atom(this.atom_of(token));
        } else if (this.is_ptr_keyword(token)) {
            this.advance();
            if (this.check(TokenKind::LESS)) {
                PointerList* pointee = this.parse_type_arguments();
                base = TypeRef.raw_pointer_to((TypeRef*)pointee.get(0));
            } else {
                base = TypeRef.raw_pointer_to(TypeRef.create(TypeKind.VOID));
            }
        } else if (this.kind_of(token) == TokenKind::IDENTIFIER) {
            TypeRef* primitive = TypeRef.from_primitive_atom(this.atom_of(token));
            if (primitive != null) {
                this.advance();
                base = primitive;
            } else {
                base = TypeRef.named(this.qualified_name());
            }
        } else {
            this.fail("expected a type");
            return TypeRef.create(TypeKind.VOID);
        }

        if (this.check(TokenKind::LESS) && base.kind == TypeKind.NAMED) {
            base.args = this.parse_type_arguments();
        }

        while (this.match(TokenKind::STAR)) {
            base = TypeRef.pointer_to(base);
        }

        while (this.check(TokenKind::LBRACKET)) {
            if (this.kind_of(this.peek_token(1)) != TokenKind::RBRACKET) {
                if (this.scan_inline_array_size(1) < 0) {
                    break;
                }
                this.advance();
                TypeRef* size = this.parse_template_argument();
                this.expect(TokenKind::RBRACKET, "expected ']' after the size of the inline array");
                base = TypeRef.inline_array(base, size);
                continue;
            }
            this.advance();
            this.advance();
            TypeRef* array = TypeRef.named("arr");
            PointerList* element = PointerList.create();
            element.push((ptr)base);
            array.args = element;
            base = array;
        }

        if (this.match(TokenKind::QUESTION)) {
            base.nullable = true;
        }
        return base;
    }
}
