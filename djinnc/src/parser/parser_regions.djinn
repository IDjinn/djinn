namespace djinnc;

impl Parser {
    // 'atomic (operands) { ... } after_commit { ... }', 'atomic { ... }' and 'cooperative { ... }' (contextual words).
    bool at_region() {
        i32 token = this.current();
        if (this.kind_of(token) != TokenKind::IDENTIFIER) {
            return false;
        }
        bool atomic = Strings.equals(this.text_of(token), this.length_of(token), "atomic");
        bool cooperative = Strings.equals(this.text_of(token), this.length_of(token), "cooperative");
        if (!atomic && !cooperative) {
            return false;
        }
        TokenKind next = this.kind_of(this.peek_token(1));
        if (next == TokenKind::LBRACE) {
            return true;
        }
        if (!atomic || next != TokenKind::LPAREN) {
            return false;
        }
        mut i32 depth = 0;
        for (mut i32 ahead = 1; this.kind_of(this.peek_token(ahead)) != TokenKind::END_OF_FILE; ahead = ahead + 1) {
            TokenKind kind = this.kind_of(this.peek_token(ahead));
            if (kind == TokenKind::LPAREN) {
                depth = depth + 1;
            } else if (kind == TokenKind::RPAREN) {
                depth = depth - 1;
                if (depth == 0) {
                    return this.kind_of(this.peek_token(ahead + 1)) == TokenKind::LBRACE;
                }
            }
        }
        return false;
    }

    // op 0 is an atomic region, op 1 a cooperative one; second holds the operands, third the after_commit block.
    unsafe Node* parse_region() {
        i32 start = this.advance();
        Node* region = Node.create(NodeKind::ATOMIC_STMT, start);
        Node* operands = Node.create_list(NodeKind::BLOCK, start);
        if (Strings.equals(this.text_of(start), this.length_of(start), "cooperative")) {
            region.set_op(1);
        } else if (this.match(TokenKind::LPAREN)) {
            if (!this.check(TokenKind::RPAREN)) {
                operands.add(this.parse_expression());
                while (this.match(TokenKind::COMMA)) {
                    operands.add(this.parse_expression());
                }
            }
            this.expect(TokenKind::RPAREN, "expected ')' after the atomic operands");
        }
        region.set_second(operands);
        region.set_first(this.parse_block());
        i32 next = this.current();
        if (region.op() == 0 && this.kind_of(next) == TokenKind::IDENTIFIER && Strings.equals(this.text_of(next), this.length_of(next), "after_commit")
            && this.kind_of(this.peek_token(1)) == TokenKind::LBRACE) {
            this.advance();
            region.set_third(this.parse_block());
        }
        return region;
    }
}
