namespace djinnc;

unsafe static mut ptr invariant_structs = null;

struct StructInvariants {
    static unsafe IdList* structs() {
        if (invariant_structs == null) {
            invariant_structs = (ptr)IdList.create();
        }
        return (IdList*)invariant_structs;
    }

    public static unsafe void mark(Node* declaration) {
        IdList* marked = StructInvariants.structs();
        marked.push((u32)Ast.id_of(declaration));
    }

    public static unsafe bool declared(Node* declaration) {
        IdList* marked = StructInvariants.structs();
        u32 id = (u32)Ast.id_of(declaration);
        for (mut i32 i = 0; i < marked.length; i = i + 1) {
            if (marked.get(i) == id) {
                return true;
            }
        }
        return false;
    }
}
