namespace djinnc;

impl Parser {
    Node* parse_enum() {
        bool is_union = this.is_union_keyword(this.current());
        i32 start = this.advance();
        Node* node = Node.create_list(NodeKind::STRUCT_DECL, start);
        node.set_flag(true);
        if (is_union) {
            node.set_op(1);
        }
        i32 name = this.expect(TokenKind::IDENTIFIER, "expected enum name");
        node.set_text(this.copy_of(name));

        mut i32 header_count = 0;
        if (this.match(TokenKind::LPAREN)) {
            while (!this.check(TokenKind::RPAREN) && !this.at_end()) {
                i32 field_token = this.current();
                Node* header_field = Node.create(NodeKind::PARAMETER, field_token);
                header_field.set_type(this.parse_type());
                i32 field_name = this.expect(TokenKind::IDENTIFIER, "expected an enum field name");
                header_field.set_text(this.copy_of(field_name));
                node.add(header_field);
                header_count = header_count + 1;
                if (!this.match(TokenKind::COMMA)) {
                    break;
                }
            }
            this.expect(TokenKind::RPAREN, "expected ')' after the enum fields");
        }

        if (this.check(TokenKind::LESS)) {
            node.set_generics(this.parse_generic_params());
        }
        this.parse_bases_and_constraints(node);

        this.expect(TokenKind::LBRACE, "expected '{' to open enum body");
        mut i64 next_value = 0;
        while (!this.check(TokenKind::RBRACE) && !this.at_end()) {
            i32 variant = this.expect(TokenKind::IDENTIFIER, "expected enum variant name");
            if (this.match(TokenKind::EQUAL)) {
                i32 literal_token = this.expect(TokenKind::INTEGER_LITERAL, "expected an integer enum value");
                next_value = Strings.parse_integer(this.text_of(literal_token), this.length_of(literal_token));
            }
            Node* constant = Node.create_list(NodeKind::FIELD_DECL, variant);
            if (header_count > 0) {
                constant.set_op(header_count);
                if (this.match(TokenKind::LPAREN)) {
                    while (!this.check(TokenKind::RPAREN) && !this.at_end()) {
                        constant.add(this.parse_expression());
                        if (!this.match(TokenKind::COMMA)) {
                            break;
                        }
                    }
                    this.expect(TokenKind::RPAREN, "expected ')' after the enum variant values");
                }
                if (constant.count() > 0) {
                    Node* flag = constant.child(0);
                    if (flag.kind() == NodeKind::INT_LITERAL) {
                        next_value = flag.int_value();
                    } else if (flag.kind() == NodeKind::UNARY && flag.op_kind() == TokenKind::MINUS) {
                        Node* magnitude = flag.first();
                        if (magnitude.kind() == NodeKind::INT_LITERAL) {
                            next_value = 0 - magnitude.int_value();
                        }
                    }
                }
            }
            constant.set_flag(true);
            constant.set_type(TypeRef.integer(32, true));
            constant.set_text(this.copy_of(variant));
            Node* value = Node.create(NodeKind::INT_LITERAL, variant);
            value.set_int_value(next_value);
            constant.set_first(value);

            if (header_count == 0 && this.match(TokenKind::LPAREN)) {
                while (!this.check(TokenKind::RPAREN) && !this.at_end()) {
                    i32 payload_token = this.current();
                    Node* payload = Node.create(NodeKind::PARAMETER, payload_token);
                    payload.set_type(this.parse_type());
                    payload.set_text("payload");
                    constant.add(payload);
                    if (!this.match(TokenKind::COMMA)) {
                        break;
                    }
                }
                this.expect(TokenKind::RPAREN, "expected ')' after enum variant payload");
            }
            node.add(constant);
            next_value = next_value + 1;

            if (!this.check(TokenKind::RBRACE)) {
                this.expect(TokenKind::COMMA, "expected ',' between enum variants");
            }
        }
        this.expect(TokenKind::RBRACE, "expected '}' to close enum body");
        return node;
    }

    Node* parse_interface() {
        i32 start = this.advance();
        Node* node = Node.create_list(NodeKind::INTERFACE_DECL, start);
        i32 name = this.expect(TokenKind::IDENTIFIER, "expected interface name");
        node.set_text(this.copy_of(name));

        if (this.check(TokenKind::LESS)) {
            node.set_generics(this.parse_generic_params());
        }
        this.parse_bases_and_constraints(node);

        this.expect(TokenKind::LBRACE, "expected '{' to open interface body");
        while (!this.check(TokenKind::RBRACE) && !this.at_end()) {
            this.parse_interface_member(node);
        }
        this.expect(TokenKind::RBRACE, "expected '}' to close interface body");
        return node;
    }

    void parse_interface_member(Node* owner) {
        i32 start = this.current();
        if (this.check(TokenKind::OPERATOR)) {
            owner.add(this.parse_operator(false));
            return;
        }
        TypeRef* type = this.parse_type();
        i32 name = this.expect(TokenKind::IDENTIFIER, "expected interface member name");
        if (this.check(TokenKind::LPAREN) || this.check(TokenKind::LESS)) {
            Node* method = Node.create_list(NodeKind::FUNCTION, start);
            method.set_type(type);
            method.set_text(this.copy_of(name));
            if (this.check(TokenKind::LESS)) {
                method.set_generics(this.parse_generic_params());
            }
            this.expect(TokenKind::LPAREN, "expected '(' after the method name");
            this.parse_parameters(method);
            this.expect(TokenKind::RPAREN, "expected ')' after parameters");
            this.expect(TokenKind::SEMICOLON, "expected ';' after interface method");
            owner.add(method);
            return;
        }
        Node* field = Node.create(NodeKind::FIELD_DECL, start);
        field.set_type(type);
        field.set_text(this.copy_of(name));
        this.expect(TokenKind::SEMICOLON, "expected ';' after interface field");
        owner.add(field);
    }

    unsafe Node* parse_impl() {
        i32 start = this.advance();
        Node* node = Node.create_list(NodeKind::IMPL_DECL, start);
        PointerList* targets = PointerList.create();
        i32 first_token = this.current();
        TypeRef* first = this.parse_type();
        if (this.check(TokenKind::COMMA) || this.check(TokenKind::FOR)) {
            Node* contract = Node.create(NodeKind::PARAMETER, first_token);
            contract.set_type(first);
            node.add(contract);
            while (this.match(TokenKind::COMMA)) {
                Node* more = Node.create(NodeKind::PARAMETER, this.current());
                more.set_type(this.parse_type());
                node.add(more);
            }
            this.expect(TokenKind::FOR, "expected 'for' after the interfaces of an impl");
            node.set_type(this.parse_type());
            while (this.match(TokenKind::COMMA)) {
                targets.push((ptr)this.parse_type());
            }
        } else {
            node.set_type(first);
        }

        this.expect(TokenKind::LBRACE, "expected '{' to open impl body");
        TypeRef* impl_target = node.type();
        bool generic_impl = impl_target != null && impl_target.args != null;
        if (generic_impl) {
            this.generic_depth = this.generic_depth + 1;
        }
        while (!this.check(TokenKind::RBRACE) && !this.at_end()) {
            this.parse_member(node);
        }
        if (generic_impl) {
            this.generic_depth = this.generic_depth - 1;
        }
        this.expect(TokenKind::RBRACE, "expected '}' to close impl body");
        for (mut i32 t = 0; t < targets.length; t = t + 1) {
            Node* copy = Node.clone(node);
            copy.set_type((TypeRef*)targets.get(t));
            Attributes.copy_tree(node, copy);
            if (this.extra_declarations == null) {
                this.extra_declarations = PointerList.create();
            }
            PointerList* pending = this.extra_declarations;
            pending.push((ptr)copy);
        }
        return node;
    }

    void parse_bases_and_constraints(Node* node) {
        mut bool has_base = false;
        while (!this.failed) {
            if (this.check(TokenKind::COLON)) {
                this.advance();
                this.match(TokenKind::INTERFACE);
                TypeRef* first = this.parse_type();
                if (has_base) {
                    Node* extra = Node.create(NodeKind::PARAMETER, this.current());
                    extra.set_type(first);
                    node.add(extra);
                } else {
                    node.set_type(first);
                    has_base = true;
                }
                while (this.match(TokenKind::COMMA)) {
                    this.match(TokenKind::INTERFACE);
                    Node* base = Node.create(NodeKind::PARAMETER, this.current());
                    base.set_type(this.parse_type());
                    node.add(base);
                }
            } else if (this.check(TokenKind::WHERE)) {
                GenericParams* params = node.generics();
                if (params == null) {
                    this.fail("'where' needs a generic declaration");
                    return;
                }
                this.parse_where_clauses(params);
            } else {
                return;
            }
        }
    }

    Node* parse_struct() {
        i32 start = this.advance();
        Node* node = Node.create_list(NodeKind::STRUCT_DECL, start);
        i32 name = this.expect(TokenKind::IDENTIFIER, "expected struct name");
        node.set_text(this.copy_of(name));

        mut bool generic_struct = false;
        if (this.check(TokenKind::LESS)) {
            node.set_generics(this.parse_generic_params());
            generic_struct = true;
        }
        this.parse_bases_and_constraints(node);

        if (this.match(TokenKind::SEMICOLON)) {
            return node;
        }

        this.expect(TokenKind::LBRACE, "expected '{' to open struct body");
        if (generic_struct) {
            this.generic_depth = this.generic_depth + 1;
        }
        while (!this.check(TokenKind::RBRACE) && !this.at_end()) {
            this.parse_member(node);
        }
        if (generic_struct) {
            this.generic_depth = this.generic_depth - 1;
        }
        this.expect(TokenKind::RBRACE, "expected '}' to close struct body");
        return node;
    }

    void parse_struct_member(Node* owner) {
        i32 start = this.current();
        mut i32 lookahead = 0;
        while (this.kind_of(this.peek_token(lookahead)) == TokenKind::PUBLIC || this.kind_of(this.peek_token(lookahead)) == TokenKind::PRIVATE
            || this.kind_of(this.peek_token(lookahead)) == TokenKind::STATIC || this.kind_of(this.peek_token(lookahead)) == TokenKind::MUT
            || this.kind_of(this.peek_token(lookahead)) == TokenKind::UNSAFE
            || this.kind_of(this.peek_token(lookahead)) == TokenKind::CONSTEXPR
            || this.kind_of(this.peek_token(lookahead)) == TokenKind::CONSTEVAL
            || this.kind_of(this.peek_token(lookahead)) == TokenKind::ASYNC) {
            lookahead = lookahead + 1;
        }
        i32 head = this.peek_token(lookahead);

        if (this.kind_of(head) == TokenKind::CONST) {
            for (mut i32 i = 0; i < lookahead; i = i + 1) {
                if (this.kind_of(this.current()) == TokenKind::MUT) {
                    this.diagnostics.error(DiagnosticErrors.MUTABLE_CONSTANT, this.line_of(this.current()), this.column_of(this.current()), "a constant cannot be 'mut'");
                }
                this.advance();
            }
            this.advance();
            Node* constant = Node.create(NodeKind::FIELD_DECL, head);
            constant.set_flag(true);
            constant.set_type(this.parse_type());
            i32 constName = this.expect(TokenKind::IDENTIFIER, "expected constant name");
            constant.set_text(this.copy_of(constName));
            this.expect(TokenKind::EQUAL, "expected '=' in constant declaration");
            constant.set_first(this.parse_expression());
            this.expect(TokenKind::SEMICOLON, "expected ';' after constant");
            owner.add(constant);
            return;
        }

        i32 afterHead = this.peek_token(lookahead + 1);
        bool isConstructor = this.kind_of(head) == TokenKind::IDENTIFIER && this.kind_of(afterHead) == TokenKind::LPAREN;
        if (isConstructor) {
            for (mut i32 i = 0; i < lookahead; i = i + 1) {
                this.advance();
            }
            this.advance();
            Node* constructor = Node.create_list(NodeKind::FUNCTION, head);
            constructor.set_type(TypeRef.create(TypeKind.VOID));
            constructor.set_text(".ctor");
            this.expect(TokenKind::LPAREN, "expected '(' after the constructor name");
            this.parse_parameters(constructor);
            this.expect(TokenKind::RPAREN, "expected ')' after parameters");
            constructor.set_first(this.parse_body(true));
            owner.add(constructor);
            return;
        }

        if (this.kind_of(head) == TokenKind::OPERATOR) {
            for (mut i32 i = 0; i < lookahead; i = i + 1) {
                this.advance();
            }
            owner.add(this.parse_operator(true));
            return;
        }

        mut i32 typeEnd = this.scan_type_end(lookahead);
        if (typeEnd < 0) {
            this.fail("expected a struct member");
            return;
        }

        i32 afterType = this.peek_token(typeEnd);
        i32 afterName = this.peek_token(typeEnd + 1);
        bool genericMethod = this.kind_of(afterName) == TokenKind::LESS && this.scan_generic_head(typeEnd + 1);
        if (this.kind_of(afterType) == TokenKind::IDENTIFIER && (this.kind_of(afterName) == TokenKind::LPAREN || genericMethod)) {
            Node* method = this.parse_function(false);
            if (method != null) {
                owner.add(method);
            }
            return;
        }

        bool isProperty = this.kind_of(afterType) == TokenKind::IDENTIFIER
            && (this.kind_of(afterName) == TokenKind::LBRACE || this.kind_of(afterName) == TokenKind::ARROW);
        if (isProperty) {
            for (mut i32 i = 0; i < lookahead; i = i + 1) {
                this.advance();
            }
            this.parse_property(owner);
            return;
        }

        mut bool mutable_field = false;
        for (mut i32 i = 0; i < lookahead; i = i + 1) {
            if (this.kind_of(this.current()) == TokenKind::MUT) {
                mutable_field = true;
            }
            this.advance();
        }
        Node* field = Node.create(NodeKind::FIELD_DECL, start);
        if (mutable_field || this.match(TokenKind::MUT)) {
            field.set_flag(true);
        }
        field.set_type(this.parse_type());
        i32 fieldName = this.expect(TokenKind::IDENTIFIER, "expected field name");
        field.set_text(this.copy_of(fieldName));
        this.expect(TokenKind::SEMICOLON, "expected ';' after field");
        owner.add(field);
    }

    Node* property_return(i32 at, Node* value) {
        Node* body = Node.create_list(NodeKind::BLOCK, at);
        Node* ret = Node.create(NodeKind::RETURN, at);
        ret.set_first(value);
        body.add(ret);
        return body;
    }

    unsafe Node* backing_access(i32 at, ptr<i8> field_name) {
        Node* self = Node.create(NodeKind::IDENTIFIER, at);
        self.set_text("this");
        Node* access = Node.create(NodeKind::FIELD_ACCESS, at);
        access.set_first(self);
        access.set_text(field_name);
        return access;
    }

    unsafe Node* property_method(i32 at, ptr<i8> prefix, ptr<i8> name, TypeRef* type, bool setter, Node* body) {
        Node* method = Node.create_list(NodeKind::FUNCTION, at);
        ByteBuffer* full = ByteBuffer.create();
        full.append(prefix);
        full.append(name);
        method.set_text(full.cstr());
        if (setter) {
            method.set_type(TypeRef.create(TypeKind.VOID));
            Node* parameter = Node.create(NodeKind::PARAMETER, at);
            parameter.set_type(type);
            parameter.set_text("value");
            method.add(parameter);
        } else {
            method.set_type(type);
        }
        method.set_first(body);
        return method;
    }

    unsafe void parse_property(Node* owner) {
        i32 start = this.current();
        TypeRef* type = this.parse_type();
        i32 name_token = this.expect(TokenKind::IDENTIFIER, "expected property name");
        ptr<i8> name = this.copy_of(name_token);
        ByteBuffer* backing = ByteBuffer.create();
        backing.append("__prop_");
        backing.append(name);
        mut Node* getter_body = (Node*)0;
        mut Node* setter_body = (Node*)0;
        mut bool auto_get = false;
        mut bool auto_set = false;

        if (this.match(TokenKind::ARROW)) {
            getter_body = this.property_return(start, this.parse_expression());
            this.expect(TokenKind::SEMICOLON, "expected ';' after property expression");
        } else {
            this.expect(TokenKind::LBRACE, "expected '{' to open the property");
            while (!this.check(TokenKind::RBRACE) && !this.at_end() && !this.failed) {
                while (this.check(TokenKind::PUBLIC) || this.check(TokenKind::PRIVATE)) {
                    this.advance();
                }
                i32 accessor = this.expect(TokenKind::IDENTIFIER, "expected 'get' or 'set'");
                bool is_get = Strings.equals(this.text_of(accessor), this.length_of(accessor), "get");
                bool is_set = Strings.equals(this.text_of(accessor), this.length_of(accessor), "set");
                if (!is_get && !is_set) {
                    this.fail("expected 'get' or 'set' in a property");
                    return;
                }
                mut Node* body = (Node*)0;
                mut bool automatic = false;
                if (this.match(TokenKind::SEMICOLON)) {
                    automatic = true;
                } else if (this.match(TokenKind::ARROW)) {
                    i32 arrow = this.current();
                    Node* expression = this.parse_expression();
                    this.expect(TokenKind::SEMICOLON, "expected ';' after accessor expression");
                    if (is_get) {
                        body = this.property_return(arrow, expression);
                    } else {
                        body = Node.create_list(NodeKind::BLOCK, arrow);
                        Node* statement = Node.create(NodeKind::EXPR_STMT, arrow);
                        statement.set_first(expression);
                        body.add(statement);
                    }
                } else {
                    body = this.parse_body(true);
                }
                if (is_get) {
                    getter_body = body;
                    auto_get = automatic;
                } else {
                    setter_body = body;
                    auto_set = automatic;
                }
            }
            this.expect(TokenKind::RBRACE, "expected '}' to close the property");
        }

        if (auto_get || auto_set) {
            Node* field = Node.create(NodeKind::FIELD_DECL, start);
            field.set_flag(true);
            field.set_type(type);
            field.set_text(backing.cstr());
            owner.add(field);
        }
        if (auto_get) {
            getter_body = this.property_return(start, this.backing_access(start, backing.cstr()));
        }
        if (auto_set) {
            Node* assign = Node.create(NodeKind::ASSIGN, start);
            assign.set_first(this.backing_access(start, backing.cstr()));
            Node* value = Node.create(NodeKind::IDENTIFIER, start);
            value.set_text("value");
            assign.set_second(value);
            setter_body = Node.create_list(NodeKind::BLOCK, start);
            Node* statement = Node.create(NodeKind::EXPR_STMT, start);
            statement.set_first(assign);
            setter_body.add(statement);
        }
        if (getter_body == null) {
            this.fail("a property needs a getter");
            return;
        }
        owner.add(this.property_method(start, "get:", name, type, false, getter_body));
        if (setter_body != null) {
            owner.add(this.property_method(start, "set:", name, type, true, setter_body));
        }
    }
}
