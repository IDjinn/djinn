namespace djinnc;

struct FunctionContracts {
    PointerList* requires;
    PointerList* ensures;
    PointerList* captures;

    public static unsafe FunctionContracts* create(PointerList* requires, PointerList* ensures, PointerList* captures) {
        FunctionContracts* contracts = (FunctionContracts*)Memory.zalloc(sizeof(FunctionContracts));
        contracts.requires = requires;
        contracts.ensures = ensures;
        contracts.captures = captures;
        return contracts;
    }
}
