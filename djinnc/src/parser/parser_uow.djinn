namespace djinnc;

impl Parser {
    bool at_uow_declaration() {
        i32 token = this.current();
        return this.kind_of(token) == TokenKind::IDENTIFIER && Strings.equals(this.text_of(token), this.length_of(token), "uow")
            && this.kind_of(this.peek_token(1)) == TokenKind::IDENTIFIER && this.kind_of(this.peek_token(2)) == TokenKind::LBRACE;
    }

    bool at_clause_word(ptr<i8> word) {
        i32 token = this.current();
        return this.kind_of(token) == TokenKind::IDENTIFIER && Strings.equals(this.text_of(token), this.length_of(token), word)
            && this.kind_of(this.peek_token(1)) == TokenKind::LPAREN;
    }

    // The text between the parentheses of 'word( ... )', kept as written.
    unsafe ptr<i8> parse_text_clause() {
        this.advance();
        this.expect(TokenKind::LPAREN, "expected '(' after the clause name");
        i32 first = this.current();
        mut i32 depth = 1;
        mut i32 last = first;
        while (!this.at_end() && !this.failed) {
            TokenKind kind = this.kind_of(this.current());
            if (kind == TokenKind::LPAREN) {
                depth = depth + 1;
            } else if (kind == TokenKind::RPAREN) {
                depth = depth - 1;
                if (depth == 0) {
                    break;
                }
            }
            last = this.advance();
        }
        this.expect(TokenKind::RPAREN, "expected ')' to close the clause");
        if (last < first) {
            return "";
        }
        return this.clause_text(first, last);
    }

    // uow Name { Type [mut] participant; require(...) ensure(...) writes(...) access(...) ordering(...) isolation(...) }
    unsafe Node* parse_uow_declaration() {
        i32 start = this.advance();
        i32 name = this.expect(TokenKind::IDENTIFIER, "expected the name of the uow");
        this.expect(TokenKind::LBRACE, "expected '{' after the uow name");
        UowDeclaration* uow = (UowDeclaration*)Memory.zalloc(sizeof(UowDeclaration));
        uow.name = this.copy_of(name);
        uow.token = start;
        uow.participants = PointerList.create();
        uow.requires = PointerList.create();
        uow.ensures = PointerList.create();
        uow.captures = PointerList.create();
        uow.writes = PointerList.create();
        while (!this.check(TokenKind::RBRACE) && !this.at_end() && !this.failed) {
            if (this.check(TokenKind::REQUIRE)) {
                PointerList* found = this.parse_clauses(TokenKind::REQUIRE, Intrinsic.REQUIRE_CLAUSE);
                this.append_all(uow.requires, found);
            } else if (this.check(TokenKind::ENSURE)) {
                PointerList* saved = this.old_captures;
                this.old_captures = PointerList.create();
                bool was_in_ensure = this.in_ensure;
                this.in_ensure = true;
                PointerList* found = this.parse_clauses(TokenKind::ENSURE, Intrinsic.ENSURE_CLAUSE);
                this.in_ensure = was_in_ensure;
                this.append_all(uow.ensures, found);
                this.append_all(uow.captures, this.old_captures);
                this.old_captures = saved;
            } else if (this.at_writes_clause()) {
                PointerList* places = this.parse_writes();
                uow.has_writes = true;
                if (places != null) {
                    this.append_all(uow.writes, places);
                }
            } else if (this.at_clause_word("access")) {
                uow.access = this.parse_text_clause();
            } else if (this.at_clause_word("ordering")) {
                uow.ordering = this.parse_text_clause();
            } else if (this.at_clause_word("isolation")) {
                uow.isolation_token = this.current();
                uow.isolation = this.parse_text_clause();
            } else {
                this.match(TokenKind::MUT);
                TypeRef* type = this.parse_type();
                this.match(TokenKind::MUT);
                i32 participant_name = this.expect(TokenKind::IDENTIFIER, "expected the name of the participant");
                this.expect(TokenKind::SEMICOLON, "expected ';' after the participant");
                Node* participant = Node.create(NodeKind::PARAMETER, participant_name);
                participant.set_type(type);
                participant.set_text(this.copy_of(participant_name));
                uow.participants.push((ptr)participant);
            }
        }
        this.expect(TokenKind::RBRACE, "expected '}' to close the uow");
        if (UowDeclaration.find(uow.name) != null) {
            this.diagnostics.error(DiagnosticErrors.UOW_DECLARATION, this.line_of(start), this.column_of(start), "a uow with this name is already declared");
        } else {
            PointerList* all = UowDeclaration.all();
            all.push((ptr)uow);
        }
        return (Node*)0;
    }

    unsafe void append_all(PointerList* target, PointerList* source) {
        for (mut i32 i = 0; i < source.length; i = i + 1) {
            target.push(source.get(i));
        }
    }

    // uow(Name) strategy cooperative, after the contract clauses of a method.
    unsafe void parse_uow_use() {
        this.uow_name = (ptr<i8>)0;
        this.uow_strategy = (ptr<i8>)0;
        if (!this.at_clause_word("uow")) {
            return;
        }
        this.uow_token = this.advance();
        this.advance();
        i32 name = this.expect(TokenKind::IDENTIFIER, "expected the name of the uow");
        this.expect(TokenKind::RPAREN, "expected ')' after the uow name");
        this.uow_name = this.copy_of(name);
        i32 next = this.current();
        if (this.kind_of(next) == TokenKind::IDENTIFIER && Strings.equals(this.text_of(next), this.length_of(next), "strategy")
            && this.kind_of(this.peek_token(1)) == TokenKind::IDENTIFIER) {
            this.advance();
            this.uow_strategy = this.copy_of(this.advance());
        }
    }

    unsafe void record_uow_use(Node* function) {
        if (this.uow_name == null) {
            return;
        }
        AttributeUse* use = (AttributeUse*)Memory.zalloc(sizeof(AttributeUse));
        use.target = function;
        use.name = "uow_use";
        use.target_kind = AttributeTarget.FUNCTION;
        use.text_arg = this.uow_name;
        use.int_arg = (i64)this.uow_token;
        use.line = this.line_of(this.uow_token);
        use.column = this.column_of(this.uow_token);
        if (this.uow_strategy != null) {
            Node* strategy = Node.create(NodeKind::IDENTIFIER, this.uow_token);
            strategy.set_text(this.uow_strategy);
            use.payload = strategy;
        }
        Attributes.record(use);
        this.uow_name = (ptr<i8>)0;
        this.uow_strategy = (ptr<i8>)0;
    }

    unsafe void uow_error(PointerList* diagnostics_list, i32 token, i32 code, ptr<i8> message) {
        for (mut i32 i = 0; i < diagnostics_list.length; i = i + 1) {
            SourceFile* file = Sources.get(i);
            if (token >= file.first_token && token < file.token_end) {
                Diagnostics* diagnostics = (Diagnostics*)diagnostics_list.get(i);
                diagnostics.error(code, this.line_of(token), this.column_of(token), message);
                return;
            }
        }
        Diagnostics* fallback = (Diagnostics*)diagnostics_list.get(0);
        fallback.error(code, this.line_of(token), this.column_of(token), message);
    }

    // Rewrites every method that says uow(Name): the body becomes an atomic region over the uow's writes, the uow's
    // contracts wrap it, and its writes list becomes the writes clause the effects pass audits.
    public unsafe void lower_uows(PointerList* diagnostics_list) {
        this.check_uow_declarations(diagnostics_list);
        PointerList* uses = Attributes.all();
        i32 total = uses.length;
        for (mut i32 i = 0; i < total; i = i + 1) {
            AttributeUse* use = (AttributeUse*)uses.get(i);
            if (Strings.same(use.name, "uow_use")) {
                this.lower_uow(use, diagnostics_list);
            }
        }
    }

    unsafe Node* parameter_named(Node* function, ptr<i8> name) {
        for (mut i32 i = 0; i < function.count(); i = i + 1) {
            Node* parameter = function.child(i);
            if (parameter.kind() == NodeKind::PARAMETER && Strings.same(parameter.text(), name)) {
                return parameter;
            }
        }
        return (Node*)0;
    }

    static unsafe bool same_type(TypeRef* left, TypeRef* right) {
        ByteBuffer* first = ByteBuffer.create();
        left.describe(first);
        ByteBuffer* second = ByteBuffer.create();
        right.describe(second);
        return Strings.same(first.cstr(), second.cstr());
    }

    unsafe Node* operand_of(Node* place, Node* function) {
        NodeKind kind = place.kind();
        if (kind == NodeKind::UNARY && place.op_kind() == TokenKind::STAR) {
            return this.operand_of(place.first(), function);
        }
        if (kind == NodeKind::IDENTIFIER) {
            Node* identifier = Node.create(NodeKind::IDENTIFIER, place.token);
            identifier.set_text(place.text());
            Node* parameter = this.parameter_named(function, place.text());
            if (parameter != null && parameter.type() != null && parameter.type().is_pointer()) {
                Node* dereference = Node.create(NodeKind::UNARY, place.token);
                dereference.set_op_kind(TokenKind::STAR);
                dereference.set_first(identifier);
                return dereference;
            }
            return identifier;
        }
        if (kind == NodeKind::FIELD_ACCESS) {
            Node* access = Node.create(NodeKind::FIELD_ACCESS, place.token);
            access.set_text(place.text());
            mut Node* base = place.first();
            while (base.kind() == NodeKind::UNARY && base.op_kind() == TokenKind::STAR) {
                base = base.first();
            }
            if (base.kind() == NodeKind::FIELD_ACCESS) {
                access.set_first(this.operand_of(base, function));
            } else {
                Node* root = Node.create(NodeKind::IDENTIFIER, base.token);
                root.set_text(base.text());
                access.set_first(root);
            }
            return access;
        }
        return (Node*)0;
    }

    unsafe ptr<i8> root_name(Node* place) {
        mut Node* current = place;
        while (current != null && current.kind() != NodeKind::IDENTIFIER) {
            current = current.first();
        }
        if (current == null) {
            return (ptr<i8>)0;
        }
        return current.text();
    }

    unsafe void lower_uow(AttributeUse* use, PointerList* diagnostics_list) {
        Node* function = use.target;
        i32 token = (i32)use.int_arg;
        UowDeclaration* uow = UowDeclaration.find(use.text_arg);
        if (uow == null) {
            this.uow_error(diagnostics_list, token, DiagnosticErrors.UOW_DECLARATION, "unknown uow: declare it with 'uow Name { ... }'");
            return;
        }
        if (function.first() == null) {
            this.uow_error(diagnostics_list, token, DiagnosticErrors.UOW_DECLARATION, "a method that uses a uow needs a body: the body is the region");
            return;
        }
        mut bool cooperative = false;
        if (use.payload == null) {
            this.uow_error(diagnostics_list, token, DiagnosticErrors.UOW_STRATEGY, "uow(Name) needs a strategy: write 'strategy cooperative'");
        } else if (Strings.same(use.payload.text(), "cooperative")) {
            cooperative = true;
        } else {
            this.uow_error(diagnostics_list, token, DiagnosticErrors.UOW_STRATEGY, "the only strategy for an in-memory uow is 'cooperative'");
        }
        if (uow.isolation != null && !(Strings.same(uow.isolation, "serializable") && cooperative)) {
            ByteBuffer* message = ByteBuffer.create();
            message.append("isolation(");
            message.append(uow.isolation);
            message.append(") has nothing to sustain it here: in memory only isolation(serializable) is accepted, and only with strategy cooperative");
            this.uow_error(diagnostics_list, token, DiagnosticErrors.UOW_STRATEGY, message.cstr());
        }
        mut bool bound = true;
        for (mut i32 i = 0; i < uow.participants.length; i = i + 1) {
            Node* participant = (Node*)uow.participants.get(i);
            Node* parameter = this.parameter_named(function, participant.text());
            ByteBuffer* message = ByteBuffer.create();
            if (parameter == null) {
                message.append("the uow participant '");
                message.append(participant.text());
                message.append("' has no parameter of that name in this method");
            } else if (parameter.type() == null || participant.type() == null || !Parser.same_type(parameter.type(), participant.type())) {
                message.append("the parameter '");
                message.append(participant.text());
                message.append("' does not have the type the uow declares for that participant");
            }
            if (message.length > 0) {
                bound = false;
                this.uow_error(diagnostics_list, token, DiagnosticErrors.UOW_BINDING, message.cstr());
            }
        }
        Node* operands = Node.create_list(NodeKind::BLOCK, token);
        for (mut i32 i = 0; i < uow.writes.length; i = i + 1) {
            Node* place = (Node*)uow.writes.get(i);
            ptr<i8> root = this.root_name(place);
            mut bool participant_found = false;
            for (mut i32 p = 0; p < uow.participants.length; p = p + 1) {
                Node* participant = (Node*)uow.participants.get(p);
                if (root != null && Strings.same(participant.text(), root)) {
                    participant_found = true;
                }
            }
            Node* operand = this.operand_of(place, function);
            if (!participant_found || operand == null) {
                bound = false;
                this.uow_error(diagnostics_list, place.token, DiagnosticErrors.UOW_BINDING, "writes names a participant of the uow, or a field of one");
                continue;
            }
            operands.add(operand);
        }
        if (!bound) {
            return;
        }
        Node* region = Node.create(NodeKind::ATOMIC_STMT, function.token);
        region.set_second(operands);
        region.set_first(function.first());
        Node* body = Node.create_list(NodeKind::BLOCK, function.token);
        body.add(region);
        PointerList* requires = PointerList.create();
        PointerList* ensures = PointerList.create();
        PointerList* captures = PointerList.create();
        for (mut i32 i = 0; i < uow.requires.length; i = i + 1) {
            requires.push((ptr)Node.clone((Node*)uow.requires.get(i)));
        }
        for (mut i32 i = 0; i < uow.ensures.length; i = i + 1) {
            ensures.push((ptr)Node.clone((Node*)uow.ensures.get(i)));
        }
        for (mut i32 i = 0; i < uow.captures.length; i = i + 1) {
            captures.push((ptr)Node.clone((Node*)uow.captures.get(i)));
        }
        function.set_first(this.with_contracts(function.token, function, body, FunctionContracts.create(requires, ensures, captures)));
        Node* list = Node.create_list(NodeKind::BLOCK, token);
        for (mut i32 i = 0; i < uow.writes.length; i = i + 1) {
            list.add((Node*)uow.writes.get(i));
        }
        AttributeUse* clause = (AttributeUse*)Memory.zalloc(sizeof(AttributeUse));
        clause.target = function;
        clause.name = "writes";
        clause.target_kind = AttributeTarget.FUNCTION;
        clause.payload = list;
        clause.line = use.line;
        clause.column = use.column;
        Attributes.record(clause);
    }
}
