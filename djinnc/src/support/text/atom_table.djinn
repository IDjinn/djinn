namespace djinnc;

struct AtomTable {
    Arena* arena;
    u32* slots;
    u32* hashes;
    i8** texts;
    u32* lengths;
    u32* bases;
    u32 count;
    u32 atom_capacity;
    u32 slot_capacity;

    public static AtomTable* create(Arena* arena) {
        AtomTable* table = (AtomTable*)arena.zalloc(sizeof(AtomTable), 8);
        table.arena = arena;
        table.atom_capacity = 512;
        table.slot_capacity = 1024;
        table.slots = (u32*)arena.zalloc((u64)table.slot_capacity * 4, 4);
        table.hashes = (u32*)arena.alloc((u64)table.atom_capacity * 4, 4);
        table.texts = (i8**)arena.alloc((u64)table.atom_capacity * 8, 8);
        table.lengths = (u32*)arena.alloc((u64)table.atom_capacity * 4, 4);
        table.bases = (u32*)arena.zalloc((u64)table.atom_capacity * 4, 4);
        return table;
    }

    public static u32 hash(i8* text, u32 length) {
        mut u64 value = 2166136261;
        for (mut u32 i = 0; i < length; i = i + 1) {
            u64 byte = (u64)text[i] & 255;
            value = ((value ^ byte) * 16777619) & Limits.U32_MAX;
        }
        return (u32)value;
    }

    public u32 intern(i8* text, u32 length) {
        u32 hash = AtomTable.hash(text, length);
        u32 slot = this.find_slot(hash, text, length);
        if (this.slots[slot] != 0) {
            return this.slots[slot] - 1;
        }
        return this.insert(slot, hash, text, length);
    }

    public u32 intern_copy(i8* text, u32 length) {
        u32 hash = AtomTable.hash(text, length);
        u32 slot = this.find_slot(hash, text, length);
        if (this.slots[slot] != 0) {
            return this.slots[slot] - 1;
        }
        Arena* arena = this.arena;
        i8* owned = (i8*)arena.zalloc((u64)length + 1, 1);
        memcpy(owned, text, (u64)length);
        return this.insert(slot, hash, owned, length);
    }

    u32 find_slot(u32 hash, i8* text, u32 length) {
        u32 mask = this.slot_capacity - 1;
        mut u32 slot = hash & mask;
        while (this.slots[slot] != 0) {
            u32 atom = this.slots[slot] - 1;
            if (this.hashes[atom] == hash && this.lengths[atom] == length) {
                if (memcmp(this.texts[atom], text, (u64)length) == 0) {
                    return slot;
                }
            }
            slot = (slot + 1) & mask;
        }
        return slot;
    }

    u32 insert(u32 slot, u32 hash, i8* text, u32 length) {
        if (this.count == this.atom_capacity) {
            this.grow_atoms();
        }
        u32 atom = this.count;
        this.count = this.count + 1;
        this.hashes[atom] = hash;
        this.texts[atom] = text;
        this.lengths[atom] = length;
        this.slots[slot] = atom + 1;

        if (this.count * 2 > this.slot_capacity) {
            this.rehash();
        }
        return atom;
    }

    public i8* text(u32 atom) {
        return this.texts[atom];
    }

    public u32 length(u32 atom) {
        return this.lengths[atom];
    }

    public u32 base_of(u32 atom) {
        if (this.bases[atom] != 0) {
            return this.bases[atom] - 1;
        }
        i8* text = this.texts[atom];
        i32 length = (i32)this.lengths[atom];
        mut i32 last = 0;
        for (mut i32 i = 0; i + 1 < length; i = i + 1) {
            if (text[i] == 58 && text[i + 1] == 58) {
                last = i + 2;
            }
        }
        mut u32 base = atom;
        if (last > 0) {
            base = this.intern_copy(text + last, (u32)(length - last));
        }
        this.bases[atom] = base + 1;
        return base;
    }

    void grow_atoms() {
        u32 capacity = this.atom_capacity * 2;
        Arena* arena = this.arena;
        u32* hashes = (u32*)arena.alloc((u64)capacity * 4, 4);
        i8** texts = (i8**)arena.alloc((u64)capacity * 8, 8);
        u32* lengths = (u32*)arena.alloc((u64)capacity * 4, 4);
        u32* bases = (u32*)arena.zalloc((u64)capacity * 4, 4);
        memcpy(bases, this.bases, (u64)this.count * 4);
        memcpy(hashes, this.hashes, (u64)this.count * 4);
        memcpy(texts, this.texts, (u64)this.count * 8);
        memcpy(lengths, this.lengths, (u64)this.count * 4);
        this.hashes = hashes;
        this.texts = texts;
        this.lengths = lengths;
        this.bases = bases;
        this.atom_capacity = capacity;
    }

    void rehash() {
        u32 capacity = this.slot_capacity * 2;
        Arena* arena = this.arena;
        u32* slots = (u32*)arena.zalloc((u64)capacity * 4, 4);
        u32 mask = capacity - 1;
        for (mut u32 atom = 0; atom < this.count; atom = atom + 1) {
            mut u32 slot = this.hashes[atom] & mask;
            while (slots[slot] != 0) {
                slot = (slot + 1) & mask;
            }
            slots[slot] = atom + 1;
        }
        this.slots = slots;
        this.slot_capacity = capacity;
    }
}
