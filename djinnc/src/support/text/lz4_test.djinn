namespace djinnc;

import testing;

struct Lz4Tests {
    // Compresses `data`, decodes it and requires the same bytes back.
    static unsafe bool round_trip(ptr<i8> data, i32 length) {
        ByteBuffer* packed = ByteBuffer.create();
        Lz4.compress(data, length, packed);
        ptr<i8> again = (ptr<i8>)Memory.zalloc((u64)length + 1);
        if (!Lz4.decompress(packed.data, packed.length, again, length)) {
            return false;
        }
        return memcmp(again, data, (u64)length) == 0;
    }

    // Pseudo random bytes with `period` (0 = no repetition) so matches of every distance and length appear.
    static unsafe ptr<i8> sample(i32 length, i32 period, u32 seed) {
        ptr<i8> data = (ptr<i8>)Memory.zalloc((u64)length + 1);
        mut u32w state = (u32w)seed;
        for (mut i32 i = 0; i < length; i = i + 1) {
            if (period > 0 && i >= period) {
                data[i] = data[i - period];
            } else {
                state = state * 1664525 + 1013904223;
                data[i] = (i8)(u8)((u32)(state >> 24));
            }
        }
        return data;
    }

    [Test]
    unsafe void empty_and_tiny_inputs_round_trip() {
        ptr<i8> data = Lz4Tests.sample(32, 0, 1);
        for (mut i32 length = 0; length <= 32; length = length + 1) {
            Expect.is_true(Lz4Tests.round_trip(data, length));
        }
    }

    [Test]
    unsafe void long_runs_round_trip() {
        ptr<i8> zeros = (ptr<i8>)Memory.zalloc(100001);
        Expect.is_true(Lz4Tests.round_trip(zeros, 100000));
        ByteBuffer* packed = ByteBuffer.create();
        Lz4.compress(zeros, 100000, packed);
        Expect.is_true(packed.length < 1000);
    }

    [Test]
    unsafe void random_data_round_trips() {
        for (mut i32 length = 1; length < 5000; length = length + 97) {
            ptr<i8> data = Lz4Tests.sample(length, 0, (u32)length);
            Expect.is_true(Lz4Tests.round_trip(data, length));
        }
    }

    [Test]
    unsafe void repeating_data_round_trips_for_every_distance() {
        for (mut i32 period = 1; period < 300; period = period + 7) {
            ptr<i8> data = Lz4Tests.sample(20000, period, (u32)period);
            Expect.is_true(Lz4Tests.round_trip(data, 20000));
        }
        // a distance past the 64 KiB window cannot be coded: those bytes must stay literals
        ptr<i8> far = Lz4Tests.sample(200000, 70000, 5);
        Expect.is_true(Lz4Tests.round_trip(far, 200000));
    }

    [Test]
    unsafe void malformed_blocks_are_rejected() {
        ptr<i8> out = (ptr<i8>)Memory.zalloc(64);
        // literal count larger than the input
        ptr<i8> truncated = (ptr<i8>)Memory.zalloc(4);
        truncated[0] = (i8)(u8)80;
        Expect.is_false(Lz4.decompress(truncated, 3, out, 5));
        // a match whose offset points before the start of the output
        ptr<i8> bad_offset = (ptr<i8>)Memory.zalloc(8);
        bad_offset[0] = (i8)(u8)16;
        bad_offset[1] = 65;
        bad_offset[2] = 9;
        bad_offset[3] = 0;
        Expect.is_false(Lz4.decompress(bad_offset, 4, out, 10));
        // the wrong decoded size
        ptr<i8> data = Lz4Tests.sample(100, 0, 3);
        ByteBuffer* packed = ByteBuffer.create();
        Lz4.compress(data, 100, packed);
        Expect.is_false(Lz4.decompress(packed.data, packed.length, out, 99));
    }
}
