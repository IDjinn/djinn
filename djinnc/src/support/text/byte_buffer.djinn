namespace djinnc;

struct ByteBuffer {
    i8* data;
    i32 length;
    i32 capacity;

    public static ByteBuffer* create() {
        ByteBuffer* buf = (ByteBuffer*)Memory.zalloc(sizeof(ByteBuffer));
        buf.capacity = 64;
        buf.data = (i8*)Memory.zalloc(64);
        return buf;
    }

    public void append_char(i32 c) {
        this.reserve(1);
        this.data[this.length] = (i8)c;
        this.length = this.length + 1;
    }

    public void append(i8* text) {
        i32 count = strlen(text);
        this.append_slice(text, count);
    }

    public void append_slice(i8* text, i32 count) {
        this.reserve(count);
        memcpy(this.data + this.length, text, (u64)count);
        this.length = this.length + count;
    }

    public void append_int(i64 value) {
        if (value < 0) {
            this.append_char(45);
            this.append_int(0 - value);
            return;
        }
        if (value >= 10) {
            this.append_int(value / 10);
        }
        this.append_char(48 + (i32)(value % 10));
    }

    public i8* cstr() {
        this.reserve(1);
        this.data[this.length] = 0;
        return this.data;
    }

    void reserve(i32 extra) {
        i32 needed = this.length + extra + 1;
        if (needed <= this.capacity) {
            return;
        }
        mut i32 newCapacity = this.capacity * 2;
        while (newCapacity < needed) {
            newCapacity = newCapacity * 2;
        }
        i8* newData = (i8*)Memory.zalloc((i64)newCapacity);
        memcpy(newData, this.data, (u64)this.length);
        this.data = newData;
        this.capacity = newCapacity;
    }
}
