namespace djinnc;

struct ByteBuffer {
    ptr<i8> data;
    i32 length;
    i32 capacity;

    public static unsafe ByteBuffer* create() {
        ByteBuffer* buf = (ByteBuffer*)Memory.zalloc(sizeof(ByteBuffer));
        buf.capacity = 64;
        buf.data = (ptr<i8>)Memory.zalloc(64);
        return buf;
    }

    public unsafe void append_byte(i32 value) {
        this.reserve(1);
        this.data[this.length] = (i8)(u8)(value & 255);
        this.length = this.length + 1;
    }

    public unsafe void append_char(char c) {
        this.append_byte((i32)c);
    }

    public unsafe void append_utf8(i64 code_point) {
        if (code_point < 128) {
            this.append_byte((i32)code_point);
        } else if (code_point < 2048) {
            this.append_byte((i32)(192 | (code_point >> 6)));
            this.append_byte((i32)(128 | (code_point & 63)));
        } else if (code_point < 65536) {
            this.append_byte((i32)(224 | (code_point >> 12)));
            this.append_byte((i32)(128 | ((code_point >> 6) & 63)));
            this.append_byte((i32)(128 | (code_point & 63)));
        } else {
            this.append_byte((i32)(240 | (code_point >> 18)));
            this.append_byte((i32)(128 | ((code_point >> 12) & 63)));
            this.append_byte((i32)(128 | ((code_point >> 6) & 63)));
            this.append_byte((i32)(128 | (code_point & 63)));
        }
    }

    public void append(ptr<i8> text) {
        i32 count = strlen(text);
        this.append_slice(text, count);
    }

    public unsafe void append_slice(ptr<i8> text, i32 count) {
        this.reserve(count);
        memcpy(this.data + this.length, text, (u64)count);
        this.length = this.length + count;
    }

    public void append_int(i64 value) {
        if (value < 0) {
            this.append_byte(45);
            this.append_unsigned(~(u64)value + 1);
            return;
        }
        this.append_unsigned((u64)value);
    }

    public unsafe void append_unsigned(u64 value) {
        mut i32 count = 1;
        mut u64 rest = value;
        while (rest >= 10) {
            rest = rest / 10;
            count = count + 1;
        }
        this.reserve(count);
        rest = value;
        for (mut i32 at = this.length + count - 1; at >= this.length; at = at - 1) {
            this.data[at] = (i8)(48 + (i32)(rest % 10));
            rest = rest / 10;
        }
        this.length = this.length + count;
    }

    public unsafe void append_json_string(ptr<i8> text) {
        this.append_byte(34);
        if (text != null) {
            i32 count = strlen(text);
            for (mut i32 i = 0; i < count; i = i + 1) {
                i32 c = (i32)text[i];
                if (c == 34 || c == 92) {
                    this.append_byte(92);
                    this.append_byte(c);
                } else if (c == 10) {
                    this.append_byte(92);
                    this.append_byte(110);
                } else if (c == 13) {
                    this.append_byte(92);
                    this.append_byte(114);
                } else if (c == 9) {
                    this.append_byte(92);
                    this.append_byte(116);
                } else if (c >= 0 && c < 32) {
                    this.append_byte(32);
                } else {
                    this.append_byte(c);
                }
            }
        }
        this.append_byte(34);
    }

    public unsafe ptr<i8> cstr() {
        this.reserve(1);
        this.data[this.length] = 0;
        return this.data;
    }

    void reserve(i32 extra) {
        i32 needed = this.length + extra + 1;
        if (needed <= this.capacity) {
            return;
        }
        mut i32 newCapacity = this.capacity * 2;
        while (newCapacity < needed) {
            newCapacity = newCapacity * 2;
        }
        ptr<i8> newData = (ptr<i8>)Memory.zalloc((u64)newCapacity);
        memcpy(newData, this.data, (u64)this.length);
        this.data = newData;
        this.capacity = newCapacity;
    }
}
