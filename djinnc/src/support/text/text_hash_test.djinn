namespace djinnc;

import testing;

struct TextHashTests {
    [Test]
    unsafe void equal_text_has_equal_hash_and_one_changed_byte_changes_it() {
        for (mut i32 length = 1; length < 600; length = length + 13) {
            ptr<i8> a = (ptr<i8>)Memory.zalloc((u64)length + 1);
            ptr<i8> b = (ptr<i8>)Memory.zalloc((u64)length + 1);
            for (mut i32 i = 0; i < length; i = i + 1) {
                a[i] = (i8)(u8)((i * 7 + 1) & 255);
                b[i] = a[i];
            }
            Expect.equal((i64)TextHash.of(a, length), (i64)TextHash.of(b, length));
            b[length - 1] = (i8)(u8)(((i32)(u8)b[length - 1] + 1) & 255);
            Expect.is_true(TextHash.of(a, length) != TextHash.of(b, length));
        }
    }
}
