namespace djinnc;

struct Strings {
    public static bool equals(ptr<i8> text, i32 length, ptr<i8> literal) {
        i32 literalLength = strlen(literal);
        if (literalLength != length) {
            return false;
        }
        return memcmp(text, literal, (u64)length) == 0;
    }

    public static bool same(ptr<i8> left, ptr<i8> right) {
        i32 leftLength = strlen(left);
        return Strings.equals(left, leftLength, right);
    }

    public static unsafe bool starts_with(ptr<i8> source, i32 pos, i32 length, ptr<i8> prefix) {
        i32 prefixLength = strlen(prefix);
        if (pos + prefixLength > length) {
            return false;
        }
        return memcmp(source + pos, prefix, (u64)prefixLength) == 0;
    }

    public static ptr<i8> duplicate(ptr<i8> text, i32 length) {
        ptr<i8> copy = (ptr<i8>)Memory.zalloc((u64)length + 1);
        memcpy(copy, text, (u64)length);
        return copy;
    }

    public static unsafe char char_at(ptr<i8> text, i32 index) {
        i32 raw = text[index];
        return (char)(raw & 255);
    }

    public static bool is_digit(char c) {
        return c >= '0' && c <= '9';
    }

    public static bool is_hex_digit(char c) {
        return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
    }

    public static bool is_letter(char c) {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
    }

    public static bool is_ident_start(char c) {
        return Strings.is_letter(c) || c == '_';
    }

    public static bool is_ident_part(char c) {
        return Strings.is_letter(c) || Strings.is_digit(c) || c == '_';
    }

    public static i32 digit_value(char c) {
        if (c >= '0' && c <= '9') {
            return (i32)c - (i32)'0';
        }
        if (c >= 'a' && c <= 'f') {
            return (i32)c - (i32)'a' + 10;
        }
        if (c >= 'A' && c <= 'F') {
            return (i32)c - (i32)'A' + 10;
        }
        return 0 - 1;
    }

    public static unsafe i64 parse_integer(ptr<i8> text, i32 length) {
        mut i32 pos = 0;
        mut i64 radix = 10;
        if (length > 2 && Strings.char_at(text, 0) == '0' && (Strings.char_at(text, 1) == 'x' || Strings.char_at(text, 1) == 'X')) {
            radix = 16;
            pos = 2;
        } else if (length > 2 && Strings.char_at(text, 0) == '0' && (Strings.char_at(text, 1) == 'b' || Strings.char_at(text, 1) == 'B')) {
            radix = 2;
            pos = 2;
        }

        mut i64w value = 0;
        while (pos < length) {
            char c = Strings.char_at(text, pos);
            i32 digit = Strings.digit_value(c);
            if (digit < 0 || digit >= radix) {
                if (c == '_' || c == '\'') {
                    pos = pos + 1;
                    continue;
                }
                return value;
            }
            value = value * radix + digit;
            pos = pos + 1;
        }
        return value;
    }

    public static unsafe f64 parse_float(ptr<i8> text, i32 length) {
        ByteBuffer* clean = ByteBuffer.create();
        for (mut i32 i = 0; i < length; i = i + 1) {
            char c = Strings.char_at(text, i);
            if (c != '_' && c != '\'') {
                clean.append_char(c);
            }
        }
        return strtod(clean.cstr(), null);
    }
}
