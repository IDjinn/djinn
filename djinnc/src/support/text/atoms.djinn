namespace djinnc;

unsafe static mut ptr process_atoms = null;

struct Atoms {
    const u32 KEYWORD_COUNT = 47;
    const u32 UNSAFE_ATOM = 46;
    const u32 SIZEOF_ATOM = 47;
    const u32 MAIN_ATOM = 48;
    const u32 VAR_ATOM = 49;
    const u32 UNLIKELY_ATOM = 50;
    const u32 ASSUME_ATOM = 51;
    const u32 DEBUGTRAP_ATOM = 52;
    const u32 UNREACHABLE_ATOM = 53;
    const u32 TRAP_ATOM = 54;
    const u32 TYPEOF_ATOM = 55;
    const u32 LIKELY_ATOM = 56;
    const u32 PANIC_ATOM = 57;
    const u32 PREFETCH_ATOM = 58;
    const u32 ALIGNOF_ATOM = 59;
    const u32 EXPECT_ATOM = 60;
    const u32 BOUNDS_CHECK_ATOM = 61;
    const u32 THIS_ATOM = 22;

    static void reserve(AtomTable* table, ptr<i8> text, u32 length, u32 expected) {
        u32 atom = table.intern_copy(text, length);
        if (atom != expected) {
            logger_error(Log.get(), "djinnc: reserved atom '%s' got id %d, expected %d (the order in Atoms.get changed)", text, (i32)atom, (i32)expected);
            exit(70);
        }
    }

    public static unsafe AtomTable* get() {
        if (process_atoms == null) {
            AtomTable* table = AtomTable.create(Memory.arena());
            for (mut i32 kind = 6; kind <= 51; kind = kind + 1) {
                TokenKind keyword_kind = (TokenKind)kind;
                ptr<i8> keyword = keyword_kind.text;
                table.intern_copy(keyword, (u32)strlen(keyword));
            }
            Atoms.reserve(table, "this", 4, Atoms.THIS_ATOM);
            Atoms.reserve(table, "unsafe", 6, Atoms.UNSAFE_ATOM);
            Atoms.reserve(table, "sizeof", 6, Atoms.SIZEOF_ATOM);
            Atoms.reserve(table, "main", 4, Atoms.MAIN_ATOM);
            Atoms.reserve(table, "var", 3, Atoms.VAR_ATOM);
            Atoms.reserve(table, "unlikely", 8, Atoms.UNLIKELY_ATOM);
            Atoms.reserve(table, "assume", 6, Atoms.ASSUME_ATOM);
            Atoms.reserve(table, "debugtrap", 9, Atoms.DEBUGTRAP_ATOM);
            Atoms.reserve(table, "unreachable", 11, Atoms.UNREACHABLE_ATOM);
            Atoms.reserve(table, "trap", 4, Atoms.TRAP_ATOM);
            Atoms.reserve(table, "typeof", 6, Atoms.TYPEOF_ATOM);
            Atoms.reserve(table, "likely", 6, Atoms.LIKELY_ATOM);
            Atoms.reserve(table, "panic", 5, Atoms.PANIC_ATOM);
            Atoms.reserve(table, "prefetch", 8, Atoms.PREFETCH_ATOM);
            Atoms.reserve(table, "alignof", 7, Atoms.ALIGNOF_ATOM);
            Atoms.reserve(table, "expect", 6, Atoms.EXPECT_ATOM);
            Atoms.reserve(table, "bounds_check", 12, Atoms.BOUNDS_CHECK_ATOM);
            process_atoms = (ptr)table;
        }
        return (AtomTable*)process_atoms;
    }

    public static TokenKind keyword_kind(u32 atom) {
        if (atom == Atoms.VAR_ATOM) {
            return TokenKind::AUTO;
        }
        if (atom >= Atoms.KEYWORD_COUNT) {
            return TokenKind::IDENTIFIER;
        }
        if (atom == Atoms.UNSAFE_ATOM) {
            return TokenKind::UNSAFE;
        }
        return (TokenKind)((i32)atom + 6);
    }
}
