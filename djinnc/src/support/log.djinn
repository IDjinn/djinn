namespace djinnc;

struct Log {
    public static void error(i8* text) {
        write(2, text, (u32)strlen(text));
    }

    public static void error_buffer(ByteBuf* message) {
        write(2, message.data, (u32)message.length);
    }

    public static void error_int(i64 value) {
        ByteBuf* text = ByteBuf.create();
        text.append_int(value);
        Log.error_buffer(text);
    }
}
