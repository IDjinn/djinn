namespace djinnc;

unsafe static mut void* source_files = null;

struct SourceFile {
    i8* path;
    i8* text;
    u32 length;
    u32* line_starts;
    u32 line_count;
    u32 line_capacity;
    i32 first_token;
    i32 token_end;

    public static SourceFile* create(i8* path, i8* text, u32 length) {
        Arena* arena = Memory.arena();
        SourceFile* file = (SourceFile*)arena.zalloc(sizeof(SourceFile), 8);
        file.path = path;
        file.text = text;
        file.length = length;
        file.line_capacity = length / 24 + 16;
        file.line_starts = (u32*)arena.alloc((u64)file.line_capacity * 4, 4);
        file.line_starts[0] = 0;
        file.line_count = 1;
        return file;
    }

    public void add_line_start(u32 offset) {
        if (this.line_count == this.line_capacity) {
            Arena* arena = Memory.arena();
            u32 capacity = this.line_capacity * 2;
            u32* grown = (u32*)arena.alloc((u64)capacity * 4, 4);
            memcpy(grown, this.line_starts, (u64)this.line_count * 4);
            this.line_starts = grown;
            this.line_capacity = capacity;
        }
        this.line_starts[this.line_count] = offset;
        this.line_count = this.line_count + 1;
    }

    public u32 line_of(u32 offset) {
        mut u32 low = 0;
        mut u32 high = this.line_count;
        while (high - low > 1) {
            u32 middle = (low + high) / 2;
            if (this.line_starts[middle] <= offset) {
                low = middle;
            } else {
                high = middle;
            }
        }
        return low + 1;
    }

    public u32 column_of(u32 offset) {
        u32 line = this.line_of(offset);
        return offset - this.line_starts[line - 1] + 1;
    }
}

struct Sources {
    public static PointerList* list() {
        if (source_files == null) {
            source_files = (void*)PointerList.create();
        }
        return (PointerList*)source_files;
    }

    public static SourceFile* add(i8* path, i8* text, u32 length) {
        SourceFile* file = SourceFile.create(path, text, length);
        PointerList* files = Sources.list();
        files.push((void*)file);
        return file;
    }

    public static SourceFile* get(i32 index) {
        PointerList* files = Sources.list();
        return (SourceFile*)files.get(index);
    }

    public static i32 count() {
        PointerList* files = Sources.list();
        return files.length;
    }

    public static SourceFile* of_token(i32 token) {
        PointerList* files = Sources.list();
        mut i32 low = 0;
        mut i32 high = files.length;
        while (high - low > 1) {
            i32 middle = (low + high) / 2;
            SourceFile* candidate = (SourceFile*)files.get(middle);
            if (candidate.first_token <= token) {
                low = middle;
            } else {
                high = middle;
            }
        }
        return (SourceFile*)files.get(low);
    }
}
