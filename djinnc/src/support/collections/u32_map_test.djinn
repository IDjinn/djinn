namespace djinnc;

import testing;

struct U32MapTests {
    [Test]
    unsafe void a_missing_key_is_not_found() {
        Arena* arena = Arena.create(65536);
        U32Map* map = U32Map.create(arena, 8);
        Expect.is_true(map.find(7) < 0);
        arena.destroy();
    }

    [Test]
    unsafe void key_zero_is_a_valid_key() {
        Arena* arena = Arena.create(65536);
        U32Map* map = U32Map.create(arena, 8);
        Expect.is_false(map.contains(0));
        map.put(0, 11);
        Expect.is_true(map.contains(0));
        Expect.equal(11, (i64)map.get_or(0, 0));
        arena.destroy();
    }

    [Test]
    unsafe void put_overwrites_the_value() {
        Arena* arena = Arena.create(65536);
        U32Map* map = U32Map.create(arena, 8);
        map.put(7, 22);
        map.put(7, 33);
        Expect.equal(33, (i64)map.get_or(7, 0));
        Expect.equal(1, (i64)map.count);
        arena.destroy();
    }

    [Test]
    unsafe void lookups_survive_growth() {
        Arena* arena = Arena.create(65536);
        U32Map* map = U32Map.create(arena, 8);
        map.put(0, 11);
        for (mut u32 i = 100; i < 5100; i = i + 1) {
            map.put(i, i * 2);
        }
        Expect.equal(5001, (i64)map.count);
        Expect.equal(8642, (i64)map.get_or(4321, 0));
        Expect.equal(11, (i64)map.get_or(0, 0));
        Expect.is_true(map.find(99999) < 0);
        Expect.equal(8642, map.find(4321));
        arena.destroy();
    }
}
