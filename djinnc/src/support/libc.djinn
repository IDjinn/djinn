namespace djinnc;

extern "C" {
    i32 printf(i8* format, ...);

    void* malloc(u64 size);
    void free(void* pointer);
    void* memset(void* pointer, i32 value, u64 count);
    void* memcpy(void* destination, void* source, u64 count);
    i32 memcmp(void* left, void* right, u64 count);
    i32 strlen(i8* text);
    f64 strtod(i8* text, i8** end);

    void* fopen(i8* path, i8* mode);
    i32 fclose(void* file);
    i32 fseek(void* file, i64 offset, i32 origin);
    i64 ftell(void* file);
    u64 fread(void* buffer, u64 size, u64 count, void* file);

    i32 clock();
    void exit(i32 status);
    i32 system(i8* command);
    i8* getenv(i8* name);

    i32 __djinn_argc();
    i8* __djinn_argv(i32 index);

    void* logger_create(i8* name, i32 output, i32 level);
    void logger_set_format(void* logger, i8* format);
    void logger_error(void* logger, i8* format, ...);
    void logger_warn(void* logger, i8* format, ...);
    void logger_info(void* logger, i8* format, ...);
}
