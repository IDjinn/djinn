namespace djinnc;

unsafe static mut void* process_arena = null;

struct Memory {
    public static Arena* arena() {
        if (unlikely(process_arena == null)) {
            process_arena = (void*)Arena.create(1048576);
        }
        return (Arena*)process_arena;
    }

    public static void release() {
        if (process_arena == null) {
            return;
        }
        Arena* arena = (Arena*)process_arena;
        process_arena = (void*)0;
        arena.destroy();
        free((void*)arena);
    }

    public static void* zalloc(i64 count) {
        Arena* arena = Memory.arena();
        return arena.zalloc((u64)count, 16);
    }
}
