namespace djinnc;

import testing;

struct ArenaTests {
    [Test]
    unsafe void aligns_to_eight_bytes() {
        Arena* arena = Arena.create(1024);
        arena.alloc(3, 1);
        ptr aligned = arena.alloc(8, 8);
        Expect.equal(0, (i64)aligned % 8);
        arena.destroy();
    }

    [Test]
    unsafe void aligns_to_sixteen_bytes() {
        Arena* arena = Arena.create(1024);
        arena.alloc(3, 1);
        ptr wide = arena.alloc(16, 16);
        Expect.equal(0, (i64)wide % 16);
        arena.destroy();
    }

    [Test]
    unsafe void grows_past_its_first_block() {
        Arena* arena = Arena.create(1024);
        u64 reserved_before = arena.total_reserved;
        for (mut i32 i = 0; i < 100; i = i + 1) {
            arena.alloc(500, 8);
        }
        Expect.is_true(arena.total_reserved > reserved_before);
        arena.destroy();
    }

    [Test]
    unsafe void reset_frees_the_blocks_after_a_mark() {
        Arena* arena = Arena.create(1024);
        ArenaMark* mark = arena.mark();
        u64 reserved_before = arena.total_reserved;
        for (mut i32 i = 0; i < 100; i = i + 1) {
            arena.alloc(500, 8);
        }
        arena.reset_to(mark);
        Expect.equal((i64)reserved_before, (i64)arena.total_reserved);
        arena.destroy();
    }

    [Test]
    unsafe void zeroes_an_oversized_allocation() {
        Arena* arena = Arena.create(1024);
        ptr<i8> big = (ptr<i8>)arena.zalloc(1048576, 8);
        Expect.is_true(big[0] == 0 && big[1048575] == 0);
        arena.destroy();
    }

    [Test]
    unsafe void destroy_releases_every_block() {
        Arena* arena = Arena.create(1024);
        arena.alloc(500, 8);
        arena.destroy();
        Expect.equal(0, (i64)arena.total_reserved);
        Expect.is_true(arena.head == null);
    }
}
