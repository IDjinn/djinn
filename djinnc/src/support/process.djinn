namespace djinnc;

struct Process {
    public static i32 argc() {
        return __djinn_argc();
    }

    public static i8* argv_or(i32 index, i8* fallback) {
        i8* value = __djinn_argv(index);
        if (value == null) {
            return fallback;
        }
        return value;
    }

    public static i8* env_or(i8* name, i8* fallback) {
        i8* value = getenv(name);
        if (value == null) {
            return fallback;
        }
        return value;
    }

    public static i32 run(i8* command) {
        return system(command);
    }
}
