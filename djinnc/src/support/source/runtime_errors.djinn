namespace djinnc;

struct RuntimeErrors {
    const i32 RUNTIME = 10000;
    const i32 DIVISION_BY_ZERO = 10001;
    const i32 SHIFT_OUT_OF_RANGE = 10002;
    const i32 FLOAT_CAST_OUT_OF_RANGE = 10003;
    const i32 BOOL_CAST_INVALID = 10004;
    const i32 INTEGER_CAST_TRUNCATED = 10005;
    const i32 DIVISION_OVERFLOW = 10006;
    const i32 INTEGER_OVERFLOW = 10007;
    const i32 INTEGER_OVERFLOW_UNHANDLED = 10008;
    const i32 NULL_POINTER_UNWRAP = 10009;
    const i32 INDEX_OUT_OF_RANGE = 10010;
    const i32 RUNTIME_STR_CONCATENATION = 10011;
    const i32 RANGE_PROOF_VIOLATED = 10012;

    public static ptr<i8> text(i32 code) {
        if (code == RuntimeErrors.DIVISION_BY_ZERO) { return "division by zero"; }
        if (code == RuntimeErrors.SHIFT_OUT_OF_RANGE) { return "shift amount is out of range"; }
        if (code == RuntimeErrors.FLOAT_CAST_OUT_OF_RANGE) { return "float value is out of range for the integer type"; }
        if (code == RuntimeErrors.BOOL_CAST_INVALID) { return "only 0 or 1 can be converted to bool"; }
        if (code == RuntimeErrors.INTEGER_CAST_TRUNCATED) { return "integer value does not fit in the target type"; }
        if (code == RuntimeErrors.DIVISION_OVERFLOW) { return "integer overflow: the minimum value divided by -1"; }
        if (code == RuntimeErrors.INTEGER_OVERFLOW) { return "integer overflow"; }
        if (code == RuntimeErrors.INTEGER_OVERFLOW_UNHANDLED) { return "integer overflow (use the w suffix to wrap, the s suffix to saturate or throws(Overflow) to catch it)"; }
        if (code == RuntimeErrors.NULL_POINTER_UNWRAP) { return "null pointer dereference of a nullable pointer"; }
        if (code == RuntimeErrors.INDEX_OUT_OF_RANGE) { return "index out of range"; }
        if (code == RuntimeErrors.RUNTIME_STR_CONCATENATION) { return "str concatenation is only available at compile time"; }
        if (code == RuntimeErrors.RANGE_PROOF_VIOLATED) { return "range proof violated (compiler bug, rerun without --verify-ranges and report it)"; }
        return "runtime error";
    }

    public static ptr<i8> report(i32 code) {
        ByteBuffer* line = ByteBuffer.create();
        line.append_char('R');
        line.append_int((i64)code);
        line.append(": ");
        line.append(RuntimeErrors.text(code));
        return line.cstr();
    }
}
