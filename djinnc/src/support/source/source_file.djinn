namespace djinnc;

unsafe static mut ptr source_files = null;

struct SourceFile {
    ptr<i8> path;
    ptr<i8> text;
    u32 length;
    ptr<u32> line_starts;
    u32 line_count;
    u32 line_capacity;
    i32 first_token;
    i32 token_end;
    bool is_header;

    public static unsafe SourceFile* create(ptr<i8> path, ptr<i8> text, u32 length) {
        Arena* arena = Memory.arena();
        SourceFile* file = (SourceFile*)arena.zalloc(sizeof(SourceFile), 8);
        file.path = path;
        file.text = text;
        file.length = length;
        file.line_capacity = length / 24 + 16;
        file.line_starts = (ptr<u32>)arena.alloc((u64)file.line_capacity * 4, 4);
        file.line_starts[0] = 0;
        file.line_count = 1;
        return file;
    }

    public unsafe void add_line_start(u32 offset) {
        if (this.line_count == this.line_capacity) {
            Arena* arena = Memory.arena();
            u32 capacity = this.line_capacity * 2;
            ptr<u32> grown = (ptr<u32>)arena.alloc((u64)capacity * 4, 4);
            memcpy(grown, this.line_starts, (u64)this.line_count * 4);
            this.line_starts = grown;
            this.line_capacity = capacity;
        }
        this.line_starts[this.line_count] = offset;
        this.line_count = this.line_count + 1;
    }

    public unsafe u32 line_of(u32 offset) {
        mut u32 low = 0;
        mut u32 high = this.line_count;
        while (high - low > 1) {
            u32 middle = (low + high) / 2;
            if (this.line_starts[middle] <= offset) {
                low = middle;
            } else {
                high = middle;
            }
        }
        return low + 1;
    }

    public unsafe u32 column_of(u32 offset) {
        u32 line = this.line_of(offset);
        return offset - this.line_starts[line - 1] + 1;
    }
}
