namespace djinnc;

struct Diagnostics {
    ptr<i8> file;
    i32 errors;

    public static Diagnostics* create(ptr<i8> file) {
        Diagnostics* diagnostics = (Diagnostics*)Memory.zalloc(sizeof(Diagnostics));
        diagnostics.file = file;
        return diagnostics;
    }

    public void error(i32 line, i32 column, ptr<i8> message) {
        logger_error(Log.get(), "%s:%d:%d: error: %s", this.file, line, column, message);
        this.errors = this.errors + 1;
    }

    public void warning(i32 line, i32 column, ptr<i8> message) {
        logger_error(Log.get(), "%s:%d:%d: warning: %s", this.file, line, column, message);
    }

    public void warning_in(ptr<i8> file, i32 line, i32 column, ptr<i8> message) {
        logger_error(Log.get(), "%s:%d:%d: warning: %s", file, line, column, message);
    }

    public void error_in(ptr<i8> file, i32 line, i32 column, ptr<i8> message) {
        logger_error(Log.get(), "%s:%d:%d: error: %s", file, line, column, message);
        this.errors = this.errors + 1;
    }

    public void error_near(i32 line, i32 column, ptr<i8> message, ptr<i8> found) {
        logger_error(Log.get(), "%s:%d:%d: error: %s (found '%s')", this.file, line, column, message, found);
        this.errors = this.errors + 1;
    }

    public bool failed() {
        return this.errors > 0;
    }
}
