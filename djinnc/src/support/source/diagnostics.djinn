namespace djinnc;

unsafe static mut i32 diagnostics_json = 0;
unsafe static mut ptr diagnostics_arguments = null;
unsafe static mut bool diagnostics_unknown_type = false;

struct DiagnosticSite {
    ptr<i8> file;
    i32 line;
    i32 column;
}

struct Diagnostics {
    ptr<i8> file;
    i32 errors;
    ptr<i8> last_file;
    i32 last_code;
    i32 last_line;
    i32 last_column;
    bool settling;
    PointerList* settled;

    public static unsafe Diagnostics* create(ptr<i8> file) {
        Diagnostics* diagnostics = (Diagnostics*)Memory.zalloc(sizeof(Diagnostics));
        diagnostics.file = file;
        diagnostics.settled = PointerList.create();
        return diagnostics;
    }

    unsafe bool is_settled(ptr<i8> file, i32 line, i32 column) {
        PointerList* sites = this.settled;
        for (mut i32 i = 0; i < sites.length; i = i + 1) {
            DiagnosticSite* site = (DiagnosticSite*)sites.get(i);
            if (site.line == line && site.column == column && site.file == file) {
                return true;
            }
        }
        return false;
    }

    // While settling, an error closes its position: a later pass over the same source reports nothing there.
    unsafe void settle(ptr<i8> file, i32 line, i32 column) {
        DiagnosticSite* site = (DiagnosticSite*)Memory.zalloc(sizeof(DiagnosticSite));
        site.file = file;
        site.line = line;
        site.column = column;
        PointerList* sites = this.settled;
        sites.push((ptr)site);
    }

    public static unsafe void set_json(bool enabled) {
        if (enabled) {
            diagnostics_json = 1;
        } else {
            diagnostics_json = 0;
        }
    }

    public static unsafe bool json() {
        return diagnostics_json == 1;
    }

    public static unsafe void add_argument(ptr<i8> text) {
        if (diagnostics_arguments == null) {
            diagnostics_arguments = (ptr)PointerList.create();
        }
        PointerList* list = (PointerList*)diagnostics_arguments;
        list.push((ptr)text);
    }

    static unsafe PointerList* take_arguments() {
        PointerList* list = (PointerList*)diagnostics_arguments;
        diagnostics_arguments = null;
        return list;
    }

    public static unsafe bool saw_unknown_type() {
        return diagnostics_unknown_type;
    }

    public static ptr<i8> code_text(i32 code) {
        ByteBuffer* text = ByteBuffer.create();
        text.append_char('E');
        text.append_int((i64)code);
        return text.cstr();
    }

    static unsafe SourceFile* source_of(ptr<i8> path) {
        for (mut i32 i = 0; i < Sources.count(); i = i + 1) {
            SourceFile* source = Sources.get(i);
            if (source.path == path || Strings.same(source.path, path)) {
                return source;
            }
        }
        return (SourceFile*)0;
    }

    static unsafe void append_snippet(ByteBuffer* out, ptr<i8> path, i32 line, i32 column, i32 length) {
        SourceFile* source = Diagnostics.source_of(path);
        if (source == null || line < 1 || column < 1 || (u32)line > source.line_count) {
            return;
        }
        u32 start = source.line_starts[line - 1];
        mut u32 end = start;
        while (end < source.length && source.text[end] != 10 && source.text[end] != 13) {
            end = end + 1;
        }
        i32 size = (i32)(end - start);
        i32 at = column - 1;
        if (at > size) {
            return;
        }
        mut i32 first = 0;
        if (at > 120) {
            first = at - 120;
        }
        mut i32 last = size;
        if (last - first > 200) {
            last = first + 200;
        }
        ByteBuffer* number = ByteBuffer.create();
        number.append_int((i64)line);
        i32 width = (i32)strlen(number.cstr());
        out.append("
");
        for (mut i32 i = width; i < 5; i = i + 1) {
            out.append_char(' ');
        }
        out.append(number.cstr());
        out.append(" | ");
        if (first > 0) {
            out.append("...");
        }
        out.append_slice(source.text + start + first, last - first);
        if (last < size) {
            out.append("...");
        }
        out.append("
      | ");
        if (first > 0) {
            out.append("   ");
        }
        for (mut i32 i = first; i < at; i = i + 1) {
            u8 unit = (u8)source.text[start + (u32)i];
            if (unit == 9) {
                out.append_char('	');
            } else if (unit < 128 || unit >= 192) {
                out.append_char(' ');
            }
        }
        out.append_char('^');
        for (mut i32 i = at + 1; i < at + length && i < last; i = i + 1) {
            u8 unit = (u8)source.text[start + (u32)i];
            if (unit < 128 || unit >= 192) {
                out.append_char('~');
            }
        }
    }

    void emit(bool is_error, ptr<i8> file, i32 code, i32 line, i32 column, i32 length, ptr<i8> message, ptr<i8> found) {
        PointerList* arguments = Diagnostics.take_arguments();
        if (code == this.last_code && line == this.last_line && column == this.last_column && file == this.last_file) {
            return;
        }
        this.last_file = file;
        this.last_code = code;
        this.last_line = line;
        this.last_column = column;
        if (is_error && this.is_settled(file, line, column)) {
            return;
        }
        if (is_error && this.settling) {
            this.settle(file, line, column);
        }
        if (code == DiagnosticErrors.UNKNOWN_TYPE) {
            unsafe {
                diagnostics_unknown_type = true;
            }
        }
        ByteBuffer* out = ByteBuffer.create();
        mut ptr<i8> severity = "warning";
        if (is_error) {
            severity = "error";
        }
        if (Diagnostics.json()) {
            out.append("{\"severity\":\"");
            out.append(severity);
            out.append("\",\"code\":\"");
            out.append(Diagnostics.code_text(code));
            out.append("\",\"file\":");
            out.append_json_string(file);
            out.append(",\"line\":");
            out.append_int((i64)line);
            out.append(",\"column\":");
            out.append_int((i64)column);
            out.append(",\"length\":");
            out.append_int((i64)length);
            out.append(",\"end_line\":");
            out.append_int((i64)line);
            out.append(",\"end_column\":");
            out.append_int((i64)(column + length));
            out.append(",\"message\":");
            out.append_json_string(message);
            if (arguments != null) {
                out.append(",\"args\":[");
                for (mut i32 i = 0; i < arguments.length; i = i + 1) {
                    if (i > 0) {
                        out.append(",");
                    }
                    out.append_json_string((ptr<i8>)arguments.get(i));
                }
                out.append("]");
            }
            if (found != null) {
                out.append(",\"found\":");
                out.append_json_string(found);
            }
            out.append("}");
        } else {
            out.append(file);
            out.append(":");
            out.append_int((i64)line);
            out.append(":");
            out.append_int((i64)column);
            out.append(": ");
            out.append(severity);
            out.append("[");
            out.append(Diagnostics.code_text(code));
            out.append("]: ");
            out.append(message);
            if (found != null) {
                out.append(" (found '");
                out.append(found);
                out.append("')");
            }
            Diagnostics.append_snippet(out, file, line, column, length);
        }
        logger_error(Log.get(), "%s", out.cstr());
        if (is_error) {
            this.errors = this.errors + 1;
        }
    }

    public void error(i32 code, i32 line, i32 column, ptr<i8> message) {
        this.emit(true, this.file, code, line, column, 1, message, null);
    }

    public void warning(i32 code, i32 line, i32 column, ptr<i8> message) {
        this.emit(false, this.file, code, line, column, 1, message, null);
    }

    public void warning_span(i32 code, i32 line, i32 column, i32 length, ptr<i8> message) {
        this.emit(false, this.file, code, line, column, length, message, null);
    }

    public void warning_in(i32 code, ptr<i8> file, i32 line, i32 column, ptr<i8> message) {
        this.emit(false, file, code, line, column, 1, message, null);
    }

    public void error_in(i32 code, ptr<i8> file, i32 line, i32 column, ptr<i8> message) {
        this.emit(true, file, code, line, column, 1, message, null);
    }

    public void error_span(i32 code, ptr<i8> file, i32 line, i32 column, i32 length, ptr<i8> message) {
        this.emit(true, file, code, line, column, length, message, null);
    }

    public void error_expected(i32 code, i32 line, i32 column, ptr<i8> message, ptr<i8> found) {
        this.emit(true, this.file, code, line, column, 1, message, found);
    }

    public void error_near(i32 code, i32 line, i32 column, ptr<i8> message, ptr<i8> found) {
        this.emit(true, this.file, code, line, column, strlen(found), message, found);
    }

    public bool failed() {
        return this.errors > 0;
    }
}
