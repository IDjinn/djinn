namespace djinnc;

unsafe static mut i32 diagnostics_json = 0;

struct Diagnostics {
    ptr<i8> file;
    i32 errors;

    public static unsafe Diagnostics* create(ptr<i8> file) {
        Diagnostics* diagnostics = (Diagnostics*)Memory.zalloc(sizeof(Diagnostics));
        diagnostics.file = file;
        return diagnostics;
    }

    public static unsafe void set_json(bool enabled) {
        if (enabled) {
            diagnostics_json = 1;
        } else {
            diagnostics_json = 0;
        }
    }

    public static unsafe bool json() {
        return diagnostics_json == 1;
    }

    public static ptr<i8> code_text(i32 code) {
        ByteBuffer* text = ByteBuffer.create();
        text.append_char(69);
        text.append_int((i64)code);
        return text.cstr();
    }

    void emit(bool is_error, ptr<i8> file, i32 code, i32 line, i32 column, ptr<i8> message, ptr<i8> found) {
        ByteBuffer* out = ByteBuffer.create();
        mut ptr<i8> severity = "warning";
        if (is_error) {
            severity = "error";
        }
        if (Diagnostics.json()) {
            out.append("{\"severity\":\"");
            out.append(severity);
            out.append("\",\"code\":\"");
            out.append(Diagnostics.code_text(code));
            out.append("\",\"file\":");
            out.append_json_string(file);
            out.append(",\"line\":");
            out.append_int((i64)line);
            out.append(",\"column\":");
            out.append_int((i64)column);
            out.append(",\"length\":1,\"message\":");
            out.append_json_string(message);
            if (found != null) {
                out.append(",\"found\":");
                out.append_json_string(found);
            }
            out.append("}");
        } else {
            out.append(file);
            out.append(":");
            out.append_int((i64)line);
            out.append(":");
            out.append_int((i64)column);
            out.append(": ");
            out.append(severity);
            out.append("[");
            out.append(Diagnostics.code_text(code));
            out.append("]: ");
            out.append(message);
            if (found != null) {
                out.append(" (found '");
                out.append(found);
                out.append("')");
            }
        }
        logger_error(Log.get(), "%s", out.cstr());
        if (is_error) {
            this.errors = this.errors + 1;
        }
    }

    public void error(i32 code, i32 line, i32 column, ptr<i8> message) {
        this.emit(true, this.file, code, line, column, message, null);
    }

    public void warning(i32 code, i32 line, i32 column, ptr<i8> message) {
        this.emit(false, this.file, code, line, column, message, null);
    }

    public void warning_in(i32 code, ptr<i8> file, i32 line, i32 column, ptr<i8> message) {
        this.emit(false, file, code, line, column, message, null);
    }

    public void error_in(i32 code, ptr<i8> file, i32 line, i32 column, ptr<i8> message) {
        this.emit(true, file, code, line, column, message, null);
    }

    public void error_near(i32 code, i32 line, i32 column, ptr<i8> message, ptr<i8> found) {
        this.emit(true, this.file, code, line, column, message, found);
    }

    public bool failed() {
        return this.errors > 0;
    }
}
