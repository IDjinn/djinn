namespace djinnc;

struct Sources {
    public static unsafe PointerList* list() {
        if (source_files == null) {
            source_files = (ptr)PointerList.create();
        }
        return (PointerList*)source_files;
    }

    public static SourceFile* add(ptr<i8> path, ptr<i8> text, u32 length) {
        SourceFile* file = SourceFile.create(path, text, length);
        PointerList* files = Sources.list();
        files.push((ptr)file);
        return file;
    }

    public static unsafe SourceFile* get(i32 index) {
        PointerList* files = Sources.list();
        return (SourceFile*)files.get(index);
    }

    public static i32 count() {
        PointerList* files = Sources.list();
        return files.length;
    }

    public static unsafe SourceFile* of_token(i32 token) {
        PointerList* files = Sources.list();
        mut i32 low = 0;
        mut i32 high = files.length;
        while (high - low > 1) {
            i32 middle = (low + high) / 2;
            SourceFile* candidate = (SourceFile*)files.get(middle);
            if (candidate.first_token <= token) {
                low = middle;
            } else {
                high = middle;
            }
        }
        return (SourceFile*)files.get(low);
    }
}
