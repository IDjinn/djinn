namespace djinnc;

struct U32Map {
    Arena* arena;
    u32* keys;
    u32* values;
    u32 count;
    u32 capacity;

    public static U32Map* create(Arena* arena, u32 capacity) {
        U32Map* map = (U32Map*)arena.zalloc(sizeof(U32Map), 8);
        map.arena = arena;
        map.capacity = capacity;
        map.keys = (u32*)arena.zalloc((u64)capacity * 4, 4);
        map.values = (u32*)arena.alloc((u64)capacity * 4, 4);
        return map;
    }

    public void put(u32 key, u32 value) {
        if ((this.count + 1) * 2 > this.capacity) {
            this.grow();
        }
        u32 slot = this.find_slot(key);
        if (this.keys[slot] == 0) {
            this.keys[slot] = key + 1;
            this.count = this.count + 1;
        }
        this.values[slot] = value;
    }

    public void copy_into(U32Map* target) {
        for (mut u32 slot = 0; slot < this.capacity; slot = slot + 1) {
            if (this.keys[slot] != 0) {
                target.put(this.keys[slot] - 1, this.values[slot]);
            }
        }
    }

    public bool contains(u32 key) {
        u32 slot = this.find_slot(key);
        return this.keys[slot] != 0;
    }

    public i64 find(u32 key) {
        u32 slot = this.find_slot(key);
        if (this.keys[slot] == 0) {
            return 0 - 1;
        }
        return (i64)this.values[slot];
    }

    public u32 get_or(u32 key, u32 fallback) {
        u32 slot = this.find_slot(key);
        if (this.keys[slot] == 0) {
            return fallback;
        }
        return this.values[slot];
    }

    u32 find_slot(u32 key) {
        u32 mask = this.capacity - 1;
        mut u32 slot = (u32)(((u64)key * 2654435761) & Limits.U32_MAX) & mask;
        while (this.keys[slot] != 0 && this.keys[slot] != key + 1) {
            slot = (slot + 1) & mask;
        }
        return slot;
    }

    void grow() {
        u32 old_capacity = this.capacity;
        u32* old_keys = this.keys;
        u32* old_values = this.values;
        Arena* arena = this.arena;
        this.capacity = old_capacity * 2;
        this.keys = (u32*)arena.zalloc((u64)this.capacity * 4, 4);
        this.values = (u32*)arena.alloc((u64)this.capacity * 4, 4);
        this.count = 0;
        for (mut u32 i = 0; i < old_capacity; i = i + 1) {
            if (old_keys[i] != 0) {
                this.put(old_keys[i] - 1, old_values[i]);
            }
        }
    }
}
