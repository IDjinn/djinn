namespace djinnc;

struct Process {
    public static unsafe i32 argc() {
        return __djinn_argc();
    }

    public static unsafe ptr<i8> argv_or(i32 index, ptr<i8> fallback) {
        ptr<i8> value = __djinn_argv(index);
        if (value == null) {
            return fallback;
        }
        return value;
    }

    public static unsafe ptr<i8> env_or(ptr<i8> name, ptr<i8> fallback) {
        ptr<i8> value = getenv(name);
        if (value == null) {
            return fallback;
        }
        return value;
    }

    public static unsafe i32 run(ptr<i8> command) {
        i32 status = system(command);
        if (Platform.Windows || status < 0) {
            return status;
        }
        if ((status & 127) != 0) {
            return 128 + (status & 127);
        }
        return (status >> 8) & 255;
    }
}
