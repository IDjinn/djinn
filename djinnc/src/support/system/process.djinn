namespace djinnc;

struct Process {
    public static i32 argc() {
        return __djinn_argc();
    }

    public static ptr<i8> argv_or(i32 index, ptr<i8> fallback) {
        ptr<i8> value = __djinn_argv(index);
        if (value == null) {
            return fallback;
        }
        return value;
    }

    public static ptr<i8> env_or(ptr<i8> name, ptr<i8> fallback) {
        ptr<i8> value = getenv(name);
        if (value == null) {
            return fallback;
        }
        return value;
    }

    public static i32 run(ptr<i8> command) {
        return system(command);
    }
}
