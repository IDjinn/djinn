namespace djinnc;

struct PerformanceMonitor {
    ptr<i8> prefix;
    bool enabled;
    i64 start;
    i64 lap_start;
    i32 laps;

    public static PerformanceMonitor* create(ptr<i8> prefix, bool enabled) {
        PerformanceMonitor* monitor = (PerformanceMonitor*)Memory.zalloc(sizeof(PerformanceMonitor));
        monitor.prefix = prefix;
        monitor.enabled = enabled;
        monitor.reset();
        return monitor;
    }

    public void reset() {
        i64 now = __djinn_now_us();
        this.start = now;
        this.lap_start = now;
    }

    public i64 elapsed_us() {
        return __djinn_now_us() - this.start;
    }

    public void lap(ptr<i8> name) {
        i64 now = __djinn_now_us();
        i64 elapsed = now - this.lap_start;
        this.lap_start = now;
        this.laps = this.laps + 1;
        if (this.enabled) {
            printf("[PerformanceMonitor %s] lap %s (%d) %d.%03d ms\n", this.prefix, name, this.laps, (i32)(elapsed / 1000), (i32)(elapsed % 1000));
        }
    }

    public void finish() {
        if (this.enabled) {
            i64 total = this.elapsed_us();
            printf("[PerformanceMonitor %s] total %d.%03d ms in %d laps\n", this.prefix, (i32)(total / 1000), (i32)(total % 1000), this.laps);
        }
    }
}
