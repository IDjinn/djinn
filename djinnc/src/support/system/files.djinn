namespace djinnc;

struct Files {
    public static i8* read_all(i8* path) {
        void* file = fopen(path, "rb");
        if (file == null) {
            return null;
        }
        fseek(file, 0, 2);
        i32 length = (i32)ftell(file);
        fseek(file, 0, 0);
        i8* buffer = (i8*)Memory.zalloc((i64)length + 1);
        fread(buffer, 1, (u64)length, file);
        fclose(file);
        return buffer;
    }

    public static i8* read_bytes(i8* path, i32* length) {
        void* file = fopen(path, "rb");
        if (file == null) {
            return null;
        }
        fseek(file, 0, 2);
        i32 size = (i32)ftell(file);
        fseek(file, 0, 0);
        i8* buffer = (i8*)Memory.zalloc((i64)size + 1);
        fread(buffer, 1, (u64)size, file);
        fclose(file);
        length[0] = size;
        return buffer;
    }

    public static bool write_bytes(i8* path, i8* data, i32 length) {
        void* file = fopen(path, "wb");
        if (file == null) {
            return false;
        }
        u64 written = fwrite(data, 1, (u64)length, file);
        fclose(file);
        return written == (u64)length;
    }
}
