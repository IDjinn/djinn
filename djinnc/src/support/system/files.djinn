namespace djinnc;

struct Files {
    public static unsafe ptr<i8> read_all(ptr<i8> path) {
        ptr file = fopen(path, "rb");
        if (file == null) {
            return null;
        }
        fseek(file, 0, 2);
        i32 length = (i32)ftell(file);
        fseek(file, 0, 0);
        Arena* arena = Memory.arena();
        ptr<i8> buffer = (ptr<i8>)arena.alloc((u64)length + 1, 1);
        fread(buffer, 1, (u64)length, file);
        fclose(file);
        buffer[length] = 0;
        return buffer;
    }

    public static unsafe ptr<i8> read_bytes(ptr<i8> path, ptr<i32> length) {
        ptr file = fopen(path, "rb");
        if (file == null) {
            return null;
        }
        fseek(file, 0, 2);
        i32 size = (i32)ftell(file);
        fseek(file, 0, 0);
        ptr<i8> buffer = (ptr<i8>)Memory.zalloc((u64)size + 1);
        fread(buffer, 1, (u64)size, file);
        fclose(file);
        length[0] = size;
        return buffer;
    }

    // Reads every path of the list with libc. The result holds, in order, the NUL-terminated contents, or null for a
    // file that cannot be read; `lengths`, when not null, receives the sizes (-1 for a failed file).
    public static unsafe PointerList* read_all_many(PointerList* paths, ptr<i32> lengths) {
        return Files.read_many(paths, lengths, 0);
    }

    // Same as `read_all_many`, through io_uring on Linux (libc where it is not available). Worth it for large batches
    // or high latency storage.
    public static unsafe PointerList* read_all_many_uring(PointerList* paths, ptr<i32> lengths) {
        return Files.read_many(paths, lengths, 1);
    }

    static unsafe PointerList* read_many(PointerList* paths, ptr<i32> lengths, i32 use_uring) {
        i32 count = paths.length;
        PointerList* result = PointerList.create();
        if (count == 0) {
            return result;
        }
        ptr<ptr<i8>> buffers = (ptr<ptr<i8>>)Memory.zalloc((u64)count * 8);
        ptr<i64> sizes = (ptr<i64>)Memory.zalloc((u64)count * 8);
        __djinn_files_batch(0, use_uring, (ptr<ptr<i8>>)paths.data, buffers, sizes, count);
        for (mut i32 i = 0; i < count; i = i + 1) {
            result.push((ptr)*(buffers + i));
            if (lengths != null) {
                lengths[i] = (i32)sizes[i];
            }
        }
        return result;
    }

    // Writes `datas[i]` (`lengths[i]` bytes) to `paths[i]` for every entry with libc; returns how many files failed.
    public static unsafe i32 write_bytes_many(PointerList* paths, PointerList* datas, ptr<i32> lengths) {
        return Files.write_many(paths, datas, lengths, 0);
    }

    // Same as `write_bytes_many`, through io_uring on Linux (libc where it is not available).
    public static unsafe i32 write_bytes_many_uring(PointerList* paths, PointerList* datas, ptr<i32> lengths) {
        return Files.write_many(paths, datas, lengths, 1);
    }

    static unsafe i32 write_many(PointerList* paths, PointerList* datas, ptr<i32> lengths, i32 use_uring) {
        i32 count = paths.length;
        if (count == 0) {
            return 0;
        }
        ptr<i64> sizes = (ptr<i64>)Memory.zalloc((u64)count * 8);
        for (mut i32 i = 0; i < count; i = i + 1) {
            sizes[i] = (i64)lengths[i];
            __djinn_make_parent_directories((ptr<i8>)paths.get(i));
        }
        __djinn_files_batch(1, use_uring, (ptr<ptr<i8>>)paths.data, (ptr<ptr<i8>>)datas.data, sizes, count);
        mut i32 failed = 0;
        for (mut i32 i = 0; i < count; i = i + 1) {
            if (sizes[i] < 0) {
                failed = failed + 1;
            }
        }
        return failed;
    }

    public static bool write_bytes(ptr<i8> path, ptr<i8> data, i32 length) {
        __djinn_make_parent_directories(path);
        ptr file = fopen(path, "wb");
        if (file == null) {
            return false;
        }
        u64 written = fwrite(data, 1, (u64)length, file);
        fclose(file);
        return written == (u64)length;
    }
}
