namespace djinnc;

struct StdLibrary {
    public static ptr<i8> locate(Options* options) {
        if (options.std_dir != null) {
            return options.std_dir;
        }
        ptr<i8> configured = getenv("DJINN_STD_DIR");
        if (configured != null) {
            return configured;
        }
        ByteBuffer* sibling = ByteBuffer.create();
        sibling.append(options.runtime_dir);
        sibling.append("/../std");
        return sibling.cstr();
    }

    static unsafe bool is_excluded(ptr<i8> path) {
        i32 length = strlen(path);
        ptr<ptr<i8>> pending = StdLibrary.pending_files();
        for (mut i32 i = 0; pending[i] != null; i = i + 1) {
            i32 suffix = strlen(pending[i]);
            if (length >= suffix && Strings.equals(path + length - suffix, suffix, pending[i])) {
                return true;
            }
        }
        return false;
    }

    static ptr<ptr<i8>> pending_files() {
        ptr<ptr<i8>> files = (ptr<ptr<i8>>)Memory.zalloc(8 * 10);
        return files;
    }

    public static unsafe bool add(Options* options) {
        ptr<i8> directory = StdLibrary.locate(options);
        ptr<i8> listing = __djinn_list_files(directory, ".djinn");
        if (listing == null) {
            logger_error(Log.get(), "djinnc: cannot list the std directory '%s' (see --std-dir)", directory);
            return false;
        }
        i32 length = strlen(listing);
        PointerList* inputs = options.inputs;
        PointerList* dependencies = options.dependencies;
        mut i32 start = 0;
        for (mut i32 i = 0; i <= length; i = i + 1) {
            if (i == length || listing[i] == 10) {
                if (i > start) {
                    ptr<i8> path = Strings.duplicate(listing + start, i - start);
                    if (!StdLibrary.is_excluded(path)) {
                        inputs.push((ptr)path);
                        dependencies.push((ptr)path);
                    }
                }
                start = i + 1;
            }
        }
        return true;
    }
}
