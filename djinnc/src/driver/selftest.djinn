namespace djinnc;

struct SelfTest {
    public static i32 run() {
        mut i32 failed = 0;
        failed = failed + SelfTest.arena();
        failed = failed + SelfTest.atoms();
        failed = failed + SelfTest.u32_map();
        if (failed == 0) {
            printf("selftest: ok\n");
        }
        return failed;
    }

    static i32 check(bool condition, ptr<i8> name) {
        if (condition) {
            return 0;
        }
        printf("selftest: FAILED %s\n", name);
        return 1;
    }

    static i32 arena() {
        mut i32 failed = 0;
        Arena* arena = Arena.create(1024);

        ptr<i8> first = (ptr<i8>)arena.alloc(3, 1);
        ptr aligned = arena.alloc(8, 8);
        failed = failed + SelfTest.check((i64)aligned % 8 == 0, "arena: 8-byte alignment");
        ptr wide = arena.alloc(16, 16);
        failed = failed + SelfTest.check((i64)wide % 16 == 0, "arena: 16-byte alignment");

        ArenaMark* mark = arena.mark();
        u64 reserved_before = arena.total_reserved;
        for (mut i32 i = 0; i < 100; i = i + 1) {
            arena.alloc(500, 8);
        }
        failed = failed + SelfTest.check(arena.total_reserved > reserved_before, "arena: grows");
        arena.reset_to(mark);
        failed = failed + SelfTest.check(arena.total_reserved == reserved_before, "arena: reset frees blocks");

        ptr<i8> big = (ptr<i8>)arena.zalloc(1048576, 8);
        failed = failed + SelfTest.check(big[0] == 0 && big[1048575] == 0, "arena: oversized zalloc");
        arena.destroy();
        failed = failed + SelfTest.check(arena.total_reserved == 0 && arena.head == null, "arena: destroy releases blocks");
        return failed;
    }

    static i32 atoms() {
        mut i32 failed = 0;
        Arena* arena = Arena.create(65536);
        AtomTable* table = AtomTable.create(arena);

        u32 foo = table.intern("foo", 3);
        u32 bar = table.intern("bar", 3);
        u32 again = table.intern("foo", 3);
        failed = failed + SelfTest.check(foo == 0 && bar == 1, "atoms: sequential ids");
        failed = failed + SelfTest.check(again == foo, "atoms: dedupe");
        failed = failed + SelfTest.check(table.intern("fo", 2) != foo, "atoms: length matters");

        ByteBuffer* text = ByteBuffer.create();
        for (mut i32 i = 0; i < 5000; i = i + 1) {
            text.length = 0;
            text.append("name_");
            text.append_int(i);
            ptr<i8> copy = Strings.duplicate(text.data, text.length);
            table.intern(copy, (u32)text.length);
        }
        failed = failed + SelfTest.check(table.count == 5003, "atoms: count after growth");

        text.length = 0;
        text.append("name_4321");
        u32 found = table.intern(text.data, (u32)text.length);
        failed = failed + SelfTest.check(found < table.count && Strings.same(table.text(found), "name_4321"), "atoms: lookup after rehash");
        failed = failed + SelfTest.check(table.count == 5003, "atoms: no duplicate on re-intern");

        u32 owned = table.intern_copy("name_4321", 9);
        failed = failed + SelfTest.check(owned == found && table.count == 5003, "atoms: copy hits existing");
        u32 fresh = table.intern_copy("fresh_atom", 10);
        ptr<i8> fresh_text = table.text(fresh);
        failed = failed + SelfTest.check(fresh_text[10] == 0 && Strings.same(fresh_text, "fresh_atom"), "atoms: copy is terminated");
        arena.destroy();
        return failed;
    }

    static i32 u32_map() {
        mut i32 failed = 0;
        Arena* arena = Arena.create(65536);
        U32Map* map = U32Map.create(arena, 8);

        failed = failed + SelfTest.check(map.find(7) < 0, "u32 map: missing key");
        failed = failed + SelfTest.check(!map.contains(0), "u32 map: key zero absent");
        map.put(0, 11);
        map.put(7, 22);
        failed = failed + SelfTest.check(map.get_or(0, 0) == 11 && map.get_or(7, 0) == 22, "u32 map: stored values");
        map.put(7, 33);
        failed = failed + SelfTest.check(map.get_or(7, 0) == 33 && map.count == 2, "u32 map: overwrite");

        for (mut u32 i = 100; i < 5100; i = i + 1) {
            map.put(i, i * 2);
        }
        failed = failed + SelfTest.check(map.count == 5002, "u32 map: count after growth");
        failed = failed + SelfTest.check(map.get_or(4321, 0) == 8642 && map.get_or(0, 0) == 11, "u32 map: lookup after growth");
        failed = failed + SelfTest.check(map.find(99999) < 0, "u32 map: missing after growth");
        failed = failed + SelfTest.check(map.find(4321) == 8642 && map.find(0) == 11, "u32 map: find returns the value");
        arena.destroy();
        return failed;
    }
}
