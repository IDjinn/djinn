namespace djinnc;

struct Dump {
    public static void tokens(TokenList* tokens) {
        for (mut i32 i = 0; i < tokens.length; i = i + 1) {
            printf("%d:%d %s '%.*s'\n", tokens.line(i), tokens.column(i), tokens.kind(i).name, tokens.text_length(i), tokens.text(i));
        }
    }

    public static void indent(i32 depth) {
        for (mut i32 i = 0; i < depth; i = i + 1) {
            printf("  ");
        }
    }

    public static void program(Node* program, PointerList* dependencies) {
        printf("%s
", program.kind().name);
        for (mut i32 i = 0; i < program.count(); i = i + 1) {
            Node* declaration = program.child(i);
            if (!dependencies.contains_string(declaration.file_name())) {
                Dump.node(declaration, 1);
            }
        }
    }

    public static void node(Node* node, i32 depth) {
        if (node == null) {
            return;
        }
        Dump.indent(depth);
        printf("%s", node.kind().name);
        if (node.text() != null) {
            printf(" %s", node.text());
        }
        if (node.kind() == NodeKind::INTRINSIC) {
            printf(" %s", Intrinsic.name(node.op()));
        } else if (node.op() != 0) {
            printf(" op=%s", node.op_kind().name);
        }
        if (node.kind() == NodeKind::INT_LITERAL || node.kind() == NodeKind::BOOL_LITERAL) {
            printf(" %lld", node.int_value());
        }
        if (node.type() != null) {
            ByteBuffer* description = ByteBuffer.create();
            TypeRef* type = node.type();
            type.describe(description);
            printf(" : %s", description.cstr());
        }
        printf(" <%d:%d>\n", node.line(), node.column());

        Dump.node(node.first(), depth + 1);
        Dump.node(node.second(), depth + 1);
        Dump.node(node.third(), depth + 1);
        Dump.node(node.fourth(), depth + 1);
        if (node.has_items()) {
            for (mut i32 i = 0; i < node.count(); i = i + 1) {
                Dump.node(node.child(i), depth + 1);
            }
        }
    }
}
