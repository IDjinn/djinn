namespace djinnc;

struct ProjectList {
    const i32 NONE = 0;
    const i32 LIBS = 1;
    const i32 SOURCES = 2;
    const i32 IGNORED = 3;
    const i32 TARGETS = 4;
}

struct Project {
    public static unsafe bool is_source_file(ptr<i8> path) {
        i32 length = strlen(path);
        return length > 6 && Strings.equals(path + length - 6, 6, ".djinn");
    }

    public static unsafe bool is_test_file(ptr<i8> path) {
        i32 length = strlen(path);
        return length > 11 && Strings.equals(path + length - 11, 11, "_test.djinn");
    }

    // For 'dir/name.<word>.djinn' with a platform word (windows, linux, macos, android, ios, web, desktop, mobile,
    // native): the length of 'dir/name' and where the word starts, or -1 when the file has no such suffix.
    static unsafe i32 platform_stem(ptr<i8> path, ptr<i32> word_start) {
        i32 length = strlen(path);
        if (!Project.is_source_file(path)) {
            return 0 - 1;
        }
        i32 stem_end = length - 6;
        mut i32 dot = stem_end - 1;
        while (dot >= 0 && path[dot] != 46 && path[dot] != 47 && path[dot] != 92) {
            dot = dot - 1;
        }
        if (dot <= 0 || path[dot] != 46 || path[dot - 1] == 47 || path[dot - 1] == 92) {
            return 0 - 1;
        }
        if (!Target.is_platform_word(path + dot + 1, stem_end - dot - 1)) {
            return 0 - 1;
        }
        word_start[0] = dot + 1;
        return dot;
    }

    static unsafe bool same_stem(ptr<i8> path, i32 stem, ptr<i8> other, i32 other_stem) {
        if (stem != other_stem) {
            return false;
        }
        for (mut i32 i = 0; i < stem; i = i + 1) {
            if (path[i] != other[i]) {
                return false;
            }
        }
        return true;
    }

    // Keeps, for every 'name', the most specific 'name.<platform>.djinn' that matches the target (the platform, then
    // its group, then 'native') in place of 'name.djinn', and drops the variants of other platforms.
    public static unsafe PointerList* select_platform_files(PointerList* paths) {
        PointerList* kept = PointerList.create();
        for (mut i32 i = 0; i < paths.length; i = i + 1) {
            ptr<i8> path = (ptr<i8>)paths.get(i);
            mut i32 word = 0;
            i32 stem = Project.platform_stem(path, &word);
            mut i32 rank = 0;
            mut i32 key_length = 0;
            if (stem >= 0) {
                rank = Target.platform_rank(path + word, strlen(path) - 6 - word);
                if (rank == 0) {
                    continue;
                }
                key_length = stem;
            } else {
                key_length = strlen(path) - 6;
            }
            mut bool beaten = false;
            for (mut i32 j = 0; j < paths.length && !beaten; j = j + 1) {
                if (j == i) {
                    continue;
                }
                ptr<i8> other = (ptr<i8>)paths.get(j);
                mut i32 other_word = 0;
                i32 other_stem = Project.platform_stem(other, &other_word);
                if (other_stem < 0 || !Project.same_stem(path, key_length, other, other_stem)) {
                    continue;
                }
                i32 other_rank = Target.platform_rank(other + other_word, strlen(other) - 6 - other_word);
                beaten = other_rank > rank;
            }
            if (!beaten) {
                kept.push((ptr)path);
            }
        }
        return kept;
    }

    public static ptr<i8> generated_entry() {
        return "<generated test entry>";
    }

    public static unsafe ptr<i8> read_input(ptr<i8> path) {
        if (Strings.same(path, Project.generated_entry())) {
            ptr<i8> text = "import testing;

i32 main() {
    return TestProgram.run();
}
";
            return Strings.duplicate(text, strlen(text));
        }
        return Files.read_all(path);
    }

    public static unsafe PointerList* read_inputs(PointerList* paths) {
        PointerList* real = PointerList.create();
        for (mut i32 i = 0; i < paths.length; i = i + 1) {
            ptr<i8> path = (ptr<i8>)paths.get(i);
            if (!Strings.same(path, Project.generated_entry())) {
                real.push((ptr)path);
            }
        }
        PointerList* loaded = Files.read_all_many(real, null);
        PointerList* result = PointerList.create();
        mut i32 next = 0;
        for (mut i32 i = 0; i < paths.length; i = i + 1) {
            ptr<i8> path = (ptr<i8>)paths.get(i);
            if (Strings.same(path, Project.generated_entry())) {
                result.push((ptr)Project.read_input(path));
            } else {
                result.push(loaded.get(next));
                next = next + 1;
            }
        }
        return result;
    }

    static unsafe bool defines_main(Options* options) {
        PointerList* inputs = options.inputs;
        for (mut i32 i = 0; i < inputs.length; i = i + 1) {
            ptr<i8> path = (ptr<i8>)inputs.get(i);
            if (!Project.is_test_file(path)) {
                continue;
            }
            ptr<i8> text = Files.read_all(path);
            if (text == null) {
                continue;
            }
            i32 length = strlen(text);
            for (mut i32 at = 0; at + 9 <= length; at = at + 1) {
                if (Strings.equals(text + at, 9, "i32 main(") && (at == 0 || text[at - 1] == 10)) {
                    return true;
                }
            }
        }
        return false;
    }

    public static unsafe bool has_base_name(ptr<i8> path, ptr<i8> name) {
        i32 length = strlen(path);
        i32 base = strlen(name);
        if (length <= base || !Strings.same(path + length - base, name)) {
            return false;
        }
        return path[length - base - 1] == 47 || path[length - base - 1] == 92;
    }

    // Accepts a project directory or the path of its djinn.proj; always returns a directory with '/' separators and
    // no trailing separator ('.' for a bare 'djinn.proj').
    static unsafe ptr<i8> normalize_directory(ptr<i8> path) {
        mut i32 length = strlen(path);
        ByteBuffer* result = ByteBuffer.create();
        for (mut i32 i = 0; i < length; i = i + 1) {
            if (path[i] == 92) {
                result.append_char('/');
            } else {
                result.append_char((char)path[i]);
            }
        }
        ptr<i8> text = result.cstr();
        length = strlen(text);
        if (length >= 10 && Strings.same(text + length - 10, "djinn.proj") && (length == 10 || text[length - 11] == 47)) {
            length = length - 10;
            if (length == 0) {
                return Strings.duplicate(".", 1);
            }
        }
        while (length > 1 && text[length - 1] == 47) {
            length = length - 1;
        }
        return Strings.duplicate(text, length);
    }

    public static bool apply(Options* options, ptr<i8> given_directory) {
        ptr<i8> directory = Project.normalize_directory(given_directory);
        ByteBuffer* manifest_path = ByteBuffer.create();
        manifest_path.append(directory);
        manifest_path.append("/djinn.proj");
        ptr<i8> manifest = Files.read_all(manifest_path.cstr());
        if (manifest == null) {
            logger_error(Log.get(), "djinnc: cannot read '%s'", manifest_path.cstr());
            return false;
        }
        Project.read_manifest(options, manifest, directory);

        ByteBuffer* source_root = ByteBuffer.create();
        source_root.append(directory);
        source_root.append("/src");
        mut ptr<i8> listing = __djinn_list_files(source_root.cstr(), ".djinn");
        if (listing == null) {
            // No 'src' folder (the std library keeps its sources next to djinn.proj): use the project folder itself.
            listing = __djinn_list_files(directory, ".djinn");
        }
        if (listing == null) {
            logger_error(Log.get(), "djinnc: cannot list '%s'", directory);
            return false;
        }
        Project.add_listed_files(options, listing);
        if (options.test_command && !Project.defines_main(options)) {
            PointerList* inputs = options.inputs;
            inputs.push((ptr)Project.generated_entry());
        }
        return options.inputs.length > 0;
    }

    static unsafe void add_listed_files(Options* options, ptr<i8> listing) {
        i32 length = strlen(listing);
        PointerList* inputs = options.inputs;
        mut i32 start = 0;
        for (mut i32 i = 0; i <= length; i = i + 1) {
            if (i == length || listing[i] == 10) {
                if (i > start) {
                    ptr<i8> path = Strings.duplicate(listing + start, i - start);
                    bool is_entry = options.include_tests && options.entry_file != null && Project.has_base_name(path, options.entry_file);
                    if (!is_entry && (options.include_tests || !Project.is_test_file(path))) {
                        inputs.push((ptr)path);
                    }
                }
                start = i + 1;
            }
        }
        options.input = (ptr<i8>)inputs.get(0);
    }

    static unsafe void read_manifest(Options* options, ptr<i8> manifest, ptr<i8> directory) {
        i32 length = strlen(manifest);
        mut ptr<i8> output_file = (ptr<i8>)0;
        mut ptr<i8> output_directory = (ptr<i8>)0;
        mut i32 start = 0;
        mut i32 open_list = ProjectList.NONE;
        for (mut i32 i = 0; i <= length; i = i + 1) {
            if (i == length || manifest[i] == 10) {
                i32 first = Project.skip_blanks(manifest, start, i);
                if (open_list != ProjectList.NONE) {
                    open_list = Project.read_items(options, manifest, first, i, open_list, directory);
                } else if (Strings.starts_with(manifest, first, i, "libs:")) {
                    options.use_std = false;
                    open_list = Project.read_items(options, manifest, first + 5, i, ProjectList.LIBS, directory);
                } else if (Strings.starts_with(manifest, first, i, "test-libs:")) {
                    mut i32 kind = ProjectList.IGNORED;
                    if (options.include_tests) {
                        kind = ProjectList.LIBS;
                    }
                    open_list = Project.read_items(options, manifest, first + 10, i, kind, directory);
                } else if (Strings.starts_with(manifest, first, i, "targets:")) {
                    open_list = Project.read_items(options, manifest, first + 8, i, ProjectList.TARGETS, directory);
                } else if (Strings.starts_with(manifest, first, i, "entry:")) {
                    options.entry_file = Project.read_value(manifest, first + 6, i);
                } else if (Strings.starts_with(manifest, first, i, "async-threads:")) {
                    ptr<i8> threads_text = Project.read_value(manifest, first + 14, i);
                    if (!options.async_threads_set) {
                        options.async_threads = Strings.parse_integer(threads_text, strlen(threads_text));
                        options.async_threads_set = true;
                    }
                } else if (Strings.starts_with(manifest, first, i, "static-cache:")) {
                    ptr<i8> seconds_text = Project.read_value(manifest, first + 13, i);
                    options.static_cache = Strings.parse_integer(seconds_text, strlen(seconds_text));
                    options.static_cache_set = true;
                } else if (Strings.starts_with(manifest, first, i, "sources:")) {
                    open_list = Project.read_items(options, manifest, first + 8, i, ProjectList.SOURCES, directory);
                } else if (Strings.starts_with(manifest, first, i, "windowed:")) {
                    options.windowed = Strings.same(Project.read_value(manifest, first + 9, i), "true");
                } else if (Strings.starts_with(manifest, first, i, "library-mode:")) {
                    options.library = Strings.same(Project.read_value(manifest, first + 13, i), "true");
                } else if (Strings.starts_with(manifest, first, i, "reflection-mode:")) {
                    if (Strings.same(Project.read_value(manifest, first + 16, i), "all")) {
                        options.reflect_mode = ReflectionMode.ALL;
                    }
                } else if (Strings.starts_with(manifest, first, i, "ieee754:")) {
                    FloatSettings* standard_settings = options.float_settings;
                    if (!options.float_standard_set && !standard_settings.set_standard(Project.read_value(manifest, first + 8, i))) {
                        options.ok = false;
                    }
                } else if (Strings.starts_with(manifest, first, i, "fp-env:")) {
                    FloatSettings* environment_settings = options.float_settings;
                    if (!options.float_environment_set && !environment_settings.set_environment(Project.read_value(manifest, first + 7, i))) {
                        options.ok = false;
                    }
                } else if (Strings.starts_with(manifest, first, i, "generate:")) {
                    options.no_generate = Strings.same(Project.read_value(manifest, first + 9, i), "false");
                } else if (Strings.starts_with(manifest, first, i, "file:")) {
                    output_file = Project.read_value(manifest, first + 5, i);
                } else if (Strings.starts_with(manifest, first, i, "directory:")) {
                    output_directory = Project.read_value(manifest, first + 10, i);
                } else if (first < i && (manifest[first] == 39 || manifest[first] == 34)) {
                    ByteBuffer* link_args = options.link_args;
                    ptr<i8> value = Project.read_value(manifest, first, i);
                    Linker.append_link_arg(options, link_args, value);
                    PointerList* declared = options.declared_links;
                    declared.push((ptr)value);
                    PointerList* linked = options.linked;
                    linked.push((ptr)value);
                }
                start = i + 1;
            }
        }

        if (!options.output_set && output_file != null) {
            ByteBuffer* output = ByteBuffer.create();
            if (output_directory != null) {
                output.append(output_directory);
                output.append_char('/');
            }
            output.append(output_file);
            options.output = output.cstr();
        }
    }

    static unsafe i32 read_items(Options* options, ptr<i8> text, i32 from, i32 to, i32 list, ptr<i8> directory) {
        mut i32 position = from;
        while (position < to) {
            i32 c = (i32)text[position];
            if (c == 93) {
                return ProjectList.NONE;
            }
            position = position + 1;
            if (c == 39 || c == 34) {
                i32 item = position;
                while (position < to && (i32)text[position] != c) {
                    position = position + 1;
                }
                Project.add_item(options, Strings.duplicate(text + item, position - item), list, directory);
                position = position + 1;
            } else if (list == ProjectList.TARGETS && c >= 97 && c <= 122) {
                // platform words may be bare: targets: [windows, linux]
                i32 word = position - 1;
                while (position < to && (((i32)text[position] >= 97 && (i32)text[position] <= 122) || ((i32)text[position] >= 48 && (i32)text[position] <= 57))) {
                    position = position + 1;
                }
                Project.add_item(options, Strings.duplicate(text + word, position - word), list, directory);
            }
        }
        return list;
    }

    static unsafe void add_item(Options* options, ptr<i8> item, i32 list, ptr<i8> directory) {
        if (list == ProjectList.IGNORED) {
            return;
        }
        if (list == ProjectList.TARGETS) {
            i32 mask = Target.platform_mask(item, strlen(item));
            if (mask == 0) {
                logger_error(Log.get(), "djinnc: unknown platform '%s' in targets (windows, linux, macos, android, ios, web, desktop, mobile, native)", item);
                options.ok = false;
                return;
            }
            options.target_mask = options.target_mask | mask;
            return;
        }
        if (list == ProjectList.LIBS && Strings.same(item, "std")) {
            options.use_std = true;
            return;
        }
        ByteBuffer* path = ByteBuffer.create();
        if (list == ProjectList.LIBS) {
            path.append(options.library_dir);
            path.append("/");
            path.append(item);
            path.append(".djlib");
            PointerList* libraries = options.libraries;
            libraries.push((ptr)path.cstr());
            return;
        }
        path.append(directory);
        path.append("/");
        path.append(item);
        PointerList* inputs = options.inputs;
        inputs.push((ptr)path.cstr());
    }

    static unsafe i32 skip_blanks(ptr<i8> text, i32 from, i32 to) {
        mut i32 position = from;
        while (position < to && (text[position] == 32 || text[position] == 9)) {
            position = position + 1;
        }
        return position;
    }

    static unsafe ptr<i8> read_value(ptr<i8> text, i32 from, i32 to) {
        mut i32 start = Project.skip_blanks(text, from, to);
        mut i32 end = to;
        while (end > start && (text[end - 1] == 13 || text[end - 1] == 32 || text[end - 1] == 44)) {
            end = end - 1;
        }
        if (end - start >= 2 && (text[start] == 39 || text[start] == 34) && text[end - 1] == text[start]) {
            start = start + 1;
            end = end - 1;
        }
        return Strings.duplicate(text + start, end - start);
    }
}
