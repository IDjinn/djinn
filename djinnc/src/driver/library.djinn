namespace djinnc;

unsafe static mut ptr library_bodies = null;
unsafe static mut ptr library_objects = null;
unsafe static mut ptr library_resident = null;
unsafe static mut ptr library_resident_sizes = null;
unsafe static mut ptr library_macro_objects = null;
unsafe static mut ptr library_macro_sizes = null;
unsafe static mut i32 library_loaded = 0;
unsafe static mut ptr library_bitcode = null;
unsafe static mut ptr library_bitcode_sizes = null;
unsafe static mut ptr<i8> library_pending_bitcode = null;
unsafe static mut u64 library_pending_bitcode_size = 0;

struct Staged {
    ptr<u8> kinds;
    ptr<u32> atoms;
    i32 count;
    i32 previous;
    bool failed;
}

struct PhraseStats {
    AtomTable* table;
    ptr<u32> counts;
    i32 known;
}

struct PackedFile {
    ptr<i8> path;
    i32 token_count;
    i32 start;
    i32 end;
}

struct LibraryInterface {
    ptr<u32> atoms;
    i32 atom_count;
    ptr<ptr<i8>> phrases;
    i32 phrase_count;
    PointerList* files;
}

struct Library {
    const i32 VERSION = 1;
    const i32 PHRASE_CODE = 127;
    const i32 HEADER_SIZE = 128;
    const i32 ENTRY_SIZE = 32;
    const u32 COMPILER_VERSION = 256;
    const i32 LABEL_OFFSET = 32;
    const i32 BUILD_ID_OFFSET = 64;
    const i32 INTERFACE_HASH_OFFSET = 96;
    // text hash of the header and the section table (this field read as zero): 0 in libraries written before it existed
    const i32 HEADER_HASH_OFFSET = 104;
    const i32 TEXT_FIELD_SIZE = 32;
    const i32 SECTION_MANIFEST = 1;
    const i32 SECTION_INTERFACE = 2;
    const i32 SECTION_OBJECT = 3;
    const i32 SECTION_BITCODE = 4;
    // the same sections stored as `u32 raw size` + an LZ4 block; readers that do not know the kinds ignore them
    const i32 SECTION_INTERFACE_LZ4 = 5;
    const i32 SECTION_BITCODE_LZ4 = 6;
    const i32 FLAG_STD = 1;
    // section checksums and the interface hash use the vectorizable text hash instead of FNV-1a (older libraries use FNV-1a)
    const i32 FLAG_TEXT_HASH = 2;

    public static bool active() {
        return library_loaded != 0;
    }

    public static unsafe IdList* bodies() {
        if (library_bodies == null) {
            library_bodies = (ptr)IdList.create();
        }
        return (IdList*)library_bodies;
    }

    public static void record_body(i32 open, i32 close) {
        IdList* ranges = Library.bodies();
        ranges.push((u32)open);
        ranges.push((u32)close);
    }

    static unsafe PointerList* resident() {
        if (library_resident == null) {
            library_resident = (ptr)PointerList.create();
        }
        return (PointerList*)library_resident;
    }

    static unsafe PointerList* resident_sizes() {
        if (library_resident_sizes == null) {
            library_resident_sizes = (ptr)PointerList.create();
        }
        return (PointerList*)library_resident_sizes;
    }

    public static unsafe PointerList* bitcode() {
        if (library_bitcode == null) {
            library_bitcode = (ptr)PointerList.create();
        }
        return (PointerList*)library_bitcode;
    }

    public static unsafe PointerList* bitcode_sizes() {
        if (library_bitcode_sizes == null) {
            library_bitcode_sizes = (ptr)PointerList.create();
        }
        return (PointerList*)library_bitcode_sizes;
    }

    public static unsafe void set_bitcode(ptr<i8> data, u64 size) {
        library_pending_bitcode = data;
        library_pending_bitcode_size = size;
    }

    static unsafe PointerList* macro_objects() {
        if (library_macro_objects == null) {
            library_macro_objects = (ptr)PointerList.create();
        }
        return (PointerList*)library_macro_objects;
    }

    static unsafe PointerList* macro_object_sizes() {
        if (library_macro_sizes == null) {
            library_macro_sizes = (ptr)PointerList.create();
        }
        return (PointerList*)library_macro_sizes;
    }

    static unsafe PointerList* objects() {
        if (library_objects == null) {
            library_objects = (ptr)PointerList.create();
        }
        return (PointerList*)library_objects;
    }

    static void put_u32(ByteBuffer* out, u32 value) {
        for (mut i32 i = 0; i < 4; i = i + 1) {
            out.append_byte((i32)((value >> (u32)(i * 8)) & 255));
        }
    }

    static void put_u64(ByteBuffer* out, u64 value) {
        for (mut i32 i = 0; i < 8; i = i + 1) {
            out.append_byte((i32)((value >> (u64)(i * 8)) & 255));
        }
    }

    static void put_fixed(ByteBuffer* out, ptr<i8> text) {
        mut i32 length = strlen(text);
        if (length > Library.TEXT_FIELD_SIZE - 1) {
            length = Library.TEXT_FIELD_SIZE - 1;
        }
        out.append_slice(text, length);
        for (mut i32 i = length; i < Library.TEXT_FIELD_SIZE; i = i + 1) {
            out.append_byte(0);
        }
    }

    static void put_text(ByteBuffer* out, ptr<i8> text, i32 length) {
        Library.put_u32(out, (u32)length);
        out.append_slice(text, length);
    }

    static unsafe u32 get_u32(ptr<i8> data, i32 offset) {
        mut u32 value = 0;
        for (mut i32 i = 3; i >= 0; i = i - 1) {
            value = (value << 8) | (u32)(u8)data[offset + i];
        }
        return value;
    }

    static unsafe u64 get_u64(ptr<i8> data, i32 offset) {
        mut u64 value = 0;
        for (mut i32 i = 7; i >= 0; i = i - 1) {
            value = (value << 8) | (u64)(u8)data[offset + i];
        }
        return value;
    }

    // Hash of the header and the section table of a stored library, with the hash field itself counted as zero. It covers
    // what locates and describes every section, which the per-section checksums cannot.
    static unsafe u64 head_checksum(ptr<i8> data, i32 length) {
        i32 count = (i32)Library.get_u32(data, 20);
        i32 table = (i32)Library.get_u32(data, 24);
        i32 end = table + count * Library.ENTRY_SIZE;
        if (table < Library.HEADER_SIZE || count < 0 || count > 64 || end > length) {
            return 0;
        }
        ptr<i8> copy = (ptr<i8>)Memory.zalloc((u64)end + 1);
        memcpy(copy, data, (u64)end);
        for (mut i32 i = 0; i < 8; i = i + 1) {
            copy[Library.HEADER_HASH_OFFSET + i] = (i8)0;
        }
        return TextHash.of(copy, end);
    }

    // Records the header-and-table hash in the header of a library being written (the buffer holds the header and the table).
    static unsafe void seal_head(ByteBuffer* out) {
        ByteBuffer* field = ByteBuffer.create();
        Library.put_u64(field, Library.head_checksum(out.data, out.length));
        memcpy(out.data + Library.HEADER_HASH_OFFSET, field.data, 8);
    }

    // True when the header and table match the hash the header records (always true without one).
    static unsafe bool head_intact(ptr<i8> data, i32 length) {
        u64 recorded = Library.get_u64(data, Library.HEADER_HASH_OFFSET);
        return recorded == 0 || recorded == Library.head_checksum(data, length);
    }

    // Checksum of a section of the library whose header is `header`: the text hash when the header says so.
    static unsafe u64 section_checksum(ptr<i8> header, ptr<i8> data, i32 length) {
        if ((Library.get_u32(header, 16) & (u32)Library.FLAG_TEXT_HASH) != 0) {
            return TextHash.of(data, length);
        }
        return Library.checksum(data, length);
    }

    static unsafe u64 checksum(ptr<i8> data, i32 length) {
        mut u64w hash = 14695981039346656037;
        for (mut i32 i = 0; i < length; i = i + 1) {
            hash = (hash ^ (u64)(u8)data[i]) * 1099511628211;
        }
        return hash;
    }

    static void put_varint(ByteBuffer* out, u32 value) {
        mut u32 rest = value;
        while (rest >= 128) {
            out.append_byte((i32)((rest & 127) | 128));
            rest = rest >> 7;
        }
        out.append_byte((i32)rest);
    }

    static unsafe u32 get_varint(ptr<i8> data, ptr<i32> cursor) {
        mut u32 value = 0;
        mut u32 shift = 0;
        while (true) {
            u32 byte = (u32)(u8)data[cursor[0]];
            cursor[0] = cursor[0] + 1;
            value = value | ((byte & 127) << shift);
            if (byte < 128) {
                break;
            }
            shift = shift + 7;
        }
        return value;
    }

    // A keyword or a symbol is its kind; everything else (names, literals, `var`) carries its text.
    static unsafe bool explicit_atom(TokenKind kind) {
        ptr<i8> text = kind.text;
        return text[0] == 0 || kind == TokenKind::AUTO;
    }

    static unsafe bool word_kind(TokenKind kind) {
        ptr<i8> text = kind.text;
        return text[0] != 0 && Strings.is_ident_start(Strings.char_at(text, 0));
    }

    static unsafe bool literal_kind(TokenKind kind) {
        return kind == TokenKind::STRING_LITERAL || kind == TokenKind::CHAR_LITERAL || kind == TokenKind::INTERP_BEGIN
            || kind == TokenKind::INTERP_MIDDLE || kind == TokenKind::INTERP_END || kind == TokenKind::INTERP_FORMAT;
    }

    static unsafe void stage_raw(Staged* staged, TokenKind kind, u32 atom, bool space) {
        mut i32 code = kind.getValue();
        if (space) {
            code = code | 128;
        }
        staged.kinds[staged.count] = (u8)code;
        staged.atoms[staged.count] = atom;
        staged.count = staged.count + 1;
    }

    static unsafe void stage_token(Staged* staged, TokenList* list, i32 index) {
        TokenKind kind = list.kind(index);
        mut bool space = false;
        if (staged.previous >= 0) {
            TokenKind before = list.kind(staged.previous);
            space = Library.literal_kind(before) || list.start(index) != list.start(staged.previous) + (u32)list.text_length(staged.previous);
        }
        mut u32 atom = 4294967295;
        if (Library.explicit_atom(kind)) {
            atom = list.atom(index);
        } else if (list.raw_atom(index) != 0) {
            ptr<i8> keyword = kind.text;
            if (list.text_length(index) != strlen(keyword) || memcmp(list.text(index), keyword, (u64)strlen(keyword)) != 0) {
                staged.failed = true;
            }
        }
        Library.stage_raw(staged, kind, atom, space);
        staged.previous = index;
    }

    // The tokens of a file as the interface keeps them: bodies of functions that need none become `{}`.
    static unsafe void stage_file(Staged* staged, SourceFile* file) {
        TokenList* list = TokenList.get();
        IdList* ranges = Library.bodies();
        staged.count = 0;
        staged.previous = -1;
        mut i32 cursor = file.first_token;
        i32 end = file.token_end - 1;
        for (mut i32 r = 0; r + 1 < ranges.length; r = r + 2) {
            i32 open = (i32)ranges.get(r);
            i32 close = (i32)ranges.get(r + 1);
            if (open < file.first_token || open >= file.token_end || open < cursor) {
                continue;
            }
            for (mut i32 t = cursor; t <= open; t = t + 1) {
                Library.stage_token(staged, list, t);
            }
            Library.stage_raw(staged, TokenKind::RBRACE, 4294967295, false);
            staged.previous = close;
            cursor = close + 1;
        }
        for (mut i32 t = cursor; t < end; t = t + 1) {
            Library.stage_token(staged, list, t);
        }
    }

    static unsafe bool staged_kind(Staged* staged, i32 at, i32 code) {
        return at < staged.count && ((i32)staged.kinds[at] & 127) == code;
    }

    static unsafe bool staged_joined(Staged* staged, i32 at, i32 code) {
        return Library.staged_kind(staged, at, code) && ((i32)staged.kinds[at] & 128) == 0;
    }

    static unsafe void append_atom(ByteBuffer* key, u32 atom) {
        AtomTable* table = Atoms.get();
        key.append_slice(table.text(atom), (i32)table.length(atom));
    }

    // A qualified name (`std::meta::Reflect`) or an attribute (`[Reflect]`) is one phrase when it repeats: its key is its text.
    static unsafe i32 phrase_at(Staged* staged, i32 at, ByteBuffer* key) {
        key.length = 0;
        i32 name = TokenKind::IDENTIFIER.getValue();
        i32 colons = TokenKind::COLON_COLON.getValue();
        if (Library.staged_kind(staged, at, name)) {
            mut i32 length = 1;
            while (Library.staged_joined(staged, at + length, colons) && Library.staged_joined(staged, at + length + 1, name)) {
                length = length + 2;
            }
            if (length < 3) {
                return 0;
            }
            for (mut i32 i = 0; i < length; i = i + 2) {
                if (i > 0) {
                    key.append("::");
                }
                Library.append_atom(key, staged.atoms[at + i]);
            }
            return length;
        }
        if (Library.staged_kind(staged, at, TokenKind::LBRACKET.getValue()) && Library.staged_joined(staged, at + 1, name)
            && Library.staged_joined(staged, at + 2, TokenKind::RBRACKET.getValue())) {
            key.append("[");
            Library.append_atom(key, staged.atoms[at + 1]);
            key.append("]");
            return 3;
        }
        return 0;
    }

    static unsafe i32 phrase_use(Staged* staged, i32 at, ByteBuffer* key, PhraseStats* stats, ptr<i32> id) {
        i32 length = Library.phrase_at(staged, at, key);
        if (length == 0) {
            return 0;
        }
        u32 found = stats.table.intern_copy(key.data, (u32)key.length);
        if ((i32)found >= stats.known || stats.counts[found] < 2) {
            return 0;
        }
        id[0] = (i32)found;
        return length;
    }

    // Orders the ids whose count reaches `minimum` from the most to the least used (stable), so frequent ones get short indexes.
    static unsafe i32 rank(ptr<u32> counts, i32 total, u32 minimum, ptr<i32> order, ptr<i32> position) {
        mut u32 top = 0;
        for (mut i32 i = 0; i < total; i = i + 1) {
            if (counts[i] > top) {
                top = counts[i];
            }
        }
        ptr<i32> bucket = (ptr<i32>)Memory.zalloc(((u64)top + 2) * 4);
        mut i32 used = 0;
        for (mut i32 i = 0; i < total; i = i + 1) {
            if (counts[i] >= minimum && counts[i] > 0) {
                bucket[counts[i]] = bucket[counts[i]] + 1;
                used = used + 1;
            }
        }
        mut i32 running = 0;
        for (mut i32 c = (i32)top; c >= 0; c = c - 1) {
            i32 here = bucket[c];
            bucket[c] = running;
            running = running + here;
        }
        for (mut i32 i = 0; i < total; i = i + 1) {
            if (counts[i] >= minimum && counts[i] > 0) {
                i32 slot = bucket[counts[i]];
                bucket[counts[i]] = slot + 1;
                order[slot] = i;
                position[i] = slot;
            }
        }
        return used;
    }

    static unsafe i32 common_directory(PointerList* files) {
        SourceFile* first = (SourceFile*)files.get(0);
        mut i32 shared = strlen(first.path);
        for (mut i32 f = 1; f < files.length; f = f + 1) {
            SourceFile* other = (SourceFile*)files.get(f);
            mut i32 same = 0;
            while (same < shared && other.path[same] != 0 && other.path[same] == first.path[same]) {
                same = same + 1;
            }
            shared = same;
        }
        mut i32 cut = 0;
        for (mut i32 i = 0; i < shared; i = i + 1) {
            if (first.path[i] == 47 || first.path[i] == 92) {
                cut = i + 1;
            }
        }
        return cut;
    }

    // The interface: a string table of every name, a table of repeated qualified names and attributes, and per file the
    // token stream (kind byte, bit 7 = whitespace before, then an index for tokens that carry text). It holds no source text.
    static unsafe bool pack_interface(ByteBuffer* out, PointerList* files) {
        out.append("DJI1");
        if (files.length == 0) {
            Library.put_varint(out, 0);
            Library.put_varint(out, 0);
            Library.put_varint(out, 0);
            return true;
        }
        AtomTable* table = Atoms.get();
        mut i32 widest = 0;
        mut i32 total = 0;
        for (mut i32 f = 0; f < files.length; f = f + 1) {
            SourceFile* file = (SourceFile*)files.get(f);
            i32 size = file.token_end - file.first_token;
            if (size > widest) {
                widest = size;
            }
            total = total + size;
        }
        Staged* staged = (Staged*)Memory.zalloc(sizeof(Staged));
        staged.kinds = (ptr<u8>)Memory.zalloc((u64)widest + 8);
        staged.atoms = (ptr<u32>)Memory.zalloc(((u64)widest + 8) * 4);
        PhraseStats* stats = (PhraseStats*)Memory.zalloc(sizeof(PhraseStats));
        stats.table = AtomTable.create(Memory.arena());
        stats.counts = (ptr<u32>)Memory.zalloc(((u64)total * 3 + 8) * 4);
        ptr<u32> atom_counts = (ptr<u32>)Memory.zalloc(((u64)table.count + 8) * 4);
        ByteBuffer* key = ByteBuffer.create();
        ptr<i32> id = (ptr<i32>)Memory.zalloc(8);

        for (mut i32 f = 0; f < files.length; f = f + 1) {
            Library.stage_file(staged, (SourceFile*)files.get(f));
            if (staged.failed) {
                return false;
            }
            mut i32 i = 0;
            while (i < staged.count) {
                i32 length = Library.phrase_at(staged, i, key);
                if (length > 0) {
                    u32 found = stats.table.intern_copy(key.data, (u32)key.length);
                    stats.counts[found] = stats.counts[found] + 1;
                    i = i + length;
                } else {
                    i = i + 1;
                }
            }
        }
        stats.known = (i32)stats.table.count;
        for (mut i32 f = 0; f < files.length; f = f + 1) {
            Library.stage_file(staged, (SourceFile*)files.get(f));
            mut i32 i = 0;
            while (i < staged.count) {
                i32 length = Library.phrase_use(staged, i, key, stats, id);
                if (length > 0) {
                    i = i + length;
                    continue;
                }
                if (staged.atoms[i] != 4294967295) {
                    atom_counts[staged.atoms[i]] = atom_counts[staged.atoms[i]] + 1;
                }
                i = i + 1;
            }
        }

        i32 atom_total = (i32)table.count;
        ptr<i32> atom_order = (ptr<i32>)Memory.zalloc(((u64)atom_total + 8) * 4);
        ptr<i32> atom_rank = (ptr<i32>)Memory.zalloc(((u64)atom_total + 8) * 4);
        i32 atom_used = Library.rank(atom_counts, atom_total, 1, atom_order, atom_rank);
        ptr<i32> phrase_order = (ptr<i32>)Memory.zalloc(((u64)stats.known + 8) * 4);
        ptr<i32> phrase_rank = (ptr<i32>)Memory.zalloc(((u64)stats.known + 8) * 4);
        i32 phrase_used = Library.rank(stats.counts, stats.known, 2, phrase_order, phrase_rank);

        Library.put_varint(out, (u32)atom_used);
        for (mut i32 k = 0; k < atom_used; k = k + 1) {
            u32 atom = (u32)atom_order[k];
            Library.put_varint(out, table.length(atom));
            out.append_slice(table.text(atom), (i32)table.length(atom));
        }
        Library.put_varint(out, (u32)phrase_used);
        for (mut i32 k = 0; k < phrase_used; k = k + 1) {
            u32 phrase = (u32)phrase_order[k];
            Library.put_varint(out, stats.table.length(phrase));
            out.append_slice(stats.table.text(phrase), (i32)stats.table.length(phrase));
        }

        i32 prefix = Library.common_directory(files);
        Library.put_varint(out, (u32)files.length);
        ByteBuffer* stream = ByteBuffer.create();
        for (mut i32 f = 0; f < files.length; f = f + 1) {
            SourceFile* file = (SourceFile*)files.get(f);
            Library.stage_file(staged, file);
            stream.length = 0;
            mut i32 i = 0;
            while (i < staged.count) {
                i32 length = Library.phrase_use(staged, i, key, stats, id);
                if (length > 0) {
                    stream.append_byte(((i32)staged.kinds[i] & 128) | Library.PHRASE_CODE);
                    Library.put_varint(stream, (u32)phrase_rank[id[0]]);
                    i = i + length;
                    continue;
                }
                stream.append_byte((i32)staged.kinds[i]);
                if (staged.atoms[i] != 4294967295) {
                    Library.put_varint(stream, (u32)atom_rank[staged.atoms[i]]);
                }
                i = i + 1;
            }
            ptr<i8> relative = file.path + prefix;
            Library.put_varint(out, (u32)strlen(relative));
            out.append(relative);
            Library.put_varint(out, (u32)staged.count);
            Library.put_varint(out, (u32)stream.length);
            out.append_slice(stream.data, stream.length);
        }
        return true;
    }

    // Reads the tables and the per-file streams of an interface section; false when it is not this format.
    static unsafe bool read_interface(ptr<i8> data, i32 offset, i32 size, LibraryInterface* context) {
        i32 end = offset + size;
        if (size < 4 || memcmp(data + offset, "DJI1", 4) != 0) {
            return false;
        }
        ptr<i32> cursor = (ptr<i32>)Memory.zalloc(8);
        cursor[0] = offset + 4;
        AtomTable* table = Atoms.get();
        context.atom_count = (i32)Library.get_varint(data, cursor);
        context.atoms = (ptr<u32>)Memory.zalloc(((u64)context.atom_count + 1) * 4);
        for (mut i32 k = 0; k < context.atom_count; k = k + 1) {
            i32 length = (i32)Library.get_varint(data, cursor);
            if (cursor[0] + length > end) {
                return false;
            }
            context.atoms[k] = table.intern_copy(data + cursor[0], (u32)length);
            cursor[0] = cursor[0] + length;
        }
        context.phrase_count = (i32)Library.get_varint(data, cursor);
        context.phrases = (ptr<ptr<i8>>)Memory.zalloc(((u64)context.phrase_count + 1) * 8);
        for (mut i32 k = 0; k < context.phrase_count; k = k + 1) {
            i32 length = (i32)Library.get_varint(data, cursor);
            if (cursor[0] + length > end) {
                return false;
            }
            context.phrases[k] = Strings.duplicate(data + cursor[0], length);
            cursor[0] = cursor[0] + length;
        }
        i32 count = (i32)Library.get_varint(data, cursor);
        context.files = PointerList.create();
        PointerList* files = context.files;
        for (mut i32 f = 0; f < count; f = f + 1) {
            PackedFile* packed = (PackedFile*)Memory.zalloc(sizeof(PackedFile));
            i32 path_length = (i32)Library.get_varint(data, cursor);
            if (cursor[0] + path_length > end) {
                return false;
            }
            packed.path = Strings.duplicate(data + cursor[0], path_length);
            cursor[0] = cursor[0] + path_length;
            packed.token_count = (i32)Library.get_varint(data, cursor);
            i32 stream = (i32)Library.get_varint(data, cursor);
            packed.start = cursor[0];
            packed.end = cursor[0] + stream;
            if (packed.end > end) {
                return false;
            }
            cursor[0] = packed.end;
            files.push((ptr)packed);
        }
        return true;
    }

    static unsafe void push_word(TokenList* tokens, u32 position, ptr<i8> text, i32 length) {
        AtomTable* table = Atoms.get();
        tokens.push(TokenKind::IDENTIFIER, position, table.intern_copy(text, (u32)length) + 1);
    }

    // Turns a file's token stream back into tokens (the lexer is not run on interfaces).
    public static unsafe void unpack(SourceFile* file) {
        TokenList* tokens = TokenList.get();
        LibraryInterface* context = (LibraryInterface*)file.packed_context;
        AtomTable* table = Atoms.get();
        ptr<i8> data = file.packed;
        ptr<i32> cursor = (ptr<i32>)Memory.zalloc(8);
        cursor[0] = file.packed_start;
        file.first_token = tokens.length;
        mut u32 position = 0;
        while (cursor[0] < file.packed_end) {
            i32 byte = (i32)(u8)data[cursor[0]];
            cursor[0] = cursor[0] + 1;
            i32 code = byte & 127;
            if (byte >= 128) {
                position = position + 1;
            }
            if (code == Library.PHRASE_CODE) {
                ptr<i8> text = context.phrases[(i32)Library.get_varint(data, cursor)];
                i32 length = strlen(text);
                if (text[0] == 91) {
                    tokens.push(TokenKind::LBRACKET, position, 0);
                    Library.push_word(tokens, position + 1, text + 1, length - 2);
                    tokens.push(TokenKind::RBRACKET, position + (u32)length - 1, 0);
                } else {
                    mut i32 from = 0;
                    for (mut i32 i = 0; i <= length; i = i + 1) {
                        if (i == length || (text[i] == 58 && text[i + 1] == 58)) {
                            Library.push_word(tokens, position + (u32)from, text + from, i - from);
                            if (i < length) {
                                tokens.push(TokenKind::COLON_COLON, position + (u32)i, 0);
                                i = i + 1;
                            }
                            from = i + 1;
                        }
                    }
                }
                position = position + (u32)length;
                continue;
            }
            TokenKind kind = (TokenKind)code;
            if (Library.explicit_atom(kind)) {
                u32 atom = context.atoms[(i32)Library.get_varint(data, cursor)];
                tokens.push(kind, position, atom + 1);
                position = position + table.length(atom);
                if (Library.literal_kind(kind)) {
                    position = position + 2;
                }
            } else {
                ptr<i8> text = kind.text;
                i32 length = strlen(text);
                if (Library.word_kind(kind)) {
                    tokens.push(kind, position, table.intern_copy(text, (u32)length) + 1);
                } else {
                    tokens.push(kind, position, 0);
                }
                position = position + (u32)length;
            }
        }
        tokens.push(TokenKind::END_OF_FILE, position, 0);
        file.token_end = tokens.length;
    }

    // Source-like text of a packed file, for --inspect-lib only (it is not parsed again).
    static unsafe void render(ByteBuffer* out, ptr<i8> data, PackedFile* packed, LibraryInterface* context) {
        AtomTable* table = Atoms.get();
        ptr<i32> cursor = (ptr<i32>)Memory.zalloc(8);
        cursor[0] = packed.start;
        while (cursor[0] < packed.end) {
            i32 byte = (i32)(u8)data[cursor[0]];
            cursor[0] = cursor[0] + 1;
            i32 code = byte & 127;
            if (byte >= 128) {
                out.append_byte(32);
            }
            if (code == Library.PHRASE_CODE) {
                out.append(context.phrases[(i32)Library.get_varint(data, cursor)]);
                continue;
            }
            TokenKind kind = (TokenKind)code;
            if (!Library.explicit_atom(kind)) {
                out.append(kind.text);
                continue;
            }
            u32 atom = context.atoms[(i32)Library.get_varint(data, cursor)];
            ptr<i8> text = table.text(atom);
            i32 length = (i32)table.length(atom);
            if (kind == TokenKind::STRING_LITERAL || kind == TokenKind::INTERP_BEGIN) {
                if (kind == TokenKind::INTERP_BEGIN) {
                    out.append_byte(36);
                }
                out.append_byte(34);
            } else if (kind == TokenKind::INTERP_MIDDLE || kind == TokenKind::INTERP_END) {
                out.append_byte(125);
            } else if (kind == TokenKind::INTERP_FORMAT) {
                out.append_byte(58);
            } else if (kind == TokenKind::CHAR_LITERAL) {
                out.append_byte(39);
            }
            if (kind == TokenKind::CHAR_LITERAL) {
                i32 point = (i32)Strings.parse_integer(text, length);
                if (point >= 32 && point < 127 && point != 39 && point != 92) {
                    out.append_byte(point);
                } else {
                    out.append("\\u");
                    for (mut i32 shift = 12; shift >= 0; shift = shift - 4) {
                        out.append_byte((i32)Strings.char_at("0123456789abcdef", (point >> shift) & 15));
                    }
                }
                out.append_byte(39);
                continue;
            }
            if (kind == TokenKind::STRING_LITERAL || kind == TokenKind::INTERP_BEGIN || kind == TokenKind::INTERP_MIDDLE
                || kind == TokenKind::INTERP_END || kind == TokenKind::INTERP_FORMAT) {
                for (mut i32 i = 0; i < length; i = i + 1) {
                    i32 c = (i32)(u8)text[i];
                    if (c == 34 || c == 92) {
                        out.append_byte(92);
                    }
                    if (c == 10) {
                        out.append("\\n");
                    } else {
                        out.append_byte(c);
                    }
                }
                if (kind == TokenKind::STRING_LITERAL || kind == TokenKind::INTERP_END) {
                    out.append_byte(34);
                } else if (kind != TokenKind::INTERP_FORMAT) {
                    out.append_byte(123);
                }
                continue;
            }
            out.append_slice(text, length);
        }
    }

    static unsafe ptr<i8> base_name(ptr<i8> path) {
        i32 length = strlen(path);
        mut i32 start = 0;
        mut i32 end = length;
        for (mut i32 i = 0; i < length; i = i + 1) {
            if (path[i] == 47 || path[i] == 92) {
                start = i + 1;
            }
        }
        for (mut i32 i = start; i < length; i = i + 1) {
            if (path[i] == 46) {
                end = i;
            }
        }
        return Strings.duplicate(path + start, end - start);
    }

    public static bool write(Options* options, ptr<i8> object_path) {
        i32 object_length = 0;
        ptr<i8> object = Files.read_bytes(object_path, &object_length);
        if (object == null) {
            logger_error(Log.get(), "djinnc: cannot read the object '%s'", object_path);
            return false;
        }

        ByteBuffer* iface = ByteBuffer.create();
        PointerList* chosen = PointerList.create();
        PointerList* inputs = options.inputs;
        PointerList* dependencies = options.dependencies;
        for (mut i32 i = 0; i < inputs.length; i = i + 1) {
            SourceFile* file = Sources.get(i);
            if (dependencies.contains_string(file.path)) {
                continue;
            }
            chosen.push((ptr)file);
        }
        u32 file_count = (u32)chosen.length;
        if (!Library.pack_interface(iface, chosen)) {
            logger_error(Log.get(), "djinnc: a token of the library has no stable text; the interface cannot be written");
            return false;
        }

        ByteBuffer* manifest = ByteBuffer.create();
        ptr<i8> name = Library.base_name(options.output);
        Library.put_text(manifest, name, strlen(name));
        Library.put_text(manifest, Target.triple(), strlen(Target.triple()));
        Library.put_u32(manifest, file_count);
        // the system libraries this library needs (user32, vulkan-1, ...): consumers link and verify them
        PointerList* declared = options.declared_links;
        Library.put_u32(manifest, (u32)declared.length);
        for (mut i32 d = 0; d < declared.length; d = d + 1) {
            ptr<i8> link = (ptr<i8>)declared.get(d);
            Library.put_text(manifest, link, strlen(link));
        }

        // the platforms the library supports (0 = any), after the links
        Library.put_u32(manifest, (u32)options.target_mask);

        mut u32 flags = (u32)Library.FLAG_TEXT_HASH;
        if (options.use_std) {
            flags = flags | (u32)Library.FLAG_STD;
        }
        ptr<i8> bitcode = library_pending_bitcode;
        i32 bitcode_length = (i32)library_pending_bitcode_size;
        mut i32 section_count = 3;
        if (bitcode != null) {
            section_count = 4;
        }
        // Interface and bitcode are stored compressed when that is smaller; the object stays raw (the linker needs it
        // extracted on disk), and so does the small manifest.
        ByteBuffer* iface_stored = Library.compressed(iface.data, iface.length, options.no_compress);
        mut ByteBuffer* bitcode_stored = ByteBuffer.create();
        if (bitcode != null) {
            bitcode_stored = Library.compressed(bitcode, bitcode_length, options.no_compress);
        }
        i32 table_size = Library.HEADER_SIZE + section_count * Library.ENTRY_SIZE;
        ByteBuffer* out = ByteBuffer.create();
        out.append("DJINNLIB");
        Library.put_u32(out, (u32)Library.VERSION);
        Library.put_u32(out, (u32)Library.HEADER_SIZE);
        Library.put_u32(out, flags);
        Library.put_u32(out, (u32)section_count);
        Library.put_u32(out, (u32)Library.HEADER_SIZE);
        Library.put_u32(out, Library.COMPILER_VERSION);
        Library.put_fixed(out, "0.1.0-dev");
        mut ptr<i8> build_id = getenv("DJINN_BUILD_ID");
        if (build_id == null) {
            build_id = "";
        }
        Library.put_fixed(out, build_id);
        // checksum of the interface section: a consumer checks that the interface it parses is the one the header names
        Library.put_u64(out, TextHash.of(iface.data, iface.length));
        while (out.length < Library.HEADER_SIZE) {
            out.append_byte(0);
        }

        mut u64 offset = (u64)table_size;
        for (mut i32 s = 0; s < section_count; s = s + 1) {
            mut ptr<i8> data = manifest.data;
            mut i32 size = manifest.length;
            mut i32 kind = s + 1;
            if (s == 1) {
                data = iface_stored.data;
                size = iface_stored.length;
                if (iface_stored.length != iface.length) {
                    kind = Library.SECTION_INTERFACE_LZ4;
                }
            } else if (s == 2) {
                data = object;
                size = object_length;
            } else if (s == 3) {
                data = bitcode_stored.data;
                size = bitcode_stored.length;
                if (bitcode_stored.length != bitcode_length) {
                    kind = Library.SECTION_BITCODE_LZ4;
                }
            }
            Library.put_u32(out, (u32)kind);
            Library.put_u32(out, 0);
            Library.put_u64(out, offset);
            Library.put_u64(out, (u64)size);
            Library.put_u64(out, TextHash.of(data, size));
            offset = offset + (u64)size;
        }
        // seal the header and the section table
        Library.seal_head(out);
        out.append_slice(manifest.data, manifest.length);
        out.append_slice(iface_stored.data, iface_stored.length);
        out.append_slice(object, object_length);
        if (bitcode != null) {
            out.append_slice(bitcode_stored.data, bitcode_stored.length);
        }
        if (Library.same_content(options.output, out.data, out.length)) {
            // nothing changed (interface, object, bitcode and manifest are byte for byte the same): keep the
            // existing file so its timestamp stays and build systems do not rebuild every consumer
            logger_info(Log.get(), "djinnc: library '%s' is up to date", options.output);
            return true;
        }
        return Files.write_bytes(options.output, out.data, out.length);
    }

    // The platforms a library supports (bits of Target.platform_mask, 0 = any): the u32 after the link list of the
    // manifest, absent in libraries written before it existed.
    static unsafe i32 platforms_of(ptr<i8> data, i32 manifest_offset, i32 manifest_size) {
        i32 end = manifest_offset + manifest_size;
        i32 name_length = (i32)Library.get_u32(data, manifest_offset);
        i32 triple_at = manifest_offset + 4 + name_length;
        i32 links_at = triple_at + 4 + (i32)Library.get_u32(data, triple_at) + 4;
        if (links_at + 4 > end) {
            return 0;
        }
        mut i32 pending = (i32)Library.get_u32(data, links_at);
        mut i32 cursor = links_at + 4;
        while (pending > 0 && cursor + 4 <= end) {
            cursor = cursor + 4 + (i32)Library.get_u32(data, cursor);
            pending = pending - 1;
        }
        if (cursor + 4 > end) {
            return 0;
        }
        return (i32)Library.get_u32(data, cursor);
    }

    // The library must support the platform being built for, and every platform the project supports.
    static unsafe bool check_platforms(Options* options, ptr<i8> path, ptr<i8> data, i32 manifest_offset, i32 manifest_size) {
        i32 mask = Library.platforms_of(data, manifest_offset, manifest_size);
        if (mask == 0) {
            return true;
        }
        ByteBuffer* supported = ByteBuffer.create();
        Target.append_platforms(supported, mask);
        if ((mask & Target.platform_bit()) == 0) {
            logger_error(Log.get(), "djinnc: library '%s' supports %s; building for %s", path, supported.cstr(), Target.platform_name());
            return false;
        }
        if (options.target_mask != 0 && (options.target_mask & mask) != options.target_mask) {
            ByteBuffer* wanted = ByteBuffer.create();
            Target.append_platforms(wanted, options.target_mask);
            logger_error(Log.get(), "djinnc: the project supports %s, but library '%s' supports only %s", wanted.cstr(), path, supported.cstr());
            return false;
        }
        return true;
    }

    // The bytes to store for a section: the data itself, or `u32 raw size` + an LZ4 block when that is smaller
    // (the stored length tells which: it differs from the raw length only for a compressed section).
    static unsafe ByteBuffer* compressed(ptr<i8> data, i32 length, bool disabled) {
        ByteBuffer* raw = ByteBuffer.create();
        raw.append_slice(data, length);
        if (disabled || length < 64) {
            return raw;
        }
        ByteBuffer* packed = ByteBuffer.create();
        Library.put_u32(packed, (u32)length);
        Lz4.compress(data, length, packed);
        if (packed.length >= length) {
            return raw;
        }
        // never store what does not decode back to the same bytes: a compressor bug must not damage a library
        ptr<i8> again = (ptr<i8>)Memory.zalloc((u64)length + 1);
        if (!Lz4.decompress(packed.data + 4, packed.length - 4, again, length) || memcmp(again, data, (u64)length) != 0) {
            logger_warn(Log.get(), "djinnc: compressing a library section failed its round trip check; storing it raw");
            return raw;
        }
        return packed;
    }

    // Returns the library with every compressed section expanded in place of its stored form, so the rest of the
    // compiler reads sections the same way whether or not the file was compressed. The stored bytes are checked
    // against the section checksum first; null (and a message) when one is damaged. A file with nothing compressed
    // is returned as it is. `length` is updated to the size of the returned image.
    static unsafe ptr<i8> expand(ptr<i8> data, ptr<i32> length, ptr<i8> path) {
        i32 count = (i32)Library.get_u32(data, 20);
        i32 table = (i32)Library.get_u32(data, 24);
        if (table < Library.HEADER_SIZE || count < 0 || count > 64 || table + count * Library.ENTRY_SIZE > length[0]) {
            return data;
        }
        mut bool any = false;
        for (mut i32 s = 0; s < count; s = s + 1) {
            u32 kind = Library.get_u32(data, table + s * Library.ENTRY_SIZE);
            if (kind == (u32)Library.SECTION_INTERFACE_LZ4 || kind == (u32)Library.SECTION_BITCODE_LZ4) {
                any = true;
            }
        }
        if (!any) {
            return data;
        }
        i32 head_size = table + count * Library.ENTRY_SIZE;
        ByteBuffer* entries = ByteBuffer.create();
        ByteBuffer* body = ByteBuffer.create();
        for (mut i32 s = 0; s < count; s = s + 1) {
            i32 entry = table + s * Library.ENTRY_SIZE;
            u32 kind = Library.get_u32(data, entry);
            u64 start = Library.get_u64(data, entry + 8);
            u64 span = Library.get_u64(data, entry + 16);
            if (start + span > (u64)length[0]) {
                logger_error(Log.get(), "djinnc: '%s' is corrupted", path);
                return null;
            }
            mut ptr<i8> section = data + (i32)start;
            mut i32 size = (i32)span;
            mut u32 plain_kind = kind;
            if (kind == (u32)Library.SECTION_INTERFACE_LZ4 || kind == (u32)Library.SECTION_BITCODE_LZ4) {
                if (size < 4 || Library.section_checksum(data, section, size) != Library.get_u64(data, entry + 24)) {
                    logger_error(Log.get(), "djinnc: '%s' is corrupted", path);
                    return null;
                }
                i32 raw_size = (i32)Library.get_u32(section, 0);
                if (raw_size <= 0 || raw_size > 1073741824) {
                    logger_error(Log.get(), "djinnc: '%s' is corrupted", path);
                    return null;
                }
                ptr<i8> raw = (ptr<i8>)Memory.zalloc((u64)raw_size + 1);
                if (!Lz4.decompress(section + 4, size - 4, raw, raw_size)) {
                    logger_error(Log.get(), "djinnc: '%s' is corrupted (a compressed section does not decode)", path);
                    return null;
                }
                section = raw;
                size = raw_size;
                plain_kind = (u32)Library.SECTION_INTERFACE;
                if (kind == (u32)Library.SECTION_BITCODE_LZ4) {
                    plain_kind = (u32)Library.SECTION_BITCODE;
                }
            }
            // an entry of the expanded image: raw size and checksum, offset after the table and the earlier sections
            Library.put_u32(entries, plain_kind);
            Library.put_u32(entries, 0);
            Library.put_u64(entries, (u64)(head_size + body.length));
            Library.put_u64(entries, (u64)size);
            Library.put_u64(entries, Library.section_checksum(data, section, size));
            body.append_slice(section, size);
        }
        ByteBuffer* image = ByteBuffer.create();
        image.append_slice(data, table);
        image.append_slice(entries.data, entries.length);
        image.append_slice(body.data, body.length);
        length[0] = image.length;
        return image.data;
    }

    // True when the file already holds a library with the same header (up to the label) and sections that store
    // the same bytes as the new one. The build id is not compared.
    static unsafe bool same_content(ptr<i8> path, ptr<i8> data, i32 length) {
        i32 old_length = 0;
        ptr<i8> old = Files.read_bytes(path, &old_length);
        if (old == null) {
            return false;
        }
        if (old_length != length || Library.get_u32(old, 20) != Library.get_u32(data, 20)) {
            return false;
        }
        // format, flags, compiler version and label must match, so a new compiler always rewrites the file
        for (mut i32 h = 0; h < 64; h = h + 1) {
            if (old[h] != data[h]) {
                return false;
            }
        }
        i32 count = (i32)Library.get_u32(data, 20);
        i32 table = (i32)Library.get_u32(data, 24);
        for (mut i32 s = 0; s < count; s = s + 1) {
            i32 entry = table + s * Library.ENTRY_SIZE;
            if (entry + Library.ENTRY_SIZE > length || entry + Library.ENTRY_SIZE > old_length) {
                return false;
            }
            // kind, size and checksum of the stored section (the offset follows from the sizes)
            if (Library.get_u32(old, entry) != Library.get_u32(data, entry)
                || Library.get_u64(old, entry + 16) != Library.get_u64(data, entry + 16)
                || Library.get_u64(old, entry + 24) != Library.get_u64(data, entry + 24)) {
                return false;
            }
        }
        return true;
    }

    static unsafe bool section(ptr<i8> data, i32 length, i32 kind, ptr<i32> offset, ptr<i32> size) {
        i32 count = (i32)Library.get_u32(data, 20);
        i32 table = (i32)Library.get_u32(data, 24);
        for (mut i32 s = 0; s < count; s = s + 1) {
            i32 entry = table + s * Library.ENTRY_SIZE;
            if (entry + Library.ENTRY_SIZE > length) {
                return false;
            }
            if ((i32)Library.get_u32(data, entry) != kind) {
                continue;
            }
            u64 start = Library.get_u64(data, entry + 8);
            u64 span = Library.get_u64(data, entry + 16);
            if (start + span > (u64)length) {
                return false;
            }
            offset[0] = (i32)start;
            size[0] = (i32)span;
            return Library.section_checksum(data, data + (i32)start, (i32)span) == Library.get_u64(data, entry + 24);
        }
        return false;
    }

    static unsafe bool file_exists(ptr<i8> path) {
        ptr file = fopen(path, "rb");
        if (file == null) {
            return false;
        }
        fclose(file);
        return true;
    }

    static unsafe bool known_system_library(ptr<i8> name) {
        ByteBuffer* lower = ByteBuffer.create();
        for (mut i32 i = 0; name[i] != 0; i = i + 1) {
            mut i8 c = name[i];
            if (c >= 65 && c <= 90) {
                c = (i8)(c + 32);
            }
            lower.append_byte(c);
        }
        ptr<i8> text = lower.cstr();
        return Strings.same(text, "kernel32") || Strings.same(text, "user32") || Strings.same(text, "gdi32")
            || Strings.same(text, "shell32") || Strings.same(text, "ole32") || Strings.same(text, "oleaut32")
            || Strings.same(text, "advapi32") || Strings.same(text, "comdlg32") || Strings.same(text, "comctl32")
            || Strings.same(text, "winmm") || Strings.same(text, "ws2_32") || Strings.same(text, "ntdll")
            || Strings.same(text, "opengl32") || Strings.same(text, "dwmapi") || Strings.same(text, "uxtheme")
            || Strings.same(text, "delayimp");
    }

    static unsafe bool probe_import_library(Options* options, ptr<i8> dir, ptr<i8> file, bool add_path) {
        ByteBuffer* candidate = ByteBuffer.create();
        candidate.append(dir);
        candidate.append_char('/');
        candidate.append(file);
        if (!Library.file_exists(candidate.cstr())) {
            return false;
        }
        if (add_path) {
            ByteBuffer* argument = ByteBuffer.create();
            argument.append("-L");
            argument.append(dir);
            ByteBuffer* link_args = options.link_args;
            Linker.append_link_arg(options, link_args, argument.cstr());
        }
        return true;
    }

    // Looks for NAME.lib next to the library, in its native/ folder, in the -L directories and in LIB; a directory that
    // is not already searched is added to the linker's search path.
    static unsafe bool find_import_library(Options* options, ptr<i8> library_path, ptr<i8> name) {
        ByteBuffer* file = ByteBuffer.create();
        file.append(name);
        file.append(".lib");
        ByteBuffer* here = ByteBuffer.create();
        here.append(library_path);
        mut i32 cut = here.length;
        while (cut > 0 && here.data[cut - 1] != 47 && here.data[cut - 1] != 92) {
            cut = cut - 1;
        }
        here.length = cut;
        if (cut == 0) {
            here.append("./");
        }
        ByteBuffer* beside = ByteBuffer.create();
        beside.append(here.cstr());
        if (Library.probe_import_library(options, beside.cstr(), file.cstr(), true)) {
            return true;
        }
        ByteBuffer* native = ByteBuffer.create();
        native.append(here.cstr());
        native.append("native");
        if (Library.probe_import_library(options, native.cstr(), file.cstr(), true)) {
            return true;
        }
        ByteBuffer* sibling = ByteBuffer.create();
        sibling.append(here.cstr());
        sibling.append("../native");
        if (Library.probe_import_library(options, sibling.cstr(), file.cstr(), true)) {
            return true;
        }
        PointerList* system_libs = options.system_libs;
        for (mut i32 k = 0; k < system_libs.length; k = k + 1) {
            ptr<i8> given = (ptr<i8>)system_libs.get(k);
            if (given[0] == 45 && given[1] == 76 && Library.probe_import_library(options, given + 2, file.cstr(), false)) {
                return true;
            }
        }
        ptr<i8> search = getenv("LIB");
        if (search != null) {
            i32 total = strlen(search);
            mut i32 start = 0;
            for (mut i32 i = 0; i <= total; i = i + 1) {
                if (i == total || search[i] == 59) {
                    if (i > start) {
                        ptr<i8> directory = Strings.duplicate(search + start, i - start);
                        if (Library.probe_import_library(options, directory, file.cstr(), false)) {
                            return true;
                        }
                    }
                    start = i + 1;
                }
            }
        }
        return false;
    }

    // Links what an imported library declared it needs, once however many libraries ask, and checks that it can be found:
    // a missing file path is an error, a missing import library is reported before the linker fails with undefined symbols.
    static unsafe bool link_dependencies(Options* options, ptr<i8> path, ptr<i8> data, i32 manifest_offset, i32 manifest_size, i32 after_triple) {
        i32 count_at = after_triple + 4;
        if (count_at + 4 > manifest_offset + manifest_size) {
            return true;
        }
        i32 count = (i32)Library.get_u32(data, count_at);
        mut i32 cursor = count_at + 4;
        for (mut i32 k = 0; k < count; k = k + 1) {
            if (cursor + 4 > manifest_offset + manifest_size) {
                logger_error(Log.get(), "djinnc: '%s' is corrupted", path);
                return false;
            }
            i32 size = (i32)Library.get_u32(data, cursor);
            ptr<i8> dependency = Strings.duplicate(data + cursor + 4, size);
            cursor = cursor + 4 + size;
            PointerList* linked = options.linked;
            if (linked.contains_string(dependency)) {
                continue;
            }
            linked.push((ptr)dependency);
            if (dependency[0] == 45 && dependency[1] == 108 && Linker.is_windows()) {
                ptr<i8> name = dependency + 2;
                if (!Library.find_import_library(options, path, name) && !Library.known_system_library(name)) {
                    logger_warn(Log.get(), "djinnc: '%s' needs the library '%s', which was not found next to it, in the -L directories or in LIB", path, name);
                }
            } else if (dependency[0] != 45) {
                mut bool has_directory = false;
                for (mut i32 i = 0; dependency[i] != 0; i = i + 1) {
                    if (dependency[i] == 47 || dependency[i] == 92) {
                        has_directory = true;
                    }
                }
                if (has_directory && !Library.file_exists(dependency)) {
                    logger_error(Log.get(), "djinnc: '%s' needs '%s', which does not exist", path, dependency);
                    return false;
                }
            }
            ByteBuffer* link_args = options.link_args;
            Linker.append_link_arg(options, link_args, dependency);
        }
        return true;
    }

    // When cross-compiling, <dir>/<triple>/<name>.djlib (built for the target) is preferred over <dir>/<name>.djlib,
    // which may then be a library of procedural macros built for the host.
    public static unsafe ptr<i8> for_target(Options* options, ptr<i8> path) {
        if (!Target.is_cross(options.target)) {
            return path;
        }
        ptr<i8> directory = Linker.directory_of(path);
        ByteBuffer* candidate = ByteBuffer.create();
        candidate.append(directory);
        candidate.append(Target.triple());
        candidate.append("/");
        candidate.append(path + strlen(directory));
        if (Library.file_exists(candidate.cstr())) {
            return candidate.cstr();
        }
        return path;
    }

    public static unsafe i32 load(Options* options, ptr<i8> path, PointerList* diagnostics_list) {
        i32 length = 0;
        mut ptr<i8> data = Files.read_bytes(path, &length);
        if (data == null || length < Library.HEADER_SIZE || memcmp(data, "DJINNLIB", 8) != 0) {
            logger_error(Log.get(), "djinnc: '%s' is not a djinn library", path);
            return -1;
        }
        if ((i32)Library.get_u32(data, 8) != Library.VERSION) {
            logger_error(Log.get(), "djinnc: '%s' has an unsupported library version", path);
            return -1;
        }
        // Version policy: a library is read only by a compiler of the same major.minor version (the patch does not
        // change the interface or the object conventions). Libraries of other versions must be built again.
        u32 written_by = Library.get_u32(data, 28);
        if ((written_by >> 8) != (Library.COMPILER_VERSION >> 8)) {
            logger_error(Log.get(), "djinnc: '%s' was written by djinnc %d.%d.%d, this is djinnc %d.%d.%d; build the library again with this compiler", path,
                (i32)(written_by >> 16), (i32)((written_by >> 8) & 255), (i32)(written_by & 255),
                (i32)(Library.COMPILER_VERSION >> 16), (i32)((Library.COMPILER_VERSION >> 8) & 255), (i32)(Library.COMPILER_VERSION & 255));
            return -1;
        }
        if (!Library.head_intact(data, length)) {
            logger_error(Log.get(), "djinnc: '%s' is corrupted (its header or section table does not match the recorded hash)", path);
            return -1;
        }
        data = Library.expand(data, &length, path);
        if (data == null) {
            return -1;
        }
        i32 interface_offset = 0;
        i32 interface_size = 0;
        i32 object_offset = 0;
        i32 object_size = 0;
        i32 manifest_offset = 0;
        i32 manifest_size = 0;
        bool intact = Library.section(data, length, Library.SECTION_MANIFEST, &manifest_offset, &manifest_size)
            && Library.section(data, length, Library.SECTION_INTERFACE, &interface_offset, &interface_size)
            && Library.section(data, length, Library.SECTION_OBJECT, &object_offset, &object_size);
        if (!intact) {
            logger_error(Log.get(), "djinnc: '%s' is corrupted", path);
            return -1;
        }
        // the header names the interface it was built with (0 in libraries written before the field existed)
        u64 interface_hash = Library.get_u64(data, Library.INTERFACE_HASH_OFFSET);
        if (interface_hash != 0 && interface_hash != Library.section_checksum(data, data + interface_offset, interface_size)) {
            logger_error(Log.get(), "djinnc: '%s' is stale: its interface does not match the one recorded in the header; build the library again", path);
            return -1;
        }
        if ((Library.get_u32(data, 16) & (u32)Library.FLAG_STD) != 0 && !options.use_std && !Target.is_js()) {
            logger_error(Log.get(), "djinnc: '%s' was built with --std; compile with --std too", path);
            return -1;
        }

        i32 name_length = (i32)Library.get_u32(data, manifest_offset);
        i32 triple_at = manifest_offset + 4 + name_length;
        i32 triple_size = (i32)Library.get_u32(data, triple_at);
        // While cross-compiling, a library built for the host only lends its procedural macros: they run in the JIT,
        // and nothing of it is linked into the program.
        bool for_target = Strings.equals(data + triple_at + 4, triple_size, Target.triple());
        bool macros_only = !for_target && !Target.is_native() && Strings.equals(data + triple_at + 4, triple_size, Target.host_triple());
        // a library that names the platforms it supports says so, instead of failing later at link time
        if (!Library.check_platforms(options, path, data, manifest_offset, manifest_size)) {
            return -1;
        }
        if (!for_target && !macros_only) {
            logger_error(Log.get(), "djinnc: '%s' targets a different triple than '%s'", path, Target.triple());
            return -1;
        }
        if (macros_only) {
            Library.macro_objects().push((ptr)(data + object_offset));
            Library.macro_object_sizes().push((ptr)(u64)object_size);
            return Library.read_packed_files(path, data, interface_offset, interface_size, options, diagnostics_list, true);
        }

        if (!Library.link_dependencies(options, path, data, manifest_offset, manifest_size, triple_at + 4 + triple_size)) {
            return -1;
        }

        i32 bitcode_offset = 0;
        i32 bitcode_size = 0;
        if (Library.section(data, length, Library.SECTION_BITCODE, &bitcode_offset, &bitcode_size)) {
            Library.bitcode().push((ptr)(data + bitcode_offset));
            Library.bitcode_sizes().push((ptr)(u64)bitcode_size);
        }

        if (Target.is_native()) {
            Library.macro_objects().push((ptr)(data + object_offset));
            Library.macro_object_sizes().push((ptr)(u64)object_size);
        }
        if (options.run || options.check_only) {
            Library.resident().push((ptr)(data + object_offset));
            Library.resident_sizes().push((ptr)(u64)object_size);
            library_loaded = 1;
        } else {
        PointerList* objects = Library.objects();
        ByteBuffer* object_path = ByteBuffer.create();
        object_path.append(options.output);
        object_path.append(".lib");
        object_path.append_int(objects.length);
        object_path.append(".obj");
        if (!Files.write_bytes(object_path.cstr(), data + object_offset, object_size)) {
            logger_error(Log.get(), "djinnc: cannot write '%s'", object_path.cstr());
            return -1;
        }
        objects.push((ptr)object_path.cstr());
        ByteBuffer* link_args = options.link_args;
        link_args.append(" \"");
        link_args.append(object_path.cstr());
        link_args.append("\"");
        }

        library_loaded = 1;
        return Library.read_packed_files(path, data, interface_offset, interface_size, options, diagnostics_list, false);
    }

    // Adds the source files packed in a library's interface, as headers of the program being compiled.
    static unsafe i32 read_packed_files(ptr<i8> path, ptr<i8> data, i32 interface_offset, i32 interface_size, Options* options, PointerList* diagnostics_list, bool macros_only) {
        LibraryInterface* context = (LibraryInterface*)Memory.zalloc(sizeof(LibraryInterface));
        if (!Library.read_interface(data, interface_offset, interface_size, context)) {
            logger_error(Log.get(), "djinnc: '%s' has an interface this compiler cannot read; build the library again with this djinnc", path);
            return -1;
        }
        PointerList* packed_files = context.files;
        for (mut i32 f = 0; f < packed_files.length; f = f + 1) {
            PackedFile* packed = (PackedFile*)packed_files.get(f);
            ByteBuffer* name = ByteBuffer.create();
            name.append(path);
            name.append("!");
            name.append(packed.path);
            SourceFile* file = Sources.add(name.cstr(), "", (u32)packed.token_count * 4);
            file.is_library_interface = true;
            file.packed = data;
            file.packed_start = packed.start;
            file.packed_end = packed.end;
            file.packed_context = (ptr)context;
            file.macros_only = macros_only;
            diagnostics_list.push((ptr)Diagnostics.create(name.cstr()));
            PointerList* dependencies = options.dependencies;
            dependencies.push((ptr)name.cstr());
        }
        return packed_files.length;
    }

    static void field(ByteBuffer* out, ptr<i8> label, ptr<i8> value, i32 length) {
        out.append("  ");
        out.append(label);
        out.append_slice(value, length);
        out.append_byte(10);
    }

    static void number_field(ByteBuffer* out, ptr<i8> label, i32 value, ptr<i8> suffix) {
        out.append("  ");
        out.append(label);
        out.append_int((i64)value);
        out.append(suffix);
        out.append_byte(10);
    }

    // "stored:" line for a section kept compressed in the file: the bytes it takes there
    static unsafe void stored_note(ByteBuffer* out, ptr<i8> stored, i32 stored_length, i32 compressed_kind) {
        i32 count = (i32)Library.get_u32(stored, 20);
        i32 table = (i32)Library.get_u32(stored, 24);
        for (mut i32 s = 0; s < count; s = s + 1) {
            i32 entry = table + s * Library.ENTRY_SIZE;
            if (entry + Library.ENTRY_SIZE <= stored_length && (i32)Library.get_u32(stored, entry) == compressed_kind) {
                Library.number_field(out, "            stored: ", (i32)Library.get_u64(stored, entry + 16), " bytes (lz4)");
            }
        }
    }

    public static unsafe ByteBuffer* describe(ptr<i8> data, i32 length, ptr<i8> path, bool sections_only, ptr<i8> stored, i32 stored_length) {
        ByteBuffer* out = ByteBuffer.create();
        u32 version = Library.get_u32(data, 8);
        u32 compiler = Library.get_u32(data, 28);
        u32 flags = Library.get_u32(data, 16);
        i32 manifest_offset = 0;
        i32 manifest_size = 0;
        i32 interface_offset = 0;
        i32 interface_size = 0;
        i32 object_offset = 0;
        i32 object_size = 0;
        bool intact = Library.section(data, length, Library.SECTION_MANIFEST, &manifest_offset, &manifest_size)
            && Library.section(data, length, Library.SECTION_INTERFACE, &interface_offset, &interface_size)
            && Library.section(data, length, Library.SECTION_OBJECT, &object_offset, &object_size);
        out.append("DJINNLIB ");
        out.append(path);
        out.append_byte(10);
        if (!intact) {
            out.append("  integrity:  CORRUPTED\n");
            return out;
        }
        i32 name_length = (i32)Library.get_u32(data, manifest_offset);
        i32 triple_at = manifest_offset + 4 + name_length;
        i32 triple_size = (i32)Library.get_u32(data, triple_at);
        Library.field(out, "library:    ", data + manifest_offset + 4, name_length);
        Library.field(out, "target:     ", data + triple_at + 4, triple_size);
        out.append("  format:     v");
        out.append_int((i64)version);
        out.append(", header ");
        out.append_int((i64)Library.get_u32(data, 12));
        out.append(" bytes, written by djinnc ");
        out.append_int((i64)(compiler >> 16));
        out.append_char('.');
        out.append_int((i64)((compiler >> 8) & 255));
        out.append_char('.');
        out.append_int((i64)(compiler & 255));
        out.append_byte(10);
        Library.field(out, "version:    ", data + Library.LABEL_OFFSET, strlen(data + Library.LABEL_OFFSET));
        if (data[Library.BUILD_ID_OFFSET] != 0) {
            Library.field(out, "build id:   ", data + Library.BUILD_ID_OFFSET, strlen(data + Library.BUILD_ID_OFFSET));
        }
        if (Library.get_u64(data, Library.INTERFACE_HASH_OFFSET) != 0) {
            out.append("  interface hash: ");
            out.append_unsigned(Library.get_u64(data, Library.INTERFACE_HASH_OFFSET));
            out.append_byte(10);
        }
        if (Library.get_u64(stored, Library.HEADER_HASH_OFFSET) != 0) {
            mut ptr<i8> state = "ok";
            if (!Library.head_intact(stored, stored_length)) {
                state = "DAMAGED";
            }
            Library.field(out, "header hash: ", state, strlen(state));
        }
        i32 platforms = Library.platforms_of(data, manifest_offset, manifest_size);
        if (platforms != 0) {
            ByteBuffer* names = ByteBuffer.create();
            Target.append_platforms(names, platforms);
            Library.field(out, "targets:    ", names.data, names.length);
        }
        mut ptr<i8> needs_std = "no";
        if ((flags & (u32)Library.FLAG_STD) != 0) {
            needs_std = "yes";
        }
        Library.field(out, "needs std:  ", needs_std, strlen(needs_std));
        i32 links_at = triple_at + 4 + triple_size + 4;
        if (links_at + 4 <= manifest_offset + manifest_size) {
            mut i32 pending = (i32)Library.get_u32(data, links_at);
            mut i32 link_cursor = links_at + 4;
            while (pending > 0 && link_cursor + 4 <= manifest_offset + manifest_size) {
                i32 link_size = (i32)Library.get_u32(data, link_cursor);
                Library.field(out, "links:      ", data + link_cursor + 4, link_size);
                link_cursor = link_cursor + 4 + link_size;
                pending = pending - 1;
            }
        }
        out.append("  integrity:  ok\n");
        Library.number_field(out, "file size:  ", stored_length, " bytes");
        Library.number_field(out, "manifest:   ", manifest_size, " bytes");
        Library.number_field(out, "interface:  ", interface_size, " bytes (declaration tokens, no source text)");
        Library.stored_note(out, stored, stored_length, Library.SECTION_INTERFACE_LZ4);
        Library.number_field(out, "object:     ", object_size, " bytes (compiled code)");
        i32 bitcode_offset = 0;
        i32 bitcode_size = 0;
        if (Library.section(data, length, Library.SECTION_BITCODE, &bitcode_offset, &bitcode_size)) {
            Library.number_field(out, "bitcode:    ", bitcode_size, " bytes (small functions, inlined by consumers)");
            Library.stored_note(out, stored, stored_length, Library.SECTION_BITCODE_LZ4);
        } else {
            out.append("  bitcode:    none
");
        }
        LibraryInterface* context = (LibraryInterface*)Memory.zalloc(sizeof(LibraryInterface));
        if (!Library.read_interface(data, interface_offset, interface_size, context)) {
            out.append("  interface:  UNREADABLE (rebuild the library)
");
            return out;
        }
        Library.number_field(out, "names:      ", context.atom_count, " strings");
        Library.number_field(out, "phrases:    ", context.phrase_count, " repeated qualified names and attributes");
        PointerList* packed_files = context.files;
        Library.number_field(out, "files:      ", packed_files.length, "");
        if (sections_only) {
            return out;
        }
        for (mut i32 f = 0; f < packed_files.length; f = f + 1) {
            PackedFile* packed = (PackedFile*)packed_files.get(f);
            out.append("
// ---- ");
            out.append(packed.path);
            out.append(" ----
");
            ByteBuffer* text = ByteBuffer.create();
            Library.render(text, data, packed, context);
            Library.pretty(out, text.data, text.length);
            out.append_byte(10);
        }
        return out;
    }

    static unsafe void pretty(ByteBuffer* out, ptr<i8> text, i32 length) {
        mut i32 depth = 0;
        mut bool quoted = false;
        for (mut i32 i = 0; i < length; i = i + 1) {
            i32 c = (i32)(u8)text[i];
            if (quoted) {
                out.append_byte(c);
                if (c == 92 && i + 1 < length) {
                    i = i + 1;
                    out.append_byte((i32)(u8)text[i]);
                } else if (c == 34) {
                    quoted = false;
                }
                continue;
            }
            if (c == 34) {
                quoted = true;
                out.append_byte(c);
            } else if (c == 123 && i + 1 < length && text[i + 1] == 125) {
                out.append("{}");
                i = i + 1;
            } else if (c == 32 && (out.length == 0 || out.data[out.length - 1] == 10 || out.data[out.length - 1] == 32)) {
                continue;
            } else if (c == 123) {
                Library.trim_end(out);
                out.append(" {\n");
                depth = depth + 1;
                Library.indent(out, depth);
            } else if (c == 125) {
                depth = depth - 1;
                Library.trim_end(out);
                out.append_byte(10);
                Library.indent(out, depth);
                out.append("}\n");
                Library.indent(out, depth);
            } else if (c == 59) {
                out.append(";\n");
                Library.indent(out, depth);
            } else {
                out.append_byte(c);
            }
        }
    }

    static unsafe void trim_end(ByteBuffer* out) {
        while (out.length > 0 && (out.data[out.length - 1] == 32 || out.data[out.length - 1] == 10)) {
            out.length = out.length - 1;
        }
    }

    static void indent(ByteBuffer* out, i32 depth) {
        for (mut i32 i = 0; i < depth; i = i + 1) {
            out.append("    ");
        }
    }

    public static i32 inspect(ptr<i8> path, ptr<i8> output_path, bool sections_only) {
        i32 length = 0;
        ptr<i8> stored = Files.read_bytes(path, &length);
        if (stored == null || length < Library.HEADER_SIZE || memcmp(stored, "DJINNLIB", 8) != 0) {
            logger_error(Log.get(), "djinnc: '%s' is not a djinn library", path);
            return 1;
        }
        i32 stored_length = length;
        ptr<i8> data = Library.expand(stored, &length, path);
        if (data == null) {
            return 1;
        }
        ByteBuffer* text = Library.describe(data, length, path, sections_only, stored, stored_length);
        if (output_path != null) {
            if (!Files.write_bytes(output_path, text.data, text.length)) {
                return 1;
            }
            return 0;
        }
        printf("%.*s", text.length, text.data);
        return 0;
    }

    public static void cleanup() {
        PointerList* objects = Library.objects();
        for (mut i32 i = 0; i < objects.length; i = i + 1) {
            remove((ptr<i8>)objects.get(i));
        }
    }
}
