namespace djinnc;

unsafe static mut ptr library_bodies = null;
unsafe static mut ptr library_objects = null;
unsafe static mut i32 library_loaded = 0;

struct Library {
    const i32 VERSION = 1;
    const i32 HEADER_SIZE = 128;
    const i32 ENTRY_SIZE = 32;
    const u32 COMPILER_VERSION = 256;
    const i32 LABEL_OFFSET = 32;
    const i32 BUILD_ID_OFFSET = 64;
    const i32 TEXT_FIELD_SIZE = 32;
    const i32 SECTION_MANIFEST = 1;
    const i32 SECTION_INTERFACE = 2;
    const i32 SECTION_OBJECT = 3;
    const i32 FLAG_STD = 1;

    public static bool active() {
        return library_loaded != 0;
    }

    public static unsafe IdList* bodies() {
        if (library_bodies == null) {
            library_bodies = (ptr)IdList.create();
        }
        return (IdList*)library_bodies;
    }

    public static void record_body(i32 open, i32 close) {
        IdList* ranges = Library.bodies();
        ranges.push((u32)open);
        ranges.push((u32)close);
    }

    static unsafe PointerList* objects() {
        if (library_objects == null) {
            library_objects = (ptr)PointerList.create();
        }
        return (PointerList*)library_objects;
    }

    static void put_u32(ByteBuffer* out, u32 value) {
        for (mut i32 i = 0; i < 4; i = i + 1) {
            out.append_char((i32)((value >> (u32)(i * 8)) & 255));
        }
    }

    static void put_u64(ByteBuffer* out, u64 value) {
        for (mut i32 i = 0; i < 8; i = i + 1) {
            out.append_char((i32)((value >> (u64)(i * 8)) & 255));
        }
    }

    static void put_fixed(ByteBuffer* out, ptr<i8> text) {
        mut i32 length = strlen(text);
        if (length > Library.TEXT_FIELD_SIZE - 1) {
            length = Library.TEXT_FIELD_SIZE - 1;
        }
        out.append_slice(text, length);
        for (mut i32 i = length; i < Library.TEXT_FIELD_SIZE; i = i + 1) {
            out.append_char(0);
        }
    }

    static void put_text(ByteBuffer* out, ptr<i8> text, i32 length) {
        Library.put_u32(out, (u32)length);
        out.append_slice(text, length);
    }

    static unsafe u32 get_u32(ptr<i8> data, i32 offset) {
        mut u32 value = 0;
        for (mut i32 i = 3; i >= 0; i = i - 1) {
            value = (value << 8) | (u32)(u8)data[offset + i];
        }
        return value;
    }

    static unsafe u64 get_u64(ptr<i8> data, i32 offset) {
        mut u64 value = 0;
        for (mut i32 i = 7; i >= 0; i = i - 1) {
            value = (value << 8) | (u64)(u8)data[offset + i];
        }
        return value;
    }

    static unsafe u64 checksum(ptr<i8> data, i32 length) {
        mut u64 hash = 14695981039346656037;
        for (mut i32 i = 0; i < length; i = i + 1) {
            hash = (hash ^ (u64)(u8)data[i]) * 1099511628211;
        }
        return hash;
    }

    static unsafe void minify(ByteBuffer* out, ptr<i8> text, i32 length) {
        mut i32 i = 0;
        while (i < length) {
            i32 c = (i32)(u8)text[i];
            if (c == 34 || c == 39) {
                out.append_char(c);
                i = i + 1;
                while (i < length && (i32)(u8)text[i] != c) {
                    if ((i32)(u8)text[i] == 92 && i + 1 < length) {
                        out.append_char(92);
                        i = i + 1;
                    }
                    out.append_char((i32)(u8)text[i]);
                    i = i + 1;
                }
                if (i < length) {
                    out.append_char(c);
                    i = i + 1;
                }
            } else if (c == 47 && i + 1 < length && text[i + 1] == 47) {
                while (i < length && text[i] != 10) {
                    i = i + 1;
                }
            } else if (c == 47 && i + 1 < length && text[i + 1] == 42) {
                i = i + 2;
                while (i + 1 < length && !(text[i] == 42 && text[i + 1] == 47)) {
                    i = i + 1;
                }
                i = i + 2;
            } else if (c == 32 || c == 9 || c == 10 || c == 13) {
                if (out.length > 0 && out.data[out.length - 1] != 32) {
                    out.append_char(32);
                }
                i = i + 1;
            } else {
                out.append_char(c);
                i = i + 1;
            }
        }
    }

    static unsafe void interface_of(ByteBuffer* out, SourceFile* file) {
        TokenList* tokens = TokenList.get();
        IdList* ranges = Library.bodies();
        mut i32 position = 0;
        ByteBuffer* stripped = ByteBuffer.create();
        for (mut i32 r = 0; r + 1 < ranges.length; r = r + 2) {
            i32 open = (i32)ranges.get(r);
            i32 close = (i32)ranges.get(r + 1);
            if (open < file.first_token || open >= file.token_end) {
                continue;
            }
            i32 from = (i32)tokens.start(open);
            i32 to = (i32)tokens.start(close) + 1;
            if (from < position) {
                continue;
            }
            Library.minify(stripped, file.text + position, from - position);
            stripped.append("{}");
            position = to;
        }
        Library.minify(stripped, file.text + position, (i32)file.length - position);
        Library.put_text(out, file.path, strlen(file.path));
        Library.put_text(out, stripped.data, stripped.length);
    }

    static unsafe ptr<i8> base_name(ptr<i8> path) {
        i32 length = strlen(path);
        mut i32 start = 0;
        mut i32 end = length;
        for (mut i32 i = 0; i < length; i = i + 1) {
            if (path[i] == 47 || path[i] == 92) {
                start = i + 1;
            }
        }
        for (mut i32 i = start; i < length; i = i + 1) {
            if (path[i] == 46) {
                end = i;
            }
        }
        return Strings.duplicate(path + start, end - start);
    }

    public static bool write(Options* options, ptr<i8> object_path) {
        i32 object_length = 0;
        ptr<i8> object = Files.read_bytes(object_path, &object_length);
        if (object == null) {
            logger_error(Log.get(), "djinnc: cannot read the object '%s'", object_path);
            return false;
        }

        ByteBuffer* iface = ByteBuffer.create();
        mut u32 file_count = 0;
        PointerList* inputs = options.inputs;
        PointerList* dependencies = options.dependencies;
        for (mut i32 i = 0; i < inputs.length; i = i + 1) {
            SourceFile* file = Sources.get(i);
            if (dependencies.contains_string(file.path)) {
                continue;
            }
            Library.interface_of(iface, file);
            file_count = file_count + 1;
        }

        ByteBuffer* manifest = ByteBuffer.create();
        ptr<i8> name = Library.base_name(options.output);
        Library.put_text(manifest, name, strlen(name));
        Library.put_text(manifest, Target.triple(), strlen(Target.triple()));
        Library.put_u32(manifest, file_count);

        mut u32 flags = 0;
        if (options.use_std) {
            flags = (u32)Library.FLAG_STD;
        }
        i32 section_count = 3;
        i32 table_size = Library.HEADER_SIZE + section_count * Library.ENTRY_SIZE;
        ByteBuffer* out = ByteBuffer.create();
        out.append("DJINNLIB");
        Library.put_u32(out, (u32)Library.VERSION);
        Library.put_u32(out, (u32)Library.HEADER_SIZE);
        Library.put_u32(out, flags);
        Library.put_u32(out, (u32)section_count);
        Library.put_u32(out, (u32)Library.HEADER_SIZE);
        Library.put_u32(out, Library.COMPILER_VERSION);
        Library.put_fixed(out, "0.1.0-dev");
        mut ptr<i8> build_id = getenv("DJINN_BUILD_ID");
        if (build_id == null) {
            build_id = "";
        }
        Library.put_fixed(out, build_id);
        while (out.length < Library.HEADER_SIZE) {
            out.append_char(0);
        }

        mut u64 offset = (u64)table_size;
        for (mut i32 s = 0; s < section_count; s = s + 1) {
            mut ptr<i8> data = manifest.data;
            mut i32 size = manifest.length;
            if (s == 1) {
                data = iface.data;
                size = iface.length;
            } else if (s == 2) {
                data = object;
                size = object_length;
            }
            Library.put_u32(out, (u32)(s + 1));
            Library.put_u32(out, 0);
            Library.put_u64(out, offset);
            Library.put_u64(out, (u64)size);
            Library.put_u64(out, Library.checksum(data, size));
            offset = offset + (u64)size;
        }
        out.append_slice(manifest.data, manifest.length);
        out.append_slice(iface.data, iface.length);
        out.append_slice(object, object_length);
        return Files.write_bytes(options.output, out.data, out.length);
    }

    static unsafe bool section(ptr<i8> data, i32 length, i32 kind, ptr<i32> offset, ptr<i32> size) {
        i32 count = (i32)Library.get_u32(data, 20);
        i32 table = (i32)Library.get_u32(data, 24);
        for (mut i32 s = 0; s < count; s = s + 1) {
            i32 entry = table + s * Library.ENTRY_SIZE;
            if (entry + Library.ENTRY_SIZE > length) {
                return false;
            }
            if ((i32)Library.get_u32(data, entry) != kind) {
                continue;
            }
            u64 start = Library.get_u64(data, entry + 8);
            u64 span = Library.get_u64(data, entry + 16);
            if (start + span > (u64)length) {
                return false;
            }
            offset[0] = (i32)start;
            size[0] = (i32)span;
            return Library.checksum(data + (i32)start, (i32)span) == Library.get_u64(data, entry + 24);
        }
        return false;
    }

    public static unsafe i32 load(Options* options, ptr<i8> path, PointerList* diagnostics_list) {
        i32 length = 0;
        ptr<i8> data = Files.read_bytes(path, &length);
        if (data == null || length < Library.HEADER_SIZE || memcmp(data, "DJINNLIB", 8) != 0) {
            logger_error(Log.get(), "djinnc: '%s' is not a djinn library", path);
            return -1;
        }
        if ((i32)Library.get_u32(data, 8) != Library.VERSION) {
            logger_error(Log.get(), "djinnc: '%s' has an unsupported library version", path);
            return -1;
        }
        i32 interface_offset = 0;
        i32 interface_size = 0;
        i32 object_offset = 0;
        i32 object_size = 0;
        i32 manifest_offset = 0;
        i32 manifest_size = 0;
        bool intact = Library.section(data, length, Library.SECTION_MANIFEST, &manifest_offset, &manifest_size)
            && Library.section(data, length, Library.SECTION_INTERFACE, &interface_offset, &interface_size)
            && Library.section(data, length, Library.SECTION_OBJECT, &object_offset, &object_size);
        if (!intact) {
            logger_error(Log.get(), "djinnc: '%s' is corrupted", path);
            return -1;
        }
        if ((Library.get_u32(data, 16) & (u32)Library.FLAG_STD) != 0 && !options.use_std) {
            logger_error(Log.get(), "djinnc: '%s' was built with --std; compile with --std too", path);
            return -1;
        }

        i32 name_length = (i32)Library.get_u32(data, manifest_offset);
        i32 triple_at = manifest_offset + 4 + name_length;
        i32 triple_size = (i32)Library.get_u32(data, triple_at);
        if (!Strings.equals(data + triple_at + 4, triple_size, Target.triple())) {
            logger_error(Log.get(), "djinnc: '%s' targets a different triple than '%s'", path, Target.triple());
            return -1;
        }

        PointerList* objects = Library.objects();
        ByteBuffer* object_path = ByteBuffer.create();
        object_path.append(options.output);
        object_path.append(".lib");
        object_path.append_int(objects.length);
        object_path.append(".obj");
        if (!Files.write_bytes(object_path.cstr(), data + object_offset, object_size)) {
            logger_error(Log.get(), "djinnc: cannot write '%s'", object_path.cstr());
            return -1;
        }
        objects.push((ptr)object_path.cstr());
        ByteBuffer* link_args = options.link_args;
        link_args.append(" \"");
        link_args.append(object_path.cstr());
        link_args.append("\"");

        library_loaded = 1;
        mut i32 cursor = interface_offset;
        i32 end = interface_offset + interface_size;
        mut i32 added = 0;
        while (cursor < end) {
            i32 path_length = (i32)Library.get_u32(data, cursor);
            ptr<i8> original = Strings.duplicate(data + cursor + 4, path_length);
            cursor = cursor + 4 + path_length;
            i32 text_length = (i32)Library.get_u32(data, cursor);
            ptr<i8> text = Strings.duplicate(data + cursor + 4, text_length);
            cursor = cursor + 4 + text_length;

            ByteBuffer* name = ByteBuffer.create();
            name.append(path);
            name.append("!");
            name.append(original);
            SourceFile* file = Sources.add(name.cstr(), text, (u32)text_length);
            file.is_header = true;
            diagnostics_list.push((ptr)Diagnostics.create(name.cstr()));
            PointerList* dependencies = options.dependencies;
            dependencies.push((ptr)name.cstr());
            added = added + 1;
        }
        return added;
    }

    static void field(ByteBuffer* out, ptr<i8> label, ptr<i8> value, i32 length) {
        out.append("  ");
        out.append(label);
        out.append_slice(value, length);
        out.append_char(10);
    }

    static void number_field(ByteBuffer* out, ptr<i8> label, i32 value, ptr<i8> suffix) {
        out.append("  ");
        out.append(label);
        out.append_int((i64)value);
        out.append(suffix);
        out.append_char(10);
    }

    public static unsafe ByteBuffer* describe(ptr<i8> data, i32 length, ptr<i8> path) {
        ByteBuffer* out = ByteBuffer.create();
        u32 version = Library.get_u32(data, 8);
        u32 compiler = Library.get_u32(data, 28);
        u32 flags = Library.get_u32(data, 16);
        i32 manifest_offset = 0;
        i32 manifest_size = 0;
        i32 interface_offset = 0;
        i32 interface_size = 0;
        i32 object_offset = 0;
        i32 object_size = 0;
        bool intact = Library.section(data, length, Library.SECTION_MANIFEST, &manifest_offset, &manifest_size)
            && Library.section(data, length, Library.SECTION_INTERFACE, &interface_offset, &interface_size)
            && Library.section(data, length, Library.SECTION_OBJECT, &object_offset, &object_size);
        out.append("DJINNLIB ");
        out.append(path);
        out.append_char(10);
        if (!intact) {
            out.append("  integrity:  CORRUPTED\n");
            return out;
        }
        i32 name_length = (i32)Library.get_u32(data, manifest_offset);
        i32 triple_at = manifest_offset + 4 + name_length;
        i32 triple_size = (i32)Library.get_u32(data, triple_at);
        Library.field(out, "library:    ", data + manifest_offset + 4, name_length);
        Library.field(out, "target:     ", data + triple_at + 4, triple_size);
        out.append("  format:     v");
        out.append_int((i64)version);
        out.append(", header ");
        out.append_int((i64)Library.get_u32(data, 12));
        out.append(" bytes, written by djinnc ");
        out.append_int((i64)(compiler >> 16));
        out.append_char(46);
        out.append_int((i64)((compiler >> 8) & 255));
        out.append_char(46);
        out.append_int((i64)(compiler & 255));
        out.append_char(10);
        Library.field(out, "version:    ", data + Library.LABEL_OFFSET, strlen(data + Library.LABEL_OFFSET));
        if (data[Library.BUILD_ID_OFFSET] != 0) {
            Library.field(out, "build id:   ", data + Library.BUILD_ID_OFFSET, strlen(data + Library.BUILD_ID_OFFSET));
        }
        mut ptr<i8> needs_std = "no";
        if ((flags & (u32)Library.FLAG_STD) != 0) {
            needs_std = "yes";
        }
        Library.field(out, "needs std:  ", needs_std, strlen(needs_std));
        out.append("  integrity:  ok\n");
        Library.number_field(out, "file size:  ", length, " bytes");
        Library.number_field(out, "manifest:   ", manifest_size, " bytes");
        Library.number_field(out, "interface:  ", interface_size, " bytes (declarations without bodies)");
        Library.number_field(out, "object:     ", object_size, " bytes (compiled code)");
        mut i32 cursor = interface_offset;
        i32 end = interface_offset + interface_size;
        while (cursor < end) {
            i32 path_length = (i32)Library.get_u32(data, cursor);
            out.append("\n// ---- ");
            out.append_slice(data + cursor + 4, path_length);
            out.append(" ----\n");
            cursor = cursor + 4 + path_length;
            i32 text_length = (i32)Library.get_u32(data, cursor);
            Library.pretty(out, data + cursor + 4, text_length);
            out.append_char(10);
            cursor = cursor + 4 + text_length;
        }
        return out;
    }

    static unsafe void pretty(ByteBuffer* out, ptr<i8> text, i32 length) {
        mut i32 depth = 0;
        mut bool quoted = false;
        for (mut i32 i = 0; i < length; i = i + 1) {
            i32 c = (i32)(u8)text[i];
            if (quoted) {
                out.append_char(c);
                if (c == 92 && i + 1 < length) {
                    i = i + 1;
                    out.append_char((i32)(u8)text[i]);
                } else if (c == 34) {
                    quoted = false;
                }
                continue;
            }
            if (c == 34) {
                quoted = true;
                out.append_char(c);
            } else if (c == 123 && i + 1 < length && text[i + 1] == 125) {
                out.append("{}");
                i = i + 1;
            } else if (c == 32 && (out.length == 0 || out.data[out.length - 1] == 10 || out.data[out.length - 1] == 32)) {
                continue;
            } else if (c == 123) {
                Library.trim_end(out);
                out.append(" {\n");
                depth = depth + 1;
                Library.indent(out, depth);
            } else if (c == 125) {
                depth = depth - 1;
                Library.trim_end(out);
                out.append_char(10);
                Library.indent(out, depth);
                out.append("}\n");
                Library.indent(out, depth);
            } else if (c == 59) {
                out.append(";\n");
                Library.indent(out, depth);
            } else {
                out.append_char(c);
            }
        }
    }

    static unsafe void trim_end(ByteBuffer* out) {
        while (out.length > 0 && (out.data[out.length - 1] == 32 || out.data[out.length - 1] == 10)) {
            out.length = out.length - 1;
        }
    }

    static void indent(ByteBuffer* out, i32 depth) {
        for (mut i32 i = 0; i < depth; i = i + 1) {
            out.append("    ");
        }
    }

    public static i32 inspect(ptr<i8> path, ptr<i8> output_path) {
        i32 length = 0;
        ptr<i8> data = Files.read_bytes(path, &length);
        if (data == null || length < Library.HEADER_SIZE || memcmp(data, "DJINNLIB", 8) != 0) {
            logger_error(Log.get(), "djinnc: '%s' is not a djinn library", path);
            return 1;
        }
        ByteBuffer* text = Library.describe(data, length, path);
        if (output_path != null) {
            if (!Files.write_bytes(output_path, text.data, text.length)) {
                return 1;
            }
            return 0;
        }
        printf("%.*s", text.length, text.data);
        return 0;
    }

    public static void cleanup() {
        PointerList* objects = Library.objects();
        for (mut i32 i = 0; i < objects.length; i = i + 1) {
            remove((ptr<i8>)objects.get(i));
        }
    }
}
