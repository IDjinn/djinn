namespace djinnc;

import testing;

struct JitErrorsTests {
    [Test]
    unsafe void a_short_message_is_kept_as_it_is() {
        ptr<i8> message = "Symbols not found: [ a, b, c ]";
        Expect.equal_text(message, JitErrors.summarize(message));
    }

    [Test]
    unsafe void ten_symbols_are_all_named() {
        ptr<i8> message = "Symbols not found: [ a, b, c, d, e, f, g, h, i, j ]";
        Expect.equal_text(message, JitErrors.summarize(message));
    }

    [Test]
    unsafe void the_eleventh_symbol_and_the_following_are_counted() {
        ptr<i8> message = "Symbols not found: [ a, b, c, d, e, f, g, h, i, j, k, l ]";
        Expect.equal_text("Symbols not found: [ a, b, c, d, e, f, g, h, i, j, ... and 2 more (--verbose) ]", JitErrors.summarize(message));
    }

    [Test]
    unsafe void the_cascade_list_is_one_line() {
        ptr<i8> message = "Failed to materialize symbols: { (main, { main, helper }) }";
        Expect.equal_text("some symbols could not be compiled (--verbose lists them)", JitErrors.summarize(message));
    }

    [Test]
    unsafe void any_other_long_message_is_cut() {
        ByteBuffer* message = ByteBuffer.create();
        for (mut i32 i = 0; i < 700; i = i + 1) {
            message.append("x");
        }
        ptr<i8> shown = JitErrors.summarize(message.cstr());
        Expect.contains(shown, "x... (--verbose shows the rest)");
        Expect.is_true((i32)strlen(shown) < 700);
    }
}
