namespace djinnc;

struct Prelude {
    static void line(ByteBuffer* text, i8* template) {
        i32 length = strlen(template);
        for (mut i32 i = 0; i < length; i = i + 1) {
            i32 c = template[i];
            if (c == 64) {
                text.append_char(123);
            } else if (c == 126) {
                text.append_char(125);
            } else {
                text.append_char(c);
            }
        }
        text.append_char(10);
    }

    public static i8* source() {
        ByteBuffer* text = ByteBuffer.create();
        Prelude.line(text, "struct str @");
        Prelude.line(text, "    i8* data;");
        Prelude.line(text, "    u32 length;");
        Prelude.line(text, "    public bool is_empty() @ return this.length == 0; ~");
        Prelude.line(text, "    public i8* ptr() @ return this.data; ~");
        Prelude.line(text, "~");
        Prelude.line(text, "struct arr<T> @");
        Prelude.line(text, "    T* data;");
        Prelude.line(text, "    u32 length;");
        Prelude.line(text, "    public bool is_empty() @ return this.length == 0; ~");
        Prelude.line(text, "    public T* ptr() @ return this.data; ~");
        Prelude.line(text, "~");
        return text.cstr();
    }
}
