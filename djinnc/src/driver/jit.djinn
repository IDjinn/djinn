namespace djinnc;

struct Jit {
    static unsafe bool check(ptr error, ptr<i8> what) {
        if (error == null) {
            return true;
        }
        ptr<i8> message = LLVMGetErrorMessage(error);
        logger_error(Log.get(), "djinnc: jit: %s: %s", what, message);
        LLVMDisposeErrorMessage(message);
        return false;
    }

    static unsafe bool keeps(ptr value) {
        u64 length = 0;
        ptr<i8> name = LLVMGetValueName2(value, &length);
        if (length >= 5 && name[0] == 108 && name[1] == 108 && name[2] == 118 && name[3] == 109 && name[4] == 46) {
            return true;
        }
        return Strings.same(name, "main")
            || Strings.same(name, "__djinn_jit")
            || Strings.same(name, "__djinn_coro_resume")
            || Strings.same(name, "__djinn_coro_done")
            || Strings.same(name, "__djinn_coro_destroy")
            || Strings.same(name, "__djinn_coro_promise");
    }

    static unsafe void internalize(ptr module) {
        mut ptr function = LLVMGetFirstFunction(module);
        while (function != null) {
            if (LLVMIsDeclaration(function) == 0 && !Jit.keeps(function)) {
                LLVMSetLinkage(function, LlvmConst.LINKAGE_INTERNAL);
            }
            function = LLVMGetNextFunction(function);
        }
        mut ptr global = LLVMGetFirstGlobal(module);
        while (global != null) {
            if (LLVMIsDeclaration(global) == 0 && !Jit.keeps(global)) {
                LLVMSetLinkage(global, LlvmConst.LINKAGE_INTERNAL);
            }
            global = LLVMGetNextGlobal(global);
        }
    }

    public static unsafe i32 run(CodeGenerator* gen, Options* options) {
        if (!Target.is_native()) {
            logger_error(Log.get(), "djinnc: --run needs the host target, but the target is '%s'", Target.triple());
            return 1;
        }
        if (options.runtime_lib == null) {
            logger_error(Log.get(), "djinnc: --run needs --runtime-lib <lib> with the precompiled runtime");
            return 1;
        }
        if (!Target.initialize_backend()) {
            return 1;
        }

        PointerList* objects = Library.resident();
        PointerList* sizes = Library.resident_sizes();
        bool prune = objects.length == 0;
        if (prune) {
            Jit.internalize(gen.module);
        }
        ptr<i8> pipeline = ObjectWriter.pipeline(options.opt_level, prune, true);
        if (!ObjectWriter.run_passes(gen.module, null, pipeline)) {
            return 1;
        }

        __djinn_link_debug_support();
        ptr machine = ObjectWriter.jit_machine(options.opt_level);
        if (machine == null) {
            return 1;
        }
        ptr builder = LLVMOrcCreateLLJITBuilder();
        LLVMOrcLLJITBuilderSetJITTargetMachineBuilder(builder, LLVMOrcJITTargetMachineBuilderCreateFromTargetMachine(machine));
        ptr jit = (ptr)0;
        if (!Jit.check(LLVMOrcCreateLLJIT(&jit, builder), "cannot create the JIT")) {
            return 1;
        }
        ptr dylib = LLVMOrcLLJITGetMainJITDylib(jit);

        ptr runtime = (ptr)0;
        if (!Jit.check(LLVMOrcCreateStaticLibrarySearchGeneratorForPath(&runtime, LLVMOrcLLJITGetObjLinkingLayer(jit), options.runtime_lib), "cannot load the runtime library")) {
            return 1;
        }
        LLVMOrcJITDylibAddGenerator(dylib, runtime);

        if (Linker.is_windows()) {
            ptr crt = (ptr)0;
            if (!Jit.check(LLVMOrcCreateDynamicLibrarySearchGeneratorForPath(&crt, "ucrtbase.dll", LLVMOrcLLJITGetGlobalPrefix(jit), null, null), "cannot load the C runtime")) {
                return 1;
            }
            LLVMOrcJITDylibAddGenerator(dylib, crt);
        }

        ptr process = (ptr)0;
        if (!Jit.check(LLVMOrcCreateDynamicLibrarySearchGeneratorForProcess(&process, LLVMOrcLLJITGetGlobalPrefix(jit), null, null), "cannot expose the process symbols")) {
            return 1;
        }
        LLVMOrcJITDylibAddGenerator(dylib, process);

        if (objects.length > 0 && Linker.is_windows()) {
            u64 target = 0;
            if (!Jit.check(LLVMOrcLLJITLookup(jit, &target, "_write"), "cannot find '_write'")) {
                return 1;
            }
            ptr<u64> pair = (ptr<u64>)Memory.zalloc(24);
            pair[0] = (u64)LLVMOrcLLJITMangleAndIntern(jit, "write");
            pair[1] = target;
            pair[2] = 3;
            if (!Jit.check(LLVMOrcJITDylibDefine(dylib, LLVMOrcAbsoluteSymbols((ptr)pair, 1)), "cannot alias 'write'")) {
                return 1;
            }
        }
        for (mut i32 i = 0; i < objects.length; i = i + 1) {
            ptr buffer = LLVMCreateMemoryBufferWithMemoryRangeCopy((ptr<i8>)objects.get(i), (u64)sizes.get(i), "library");
            if (!Jit.check(LLVMOrcLLJITAddObjectFile(jit, dylib, buffer), "cannot add the library object")) {
                return 1;
            }
        }

        LLVMSetDataLayout(gen.module, LLVMOrcLLJITGetDataLayoutStr(jit));
        if (Linker.is_windows()) {
            ptr legacy_write = LLVMGetNamedFunction(gen.module, "write");
            if (legacy_write != null) {
                LLVMSetValueName2(legacy_write, "_write", 6);
            }
        }
        gen.release_builders();
        gen.module_taken = 1;
        ptr shared_context = LLVMOrcCreateNewThreadSafeContextFromLLVMContext(gen.context);
        ptr shared_module = LLVMOrcCreateNewThreadSafeModule(gen.module, shared_context);
        LLVMOrcDisposeThreadSafeContext(shared_context);
        if (!Jit.check(LLVMOrcLLJITAddLLVMIRModule(jit, dylib, shared_module), "cannot add the module")) {
            return 1;
        }

        u64 entry = 0;
        if (!Jit.check(LLVMOrcLLJITLookup(jit, &entry, "main"), "cannot find 'main'")) {
            return 1;
        }
        u64 jit_address = 0;
        if (!Jit.check(LLVMOrcLLJITLookup(jit, &jit_address, "__djinn_jit"), "cannot find '__djinn_jit'")) {
            return 1;
        }
        ptr<i32> jit_flag = (ptr<i32>)(ptr)jit_address;
        jit_flag[0] = 1;
        logger_info(Log.get(), "djinnc: running 'main' in process");
        fflush(null);
        return __djinn_call_entry((ptr)entry);
    }
}
