namespace djinnc;

struct ScaffoldCommand {
    static unsafe bool is_command(ptr<i8> word) {
        return Strings.same(word, "new") || Strings.same(word, "init") || Strings.same(word, "doctor");
    }

    // 'new', 'init' and 'doctor' are interactive (std spectre), so they live in djinn-scaffold next to djinnc.
    public static unsafe i32 dispatch() {
        ptr<i8> first = Process.argv_or(1, "");
        if (!ScaffoldCommand.is_command(first) || __djinn_path_exists(first) != 0) {
            return -1;
        }
        ptr<i8> directory = __djinn_executable_dir();
        ByteBuffer* tool = ByteBuffer.create();
        if (directory != null) {
            tool.append(directory);
            tool.append("/");
        }
        tool.append("djinn-scaffold");
        if (Linker.is_windows()) {
            tool.append(".exe");
        }
        if (__djinn_path_exists(tool.cstr()) == 0) {
            logger_error(Log.get(), "djinnc: 'djinnc %s' needs djinn-scaffold next to djinnc (not found at '%s'); reinstall Djinn", first, tool.cstr());
            return 1;
        }
        ByteBuffer* command = ByteBuffer.create();
        if (Linker.is_windows()) {
            command.append("\"");
        }
        command.append("\"");
        command.append(tool.cstr());
        command.append("\"");
        i32 count = Process.argc();
        for (mut i32 i = 1; i < count; i = i + 1) {
            command.append(" \"");
            command.append(Process.argv_or(i, ""));
            command.append("\"");
        }
        if (Linker.is_windows()) {
            command.append("\"");
        }
        return Process.run(command.cstr());
    }
}
