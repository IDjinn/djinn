namespace djinnc;

struct Options {
    ptr<i8> input;
    PointerList* inputs;
    ptr<i8> output;
    ptr<i8> runtime_dir;
    ptr<i8> runtime_lib;
    bool runtime_dir_set;
    ptr<i8> target;
    ptr<i8> std_dir;
    bool use_std;
    ByteBuffer* link_args;
    bool keep_ir;
    bool use_lld;
    bool windowed;
    PointerList* system_libs;
    PointerList* declared_links;
    // platforms the project supports (bits of Target.platform_mask); 0 = any
    i32 target_mask;
    PointerList* linked;
    bool optimize;
    bool no_range_opt;
    bool no_async_elision;
    bool strict_externs;
    i64 async_threads;
    // static-cache: in djinn.proj, seconds a browser may keep the files a server names by their content (Build.StaticCache)
    i64 static_cache;
    bool static_cache_set;
    bool async_threads_set;
    bool async_threads_forced;
    bool verify_ranges;
    ptr<i8> opt_level;
    ptr<i8> cpu;
    ptr<i8> features;
    // set by the command line: it wins over 'optimization:', 'cpu:', 'features:' and 'range-opt:' in djinn.proj
    bool opt_level_set;
    bool cpu_set;
    bool features_set;
    bool range_opt_set;
    // hardening level (HardenLevel): 0 means the default (standard); --harden=<level> or 'harden:' in djinn.proj
    i32 harden;
    bool harden_set;
    // drop the code and data nothing refers to at link time (--gc-sections, 'gc-sections: true'); off by default because
    // djinnc itself links the runtime and std for its JIT
    bool gc_sections;
    bool gc_sections_set;
    // sanitizers (--sanitize=address,undefined,thread or 'sanitize:' in djinn.proj), a mask of Sanitizer
    i32 sanitize;
    bool sanitize_set;
    bool debug;
    bool emit_tokens;
    bool emit_ast;
    bool emit_ir;
    bool emit_asm;
    bool show_async;
    i32 reflect_mode;
    bool no_generate;
    bool library;
    bool library_view;
    ptr<i8> inspect_path;
    bool sections_only;
    bool no_compress;
    PointerList* libraries;
    ptr<i8> library_dir;
    PointerList* dependencies;
    bool show_version;
    bool show_help;
    bool interactive;
    bool stats;
    bool no_link;
    bool run;
    bool tiered;
    i64 tier_threshold;
    i64 tier_settle;
    bool check_only;
    bool diagnostics_json;
    bool output_set;
    bool include_tests;
    ptr<i8> entry_file;
    bool test_command;
    bool watch;
    i32 watch_runs;
    ByteBuffer* program_args;
    FloatSettings* float_settings;
    bool float_standard_set;
    bool float_environment_set;
    bool ok;

    // An installed djinnc lives in <root>/bin next to <root>/runtime, <root>/std and <root>/lib. Anything not given on
    // the command line is taken from there, unless the current directory already has its own runtime (repo checkout).
    static unsafe ptr<i8> install_path(ptr<i8> root, ptr<i8> suffix) {
        ByteBuffer* path = ByteBuffer.create();
        path.append(root);
        path.append(suffix);
        return path.cstr();
    }

    static unsafe void apply_install_layout(Options* options) {
        ptr<i8> executable_dir = __djinn_executable_dir();
        if (executable_dir == null) {
            return;
        }
        ptr<i8> root = Options.install_path(executable_dir, "/..");
        if (!options.runtime_dir_set && __djinn_path_exists("runtime/core") == 0) {
            if (__djinn_path_exists(Options.install_path(root, "/runtime/core")) != 0) {
                options.runtime_dir = Options.install_path(root, "/runtime");
            }
        }
        if (options.std_dir == null && getenv("DJINN_STD_DIR") == null) {
            if (__djinn_path_exists(Options.install_path(root, "/std")) != 0 && __djinn_path_exists(Options.install_path(options.runtime_dir, "/../std")) == 0) {
                options.std_dir = Options.install_path(root, "/std");
            }
        }
        if (options.runtime_lib == null) {
            ptr<i8> unix_lib = Options.install_path(root, "/lib/libdjinn_runtime.a");
            ptr<i8> windows_lib = Options.install_path(root, "/lib/djinn_runtime.lib");
            if (__djinn_path_exists(unix_lib) != 0) {
                options.runtime_lib = unix_lib;
            } else if (__djinn_path_exists(windows_lib) != 0) {
                options.runtime_lib = windows_lib;
            }
        }
    }

    public static unsafe Options* parse() {
        Options* options = (Options*)Memory.zalloc(sizeof(Options));
        options.output = "a.out";
        options.runtime_dir = "runtime";
        options.opt_level = "O0";
        options.tier_threshold = 1000;
        options.tier_settle = 100;
        options.ok = true;
        options.inputs = PointerList.create();
        options.dependencies = PointerList.create();
        options.libraries = PointerList.create();
        options.library_dir = "build/libs";
        options.link_args = ByteBuffer.create();
        options.system_libs = PointerList.create();
        options.declared_links = PointerList.create();
        options.linked = PointerList.create();
        options.program_args = ByteBuffer.create();
        options.float_settings = FloatSettings.create();

        i32 count = Process.argc();
        mut i32 i = 1;
        if (Strings.same(Process.argv_or(1, ""), "test")) {
            options.test_command = true;
            options.include_tests = true;
            options.reflect_mode = ReflectionMode.ALL;
            i = 2;
        }
        ptr<i8> first = Process.argv_or(1, "");
        if (Strings.same(first, "interactive") || Strings.same(first, "-i") || Strings.same(first, "--interactive")) {
            options.interactive = true;
            return options;
        }
        while (i < count) {
            ptr<i8> argument = Process.argv_or(i, "");
            if (Strings.same(argument, "--help") || Strings.same(argument, "-h") || Strings.same(argument, "help")) {
                options.show_help = true;
                return options;
            } else if (Strings.same(argument, "--")) {
                for (mut i32 rest = i + 1; rest < count; rest = rest + 1) {
                    options.program_args.append(" \"");
                    options.program_args.append(Process.argv_or(rest, ""));
                    options.program_args.append("\"");
                }
                break;
            } else if (Strings.same(argument, "--tests")) {
                options.include_tests = true;
            } else if (Strings.same(argument, "--watch")) {
                options.watch = true;
            } else if (Strings.same(argument, "--watch-runs")) {
                i = i + 1;
                ptr<i8> runs = Process.argv_or(i, "0");
                options.watch_runs = (i32)Strings.parse_integer(runs, (i32)strlen(runs));
            } else if (Strings.same(argument, "--emit-tokens")) {
                options.emit_tokens = true;
            } else if (Strings.same(argument, "--emit-ast")) {
                options.emit_ast = true;
            } else if (Strings.same(argument, "--emit-ir")) {
                options.emit_ir = true;
            } else if (Strings.same(argument, "--version")) {
                options.show_version = true;
                return options;
            } else if (Strings.same(argument, "--reflect-all")) {
                options.reflect_mode = ReflectionMode.ALL;
            } else if (Strings.same(argument, "--reflect-none")) {
                options.reflect_mode = ReflectionMode.NONE;
            } else if (Strings.same(argument, "--reflect-annotated")) {
                options.reflect_mode = ReflectionMode.ANNOTATED;
            } else if (Strings.same(argument, "--no-generate")) {
                options.no_generate = true;
            } else if (Strings.same(argument, "--show-async")) {
                options.show_async = true;
            } else if (Strings.same(argument, "--emit-asm")) {
                options.emit_asm = true;
            } else if (Strings.same(argument, "--keep-ir")) {
                options.keep_ir = true;
            } else if (Strings.same(argument, "--lld")) {
                options.use_lld = true;
            } else if ((Strings.starts_with(argument, 0, strlen(argument), "-l") || Strings.starts_with(argument, 0, strlen(argument), "-L")) && strlen(argument) > 2) {
                PointerList* system_libs = options.system_libs;
                system_libs.push((ptr)argument);
            } else if (Strings.same(argument, "--windowed")) {
                options.windowed = true;
            } else if (Strings.same(argument, "-g")) {
                options.debug = true;
            } else if (Strings.same(argument, "-O0") || Strings.same(argument, "-O1") || Strings.same(argument, "-O2")
                || Strings.same(argument, "-O3") || Strings.same(argument, "-Os") || Strings.same(argument, "-Oz")) {
                options.opt_level = argument + 1;
                options.optimize = !Strings.same(argument, "-O0");
                options.opt_level_set = true;
            } else if (Strings.starts_with(argument, 0, strlen(argument), "--harden=")) {
                options.harden = Linker.parse_harden(argument + 9);
                options.harden_set = true;
                if (options.harden == 0) {
                    logger_error(Log.get(), "djinnc: unknown hardening level '%s' (expected off, basic, standard, strict or on)", argument + 9);
                    options.ok = false;
                    return options;
                }
            } else if (Strings.starts_with(argument, 0, strlen(argument), "--sanitize=")) {
                options.sanitize = Linker.parse_sanitize(argument + 11);
                options.sanitize_set = true;
                if (options.sanitize < 0) {
                    options.ok = false;
                    return options;
                }
            } else if (Strings.same(argument, "--gc-sections") || Strings.same(argument, "--no-gc-sections")) {
                options.gc_sections = Strings.same(argument, "--gc-sections");
                options.gc_sections_set = true;
            } else if (Strings.same(argument, "--verify-ranges")) {
                options.verify_ranges = true;
            } else if (Strings.same(argument, "--no-range-opt")) {
                options.no_range_opt = true;
                options.range_opt_set = true;
            } else if (Strings.same(argument, "--strict-externs")) {
                options.strict_externs = true;
            } else if (Strings.same(argument, "--no-async-elision")) {
                options.no_async_elision = true;
            } else if (Strings.starts_with(argument, 0, strlen(argument), "--async-threads=")) {
                options.async_threads = Strings.parse_integer(argument + 16, (i32)strlen(argument + 16));
                options.async_threads_set = true;
                options.async_threads_forced = true;
            } else if (Strings.same(argument, "--stats")) {
                options.stats = true;
            } else if (Strings.same(argument, "--std")) {
                options.use_std = true;
            } else if (Strings.same(argument, "--no-compress")) {
                options.no_compress = true;
            } else if (Strings.same(argument, "--sections-only")) {
                options.sections_only = true;
            } else if (Strings.same(argument, "--emit-lib-view")) {
                options.library_view = true;
            } else if (Strings.same(argument, "--library")) {
                options.library = true;
            } else if (Strings.same(argument, "--check")) {
                options.check_only = true;
            } else if (Strings.same(argument, "--diagnostics-format=json")) {
                options.diagnostics_json = true;
            } else if (Strings.same(argument, "--diagnostics-format=text")) {
                options.diagnostics_json = false;
            } else if (Strings.starts_with(argument, 0, strlen(argument), "--ieee754=")) {
                FloatSettings* standard_settings = options.float_settings;
                options.float_standard_set = true;
                if (!standard_settings.set_standard(argument + 10)) {
                    options.ok = false;
                    return options;
                }
            } else if (Strings.starts_with(argument, 0, strlen(argument), "--fp-env=")) {
                FloatSettings* environment_settings = options.float_settings;
                options.float_environment_set = true;
                if (!environment_settings.set_environment(argument + 9)) {
                    options.ok = false;
                    return options;
                }
            } else if (Strings.same(argument, "--run")) {
                options.run = true;
            } else if (Strings.same(argument, "--tiered")) {
                options.tiered = true;
            } else if (Strings.starts_with(argument, 0, strlen(argument), "--tier-settle=")) {
                options.tier_settle = Strings.parse_integer(argument + 14, (i32)strlen(argument + 14));
            } else if (Strings.starts_with(argument, 0, strlen(argument), "--tier-threshold=")) {
                options.tier_threshold = Strings.parse_integer(argument + 17, (i32)strlen(argument + 17));
            } else if (Strings.same(argument, "--no-link")) {
                options.no_link = true;
            } else if (Strings.same(argument, "-o") || Strings.same(argument, "--runtime-dir") || Strings.same(argument, "--runtime-lib") || Strings.same(argument, "--link-arg") || Strings.same(argument, "--target") || Strings.same(argument, "--std-dir") || Strings.same(argument, "--lib") || Strings.same(argument, "--lib-dir") || Strings.same(argument, "--cpu") || Strings.same(argument, "--features") || Strings.same(argument, "--inspect-lib")) {
                i = i + 1;
                if (i >= count) {
                    logger_error(Log.get(), "djinnc: missing value for %s", argument);
                    options.ok = false;
                    return options;
                }
                ptr<i8> value = Process.argv_or(i, "");
                if (Strings.same(argument, "-o")) {
                    options.output = value;
                    options.output_set = true;
                } else if (Strings.same(argument, "--link-arg")) {
                    ByteBuffer* link_args = options.link_args;
                    link_args.append(" \"");
                    link_args.append(value);
                    link_args.append("\"");
                } else if (Strings.same(argument, "--inspect-lib")) {
                    options.inspect_path = value;
                } else if (Strings.same(argument, "--cpu")) {
                    options.cpu = value;
                    options.cpu_set = true;
                } else if (Strings.same(argument, "--features")) {
                    options.features = value;
                    options.features_set = true;
                } else if (Strings.same(argument, "--lib-dir")) {
                    options.library_dir = value;
                } else if (Strings.same(argument, "--lib")) {
                    PointerList* libraries = options.libraries;
                    libraries.push((ptr)value);
                } else if (Strings.same(argument, "--std-dir")) {
                    options.std_dir = value;
                    options.use_std = true;
                } else if (Strings.same(argument, "--target")) {
                    options.target = value;
                } else if (Strings.same(argument, "--runtime-lib")) {
                    options.runtime_lib = value;
                } else {
                    options.runtime_dir = value;
                    options.runtime_dir_set = true;
                }
            } else if (Strings.starts_with(argument, 0, strlen(argument), "-")) {
                logger_error(Log.get(), "djinnc: unknown option '%s'", argument);
                options.ok = false;
                return options;
            } else {
                options.input = argument;
                PointerList* inputs = options.inputs;
                inputs.push((ptr)argument);
            }
            i = i + 1;
        }

        PointerList* positional = options.inputs;
        if (positional.length == 1 && !Project.is_source_file(options.input)) {
            ptr<i8> directory = options.input;
            positional.truncate(0);
            options.input = null;
            if (!Project.apply(options, directory)) {
                options.ok = false;
                return options;
            }
            if (options.test_command) {
                options.library = false;
            }
        }

        Options.apply_install_layout(options);
        PointerList* system_libs = options.system_libs;
        for (mut i32 k = 0; k < system_libs.length; k = k + 1) {
            ByteBuffer* link_args = options.link_args;
            Linker.append_link_arg(options, link_args, (ptr<i8>)system_libs.get(k));
            PointerList* declared = options.declared_links;
            declared.push(system_libs.get(k));
            PointerList* linked = options.linked;
            linked.push(system_libs.get(k));
        }

        FloatSettings* float_settings = options.float_settings;
        if (!float_settings.validate()) {
            options.ok = false;
            return options;
        }

        if (Strings.same(Target.normalize(options.target), "js-unknown-web") && !WebLibraries.apply(options)) {
            options.ok = false;
            return options;
        }

        if (options.use_std && !StdLibrary.add(options)) {
            options.ok = false;
            return options;
        }

        if (options.input == null && options.inspect_path == null) {
            options.ok = false;
        }
        return options;
    }

    public static void usage() {
        Help.short_usage();
    }
}
