namespace djinnc;

struct Options {
    ptr<i8> input;
    PointerList* inputs;
    ptr<i8> output;
    ptr<i8> runtime_dir;
    ptr<i8> runtime_lib;
    ptr<i8> target;
    ptr<i8> std_dir;
    bool use_std;
    ByteBuffer* link_args;
    bool keep_ir;
    bool use_lld;
    bool optimize;
    ptr<i8> opt_level;
    ptr<i8> cpu;
    ptr<i8> features;
    bool debug;
    bool emit_tokens;
    bool emit_ast;
    bool emit_ir;
    bool emit_asm;
    bool show_async;
    i32 reflect_mode;
    bool no_generate;
    bool library;
    bool library_view;
    ptr<i8> inspect_path;
    PointerList* libraries;
    ptr<i8> library_dir;
    PointerList* dependencies;
    bool show_version;
    bool stats;
    bool no_link;
    bool run;
    bool tiered;
    i64 tier_threshold;
    i64 tier_settle;
    bool check_only;
    bool diagnostics_json;
    bool output_set;
    bool include_tests;
    ptr<i8> entry_file;
    bool test_command;
    bool watch;
    i32 watch_runs;
    ByteBuffer* program_args;
    FloatSettings* float_settings;
    bool float_standard_set;
    bool float_environment_set;
    bool ok;

    public static unsafe Options* parse() {
        Options* options = (Options*)Memory.zalloc(sizeof(Options));
        options.output = "a.out";
        options.runtime_dir = "runtime";
        options.opt_level = "O0";
        options.tier_threshold = 1000;
        options.tier_settle = 100;
        options.ok = true;
        options.inputs = PointerList.create();
        options.dependencies = PointerList.create();
        options.libraries = PointerList.create();
        options.library_dir = "build/libs";
        options.link_args = ByteBuffer.create();
        options.program_args = ByteBuffer.create();
        options.float_settings = FloatSettings.create();

        i32 count = Process.argc();
        mut i32 i = 1;
        if (Strings.same(Process.argv_or(1, ""), "test")) {
            options.test_command = true;
            options.include_tests = true;
            options.reflect_mode = ReflectionMode.ALL;
            i = 2;
        }
        while (i < count) {
            ptr<i8> argument = Process.argv_or(i, "");
            if (Strings.same(argument, "--")) {
                for (mut i32 rest = i + 1; rest < count; rest = rest + 1) {
                    options.program_args.append(" \"");
                    options.program_args.append(Process.argv_or(rest, ""));
                    options.program_args.append("\"");
                }
                break;
            } else if (Strings.same(argument, "--tests")) {
                options.include_tests = true;
            } else if (Strings.same(argument, "--watch")) {
                options.watch = true;
            } else if (Strings.same(argument, "--watch-runs")) {
                i = i + 1;
                ptr<i8> runs = Process.argv_or(i, "0");
                options.watch_runs = (i32)Strings.parse_integer(runs, (i32)strlen(runs));
            } else if (Strings.same(argument, "--emit-tokens")) {
                options.emit_tokens = true;
            } else if (Strings.same(argument, "--emit-ast")) {
                options.emit_ast = true;
            } else if (Strings.same(argument, "--emit-ir")) {
                options.emit_ir = true;
            } else if (Strings.same(argument, "--version")) {
                options.show_version = true;
                return options;
            } else if (Strings.same(argument, "--reflect-all")) {
                options.reflect_mode = ReflectionMode.ALL;
            } else if (Strings.same(argument, "--reflect-none")) {
                options.reflect_mode = ReflectionMode.NONE;
            } else if (Strings.same(argument, "--reflect-annotated")) {
                options.reflect_mode = ReflectionMode.ANNOTATED;
            } else if (Strings.same(argument, "--no-generate")) {
                options.no_generate = true;
            } else if (Strings.same(argument, "--show-async")) {
                options.show_async = true;
            } else if (Strings.same(argument, "--emit-asm")) {
                options.emit_asm = true;
            } else if (Strings.same(argument, "--keep-ir")) {
                options.keep_ir = true;
            } else if (Strings.same(argument, "--lld")) {
                options.use_lld = true;
            } else if (Strings.same(argument, "-g")) {
                options.debug = true;
            } else if (Strings.same(argument, "-O0") || Strings.same(argument, "-O1") || Strings.same(argument, "-O2")
                || Strings.same(argument, "-O3") || Strings.same(argument, "-Os") || Strings.same(argument, "-Oz")) {
                options.opt_level = argument + 1;
                options.optimize = !Strings.same(argument, "-O0");
            } else if (Strings.same(argument, "--stats")) {
                options.stats = true;
            } else if (Strings.same(argument, "--std")) {
                options.use_std = true;
            } else if (Strings.same(argument, "--emit-lib-view")) {
                options.library_view = true;
            } else if (Strings.same(argument, "--library")) {
                options.library = true;
            } else if (Strings.same(argument, "--check")) {
                options.check_only = true;
            } else if (Strings.same(argument, "--diagnostics-format=json")) {
                options.diagnostics_json = true;
            } else if (Strings.same(argument, "--diagnostics-format=text")) {
                options.diagnostics_json = false;
            } else if (Strings.starts_with(argument, 0, strlen(argument), "--ieee754=")) {
                FloatSettings* standard_settings = options.float_settings;
                options.float_standard_set = true;
                if (!standard_settings.set_standard(argument + 10)) {
                    options.ok = false;
                    return options;
                }
            } else if (Strings.starts_with(argument, 0, strlen(argument), "--fp-env=")) {
                FloatSettings* environment_settings = options.float_settings;
                options.float_environment_set = true;
                if (!environment_settings.set_environment(argument + 9)) {
                    options.ok = false;
                    return options;
                }
            } else if (Strings.same(argument, "--run")) {
                options.run = true;
            } else if (Strings.same(argument, "--tiered")) {
                options.tiered = true;
            } else if (Strings.starts_with(argument, 0, strlen(argument), "--tier-settle=")) {
                options.tier_settle = Strings.parse_integer(argument + 14, (i32)strlen(argument + 14));
            } else if (Strings.starts_with(argument, 0, strlen(argument), "--tier-threshold=")) {
                options.tier_threshold = Strings.parse_integer(argument + 17, (i32)strlen(argument + 17));
            } else if (Strings.same(argument, "--no-link")) {
                options.no_link = true;
            } else if (Strings.same(argument, "-o") || Strings.same(argument, "--runtime-dir") || Strings.same(argument, "--runtime-lib") || Strings.same(argument, "--link-arg") || Strings.same(argument, "--target") || Strings.same(argument, "--std-dir") || Strings.same(argument, "--lib") || Strings.same(argument, "--lib-dir") || Strings.same(argument, "--cpu") || Strings.same(argument, "--features") || Strings.same(argument, "--inspect-lib")) {
                i = i + 1;
                if (i >= count) {
                    logger_error(Log.get(), "djinnc: missing value for %s", argument);
                    options.ok = false;
                    return options;
                }
                ptr<i8> value = Process.argv_or(i, "");
                if (Strings.same(argument, "-o")) {
                    options.output = value;
                    options.output_set = true;
                } else if (Strings.same(argument, "--link-arg")) {
                    ByteBuffer* link_args = options.link_args;
                    link_args.append(" \"");
                    link_args.append(value);
                    link_args.append("\"");
                } else if (Strings.same(argument, "--inspect-lib")) {
                    options.inspect_path = value;
                } else if (Strings.same(argument, "--cpu")) {
                    options.cpu = value;
                } else if (Strings.same(argument, "--features")) {
                    options.features = value;
                } else if (Strings.same(argument, "--lib-dir")) {
                    options.library_dir = value;
                } else if (Strings.same(argument, "--lib")) {
                    PointerList* libraries = options.libraries;
                    libraries.push((ptr)value);
                } else if (Strings.same(argument, "--std-dir")) {
                    options.std_dir = value;
                    options.use_std = true;
                } else if (Strings.same(argument, "--target")) {
                    options.target = value;
                } else if (Strings.same(argument, "--runtime-lib")) {
                    options.runtime_lib = value;
                } else {
                    options.runtime_dir = value;
                }
            } else if (Strings.starts_with(argument, 0, strlen(argument), "-")) {
                logger_error(Log.get(), "djinnc: unknown option '%s'", argument);
                options.ok = false;
                return options;
            } else {
                options.input = argument;
                PointerList* inputs = options.inputs;
                inputs.push((ptr)argument);
            }
            i = i + 1;
        }

        PointerList* positional = options.inputs;
        if (positional.length == 1 && !Project.is_source_file(options.input)) {
            ptr<i8> directory = options.input;
            positional.truncate(0);
            options.input = null;
            if (!Project.apply(options, directory)) {
                options.ok = false;
                return options;
            }
            if (options.test_command) {
                options.library = false;
            }
        }

        FloatSettings* float_settings = options.float_settings;
        if (!float_settings.validate()) {
            options.ok = false;
            return options;
        }

        if (options.use_std && !StdLibrary.add(options)) {
            options.ok = false;
            return options;
        }

        if (options.input == null && options.inspect_path == null) {
            options.ok = false;
        }
        return options;
    }

    public static void usage() {
        logger_error(Log.get(), "usage: djinnc <input.djinn>...|<project dir> [-o <output>] [--runtime-dir <dir>] [--runtime-lib <lib>] [--link-arg <arg>]... [--target <triple>] [--std] [--std-dir <dir>] [--no-link] [--run] [--check] [--diagnostics-format=text|json]");
        logger_error(Log.get(), "              [--emit-tokens] [--emit-ast] [--emit-ir] [--emit-asm] [--library] [--emit-lib-view] [--cpu <name|native>] [--features <+feat,-feat>] [--inspect-lib <file.djlib>] [--lib <file.djlib>]... [--lib-dir <dir>] [--show-async] [--reflect-all|--reflect-annotated|--reflect-none] [--keep-ir] [--lld] [--run [--tiered] [--tier-threshold=<hits>] [--tier-settle=<ms>]] [-g] [-O0|-O1|-O2|-O3|-Os|-Oz] [--ieee754=2019|2008|1985|none] [--fp-env=default|strict] [--stats] [--tests] [--version]\n");
        logger_error(Log.get(), "environment: DJINN_CLANG overrides the clang executable, DJINN_LLD_LINK the lld-link executable (Windows),");
        logger_error(Log.get(), "             DJINN_LD_LLD, DJINN_CRT_DIR and DJINN_DYNAMIC_LINKER configure --lld on POSIX");
    }
}
