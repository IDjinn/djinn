namespace djinnc;

// The hardening levels of --harden and 'harden:' in djinn.proj (0 is "not set", which means STANDARD).
struct HardenLevel {
    const i32 OFF = 1;
    const i32 BASIC = 2;
    const i32 STANDARD = 3;
    const i32 STRICT = 4;
}

// The sanitizers of --sanitize (a mask).
struct Sanitizer {
    const i32 ADDRESS = 1;
    const i32 UNDEFINED = 2;
    const i32 THREAD = 4;
}

struct Linker {
    // "address,undefined" -> a mask of Sanitizer; "off" and "" are 0; -1 when a name is unknown or the set cannot be
    // combined (address and thread both instrument memory accesses). Reports the error.
    public static unsafe i32 parse_sanitize(ptr<i8> text) {
        mut i32 mask = 0;
        mut i32 start = 0;
        i32 length = strlen(text);
        for (mut i32 i = 0; i <= length; i = i + 1) {
            if (i == length || text[i] == 44) {
                ptr<i8> name = Strings.duplicate(text + start, i - start);
                if (Strings.same(name, "address")) {
                    mask = mask | Sanitizer.ADDRESS;
                } else if (Strings.same(name, "undefined")) {
                    mask = mask | Sanitizer.UNDEFINED;
                } else if (Strings.same(name, "thread")) {
                    mask = mask | Sanitizer.THREAD;
                } else if (!Strings.same(name, "off") && !Strings.same(name, "")) {
                    logger_error(Log.get(), "djinnc: unknown sanitizer '%s' (expected address, undefined, thread or off)", name);
                    return 0 - 1;
                }
                start = i + 1;
            }
        }
        if ((mask & Sanitizer.ADDRESS) != 0 && (mask & Sanitizer.THREAD) != 0) {
            logger_error(Log.get(), "djinnc: the address and thread sanitizers cannot be used together");
            return 0 - 1;
        }
        return mask;
    }

    // The AddressSanitizer of Windows is dynamic (clang_rt.asan_dynamic-x86_64.dll in the clang resource directory): its
    // import library and thunk are linked explicitly and the DLL is copied next to the program.
    static unsafe bool append_windows_address_sanitizer(ByteBuffer* command, ptr<i8> clang, ptr<i8> output) {
        ByteBuffer* query = ByteBuffer.create();
        query.append("\"\"");
        query.append(clang);
        query.append("\" -print-resource-dir > \"");
        query.append(output);
        query.append(".resource-dir\"\"");
        ByteBuffer* file = ByteBuffer.create();
        file.append(output);
        file.append(".resource-dir");
        if (Process.run(query.cstr()) != 0) {
            logger_error(Log.get(), "djinnc: cannot ask '%s' for its resource directory", clang);
            return false;
        }
        ptr<i8> text = Files.read_all(file.cstr());
        remove(file.cstr());
        if (text == null || strlen(text) == 0) {
            logger_error(Log.get(), "djinnc: cannot read the resource directory of '%s'", clang);
            return false;
        }
        mut i32 length = strlen(text);
        while (length > 0 && (text[length - 1] == 10 || text[length - 1] == 13)) {
            length = length - 1;
        }
        ptr<i8> directory = Strings.duplicate(text, length);
        command.append(" -Wl,/include:__asan_seh_interceptor \"");
        command.append(directory);
        command.append("/lib/windows/clang_rt.asan_dynamic-x86_64.lib\" \"-Wl,/wholearchive:");
        command.append(directory);
        command.append("/lib/windows/clang_rt.asan_dynamic_runtime_thunk-x86_64.lib\"");
        ByteBuffer* source = ByteBuffer.create();
        source.append(directory);
        source.append("/lib/windows/clang_rt.asan_dynamic-x86_64.dll");
        mut i32 slash = strlen(output);
        while (slash > 0 && output[slash - 1] != 47 && output[slash - 1] != 92) {
            slash = slash - 1;
        }
        ByteBuffer* target = ByteBuffer.create();
        if (slash == 0) {
            target.append("./");
        }
        target.append_slice(output, slash);
        ptr<i8> from = source.cstr();
        ptr<i8> to = target.cstr();
        for (mut i32 i = 0; i < strlen(from); i = i + 1) {
            if (from[i] == 47) {
                from[i] = 92;
            }
        }
        for (mut i32 i = 0; i < strlen(to); i = i + 1) {
            if (to[i] == 47) {
                to[i] = 92;
            }
        }
        ByteBuffer* copy = ByteBuffer.create();
        copy.append("copy /Y \"");
        copy.append(from);
        copy.append("\" \"");
        copy.append(to);
        copy.append("\" > nul");
        Process.run(copy.cstr());
        return true;
    }

    // The -fsanitize= list for a mask.
    public static unsafe ptr<i8> sanitize_list(i32 mask) {
        ByteBuffer* list = ByteBuffer.create();
        if ((mask & Sanitizer.ADDRESS) != 0) {
            list.append("address");
        }
        if ((mask & Sanitizer.THREAD) != 0) {
            list.append("thread");
        }
        if ((mask & Sanitizer.UNDEFINED) != 0) {
            if (list.length > 0) {
                list.append(",");
            }
            list.append("undefined");
        }
        return list.cstr();
    }

    // off, basic (link protections), standard (plus stack protectors; "on"/"true" are this) or strict; 0 when unknown.
    public static i32 parse_harden(ptr<i8> text) {
        if (Strings.same(text, "off") || Strings.same(text, "false")) { return HardenLevel.OFF; }
        if (Strings.same(text, "basic")) { return HardenLevel.BASIC; }
        if (Strings.same(text, "standard") || Strings.same(text, "on") || Strings.same(text, "true")) { return HardenLevel.STANDARD; }
        if (Strings.same(text, "strict")) { return HardenLevel.STRICT; }
        return 0;
    }

    public static i32 harden_level(Options* options) {
        if (options.harden == 0) {
            return HardenLevel.STANDARD;
        }
        return options.harden;
    }

    public static bool is_windows() {
        return getenv("OS") != null;
    }

    static i32 link_ld_lld(Options* options, ptr<i8> object_path) {
        ptr<i8> lld = Process.env_or("DJINN_LD_LLD", "ld.lld");
        ptr<i8> crt = Process.env_or("DJINN_CRT_DIR", "/usr/lib/x86_64-linux-gnu");
        ptr<i8> loader = Process.env_or("DJINN_DYNAMIC_LINKER", "/lib64/ld-linux-x86-64.so.2");

        ByteBuffer* command = ByteBuffer.create();
        command.append("\"");
        command.append(lld);
        command.append("\" --eh-frame-hdr");
        if (options.gc_sections) {
            command.append(" --gc-sections");
        }
        command.append(" -dynamic-linker \"");
        command.append(loader);
        command.append("\" \"");
        command.append(crt);
        command.append("/crt1.o\" \"");
        command.append(crt);
        command.append("/crti.o\" \"");
        command.append(object_path);
        command.append("\" \"");
        command.append(options.runtime_lib);
        command.append("\" -L\"");
        command.append(crt);
        command.append("\" -L/usr/lib -L/lib/x86_64-linux-gnu -lc -lm \"");
        command.append(crt);
        command.append("/crtn.o\"");
        if (Linker.harden_level(options) >= HardenLevel.BASIC) {
            command.append(" -z relro -z now -z noexecstack");
        }
        ByteBuffer* link_args = options.link_args;
        command.append(link_args.cstr());
        command.append(" -o \"");
        command.append(options.output);
        command.append("\"");

        return Process.run(command.cstr());
    }

    // The argument without its platform prefix, or null when it is for other platforms ('windows:-lvulkan-1').
    public static unsafe ptr<i8> for_this_platform(ptr<i8> declared) {
        mut i32 colon = 0;
        while (declared[colon] != 0 && declared[colon] != 58 && declared[colon] != 45 && declared[colon] != 47 && declared[colon] != 92) {
            colon = colon + 1;
        }
        if (colon > 0 && declared[colon] == 58 && Target.platform_mask(declared, colon) != 0) {
            if ((Target.platform_mask(declared, colon) & Target.platform_bit()) == 0) {
                return null;
            }
            return declared + (colon + 1);
        }
        return declared;
    }

    // One linker argument from a manifest or from -l / -L: with lld on Windows, -lfoo is foo.lib, -Ldir is /libpath:dir
    // and -Wl,flag (a flag for the linker behind the clang driver) is the flag itself.
    //
    // An argument can start with the platforms it is for, as in 'windows:-lvulkan-1' or 'android:-lvulkan': it is passed
    // only when building for one of them (the words of [Platform(...)] and the groups desktop, mobile, native).
    public static unsafe void append_link_arg(Options* options, ByteBuffer* link_args, ptr<i8> declared) {
        ptr<i8> value = Linker.for_this_platform(declared);
        if (value == null) {
            return;
        }
        i32 value_length = strlen(value);
        link_args.append(" \"");
        if (options.use_lld && Strings.starts_with(value, 0, value_length, "-Wl,")) {
            link_args.append(value + 4);
        } else if (options.use_lld && Linker.is_windows() && Strings.starts_with(value, 0, value_length, "-L")) {
            link_args.append("/libpath:");
            link_args.append(value + 2);
        } else if (options.use_lld && Linker.is_windows() && Strings.starts_with(value, 0, value_length, "-l")) {
            link_args.append(value + 2);
            link_args.append(".lib");
        } else {
            link_args.append(value);
        }
        link_args.append("\"");
    }

    static i32 link_lld(Options* options, ptr<i8> object_path) {
        if (options.runtime_lib == null) {
            logger_error(Log.get(), "djinnc: --lld needs --runtime-lib");
            return 1;
        }
        if (!Linker.is_windows()) {
            return Linker.link_ld_lld(options, object_path);
        }
        ptr<i8> lld = Process.env_or("DJINN_LLD_LINK", "lld-link");

        ByteBuffer* command = ByteBuffer.create();
        command.append("\"");
        command.append("\"");
        command.append(lld);
        command.append("\" \"");
        command.append(object_path);
        command.append("\" \"");
        command.append(options.runtime_lib);
        if (options.windowed) {
            command.append("\" /subsystem:windows /entry:mainCRTStartup /defaultlib:msvcrt /defaultlib:legacy_stdio_definitions /debug");
            if (options.gc_sections) {
                command.append(" /opt:ref,icf");
            }
        } else {
            command.append("\" /subsystem:console /defaultlib:msvcrt /defaultlib:legacy_stdio_definitions /debug");
        }
        ByteBuffer* link_args = options.link_args;
        command.append(link_args.cstr());
        command.append(" \"/out:");
        command.append(options.output);
        command.append("\"\"");

        return Process.run(command.cstr());
    }

    static void append_runtime_sources(ByteBuffer* command, ptr<i8> runtime_dir) {
        command.append(" \"");
        command.append(runtime_dir);
        command.append("/djinn_runtime.c\"");
        command.append(" \"");
        command.append(runtime_dir);
        command.append("/scheduler.c\"");
        command.append(" \"");
        command.append(runtime_dir);
        command.append("/io_file.c\"");
        command.append(" \"");
        command.append(runtime_dir);
        command.append("/io_socket.c\"");
        command.append(" \"");
        command.append(runtime_dir);
        command.append("/diagnostics.c\"");
        command.append(" \"");
        command.append(runtime_dir);
        command.append("/threads.c\"");
        command.append(" \"");
        command.append(runtime_dir);
        command.append("/console.c\"");
        command.append(" \"");
        command.append(runtime_dir);
        command.append("/filesystem.c\"");
        command.append(" \"");
        command.append(runtime_dir);
        command.append("/process.c\"");
        command.append(" \"");
        command.append(runtime_dir);
        command.append("/logger.c\"");
        command.append(" \"");
        command.append(runtime_dir);
        command.append("/tier.c\"");
    }

    // The directory part of a path, with its trailing separator ("" for a bare file name).
    static unsafe ptr<i8> directory_of(ptr<i8> path) {
        mut i32 cut = strlen(path);
        while (cut > 0 && path[cut - 1] != 47 && path[cut - 1] != 92) {
            cut = cut - 1;
        }
        return Strings.duplicate(path, cut);
    }

    // The web runtime: DJINN_WEB_RUNTIME_LIB when set (a prebuilt libdjinn_runtime.a for wasm32), otherwise
    // runtime/web/web_runtime.c compiled next to the object. Null when it cannot be built.
    static unsafe ptr<i8> web_runtime(Options* options, ptr<i8> object_path) {
        ptr<i8> prebuilt = getenv("DJINN_WEB_RUNTIME_LIB");
        if (prebuilt != null) {
            return prebuilt;
        }
        ByteBuffer* runtime_object = ByteBuffer.create();
        runtime_object.append(object_path);
        runtime_object.append(".runtime.o");
        ptr<i8> clang = Process.env_or("DJINN_CLANG", "clang");
        ByteBuffer* command = ByteBuffer.create();
        if (Linker.is_windows()) {
            command.append("\"");
        }
        command.append("\"");
        command.append(clang);
        command.append("\" --target=wasm32-unknown-unknown -nostdlib -ffreestanding -fno-builtin -O2 -Wall -Wextra -Wno-unused-parameter \"-I");
        command.append(options.runtime_dir);
        command.append("/web/include\" -c \"");
        command.append(options.runtime_dir);
        command.append("/web/web_runtime.c\" -o \"");
        command.append(runtime_object.cstr());
        command.append("\"");
        if (Linker.is_windows()) {
            command.append("\"");
        }
        if (Process.run(command.cstr()) != 0) {
            logger_error(Log.get(), "djinnc: cannot build the web runtime from '%s/web' (set DJINN_WEB_RUNTIME_LIB to a prebuilt one)", options.runtime_dir);
            return null;
        }
        return runtime_object.cstr();
    }

    // A program for the web: a WebAssembly module with its exports (main, djinn_tick and the host entry points) and
    // djinn.js, the host that loads it, copied next to it.
    static unsafe i32 link_wasm(Options* options, ptr<i8> object_path) {
        ptr<i8> runtime = Linker.web_runtime(options, object_path);
        if (runtime == null) {
            return 1;
        }
        ptr<i8> wasm_ld = Process.env_or("DJINN_WASM_LD", "wasm-ld");
        ByteBuffer* command = ByteBuffer.create();
        if (Linker.is_windows()) {
            command.append("\"");
        }
        command.append("\"");
        command.append(wasm_ld);
        command.append("\" \"");
        command.append(object_path);
        command.append("\" \"");
        command.append(runtime);
        command.append("\" --no-entry --export=main --export-if-defined=__djinn_last_error_report --stack-first -z stack-size=1048576 --initial-memory=16777216 --gc-sections --fatal-warnings");
        if (options.optimize) {
            // wasm-ld's own size optimizations (string tail merging, ...); the code was already optimized by LLVM
            command.append(" -O2");
        }
        if (!options.debug) {
            command.append(" --strip-debug");
        }
        ByteBuffer* link_args = options.link_args;
        command.append(link_args.cstr());
        command.append(" -o \"");
        command.append(options.output);
        command.append("\"");
        if (Linker.is_windows()) {
            command.append("\"");
        }
        i32 status = Process.run(command.cstr());
        if (status != 0) {
            return status;
        }
        // Binaryen's wasm-opt shrinks the module further when DJINN_WASM_OPT names it (not required: no wasm-opt, no pass)
        ptr<i8> wasm_opt = getenv("DJINN_WASM_OPT");
        if (wasm_opt != null && options.optimize) {
            ByteBuffer* optimize = ByteBuffer.create();
            if (Linker.is_windows()) {
                optimize.append("\"");
            }
            optimize.append("\"");
            optimize.append(wasm_opt);
            optimize.append("\" -O2 \"");
            optimize.append(options.output);
            optimize.append("\" -o \"");
            optimize.append(options.output);
            optimize.append("\"");
            if (Linker.is_windows()) {
                optimize.append("\"");
            }
            if (Process.run(optimize.cstr()) != 0) {
                logger_warn(Log.get(), "djinnc: wasm-opt failed; keeping the module as wasm-ld wrote it");
            }
        }
        ByteBuffer* glue_source = ByteBuffer.create();
        glue_source.append(options.runtime_dir);
        glue_source.append("/web/djinn.js");
        i32 length = 0;
        ptr<i8> glue = Files.read_bytes(glue_source.cstr(), &length);
        if (glue == null) {
            logger_warn(Log.get(), "djinnc: '%s' was not found, so djinn.js was not copied next to the program", glue_source.cstr());
            return 0;
        }
        ByteBuffer* glue_path = ByteBuffer.create();
        glue_path.append(Linker.directory_of(options.output));
        glue_path.append("djinn.js");
        if (!Files.write_bytes(glue_path.cstr(), glue, length)) {
            logger_error(Log.get(), "djinnc: cannot write '%s'", glue_path.cstr());
            return 1;
        }
        return 0;
    }

    // The Android ABI directory name of the target (arm64-v8a, x86_64), and the NDK clang wrapper prefix.
    static unsafe ptr<i8> android_abi() {
        if (Target.triple_mentions("aarch64") || Target.triple_mentions("arm64")) {
            return "arm64-v8a";
        }
        return "x86_64";
    }

    // The API level written after 'android' in the triple (aarch64-linux-android26); 26 when there is none.
    static unsafe i32 android_api() {
        ptr<i8> triple = Target.triple();
        i32 length = strlen(triple);
        for (mut i32 i = 0; i + 7 <= length; i = i + 1) {
            if (Strings.equals(triple + i, 7, "android")) {
                mut i32 api = 0;
                mut i32 at = i + 7;
                while (at < length && triple[at] >= 48 && triple[at] <= 57) {
                    api = api * 10 + (triple[at] - 48);
                    at = at + 1;
                }
                if (api > 0) {
                    return api;
                }
                return 26;
            }
        }
        return 26;
    }

    // An Android program or library through the NDK clang wrapper (DJINN_NDK or ANDROID_NDK_HOME; DJINN_ANDROID_CLANG
    // names the wrapper directly). An output ending in '.so' is a shared library (the NativeActivity entry point).
    // The runtime comes from lib/android/<abi>/ of the install, else --runtime-lib (built with build_runtime.sh --android).
    static unsafe i32 link_android(Options* options, ptr<i8> object_path) {
        mut ptr<i8> clang = getenv("DJINN_ANDROID_CLANG");
        ByteBuffer* wrapper = ByteBuffer.create();
        if (clang == null) {
            mut ptr<i8> ndk = getenv("DJINN_NDK");
            if (ndk == null) {
                ndk = getenv("ANDROID_NDK_HOME");
            }
            if (ndk == null) {
                logger_error(Log.get(), "djinnc: an Android target needs the NDK: set DJINN_NDK (or ANDROID_NDK_HOME), or DJINN_ANDROID_CLANG");
                return 1;
            }
            wrapper.append(ndk);
            if (Linker.is_windows()) {
                wrapper.append("/toolchains/llvm/prebuilt/windows-x86_64/bin/");
            } else {
                wrapper.append("/toolchains/llvm/prebuilt/linux-x86_64/bin/");
            }
            if (Target.triple_mentions("aarch64") || Target.triple_mentions("arm64")) {
                wrapper.append("aarch64");
            } else {
                wrapper.append("x86_64");
            }
            wrapper.append("-linux-android");
            wrapper.append_int((i64)Linker.android_api());
            wrapper.append("-clang");
            clang = wrapper.cstr();
        }

        // --runtime-lib is the host runtime (procedural macros run in the JIT); DJINN_ANDROID_RUNTIME_LIB is the target one
        mut ptr<i8> runtime = getenv("DJINN_ANDROID_RUNTIME_LIB");
        if (runtime == null) {
            runtime = options.runtime_lib;
        }
        ptr<i8> executable_dir = __djinn_executable_dir();
        if (executable_dir != null && getenv("DJINN_ANDROID_RUNTIME_LIB") == null) {
            ByteBuffer* installed = ByteBuffer.create();
            installed.append(executable_dir);
            installed.append("/../lib/android/");
            installed.append(Linker.android_abi());
            installed.append("/libdjinn_runtime.a");
            if (__djinn_path_exists(installed.cstr()) != 0) {
                runtime = installed.cstr();
            }
        }
        if (runtime == null) {
            logger_error(Log.get(), "djinnc: no Android runtime library (lib/android/%s/libdjinn_runtime.a, or --runtime-lib from tools/build_runtime.sh --android)", Linker.android_abi());
            return 1;
        }

        ByteBuffer* command = ByteBuffer.create();
        if (Linker.is_windows()) {
            command.append("\"");
        }
        command.append("\"");
        command.append(clang);
        command.append("\" \"");
        command.append(object_path);
        command.append("\" \"");
        command.append(runtime);
        command.append("\" -lm -llog -landroid");
        if (Linker.harden_level(options) >= HardenLevel.BASIC) {
            command.append(" -Wl,-z,relro,-z,now,-z,noexecstack");
        }
        i32 output_length = strlen(options.output);
        if (output_length > 3 && Strings.equals(options.output + (output_length - 3), 3, ".so")) {
            command.append(" -shared -Wl,-u,ANativeActivity_onCreate");
        }
        ByteBuffer* link_args = options.link_args;
        command.append(link_args.cstr());
        command.append(" -o \"");
        command.append(options.output);
        command.append("\"");
        if (Linker.is_windows()) {
            command.append("\"");
        }
        return Process.run(command.cstr());
    }

    public static i32 link(Options* options, ptr<i8> object_path) {
        if (options.sanitize != 0 && (Target.is_wasm() || Target.is_android() || options.use_lld)) {
            logger_error(Log.get(), "djinnc: --sanitize needs the clang driver to link: it is not available for wasm, Android or --lld");
            return 1;
        }
        if ((options.sanitize & Sanitizer.THREAD) != 0 && Linker.is_windows()) {
            logger_error(Log.get(), "djinnc: the thread sanitizer is not available on Windows (LLVM ships no runtime for it)");
            return 1;
        }
        if ((options.sanitize & Sanitizer.ADDRESS) != 0 && Linker.is_windows() && !Target.is_x64()) {
            logger_error(Log.get(), "djinnc: the address sanitizer is available on Windows x64 only");
            return 1;
        }
        if (Target.is_android()) {
            return Linker.link_android(options, object_path);
        }
        if (Target.is_wasm()) {
            return Linker.link_wasm(options, object_path);
        }
        if (options.use_lld) {
            return Linker.link_lld(options, object_path);
        }
        ptr<i8> clang = Process.env_or("DJINN_CLANG", "clang");

        ByteBuffer* command = ByteBuffer.create();
        if (Linker.is_windows()) {
            command.append("\"");
        }
        command.append("\"");
        command.append(clang);
        command.append("\" \"");
        command.append(object_path);
        command.append("\"");
        if (options.runtime_lib != null) {
            command.append(" \"");
            command.append(options.runtime_lib);
            command.append("\"");
        } else {
            Linker.append_runtime_sources(command, options.runtime_dir);
            command.append(" -O2");
            if (Linker.harden_level(options) >= HardenLevel.STANDARD && !Linker.is_windows()) {
                command.append(" -fstack-protector-strong -fstack-clash-protection -U_FORTIFY_SOURCE");
                if (options.sanitize == 0) {
                    // the checked memcpy and friends overlap with what the sanitizers report
                    command.append(" -D_FORTIFY_SOURCE=3");
                }
                if (Linker.harden_level(options) == HardenLevel.STRICT) {
                    command.append(" -fstack-protector-all -ftrivial-auto-var-init=zero");
                }
                if (Target.is_x64()) {
                    command.append(" -fcf-protection=full");
                } else if (Target.is_arm64()) {
                    command.append(" -mbranch-protection=standard");
                }
            }
        }
        if (options.sanitize != 0) {
            command.append(" -fno-omit-frame-pointer");
            mut i32 driver_sanitizers = options.sanitize;
            if (Linker.is_windows() && (options.sanitize & Sanitizer.ADDRESS) != 0) {
                // the driver would link the static runtime thunk, whose malloc functions clash with the dynamic UCRT
                // the runtime uses; the dynamic runtime and its thunk go in by hand
                driver_sanitizers = options.sanitize & (Sanitizer.UNDEFINED | Sanitizer.THREAD);
                if (!Linker.append_windows_address_sanitizer(command, clang, options.output)) {
                    return 1;
                }
            }
            if (driver_sanitizers != 0) {
                command.append(" -fsanitize=");
                command.append(Linker.sanitize_list(driver_sanitizers));
            }
            if (options.runtime_lib != null) {
                logger_warn(Log.get(), "djinnc: --runtime-lib is not instrumented: build it with DJINN_SANITIZE=%s tools/build_runtime.sh to see errors inside the runtime", Linker.sanitize_list(options.sanitize));
            }
        }
        if (options.debug || Linker.is_windows()) {
            command.append(" -g");
        }
        if (Linker.is_windows()) {
            // printf and the other stdio functions are inline in the UCRT headers; this library exports them for objects
            command.append(" -Wl,/defaultlib:legacy_stdio_definitions");
            if (options.windowed) {
                command.append(" -Wl,/subsystem:windows,/entry:mainCRTStartup");
            }
            if (Linker.harden_level(options) == HardenLevel.STRICT) {
                // the module carries the cfguard flag; this makes the linker build the guard function table
                command.append(" -Wl,/guard:cf");
            }
            if (options.gc_sections) {
                command.append(" -Wl,/opt:ref,/opt:icf");
            }
        }
        if (!Linker.is_windows()) {
            // the runtime and std use libm (cbrt, cos, exp, fmod)
            command.append(" -lm");
            if (options.gc_sections) {
                command.append(" -Wl,--gc-sections");
            }
            if (Linker.harden_level(options) >= HardenLevel.BASIC) {
                // read-only GOT after startup, no executable stack
                command.append(" -Wl,-z,relro,-z,now,-z,noexecstack");
                // a position independent executable, so ASLR moves the program too (not for a shared object)
                ByteBuffer* user_args = options.link_args;
                if (strstr(user_args.cstr(), "-shared") == null) {
                    command.append(" -pie");
                }
            }
        }
        ByteBuffer* link_args = options.link_args;
        command.append(link_args.cstr());
        command.append(" -fuse-ld=lld -o \"");
        command.append(options.output);
        command.append("\"");
        if (Linker.is_windows()) {
            command.append("\"");
        }

        return Process.run(command.cstr());
    }
}
